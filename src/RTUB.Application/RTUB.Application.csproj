<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\RTUB.Core\RTUB.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- HttpContext / IHttpContextAccessor come from the .NET 10 shared framework.
         Declared explicitly so it does not depend on Identity.UI pulling it in transitively. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.Core" />
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.UI" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="QuestPDF" />
    <PackageReference Include="WebPush-NetCore" />
    <!-- Not used by any RTUB source file. Temporary security floor: WebPush-NetCore 1.0.2
         declares a permissive Newtonsoft.Json >= 9.0.1 and ships it as a runtime asset, so
         without this direct reference the graph resolves 9.0.1 (GHSA-5crp-9r3c-p9vr, High).
         RTUB.Shared needs no reference of its own - it inherits 13.0.4 through this project.
         Revisit when WebPush-NetCore is replaced. -->
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RTUB.Application.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>fccae9d8-5630-4721-820a-d7487b90be65</UserSecretsId>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
