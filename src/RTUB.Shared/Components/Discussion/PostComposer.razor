@namespace RTUB.Shared
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using RTUB.Application.Interfaces
@inject IMentionService MentionService

<div class="post-composer">
    <EditForm Model="@model" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <ErrorDisplay />

        <div class="mb-3">
            <label class="form-label fw-semibold">
                <i class="bi bi-card-text text-primary me-2"></i>Título
            </label>
            <InputText class="form-control"
                       @bind-Value="model.Title"
                       placeholder="Título do post (3-120 caracteres)"
                       maxlength="120" />
            <ValidationMessage For="@(() => model.Title)" />
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">
                <i class="bi bi-text-paragraph text-primary me-2"></i>Conteúdo
            </label>
            <div class="mention-wrapper">
                <textarea class="form-control"
                          rows="5"
                          placeholder="Escreva o post... Use @@alcunha para mencionar alguém"
                          value="@model.Body"
                          @oninput="HandleBodyInput"></textarea>
                <ValidationMessage For="@(() => model.Body)" />

                @if (mentionSuggestions.Count > 0)
                {
                    <div class="mention-dropdown member-list-scrollable">
                        @foreach (var s in mentionSuggestions)
                        {
                            var suggestion = s;
                            <div class="cursor-pointer member-item p-2 mb-1 border rounded" @onclick="() => SelectMention(suggestion)" @key="suggestion.userId">
                                <div class="d-flex align-items-center">
                                    <img src="@suggestion.avatarUrl" alt="@suggestion.displayName" class="member-avatar-small me-2" width="50" height="50" data-avatar-fallback />
                                    <div>
                                        <div><strong>@suggestion.displayName</strong></div>
                                        @if (!string.IsNullOrWhiteSpace(suggestion.fullName))
                                        {
                                            <div class="text-muted small">@suggestion.fullName</div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Video Upload Section -->
        <div class="mb-3">
            <label class="form-label fw-semibold">
                <i class="bi bi-camera-video text-primary me-2"></i>Vídeos
            </label>
            <div class="localized-file-picker">
                <InputFile id="@videoInputId"
                           class="d-none"
                           OnChange="@HandleVideoSelection"
                           accept="video/*"
                           multiple
                           aria-label="Escolher vídeos" />
                <label class="btn btn-outline-secondary localized-file-button" for="@videoInputId">
                    <i class="bi bi-upload me-2"></i>Escolher vídeos
                </label>
                <span class="localized-file-name">
                    @if (selectedVideos.Count > 0)
                    {
                        <text>@selectedVideos.Count vídeo(s) selecionado(s)</text>
                    }
                    else
                    {
                        <text>Nenhum vídeo selecionado</text>
                    }
                </span>
            </div>
        </div>

        <div class="d-flex justify-content-end">
            <button type="submit" class="btn btn-primary btn-primary-purple" disabled="@isSubmitting">
                @if (isSubmitting)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                }
                Publicar
            </button>
        </div>
    </EditForm>
</div>

@code {
    [Parameter]
    public EventCallback<(string title, string body, IReadOnlyList<IBrowserFile> videos)> OnSubmit { get; set; }

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public string? Body { get; set; }

    private PostComposerModel model = new();
    private bool isSubmitting = false;
    private List<IBrowserFile> selectedVideos = new();
    private string videoInputId = $"post-videos-{Guid.NewGuid():N}";
    private List<(string userId, string username, string displayName, string fullName, string avatarUrl)> mentionSuggestions = new();

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(Title) || !string.IsNullOrEmpty(Body))
        {
            model.Title = Title ?? string.Empty;
            model.Body = Body ?? string.Empty;
        }
    }

    private void HandleVideoSelection(InputFileChangeEventArgs e)
    {
        selectedVideos = e.GetMultipleFiles(3).ToList(); // Max 3 videos
    }

    private async Task HandleBodyInput(ChangeEventArgs e)
    {
        model.Body = e.Value?.ToString() ?? string.Empty;
        await UpdateMentionSuggestions(model.Body);
    }

    private async Task UpdateMentionSuggestions(string text)
    {
        var atIndex = text.LastIndexOf('@');
        if (atIndex >= 0)
        {
            var query = text[(atIndex + 1)..];
            if (query.Length >= 1 && !query.Contains(' '))
            {
                var results = await MentionService.GetSuggestionsAsync(query, maxResults: 6);
                mentionSuggestions = results.ToList();
                return;
            }
        }
        mentionSuggestions.Clear();
    }

    private void SelectMention((string userId, string username, string displayName, string fullName, string avatarUrl) suggestion)
    {
        var text = model.Body;
        var atIndex = text.LastIndexOf('@');
        if (atIndex >= 0)
        {
            model.Body = text[..atIndex] + $"@{suggestion.username} ";
        }
        mentionSuggestions.Clear();
    }

    private async Task HandleSubmit()
    {
        if (isSubmitting) return;

        isSubmitting = true;
        try
        {
            await OnSubmit.InvokeAsync((model.Title, model.Body, selectedVideos));
            model = new PostComposerModel();
            selectedVideos.Clear();
            mentionSuggestions.Clear();
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private class PostComposerModel
    {
        [Required(ErrorMessage = "O título é obrigatório")]
        [MinLength(3, ErrorMessage = "O título deve ter pelo menos 3 caracteres")]
        [MaxLength(120, ErrorMessage = "O título não pode exceder 120 caracteres")]
        public string Title { get; set; } = string.Empty;

        [Required(ErrorMessage = "O conteúdo é obrigatório")]
        [MinLength(3, ErrorMessage = "O conteúdo deve ter pelo menos 3 caracteres")]
        public string Body { get; set; } = string.Empty;
    }
}
