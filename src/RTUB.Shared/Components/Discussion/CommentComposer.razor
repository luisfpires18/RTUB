@namespace RTUB.Shared
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms

<div class="comment-composer">
    <EditForm Model="@model" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <ErrorDisplay />

        <div class="mb-3">
            <InputTextArea class="form-control" 
                          rows="3" 
                          @bind-Value="model.Body" 
                          placeholder="Escreva um comentário..." />
            <ValidationMessage For="@(() => model.Body)" />
        </div>

        <div class="mb-3">
            <label class="form-label">
                <i class="bi bi-images me-2"></i>Imagens (opcional)
            </label>
            <div class="localized-file-picker">
                <InputFile id="@imageInputId" 
                           class="d-none" 
                           OnChange="@HandleImageSelection" 
                           accept="image/*" 
                           multiple 
                           aria-label="Escolher imagens" />
                <label class="btn btn-outline-secondary localized-file-button" for="@imageInputId">
                    <i class="bi bi-upload me-2"></i>Escolher imagens
                </label>
                <span class="localized-file-name">
                    @if (selectedImages.Count > 0)
                    {
                        <text>@selectedImages.Count imagem(ns) selecionada(s)</text>
                    }
                    else
                    {
                        <text>Nenhuma imagem selecionada</text>
                    }
                </span>
            </div>
        </div>

        <div class="d-flex justify-content-end">
            <button type="submit" class="btn btn-outline-primary" disabled="@isSubmitting">
                @if (isSubmitting)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                }
                Comentar
            </button>
        </div>
    </EditForm>
</div>

@code {
    [Parameter]
    public EventCallback<(string body, IReadOnlyList<IBrowserFile> images)> OnSubmit { get; set; }

    private CommentComposerModel model = new();
    private bool isSubmitting = false;
    private List<IBrowserFile> selectedImages = new();
    private string imageInputId = $"comment-images-{Guid.NewGuid():N}";

    private void HandleImageSelection(InputFileChangeEventArgs e)
    {
        selectedImages = e.GetMultipleFiles(3).ToList(); // Max 3 images per comment
    }

    private async Task HandleSubmit()
    {
        if (isSubmitting) return;

        isSubmitting = true;
        try
        {
            await OnSubmit.InvokeAsync((model.Body, selectedImages));
            model = new CommentComposerModel(); // Reset form
            selectedImages.Clear();
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private class CommentComposerModel
    {
        [Required(ErrorMessage = "O comentário é obrigatório")]
        [MinLength(1, ErrorMessage = "O comentário deve ter pelo menos 1 caractere")]
        public string Body { get; set; } = string.Empty;
    }
}
