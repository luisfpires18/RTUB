@namespace RTUB.Shared
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using RTUB.Application.Interfaces
@inject IMentionService MentionService

<div class="comment-composer">
    <EditForm Model="@model" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <ErrorDisplay />

        <div class="mb-3 mention-wrapper">
            <textarea class="form-control"
                      rows="3"
                      placeholder="Escreva um comentário... Use @@alcunha para mencionar alguém"
                      value="@model.Body"
                      @oninput="HandleBodyInput"></textarea>
            <ValidationMessage For="@(() => model.Body)" />

            @if (mentionSuggestions.Count > 0)
            {
                <div class="mention-dropdown member-list-scrollable">
                    @foreach (var s in mentionSuggestions)
                    {
                        var suggestion = s;
                        <div class="member-item p-2 mb-1 border rounded" @onclick="() => SelectMention(suggestion)" @key="suggestion.userId" style="cursor:pointer;">
                            <div class="d-flex align-items-center">
                                <img src="@suggestion.avatarUrl" alt="@suggestion.displayName" class="member-avatar-small me-2" width="50" height="50" data-avatar-fallback />
                                <div>
                                    <div><strong>@suggestion.displayName</strong></div>
                                    @if (!string.IsNullOrWhiteSpace(suggestion.fullName))
                                    {
                                        <div class="text-muted small">@suggestion.fullName</div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="d-flex justify-content-end">
            <button type="submit" class="btn btn-outline-primary" disabled="@isSubmitting">
                @if (isSubmitting)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                }
                Comentar
            </button>
        </div>
    </EditForm>
</div>

@code {
    [Parameter]
    public EventCallback<string> OnSubmit { get; set; }

    private CommentComposerModel model = new();
    private bool isSubmitting = false;
    private List<(string userId, string username, string displayName, string fullName, string avatarUrl)> mentionSuggestions = new();

    private async Task HandleBodyInput(ChangeEventArgs e)
    {
        model.Body = e.Value?.ToString() ?? string.Empty;
        await UpdateMentionSuggestions(model.Body);
    }

    private async Task UpdateMentionSuggestions(string text)
    {
        var atIndex = text.LastIndexOf('@');
        if (atIndex >= 0)
        {
            var query = text[(atIndex + 1)..];
            // Only show if no space after @ (still typing the mention)
            if (query.Length >= 1 && !query.Contains(' '))
            {
                var results = await MentionService.GetSuggestionsAsync(query, maxResults: 6);
                mentionSuggestions = results.ToList();
                return;
            }
        }
        mentionSuggestions.Clear();
    }

    private void SelectMention((string userId, string username, string displayName, string fullName, string avatarUrl) suggestion)
    {
        var text = model.Body;
        var atIndex = text.LastIndexOf('@');
        if (atIndex >= 0)
        {
            model.Body = text[..atIndex] + $"@{suggestion.username} ";
        }
        mentionSuggestions.Clear();
    }

    private async Task HandleSubmit()
    {
        if (isSubmitting) return;

        isSubmitting = true;
        try
        {
            await OnSubmit.InvokeAsync(model.Body);
            model = new CommentComposerModel();
            mentionSuggestions.Clear();
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private class CommentComposerModel
    {
        [Required(ErrorMessage = "O comentário é obrigatório")]
        [MinLength(1, ErrorMessage = "O comentário deve ter pelo menos 1 caractere")]
        public string Body { get; set; } = string.Empty;
    }
}
