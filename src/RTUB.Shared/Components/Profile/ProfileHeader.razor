@namespace RTUB.Shared
@using RTUB.Core.Entities
@using RTUB.Core.Enums
@using RTUB.Application.Helpers
@using RTUB.Application.Extensions

@*
    ProfileHeader Component
    Displays the user's header card with avatar, display name, tuna name, role badges, and primary actions
*@

<div class="profile-header-card card mb-4 w-100 overflow-hidden" style="min-width: 0;">
    <div class="card-body d-flex flex-column align-items-center w-100" style="min-width: 0;">
        <div class="row w-100 justify-content-center" style="min-width: 0;">
            <!-- Avatar and Info Section - Centered -->
            <div class="col-12" style="min-width: 0;">
                <div class="text-center d-flex flex-column align-items-center w-100" style="min-width: 0;">
                    <!-- Avatar -->
                    <div class="profile-avatar-wrapper profile-avatar-large mx-auto mb-3 mw-100" style="min-width: 0;">
                        <img src="@GetProfilePictureUrl()"
                             alt="Foto de Perfil"
                             class="profile-avatar img-fluid"
                             data-avatar-fallback />
                    </div>

                    <!-- Name and Badges -->
                    <div class="profile-header-info-centered w-100 d-flex flex-column align-items-center overflow-hidden" style="min-width: 0;">
                        <h2 class="profile-display-name mb-1">@GetHeaderDisplayName()</h2>
                        @if (!string.IsNullOrEmpty(User.Nickname))
                        {
                            <p class="profile-full-name text-muted mb-3">
                                @User.FirstName @User.LastName
                            </p>
                        }
                        
                        <!-- Role Badges -->
                        <div class="profile-badges mb-3 d-flex justify-content-center flex-wrap w-100" style="min-width: 0;">
                            @{
                                var displayCategories = StatusHelper.GetDisplayCategories(User);
                            }
                            @foreach (var category in displayCategories)
                            {
                                <CategoryBadge @key="@($"category-{User.Id}-{category}")" Category="category" AdditionalClasses="me-1 mb-1" />
                            }
                            @if (User.Positions.Any())
                            {
                                @foreach (var position in User.Positions)
                                {
                                    <PositionBadge @key="position" Position="position" AdditionalClasses="me-1 mb-1" />
                                }
                            }
                        </div>

                        <!-- Primary Actions -->
                        <div class="d-flex gap-2 justify-content-center flex-wrap w-100 profile-header-actions">
                            <button class="btn btn-sm btn-outline-light" @onclick="OnUploadPhoto" aria-label="Carregar foto de perfil">
                                <i class="bi bi-upload"></i> Carregar Foto
                            </button>
                            <button class="btn btn-sm btn-outline-light" @onclick="OnChangePassword" aria-label="Alterar palavra-passe">
                                <i class="bi bi-key"></i> Alterar Palavra-passe
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public ApplicationUser User { get; set; } = null!;

    [Parameter]
    public int ImageRefreshTrigger { get; set; }

    [Parameter]
    public EventCallback OnChangePassword { get; set; }

    [Parameter]
    public EventCallback OnUploadPhoto { get; set; }

    private string GetProfilePictureUrl()
    {
        if (User == null) return "/images/default-avatar.webp";
        
        // Return the profile picture URL directly - let ETags handle caching (304 responses)
        return User.ProfilePictureSrc ?? "/images/default-avatar.webp";
    }

    private string GetHeaderDisplayName()
    {
        if (User == null) return "";
        if (!string.IsNullOrWhiteSpace(User.Nickname))
        {
            return User.Nickname;
        }

        return $"{User.FirstName} {User.LastName}".Trim();
    }
}
