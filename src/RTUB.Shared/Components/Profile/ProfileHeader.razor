@namespace RTUB.Shared
@using RTUB.Core.Entities
@using RTUB.Core.Enums
@using RTUB.Application.Helpers
@using RTUB.Application.Extensions

@*
    ProfileHeader: the member's identity in the same language as the Membros directory card
    (docs/design/RTUB_UI_REFACTOR.md section 25) - photo, nome de tuna, name, category and
    positions, then the two profile actions.
*@

<section class="item-card profile-identity mb-4" aria-labelledby="profile-identity-name">
    <div class="profile-identity__avatar">
        <img src="@GetProfilePictureUrl()"
             alt="Foto de Perfil"
             class="profile-identity__photo"
             data-avatar-fallback />
    </div>

    <div class="profile-identity__body">
        <h2 class="profile-identity__name" id="profile-identity-name">@GetHeaderDisplayName()</h2>
        @if (!string.IsNullOrEmpty(User.Nickname))
        {
            <p class="profile-identity__fullname">@User.FirstName @User.LastName</p>
        }

        <div class="profile-identity__tags">
            @{
                var displayCategories = StatusHelper.GetDisplayCategories(User);
            }
            @foreach (var category in displayCategories)
            {
                <CategoryBadge @key="@($"category-{User.Id}-{category}")" Category="category" />
            }
            @foreach (var position in User.Positions)
            {
                <span @key="position" class="profile-identity__position">@StatusHelper.GetPositionDisplay(position)</span>
            }
        </div>

        <div class="profile-identity__actions">
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="OnUploadPhoto" aria-label="Carregar foto de perfil">
                <i class="bi bi-upload" aria-hidden="true"></i> Carregar Foto
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="OnChangePassword" aria-label="Alterar palavra-passe">
                <i class="bi bi-key" aria-hidden="true"></i> Alterar Palavra-passe
            </button>
        </div>
    </div>
</section>

@code {
    [Parameter]
    public ApplicationUser User { get; set; } = null!;

    [Parameter]
    public int ImageRefreshTrigger { get; set; }

    [Parameter]
    public EventCallback OnChangePassword { get; set; }

    [Parameter]
    public EventCallback OnUploadPhoto { get; set; }

    private string GetProfilePictureUrl()
    {
        if (User == null) return "/images/default-avatar.webp";
        
        // Return the profile picture URL directly - let ETags handle caching (304 responses)
        return User.ProfilePictureSrc ?? "/images/default-avatar.webp";
    }

    private string GetHeaderDisplayName()
    {
        if (User == null) return "";
        if (!string.IsNullOrWhiteSpace(User.Nickname))
        {
            return User.Nickname;
        }

        return $"{User.FirstName} {User.LastName}".Trim();
    }
}
