@namespace RTUB.Shared
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime

<div class="mb-3" data-media-upload-id="@componentId">
    <label class="form-label">@Label</label>

    <div class="localized-file-picker">
        <InputFile id="@inputId"
                   class="d-none"
                   OnChange="HandleMediaUpload"
                   accept="image/*,video/*"
                   aria-label="Escolher ficheiro" />
        <label class="btn btn-outline-secondary localized-file-button" for="@inputId">
            <i class="bi bi-upload me-2"></i>Escolher ficheiro
        </label>
        <span class="localized-file-name">@(!string.IsNullOrEmpty(selectedFileName) ? selectedFileName : "Sem ficheiro escolhido")</span>
    </div>

    @if (ShowCurrentMedia && !string.IsNullOrEmpty(CurrentMediaUrl))
    {
        <div class="mt-2">
            <small class="text-muted">Ficheiro atual</small>
            <br />
            @if (IsVideo(CurrentMediaUrl))
            {
                <div class="video-preview-container" style="max-width: 300px; position: relative;">
                    <video muted preload="metadata" class="img-thumbnail mt-1 @PreviewCssClass" style="width: 100%; cursor: pointer;"
                           @onmouseenter="PlayVideoPreview" @onmouseleave="PauseVideoPreview">
                        <source src="@CurrentMediaUrl" />
                    </video>
                </div>
            }
            else
            {
                <img src="@CurrentMediaUrl" alt="Preview" class="img-thumbnail mt-1 @PreviewCssClass" />
            }
        </div>
    }
    
    @if (HasNewMedia)
    {
        <div class="mt-2">
            <small class="text-success">Novo ficheiro carregado!</small>
        </div>
    }
    
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger mt-2">@ErrorMessage</div>
    }
</div>

@code {
    [Parameter] public string Label { get; set; } = "Escolher ficheiro";
    [Parameter] public string? CurrentMediaUrl { get; set; }
    [Parameter] public bool ShowCurrentMedia { get; set; } = true;
    [Parameter] public string PreviewCssClass { get; set; } = "music-album-preview";
    [Parameter] public long MaxImageSize { get; set; } = 10 * 1024 * 1024; // 10MB
    [Parameter] public long MaxVideoSize { get; set; } = 100 * 1024 * 1024; // 100MB
    
    // Event callbacks
    [Parameter] public EventCallback<IBrowserFile> OnFileSelected { get; set; }
    
    private IBrowserFile? selectedFile;
    private string inputId = $"upload-{Guid.NewGuid():N}";
    private string componentId = $"media-upload-{Guid.NewGuid():N}";
    private string? selectedFileName;
    private bool HasNewMedia { get; set; }
    private string? ErrorMessage { get; set; }

    private async Task HandleMediaUpload(InputFileChangeEventArgs e)
    {
        try
        {
            ErrorMessage = null;
            HasNewMedia = false;
            
            var mediaFile = e.File;
            if (mediaFile != null)
            {
                // Check content type
                var contentType = mediaFile.ContentType;
                var isImage = contentType.StartsWith("image/");
                var isVideo = contentType.StartsWith("video/");
                
                if (!isImage && !isVideo)
                {
                    ErrorMessage = "Formato de ficheiro não suportado. Apenas imagens e vídeos são aceites.";
                    return;
                }
                
                // Check file size
                var maxSize = isVideo ? MaxVideoSize : MaxImageSize;
                if (mediaFile.Size > maxSize)
                {
                    var maxSizeMB = maxSize / (1024 * 1024);
                    ErrorMessage = $"O tamanho do ficheiro deve ser inferior a {maxSizeMB}MB.";
                    return;
                }

                selectedFile = mediaFile;
                selectedFileName = mediaFile.Name;
                HasNewMedia = true;
                await OnFileSelected.InvokeAsync(selectedFile);
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Erro ao carregar ficheiro: {ex.Message}";
        }
    }
    
    private async Task PlayVideoPreview()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", $"document.querySelector('[data-media-upload-id=\"{componentId}\"] video')?.play()");
        }
        catch
        {
            // Ignore errors - preview is optional
        }
    }
    
    private async Task PauseVideoPreview()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", $"document.querySelector('[data-media-upload-id=\"{componentId}\"] video')?.pause()");
        }
        catch
        {
            // Ignore errors - preview is optional
        }
    }

    private bool IsVideo(string? url)
    {
        if (string.IsNullOrEmpty(url)) return false;
        
        // Check for data URLs with video MIME type
        if (url.StartsWith("data:video/", StringComparison.OrdinalIgnoreCase))
            return true;
        
        var videoExtensions = new[] { ".mp4", ".webm", ".ogg", ".mov", ".avi" };
        return videoExtensions.Any(ext => url.EndsWith(ext, StringComparison.OrdinalIgnoreCase));
    }

    /// <summary>
    /// Resets the component state
    /// </summary>
    public void Reset()
    {
        HasNewMedia = false;
        ErrorMessage = null;
        selectedFile = null;
        selectedFileName = null;
    }
}
