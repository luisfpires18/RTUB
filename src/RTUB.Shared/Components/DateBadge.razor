@namespace RTUB.Shared
@*
    DateBadge Component
    Reusable badge for displaying "HOJE" or "AMANHÃ" based on date
*@

@if (Date.Date == DateTime.Today)
{
    <span class="date-badge date-badge-hoje">HOJE</span>
}
else if (Date.Date == DateTime.Today.AddDays(1))
{
    <span class="date-badge date-badge-amanha">AMANHÃ</span>
}

@code {
    /// <summary>
    /// The date to compare against today and tomorrow
    /// </summary>
    [Parameter]
    public DateTime Date { get; set; }
    
    private DateTime _previousDate;
    private DateTime _previousToday;
    
    /// <summary>
    /// Optimize rendering - only re-render when date changes or day changes
    /// </summary>
    protected override bool ShouldRender()
    {
        var today = DateTime.Today;
        if (Date.Date != _previousDate || today != _previousToday)
        {
            _previousDate = Date.Date;
            _previousToday = today;
            return true;
        }
        return false;
    }
}
