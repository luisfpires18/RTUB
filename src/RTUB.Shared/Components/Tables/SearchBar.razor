@namespace RTUB.Shared
@using System.Threading
@implements IDisposable
@*
    Debounced search field. Named by Label (default: the placeholder without its trailing
    dots), so the placeholder is never the only name. The clear button returns focus to the
    field (docs/design/RTUB_UI_REFACTOR.md section 23.6).
*@

<div class="@(Compact ? "search-bar-container search-bar-container--compact" : "search-bar-container")">
    <div class="search-bar">
        <label class="visually-hidden" for="@_inputId">@AccessibleName</label>
        <span class="search-bar__icon" aria-hidden="true">
            <i class="bi bi-search"></i>
        </span>
        <input @ref="_input"
               id="@_inputId"
               type="search"
               class="search-bar__input"
               placeholder="@Placeholder"
               value="@pendingValue"
               autocomplete="off"
               enterkeyhint="search"
               @oninput="HandleInput"
               @onkeyup="HandleKeyUp" />
        @if (!string.IsNullOrEmpty(pendingValue))
        {
            <button class="search-bar__clear" type="button" @onclick="ClearSearch" title="Limpar pesquisa" aria-label="Limpar pesquisa">
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
        }
    </div>
</div>

@code {
    /// <summary>Current search value</summary>
    [Parameter] public string Value { get; set; } = string.Empty;

    /// <summary>Event callback for two-way binding</summary>
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    /// <summary>Optional callback when a search is performed</summary>
    [Parameter] public EventCallback<string> OnSearch { get; set; }

    /// <summary>Optional callback to clear any associated selection when the search is cleared</summary>
    [Parameter] public EventCallback OnClear { get; set; }

    /// <summary>Placeholder text for the search input</summary>
    [Parameter] public string Placeholder { get; set; } = "Pesquisar...";

    /// <summary>Accessible name. Defaults to the placeholder without trailing dots.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Debounce delay in milliseconds (default: 300ms)</summary>
    [Parameter] public int DebounceDelay { get; set; } = 300;

    /// <summary>Whether to use a compact layout (reduced margins) for inline form usage</summary>
    [Parameter] public bool Compact { get; set; }

    private readonly string _inputId = "search-" + Guid.NewGuid().ToString("N")[..8];
    private ElementReference _input;
    private Timer? debounceTimer;
    private string pendingValue = string.Empty;

    private string AccessibleName => !string.IsNullOrWhiteSpace(Label)
        ? Label
        : (Placeholder ?? string.Empty).TrimEnd('.', '…', ' ') is { Length: > 0 } name ? name : "Pesquisar";

    protected override void OnParametersSet()
    {
        pendingValue = Value ?? string.Empty;
    }

    private void HandleInput(ChangeEventArgs e)
    {
        pendingValue = e.Value?.ToString() ?? string.Empty;

        debounceTimer?.Dispose();
        // The callback runs on a timer thread: an exception there would end the whole server
        // process. It is handed to Blazor instead (the page's error boundary; logged).
        debounceTimer = new Timer(_ => _ = InvokeAsync(async () =>
        {
            try
            {
                await TriggerSearch(pendingValue);
                StateHasChanged();
            }
            catch (Exception ex)
            {
                await DispatchExceptionAsync(ex);
            }
        }), null, DebounceDelay, Timeout.Infinite);
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            debounceTimer?.Dispose();
            await TriggerSearch(pendingValue);
        }
    }

    private async Task ClearSearch()
    {
        pendingValue = string.Empty;
        debounceTimer?.Dispose();
        await ValueChanged.InvokeAsync(pendingValue);

        if (OnClear.HasDelegate)
        {
            await OnClear.InvokeAsync();
        }

        if (OnSearch.HasDelegate)
        {
            await OnSearch.InvokeAsync(pendingValue);
        }

        // The clear button disappears with the text; keep keyboard users in the field.
        await _input.FocusAsync();
    }

    private async Task TriggerSearch(string term)
    {
        await ValueChanged.InvokeAsync(term);

        if (OnSearch.HasDelegate)
        {
            await OnSearch.InvokeAsync(term);
        }
    }

    public void Dispose()
    {
        debounceTimer?.Dispose();
    }
}
