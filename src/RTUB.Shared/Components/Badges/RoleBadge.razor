@namespace RTUB.Shared
@*
    RoleBadge Component
    Displays a Bootstrap badge with the appropriate styling for a user role
    Shows icon followed by role name
*@

<span class="badge avatar-card-role-badge @GetRoleBadgeClass(Role) @GetRoleBadgeModifier(Role) @AdditionalClasses"
      tabindex="0"
      role="button"
      aria-expanded="false"
      title="@Role">
    <i class="bi @GetRoleIcon(Role) me-1"></i>@Role
</span>

@code {
    /// <summary>
    /// The role to display (e.g., "Owner", "Admin", "Mod", "Member")
    /// </summary>
    [Parameter]
    public string Role { get; set; } = string.Empty;

    /// <summary>
    /// Additional CSS classes to apply to the badge
    /// </summary>
    [Parameter]
    public string AdditionalClasses { get; set; } = "";
    
    private string _previousRole = string.Empty;
    private string _previousAdditionalClasses = "";
    
    /// <summary>
    /// Optimize rendering - only re-render when role or classes change.
    /// </summary>
    protected override bool ShouldRender()
    {
        if (Role != _previousRole || AdditionalClasses != _previousAdditionalClasses)
        {
            _previousRole = Role;
            _previousAdditionalClasses = AdditionalClasses;
            return true;
        }
        return false;
    }

    /// <summary>
    /// Returns the appropriate CSS class for the role badge
    /// </summary>
    private string GetRoleBadgeClass(string role)
    {
        return role switch
        {
            "Owner" => "bg-danger",      // Red
            "Admin" => "bg-success",     // Green
            "Mod" => "bg-warning",       // Yellow/Orange (Bootstrap warning color)
            "Member" => "",              // Custom blue color via style
            _ => "bg-secondary"
        };
    }

    /// <summary>
    /// Returns the modifier class carrying the per-role colour overrides.
    /// All three variants also reset text-transform (see badges.css).
    /// </summary>
    private string GetRoleBadgeModifier(string role)
    {
        return role switch
        {
            "Member" => "role-badge--member",
            "Mod" => "role-badge--mod",
            _ => "role-badge--plain"
        };
    }

    /// <summary>
    /// Returns the Bootstrap icon class for the role
    /// </summary>
    private string GetRoleIcon(string role)
    {
        return role switch
        {
            "Owner" => "bi-star-fill",
            "Admin" => "bi-shield-fill",
            "Mod" => "bi-shield-check",
            "Member" => "bi-person-fill",
            _ => "bi-circle"
        };
    }
}
