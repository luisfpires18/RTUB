@namespace RTUB.Shared
@inherits ErrorBoundary
@inject NavigationManager Navigation
@*
    Wraps an interactive page's content. An exception while rendering it, in a child component,
    or in an event handler rendered inside it shows this RTUB fallback instead of ending the
    circuit. ErrorBoundary still logs the exception on the server; the user never sees its
    details. "Tentar novamente" re-renders the content, "Recarregar página" reloads it.
    Exceptions in the page's own lifecycle methods (it sits outside its own boundary) and circuit
    loss still reach #blazor-error-ui / ReconnectModal (docs/design/RTUB_UI_REFACTOR.md 23.9).
*@

@if (CurrentException is null)
{
    @ChildContent
}
else if (ErrorContent is not null)
{
    @ErrorContent(CurrentException)
}
else
{
    <section class="app-error" role="alert" aria-labelledby="@_titleId" tabindex="-1" @ref="_fallback">
        <span class="app-error__icon" aria-hidden="true"><i class="bi bi-exclamation-octagon"></i></span>
        <h1 class="app-error__title" id="@_titleId">Não foi possível mostrar esta página</h1>
        <p class="app-error__message">
            Ocorreu um erro inesperado. O problema foi registado. Pode tentar novamente ou recarregar a
            página; o que ainda não tinha guardado pode perder-se ao recarregar.
        </p>
        <div class="app-error__actions">
            <button type="button" class="btn btn-primary" @onclick="Recover">Tentar novamente</button>
            <button type="button" class="btn btn-outline-secondary" @onclick="Reload">Recarregar página</button>
        </div>
    </section>
}

@code {
    private readonly string _titleId = "app-error-" + Guid.NewGuid().ToString("N")[..8];
    private ElementReference _fallback;
    private Exception? _focusedFor;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Move keyboard and screen-reader users to the message once per failure.
        if (CurrentException is not null && ErrorContent is null && !ReferenceEquals(_focusedFor, CurrentException))
        {
            _focusedFor = CurrentException;
            await _fallback.FocusAsync();
        }
    }

    private void Reload() => Navigation.Refresh(forceReload: true);
}
