@namespace RTUB.Shared
@*
    Reusable component that combines SearchBar, FilterDropdown, and list rendering.
    Handles search and filtering logic in a single component.
*@
@typeparam TItem

<div class="searchable-list">
    @if (ShowSearch)
    {
        <div class="mb-3">
            <SearchBar @bind-Value="SearchTerm"
                      Placeholder="@SearchPlaceholder"
                      OnSearch="@HandleSearch" />
        </div>
    }

    @if (FilterOptions != null && FilterOptions.Any())
    {
        <div class="mb-3">
            <FilterDropdown SelectedValue="@SelectedFilter"
                           SelectedValueChanged="@(value => SelectedFilter = value)"
                           OnChange="@HandleFilterChange"
                           AllItemsLabel="@FilterLabel"
                           Options="@FilterOptions"
                           ShowIcon="@FilterShowIcon" />
        </div>
    }

    @if (ChildContent != null)
    {
        @ChildContent(FilteredItems)
    }
</div>

@code {
    private readonly SearchHelper<TItem> _searchHelper = new();

    /// <summary>
    /// All items to search/filter
    /// </summary>
    [Parameter]
    public IEnumerable<TItem> Items { get; set; } = Enumerable.Empty<TItem>();

    /// <summary>
    /// Whether to show the search bar (default: true)
    /// </summary>
    [Parameter]
    public bool ShowSearch { get; set; } = true;

    /// <summary>
    /// Placeholder text for the search input
    /// </summary>
    [Parameter]
    public string SearchPlaceholder { get; set; } = "Pesquisar...";

    /// <summary>
    /// Functions to extract searchable strings from each item
    /// If not provided, uses ToString() on each item
    /// </summary>
    [Parameter]
    public List<Func<TItem, string>>? SearchSelectors { get; set; }

    /// <summary>
    /// Whether search should be case-sensitive (default: false)
    /// </summary>
    [Parameter]
    public bool CaseSensitive { get; set; } = false;

    /// <summary>
    /// Whether search should be accent-sensitive (default: false)
    /// </summary>
    [Parameter]
    public bool AccentSensitive { get; set; } = false;

    /// <summary>
    /// Filter dropdown options
    /// </summary>
    [Parameter]
    public IEnumerable<FilterDropdownOption>? FilterOptions { get; set; }

    /// <summary>
    /// Label for the "All items" filter option
    /// </summary>
    [Parameter]
    public string FilterLabel { get; set; } = "Todos";

    /// <summary>
    /// Whether to show icon in filter dropdown
    /// </summary>
    [Parameter]
    public bool FilterShowIcon { get; set; } = false;

    /// <summary>
    /// Custom filter function (overrides default filter logic)
    /// </summary>
    [Parameter]
    public Func<IEnumerable<TItem>, string, string, IEnumerable<TItem>>? CustomFilter { get; set; }

    /// <summary>
    /// Content to render for the filtered items
    /// Receives the filtered items collection as a parameter
    /// </summary>
    [Parameter]
    public RenderFragment<IEnumerable<TItem>>? ChildContent { get; set; }

    /// <summary>
    /// Callback when search term changes
    /// </summary>
    [Parameter]
    public EventCallback<string> OnSearchChanged { get; set; }

    /// <summary>
    /// Callback when filter changes
    /// </summary>
    [Parameter]
    public EventCallback<string> OnFilterChanged { get; set; }

    private string SearchTerm { get; set; } = string.Empty;
    private string SelectedFilter { get; set; } = string.Empty;

    private IEnumerable<TItem> FilteredItems
    {
        get
        {
            var items = Items.ToList();
            
            if (CustomFilter != null)
            {
                return CustomFilter(items, SearchTerm, SelectedFilter);
            }

            // Apply search
            if (!string.IsNullOrWhiteSpace(SearchTerm))
            {
                _searchHelper.SearchTerm = SearchTerm;
                
                if (SearchSelectors != null && SearchSelectors.Any())
                {
                    items = _searchHelper.FilterMultiple(items, SearchSelectors, CaseSensitive, AccentSensitive);
                }
                else
                {
                    items = _searchHelper.Filter(items, item => item?.ToString() ?? string.Empty, CaseSensitive);
                }
            }

            // Apply filter dropdown - parent should handle filter logic via CustomFilter
            // SelectedFilter is available for parent to use in CustomFilter

            return items;
        }
    }

    private async Task HandleSearch(string term)
    {
        SearchTerm = term;
        
        if (OnSearchChanged.HasDelegate)
        {
            await OnSearchChanged.InvokeAsync(term);
        }
        
        StateHasChanged();
    }

    private async Task HandleFilterChange()
    {
        if (OnFilterChanged.HasDelegate)
        {
            await OnFilterChanged.InvokeAsync(SelectedFilter);
        }
        
        StateHasChanged();
    }
}
