@namespace RTUB.Shared
@using Microsoft.AspNetCore.Components.Forms
@implements IDisposable
@*
    Block error: the validation summary of a form (from the cascaded EditContext) or an
    operation/load error passed in Errors. Announced when it appears (role="alert"); renders
    nothing while there is no error. Per-field messages belong to FormField; transient
    confirmations to the toast (docs/design/RTUB_UI_REFACTOR.md section 23.5).
*@

@if (HasErrors)
{
    <div class="error-display-container" role="alert">
        <div class="error-display-card">
            <i class="bi bi-exclamation-octagon-fill error-display-icon" aria-hidden="true"></i>
            <div class="error-display-content">
                <p class="error-display-title">@Title</p>
                @if (Errors != null && Errors.Any(e => !string.IsNullOrWhiteSpace(e)))
                {
                    <ul class="error-display-list">
                        @foreach (var error in Errors.Where(e => !string.IsNullOrWhiteSpace(e)))
                        {
                            <li class="error-display-item" @key="error">@error</li>
                        }
                    </ul>
                }
                else
                {
                    <ValidationSummary class="error-display-validation" />
                }
            </div>
        </div>
    </div>
}

@code {
    /// <summary>Headline of the error block</summary>
    [Parameter] public string Title { get; set; } = "Ocorreram erros de validação";

    /// <summary>Error messages to show instead of the form's validation summary</summary>
    [Parameter] public IEnumerable<string>? Errors { get; set; }

    /// <summary>EditContext from the parent EditForm (automatically cascaded)</summary>
    [CascadingParameter] public EditContext? EditContext { get; set; }

    private EditContext? _subscribedContext;

    private bool HasErrors =>
        Errors?.Any(e => !string.IsNullOrWhiteSpace(e)) == true
        || EditContext?.GetValidationMessages().Any() == true;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_subscribedContext, EditContext))
        {
            return;
        }

        Unsubscribe();
        _subscribedContext = EditContext;
        if (_subscribedContext != null)
        {
            _subscribedContext.OnValidationStateChanged += OnValidationStateChanged;
        }
    }

    private void OnValidationStateChanged(object? sender, ValidationStateChangedEventArgs e) => StateHasChanged();

    private void Unsubscribe()
    {
        if (_subscribedContext != null)
        {
            _subscribedContext.OnValidationStateChanged -= OnValidationStateChanged;
        }
    }

    public void Dispose() => Unsubscribe();
}
