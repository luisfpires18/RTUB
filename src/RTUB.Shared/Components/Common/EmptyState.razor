@namespace RTUB.Shared
@*
    "Nothing here" for a list, section or search: icon, title, optional message and one optional
    next step (a button or a link). Compact on purpose - it should not dominate the page
    (docs/design/RTUB_UI_REFACTOR.md section 23.3). The title is a paragraph, not a heading:
    it describes the state of the section it sits in, it does not start a new one.
*@

<div class="empty-state-container">
    <div class="empty-state-card">
        @if (!string.IsNullOrEmpty(Icon))
        {
            <span class="empty-state-icon" aria-hidden="true"><i class="bi @Icon"></i></span>
        }
        <p class="empty-state-title">@Title</p>
        @if (!string.IsNullOrEmpty(Message))
        {
            <p class="empty-state-message">@Message</p>
        }
        @if (!string.IsNullOrEmpty(ActionText))
        {
            @if (!string.IsNullOrEmpty(ActionUrl))
            {
                <a href="@ActionUrl" class="btn btn-primary btn-sm empty-state-action">@ActionText</a>
            }
            else if (OnAction.HasDelegate)
            {
                <button type="button" class="btn btn-primary btn-sm empty-state-action" @onclick="OnAction">@ActionText</button>
            }
        }
    </div>
</div>

@code {
    /// <summary>What is empty, in the user's words (e.g. "Sem ensaios marcados")</summary>
    [Parameter] public string Title { get; set; } = "Sem resultados";

    /// <summary>Optional context: why it is empty or what to do next</summary>
    [Parameter] public string? Message { get; set; }

    /// <summary>Bootstrap icon class (e.g. "bi-inbox", "bi-search")</summary>
    [Parameter] public string? Icon { get; set; }

    /// <summary>Label of the optional next-step action</summary>
    [Parameter] public string? ActionText { get; set; }

    /// <summary>Makes the action a link to this URL</summary>
    [Parameter] public string? ActionUrl { get; set; }

    /// <summary>Makes the action a button that runs this callback</summary>
    [Parameter] public EventCallback OnAction { get; set; }
}
