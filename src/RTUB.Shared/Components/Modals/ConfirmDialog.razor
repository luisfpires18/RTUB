@namespace RTUB.Shared
@*
    Shared confirmation on top of Modal (UI refactor 035; contract:
    docs/design/RTUB_UI_REFACTOR.md section 22).

    Intent follows the confirm button the caller already chooses: btn-danger = destructive
    (warning triangle, red), btn-warning = caution, anything else = a plain confirmation.
    Cancel comes first and takes focus when the dialog opens; the confirm action is last.
    Escape cancels. While OnConfirm runs, both buttons are disabled, the confirm button shows a
    spinner and the dialog cannot be dismissed, so a double click cannot confirm twice.
*@

<Modal Show="@Show"
       ShowChanged="@ShowChanged"
       Title="@Title"
       Size="@Size"
       Centered="true"
       ShowCloseButton="@ShowCloseButton"
       CloseOnEscape="true"
       CanClose="CanDismissAsync"
       AriaDescribedBy="@(this.BodyContent == null ? _messageId : null)"
       OnClose="HandleCancel">
    <BodyContent>
        @if (this.BodyContent != null)
        {
            @this.BodyContent
        }
        else
        {
            <div class="confirm-dialog confirm-dialog--@Intent" id="@_messageId">
                <span class="confirm-dialog__icon" aria-hidden="true"><i class="bi @IconClass"></i></span>
                <div class="confirm-dialog__text">
                    @if (!string.IsNullOrEmpty(Message))
                    {
                        <p class="confirm-dialog__message u-break-anywhere">@Message</p>
                    }
                    @if (!string.IsNullOrEmpty(WarningMessage))
                    {
                        <p class="confirm-dialog__warning">@WarningMessage</p>
                    }
                </div>
            </div>
        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-outline-secondary" @onclick="HandleCancel" disabled="@IsLocked" data-autofocus>
            <i class="bi bi-arrow-left me-2" aria-hidden="true"></i>@CancelText
        </button>
        <button type="button" class="btn @ConfirmButtonClass" @onclick="HandleConfirm" disabled="@IsLocked"
                aria-busy="@(_confirming ? "true" : null)">
            @if (_confirming)
            {
                <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
            }
            else
            {
                <i class="bi bi-@(Intent == "danger" ? "trash" : "check-circle") me-2" aria-hidden="true"></i>
            }
            @ConfirmText
        </button>
    </FooterContent>
</Modal>

@code {
    /// <summary>
    /// Controls whether the dialog is visible
    /// </summary>
    [Parameter]
    public bool Show { get; set; }

    /// <summary>
    /// Event callback when Show state changes
    /// </summary>
    [Parameter]
    public EventCallback<bool> ShowChanged { get; set; }

    /// <summary>
    /// Dialog title
    /// </summary>
    [Parameter]
    public string Title { get; set; } = "Confirmar";

    /// <summary>
    /// Simple message to display (alternative to BodyContent)
    /// </summary>
    [Parameter]
    public string? Message { get; set; }

    /// <summary>
    /// Warning message displayed below main message
    /// </summary>
    [Parameter]
    public string? WarningMessage { get; set; }

    /// <summary>
    /// Custom body content
    /// </summary>
    [Parameter]
    public RenderFragment? BodyContent { get; set; }

    /// <summary>
    /// Text for confirm button
    /// </summary>
    [Parameter]
    public string ConfirmText { get; set; } = "Confirmar";

    /// <summary>
    /// Text for cancel button
    /// </summary>
    [Parameter]
    public string CancelText { get; set; } = "Cancelar";

    /// <summary>
    /// CSS class for confirm button. It also sets the dialog's intent: "btn-danger" marks a
    /// destructive confirmation, "btn-warning" a cautionary one.
    /// </summary>
    [Parameter]
    public string ConfirmButtonClass { get; set; } = "btn-primary";

    /// <summary>
    /// Event callback when user confirms
    /// </summary>
    [Parameter]
    public EventCallback OnConfirm { get; set; }

    /// <summary>
    /// Event callback when user cancels
    /// </summary>
    [Parameter]
    public EventCallback OnCancel { get; set; }

    /// <summary>
    /// Modal size
    /// </summary>
    [Parameter]
    public Modal.ModalSize Size { get; set; } = Modal.ModalSize.Small;

    /// <summary>
    /// Whether to show close button in header
    /// </summary>
    [Parameter]
    public bool ShowCloseButton { get; set; } = false;

    /// <summary>
    /// Whether to disable the buttons (useful during async operations)
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; } = false;

    private readonly string _messageId = "rtub-confirm-" + Guid.NewGuid().ToString("N")[..10];
    private bool _confirming;

    private bool IsLocked => Disabled || _confirming;

    /// <summary>"danger", "warning" or "default", from <see cref="ConfirmButtonClass"/>.</summary>
    private string Intent =>
        ConfirmButtonClass.Contains("btn-danger", StringComparison.Ordinal) ? "danger"
        : ConfirmButtonClass.Contains("btn-warning", StringComparison.Ordinal) ? "warning"
        : "default";

    private string IconClass => Intent switch
    {
        "danger" => "bi-exclamation-triangle-fill",
        "warning" => "bi-exclamation-circle-fill",
        _ => "bi-question-circle-fill"
    };

    private Task<bool> CanDismissAsync() => Task.FromResult(!IsLocked);

    private async Task HandleConfirm()
    {
        if (IsLocked)
        {
            return;
        }

        _confirming = true;
        try
        {
            await OnConfirm.InvokeAsync();
        }
        finally
        {
            _confirming = false;
        }

        Show = false;
        await ShowChanged.InvokeAsync(false);
    }

    private async Task HandleCancel()
    {
        if (_confirming)
        {
            return;
        }

        await OnCancel.InvokeAsync();
        Show = false;
        await ShowChanged.InvokeAsync(false);
    }
}
