@namespace RTUB.Shared
@*
    RepertoireModal Component
    Modal for displaying and managing event repertoire with drag and drop functionality
    Supports multi-day events with separate repertoires per day
*@
@using RTUB.Application.Interfaces
@using RTUB.Core.Entities
@inject IEventRepertoireService RepertoireService
@inject ISongService SongService

<Modal Show="@Show" 
       ShowChanged="@((bool show) => OnShowChanged(show))"
       Title="@($"Repertório - {EventName}")" 
       Size="Modal.ModalSize.Large"
       Centered="true">
    <BodyContent>
        @if (isLoading)
        {
            <LoadingSpinner />
        }
        else
        {
            @* Multi-day event tabs *@
            @if (eventDates != null && eventDates.Count > 1)
            {
                <div class="repertoire-tabs mb-3">
                    <ul class="nav nav-tabs">
                        @foreach (var date in eventDates)
                        {
                            <li class="nav-item">
                                <button class="nav-link @(selectedDate == date ? "active" : "")" @key="date"
                                        @onclick="() => SelectDate(date)"
                                        aria-label="Selecionar data @date.ToString("dd/MM/yyyy")">
                                    @date.ToString("dd MMM yyyy", new System.Globalization.CultureInfo("pt-PT"))
                                    @if (IsAdmin)
                                    {
                                        <button class="btn btn-sm admin-btn-delete ms-2" 
                                                @onclick="@(() => ConfirmDeleteDay(date))"
                                                @onclick:stopPropagation="true"
                                                title="Apagar dia e repertório"
                                                type="button">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </button>
                            </li>
                        }
                    </ul>
                </div>
            }

            @if (IsAdmin)
            {
                <div class="mb-3">
                    <h6 class="text-white-full mb-2">Adicionar Música</h6>
                    <div class="d-flex gap-2">
                        <select class="form-select form-select-dark flex-grow-1" @bind="selectedSongId">
                            <option value="0">Selecionar música...</option>
                            @foreach (var song in availableSongs)
                            {
                                <option value="@song.Id" @key="song.Id">@song.Title</option>
                            }
                        </select>
                        <button class="btn btn-success" @onclick="AddSongToRepertoire" disabled="@(selectedSongId == 0)">
                            <i class="bi bi-plus-lg"></i> Adicionar
                        </button>
                    </div>
                </div>
                <hr class="repertoire-divider" />
            }

            @if (repertoireItems == null || !repertoireItems.Any())
            {
                <div class="text-center py-4">
                    <i class="bi bi-music-note-list repertoire-empty-icon"></i>
                    <p class="text-muted mt-2">Nenhuma música no repertório</p>
                </div>
            }
            else
            {
                <div class="repertoire-list">
                    @{
                        var orderedItems = repertoireItems.OrderBy(r => r.DisplayOrder).ToList();
                    }
                    @for (int i = 0; i < orderedItems.Count; i++)
                    {
                        var item = orderedItems[i];
                        var displayIndex = i + 1; // Per-day index starting at 1
                        <div class="repertoire-card @(draggingItemId == item.Id ? "dragging" : "") @(dragOverItemId == item.Id ? "drag-over" : "")"
                             draggable="@(IsAdmin ? "true" : "false")"
                             @ondragstart="@(() => HandleDragStart(item.Id))"
                             @ondragover="HandleDragOver"
                             @ondragover:preventDefault
                             @ondragenter="@(() => HandleDragEnter(item.Id))"
                             @ondragleave="@(() => HandleDragLeave())"
                             @ondrop="@(async () => await HandleDrop(item.Id))"
                             @ondragend="@(() => HandleDragEnd())">
                            
                            <div class="repertoire-card-content">
                                @if (IsAdmin)
                                {
                                    <div class="drag-handle" title="Arrastar para reordenar">
                                        <i class="bi bi-grip-vertical"></i>
                                    </div>
                                }
                                
                                <span class="repertoire-item-number">@displayIndex.</span>
                                <span class="repertoire-item-text">@item.Song?.Title</span>
                                
                                @if (IsAdmin)
                                {
                                    <button class="btn-icon-delete" 
                                            @onclick="@(() => RemoveSongFromRepertoire(item.Id))"
                                            @onclick:stopPropagation="true"
                                            title="Remover"
                                            type="button">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="Close">Voltar Atrás</button>
    </FooterContent>
</Modal>

<ConfirmDialog Show="@showDeleteDayConfirmation"
               ShowChanged="@(show => showDeleteDayConfirmation = show)"
               Title="Confirmar Eliminação"
               Message="@($"Tem certeza que deseja eliminar todo o repertório do dia {dayToDelete?.ToString("dd MMM yyyy", new System.Globalization.CultureInfo("pt-PT"))}?")"
               WarningMessage="Esta ação não pode ser desfeita."
               ConfirmText="Eliminar"
               ConfirmButtonClass="btn-danger"
               OnConfirm="@DeleteDay"
               OnCancel="@CancelDeleteDay" />

@code {
    [Parameter]
    public bool Show { get; set; }

    [Parameter]
    public EventCallback<bool> ShowChanged { get; set; }

    [Parameter]
    public int EventId { get; set; }

    [Parameter]
    public string EventName { get; set; } = string.Empty;
    
    [Parameter]
    public DateTime EventDate { get; set; }
    
    [Parameter]
    public DateTime? EventEndDate { get; set; }

    [Parameter]
    public bool IsAdmin { get; set; }

    [Parameter]
    public EventCallback OnRepertoireChanged { get; set; }

    private List<DateTime> eventDates = new();
    private DateTime selectedDate;
    private List<EventRepertoire>? repertoireItems;
    private List<Song>? allSongs;
    private List<Song> availableSongs = new();
    
    private int selectedSongId = 0;
    private bool isLoading = false;
    private int? draggingItemId = null;
    private int? dragOverItemId = null;
    
    private bool showDeleteDayConfirmation = false;
    private DateTime? dayToDelete = null;

    protected override async Task OnParametersSetAsync()
    {
        if (Show && EventId > 0)
        {
            await InitializeEventDatesAsync();
            await LoadRepertoire();
            if (IsAdmin)
            {
                await LoadAllSongs();
                UpdateAvailableSongs();
            }
        }
    }

    private async Task InitializeEventDatesAsync()
    {
        eventDates.Clear();

        var repertoireDates = (await RepertoireService.GetRepertoireDatesAsync(EventId)).ToList();

        if (repertoireDates.Any())
        {
            eventDates.AddRange(repertoireDates);
        }
        else
        {
            var startDate = EventDate.Date;
            var endDate = EventEndDate?.Date ?? startDate;

            // Generate list of dates from start to end
            for (var date = startDate; date <= endDate; date = date.AddDays(1))
            {
                eventDates.Add(date);
            }
        }

        // Select first date by default
        selectedDate = eventDates.FirstOrDefault();
    }

    private async Task SelectDate(DateTime date)
    {
        selectedDate = date;
        await LoadRepertoire();
        UpdateAvailableSongs();
    }

    private async Task LoadRepertoire()
    {
        isLoading = true;
        try
        {
            repertoireItems = (await RepertoireService.GetRepertoireByEventIdAsync(EventId, selectedDate)).ToList();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadAllSongs()
    {
        var songs = await SongService.GetAllSongsAsync();
        
        // Deduplicate songs by title (case-insensitive) and sort alphabetically
        // Note: HashSet.Add() returns true if the item was added (not already present),
        // allowing us to filter duplicates in a single LINQ pass
        var seenTitles = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        allSongs = songs
            .Where(s => seenTitles.Add(s.Title))
            .OrderBy(s => s.Title)
            .ToList();
    }
    
    private void UpdateAvailableSongs()
    {
        if (allSongs == null)
        {
            availableSongs = new List<Song>();
            return;
        }
        
        // Filter out songs already in the current day's repertoire
        availableSongs = allSongs
            .Where(s => repertoireItems?.All(r => r.SongId != s.Id) ?? true)
            .ToList();
    }

    private async Task AddSongToRepertoire()
    {
        if (selectedSongId == 0) return;

        try
        {
            var nextOrder = (repertoireItems?.Any() ?? false) 
                ? repertoireItems!.Max(r => r.DisplayOrder) + 1 
                : 1;

            await RepertoireService.AddSongToRepertoireAsync(EventId, selectedSongId, nextOrder, selectedDate);
            await LoadRepertoire();
            selectedSongId = 0;
            UpdateAvailableSongs();
            await OnRepertoireChanged.InvokeAsync();
        }
        catch (Exception)
        {
            // Handle error - song already in repertoire for this date
        }
    }

    private async Task RemoveSongFromRepertoire(int repertoireItemId)
    {
        if (!IsAdmin) return;

        await RepertoireService.RemoveSongFromRepertoireAsync(repertoireItemId);
        await LoadRepertoire();
        UpdateAvailableSongs();
        await OnRepertoireChanged.InvokeAsync();
    }
    
    private void ConfirmDeleteDay(DateTime date)
    {
        dayToDelete = date;
        showDeleteDayConfirmation = true;
    }
    
    private void CancelDeleteDay()
    {
        dayToDelete = null;
        showDeleteDayConfirmation = false;
    }
    
    private async Task DeleteDay()
    {
        if (!IsAdmin || dayToDelete == null) return;
        
        var dateToDelete = dayToDelete.Value;
        
        // Determine which date to select after deletion BEFORE removing from list
        DateTime? newSelectedDate = null;
        if (selectedDate == dateToDelete && eventDates.Count > 1)
        {
            var index = eventDates.IndexOf(dateToDelete);
            if (index > 0)
            {
                // Select previous date
                newSelectedDate = eventDates[index - 1];
            }
            else
            {
                // Select next date
                newSelectedDate = eventDates[index + 1];
            }
        }
        
        // Remove the day's repertoire from database
        await RepertoireService.RemoveRepertoireDayAsync(EventId, dateToDelete);
        
        // Remove the date from the eventDates list
        eventDates.Remove(dateToDelete);
        
        // Update selected date if necessary
        if (selectedDate == dateToDelete)
        {
            if (newSelectedDate.HasValue)
            {
                selectedDate = newSelectedDate.Value;
            }
            else if (eventDates.Any())
            {
                // Fallback to first available date
                selectedDate = eventDates.FirstOrDefault();
            }
            else
            {
                // No more dates - close the modal
                await Close();
                return;
            }
        }
        
        showDeleteDayConfirmation = false;
        dayToDelete = null;
        
        // Reload repertoire for the newly selected date
        await LoadRepertoire();
        UpdateAvailableSongs();
        await OnRepertoireChanged.InvokeAsync();
    }

    private void HandleDragStart(int itemId)
    {
        if (!IsAdmin) return;
        draggingItemId = itemId;
        dragOverItemId = null;
    }

    private void HandleDragEnter(int itemId)
    {
        if (!IsAdmin || draggingItemId == null || draggingItemId == itemId) return;
        dragOverItemId = itemId;
    }

    private void HandleDragLeave()
    {
        if (!IsAdmin) return;
        dragOverItemId = null;
    }

    private void HandleDragOver()
    {
        // Combined with @ondragover:preventDefault directive to allow drops
        if (!IsAdmin) return;
    }

    private void HandleDragEnd()
    {
        if (!IsAdmin) return;
        // Always clean up drag state when drag ends
        draggingItemId = null;
        dragOverItemId = null;
    }

    private async Task HandleDrop(int targetItemId)
    {
        
        if (!IsAdmin || draggingItemId == null || draggingItemId == targetItemId) 
        {
            // Clean up even if we don't process the drop
            draggingItemId = null;
            dragOverItemId = null;
            return;
        }

        var draggingItem = repertoireItems?.FirstOrDefault(r => r.Id == draggingItemId);
        var targetItem = repertoireItems?.FirstOrDefault(r => r.Id == targetItemId);

        if (draggingItem != null && targetItem != null)
        {
            // Get the current ordered list
            var orderedList = repertoireItems!.OrderBy(r => r.DisplayOrder).ToList();
            
            // Find current indices
            var draggedIndex = orderedList.IndexOf(draggingItem);
            var targetIndex = orderedList.IndexOf(targetItem);
            
            // Generic list reordering algorithm for drag-and-drop:
            // Goal: Move dragged item to target's position (swap places with target)
            
            // 1. Remove the dragged item
            orderedList.RemoveAt(draggedIndex);
            
            // 2. Calculate insertion index:
            //    - Moving DOWN (draggedIndex < targetIndex): 
            //        After removal, target shifts left by 1, so it's at (targetIndex - 1)
            //        We want to go AFTER the target, so insert at targetIndex
            //    - Moving UP (draggedIndex > targetIndex):
            //        Target position unchanged by removal, it's still at targetIndex
            //        We want to go AT the target position, so insert at targetIndex
            var insertIndex = (draggedIndex < targetIndex) ? targetIndex : targetIndex;
            
            // 3. Insert at calculated position
            orderedList.Insert(insertIndex, draggingItem);

            // Update display orders based on new list order
            var songIds = orderedList.Select(r => r.SongId).ToList();
            
            await RepertoireService.UpdateRepertoireOrderAsync(EventId, selectedDate, songIds);
            
            // Force reload to get updated order from database
            await LoadRepertoire();
            
            await OnRepertoireChanged.InvokeAsync();
            
            // Force UI refresh
            StateHasChanged();
        }
        else
        {
            Console.WriteLine($"[HandleDrop] Items not found - cannot reorder");
        }

        // Clean up drag state - don't wait for dragend as it may not fire consistently
        draggingItemId = null;
        dragOverItemId = null;
    }

    private async Task OnShowChanged(bool show)
    {
        Show = show;
        await ShowChanged.InvokeAsync(show);
    }

    private async Task Close()
    {
        await OnShowChanged(false);
    }
}
