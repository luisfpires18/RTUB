@namespace RTUB.Shared
@*
    RepertoireModal Component
    Read-only view of an event's repertoire, one tab per day on multi-day events.
    Adding, removing and reordering songs is done on the React event page (React track 012D).
*@
@using RTUB.Application.Interfaces
@using RTUB.Core.Entities
@inject IEventRepertoireService RepertoireService

<Modal Show="@Show"
       ShowChanged="@((bool show) => OnShowChanged(show))"
       Title="@($"Repertório - {EventName}")"
       Size="Modal.ModalSize.Large"
       Centered="true">
    <BodyContent>
        @if (isLoading)
        {
            <LoadingSpinner />
        }
        else
        {
            @* Multi-day event tabs *@
            @if (eventDates != null && eventDates.Count > 1)
            {
                <div class="repertoire-tabs mb-3">
                    <ul class="nav nav-tabs">
                        @foreach (var date in eventDates)
                        {
                            <li class="nav-item">
                                <button class="nav-link @(selectedDate == date ? "active" : "")" @key="date"
                                        @onclick="() => SelectDate(date)"
                                        aria-label="Selecionar data @date.ToString("dd/MM/yyyy")">
                                    @date.ToString("dd MMM yyyy", new System.Globalization.CultureInfo("pt-PT"))
                                </button>
                            </li>
                        }
                    </ul>
                </div>
            }
            @if (repertoireItems == null || !repertoireItems.Any())
            {
                <div class="text-center py-4">
                    <i class="bi bi-music-note-list repertoire-empty-icon"></i>
                    <p class="text-muted mt-2">Nenhuma música no repertório</p>
                </div>
            }
            else
            {
                <div class="repertoire-list">
                    @{
                        var orderedItems = repertoireItems.OrderBy(r => r.DisplayOrder).ToList();
                    }
                    @for (int i = 0; i < orderedItems.Count; i++)
                    {
                        var item = orderedItems[i];
                        var displayIndex = i + 1; // Per-day index starting at 1
                        <div class="repertoire-card">
                            <div class="repertoire-card-content">
                                <span class="repertoire-item-number">@displayIndex.</span>
                                <span class="repertoire-item-text">@item.Song?.Title</span>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="Close">Voltar Atrás</button>
    </FooterContent>
</Modal>

@code {
    [Parameter]
    public bool Show { get; set; }

    [Parameter]
    public EventCallback<bool> ShowChanged { get; set; }

    [Parameter]
    public int EventId { get; set; }

    [Parameter]
    public string EventName { get; set; } = string.Empty;

    [Parameter]
    public DateTime EventDate { get; set; }

    [Parameter]
    public DateTime? EventEndDate { get; set; }

    private List<DateTime> eventDates = new();
    private DateTime selectedDate;
    private List<EventRepertoire>? repertoireItems;
    private bool isLoading = false;

    protected override async Task OnParametersSetAsync()
    {
        if (Show && EventId > 0)
        {
            await InitializeEventDatesAsync();
            await LoadRepertoire();
        }
    }

    private async Task InitializeEventDatesAsync()
    {
        eventDates.Clear();

        var repertoireDates = (await RepertoireService.GetRepertoireDatesAsync(EventId)).ToList();

        if (repertoireDates.Any())
        {
            eventDates.AddRange(repertoireDates);
        }
        else
        {
            var startDate = EventDate.Date;
            var endDate = EventEndDate?.Date ?? startDate;

            // Generate list of dates from start to end
            for (var date = startDate; date <= endDate; date = date.AddDays(1))
            {
                eventDates.Add(date);
            }
        }

        // Select first date by default
        selectedDate = eventDates.FirstOrDefault();
    }

    private async Task SelectDate(DateTime date)
    {
        selectedDate = date;
        await LoadRepertoire();
    }

    private async Task LoadRepertoire()
    {
        isLoading = true;
        try
        {
            repertoireItems = (await RepertoireService.GetRepertoireByEventIdAsync(EventId, selectedDate)).ToList();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnShowChanged(bool show)
    {
        Show = show;
        await ShowChanged.InvokeAsync(show);
    }

    private async Task Close()
    {
        await OnShowChanged(false);
    }
}
