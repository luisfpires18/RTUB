@namespace RTUB.Shared
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable
@*
    Shared dialog (UI refactor 035; contract: docs/design/RTUB_UI_REFACTOR.md section 22).

    Phones (< 768px): full-screen sheet with a bottom action bar; Small dialogs stay a centered
    box. Larger screens: a dialog sized by Size.
    Semantics and focus: role="dialog" + aria-modal, named by its title. On open, focus moves to
    the element marked data-autofocus (else the dialog itself); Tab stays inside; on close focus
    returns to the control that opened it (modalHelper.js).
    Dismissal: the close button, Escape (CloseOnEscape, default ShowCloseButton), the default
    footer and callers' Cancel buttons (RequestCloseAsync via @ref) all ask CanClose, then - with
    IsDirty - "Descartar alterações?". Clicking the backdrop never closes a dialog.
    Back/Forward while open (UI refactor 037, section 24.5; modalHelper.js): the page underneath
    does not navigate; the top dialog closes as with Escape (a non-dismissible one stays), a
    dirty one asking first. In-app navigation away from a dirty dialog asks too (its guard).
*@

@if (Show)
{
    <div class="modal-backdrop show"></div>
    <div class="modal show d-block" id="@_id" tabindex="-1" role="dialog" aria-modal="true"
         aria-labelledby="@(ShowsTitle ? TitleId : null)"
         aria-label="@(ShowsTitle || string.IsNullOrEmpty(Title) ? null : Title)"
         aria-describedby="@AriaDescribedBy">
        <div class="modal-dialog @SizeClass @(Centered ? "modal-dialog-centered" : "")">
            <div class="modal-content">
                @if (!string.IsNullOrEmpty(Title) || ShowCloseButton || HeaderActions != null)
                {
                    <div class="modal-header modal-header-primary">
                        @if (HeaderActions != null)
                        {
                            <div class="modal-header-actions">
                                @HeaderActions
                            </div>
                        }
                        else if (!string.IsNullOrEmpty(Title))
                        {
                            <h2 class="modal-title" id="@TitleId">@Title</h2>
                        }
                        @if (ShowCloseButton)
                        {
                            @* One control: an X at the right on larger screens, a back arrow at the
                               left of the phone sheet (modals.css). *@
                            <button type="button" class="modal-close" @onclick="RequestCloseAsync" aria-label="Fechar">
                                <i class="bi bi-x-lg modal-close__icon-dialog" aria-hidden="true"></i>
                                <i class="bi bi-arrow-left modal-close__icon-sheet" aria-hidden="true"></i>
                            </button>
                        }
                    </div>
                }
                <div class="modal-body">
                    @BodyContent
                </div>
                @if (FooterContent != null)
                {
                    <div class="modal-footer">
                        @FooterContent
                    </div>
                }
                else if (ShowCloseButton)
                {
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="RequestCloseAsync">Voltar Atrás</button>
                    </div>
                }
            </div>
        </div>
    </div>
    @* After the dialog, so its "Descartar alterações?" layer paints on top. *@
    @if (IsDirty != null)
    {
        <UnsavedChangesGuard @ref="_guard" IsDirty="IsDirty" OnDiscard="CloseAsync" />
    }
}

@code {
    /// <summary>
    /// Controls whether the modal is visible
    /// </summary>
    [Parameter]
    public bool Show { get; set; }

    /// <summary>
    /// Event callback when Show state changes
    /// </summary>
    [Parameter]
    public EventCallback<bool> ShowChanged { get; set; }

    /// <summary>
    /// Modal title displayed in header; also the dialog's accessible name
    /// </summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>
    /// Body content of the modal
    /// </summary>
    [Parameter]
    public RenderFragment? BodyContent { get; set; }

    /// <summary>
    /// Footer content (buttons, actions, etc.)
    /// </summary>
    [Parameter]
    public RenderFragment? FooterContent { get; set; }

    /// <summary>
    /// Header actions content (buttons, links, etc.), shown instead of the title heading
    /// </summary>
    [Parameter]
    public RenderFragment? HeaderActions { get; set; }

    /// <summary>
    /// Modal size: Small, Default, Large, ExtraLarge
    /// </summary>
    [Parameter]
    public ModalSize Size { get; set; } = ModalSize.Default;

    /// <summary>
    /// Whether the dialog can be dismissed with a close button in its header
    /// </summary>
    [Parameter]
    public bool ShowCloseButton { get; set; } = true;

    /// <summary>
    /// Whether Escape dismisses the dialog. Defaults to <see cref="ShowCloseButton"/>: a dialog
    /// without a close button is not dismissible unless it opts in.
    /// </summary>
    [Parameter]
    public bool? CloseOnEscape { get; set; }

    /// <summary>
    /// Asked before any user dismissal (close button, Escape, default footer). Return false to
    /// keep the dialog open, e.g. while an operation runs or to confirm discarding changes.
    /// </summary>
    [Parameter]
    public Func<Task<bool>>? CanClose { get; set; }

    /// <summary>
    /// Whether the dialog's form has unsaved changes (usually <c>() =&gt; changes.IsDirty</c>).
    /// When it does, dismissal asks "Descartar alterações?" and reload/tab close get the browser's
    /// prompt. Leave unset for read-only and confirmation dialogs.
    /// </summary>
    [Parameter]
    public Func<bool>? IsDirty { get; set; }

    /// <summary>
    /// Id of the element that describes the dialog (read after its name), e.g. a confirmation message
    /// </summary>
    [Parameter]
    public string? AriaDescribedBy { get; set; }

    /// <summary>
    /// Whether to center the modal vertically
    /// </summary>
    [Parameter]
    public bool Centered { get; set; } = false;

    /// <summary>
    /// Event callback when modal is closed
    /// </summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    private readonly string _id = "rtub-dialog-" + Guid.NewGuid().ToString("N")[..10];
    private string TitleId => _id + "-title";
    private bool ShowsTitle => HeaderActions == null && !string.IsNullOrEmpty(Title);

    private UnsavedChangesGuard? _guard;
    private bool _renderedShow = false;
    private bool _registered = false;
    private DotNetObjectReference<Modal>? _selfReference;

    private string SizeClass => Size switch
    {
        ModalSize.Small => "modal-sm",
        ModalSize.Large => "modal-lg",
        ModalSize.ExtraLarge => "modal-xl",
        _ => ""
    };

    /// <summary>
    /// Optimize rendering - only re-render while visible or when Show changed since the last
    /// render. (The first render skips ShouldRender, so the rendered state is recorded after each
    /// render; a dialog first rendered open can then still be hidden by its parent.)
    /// </summary>
    protected override bool ShouldRender() => Show || Show != _renderedShow;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _renderedShow = Show;

        if (Show && !_registered)
        {
            _registered = true;
            _selfReference ??= DotNetObjectReference.Create(this);
            await InvokeHelperAsync("modalHelper.openDialog", _id, _selfReference, CloseOnEscape ?? ShowCloseButton);
        }
        else if (!Show && _registered)
        {
            _registered = false;
            await InvokeHelperAsync("modalHelper.closeDialog", _id);
        }
    }

    /// <summary>Escape pressed while this is the top dialog (modalHelper.js).</summary>
    [JSInvokable]
    public Task HandleEscape() => InvokeAsync(async () =>
    {
        await RequestCloseAsync();
        // A JS call is not a UI event, so re-render here as the close button's click would.
        StateHasChanged();
    });

    /// <summary>
    /// Closes the dialog as the user asked: CanClose first, then the unsaved-changes question.
    /// Returns whether it closed. Use it for Cancel buttons (<c>@ref</c> the Modal).
    /// </summary>
    public async Task<bool> RequestCloseAsync()
    {
        if (CanClose != null && !await CanClose())
        {
            return false;
        }

        if (_guard != null && !await _guard.ConfirmDiscardAsync())
        {
            return false;
        }

        await CloseAsync();
        return true;
    }

    private async Task CloseAsync()
    {
        Show = false;
        await ShowChanged.InvokeAsync(false);
        await OnClose.InvokeAsync();
    }

    /// <summary>Back/Forward while this is the top dialog (modalHelper.js): same as Escape.</summary>
    [JSInvokable]
    public Task HandleBack() => InvokeAsync(async () =>
    {
        if (CloseOnEscape ?? ShowCloseButton)
        {
            await RequestCloseAsync();
            StateHasChanged();
        }
    });

    private async Task InvokeHelperAsync(string identifier, params object?[] args)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync(identifier, args);
        }
        catch (JSException)
        {
            // Focus and scroll lock are enhancements; the dialog still works without them.
        }
        catch (JSDisconnectedException)
        {
            // Circuit gone; nothing to restore.
        }
        catch (TaskCanceledException)
        {
            // Navigated away.
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_registered)
        {
            _registered = false;
            await InvokeHelperAsync("modalHelper.closeDialog", _id);
        }

        _selfReference?.Dispose();
    }

    public enum ModalSize
    {
        Small,
        Default,
        Large,
        ExtraLarge
    }
}
