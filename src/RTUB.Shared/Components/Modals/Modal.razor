@namespace RTUB.Shared
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable
@* 
    Reusable Modal Component
    Used across the application for dialogs and modals
*@

@if (Show)
{
    <div class="modal-backdrop show"></div>
    <div class="modal show d-block" tabindex="-1" @onkeydown="HandleKeyDown">
        <div class="modal-dialog @SizeClass @(Centered ? "modal-dialog-centered" : "")">
            <div class="modal-content">
                @if (!string.IsNullOrEmpty(Title) || ShowCloseButton || HeaderActions != null)
                {
                    <div class="modal-header modal-header-primary">
                        @if (HeaderActions != null)
                        {
                            <div class="modal-header-actions">
                                @HeaderActions
                            </div>
                        }
                        else if (!string.IsNullOrEmpty(Title))
                        {
                            <h5 class="modal-title">@Title</h5>
                        }
                        @if (ShowCloseButton)
                        {
                            <button type="button" class="btn-close" @onclick="Close" aria-label="Fechar modal"></button>
                        }
                    </div>
                }
                <div class="modal-body">
                    @BodyContent
                </div>
                @if (FooterContent != null)
                {
                    <div class="modal-footer">
                        @FooterContent
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    /// <summary>
    /// Controls whether the modal is visible
    /// </summary>
    [Parameter]
    public bool Show { get; set; }

    /// <summary>
    /// Event callback when Show state changes
    /// </summary>
    [Parameter]
    public EventCallback<bool> ShowChanged { get; set; }

    /// <summary>
    /// Modal title displayed in header
    /// </summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>
    /// Body content of the modal
    /// </summary>
    [Parameter]
    public RenderFragment? BodyContent { get; set; }

    /// <summary>
    /// Footer content (buttons, actions, etc.)
    /// </summary>
    [Parameter]
    public RenderFragment? FooterContent { get; set; }

    /// <summary>
    /// Header actions content (buttons, links, etc.)
    /// </summary>
    [Parameter]
    public RenderFragment? HeaderActions { get; set; }

    /// <summary>
    /// Modal size: Small, Default, Large, ExtraLarge
    /// </summary>
    [Parameter]
    public ModalSize Size { get; set; } = ModalSize.Default;

    /// <summary>
    /// Whether to show close button in header
    /// </summary>
    [Parameter]
    public bool ShowCloseButton { get; set; } = true;

    /// <summary>
    /// Whether to center the modal vertically
    /// </summary>
    [Parameter]
    public bool Centered { get; set; } = false;

    /// <summary>
    /// Event callback when modal is closed
    /// </summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    private bool _previousShowState = false;
    private bool _bodyScrollLockApplied = false;
    
    // Retry delay for JS interop unlock operations (in milliseconds)
    private const int JsRetryDelayMs = 50;
    
    private string SizeClass => Size switch
    {
        ModalSize.Small => "modal-sm",
        ModalSize.Large => "modal-lg",
        ModalSize.ExtraLarge => "modal-xl",
        _ => ""
    };
    
    /// <summary>
    /// Optimize rendering - only re-render when Show state changes
    /// Always render when Show changes to ensure OnAfterRenderAsync is called for scroll unlock
    /// </summary>
    protected override bool ShouldRender()
    {
        if (Show != _previousShowState)
        {
            _previousShowState = Show;
            return true;
        }
        // Only render if modal is visible (Show == true)
        // When Show is false and hasn't changed, skip rendering (modal already hidden)
        return Show;
    }
    
    /// <summary>
    /// Handle modal show/hide state changes and manage body scroll lock
    /// Critical: Ensures body scroll is properly unlocked when modal closes
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Check if body scroll lock state needs to change
        if (Show && !_bodyScrollLockApplied)
        {
            // Modal opened - lock body scroll
            try
            {
                await JSRuntime.InvokeVoidAsync("modalHelper.lockBodyScroll");
                _bodyScrollLockApplied = true;
            }
            catch (JSException)
            {
                // Silent failure is acceptable here - modal will still function without scroll lock
                // This can occur during prerendering or if JS is disabled
                // The modal itself remains functional; scroll lock is a UX enhancement
            }
            catch (JSDisconnectedException)
            {
                // Circuit disconnected - benign, ignore
                // Modal is being disposed, no action needed
            }
            catch (TaskCanceledException)
            {
                // User navigated away - benign, ignore
                // Modal will be cleaned up by Blazor lifecycle
            }
        }
        else if (!Show && _bodyScrollLockApplied)
        {
            // Modal closed - unlock body scroll
            // CRITICAL FIX: Always attempt to unlock scroll when modal is hidden
            await UnlockBodyScrollAsync();
        }
    }
    
    /// <summary>
    /// Helper method to unlock body scroll with proper error handling
    /// </summary>
    private async Task UnlockBodyScrollAsync()
    {
        if (!_bodyScrollLockApplied)
        {
            return;
        }
        
        try
        {
            await JSRuntime.InvokeVoidAsync("modalHelper.unlockBodyScroll");
            _bodyScrollLockApplied = false;
        }
        catch (JSException)
        {
            // Try one more time in case of transient JS error
            // Short delay to allow JS to stabilize
            try
            {
                await Task.Delay(JsRetryDelayMs);
                await JSRuntime.InvokeVoidAsync("modalHelper.unlockBodyScroll");
                _bodyScrollLockApplied = false;
            }
            catch
            {
                // Give up but mark as unlocked to prevent further attempts
                _bodyScrollLockApplied = false;
            }
        }
        catch (JSDisconnectedException)
        {
            // Circuit disconnected - mark as unlocked
            _bodyScrollLockApplied = false;
        }
        catch (TaskCanceledException)
        {
            // User navigated away - mark as unlocked
            _bodyScrollLockApplied = false;
        }
    }

    private async Task Close()
    {
        Show = false;
        await ShowChanged.InvokeAsync(false);
        await OnClose.InvokeAsync();
    }
    
    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && ShowCloseButton)
        {
            await Close();
        }
    }
    
    /// <summary>
    /// Ensure body scroll is unlocked when component is disposed
    /// Critical fix for scroll lock issue when navigating away or component is removed
    /// </summary>
    public async ValueTask DisposeAsync()
    {
        await UnlockBodyScrollAsync();
    }

    public enum ModalSize
    {
        Small,
        Default,
        Large,
        ExtraLarge
    }
}
