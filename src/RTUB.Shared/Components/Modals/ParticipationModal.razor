@namespace RTUB.Shared
@using RTUB.Core.Enums
@using RTUB.Application.Helpers

@*
    ParticipationModal Component
    Unified modal for both event enrollment and rehearsal attendance
    Supports "WillAttend" selection for events and direct attendance for rehearsals
*@

<Modal Show="@Show" 
       ShowChanged="@ShowChanged"
       Title="@Title" 
       Size="Modal.ModalSize.Default"
       Centered="true">
    <BodyContent>
        <EditForm Model="@this" OnValidSubmit="@HandleSubmit" id="participationForm">
            <DataAnnotationsValidator />
            <ErrorDisplay Errors="@validationErrors" />

            @* Will Attend Selection (only for events with ShowWillAttend=true) *@
            @if (ShowWillAttend)
            {
                <div class="mb-4 participation-willattend">
                    <label class="form-label text-white-full fw-semibold d-flex align-items-center gap-2">
                        <i class="bi bi-person-check text-primary"></i>
                        <span>Vais participar?</span>
                    </label>
                    <div class="event-buttons-container justify-content-start">
                        <button type="button"
                                class="btn event-icon-btn btn-going @(WillAttend ? "btn-selected" : "btn-secondary-small")"
                                @onclick="@(() => OnWillAttendChanged(true))">
                            <i class="bi bi-check-circle-fill"></i>
                            <span class="btn-label">Vou</span>
                        </button>
                        <button type="button"
                                class="btn event-icon-btn btn-not-going @(!WillAttend ? "btn-selected" : "btn-secondary-small")"
                                @onclick="@(() => OnWillAttendChanged(false))">
                            <i class="bi bi-x-circle-fill"></i>
                            <span class="btn-label">Não vou</span>
                        </button>
                    </div>
                </div>
            }

            @* Only show instrument section if user is attending (WillAttend=true) *@
            @if (WillAttend)
            {
                @* Only show "Quero tocar" toggle for non-Leitão members *@
                @if (!IsLeitao)
                {
                    <div class="mb-3 form-check form-switch">
                        <input class="form-check-input clickable-row" type="checkbox" id="wantToPlayToggle"
                               checked="@WantToPlay"
                               disabled="@(!HasInstruments)"
                               @onchange="@((ChangeEventArgs e) => OnWantToPlayChanged((bool)e.Value!))">
                        <label class="form-check-label form-check-label-white-clickable" for="wantToPlayToggle">
                            Quero tocar
                        </label>
                    </div>

                    @if (!HasInstruments)
                    {
                        <small class="text-warning d-block mb-3">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            Não tens instrumentos configurados. Podes registar a tua presença sem instrumento.
                        </small>
                    }

                    @if (WantToPlay)
                    {
                        <div class="mb-3">
                            <label class="form-label text-white-full fw-semibold">
                                <i class="bi bi-music-note-beamed text-primary me-2"></i>Instrumento *
                            </label>
                            <InputSelect class="form-select form-select-dark" @bind-Value="Instrument" @bind-Value:after="@OnInstrumentChangedInternal">
                                <option value="">Selecionar...</option>
                                @if (AvailableInstruments != null && AvailableInstruments.Any())
                                {
                                    @foreach (var instrument in AvailableInstruments)
                                    {
                                        <option value="@instrument" @key="instrument">@StatusHelper.GetInstrumentDisplay(instrument)</option>
                                    }
                                }
                                else
                                {
                                    @foreach (var instrument in Enum.GetValues<InstrumentType>())
                                    {
                                        <option value="@instrument" @key="instrument">@StatusHelper.GetInstrumentDisplay(instrument)</option>
                                    }
                                }
                            </InputSelect>
                        </div>
                    }
                }
                else
                {
                    <div class="mb-3">
                        <label class="form-label text-white-full fw-semibold">
                            <i class="bi bi-music-note-beamed text-primary me-2"></i>Instrumento (Opcional)
                        </label>
                        <InputSelect class="form-select form-select-dark" @bind-Value="Instrument">
                            <option value="">Selecionar...</option>
                            @if (AvailableInstruments != null && AvailableInstruments.Any())
                            {
                                @foreach (var instrument in AvailableInstruments)
                                {
                                    <option value="@instrument" @key="instrument">@StatusHelper.GetInstrumentDisplay(instrument)</option>
                                }
                            }
                            else
                            {
                                @foreach (var instrument in Enum.GetValues<InstrumentType>())
                                {
                                    <option value="@instrument" @key="instrument">@StatusHelper.GetInstrumentDisplay(instrument)</option>
                                }
                            }
                        </InputSelect>
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label text-white-full fw-semibold">
                        <i class="bi bi-file-text text-primary me-2"></i>Notas (opcional)
                    </label>
                    <InputTextArea class="form-control" rows="@NotesRows" @bind-Value="Notes" @bind-Value:after="OnNotesChanged" placeholder="@NotesPlaceholder" />
                </div>
            }
            else
            {
                <div class="mb-3">
                    <label class="form-label text-white-full fw-semibold">
                        <i class="bi bi-file-text text-primary me-2"></i>Motivo (opcional)
                    </label>
                    <InputTextArea class="form-control" rows="@NotesRows" @bind-Value="Notes" @bind-Value:after="OnNotesChanged" placeholder="@NotesPlaceholder" />
                </div>
            }

        </EditForm>
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="HandleCancel">Cancelar</button>
        <button type="submit" form="participationForm" class="btn btn-primary btn-primary-purple">@SubmitButtonText</button>
    </FooterContent>
</Modal>

@code {
    private string instrumentValidationError = string.Empty;
    private List<string> validationErrors = new();

    /// <summary>
    /// Controls whether the modal is visible
    /// </summary>
    [Parameter]
    public bool Show { get; set; }

    /// <summary>
    /// Event callback when Show state changes
    /// </summary>
    [Parameter]
    public EventCallback<bool> ShowChanged { get; set; }

    /// <summary>
    /// Modal title
    /// </summary>
    [Parameter]
    public string Title { get; set; } = "Participação";

    /// <summary>
    /// Whether to show the "Vais participar?" section (true for events, false for rehearsals)
    /// </summary>
    [Parameter]
    public bool ShowWillAttend { get; set; } = false;

    /// <summary>
    /// Whether the user will attend (for events)
    /// </summary>
    [Parameter]
    public bool WillAttend { get; set; } = true;

    /// <summary>
    /// Whether the user will attend changed callback
    /// </summary>
    [Parameter]
    public EventCallback<bool> WillAttendChanged { get; set; }

    /// <summary>
    /// Whether the current user is a Leitão (affects instrument requirements)
    /// </summary>
    [Parameter]
    public bool IsLeitao { get; set; }

    /// <summary>
    /// Selected instrument
    /// </summary>
    [Parameter]
    public InstrumentType? Instrument { get; set; }

    /// <summary>
    /// Instrument changed callback
    /// </summary>
    [Parameter]
    public EventCallback<InstrumentType?> InstrumentChanged { get; set; }

    /// <summary>
    /// Notes text
    /// </summary>
    [Parameter]
    public string Notes { get; set; } = string.Empty;

    /// <summary>
    /// Notes changed callback
    /// </summary>
    [Parameter]
    public EventCallback<string> NotesChanged { get; set; }

    /// <summary>
    /// Number of rows for notes textarea
    /// </summary>
    [Parameter]
    public int NotesRows { get; set; } = 4;

    /// <summary>
    /// Placeholder for notes textarea
    /// </summary>
    [Parameter]
    public string NotesPlaceholder { get; set; } = "Informações adicionais...";

    /// <summary>
    /// Text for submit button
    /// </summary>
    [Parameter]
    public string SubmitButtonText { get; set; } = "Confirmar";

    /// <summary>
    /// Callback when form is submitted
    /// </summary>
    [Parameter]
    public EventCallback OnSubmit { get; set; }

    /// <summary>
    /// Callback when modal is cancelled
    /// </summary>
    [Parameter]
    public EventCallback OnCancel { get; set; }

    /// <summary>
    /// Whether "Quero tocar" toggle is enabled
    /// </summary>
    [Parameter]
    public bool WantToPlay { get; set; }

    /// <summary>
    /// WantToPlay changed callback
    /// </summary>
    [Parameter]
    public EventCallback<bool> WantToPlayChanged { get; set; }
    
    /// <summary>
    /// List of available instruments for the member (optional, defaults to all instruments)
    /// </summary>
    [Parameter]
    public List<InstrumentType>? AvailableInstruments { get; set; }

    /// <summary>
    /// Whether the user has instruments configured
    /// </summary>
    private bool HasInstruments => AvailableInstruments == null || AvailableInstruments.Any();

    private async Task OnWantToPlayChanged(bool value)
    {
        // Note: Don't compare WantToPlay != value as the parameter may have already been updated
        // by the parent component before this callback executes
        WantToPlay = value;
        if (!WantToPlay)
        {
            Instrument = null;
            await InstrumentChanged.InvokeAsync(null);
            instrumentValidationError = string.Empty;
            validationErrors.Clear();
        }
        await WantToPlayChanged.InvokeAsync(value);
        StateHasChanged();
    }

    private async Task OnWillAttendChanged(bool value)
    {
        WillAttend = value;
        await WillAttendChanged.InvokeAsync(value);
    }

    private async Task OnNotesChanged()
    {
        await NotesChanged.InvokeAsync(Notes);
    }

    private async Task OnInstrumentChangedInternal()
    {
        instrumentValidationError = string.Empty;
        validationErrors.Clear();
        await InstrumentChanged.InvokeAsync(Instrument);
    }

    private async Task HandleSubmit()
    {
        // Validate instrument is selected when required
        // Only require instrument if user wants to play, will attend, is not Leitão, 
        // AND has available instruments to choose from
        if (WantToPlay && (!ShowWillAttend || WillAttend) && !IsLeitao && !Instrument.HasValue 
            && AvailableInstruments != null && AvailableInstruments.Any())
        {
            instrumentValidationError = "Por favor, selecione um instrumento.";
            validationErrors = new List<string> { instrumentValidationError };
            return;
        }

        instrumentValidationError = string.Empty;
        validationErrors.Clear();
        await OnSubmit.InvokeAsync();
    }

    private async Task HandleCancel()
    {
        await OnCancel.InvokeAsync();
        await ShowChanged.InvokeAsync(false);
    }
}
