@namespace RTUB.Shared
@using Microsoft.AspNetCore.Identity
@using RTUB.Application.Helpers
@using RTUB.Application.Interfaces
@using RTUB.Core.Entities
@inject ILoginCountService LoginCountService
@inject UserManager<ApplicationUser> UserManager

<button class="btn btn-purple" @onclick="OpenLoginsModal" title="Ver estatísticas de login">
    <i class="bi bi-box-arrow-in-right"></i> Logins
</button>

@if (showLoginModal)
{
    <Modal Show="@showLoginModal"
           ShowChanged="@((bool value) => showLoginModal = value)"
           Title="Dashboard de Estatísticas de Login"
           Size="Modal.ModalSize.ExtraLarge"
           Centered="true">
        <BodyContent>
            @if (isLoading)
            {
                <LoadingSpinner />
            }
            else
            {
                <!-- Statistics Section -->
                <div class="stats-grid mb-4">
                    <div class="stat-card">
                        <div class="stat-card-content">
                            <div class="stat-icon">
                                <i class="bi bi-box-arrow-in-right"></i>
                            </div>
                            <div class="stat-info">
                                <div class="stat-value">@statistics.TotalLogins</div>
                                <div class="stat-label">Total de Logins</div>
                            </div>
                        </div>
                    </div>
                    <div class="stat-card stat-users">
                        <div class="stat-card-content">
                            <div class="stat-icon">
                                <i class="bi bi-people-fill"></i>
                            </div>
                            <div class="stat-info">
                                <div class="stat-value">@statistics.TotalUniqueUsers</div>
                                <div class="stat-label">Utilizadores Únicos</div>
                            </div>
                        </div>
                    </div>
                    <div class="stat-card stat-entities">
                        <div class="stat-card-content">
                            <div class="stat-icon">
                                <i class="bi bi-calendar-day"></i>
                            </div>
                            <div class="stat-info">
                                <div class="stat-value">@statistics.LoginsToday</div>
                                <div class="stat-label">Logins Hoje</div>
                            </div>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-card-content">
                            <div class="stat-icon">
                                <i class="bi bi-calendar-week"></i>
                            </div>
                            <div class="stat-info">
                                <div class="stat-value">@statistics.LoginsThisWeek</div>
                                <div class="stat-label">Logins Esta Semana</div>
                            </div>
                        </div>
                    </div>
                    <div class="stat-card stat-critical">
                        <div class="stat-card-content">
                            <div class="stat-icon">
                                <i class="bi bi-calendar-month"></i>
                            </div>
                            <div class="stat-info">
                                <div class="stat-value">@statistics.LoginsThisMonth</div>
                                <div class="stat-label">Logins Este Mês</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Top Users Section -->
                <div class="card mb-3">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="bi bi-trophy-fill"></i> Top Utilizadores por Login</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <SearchBar @bind-Value="searchTerm"
                                       Placeholder="Pesquisar por nome ou username..."
                                       OnSearch="@HandleSearchChanged" />
                        </div>

                        @if (!filteredUsers.Any())
                        {
                            <EmptyState
                                Title="Nenhum utilizador encontrado."
                                Icon="bi-search" />
                        }
                        else
                        {
                            <div class="member-card-lite-grid">
                                @foreach (var userRecord in paginatedUsers)
                                {
                                    <div class="member-card-lite member-card-lite-clickable" 
                                         @onclick="@(() => ToggleUserDetails(userRecord.User.Id))"
                                         style="cursor: pointer;">
                                        <div class="member-card-lite-header">
                                            <img src="@userRecord.User.ProfilePictureSrc"
                                                 alt="@userRecord.DisplayNickname"
                                                 class="member-card-lite-avatar"
                                                 loading="lazy" />
                                            <div class="member-card-lite-title">
                                                <div class="member-card-lite-nickname">
                                                    @userRecord.DisplayNickname
                                                    <span class="badge bg-purple ms-2">@userRecord.LoginCount logins</span>
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(userRecord.DisplayFullName))
                                                {
                                                    <div class="member-card-lite-name">@userRecord.DisplayFullName</div>
                                                }
                                            </div>
                                        </div>
                                        
                                        @if (expandedUserId == userRecord.User.Id)
                                        {
                                            <div class="member-card-lite-body mt-3 pt-3 border-top">
                                                <div class="member-card-lite-row">
                                                    <span class="member-card-lite-label">Total de Logins</span>
                                                    <span class="member-card-lite-value">
                                                        <span class="badge bg-primary">@userRecord.LoginCount</span>
                                                    </span>
                                                </div>
                                                <div class="member-card-lite-row">
                                                    <span class="member-card-lite-label">Dias Consecutivos</span>
                                                    <span class="member-card-lite-value">
                                                        <span class="badge bg-success">@userRecord.ConsecutiveDays dias</span>
                                                    </span>
                                                </div>
                                                
                                                @if (userRecord.RecentLogins != null && userRecord.RecentLogins.Any())
                                                {
                                                    <div class="mt-3">
                                                        <h6 class="text-muted mb-2">
                                                            <i class="bi bi-clock-history"></i> Últimos 10 Logins
                                                        </h6>
                                                        <div class="table-responsive">
                                                            <table class="table table-sm table-striped">
                                                                <thead>
                                                                    <tr>
                                                                        <th>Data</th>
                                                                        <th>Hora</th>
                                                                        @if (userRecord.RecentLogins.Any(l => !string.IsNullOrWhiteSpace(l.IpAddress)))
                                                                        {
                                                                            <th>IP</th>
                                                                        }
                                                                        @if (userRecord.RecentLogins.Any(l => !string.IsNullOrWhiteSpace(l.UserAgent)))
                                                                        {
                                                                            <th>User Agent</th>
                                                                        }
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var login in userRecord.RecentLogins)
                                                                    {
                                                                        <tr>
                                                                            <td>@login.LoginDate.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                                                            <td>@login.LoginDate.ToLocalTime().ToString("HH:mm:ss")</td>
                                                                            @if (userRecord.RecentLogins.Any(l => !string.IsNullOrWhiteSpace(l.IpAddress)))
                                                                            {
                                                                                <td>@(login.IpAddress ?? "-")</td>
                                                                            }
                                                                            @if (userRecord.RecentLogins.Any(l => !string.IsNullOrWhiteSpace(l.UserAgent)))
                                                                            {
                                                                                <td>
                                                                                    <small class="text-muted" title="@login.UserAgent">
                                                                                        @(string.IsNullOrWhiteSpace(login.UserAgent) ? "-" : TruncateUserAgent(login.UserAgent))
                                                                                    </small>
                                                                                </td>
                                                                            }
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="mt-3">
                                                        <EmptyState
                                                            Title="Sem logins recentes."
                                                            Icon="bi-info-circle" />
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="text-center text-muted small mt-2">
                                                <i class="bi bi-chevron-down"></i> Clique para ver detalhes
                                            </div>
                                        }
                                    </div>
                                }
                            </div>

                            <TablePagination CurrentPage="@paginationHelper.CurrentPage"
                                            PageSize="@paginationHelper.PageSize"
                                            TotalItems="@filteredUsers.Count"
                                            ItemLabel="utilizadores"
                                            PageSizeOptions="@(new[] { 10, 20, 30, 40 })"
                                            OnPageChanged="@HandlePageChange"
                                            OnPageSizeChanged="@HandlePageSizeChange" />
                        }
                    </div>
                </div>
            }
        </BodyContent>
        <FooterContent>
            <button type="button" class="btn btn-secondary" @onclick="CloseLoginsModal">Fechar</button>
        </FooterContent>
    </Modal>
}

@code {
    private bool showLoginModal = false;
    private bool isLoading = false;
    private LoginStatistics statistics = new();
    private List<UserLoginRecord> topUsers = new();
    private List<UserLoginRecord> filteredUsers = new();
    private List<UserLoginRecord> paginatedUsers = new();
    private string searchTerm = string.Empty;
    private PaginationHelper<UserLoginRecord> paginationHelper = new() { PageSize = 10 };
    private string? expandedUserId = null;

    private async Task OpenLoginsModal()
    {
        showLoginModal = true;
        isLoading = true;
        await LoadStatisticsData();
        isLoading = false;
    }

    private void CloseLoginsModal()
    {
        showLoginModal = false;
        expandedUserId = null;
    }

    private async Task LoadStatisticsData()
    {
        // Load statistics
        statistics = await LoginCountService.GetLoginStatisticsAsync();

        // Load top users
        var topUsersData = await LoginCountService.GetTopUsersByLoginCountAsync(100);
        
        topUsers = topUsersData.Select(u => new UserLoginRecord
        {
            User = u.User,
            LoginCount = u.LoginCount,
            ConsecutiveDays = 0, // Will be loaded when expanded
            RecentLogins = null // Will be loaded when expanded
        }).ToList();

        FilterAndPaginate();
    }

    private async Task ToggleUserDetails(string userId)
    {
        if (expandedUserId == userId)
        {
            // Collapse
            expandedUserId = null;
        }
        else
        {
            // Expand and load details
            expandedUserId = userId;
            var userRecord = topUsers.FirstOrDefault(u => u.User.Id == userId);
            
            if (userRecord != null)
            {
                // Load consecutive days
                userRecord.ConsecutiveDays = await LoginCountService.GetConsecutiveLoginDaysAsync(userId);
                
                // Load recent logins (last 10)
                var recentLogins = await LoginCountService.GetUserLoginsAsync(userId);
                userRecord.RecentLogins = recentLogins
                    .OrderByDescending(l => l.LoginDate)
                    .Take(10)
                    .ToList();
            }
            
            StateHasChanged();
        }
    }

    private void FilterAndPaginate()
    {
        if (topUsers == null || !topUsers.Any())
        {
            filteredUsers = new List<UserLoginRecord>();
            paginatedUsers = new List<UserLoginRecord>();
            return;
        }

        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            filteredUsers = topUsers.ToList();
        }
        else
        {
            var search = searchTerm.ToLower();
            filteredUsers = topUsers
                .Where(r => r.SearchText.Contains(search))
                .ToList();
        }

        filteredUsers = filteredUsers
            .OrderByDescending(r => r.LoginCount)
            .ToList();
        paginatedUsers = paginationHelper.GetPageData(filteredUsers);
    }

    private Task HandleSearchChanged(string value)
    {
        searchTerm = value;
        paginationHelper.Reset();
        FilterAndPaginate();
        return Task.CompletedTask;
    }

    private Task HandlePageChange(int newPage)
    {
        paginationHelper.GoToPage(newPage);
        paginatedUsers = paginationHelper.GetPageData(filteredUsers);
        return Task.CompletedTask;
    }

    private Task HandlePageSizeChange(int newPageSize)
    {
        paginationHelper.PageSize = newPageSize;
        paginationHelper.Reset();
        paginatedUsers = paginationHelper.GetPageData(filteredUsers);
        return Task.CompletedTask;
    }

    private string TruncateUserAgent(string userAgent)
    {
        if (string.IsNullOrWhiteSpace(userAgent))
            return "-";
        
        return userAgent.Length > 50 ? userAgent.Substring(0, 47) + "..." : userAgent;
    }

    private class UserLoginRecord
    {
        public ApplicationUser User { get; set; } = null!;
        public int LoginCount { get; set; }
        public int ConsecutiveDays { get; set; }
        public List<LoginCount>? RecentLogins { get; set; }

        public string DisplayNickname => !string.IsNullOrWhiteSpace(User.Nickname) ? User.Nickname : User.UserName ?? string.Empty;

        public string DisplayFullName
        {
            get
            {
                var fullName = $"{User.FirstName} {User.LastName}".Trim();
                return string.IsNullOrWhiteSpace(fullName) ? DisplayNickname : fullName;
            }
        }

        public string SearchText => $"{DisplayNickname} {DisplayFullName} {User.UserName}".ToLower();
    }
}
