@namespace RTUB.Shared
@*
    Mobile bottom navigation: a fixed bar below 1200px for NAVIGATION only - between the app's
    sections, a page's own sections, or a page's views (UI refactor 035; contract:
    docs/design/RTUB_UI_REFACTOR.md section 22). Page actions (add, statistics, back ...) use
    PageHeader/PageActions instead, which render as a group of buttons, not as navigation.
    The current item is marked with aria-current; give each bar its own AriaLabel.
*@

<nav class="mobile-bottom-nav" aria-label="@AriaLabel">
    @foreach (var item in Items)
    {
        <button type="button" @key="item.Key"
                class="mobile-bottom-nav__btn @(item.Key == ActiveKey ? "mobile-bottom-nav__btn--active" : "")"
                @onclick="() => OnSelect.InvokeAsync(item.Key)"
                aria-current="@(item.Key == ActiveKey ? "true" : null)">
            <span class="mobile-bottom-nav__icon-wrap">
                <i class="bi @item.Icon" aria-hidden="true"></i>
                @if (Badges != null && Badges.TryGetValue(item.Key, out var badge))
                {
                    @badge
                }
            </span>
            <span>@item.Label</span>
        </button>
    }
</nav>

@code {
    /// <summary>
    /// The navigation items to display.
    /// </summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<MobileNavItem> Items { get; set; } = Array.Empty<MobileNavItem>();

    /// <summary>
    /// The currently active section key.
    /// </summary>
    [Parameter]
    public string ActiveKey { get; set; } = string.Empty;

    /// <summary>
    /// Callback when a button is tapped.
    /// </summary>
    [Parameter]
    public EventCallback<string> OnSelect { get; set; }

    /// <summary>
    /// Optional per-item badge content keyed by item Key.
    /// </summary>
    [Parameter]
    public Dictionary<string, RenderFragment>? Badges { get; set; }

    /// <summary>
    /// Accessible name of this navigation, e.g. "Secções da página".
    /// </summary>
    [Parameter]
    public string AriaLabel { get; set; } = "Navegação";

    /// <summary>
    /// Represents a single bottom-nav item.
    /// </summary>
    public record MobileNavItem(string Key, string Label, string Icon);
}
