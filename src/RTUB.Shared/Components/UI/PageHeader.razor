@namespace RTUB.Shared
@*
    Page header (UI refactor 035; contract: docs/design/RTUB_UI_REFACTOR.md section 22).

    The page's single h1, an optional icon and subtitle, an optional back affordance and the
    page's actions. Actions are PageAction children: one list that renders as header buttons
    from 1200px up and as the fixed bottom action bar below (PageActions).

        <PageHeader Title="Ensaios" Icon="bi-music-note-list" Subtitle="...">
            <Actions>
                <PageAction Label="Adicionar Ensaio" ShortLabel="Adicionar" Icon="bi-plus-lg"
                            Intent="PageActionIntent.Primary" OnClick="OpenCreateModal" />
            </Actions>
        </PageHeader>

    ChildContent is extra context shown under the title (badges, a filter tied to the title).
*@

<div class="page-header">
    <div class="page-header__main">
        @if (!string.IsNullOrEmpty(BackHref))
        {
            <a class="page-header__back" href="@BackHref" aria-label="@BackLabel" title="@BackLabel">
                <i class="bi bi-arrow-left" aria-hidden="true"></i>
            </a>
        }
        else if (OnBack.HasDelegate)
        {
            <button type="button" class="page-header__back" @onclick="OnBack" aria-label="@BackLabel" title="@BackLabel">
                <i class="bi bi-arrow-left" aria-hidden="true"></i>
            </button>
        }
        <div class="page-header__text">
            <h1 class="page-header__title">
                @if (!string.IsNullOrEmpty(Icon))
                {
                    <i class="bi @Icon page-header__icon" aria-hidden="true"></i>
                }
                <span>@Title</span>
            </h1>
            @if (!string.IsNullOrEmpty(Subtitle))
            {
                <p class="page-header__subtitle">@Subtitle</p>
            }
            @ChildContent
        </div>
    </div>
    @if (Actions != null)
    {
        <PageActions>@Actions</PageActions>
    }
</div>

@code {
    /// <summary>The page title (the page's h1).</summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    /// <summary>Bootstrap Icons class shown before the title, e.g. "bi-calendar-event".</summary>
    [Parameter]
    public string? Icon { get; set; }

    /// <summary>Secondary line under the title.</summary>
    [Parameter]
    public string? Subtitle { get; set; }

    /// <summary>Target of the back affordance (a link). Use OnBack when going back needs code.</summary>
    [Parameter]
    public string? BackHref { get; set; }

    /// <summary>Back affordance as a button, when there is no fixed target.</summary>
    [Parameter]
    public EventCallback OnBack { get; set; }

    /// <summary>Accessible name of the back affordance.</summary>
    [Parameter]
    public string BackLabel { get; set; } = "Voltar";

    /// <summary>The page's actions: PageAction children.</summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }

    /// <summary>Extra context under the title (badges, a filter tied to the title).</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
