@namespace RTUB.Shared
@*
    "More actions" menu for a card's management actions (edit, notify, cancel, delete), so they stop
    competing with the card's content and its member action (docs/design/RTUB_UI_REFACTOR.md
    section 25). Bootstrap's dropdown (already loaded for the navbar) handles open/close, arrow keys
    and Escape. Put CardMenuItem children inside; destructive items last, after a divider.
    Visibility stays in the caller - the menu never decides authorization.
*@

<div class="dropdown card-menu @CssClass">
    <button type="button"
            class="card-menu__trigger"
            data-bs-toggle="dropdown"
            aria-expanded="false"
            aria-label="@($"Gerir: {Label}")"
            title="Gerir">
        <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
    </button>
    <ul class="dropdown-menu dropdown-menu-end card-menu__list">
        @ChildContent
    </ul>
</div>

@code {
    /// <summary>What the menu manages (the item's name), for the trigger's accessible name</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = "";

    [Parameter] public string? CssClass { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }
}
