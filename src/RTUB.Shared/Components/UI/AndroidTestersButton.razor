@namespace RTUB.Shared
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using RTUB.Application.Helpers
@using RTUB.Application.Interfaces
@using RTUB.Application.DTOs
@inject UserManager<ApplicationUser> UserManager
@inject IPushNotificationService PushNotificationService
@inject NavigationManager Navigation

<button class="btn btn-white btn-android-testers" @onclick="OpenTestersModal" title="Ver testadores Android" aria-label="Ver testadores Android">
    <i class="bi bi-bell"></i> Testadores Android
</button>

@if (showTestersModal)
{
    <Modal Show="@showTestersModal"
           ShowChanged="@((bool value) => showTestersModal = value)"
           Title="Testadores Android"
           Size="Modal.ModalSize.Large"
           Centered="true">
        <BodyContent>
            <!-- Custom Notification Section -->
            <div class="mb-4 p-3 bg-light rounded">
                <h6 class="mb-3">Enviar Notificação Personalizada</h6>
                <div class="mb-3">
                    <label class="form-label">Mensagem Personalizada</label>
                    <textarea class="form-control" 
                              rows="3" 
                              @bind="customMessage" 
                              placeholder="Digite a mensagem que deseja enviar aos testadores Android..."
                              maxlength="@MaxMessageLength"></textarea>
                    <div class="form-text">Máximo @MaxMessageLength caracteres</div>
                </div>
                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="alert alert-danger" role="alert">
                        @errorMessage
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(successMessage))
                {
                    <div class="alert alert-success" role="alert">
                        @successMessage
                    </div>
                }
                <button class="btn btn-white" 
                        @onclick="SendNotification" 
                        disabled="@(isSending || string.IsNullOrWhiteSpace(customMessage))"
                        aria-label="Enviar notificação push">
                    @if (isSending)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>A enviar...</span>
                    }
                    else
                    {
                        <i class="bi bi-bell"></i>
                        <span>Enviar Notificação</span>
                    }
                </button>
            </div>

            <!-- Search Bar -->
            @if (androidTesters != null && androidTesters.Any())
            {
                <div class="mb-3">
                    <SearchBar @bind-Value="searchTerm"
                               Placeholder="Pesquisar por nome ou username..."
                               OnSearch="@HandleSearchChanged" />
                </div>

                @if (!filteredTesters.Any())
                {
                    <EmptyState
                        Title="Nenhum testador encontrado."
                        Icon="bi-search" />
                }
                else
                {
                    <!-- Member Cards Grid -->
                    <div class="member-card-lite-grid">
                        @foreach (var tester in paginatedTesters)
                        {
                            <MemberCardLite AvatarUrl="@tester.AvatarUrl"
                                            AltText="@tester.DisplayNickname"
                                            Nickname="@tester.DisplayNickname"
                                            FullName="@tester.DisplayFullName"
                                            LastLoginText="@(tester.LastLoginDate.HasValue ? tester.LastLoginDate.Value.ToString("dd/MM/yyyy HH:mm") : "Nunca")" />
                        }
                    </div>

                    <!-- Pagination -->
                    <TablePagination CurrentPage="@paginationHelper.CurrentPage"
                                     PageSize="@paginationHelper.PageSize"
                                     TotalItems="@filteredTesters.Count"
                                     ItemLabel="testadores"
                                     PageSizeOptions="@(new[] { 12, 24, 36, 48, 60 })"
                                     OnPageChanged="@HandlePageChange"
                                     OnPageSizeChanged="@HandlePageSizeChange" />
                }
            }
            else if (androidTesters != null)
            {
                <EmptyState
                    Title="Nenhum testador Android encontrado."
                    Icon="bi-info-circle" />
            }
        </BodyContent>
        <FooterContent>
            <button type="button" class="btn btn-secondary" @onclick="CloseTestersModal" aria-label="Fechar modal">Fechar</button>
        </FooterContent>
    </Modal>
}

@code {
    // Constants
    private const string NotificationTitle = "RTUB - Testadores Android";
    private const string NotificationTag = "android-testers-notification";
    private const int MaxMessageLength = 500;
    
    private bool showTestersModal = false;
    private List<AndroidTester>? androidTesters;
    private List<AndroidTester> filteredTesters = new();
    private List<AndroidTester> paginatedTesters = new();
    private string searchTerm = string.Empty;
    private PaginationHelper<AndroidTester> paginationHelper = new() { PageSize = 12 };
    
    // Notification fields
    private string customMessage = string.Empty;
    private bool isSending = false;
    private string? errorMessage;
    private string? successMessage;

    private async Task OpenTestersModal()
    {
        showTestersModal = true;
        await LoadAndroidTesters();
    }

    private void CloseTestersModal()
    {
        showTestersModal = false;
        customMessage = string.Empty;
        errorMessage = null;
        successMessage = null;
    }

    private async Task LoadAndroidTesters()
    {
        var users = await UserManager.Users
            .AsNoTracking()
            .Where(u => u.IsAndroidTester)
            .ToListAsync();

        androidTesters = users
            .Select(u => new AndroidTester
            {
                UserId = u.Id,
                UserName = u.UserName ?? string.Empty,
                Nickname = u.Nickname ?? string.Empty,
                FirstName = u.FirstName ?? string.Empty,
                LastName = u.LastName ?? string.Empty,
                AvatarUrl = u.ProfilePictureSrc,
                LastLoginDate = u.LastLoginDate
            })
            .OrderBy(t => t.DisplayNickname)
            .ToList();

        FilterAndPaginate();
    }

    private void FilterAndPaginate()
    {
        if (androidTesters == null)
        {
            filteredTesters = new List<AndroidTester>();
            paginatedTesters = new List<AndroidTester>();
            return;
        }

        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            filteredTesters = androidTesters.ToList();
        }
        else
        {
            var search = searchTerm.ToLower();
            filteredTesters = androidTesters
                .Where(t => t.SearchText.Contains(search))
                .ToList();
        }

        filteredTesters = filteredTesters
            .OrderBy(t => t.DisplayNickname)
            .ToList();
        paginatedTesters = paginationHelper.GetPageData(filteredTesters);
    }

    private Task HandleSearchChanged(string value)
    {
        searchTerm = value;
        paginationHelper.Reset();
        FilterAndPaginate();
        return Task.CompletedTask;
    }

    private Task HandlePageChange(int newPage)
    {
        paginationHelper.GoToPage(newPage);
        paginatedTesters = paginationHelper.GetPageData(filteredTesters);
        return Task.CompletedTask;
    }

    private Task HandlePageSizeChange(int newPageSize)
    {
        paginationHelper.PageSize = newPageSize;
        paginationHelper.Reset();
        paginatedTesters = paginationHelper.GetPageData(filteredTesters);
        return Task.CompletedTask;
    }

    private async Task SendNotification()
    {
        if (string.IsNullOrWhiteSpace(customMessage))
        {
            errorMessage = "Por favor, insira uma mensagem.";
            return;
        }

        if (androidTesters == null || !androidTesters.Any())
        {
            errorMessage = "Não há testadores Android para notificar.";
            return;
        }

        isSending = true;
        errorMessage = null;
        successMessage = null;
        StateHasChanged();

        try
        {
            // Get base URL for notification
            var baseUri = Navigation.BaseUri.TrimEnd('/');

            // Create notification DTO
            var notification = new SendPushNotificationDto
            {
                Title = NotificationTitle,
                Body = customMessage.Trim(),
                Icon = "/images/logo-512x512.png",
                Url = $"{baseUri}/",
                Tag = NotificationTag
            };

            // Get all Android tester user IDs
            var testerIds = androidTesters.Select(t => t.UserId).ToList();

            // Send notification to all Android testers
            await PushNotificationService.SendToSelectedUsersAsync(testerIds, notification);

            successMessage = $"Notificação enviada com sucesso para {testerIds.Count} testador(es) Android!";
            customMessage = string.Empty;
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro ao enviar notificação: {ex.Message}";
        }
        finally
        {
            isSending = false;
            StateHasChanged();
        }
    }

    private class AndroidTester
    {
        public string UserId { get; set; } = string.Empty;
        public string UserName { get; set; } = string.Empty;
        public string Nickname { get; set; } = string.Empty;
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string AvatarUrl { get; set; } = string.Empty;
        public DateTime? LastLoginDate { get; set; }

        public string DisplayNickname => !string.IsNullOrWhiteSpace(Nickname) ? Nickname : UserName;

        public string DisplayFullName
        {
            get
            {
                var fullName = $"{FirstName} {LastName}".Trim();
                return string.IsNullOrWhiteSpace(fullName) ? DisplayNickname : fullName;
            }
        }

        public string SearchText => $"{DisplayNickname} {DisplayFullName} {UserName}".ToLower();
    }
}
