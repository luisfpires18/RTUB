@namespace RTUB.Shared
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using RTUB.Application.Extensions
@using RTUB.Application.Interfaces
@using RTUB.Application.Helpers
@inject IEnrollmentService EnrollmentService
@inject IEventService EventService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager

@*
    My Enrollments Button Component
    Shows user's enrollment history in events
    Available to all authenticated users
*@

@if (!HideButton)
{
    <button class="btn btn-outline-secondary btn-my-enrollments" @onclick="OpenMyEnrollmentsModal" title="Minhas Inscrições" aria-label="Ver minhas inscrições">
        <i class="bi bi-calendar-check"></i> Minhas Inscrições
    </button>
}

<!-- Minhas Inscrições Modal -->
@if (showMyEnrollmentsModal)
{
    <Modal Show="@showMyEnrollmentsModal"
           ShowChanged="@((bool show) => showMyEnrollmentsModal = show)"
           Title="Minhas Inscrições Recentes"
           Size="Modal.ModalSize.Large"
           Centered="true">
        <BodyContent>
            @if (eventEnrollments == null || !eventEnrollments.Any())
            {
                <EmptyState 
                    Title="Sem inscrições registadas." 
                    Icon="bi-info-circle" />
            }
            else
            {
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <strong>Taxa de Participação @(showAllEvents ? "(todas as atuações)" : "(últimas 10 atuações)"):</strong>
                        <span class="badge bg-primary">@enrollmentCount / @totalRecentEvents atuações</span>
                        @if (totalRecentEvents > 0)
                        {
                            <span class="ms-2">(@(Math.Round((double)enrollmentCount / totalRecentEvents * 100, 1))%)</span>
                        }
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="showAllEventsToggle"
                               @bind="showAllEvents" @bind:after="OnToggleChanged" />
                        <label class="form-check-label" for="showAllEventsToggle">
                            Mostrar todos
                        </label>
                    </div>
                </div>
                <SearchBar @bind-Value="myEnrollmentsSearchTerm"
                           Placeholder="Pesquisar atuações por nome..."
                           OnSearch="ApplyEnrollmentSearch" />
                <div class="activity-card-lite-grid">
                    @foreach (var item in paginatedEventEnrollments)
                    {
                        <ActivityCardLite @key="item.Event.Id">
                            <div class="activity-card-lite-row">
                                <span class="activity-card-lite-value w-100 text-center">@item.Event.Date.ToString("dd MMM yyyy")</span>
                            </div>
                            <div class="activity-card-lite-row">
                                <span class="activity-card-lite-value text-center w-100">@item.Event.Name</span>
                            </div>
                            <div class="activity-card-lite-row">
                                <span class="activity-card-lite-value text-center w-100">@item.Event.Type.GetDisplayName()</span>
                            </div>
                            <div class="activity-card-lite-row">
                                <span class="activity-card-lite-value w-100 text-center">
                                    @if (item.WillAttend)
                                    {
                                        <span class="badge bg-success">Foi</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Não foi</span>
                                    }
                                </span>
                            </div>
                        </ActivityCardLite>
                    }
                </div>
                
                <!-- Pagination -->
                @if (eventEnrollments.Count > 0)
                {
                    <TablePagination CurrentPage="@eventsPaginationHelper.CurrentPage"
                                    PageSize="@eventsPaginationHelper.PageSize"
                                    TotalItems="@filteredEventEnrollments.Count"
                                    ItemLabel="inscrições"
                                    PageSizeOptions="@(new[] { 9, 18, 27, 36 })"
                                    OnPageChanged="@HandleEventsPageChange"
                                    OnPageSizeChanged="@HandleEventsPageSizeChange" />
                }
            }
        </BodyContent>
        <FooterContent>
            <button type="button" class="btn btn-secondary" @onclick="CloseMyEnrollmentsModal" aria-label="Voltar Atrás">Voltar Atrás</button>
        </FooterContent>
    </Modal>
}

@code {
    /// <summary>
    /// When true, hides the trigger button (used when the parent page provides its own trigger via @ref)
    /// </summary>
    [Parameter]
    public bool HideButton { get; set; }

    private bool showMyEnrollmentsModal = false;
    private bool showAllEvents = false;
    private List<EventEnrollmentDisplay> eventEnrollments = new();
    private List<EventEnrollmentDisplay> filteredEventEnrollments = new();
    private List<EventEnrollmentDisplay> paginatedEventEnrollments = new();
    private int enrollmentCount = 0;
    private int totalRecentEvents = 0;
    private string? currentUserId;
    private string myEnrollmentsSearchTerm = string.Empty;
    private PaginationHelper<EventEnrollmentDisplay> eventsPaginationHelper = new() { PageSize = 9 };

    private class EventEnrollmentDisplay
    {
        public Event Event { get; set; } = null!;
        public Enrollment? Enrollment { get; set; }
        public bool WillAttend => Enrollment?.WillAttend ?? false;
        public InstrumentType? Instrument => Enrollment?.Instrument;
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            var appUser = await UserManager.GetUserAsync(user);
            if (appUser != null)
            {
                currentUserId = appUser.Id;
            }
        }
    }

    /// <summary>
    /// Opens the enrollments modal. Can be called externally via @ref.
    /// </summary>
    public async Task Open()
    {
        await LoadMyEnrollments();
        showMyEnrollmentsModal = true;
        StateHasChanged();
    }

    private async Task OpenMyEnrollmentsModal()
    {
        await LoadMyEnrollments();
        showMyEnrollmentsModal = true;
    }

    private void CloseMyEnrollmentsModal()
    {
        showMyEnrollmentsModal = false;
    }

    private async Task LoadMyEnrollments()
    {
        if (currentUserId == null) return;

        try
        {
            // Get past events based on toggle state
            var recentEvents = showAllEvents 
                ? await EventService.GetPastEventsAsync(int.MaxValue)
                : await EventService.GetPastEventsAsync(10);
                
            var pastEvents = recentEvents
                .Where(e => !e.IsCancelled && e.Date < DateTime.Today)
                .OrderByDescending(e => e.Date)
                .Take(showAllEvents ? int.MaxValue : 10)
                .ToList();

            // Get user's enrollments
            var userEnrollments = (await EnrollmentService.GetEnrollmentsByUserIdAsync(currentUserId))
                .ToDictionary(e => e.EventId, e => e);

            // Create display list combining events with enrollment status
            eventEnrollments = pastEvents.Select(e => new EventEnrollmentDisplay
            {
                Event = e,
                Enrollment = userEnrollments.ContainsKey(e.Id) ? userEnrollments[e.Id] : null
            }).ToList();

            totalRecentEvents = eventEnrollments.Count;
            enrollmentCount = eventEnrollments.Count(e => e.WillAttend);

            // Apply search + pagination
            ApplyEnrollmentSearch(myEnrollmentsSearchTerm);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading enrollments: {ex.Message}");
            eventEnrollments = new List<EventEnrollmentDisplay>();
            filteredEventEnrollments = new List<EventEnrollmentDisplay>();
            paginatedEventEnrollments = new List<EventEnrollmentDisplay>();
        }
    }

    private async Task OnToggleChanged()
    {
        eventsPaginationHelper.Reset(); // Reset to page 1 when toggling
        await LoadMyEnrollments();
    }

    private void UpdatePaginatedEvents()
    {
        var source = filteredEventEnrollments.Any() || string.IsNullOrWhiteSpace(myEnrollmentsSearchTerm)
            ? filteredEventEnrollments
            : eventEnrollments;

        paginatedEventEnrollments = eventsPaginationHelper.GetPageData(source);
    }
    
    private async Task HandleEventsPageChange(int newPage)
    {
        eventsPaginationHelper.GoToPage(newPage);
        UpdatePaginatedEvents();
        await Task.CompletedTask;
    }
    
    private async Task HandleEventsPageSizeChange(int newPageSize)
    {
        eventsPaginationHelper.PageSize = newPageSize;
        eventsPaginationHelper.Reset();
        UpdatePaginatedEvents();
        await Task.CompletedTask;
    }

    private void ApplyEnrollmentSearch(string term)
    {
        myEnrollmentsSearchTerm = term ?? string.Empty;

        if (string.IsNullOrWhiteSpace(myEnrollmentsSearchTerm))
        {
            filteredEventEnrollments = eventEnrollments;
        }
        else
        {
            filteredEventEnrollments = eventEnrollments
                .Where(e => e.Event.Name.Contains(myEnrollmentsSearchTerm, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }

        eventsPaginationHelper.Reset();
        UpdatePaginatedEvents();
    }
}
