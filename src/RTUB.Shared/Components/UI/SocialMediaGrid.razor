@namespace RTUB.Shared
@*
    Social Media Grid Component
    Displays social media links as a 2x2 grid of appealing square tiles.
    Uses Bootstrap Icons and the RTUB dark/purple theme.
*@

<div class="social-grid">
    <a href="https://www.facebook.com/rtub.tuna.braganca"
       target="_blank" rel="noopener"
       aria-label="Visitar página do Facebook da RTUB"
       class="social-grid__tile social-grid__tile--facebook">
        <i class="bi bi-facebook"></i>
        <span>Facebook</span>
    </a>
    <a href="https://www.instagram.com/rtub1991/"
       target="_blank" rel="noopener"
       aria-label="Visitar perfil do Instagram da RTUB"
       class="social-grid__tile social-grid__tile--instagram">
        <i class="bi bi-instagram"></i>
        <span>Instagram</span>
    </a>
    <a href="https://www.youtube.com/@@RTUBOficial"
       target="_blank" rel="noopener"
       aria-label="Visitar canal do YouTube da RTUB"
       class="social-grid__tile social-grid__tile--youtube">
        <i class="bi bi-youtube"></i>
        <span>YouTube</span>
    </a>
    <a href="https://open.spotify.com/artist/0h6qse9m0OpJ2K6H0IFAgD?si=4a911dc1e08f4316&nd=1&dlsi=867b2e9dc5b74e8a"
       target="_blank" rel="noopener"
       aria-label="Ouvir música da RTUB no Spotify"
       class="social-grid__tile social-grid__tile--spotify">
        <i class="bi bi-spotify"></i>
        <span>Spotify</span>
    </a>
</div>
