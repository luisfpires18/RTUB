@namespace RTUB.Shared
@using System.Linq

<div class="filter-dropdown @AdditionalClasses">
    @if (ShowIcon)
    {
        <span class="filter-dropdown__icon">
            <i class="bi @(string.IsNullOrWhiteSpace(IconClass) ? "bi-funnel" : IconClass)"></i>
        </span>
    }
    <select class="filter-dropdown__select"
            @bind="CurrentValue"
            @bind:after="OnValueChanged">
        @if (UseDefaultOption)
        {
            <option value="">@AllItemsLabel</option>
        }

        @if (ChildContent is not null)
        {
            @ChildContent
        }
        else if (Items?.Any() == true)
        {
            @foreach (var item in Items)
            {
                <option value="@item">@item</option>
            }
        }
    </select>
</div>

@code {
    /// <summary>
    /// Whether to show the icon
    /// </summary>
    [Parameter]
    public bool ShowIcon { get; set; } = true;

    /// <summary>
    /// Icon class for the filter (e.g., "bi-funnel")
    /// </summary>
    [Parameter]
    public string IconClass { get; set; } = "bi-funnel";

    /// <summary>
    /// Label for "all items" option
    /// </summary>
    [Parameter]
    public string AllItemsLabel { get; set; } = "Todos";

    /// <summary>
    /// Optional additional CSS classes
    /// </summary>
    [Parameter]
    public string AdditionalClasses { get; set; } = string.Empty;

    /// <summary>
    /// List of items to display in dropdown
    /// </summary>
    [Parameter]
    public IEnumerable<string> Items { get; set; } = Enumerable.Empty<string>();

    /// <summary>
    /// Currently selected value
    /// </summary>
    [Parameter]
    public string SelectedValue { get; set; } = string.Empty;

    /// <summary>
    /// Event callback when selection changes
    /// </summary>
    [Parameter]
    public EventCallback<string> SelectedValueChanged { get; set; }

    /// <summary>
    /// Additional action to perform after value changes
    /// </summary>
    [Parameter]
    public EventCallback OnChange { get; set; }

    /// <summary>
    /// Optional custom option markup
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Whether to render the default "all" option
    /// </summary>
    [Parameter]
    public bool UseDefaultOption { get; set; } = true;

    private string CurrentValue
    {
        get => SelectedValue;
        set => SelectedValue = value;
    }

    private async Task OnValueChanged()
    {
        await SelectedValueChanged.InvokeAsync(SelectedValue);
        await OnChange.InvokeAsync();
    }
}
