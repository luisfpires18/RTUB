@namespace RTUB.Shared
@using System
@using System.Linq
@using Microsoft.AspNetCore.Components.Web
@*
    Single-choice filter. The trigger is named "<Label>: <current value>", the list is a listbox
    whose active option is exposed through aria-activedescendant, and the selected option carries
    a check (not color alone). Opens with Enter/Space/arrows, moves with arrows/Home/End, selects
    with Enter/Space, closes with Escape or Tab (focus back to the trigger) or a click outside
    (docs/design/RTUB_UI_REFACTOR.md section 23.7). Filtering stays in the page.
*@

<div class="filter-dropdown @(isOpen ? "is-open" : null) @(Disabled ? "is-disabled" : null) @AdditionalClasses">
    @if (ShowIcon)
    {
        <span class="filter-dropdown__icon" aria-hidden="true">
            <i class="bi @(string.IsNullOrWhiteSpace(IconClass) ? "bi-funnel" : IconClass)"></i>
        </span>
    }

    <button type="button"
            @ref="trigger"
            id="@triggerId"
            class="filter-dropdown__control"
            @onclick="ToggleDropdown"
            @onkeydown="HandleTriggerKeyDown"
            aria-haspopup="listbox"
            aria-expanded="@(isOpen ? "true" : "false")"
            aria-controls="@(isOpen ? panelId : null)"
            disabled="@Disabled">
        <span class="visually-hidden">@AccessibleLabel: </span>
        <span class="filter-dropdown__value">@GetDisplayLabel(CurrentValue)</span>
        <i class="bi bi-chevron-down filter-dropdown__caret" aria-hidden="true"></i>
    </button>

    @if (isOpen)
    {
        @* Transparent layer: a click anywhere outside the list closes it. *@
        <div class="filter-dropdown__backdrop" @onclick="CloseDropdown"></div>
        <div class="filter-dropdown__panel"
             id="@panelId"
             role="listbox"
             tabindex="-1"
             aria-label="@AccessibleLabel"
             aria-activedescendant="@(focusedIndex >= 0 ? OptionId(focusedIndex) : null)"
             @ref="optionsPanel"
             @onkeydown="HandlePanelKeyDown"
             @onkeydown:preventDefault="true">
            @foreach (var optionData in options.Select((option, index) => new { option, index }))
            {
                var isSelected = optionData.option.Value == CurrentValue;
                var isFocused = optionData.index == focusedIndex;
                <div class="filter-dropdown__option @(isSelected ? "is-selected" : string.Empty) @(isFocused ? "is-focused" : string.Empty)" @key="@(optionData.option.Value?.GetHashCode() ?? optionData.index)"
                     id="@OptionId(optionData.index)"
                     role="option"
                     aria-selected="@(isSelected ? "true" : "false")"
                     @onmouseenter="() => focusedIndex = optionData.index"
                     @onclick="() => SelectOption(optionData.option.Value ?? string.Empty)">
                    <span class="filter-dropdown__option-label">@optionData.option.Label</span>
                    @if (isSelected)
                    {
                        <i class="bi bi-check2 filter-dropdown__check" aria-hidden="true"></i>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    /// <summary>What is filtered (e.g. "Ano letivo"); part of the trigger's accessible name.</summary>
    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public bool ShowIcon { get; set; } = true;

    [Parameter]
    public string IconClass { get; set; } = "bi-funnel";

    [Parameter]
    public string AllItemsLabel { get; set; } = "Todos";

    [Parameter]
    public string AdditionalClasses { get; set; } = string.Empty;

    [Parameter]
    public IEnumerable<string> Items { get; set; } = Enumerable.Empty<string>();

    [Parameter]
    public IEnumerable<FilterDropdownOption> Options { get; set; } = Enumerable.Empty<FilterDropdownOption>();

    [Parameter]
    public string SelectedValue { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> SelectedValueChanged { get; set; }

    [Parameter]
    public EventCallback OnChange { get; set; }

    [Parameter]
    public bool UseDefaultOption { get; set; } = true;

    /// <summary>Shows the current value but cannot be opened.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    private readonly string triggerId = "filter-" + Guid.NewGuid().ToString("N")[..8];
    private string panelId => triggerId + "-list";

    private bool isOpen;
    private bool focusPanel;
    private bool focusTrigger;
    private int focusedIndex = -1;
    private ElementReference trigger;
    private ElementReference optionsPanel;
    private List<FilterDropdownOption> options = new();

    private string AccessibleLabel => string.IsNullOrWhiteSpace(Label) ? "Filtro" : Label;

    private string CurrentValue
    {
        get => SelectedValue;
        set => SelectedValue = value;
    }

    private string OptionId(int index) => $"{triggerId}-opt-{index}";

    protected override void OnParametersSet()
    {
        options = BuildOptions().ToList();
        if (Disabled && isOpen)
        {
            isOpen = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusPanel && isOpen)
        {
            focusPanel = false;
            await optionsPanel.FocusAsync();
        }
        else if (focusTrigger)
        {
            focusTrigger = false;
            await trigger.FocusAsync();
        }
    }

    private IEnumerable<FilterDropdownOption> BuildOptions()
    {
        var optionList = new List<FilterDropdownOption>();

        if (UseDefaultOption)
        {
            optionList.Add(new FilterDropdownOption(string.Empty, AllItemsLabel));
        }

        if (Options?.Any() == true)
        {
            optionList.AddRange(Options);
        }
        else if (Items?.Any() == true)
        {
            optionList.AddRange(Items.Select(item => new FilterDropdownOption(item, item)));
        }

        return optionList;
    }

    private string GetDisplayLabel(string value)
    {
        var option = options.FirstOrDefault(o => o.Value == value);
        if (option is not null)
        {
            return option.Label;
        }

        if (string.IsNullOrWhiteSpace(value) && UseDefaultOption)
        {
            return AllItemsLabel;
        }

        return value;
    }

    private void ToggleDropdown()
    {
        if (isOpen)
        {
            CloseDropdown();
        }
        else
        {
            OpenDropdown();
        }
    }

    private void OpenDropdown()
    {
        if (Disabled)
        {
            return;
        }

        isOpen = true;
        focusPanel = true;
        var currentIndex = options.FindIndex(o => o.Value == CurrentValue);
        focusedIndex = options.Count == 0 ? -1 : Math.Max(currentIndex, 0);
    }

    private void HandleTriggerKeyDown(KeyboardEventArgs args)
    {
        // Enter/Space arrive as a click on the button; only the arrows need handling here.
        if (args.Key is "ArrowDown" or "Down" or "ArrowUp" or "Up" && !isOpen)
        {
            OpenDropdown();
        }
    }

    private async Task HandlePanelKeyDown(KeyboardEventArgs args)
    {
        switch (args.Key)
        {
            // Keys are prevented from reaching the page (so Escape does not also close a dialog
            // around the list); Tab therefore closes the list and returns to the trigger.
            case "Escape":
            case "Tab":
                CloseDropdown();
                focusTrigger = true;
                break;
            case "Enter":
            case " ":
                if (focusedIndex >= 0 && focusedIndex < options.Count)
                {
                    await SelectOption(options[focusedIndex].Value);
                }
                break;
            case "ArrowDown":
            case "Down":
                MoveFocus(1);
                break;
            case "ArrowUp":
            case "Up":
                MoveFocus(-1);
                break;
            case "Home":
                focusedIndex = options.Count > 0 ? 0 : -1;
                break;
            case "End":
                focusedIndex = options.Count - 1;
                break;
        }
    }

    private void MoveFocus(int direction)
    {
        if (!options.Any())
        {
            return;
        }

        focusedIndex = focusedIndex < 0
            ? 0
            : (focusedIndex + direction + options.Count) % options.Count;
    }

    private async Task SelectOption(string value)
    {
        CurrentValue = value;
        CloseDropdown();
        focusTrigger = true;
        await SelectedValueChanged.InvokeAsync(SelectedValue);
        await OnChange.InvokeAsync();
    }

    private void CloseDropdown()
    {
        isOpen = false;
    }
}
