@namespace RTUB.Shared
@implements IDisposable
@inject ToastService Toasts
@*
    Renders ToastService's toasts. Placed once in MainLayout as an interactive island, so pages
    (other interactive roots of the same circuit) share the scoped service. Two live regions exist
    from the first render: polite for success/info, assertive for warning/error. Auto-dismiss
    waits while the pointer or keyboard focus is on a toast
    (docs/design/RTUB_UI_REFACTOR.md section 23.5).
*@

<div class="toast-stack" @onmouseenter="() => SetHold(pointer: true)" @onmouseleave="() => SetHold(pointer: false)"
     @onfocusin="() => SetHold(focus: true)" @onfocusout="() => SetHold(focus: false)">
    <div class="toast-stack__region" role="alert" aria-live="assertive">
        @foreach (var toast in _visible.Where(t => !t.AutoDismiss))
        {
            @RenderToast(toast)
        }
    </div>
    <div class="toast-stack__region" role="status" aria-live="polite">
        @foreach (var toast in _visible.Where(t => t.AutoDismiss))
        {
            @RenderToast(toast)
        }
    </div>
</div>

@code {
    /// <summary>How long success/info toasts stay, in milliseconds.</summary>
    [Parameter] public int Timeout { get; set; } = 5000;

    private readonly CancellationTokenSource _disposed = new();
    private readonly HashSet<Guid> _timed = new();
    private IReadOnlyList<Toast> _visible = [];
    private bool _pointerInside;
    private bool _focusInside;

    protected override void OnInitialized()
    {
        Toasts.Changed += HandleChanged;
        Refresh();
    }

    private void HandleChanged() => _ = InvokeAsync(() =>
    {
        Refresh();
        StateHasChanged();
    });

    private void Refresh()
    {
        _visible = Toasts.Toasts;
        foreach (var toast in _visible.Where(t => t.AutoDismiss && _timed.Add(t.Id)))
        {
            _ = ExpireAsync(toast.Id);
        }
        _timed.IntersectWith(_visible.Select(t => t.Id));
    }

    private async Task ExpireAsync(Guid id)
    {
        try
        {
            await Task.Delay(Timeout, _disposed.Token);
            // Reading or tabbing through the toasts: keep them until the user moves on.
            while (_pointerInside || _focusInside)
            {
                await Task.Delay(1000, _disposed.Token);
            }
            Toasts.Dismiss(id);
        }
        catch (TaskCanceledException)
        {
        }
    }

    private void SetHold(bool? pointer = null, bool? focus = null)
    {
        _pointerInside = pointer ?? _pointerInside;
        _focusInside = focus ?? _focusInside;
    }

    private void Close(Guid id)
    {
        // The focused close button disappears with its toast, and browsers do not report that
        // focus left; release the hold so the remaining toasts keep their timers.
        _focusInside = false;
        Toasts.Dismiss(id);
    }

    private RenderFragment RenderToast(Toast toast) => __builder =>
    {
        <div class="rtub-toast rtub-toast--@toast.Intent.ToString().ToLowerInvariant()" @key="toast.Id">
            <i class="bi @IconFor(toast.Intent) rtub-toast__icon" aria-hidden="true"></i>
            <div class="rtub-toast__body">
                @if (toast.Intent is ToastIntent.Error or ToastIntent.Warning)
                {
                    <span class="visually-hidden">@(toast.Intent == ToastIntent.Error ? "Erro: " : "Aviso: ")</span>
                }
                @if (!string.IsNullOrEmpty(toast.Title))
                {
                    <p class="rtub-toast__title">@toast.Title</p>
                }
                <p class="rtub-toast__message">@toast.Message</p>
            </div>
            <button type="button" class="rtub-toast__close" aria-label="Fechar notificação" @onclick="() => Close(toast.Id)">
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
        </div>
    };

    private static string IconFor(ToastIntent intent) => intent switch
    {
        ToastIntent.Success => "bi-check-circle-fill",
        ToastIntent.Warning => "bi-exclamation-triangle-fill",
        ToastIntent.Error => "bi-exclamation-octagon-fill",
        _ => "bi-info-circle-fill"
    };

    public void Dispose()
    {
        Toasts.Changed -= HandleChanged;
        _disposed.Cancel();
        _disposed.Dispose();
    }
}
