@namespace RTUB.Shared
@* One CardMenu entry. Danger = destructive (red, keep it last). Divider = separator before it. *@

@if (Divider)
{
    <li role="separator"><hr class="dropdown-divider" /></li>
}
<li>
    <button type="button"
            class="dropdown-item card-menu__item @(Danger ? "card-menu__item--danger" : null)"
            @onclick="OnClick">
        <i class="bi @Icon" aria-hidden="true"></i>
        <span>@Label</span>
    </button>
</li>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";

    [Parameter] public string Icon { get; set; } = "bi-dot";

    [Parameter] public bool Danger { get; set; }

    [Parameter] public bool Divider { get; set; }

    [Parameter] public EventCallback OnClick { get; set; }
}
