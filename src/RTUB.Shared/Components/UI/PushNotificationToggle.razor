@namespace RTUB.Shared
@using Microsoft.Extensions.Logging
@using RTUB.Application.DTOs
@implements IDisposable
@inject IJSRuntime JSRuntime
@inject ILogger<PushNotificationToggle> Logger

<div class="push-notification-toggle">
    @if (IsLoading)
    {
        <div class="text-muted">
            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
            Checking permissions...
        </div>
    }
    else if (HasAccess)
    {
        <div class="form-check form-switch">
            @* While a request runs the switch shows what was asked for - the browser has already
               moved it. Afterwards it shows the outcome, so a failed request re-renders it back. *@
            <input class="form-check-input"
                   type="checkbox"
                   id="pushNotificationSwitch"
                   checked="@(IsProcessing ? RequestedState : IsSubscribed)"
                   @onchange="HandleToggleChange"
                   disabled="@IsProcessing">
            <label class="form-check-label text-white-full" for="pushNotificationSwitch">
                @if (IsProcessing)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                }
                <i class="bi bi-bell@(IsSubscribed ? "-fill" : "")"></i>
                Push Notifications
            </label>
        </div>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-danger alert-sm mt-2 mb-0" role="alert">
                <i class="bi bi-exclamation-triangle"></i> @ErrorMessage
            </div>
        }

        @if (!string.IsNullOrEmpty(SuccessMessage))
        {
            <div class="alert alert-success alert-sm mt-2 mb-0" role="alert">
                <i class="bi bi-check-circle"></i> @SuccessMessage
            </div>
        }

        @if (ShowAndroidHint)
        {
            <div class="alert alert-warning alert-sm mt-2 mb-0" role="alert">
                <i class="bi bi-phone"></i> <strong>Não recebe notificações?</strong>
                <br/>Verifique nas definições do Android se as notificações estão ativadas para esta aplicação.
                <br/><small class="text-muted">Definições → Aplicações → RTUB (ou Chrome) → Notificações</small>
            </div>
        }
    }
</div>

@code {
    // Passed to setPushSubscription. Blazor Server's 60 s JS-interop default (CircuitOptions.
    // JSInteropDefaultCallTimeout) applies only to calls made WITHOUT a token, and a browser promise
    // cannot be cancelled: timing out re-enabled the switch while the first request was still running.
    // With this token the switch stays disabled until the browser answers; disposal ends the wait.
    private readonly CancellationTokenSource _lifetime = new();

    private bool IsLoading { get; set; } = true;
    private bool HasAccess { get; set; } = false;
    private bool IsSubscribed { get; set; } = false;
    private bool IsProcessing { get; set; } = false;
    private bool RequestedState { get; set; } = false;
    private bool ShowAndroidHint { get; set; } = false;
    private string? ErrorMessage { get; set; }
    private string? SuccessMessage { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // Check if user has access via the API.
                // syncOptOut: false - a read-only status fetch. The toggle must not reconcile the
                // local opted-out cache as a side effect of rendering; only the Prompt path does.
                var status = await JSRuntime.InvokeAsync<PushStatusDto?>("pwaHelper.getPushStatus", false);

                if (status != null && status.IsEnabled && status.IsConfigured)
                {
                    HasAccess = true;

                    // Initialize push manager
                    await InitializePushManager();
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error checking push notification status");
            }
            finally
            {
                IsLoading = false;
                StateHasChanged();
            }
        }
    }

    private async Task InitializePushManager()
    {
        try
        {
            // Creates a fresh manager and stores it on window.rtubPushManager
            var initialized = await JSRuntime.InvokeAsync<bool>("pwaHelper.initializePushManager");

            // Only check subscription status if initialization succeeded
            if (initialized)
            {
                IsSubscribed = await JSRuntime.InvokeAsync<bool>("pwaHelper.isSubscribedToPush");

                // Show Android notification hint if subscribed but on Android
                // Android 13+ may have OS-level notification blocking even when browser permission is granted
                if (IsSubscribed)
                {
                    ShowAndroidHint = await JSRuntime.InvokeAsync<bool>("pwaHelper.isAndroidPwa");
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error initializing push manager");
        }
    }

    private async Task HandleToggleChange(ChangeEventArgs e)
    {
        // One subscribe/unsubscribe at a time. The switch is disabled while one runs, but a tap can
        // reach the server before the disabled switch reaches the browser.
        if (IsProcessing)
        {
            return;
        }

        var isChecked = (bool)(e.Value ?? false);
        RequestedState = isChecked;
        ClearMessages();

        if (isChecked)
        {
            await Subscribe();
        }
        else
        {
            await Unsubscribe();
        }
    }

    private async Task Subscribe()
    {
        IsProcessing = true;
        StateHasChanged();

        try
        {
            var success = await JSRuntime.InvokeAsync<bool>("pwaHelper.setPushSubscription", _lifetime.Token, true);

            if (success)
            {
                IsSubscribed = true;
                SuccessMessage = "Successfully subscribed to push notifications!";
                ClearMessageAfterDelay(() => SuccessMessage = null);
            }
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
            // Disposed mid-call (navigation, circuit teardown): not a subscription failure.
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error subscribing to push notifications");
            ErrorMessage = "Failed to subscribe to push notifications. Please try again.";
            IsSubscribed = false;
        }
        finally
        {
            IsProcessing = false;
            if (!_lifetime.IsCancellationRequested)
            {
                StateHasChanged();
            }
        }
    }

    private async Task Unsubscribe()
    {
        IsProcessing = true;
        StateHasChanged();

        try
        {
            var success = await JSRuntime.InvokeAsync<bool>("pwaHelper.setPushSubscription", _lifetime.Token, false);

            if (success)
            {
                IsSubscribed = false;
                SuccessMessage = "Successfully unsubscribed from push notifications.";
                ClearMessageAfterDelay(() => SuccessMessage = null);
            }
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
            // Disposed mid-call (navigation, circuit teardown): not an unsubscribe failure.
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error unsubscribing from push notifications");
            ErrorMessage = "Failed to unsubscribe from push notifications. Please try again.";
            IsSubscribed = true;
        }
        finally
        {
            IsProcessing = false;
            if (!_lifetime.IsCancellationRequested)
            {
                StateHasChanged();
            }
        }
    }

    private void ClearMessages()
    {
        ErrorMessage = null;
        SuccessMessage = null;
    }

    private void ClearMessageAfterDelay(Action clearAction, int delayMs = 3000)
    {
        _ = Task.Run(async () =>
        {
            await Task.Delay(delayMs);
            if (_lifetime.IsCancellationRequested)
            {
                return; // disposed meanwhile: nothing left to render
            }
            clearAction();
            await InvokeAsync(StateHasChanged);
        });
    }

    public void Dispose()
    {
        // Cancels a subscribe/unsubscribe still waiting on the browser - see the catch filters.
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
