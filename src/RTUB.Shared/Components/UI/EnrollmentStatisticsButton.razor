@namespace RTUB.Shared
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using RTUB.Application.Interfaces
@using RTUB.Application.Helpers
@using RTUB.Application.Extensions
@using RTUB.Core.Enums
@inject IEnrollmentService EnrollmentService
@inject IEventService EventService
@inject UserManager<ApplicationUser> UserManager

@*
    Enrollment Statistics Button Component
    Shows statistics of member enrollments in events
    Member-only component
*@

<AuthorizeView>
    <Authorized>
        <button class="btn btn-outline-primary" @onclick="OpenStatsModal" title="Ver Estatísticas">
            <i class="bi bi-bar-chart"></i> Estatísticas
        </button>
    </Authorized>
</AuthorizeView>

<!-- Statistics Modal -->
@if (showStatsModal)
{
    <Modal Show="@showStatsModal"
           ShowChanged="@((bool show) => showStatsModal = show)"
           Title="Estatísticas de Inscrições"
           Size="Modal.ModalSize.Large"
           Centered="true">
        <BodyContent>
            <div class="mb-3">
                <div class="row g-2">
                    <div class="col-md-3">
                        <label class="form-label">Data Início</label>
                        <input type="date" class="form-control" @bind="statsStartDate" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Data Fim</label>
                        <input type="date" class="form-control" @bind="statsEndDate" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Categoria</label>
                        <FilterDropdown SelectedValue="@selectedCategoryFilter"
                                        SelectedValueChanged="@(value => selectedCategoryFilter = value)"
                                        OnChange="@FilterStats"
                                        AllItemsLabel="Todos"
                                        Options="@categoryFilterOptions" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">&nbsp;</label>
                        <button class="btn btn-primary w-100 d-block" @onclick="LoadStats">Carregar Estatísticas</button>
                    </div>
                </div>
            </div>

            @if (enrollmentStatsUsers != null && enrollmentStatsUsers.Any())
            {
                <!-- Search Bar -->
                <div class="mb-3">
                    <SearchBar @bind-Value="statsSearchTerm"
                               Placeholder="Pesquisar por nome..."
                               OnSearch="@HandleStatsSearchChanged" />
                </div>

                @if (!filteredStatsUsers.Any())
                {
                    <EmptyState 
                        Title="Nenhum membro encontrado com os critérios de pesquisa." 
                        Icon="bi-search" />
                }
                else
                {
                    <div class="member-card-lite-grid">
                        @foreach (var stat in paginatedStatsUsers)
                        {
                            <MemberCardLite AvatarUrl="@stat.AvatarUrl"
                                            AltText="@stat.DisplayName"
                                            Nickname="@stat.DisplayNickname"
                                            FullName="@stat.DisplayFullName">
                                <CategoryContent>
                                    @foreach (var category in stat.Categories)
                                    {
                                        <CategoryBadge Category="@category" />
                                    }
                                </CategoryContent>
                                <PrimaryRowContent>
                                    <div class="d-flex flex-column align-items-center gap-1">
                                        <div class="d-flex flex-wrap align-items-center gap-2 justify-content-center">
                                            @if (stat.PastCount > 0)
                                            {
                                                <span class="badge bg-success">@stat.PastCount Participações</span>
                                            }
                                            @if (stat.FutureCount > 0)
                                            {
                                                <span class="badge bg-warning text-dark">@stat.FutureCount Por Participar</span>
                                            }
                                            @if (stat.FutureCount == 0 && stat.PastCount == 0)
                                            {
                                                <span class="text-muted">Sem participações</span>
                                            }
                                        </div>
                                        @if (totalPastEventsInRange > 0 && stat.PastCount > 0)
                                        {
                                            <div class="text-muted small">
                                                @stat.AttendancePercentage.ToString("0.0")% de @totalPastEventsInRange atuações
                                            </div>
                                        }
                                    </div>
                                </PrimaryRowContent>
                            </MemberCardLite>
                        }
                    </div>

                    <!-- Pagination -->
                    <TablePagination CurrentPage="@statsPaginationHelper.CurrentPage"
                                    PageSize="@statsPaginationHelper.PageSize"
                                    TotalItems="@filteredStatsUsers.Count"
                                    ItemLabel="membros"
                                    PageSizeOptions="@(new[] { 15, 30, 45, 60 })"
                                    OnPageChanged="@HandleStatsPageChange"
                                    OnPageSizeChanged="@HandleStatsPageSizeChange" />
                }
            }
            else if (enrollmentStatsUsers != null)
            {
                <EmptyState 
                    Title="Sem dados para o período selecionado." 
                    Icon="bi-info-circle" />
            }
        </BodyContent>
        <FooterContent>
            <button type="button" class="btn btn-secondary" @onclick="CloseStatsModal">Fechar</button>
        </FooterContent>
    </Modal>
}

@code {
    private bool showStatsModal = false;
    
    // Default dates set to current fiscal year (Sept 1 - Aug 31)
    private DateTime statsStartDate = GetCurrentFiscalYearStart();
    private DateTime statsEndDate = GetCurrentFiscalYearEnd();
    
    private List<UserEnrollmentStats>? enrollmentStatsUsers;
    private List<UserEnrollmentStats> filteredStatsUsers = new();
    private List<UserEnrollmentStats> paginatedStatsUsers = new();
    private string statsSearchTerm = string.Empty;
    private string selectedCategoryFilter = string.Empty;
    private int totalPastEventsInRange = 0;
    private SortableTableHelper<UserEnrollmentStats> statsSortHelper = new() { SortColumn = nameof(UserEnrollmentStats.PastCount), SortAscending = false };
    private PaginationHelper<UserEnrollmentStats> statsPaginationHelper = new() { PageSize = 15 };

    // Category filter options
    private IEnumerable<FilterDropdownOption> categoryFilterOptions => new[]
    {
        new FilterDropdownOption("Tuno", "Tunos"),
        new FilterDropdownOption("Caloiro", "Caloiros"),
        new FilterDropdownOption("Leitao", "Leitões")
    };

    /// <summary>
    /// Gets the start date of the current fiscal year (September 1st)
    /// </summary>
    private static DateTime GetCurrentFiscalYearStart()
    {
        var startYear = FiscalYearHelper.GetCurrentFiscalYearStartYear();
        return new DateTime(startYear, 9, 1);
    }

    /// <summary>
    /// Gets the end date of the current fiscal year (August 31st of the following year)
    /// </summary>
    private static DateTime GetCurrentFiscalYearEnd()
    {
        var startYear = FiscalYearHelper.GetCurrentFiscalYearStartYear();
        return new DateTime(startYear + 1, 8, 31);
    }

    private void OpenStatsModal()
    {
        showStatsModal = true;
    }

    private void CloseStatsModal()
    {
        showStatsModal = false;
    }

    private async Task LoadStats()
    {
        try
        {
            var allEnrollments = await EnrollmentService.GetAllEnrollmentsAsync();
            
            // Filter by date range
            var filteredEnrollments = allEnrollments
                .Where(e => e.Event != null && 
                           e.Event.Date.Date >= statsStartDate.Date && 
                           e.Event.Date.Date <= statsEndDate.Date &&
                           e.WillAttend)
                .ToList();

            // Count total past events in range for percentage calculation
            var allEvents = await EventService.GetAllEventsAsync();
            totalPastEventsInRange = allEvents
                .Count(e => e.Date.Date >= statsStartDate.Date && 
                           e.Date.Date <= statsEndDate.Date && 
                           e.Date.Date < DateTime.Today &&
                           !e.IsCancelled);

            // Group by user and count future vs past
            var stats = filteredEnrollments
                .GroupBy(e => e.UserId)
                .Select(g => new { 
                    UserId = g.Key, 
                    FutureCount = g.Count(e => e.Event!.Date >= DateTime.Today),
                    PastCount = g.Count(e => e.Event!.Date < DateTime.Today)
                })
                .ToList();

            // Load all users at once to ensure Categories are loaded correctly
            // Using Users query with AsNoTracking ensures EF Core properly materializes primitive collections
            var userIds = stats.Select(s => s.UserId).ToList();
            var allUsers = await UserManager.Users
                .AsNoTracking()
                .Where(u => userIds.Contains(u.Id))
                .ToListAsync();
            var userLookup = allUsers.ToDictionary(u => u.Id);

            enrollmentStatsUsers = new List<UserEnrollmentStats>();
            
            foreach (var stat in stats)
            {
                if (userLookup.TryGetValue(stat.UserId, out var user))
                {
                    enrollmentStatsUsers.Add(new UserEnrollmentStats
                    {
                        UserId = stat.UserId,
                        UserName = user.GetDisplayName(),
                        Nickname = user.Nickname ?? string.Empty,
                        FirstName = user.FirstName ?? string.Empty,
                        LastName = user.LastName ?? string.Empty,
                        AvatarUrl = user.ProfilePictureSrc,
                        Categories = StatusHelper.GetDisplayCategories(user),
                        FutureCount = stat.FutureCount,
                        PastCount = stat.PastCount,
                        TotalPastEvents = totalPastEventsInRange
                    });
                }
            }
            
            FilterStats();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading stats: {ex.Message}");
            enrollmentStatsUsers = new List<UserEnrollmentStats>();
        }
    }

    private void FilterStats()
    {
        if (enrollmentStatsUsers == null)
        {
            filteredStatsUsers = new List<UserEnrollmentStats>();
            paginatedStatsUsers = new List<UserEnrollmentStats>();
            return;
        }

        var filtered = enrollmentStatsUsers.AsEnumerable();

        // Apply category filter
        if (!string.IsNullOrEmpty(selectedCategoryFilter))
        {
            filtered = selectedCategoryFilter switch
            {
                "Tuno" => filtered.Where(s => s.Categories.Contains(MemberCategory.Tuno) || 
                                             s.Categories.Contains(MemberCategory.Veterano) || 
                                             s.Categories.Contains(MemberCategory.Tunossauro)),
                "Caloiro" => filtered.Where(s => s.Categories.Contains(MemberCategory.Caloiro)),
                "Leitao" => filtered.Where(s => s.Categories.Contains(MemberCategory.Leitao)),
                _ => filtered
            };
        }

        // Apply search
        if (!string.IsNullOrWhiteSpace(statsSearchTerm))
        {
            var search = statsSearchTerm.ToLower();
            filtered = filtered.Where(s => s.SearchText.Contains(search));
        }

        filteredStatsUsers = filtered.ToList();

        // Apply sorting
        if (statsSortHelper.SortColumn == nameof(UserEnrollmentStats.PastCount))
        {
            filteredStatsUsers = statsSortHelper.SortAscending
                ? filteredStatsUsers
                    .OrderBy(s => s.PastCount)
                    .ThenBy(s => s.FutureCount)
                    .ToList()
                : filteredStatsUsers
                    .OrderByDescending(s => s.PastCount)
                    .ThenByDescending(s => s.FutureCount)
                    .ToList();
        }
        else
        {
            var columnSelectors = new Dictionary<string, Func<UserEnrollmentStats, IComparable>>
            {
                { nameof(UserEnrollmentStats.UserName), s => s.UserName },
                { nameof(UserEnrollmentStats.PastCount), s => s.PastCount }
            };
            filteredStatsUsers = statsSortHelper.ApplySort(filteredStatsUsers, columnSelectors);
        }

        // Reset pagination when filter changes
        statsPaginationHelper.Reset();

        // Apply pagination
        paginatedStatsUsers = statsPaginationHelper.GetPageData(filteredStatsUsers);
    }

    private async Task HandleStatsSearchChanged(string searchTerm)
    {
        statsSearchTerm = searchTerm;
        FilterStats();
        await Task.CompletedTask;
    }

    private void SortStatsBy(string columnName)
    {
        statsSortHelper.ChangeSortColumn(columnName);
        FilterStats();
    }

    private async Task HandleStatsPageChange(int newPage)
    {
        statsPaginationHelper.GoToPage(newPage);
        paginatedStatsUsers = statsPaginationHelper.GetPageData(filteredStatsUsers);
        await Task.CompletedTask;
    }

    private async Task HandleStatsPageSizeChange(int newPageSize)
    {
        statsPaginationHelper.PageSize = newPageSize;
        statsPaginationHelper.Reset();
        paginatedStatsUsers = statsPaginationHelper.GetPageData(filteredStatsUsers);
        await Task.CompletedTask;
    }

    private class UserEnrollmentStats
    {
        public string UserId { get; set; } = string.Empty;
        public string UserName { get; set; } = string.Empty;
        public string Nickname { get; set; } = string.Empty;
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string AvatarUrl { get; set; } = string.Empty;
        public List<MemberCategory> Categories { get; set; } = new();
        public int FutureCount { get; set; }
        public int PastCount { get; set; }
        public int TotalPastEvents { get; set; }

        public string DisplayNickname => !string.IsNullOrWhiteSpace(Nickname) ? Nickname : UserName;

        public string DisplayFullName
        {
            get
            {
                var fullName = $"{FirstName} {LastName}".Trim();
                return string.IsNullOrWhiteSpace(fullName) ? UserName : fullName;
            }
        }

        public string DisplayName => !string.IsNullOrWhiteSpace(UserName) ? UserName : DisplayFullName;

        public string SearchText => $"{DisplayNickname} {DisplayFullName}".ToLower();

        public double AttendancePercentage => TotalPastEvents > 0 ? (double)PastCount / TotalPastEvents * 100 : 0;
    }
}
