@using Microsoft.Extensions.Logging
@using Microsoft.Extensions.Options
@using Microsoft.AspNetCore.Components.Authorization
@using RTUB.Application.Configuration
@inject IJSRuntime JSRuntime
@inject ILogger<LoginPopup> Logger
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IOptions<LoginPopupOptions> Options

@if (ShowPopup)
{
    <div class="login-popup-overlay">
        <div class="login-popup-card" @onclick:stopPropagation="true">
            <div class="login-popup-icon">
                <i class="bi bi-info-circle-fill" aria-hidden="true"></i>
            </div>
            <h3 class="login-popup-title">@Options.Value.Title</h3>
            <p class="login-popup-message">
                @Options.Value.Description
            </p>
            <div class="login-popup-buttons">
                <button class="btn btn-primary btn-primary-purple" @onclick="HandleDismiss" aria-label="@Options.Value.ButtonText">
                    @Options.Value.ButtonText
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool ShowPopup { get; set; } = false;
    private const string LocalStorageKeyPrefix = "login-popup-read-";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // Check if popup is enabled in configuration
                if (!Options.Value.Enabled)
                {
                    return;
                }

                // Check if user is authenticated
                var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
                if (!(authState.User.Identity?.IsAuthenticated ?? false))
                {
                    return;
                }

                // If ReadOnce is true, check localStorage to see if this version was already shown
                if (Options.Value.ReadOnce)
                {
                    var storageKey = $"{LocalStorageKeyPrefix}{Options.Value.Version}";
                    var alreadyRead = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", storageKey);
                    if (alreadyRead != null)
                    {
                        return;
                    }
                }

                // Show popup
                ShowPopup = true;
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error checking if login popup should be shown");
            }
        }
    }

    private async Task HandleDismiss()
    {
        // If ReadOnce is true, mark this version as read in localStorage
        if (Options.Value.ReadOnce)
        {
            try
            {
                var storageKey = $"{LocalStorageKeyPrefix}{Options.Value.Version}";
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", storageKey, "true");
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error marking login popup as read");
            }
        }

        ShowPopup = false;
        StateHasChanged();
    }
}
