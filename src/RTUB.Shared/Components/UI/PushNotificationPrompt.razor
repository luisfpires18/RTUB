@namespace RTUB.Shared
@using Microsoft.Extensions.Logging
@using Microsoft.AspNetCore.Components.Authorization
@using RTUB.Application.DTOs
@inject IJSRuntime JSRuntime
@inject ILogger<PushNotificationPrompt> Logger
@inject AuthenticationStateProvider AuthenticationStateProvider

@if (ShowPrompt)
{
    <div class="push-prompt-overlay">
        <div class="push-prompt-card" @onclick:stopPropagation="true">
            <div class="push-prompt-icon">
                <i class="bi bi-bell-fill"></i>
            </div>
            <h3 class="push-prompt-title">@(IsRecoveryMode ? "Reativar Notificações?" : "Ativar Notificações?")</h3>
            <p class="push-prompt-message">
                @if (IsRecoveryMode)
                {
                    <text>As suas notificações push foram desativadas. Reative para continuar a receber atualizações sobre atuações, ensaios e mensagens.</text>
                }
                else
                {
                    <text>Receba notificações sobre atuações, ensaios, mensagens e outras atualizações importantes da RTUB.</text>
                }
            </p>
            <div class="push-prompt-buttons">
                <button class="btn btn-primary btn-primary-purple" @onclick="HandleAllow" disabled="@IsProcessing" aria-label="Ativar notificações push">
                    @if (IsProcessing)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    }
                    Ativar
                </button>
                <button class="btn btn-outline-secondary" @onclick="HandleDismiss" disabled="@IsProcessing" aria-label="Dispensar">
                    Agora Não
                </button>
            </div>
            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="alert alert-danger alert-sm mt-3 mb-0" role="alert">
                    <i class="bi bi-exclamation-triangle"></i> @ErrorMessage
                </div>
            }
        </div>
    </div>
}

@code {
    private bool ShowPrompt { get; set; } = false;
    private bool IsProcessing { get; set; } = false;
    private bool IsRecoveryMode { get; set; } = false;
    private string? ErrorMessage { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // Check if user is authenticated
                var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
                if (!(authState.User.Identity?.IsAuthenticated ?? false))
                {
                    return;
                }

                // In PWA/TWA mode, check subscription health first
                // This handles cases where Chrome rotated the push endpoint
                // or the subscription expired while the app was closed
                var isPwa = await JSRuntime.InvokeAsync<bool>("pwaHelper.isPwaMode");
                if (isPwa)
                {
                    var health = await JSRuntime.InvokeAsync<string>("pwaHelper.checkSubscriptionHealth");
                    
                    if (health == "missing" || health == "expired")
                    {
                        // Subscription was lost - attempt silent re-subscribe first
                        var status = await JSRuntime.InvokeAsync<PushStatusDto?>("pwaHelper.getPushStatus");
                        if (status != null && status.IsEnabled && status.IsConfigured)
                        {
                            // Try automatic recovery (only if permission was already granted)
                            var permissionGranted = await JSRuntime.InvokeAsync<bool>("pwaHelper.isPushPermissionGranted");
                            
                            if (permissionGranted)
                            {
                                var recovered = await TrySilentResubscribe();
                                if (recovered)
                                {
                                    return; // Successfully recovered, no prompt needed
                                }
                            }
                            
                            // Silent recovery failed - show the prompt in recovery mode
                            IsRecoveryMode = true;
                            ShowPrompt = true;
                            StateHasChanged();
                            return;
                        }
                    }
                }

                // Standard first-time prompt flow
                var shouldShow = await JSRuntime.InvokeAsync<bool>("pwaHelper.shouldShowPushPrompt");

                if (shouldShow)
                {
                    // Check if push notifications are available and configured
                    var status = await JSRuntime.InvokeAsync<PushStatusDto?>("pwaHelper.getPushStatus");

                    if (status != null && status.IsEnabled && status.IsConfigured)
                    {
                        ShowPrompt = true;
                        StateHasChanged();
                    }
                }
            }
            catch (TaskCanceledException) { }
            catch (Microsoft.JSInterop.JSDisconnectedException) { }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error checking if push prompt should be shown");
            }
        }
    }

    /// <summary>
    /// Attempts to silently re-subscribe to push notifications without user interaction.
    /// This handles the case where Chrome rotated the push endpoint while the app was closed.
    /// Returns true if the re-subscription was successful.
    /// </summary>
    private async Task<bool> TrySilentResubscribe()
    {
        try
        {
            // Initialize push manager
            var initialized = await JSRuntime.InvokeAsync<bool>("pwaHelper.initializePushManager");
            if (!initialized)
            {
                return false;
            }

            // Use the validate and refresh method which handles re-subscription
            var result = await JSRuntime.InvokeAsync<string>("pwaHelper.validateAndRefreshPushSubscription");

            if (result == "active" || result == "refreshed")
            {
                Logger.LogInformation("Push subscription silently recovered: {Result}", result);
                // Clear the subscription-lost flag
                await JSRuntime.InvokeVoidAsync("pwaHelper.clearSubscriptionLost");
                return true;
            }

            return false;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Silent push re-subscription failed");
            return false;
        }
    }

    private async Task HandleAllow()
    {
        IsProcessing = true;
        ErrorMessage = null;
        StateHasChanged();

        try
        {
            // Initialize push manager if needed
            var initialized = await JSRuntime.InvokeAsync<bool>("pwaHelper.initializePushManager");

            if (initialized)
            {
                // Subscribe to push notifications
                var success = await JSRuntime.InvokeAsync<bool>("pwaHelper.subscribeToPush");

                if (success)
                {
                    // Mark as prompted
                    await JSRuntime.InvokeVoidAsync("pwaHelper.markAsPrompted");
                    
                    // Hide the prompt
                    ShowPrompt = false;
                    StateHasChanged();
                }
                else
                {
                    ErrorMessage = "Não foi possível ativar as notificações. Por favor, tente novamente.";
                }
            }
            else
            {
                ErrorMessage = "As notificações push não estão disponíveis neste momento.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error subscribing to push notifications");
            ErrorMessage = "Erro ao ativar notificações. Pode alterar nas definições do perfil.";
            
            // Still mark as prompted so we don't keep bothering the user
            try
            {
                await JSRuntime.InvokeVoidAsync("pwaHelper.markAsPrompted");
            }
            catch
            {
                // Ignore
            }
        }
        finally
        {
            IsProcessing = false;
            StateHasChanged();
        }
    }

    private async Task HandleDismiss()
    {
        if (IsProcessing) return;

        try
        {
            // Mark as prompted so we don't show again
            await JSRuntime.InvokeVoidAsync("pwaHelper.markAsPrompted");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error marking push prompt as dismissed");
        }

        ShowPrompt = false;
        StateHasChanged();
    }
}
