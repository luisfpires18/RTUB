@namespace RTUB.Shared
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable
@*
    Unsaved-change protection for one form (docs/design/RTUB_UI_REFACTOR.md 24.3-24.5).
    While IsDirty:
    - reload, tab close and links out of the app get the browser's own prompt
      (NavigationLock.ConfirmExternalNavigation);
    - leaving inside the app asks the shared "Descartar alterações?" dialog: NavigateTo through
      NavigationLock, links and Back/Forward through modalHelper.js (static routing never reaches
      NavigationLock), which calls ConfirmLeave;
    - the service-worker update toast holds its reload.
    ConfirmDiscardAsync() is the same question for Cancel buttons (true at once when clean).
    OnDiscard runs when the user discarded to leave (reset the form / close its dialog).
    Modal embeds one when given IsDirty; a page form places its own.
*@

<NavigationLock ConfirmExternalNavigation="@_dirty"
                OnBeforeInternalNavigation="OnBeforeInternalNavigationAsync" />

<ConfirmDialog Show="@_asking"
               ShowChanged="@(show => { if (!show) Answer(false); })"
               Title="Descartar alterações?"
               Message="Tem alterações que ainda não foram guardadas."
               WarningMessage="Se continuar, perdem-se."
               CancelText="Continuar a editar"
               ConfirmText="Descartar"
               ConfirmButtonClass="btn-danger"
               OnConfirm="() => Answer(true)"
               OnCancel="() => Answer(false)" />

@code {
    /// <summary>Whether the form has unsaved changes (usually <c>() =&gt; changes.IsDirty</c>).</summary>
    [Parameter, EditorRequired] public Func<bool> IsDirty { get; set; } = () => false;

    /// <summary>Runs after the user chose to discard during a navigation (reset the form).</summary>
    [Parameter] public EventCallback OnDiscard { get; set; }

    private readonly string _id = "unsaved-" + Guid.NewGuid().ToString("N")[..10];
    private bool _dirty;
    private bool _reported;
    private bool _asking;
    private TaskCompletionSource<bool>? _answer;
    private DotNetObjectReference<UnsavedChangesGuard>? _selfReference;

    protected override void OnParametersSet() => _dirty = IsDirty();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_dirty != _reported)
        {
            _reported = _dirty;
            await SetUnsavedFlagAsync(_dirty);
        }
    }

    /// <summary>
    /// True when the form is clean or the user chose "Descartar"; false for "Continuar a editar"
    /// (also Escape, Back or a cancelled navigation while asking).
    /// </summary>
    public async Task<bool> ConfirmDiscardAsync(CancellationToken cancellationToken = default)
    {
        if (!IsDirty())
        {
            return true;
        }

        if (_answer == null)
        {
            _answer = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
            _asking = true;
            await InvokeAsync(StateHasChanged);
        }

        var answer = _answer;
        using var registration = cancellationToken.Register(() => _ = InvokeAsync(() => Answer(false)));
        var discard = await answer.Task;
        if (discard)
        {
            _dirty = false;
            await SetUnsavedFlagAsync(false);
            _reported = false;
        }
        return discard;
    }

    private void Answer(bool discard)
    {
        _asking = false;
        var answer = _answer;
        _answer = null;
        answer?.TrySetResult(discard);
        StateHasChanged();
    }

    /// <summary>A link or Back/Forward is leaving while dirty (modalHelper.js). True = go.</summary>
    [JSInvokable]
    public async Task<bool> ConfirmLeave()
    {
        var leave = false;
        await InvokeAsync(async () =>
        {
            leave = await ConfirmDiscardAsync();
            if (leave)
            {
                await OnDiscard.InvokeAsync();
            }
        });
        return leave;
    }

    private async Task OnBeforeInternalNavigationAsync(LocationChangingContext context)
    {
        if (!IsDirty())
        {
            return;
        }

        if (!await ConfirmDiscardAsync(context.CancellationToken))
        {
            context.PreventNavigation();
            return;
        }

        await OnDiscard.InvokeAsync();
    }

    private async Task SetUnsavedFlagAsync(bool dirty)
    {
        try
        {
            _selfReference ??= DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("modalHelper.setUnsavedChanges", _id, _selfReference, dirty);
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException or TaskCanceledException or InvalidOperationException)
        {
            // The update toast's hold is an enhancement; prerendering has no JS.
        }
    }

    public async ValueTask DisposeAsync()
    {
        _answer?.TrySetResult(false);
        if (_selfReference != null)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("modalHelper.removeGuard", _id);
            }
            catch (Exception e) when (e is JSException or JSDisconnectedException or TaskCanceledException or InvalidOperationException)
            {
            }
            _selfReference.Dispose();
        }
    }
}
