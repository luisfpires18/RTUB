@namespace RTUB.Shared
@using RTUB.Core.Entities
@using RTUB.Core.Enums
@using RTUB.Application.Extensions
@*
    MeetingRequestCard Component
    Card for displaying meeting request information (CV or AG)
*@

<div class="card request-card h-100">
    <div class="position-relative">
        @if (IsAuthor)
        {
            <div class="request-admin-overlay" style="flex-direction: column;">
                <button class="btn btn-sm music-btn-delete" @onclick="HandleDelete" title="Eliminar">
                    <i class="bi bi-trash music-icon-delete"></i>
                </button>
                @if (ShowReminder && MeetingRequest.Status == RequestStatus.Pending)
                {
                    <button class="btn btn-sm" style="background-color: rgba(255, 255, 255, 0.85); border: none; padding: 6px 10px;" @onclick="HandleSendReminder" title="Enviar Lembrete">
                        <i class="bi bi-bell-fill" style="font-size: 1.1rem; color: #333; transition: transform 0.2s ease;"></i>
                    </button>
                }
            </div>
        }
        <div class="request-icon-header">
            <div class="request-icon-circle">
                @if (MeetingRequest.RequestedMeetingType == MeetingType.ConselhoVeteranos)
                {
                    <i class="bi bi-megaphone-fill"></i>
                }
                else if (MeetingRequest.RequestedMeetingType == MeetingType.ReuniaoDirecao)
                {
                    <i class="bi bi-briefcase-fill"></i>
                }
                else
                {
                    <i class="bi bi-people-fill"></i>
                }
            </div>
        </div>
    </div>
    <div class="card-body d-flex flex-column">
        <div class="request-info">
            <!-- Meeting Type Badge -->
            <div class="mb-2">
                <span class="badge @GetMeetingTypeBadgeClass()">
                    @GetMeetingTypeDisplayName()
                </span>
            </div>
            
            <!-- Author Nickname -->
            <div class="request-info-row">
                <i class="bi bi-person request-icon"></i>
                <span class="request-text fw-bold">@(MeetingRequest.Author?.Nickname ?? "Desconhecido")</span>
            </div>
            
            <!-- Proposed Date -->
            <div class="request-info-row">
                <i class="bi bi-calendar3 request-icon"></i>
                <span class="request-text">@MeetingRequest.ProposedDateTime.ToPortugueseShortDate()</span>
            </div>
            
            <!-- Location -->
            @if (!string.IsNullOrEmpty(MeetingRequest.Location))
            {
                <div class="request-info-row">
                    <i class="bi bi-geo-alt request-icon"></i>
                    <span class="request-text">@MeetingRequest.Location</span>
                </div>
            }

            <!-- Status Badge -->
            <div class="mt-2">
                <StatusBadge Status="@MeetingRequest.Status" />
            </div>
        </div>

        <div class="request-actions mt-auto">
            <div class="d-flex gap-2 align-items-center justify-content-center flex-wrap">
                <!-- View Details button -->
                <button class="btn btn-sm btn-outline-primary d-flex align-items-center gap-1" 
                        @onclick="HandleViewDetails" 
                        title="Ver Detalhes">
                    <i class="bi bi-eye-fill"></i>
                    <span>Ver Detalhes</span>
                </button>

                @if (CanApproveReject && MeetingRequest.Status == RequestStatus.Pending)
                {
                    <!-- Accept button -->
                    <button class="btn btn-sm btn-success d-flex align-items-center" 
                            @onclick="HandleAccept" 
                            title="Aceitar">
                        <i class="bi bi-check-circle-fill"></i>
                    </button>

                    <!-- Reject button -->
                    <button class="btn btn-sm btn-danger d-flex align-items-center" 
                            @onclick="HandleReject" 
                            title="Rejeitar">
                        <i class="bi bi-x-circle-fill"></i>
                    </button>
                }
            </div>
        </div>
    </div>
</div>

@code {
    /// <summary>
    /// The meeting request to display
    /// </summary>
    [Parameter]
    public MeetingRequest MeetingRequest { get; set; } = null!;

    /// <summary>
    /// Whether the current user is the author (has delete permissions)
    /// </summary>
    [Parameter]
    public bool IsAuthor { get; set; }

    /// <summary>
    /// Whether the current user can approve/reject requests
    /// </summary>
    [Parameter]
    public bool CanApproveReject { get; set; }

    /// <summary>
    /// Callback when the view details button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnViewDetails { get; set; }

    /// <summary>
    /// Callback when the delete button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnDelete { get; set; }

    /// <summary>
    /// Callback when the accept button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnAccept { get; set; }

    /// <summary>
    /// Callback when the reject button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnReject { get; set; }

    /// <summary>
    /// Whether to show the send reminder button
    /// </summary>
    [Parameter]
    public bool ShowReminder { get; set; }

    /// <summary>
    /// Callback when the send reminder button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnSendReminder { get; set; }

    private async Task HandleViewDetails()
    {
        if (OnViewDetails.HasDelegate)
        {
            await OnViewDetails.InvokeAsync();
        }
    }

    private async Task HandleDelete()
    {
        if (OnDelete.HasDelegate)
        {
            await OnDelete.InvokeAsync();
        }
    }

    private async Task HandleAccept()
    {
        if (OnAccept.HasDelegate)
        {
            await OnAccept.InvokeAsync();
        }
    }

    private async Task HandleReject()
    {
        if (OnReject.HasDelegate)
        {
            await OnReject.InvokeAsync();
        }
    }

    private async Task HandleSendReminder()
    {
        if (OnSendReminder.HasDelegate)
        {
            await OnSendReminder.InvokeAsync();
        }
    }
    
    private string GetMeetingTypeBadgeClass()
    {
        return MeetingRequest.RequestedMeetingType switch
        {
            MeetingType.ConselhoVeteranos => "bg-secondary",  // Grey for veteran council
            MeetingType.AssembleiaGeralOrdinaria => "bg-primary",  // Blue for ordinary assembly
            MeetingType.AssembleiaGeralExtraordinaria => "bg-primary",  // Blue for extraordinary assembly
            MeetingType.ReuniaoDirecao => "bg-info",  // Light blue for board meetings
            _ => "bg-secondary"
        };
    }
    
    private string GetMeetingTypeDisplayName()
    {
        return MeetingRequest.RequestedMeetingType switch
        {
            MeetingType.ConselhoVeteranos => "Conselho de Veteranos",
            MeetingType.AssembleiaGeralOrdinaria => "Assembleia Geral Ordinária",
            MeetingType.AssembleiaGeralExtraordinaria => "Assembleia Geral Extraordinária",
            MeetingType.ReuniaoDirecao => "Reunião de Direção",
            _ => "Desconhecido"
        };
    }
}
