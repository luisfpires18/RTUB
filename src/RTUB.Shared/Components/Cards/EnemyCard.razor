@namespace RTUB.Shared
@using RTUB.Core.Entities

@* EnemyCard Component - Displays an enemy character card for My Tuno battles with fantasy-style stats *@

<div class="enemy-card card h-100">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h6 class="mb-0">
            <i class="bi bi-person me-2"></i>
            @if (Character?.User != null)
            {
                @Character.User.UserName
            }
            else
            {
                <text>Personagem</text>
            }
        </h6>
        @if (ArenaRating > 0)
        {
            <span class="badge" style="background-color: #ffc107; color: #000;" title="Arena Rating">
                <i class="bi bi-graph-up-arrow me-1"></i>@ArenaRating
            </span>
        }
    </div>
    <div class="card-body d-flex flex-column">
        <!-- Avatar and User Info -->
        @if (Character?.User != null)
        {
            <div class="text-center mb-3">
                <div class="avatar-card-image-wrapper d-inline-block mb-2" style="width: 80px; height: 80px;">
                    <img src="@CacheBuster.Bust(Character.User.ImageUrl ?? "/images/default-avatar.webp")" 
                         alt="Avatar" 
                         class="avatar-card-image rounded-circle" 
                         onerror="this.onerror=null; this.src='/images/default-avatar.webp';"
                         style="width: 100%; height: 100%; object-fit: cover; border: 2px solid var(--bs-primary);" />
                </div>
                <div class="avatar-card-content">
                    @if (!string.IsNullOrEmpty(Character.User.Nickname))
                    {
                        <div class="avatar-card-tuna-name fw-bold">@Character.User.Nickname</div>
                    }
                    @if (!string.IsNullOrEmpty(Character.User.FirstName) || !string.IsNullOrEmpty(Character.User.LastName))
                    {
                        <div class="avatar-card-full-name text-muted small">@Character.User.FirstName @Character.User.LastName</div>
                    }
                </div>
            </div>
        }

        <!-- Rating Gain Badge (if in arena context) -->
        @if (RatingGain >= 0 && ArenaRating > 0)
        {
            var ratingColor = RatingGain == 0 ? "gray" : RatingGain >= 15 ? "gold" : "green";
            <div class="text-center mb-2">
                <FantasyTile Icon="bi-trophy-fill"
                             Label="Vitória"
                             Value="@($"+{RatingGain}")"
                             Color="@ratingColor"
                             Size="sm"
                             Tooltip="Rating que ganhas se venceres" />
            </div>
        }
        
        <!-- HP Bar -->
        @{
            var currentHP = Character?.CurrentHP ?? Character?.TotalHP ?? 100;
            long maxHP;
            if (Character != null && Character.ShotBuffBattlesRemaining > 0)
            {
                var buffedCopy = Character.CreateShotBuffedCopy(Character);
                maxHP = buffedCopy.TotalHP;
            }
            else
            {
                maxHP = Character?.TotalHP ?? 100;
            }
            var hpProgress = maxHP > 0 ? Math.Min(100, (currentHP * 100.0 / maxHP)) : 0;
        }
        <div class="xp-bar-container mb-3">
            <div class="xp-bar-bg">
                <div class="xp-bar-fill hp-bar-fill" 
                     style="width: @(hpProgress.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%"
                     role="progressbar" 
                     aria-valuenow="@currentHP" 
                     aria-valuemin="0" 
                     aria-valuemax="@maxHP">
                </div>
            </div>
            <div class="xp-bar-text">
                <span class="xp-current">HP: @NumberFormatter.Compact(currentHP)</span>
                <span class="xp-separator">/</span>
                <span class="xp-max">@NumberFormatter.Compact(maxHP)</span>
            </div>
        </div>
        
        <!-- Level and XP Display (conditionally shown) -->
        @if (ShowLevelAndXP)
        {
            var xpToNextLevel = RTUB.Core.Entities.Character.XpForLevel(Character?.Level ?? 1);
            var currentXP = Character?.XP ?? 0;
            var xpProgress = xpToNextLevel > 0 ? Math.Min(100, (currentXP * 100.0 / xpToNextLevel)) : 0;
            
            <div class="level-xp-container mb-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="d-flex align-items-center">
                        <i class="bi bi-star-fill text-warning me-2"></i>
                        <span>Nível</span>
                    </span>
                    <strong class="text-warning">@(Character?.Level ?? 1)</strong>
                </div>
                
                <div class="xp-bar-container">
                    <div class="xp-bar-bg">
                        <div class="xp-bar-fill" 
                             style="width: @(xpProgress.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%"
                             role="progressbar" 
                             aria-valuenow="@currentXP" 
                             aria-valuemin="0" 
                             aria-valuemax="@xpToNextLevel">
                        </div>
                    </div>
                    <div class="xp-bar-text">
                        <span class="xp-current">XP: @NumberFormatter.Compact(currentXP)</span>
                        <span class="xp-separator">/</span>
                        <span class="xp-max">@NumberFormatter.Compact(xpToNextLevel)</span>
                    </div>
                </div>
            </div>
        }
        
        <!-- Character Sprite -->
        <div class="text-center mb-3">
            <img src="@CacheBuster.Bust("/sprites/games/my-tuno/default_tuno.png")" 
                 alt="Enemy Character" 
                 class="character-sprite img-fluid"
                 style="max-height: 150px; max-width: 100%; object-fit: contain;" />
        </div>
        
        <hr />
        
        <!-- Fantasy Stat Tiles -->
        <div class="d-flex flex-wrap gap-1 justify-content-center mb-3">
            <FantasyTile Icon="bi-heart-fill" Label="HP" Value="@($"{NumberFormatter.Compact(currentHP)}/{NumberFormatter.Compact(maxHP)}")" Color="red" Size="sm" />
            <FantasyTile Icon="bi-lightning-fill" Label="Poder" Value="@NumberFormatter.Compact(Character?.TotalPower ?? 0)" Color="green" Size="sm" />
            <FantasyTile Icon="bi-speedometer2" Label="Veloc." Value="@($"{(Character?.ActionTime ?? 5.0):F1}s")" Color="blue" Size="sm" />
            <FantasyTile Icon="bi-bullseye" Label="Crítico" Value="@($"{(Character?.TotalCriticalChance ?? 0) * 100:F1}%")" Color="yellow" Size="sm" />
            <FantasyTile Icon="bi-shield-fill" Label="Defesa" Value="@NumberFormatter.Compact(Character?.TotalDefense ?? 0)" Color="gray" Size="sm" />
        </div>

        <!-- Fight Button -->
        <div class="mt-auto">
            <button class="btn btn-primary w-100" 
                    @onclick="() => OnFight.InvokeAsync(Character)"
                    disabled="@(IsDisabled || Character == null || !Character.IsAlive())">
                @if (IsFighting)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                    <text>A lutar...</text>
                }
                else
                {
                    <i class="bi bi-sword me-2"></i>
                    <text>Lutar</text>
                }
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public Character? Character { get; set; }

    [Parameter]
    public EventCallback<Character> OnFight { get; set; }

    [Parameter]
    public bool IsDisabled { get; set; } = false;

    [Parameter]
    public bool IsFighting { get; set; } = false;

    [Parameter]
    public bool ShowLevelAndXP { get; set; } = false;

    /// <summary>Arena rating of the opponent (0 = don't show rating section)</summary>
    [Parameter]
    public int ArenaRating { get; set; } = 0;

    /// <summary>Rating gain if you win (shown only when ArenaRating > 0)</summary>
    [Parameter]
    public int RatingGain { get; set; } = 0;
}
