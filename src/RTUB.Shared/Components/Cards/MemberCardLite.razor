@namespace RTUB.Shared
@*
    MemberCardLite Component
    Compact card for member status listings
*@

<div class="member-card-lite">
    @if (ActionContent != null)
    {
        @ActionContent
    }
    <div class="member-card-lite-header">
        <img src="@GetAvatarSrc()"
             alt="@AltText"
             class="member-card-lite-avatar"
             width="44"
             height="44"
             loading="lazy"
             onerror="this.onerror=null; this.src='/images/default-avatar.webp';" />
        <div class="member-card-lite-title">
            <div class="member-card-lite-nickname">@Nickname</div>
            @if (!string.IsNullOrWhiteSpace(FullName))
            {
                <div class="member-card-lite-name">@FullName</div>
            }
        </div>
    </div>
    <div class="member-card-lite-body">
        @if (PrimaryRowContent != null)
        {
            <div class="member-card-lite-row">
                @if (!string.IsNullOrWhiteSpace(PrimaryRowLabel))
                {
                    <span class="member-card-lite-label">@PrimaryRowLabel</span>
                }
                <span class="member-card-lite-value @(string.IsNullOrWhiteSpace(PrimaryRowLabel) ? "member-card-lite-value-centered" : "")">@PrimaryRowContent</span>
            </div>
        }
        @if (CategoryContent != null)
        {
            <div class="member-card-lite-row">
                <span class="member-card-lite-value member-card-lite-value-centered">@CategoryContent</span>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(InstrumentText))
        {
            <div class="member-card-lite-row">
                <span class="member-card-lite-label">Instrumento</span>
                <span class="member-card-lite-value">@InstrumentText</span>
            </div>
        }
        @if (StatusContent != null)
        {
            <div class="member-card-lite-row">
                <span class="member-card-lite-label">Estado</span>
                <span class="member-card-lite-value member-card-lite-status">@StatusContent</span>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(ProgressText))
        {
            <div class="member-card-lite-progress text-muted">
                <i class="bi bi-clock-history me-1"></i>@ProgressText
            </div>
        }
        @if (EncouragementContent != null)
        {
            <div class="member-card-lite-encouragement">
                @EncouragementContent
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(LastRehearsalText))
        {
            <div class="member-card-lite-row">
                <span class="member-card-lite-label">Último Ensaio</span>
                <span class="member-card-lite-value">@LastRehearsalText</span>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(LastLoginText))
        {
            <div class="member-card-lite-row">
                <span class="member-card-lite-label">Último Login</span>
                <span class="member-card-lite-value">@LastLoginText</span>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(LastEventText))
        {
            <div class="member-card-lite-row">
                <span class="member-card-lite-label">Última Atuação</span>
                <span class="member-card-lite-value">@LastEventText</span>
            </div>
        }
        @if (BirthdayContent != null)
        {
            <div class="member-card-lite-row">
                <span class="member-card-lite-label">Aniversário</span>
                <span class="member-card-lite-value">@BirthdayContent</span>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(AgeText))
        {
            <div class="member-card-lite-row">
                <span class="member-card-lite-label">Idade</span>
                <span class="member-card-lite-value">@AgeText</span>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(CityText))
        {
            <div class="member-card-lite-row">
                <span class="member-card-lite-label">Cidade</span>
                <span class="member-card-lite-value">@CityText</span>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public string AvatarUrl { get; set; } = "";

    [Parameter]
    public string AltText { get; set; } = "";

    [Parameter]
    public string Nickname { get; set; } = "";

    [Parameter]
    public string FullName { get; set; } = "";

    [Parameter]
    public string InstrumentText { get; set; } = "";

    [Parameter]
    public string LastRehearsalText { get; set; } = "";

    [Parameter]
    public string LastLoginText { get; set; } = "";

    [Parameter]
    public string LastEventText { get; set; } = "";

    [Parameter]
    public string ProgressText { get; set; } = "";

    [Parameter]
    public RenderFragment? StatusContent { get; set; }

    [Parameter]
    public RenderFragment? CategoryContent { get; set; }

    [Parameter]
    public string PrimaryRowLabel { get; set; } = "";

    [Parameter]
    public RenderFragment? PrimaryRowContent { get; set; }

    [Parameter]
    public RenderFragment? BirthdayContent { get; set; }

    [Parameter]
    public string AgeText { get; set; } = "";

    [Parameter]
    public string CityText { get; set; } = "";
    
    [Parameter]
    public RenderFragment? EncouragementContent { get; set; }

    /// <summary>
    /// Optional action content rendered at the top-right corner of the card.
    /// Use with member-card-lite-action-btn class for consistent styling.
    /// </summary>
    [Parameter]
    public RenderFragment? ActionContent { get; set; }

    /// <summary>
    /// Returns the avatar URL with fallback to default if empty or null.
    /// </summary>
    private string GetAvatarSrc()
    {
        return string.IsNullOrWhiteSpace(AvatarUrl) ? "/images/default-avatar.webp" : AvatarUrl;
    }
}
