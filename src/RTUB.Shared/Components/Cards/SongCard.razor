@namespace RTUB.Shared
@using Microsoft.AspNetCore.Components.Authorization
@using RTUB.Core.Entities
@using Microsoft.AspNetCore.Components
@*
    SongCard Component
    Card-based design for displaying song information with actions
    Desktop-first design that scales well on mobile
*@

<div class="card song-card h-100">
    <div class="position-relative">
        @if (CanEdit || CanDelete)
        {
            <div class="song-admin-overlay">
                @if (CanEdit)
                {
                    <button class="btn btn-sm music-btn-edit" @onclick="HandleEdit" title="Editar">
                        <i class="bi bi-pencil music-icon-edit"></i>
                    </button>
                }
                @if (CanDelete)
                {
                    <button class="btn btn-sm music-btn-delete" @onclick="HandleDelete" title="Eliminar">
                        <i class="bi bi-trash music-icon-delete"></i>
                    </button>
                }
            </div>
        }
        <div class="song-header">
            <div class="song-icon-circle">
                <i class="bi bi-music-note-beamed"></i>
            </div>
        </div>
    </div>
    <div class="card-body d-flex flex-column">
        <div class="song-info">
            <h5 class="song-title" title="@GetSongTitleWithTrack()">
                @if (Song.TrackNumber.HasValue)
                {
                    <span class="song-track-number">#@Song.TrackNumber</span>
                }
                <span>@Song.Title</span>
            </h5>
            <div class="song-authors">
                @if (!string.IsNullOrEmpty(Song.LyricAuthor))
                {
                    <div class="song-author-row">
                        <div class="song-author-header">
                            <i class="bi bi-pen song-icon"></i>
                            <span class="song-author-label">Letra:</span>
                        </div>
                        <span class="song-author-text" title="@Song.LyricAuthor">@FormatAuthors(Song.LyricAuthor)</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Song.MusicAuthor))
                {
                    <div class="song-author-row">
                        <div class="song-author-header">
                            <i class="bi bi-music-note song-icon"></i>
                            <span class="song-author-label">Música:</span>
                        </div>
                        <span class="song-author-text" title="@Song.MusicAuthor">@FormatAuthors(Song.MusicAuthor)</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Song.Adaptation))
                {
                    <div class="song-author-row">
                        <div class="song-author-header">
                            <i class="bi bi-arrow-repeat song-icon"></i>
                            <span class="song-author-label">Adaptação:</span>
                        </div>
                        <span class="song-author-text" title="@Song.Adaptation">@FormatAuthors(Song.Adaptation)</span>
                    </div>
                }
                @if (string.IsNullOrEmpty(Song.LyricAuthor) && string.IsNullOrEmpty(Song.MusicAuthor))
                {
                    <div class="song-author-row-inline">
                        <i class="bi bi-person song-icon"></i>
                        <span class="song-author-text text-muted">Autor desconhecido</span>
                    </div>
                }
            </div>
        </div>

        @if (PlayCount > 0)
        {
            <div class="song-play-count mt-2" title="Foi tocado @PlayCount vezes">
                <i class="bi bi-play-circle"></i>
                <span class="ms-1">@PlayCount @(PlayCount == 1 ? "reprodução" : "reproduções")</span>
            </div>
        }

        <div class="song-actions mt-auto">
            <div class="song-primary-actions">
                @if (Song.HasMusic)
                {
                    <button class="btn btn-sm btn-purple song-action-btn" @onclick="HandlePlay" title="Reproduzir">
                        <i class="bi bi-play-circle-fill"></i>
                        <span class="action-label">Play</span>
                    </button>
                }
                else
                {
                    <button class="btn btn-sm btn-purple song-action-btn" disabled title="Áudio não disponível">
                        <i class="bi bi-play-circle-fill"></i>
                        <span class="action-label">Play</span>
                    </button>
                }
                <button class="btn btn-sm btn-purple song-action-btn" @onclick="HandleViewLyric" title="Ver Letra">
                    <i class="bi bi-file-text-fill"></i>
                    <span class="action-label">Letra</span>
                </button>
                @{
                    var hasLinks = !string.IsNullOrEmpty(Song.SpotifyUrl) || (Song.YouTubeUrls?.Any() == true);
                }
                @if (hasLinks)
                {
                    <button class="btn btn-sm btn-purple song-action-btn" @onclick="HandleViewLinks" title="Ver Links (@LinkCount)">
                        <i class="bi bi-link-45deg"></i>
                        <span class="action-label">Links</span>
                        @if (LinkCount > 0)
                        {
                            <span class="song-count-badge">@LinkCount</span>
                        }
                    </button>
                }
                else
                {
                    <button class="btn btn-sm btn-purple song-action-btn" disabled title="Sem links disponíveis">
                        <i class="bi bi-link-45deg"></i>
                        <span class="action-label">Links</span>
                    </button>
                }

                <AuthorizeView>
                    <Authorized>
                        <button class="btn btn-sm btn-purple song-action-btn" @onclick="HandleViewVideos" title="Ver Vídeos (@VideoCount)">
                            <i class="bi bi-camera-video-fill"></i>
                            <span class="action-label">Vídeos</span>
                            @if (VideoCount > 0)
                            {
                                <span class="song-count-badge">@VideoCount</span>
                            }
                        </button>
                     </Authorized>
                </AuthorizeView>
               
            </div>
        </div>
    </div>
</div>

@code {
    /// <summary>
    /// The song to display
    /// </summary>
    [Parameter]
    public Song Song { get; set; } = null!;

    /// <summary>
    /// The number of times the song has been played
    /// </summary>
    [Parameter]
    public int PlayCount { get; set; }

    /// <summary>
    /// The number of links (Spotify + YouTube) for this song
    /// </summary>
    [Parameter]
    public int LinkCount { get; set; }

    /// <summary>
    /// The number of videos for this song
    /// </summary>
    [Parameter]
    public int VideoCount { get; set; }

    /// <summary>
    /// Whether the current user can edit the song
    /// </summary>
    [Parameter]
    public bool CanEdit { get; set; }

    /// <summary>
    /// Whether the current user can delete the song
    /// </summary>
    [Parameter]
    public bool CanDelete { get; set; }

    /// <summary>
    /// Callback when the play button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnPlay { get; set; }

    /// <summary>
    /// Callback when the view lyric button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnViewLyric { get; set; }

    /// <summary>
    /// Callback when the view links button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnViewLinks { get; set; }

    /// <summary>
    /// Callback when the view videos button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnViewVideos { get; set; }

    /// <summary>
    /// Callback when the edit button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnEdit { get; set; }

    /// <summary>
    /// Callback when the delete button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnDelete { get; set; }

    private async Task HandlePlay()
    {
        if (OnPlay.HasDelegate)
        {
            await OnPlay.InvokeAsync();
        }
    }

    private async Task HandleViewLyric()
    {
        if (OnViewLyric.HasDelegate)
        {
            await OnViewLyric.InvokeAsync();
        }
    }

    private async Task HandleViewLinks()
    {
        if (OnViewLinks.HasDelegate)
        {
            await OnViewLinks.InvokeAsync();
        }
    }

    private async Task HandleViewVideos()
    {
        if (OnViewVideos.HasDelegate)
        {
            await OnViewVideos.InvokeAsync();
        }
    }

    private async Task HandleEdit()
    {
        if (OnEdit.HasDelegate)
        {
            await OnEdit.InvokeAsync();
        }
    }

    private async Task HandleDelete()
    {
        if (OnDelete.HasDelegate)
        {
            await OnDelete.InvokeAsync();
        }
    }

    private string GetSongTitleWithTrack()
    {
        if (Song.TrackNumber.HasValue)
        {
            return $"#{Song.TrackNumber} {Song.Title}";
        }
        return Song.Title;
    }

    private MarkupString FormatAuthors(string authors)
    {
        if (string.IsNullOrEmpty(authors))
        {
            return new MarkupString(string.Empty);
        }
        
        // Replace ", " with ",\u00A0" to add non-breaking space after commas
        var formatted = authors.Replace(", ", ",\u00A0");
        return new MarkupString(formatted);
    }
    
    // Track previous state for ShouldRender optimization
    private int _previousSongId;
    private bool _previousHasMusic;
    private bool _previousCanEdit;
    private bool _previousCanDelete;
    private bool _previousHasVideos;
    private int _previousPlayCount;
    private int _previousLinkCount;
    private int _previousVideoCount;
    private string? _previousTitle;
    private int? _previousTrackNumber;
    private string? _previousLyricAuthor;
    private string? _previousMusicAuthor;
    private string? _previousAdaptation;
    
    /// <summary>
    /// Optimize rendering - only re-render when key parameters change.
    /// This is especially important for SongCard as it's used in grids with many songs.
    /// </summary>
    protected override bool ShouldRender()
    {
        var songId = Song?.Id ?? 0;
        var hasMusic = Song?.HasMusic ?? false;
        var hasVideos = Song?.Videos?.Any() == true;
        var title = Song?.Title;
        var trackNumber = Song?.TrackNumber;
        var lyricAuthor = Song?.LyricAuthor;
        var musicAuthor = Song?.MusicAuthor;
        var adaptation = Song?.Adaptation;
        
        if (songId != _previousSongId ||
            hasMusic != _previousHasMusic ||
            CanEdit != _previousCanEdit ||
            CanDelete != _previousCanDelete ||
            hasVideos != _previousHasVideos ||
            PlayCount != _previousPlayCount ||
            LinkCount != _previousLinkCount ||
            VideoCount != _previousVideoCount ||
            title != _previousTitle ||
            trackNumber != _previousTrackNumber ||
            lyricAuthor != _previousLyricAuthor ||
            musicAuthor != _previousMusicAuthor ||
            adaptation != _previousAdaptation)
        {
            _previousSongId = songId;
            _previousHasMusic = hasMusic;
            _previousCanEdit = CanEdit;
            _previousCanDelete = CanDelete;
            _previousHasVideos = hasVideos;
            _previousPlayCount = PlayCount;
            _previousLinkCount = LinkCount;
            _previousVideoCount = VideoCount;
            _previousTitle = title;
            _previousTrackNumber = trackNumber;
            _previousLyricAuthor = lyricAuthor;
            _previousMusicAuthor = musicAuthor;
            _previousAdaptation = adaptation;
            return true;
        }
        return false;
    }
}
