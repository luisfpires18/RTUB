@namespace RTUB.Shared
@using RTUB.Core.Entities

<div class="character-overview-card" tabindex="0">
    @if (ShowDeleteButton)
    {
        <button class="character-overview-card-delete-btn"
                @onclick="@OnDelete"
                @onclick:stopPropagation="true"
                title="Eliminar personagem"
                aria-label="Eliminar personagem">
            <i class="bi bi-trash"></i>
        </button>
    }

    <div class="character-overview-card-avatar">
        @if (Character?.User != null && !string.IsNullOrEmpty(Character.User.ProfilePictureSrc))
        {
            <img src="@CacheBuster.Bust(Character.User.ProfilePictureSrc)"
                 alt="@GetDisplayName()"
                 class="character-overview-card-image"
                 loading="lazy" />
        }
        else
        {
            <div class="character-overview-card-image-placeholder">
                <i class="bi bi-person"></i>
            </div>
        }
    </div>

    <div class="character-overview-card-content">
        <h6 class="character-overview-card-name">@GetDisplayName()</h6>
        <div class="character-overview-card-level">
            <span class="badge bg-primary">Nível @(Character?.Level ?? 1)</span>
            @if (StageInfo.HasValue)
            {
                <span class="badge bg-warning text-dark ms-1">
                    <i class="bi bi-layers me-1"></i>Floor @StageInfo.Value
                </span>
            }
        </div>

        <div class="character-overview-card-stats">
            <div class="stat-row">
                <span class="stat-icon text-danger"><i class="bi bi-heart-fill"></i></span>
                <span class="stat-label">HP</span>
                <span class="stat-value">@NumberFormatter.Compact(Character?.TotalHP ?? 0)</span>
            </div>
            <div class="stat-row">
                <span class="stat-icon text-warning"><i class="bi bi-lightning-fill"></i></span>
                <span class="stat-label">Poder</span>
                <span class="stat-value">@NumberFormatter.Compact(Character?.TotalPower ?? 0)</span>
            </div>
            <div class="stat-row">
                <span class="stat-icon text-info"><i class="bi bi-speedometer2"></i></span>
                <span class="stat-label">Velocidade</span>
                <span class="stat-value">@(Character?.ActionTime.ToString("F1") ?? "5.0")s</span>
            </div>
            <div class="stat-row">
                <span class="stat-icon text-success"><i class="bi bi-shield-fill"></i></span>
                <span class="stat-label">Defesa</span>
                <span class="stat-value">@NumberFormatter.Compact(Character?.TotalDefense ?? 0)</span>
            </div>
            <div class="stat-row">
                <span class="stat-icon text-primary"><i class="bi bi-bullseye"></i></span>
                <span class="stat-label">Crítico</span>
                <span class="stat-value">@((Character?.TotalCriticalChance ?? 0).ToString("P0"))</span>
            </div>
        </div>
    </div>

    <div class="character-overview-card-action">
        @if (ShowLevelButtons)
        {
            <div class="d-flex gap-1 mb-2">
                <button class="btn btn-outline-danger btn-sm flex-fill"
                        @onclick="@OnLevelDown"
                        @onclick:stopPropagation="true"
                        disabled="@(Character == null || Character.Level <= 1)"
                        title="Nível -1">
                    <i class="bi bi-dash-lg"></i> LVL
                </button>
                <button class="btn btn-outline-success btn-sm flex-fill"
                        @onclick="@OnLevelUp"
                        @onclick:stopPropagation="true"
                        disabled="@(Character == null)"
                        title="Nível +1">
                    <i class="bi bi-plus-lg"></i> LVL
                </button>
            </div>
        }
        <button class="btn btn-outline-primary btn-sm w-100"
                @onclick="() => OnViewDetails.InvokeAsync(Character)"
                disabled="@(Character == null)">
            <i class="bi bi-eye me-1"></i>Ver Detalhes
        </button>
    </div>
</div>

@code {
    [Parameter] public Character? Character { get; set; }
    [Parameter] public int? StageInfo { get; set; }
    [Parameter] public EventCallback<Character> OnViewDetails { get; set; }
    [Parameter] public bool ShowDeleteButton { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }
    [Parameter] public bool ShowLevelButtons { get; set; }
    [Parameter] public EventCallback OnLevelUp { get; set; }
    [Parameter] public EventCallback OnLevelDown { get; set; }

    private string GetDisplayName()
    {
        if (Character?.User == null) return "Personagem";
        return !string.IsNullOrEmpty(Character.User.Nickname)
            ? Character.User.Nickname
            : "Personagem";
    }
}
