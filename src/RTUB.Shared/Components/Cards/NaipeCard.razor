@namespace RTUB.Shared
@using RTUB.Application.DTOs
@using RTUB.Core.Enums
@using RTUB.Application.Helpers
@using Microsoft.JSInterop

<div class="naipe-card" data-naipe-id="@Content.Id">
    <!-- Header with media preview or icon -->
    <div class="naipe-header">
        @if (CanEdit || CanDelete)
        {
            <div class="naipe-admin-overlay">
                @if (CanEdit)
                {
                    <button class="btn btn-sm admin-btn-edit" @onclick="OnEdit" @onclick:stopPropagation="true" title="Editar">
                        <i class="bi bi-pencil"></i>
                    </button>
                }
                @if (CanDelete)
                {
                    <button class="btn btn-sm admin-btn-delete" @onclick="OnDelete" @onclick:stopPropagation="true" title="Eliminar">
                        <i class="bi bi-trash"></i>
                    </button>
                }
            </div>
        }
        
        @if (Content.IsVideo)
        {
            <!-- Video preview with muted video -->
            <div class="naipe-media-preview video">
                <video class="naipe-video-preview" muted preload="metadata" @onmouseenter="PlayPreview" @onmouseleave="PausePreview" @ref="videoElement">
                    <source src="@Content.Url" type="@Content.MimeType" />
                </video>
                <span class="naipe-media-badge badge bg-purple">
                    <i class="bi bi-camera-video"></i> Vídeo
                </span>
            </div>
        }
        else
        {
            <!-- Image preview -->
            <div class="naipe-media-preview image">
                <img src="@Content.Url" alt="@Content.Title" class="naipe-image" loading="lazy" />
                <span class="naipe-media-badge badge bg-purple">
                    <i class="bi bi-image"></i> Imagem
                </span>
            </div>
        }
    </div>

    <!-- Card Body -->
    <div class="card-body">
        <!-- Instrument Type Badge -->
        <div class="naipe-instrument-badge mb-2">
            <span class="badge bg-purple">
                <i class="bi bi-music-note"></i> @StatusHelper.GetInstrumentDisplay(Content.InstrumentType)
            </span>
        </div>

        <!-- Title -->
        <h5 class="naipe-title" title="@Content.Title">@GetTitleSnippet()</h5>

        <!-- Description Snippet -->
        @if (!string.IsNullOrWhiteSpace(Content.Description))
        {
            <p class="naipe-description">@GetDescriptionSnippet()</p>
        }

        <!-- Metadata Row -->
        <div class="naipe-metadata">
            <div class="naipe-metadata-item">
                <i class="bi bi-eye text-primary"></i>
                <span>@PlayCount</span>
            </div>
            <div class="naipe-metadata-item">
                <i class="bi bi-chat-dots text-primary"></i>
                <span>@Content.CommentCount</span>
            </div>
        </div>

        @if (IsAdmin)
        {
            <div class="mt-2 text-muted small">
                <div>
                    <i class="bi bi-person me-1"></i>
                    <span class="fw-semibold">Criado por:</span> @FormatField(Content.CreatedByUserName)
                </div>
                <div>
                    <i class="bi bi-person-check me-1"></i>
                    <span class="fw-semibold">Atualizado por:</span> @FormatField(Content.UpdatedByUserName)
                </div>
            </div>
        }
    </div>

    <!-- Actions -->
    <div class="naipe-actions">
        <button class="btn btn-purple btn-sm" @onclick="OnView" title="@(Content.IsVideo ? "Ver Vídeo" : "Ver Imagem")">
            <i class="bi bi-@(Content.IsVideo ? "play-circle" : "eye")"></i>
        </button>
    </div>
</div>

@code {
    [Parameter] public NaipeContentDto Content { get; set; } = null!;
    [Parameter] public int PlayCount { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public bool CanDelete { get; set; }
    [Parameter] public bool IsAdmin { get; set; }
    [Parameter] public EventCallback OnView { get; set; }
    [Parameter] public EventCallback OnEdit { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }
    
    [Inject] private IJSRuntime JSRuntime { get; set; } = null!;
    
    private ElementReference videoElement;
    
    private string GetTitleSnippet()
    {
        if (string.IsNullOrWhiteSpace(Content.Title))
            return string.Empty;

        const int maxLength = 40;
        return Content.Title.Length > maxLength
            ? Content.Title.Substring(0, maxLength) + "..."
            : Content.Title;
    }

    private string GetDescriptionSnippet()
    {
        if (string.IsNullOrWhiteSpace(Content.Description))
            return string.Empty;

        const int maxLength = 80;
        return Content.Description.Length > maxLength
            ? Content.Description.Substring(0, maxLength) + "..."
            : Content.Description;
    }

    private static string FormatField(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "-" : value;
    }
    
    private async Task PlayPreview()
    {
        if (Content.IsVideo)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("eval", $"document.querySelector('[data-naipe-id=\"{Content.Id}\"] video')?.play()");
            }
            catch
            {
                // Ignore errors - preview is optional
            }
        }
    }
    
    private async Task PausePreview()
    {
        if (Content.IsVideo)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("eval", $"document.querySelector('[data-naipe-id=\"{Content.Id}\"] video')?.pause()");
            }
            catch
            {
                // Ignore errors - preview is optional
            }
        }
    }

    protected override bool ShouldRender()
    {
        // Only re-render when content changes
        return true;
    }
}
