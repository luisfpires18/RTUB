@namespace RTUB.Shared

<div class="card game-card h-100">
    <div class="position-relative">
        @if (!string.IsNullOrEmpty(ImageUrl))
        {
            <img src="@ImageUrl" class="card-img-top game-image" alt="@Title" loading="lazy">
        }
        else
        {
            <div class="card-img-top game-image-placeholder">
                <i class="bi bi-controller game-icon-large"></i>
            </div>
        }
        
        @if (ComingSoon)
        {
            <div class="position-absolute top-0 start-0 p-2">
                <span class="badge bg-warning text-dark fs-6">
                    <i class="bi bi-clock-fill me-1"></i>EM BREVE
                </span>
            </div>
        }
        
        @if (MembersOnly)
        {
            <div class="position-absolute top-0 @(ComingSoon ? "start-50" : "start-0") p-2">
                <span class="badge bg-info text-dark fs-6" title="Apenas para membros oficiais">
                    <i class="bi bi-people-fill me-1"></i>MEMBROS
                </span>
            </div>
        }
        
        @if (ShowAdminControls)
        {
            <div class="admin-overlay">
                <button class="btn btn-sm music-btn-edit" @onclick="OnEdit" @onclick:stopPropagation="true" title="Editar">
                    <i class="bi bi-pencil music-icon-edit"></i>
                </button>
            </div>
        }
    </div>
    <div class="card-body d-flex flex-column p-3">
        <h5 class="card-title mb-2">@Title</h5>
        @if (!string.IsNullOrEmpty(Description))
        {
            <p class="card-text text-white-opacity mb-3 flex-grow-1">@Description</p>
        }
        
        <div class="game-buttons-container mt-auto">
            @if (!ComingSoon)
            {
                <button class="btn btn-primary game-btn" @onclick="OnPlay" title="Jogar">
                    <i class="bi bi-play-fill me-1"></i>Jogar
                </button>
            }
            else
            {
                <button class="btn btn-secondary game-btn" disabled>
                    <i class="bi bi-clock me-1"></i>Em Breve
                </button>
            }
            <button class="btn btn-outline-warning game-btn" @onclick="OnShowLeaderboard" title="Classificação">
                <i class="bi bi-trophy-fill me-1"></i>Ranking
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? ImageUrl { get; set; }
    [Parameter] public string GameKey { get; set; } = string.Empty;
    [Parameter] public bool ComingSoon { get; set; }
    [Parameter] public bool MembersOnly { get; set; }
    [Parameter] public bool ShowAdminControls { get; set; }
    [Parameter] public EventCallback OnPlay { get; set; }
    [Parameter] public EventCallback OnShowLeaderboard { get; set; }
    [Parameter] public EventCallback OnEdit { get; set; }
}
