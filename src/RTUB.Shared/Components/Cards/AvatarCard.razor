@namespace RTUB.Shared
@using RTUB.Core.Enums
@using RTUB.Application.Helpers

@*
    AvatarCard Component
    Displays a member card with avatar, name, badges, and action buttons
    Reuses hierarchy card visual without connectors
*@

<div class="avatar-card @(IsExpelled ? "avatar-card-expelled" : "")" tabindex="0" @onkeydown="@HandleKeyDown">
    <!-- Definir Alcunha button in top-left (for Leitões, Admin only) -->
    @if (ShowSetNicknameButton)
    {
        <button class="avatar-card-set-nickname-btn" 
                @onclick="@OnSetNickname" 
                @onclick:stopPropagation="true"
                title="@SetNicknameTooltip"
                aria-label="@SetNicknameTooltip">
            <i class="bi bi-tag"></i>
        </button>
    }
    
    <!-- Edit & Delete buttons in top-right -->
    @if (ShowEditButton)
    {
        <button class="avatar-card-edit-btn" 
                @onclick="@OnEdit" 
                @onclick:stopPropagation="true"
                title="@EditTooltip"
                aria-label="@EditTooltip">
            <i class="bi bi-pencil"></i>
        </button>
    }
    @if (ShowDeleteButton)
    {
        <button class="avatar-card-delete-btn" 
                @onclick="@OnDelete" 
                @onclick:stopPropagation="true"
                title="@DeleteTooltip"
                aria-label="@DeleteTooltip">
            <i class="bi bi-trash"></i>
        </button>
    }

    <!-- Avatar -->
    <div class="avatar-card-image-wrapper">
        @if (LazyLoad && !imageLoaded)
        {
            <div class="avatar-card-skeleton"></div>
        }
        <img src="@AvatarUrl" 
             alt="@AltText" 
             class="avatar-card-image @(imageLoaded ? "" : "d-none")"
             @onload="@HandleImageLoad"
             @onerror="@HandleImageError"
             loading="@(LazyLoad ? "lazy" : "eager")" />
    </div>

    <!-- Member Info -->
    <div class="avatar-card-content">
        <!-- Login Status (above nickname) -->
        <div class="avatar-card-login-status">
            @if (IsUserOnline())
            {
                <i class="bi bi-circle-fill text-success"></i>
                <span>Online</span>
            }
            else
            {
                <i class="bi bi-circle-fill text-danger"></i>
                <span>Offline</span>
            }
        </div>
        
        <!-- Nome de Tuna (primary) -->
        @if (!string.IsNullOrEmpty(TunaName))
        {
            <div class="avatar-card-tuna-name">@TunaName</div>
        }
        
        <!-- Nome (secondary) -->
        @if (!string.IsNullOrEmpty(FullName))
        {
            <div class="avatar-card-full-name">@FullName</div>
        }

        <!-- Badges (Category/Roles) -->
        <div class="avatar-card-badges">
            @BadgeContent
        </div>

        <!-- Instrumento Principal / a aprender -->
        @if (!string.IsNullOrEmpty(InstrumentText))
        {
            <div class="avatar-card-instrument">
                <i class="bi bi-music-note"></i> @InstrumentText
            </div>
        }

        <!-- Inactivity warning (between instrument and action buttons) -->
        @if (ShowInactivityWarning)
        {
            <div class="avatar-card-inactivity-indicator" 
                 title="@InactivityWarningTooltip"
                 aria-label="@InactivityWarningTooltip">
                <i class="bi bi-clock-history"></i>
                <span>Não tem participado</span>
            </div>
        }
    </div>

    <!-- View button and expulsion button below the card -->
    <div class="avatar-card-actions">
        <button class="btn btn-sm btn-purple" 
                @onclick="@OnView"
                title="@ViewTooltip"
                aria-label="@ViewTooltip">
            <i class="bi bi-eye"></i> @ViewButtonText
        </button>
        
        @if (ShowExpelButton)
        {
            @if (IsExpelled)
            {
                <button class="btn btn-sm btn-success" 
                        @onclick="@OnReactivate"
                        @onclick:stopPropagation="true"
                        title="Reativar membro"
                        aria-label="Reativar membro">
                    <i class="bi bi-person-check"></i>
                </button>
            }
            else
            {
                <button class="btn btn-sm btn-danger" 
                        @onclick="@OnExpel"
                        @onclick:stopPropagation="true"
                        title="Expulsar membro"
                        aria-label="Expulsar membro">
                    <i class="bi bi-person-x"></i>
                </button>
            }
        }
    </div>
</div>

@code {
    private const int ONLINE_THRESHOLD_HOURS = 1;

    [Parameter]
    public string AvatarUrl { get; set; } = "";

    [Parameter]
    public string TunaName { get; set; } = "";

    [Parameter]
    public string FullName { get; set; } = "";

    [Parameter]
    public string InstrumentText { get; set; } = "";

    [Parameter]
    public string AltText { get; set; } = "";

    [Parameter]
    public DateTime? LastLoginDate { get; set; }

    [Parameter]
    public RenderFragment? BadgeContent { get; set; }

    [Parameter]
    public EventCallback OnView { get; set; }

    [Parameter]
    public EventCallback OnEdit { get; set; }

    [Parameter]
    public EventCallback OnDelete { get; set; }
    
    [Parameter]
    public EventCallback OnSetNickname { get; set; }

    [Parameter]
    public bool ShowEditButton { get; set; } = false;

    [Parameter]
    public bool ShowDeleteButton { get; set; } = false;
    
    [Parameter]
    public bool ShowSetNicknameButton { get; set; } = false;
    
    [Parameter]
    public bool ShowInactivityWarning { get; set; } = false;

    [Parameter]
    public string InactivityWarningTooltip { get; set; } = "Não tem participado";

    [Parameter]
    public bool LazyLoad { get; set; } = true;

    [Parameter]
    public string ViewTooltip { get; set; } = "Ver Detalhes";

    [Parameter]
    public string ViewButtonText { get; set; } = "Ver Detalhes";

    [Parameter]
    public string EditTooltip { get; set; } = "Editar";

    [Parameter]
    public string DeleteTooltip { get; set; } = "Eliminar";
    
    [Parameter]
    public string SetNicknameTooltip { get; set; } = "Definir Alcunha";

    [Parameter]
    public bool ShowExpelButton { get; set; } = false;

    [Parameter]
    public bool IsExpelled { get; set; } = false;

    [Parameter]
    public EventCallback OnExpel { get; set; }

    [Parameter]
    public EventCallback OnReactivate { get; set; }

    private bool imageLoaded = false;
    
    // Track previous state for ShouldRender optimization
    private string? _previousAvatarUrl;
    private string? _previousTunaName;
    private string? _previousFullName;
    private string? _previousInstrumentText;
    private DateTime? _previousLastLoginDate;
    private bool _previousShowEditButton;
    private bool _previousShowDeleteButton;
    private bool _previousShowSetNicknameButton;
    private bool _previousShowInactivityWarning;
    private bool _previousShowExpelButton;
    private bool _previousIsExpelled;
    private bool _previousImageLoaded;
    
    /// <summary>
    /// Optimize rendering - only re-render when key parameters change.
    /// This is especially important for AvatarCard as it's used in grids with many instances.
    /// </summary>
    protected override bool ShouldRender()
    {
        if (AvatarUrl != _previousAvatarUrl ||
            TunaName != _previousTunaName ||
            FullName != _previousFullName ||
            InstrumentText != _previousInstrumentText ||
            LastLoginDate != _previousLastLoginDate ||
            ShowEditButton != _previousShowEditButton ||
            ShowDeleteButton != _previousShowDeleteButton ||
            ShowSetNicknameButton != _previousShowSetNicknameButton ||
            ShowInactivityWarning != _previousShowInactivityWarning ||
            ShowExpelButton != _previousShowExpelButton ||
            IsExpelled != _previousIsExpelled ||
            imageLoaded != _previousImageLoaded)
        {
            _previousAvatarUrl = AvatarUrl;
            _previousTunaName = TunaName;
            _previousFullName = FullName;
            _previousInstrumentText = InstrumentText;
            _previousLastLoginDate = LastLoginDate;
            _previousShowEditButton = ShowEditButton;
            _previousShowDeleteButton = ShowDeleteButton;
            _previousShowSetNicknameButton = ShowSetNicknameButton;
            _previousShowInactivityWarning = ShowInactivityWarning;
            _previousShowExpelButton = ShowExpelButton;
            _previousIsExpelled = IsExpelled;
            _previousImageLoaded = imageLoaded;
            return true;
        }
        return false;
    }

    private void HandleImageLoad()
    {
        imageLoaded = true;
        StateHasChanged();
    }

    private void HandleImageError()
    {
        imageLoaded = true;
        StateHasChanged();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await OnView.InvokeAsync();
        }
    }

    /// <summary>
    /// Determines if the user is online based on LastLoginDate.
    /// Reuses the same logic from LoginStatusBadge component.
    /// </summary>
    private bool IsUserOnline()
    {
        if (LastLoginDate == null)
            return false;
        
        var timeAgo = DateTime.UtcNow - LastLoginDate.Value;
        return timeAgo.TotalHours < ONLINE_THRESHOLD_HOURS;
    }
}
