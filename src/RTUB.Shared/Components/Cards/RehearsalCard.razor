@namespace RTUB.Shared
@using RTUB.Application.Extensions
@*
    RehearsalCard: date first, then time and place, then the member's own answer
    (docs/design/RTUB_UI_REFACTOR.md section 25). Management actions live in the CardMenu.
    IsNext marks the next rehearsal so it stands out from the rest of the list.
*@

<article class="@CardClass" aria-labelledby="@TitleId">
    <div class="rehearsal-item__head">
        <DateTile Date="@Rehearsal.Date" ShowYear="@IsPastRehearsal" Muted="@(IsPastRehearsal || Rehearsal.IsCanceled)" />
        <div class="rehearsal-item__heading">
            @if (Rehearsal.IsCanceled)
            {
                <p class="item-status item-status--danger"><i class="bi bi-x-octagon-fill" aria-hidden="true"></i>Cancelado</p>
            }
            else if (IsNext)
            {
                <p class="item-status item-status--accent"><i class="bi bi-arrow-right-circle-fill" aria-hidden="true"></i>Próximo ensaio</p>
            }
            else if (IsPastRehearsal && UserAttendance != null)
            {
                @if (!UserAttendance.WillAttend)
                {
                    <p class="item-status"><i class="bi bi-x-circle" aria-hidden="true"></i>Não fui</p>
                }
                else if (UserAttendance.Attended)
                {
                    <p class="item-status item-status--success"><i class="bi bi-check-circle-fill" aria-hidden="true"></i>Fui</p>
                }
                else
                {
                    <p class="item-status item-status--warning"><i class="bi bi-clock-fill" aria-hidden="true"></i>Presença pendente</p>
                }
            }
            <h3 class="item-card__title" id="@TitleId">
                @GetDayOfWeek(Rehearsal.Date)<span class="visually-hidden">, @Rehearsal.Date.ToString("dd MMM yyyy")</span>
            </h3>
            <p class="item-card__meta item-card__meta--strong">
                <i class="bi bi-clock" aria-hidden="true"></i>
                <span>
                    @Rehearsal.StartTime.ToString(@"hh\:mm") - @Rehearsal.EndTime.ToString(@"hh\:mm")
                    @if (!Rehearsal.IsCanceled)
                    {
                        <DateBadge Date="@Rehearsal.Date" />
                    }
                </span>
            </p>
            @if (!string.IsNullOrEmpty(Rehearsal.Location))
            {
                <p class="item-card__meta">
                    <i class="bi bi-geo-alt" aria-hidden="true"></i>
                    <span>@Rehearsal.Location</span>
                </p>
            }
        </div>
        @if (IsAdmin)
        {
            <CardMenu Label="@($"ensaio de {Rehearsal.Date:dd MMM yyyy}")">
                <CardMenuItem Label="Editar ensaio" Icon="bi-pencil" OnClick="HandleEdit" />
                @if (!Rehearsal.IsCanceled && !IsPastRehearsal)
                {
                    <CardMenuItem Label="Notificar por push" Icon="bi-bell" OnClick="HandleSendPushNotification" />
                }
                @if (Rehearsal.IsCanceled && !IsPastRehearsal)
                {
                    <CardMenuItem Label="Reativar ensaio" Icon="bi-arrow-counterclockwise" OnClick="HandleUncancel" />
                }
                @if (!Rehearsal.IsCanceled && ShowCancelButton)
                {
                    <CardMenuItem Label="Cancelar ensaio" Icon="bi-x-octagon" Danger="true" Divider="true" OnClick="HandleCancel" />
                }
                @if (ShowDeleteButton)
                {
                    <CardMenuItem Label="Eliminar ensaio" Icon="bi-trash" Danger="true"
                                  Divider="@(Rehearsal.IsCanceled || !ShowCancelButton)" OnClick="HandleDelete" />
                }
            </CardMenu>
        }
    </div>

    @if (!string.IsNullOrEmpty(Rehearsal.Theme) || !string.IsNullOrEmpty(Rehearsal.Description))
    {
        <dl class="rehearsal-item__notes">
            @if (!string.IsNullOrEmpty(Rehearsal.Theme))
            {
                <div><dt>Tema</dt><dd>@Rehearsal.Theme</dd></div>
            }
            @if (!string.IsNullOrEmpty(Rehearsal.Description))
            {
                <div><dt>Descrição</dt><dd>@Rehearsal.Description</dd></div>
            }
        </dl>
    }

    <div class="item-card__footer">
        <div class="item-card__links">
            <button type="button" class="item-chip item-chip--link" @onclick="HandleViewDetails" title="Ver Detalhes">
                <i class="bi bi-info-circle" aria-hidden="true"></i><span>Detalhes</span>
            </button>
            @if (!Rehearsal.IsCanceled || IsAdmin)
            {
                @if (!Rehearsal.IsCanceled && IsAdmin && IsPastRehearsal && HasPendingApprovals)
                {
                    <button type="button" class="item-chip item-chip--warning" @onclick="HandleViewAttendances"
                            title="Ver Presenças - Tem presenças pendentes para aprovar"
                            aria-label="@($"Ver presenças pendentes para aprovar ({AttendanceCount})")">
                        <i class="bi bi-clock-fill" aria-hidden="true"></i><span>@AttendanceCount</span>
                    </button>
                }
                else
                {
                    <button type="button" class="item-chip" @onclick="HandleViewAttendances" title="Ver Presenças"
                            aria-label="@($"Ver presenças ({AttendanceCount})")">
                        <i class="bi bi-people" aria-hidden="true"></i><span>@AttendanceCount</span>
                    </button>
                }
            }
            @if (!Rehearsal.IsCanceled && IsPastRehearsal && UserAttendance is { WillAttend: true, Attended: false })
            {
                <button type="button" class="item-chip item-chip--danger rehearsal-item__remove" @onclick="OnRemoveAttendance"
                        title="Remover presença pendente">
                    <i class="bi bi-trash" aria-hidden="true"></i><span>Remover</span>
                </button>
            }
        </div>

        @if (!Rehearsal.IsCanceled && !IsPastRehearsal)
        {
            var going = UserAttendance?.WillAttend == true;
            var notGoing = UserAttendance != null && !UserAttendance.WillAttend;
            var pending = going && !UserAttendance!.Attended;
            <div class="participation@(UserAttendance != null ? " participation--answered" : null)"
                 role="group" aria-label="@($"A tua presença: {GetDayOfWeek(Rehearsal.Date)}, {Rehearsal.Date:dd MMM yyyy}")">
                <button type="button"
                        class="participation__option participation__option--yes@(pending ? " participation__option--pending" : null)"
                        aria-pressed="@(going ? "true" : "false")"
                        title="@(UserAttendance == null ? "Marcar presença" : notGoing ? "Mudar para vou" : pending ? "Editar presença pendente" : "Editar presença aprovada")"
                        @onclick="@(going ? OnEditAttendance : OnAttendPending)">
                    <i class="bi @(pending ? "bi-clock-fill" : going ? "bi-check-circle-fill" : "bi-check-lg")" aria-hidden="true"></i>
                    <span>Vou</span>
                    @if (pending)
                    {
                        <span class="participation__note">pendente</span>
                    }
                </button>
                <button type="button" class="participation__option participation__option--no"
                        aria-pressed="@(notGoing ? "true" : "false")"
                        title="@(notGoing ? "Editar impossibilidade" : going ? "Mudar para não vou" : "Não vou participar")"
                        @onclick="@(notGoing ? OnEditAttendance : OnAttendNotGoing)">
                    <i class="bi @(notGoing ? "bi-x-circle-fill" : "bi-x-lg")" aria-hidden="true"></i>
                    <span>Não vou</span>
                </button>
            </div>
        }
    </div>
</article>

@code {
    /// <summary>
    /// The rehearsal to display
    /// </summary>
    [Parameter]
    public Rehearsal Rehearsal { get; set; } = null!;

    /// <summary>
    /// The current user's attendance for this rehearsal (if any)
    /// </summary>
    [Parameter]
    public RehearsalAttendance? UserAttendance { get; set; }

    /// <summary>
    /// Total number of attendances for this rehearsal
    /// </summary>
    [Parameter]
    public int AttendanceCount { get; set; }

    /// <summary>
    /// Whether the current user has admin privileges
    /// </summary>
    [Parameter]
    public bool IsAdmin { get; set; }

    /// <summary>
    /// Whether this is a past rehearsal (changes display behavior)
    /// </summary>
    [Parameter]
    public bool IsPastRehearsal { get; set; }

    /// <summary>
    /// Callback when the edit button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnEdit { get; set; }

    /// <summary>
    /// Callback when the delete button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnDelete { get; set; }

    /// <summary>
    /// Callback when the mark attendance button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnMarkAttendance { get; set; }

    /// <summary>
    /// Callback when the "pending" (going) attendance button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnAttendPending { get; set; }

    /// <summary>
    /// Callback when the "not going" attendance button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnAttendNotGoing { get; set; }

    /// <summary>
    /// Callback when the view attendances button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnViewAttendances { get; set; }

    /// <summary>
    /// Callback when the edit attendance button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnEditAttendance { get; set; }

    /// <summary>
    /// Callback when the remove attendance button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnRemoveAttendance { get; set; }

    /// <summary>
    /// Callback when the view details button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnViewDetails { get; set; }
    
    /// <summary>
    /// Callback when the send push notification button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnSendPushNotification { get; set; }
    
    /// <summary>
    /// Callback when the cancel button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnCancel { get; set; }
    
    /// <summary>
    /// Callback when the uncancel button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnUncancel { get; set; }
    
    /// <summary>
    /// Whether to show the delete button (default: true)
    /// Can be set to false for users with restricted permissions (e.g., Caloiro Admins)
    /// </summary>
    [Parameter]
    public bool ShowDeleteButton { get; set; } = true;
    
    /// <summary>
    /// Whether to show the cancel button (default: true)
    /// Can be set to false for users with restricted permissions (e.g., Caloiro Admins)
    /// </summary>
    [Parameter]
    public bool ShowCancelButton { get; set; } = true;
    
    /// <summary>
    /// Whether this past rehearsal has pending attendances that need approval (Admin only)
    /// </summary>
    [Parameter]
    public bool HasPendingApprovals { get; set; } = false;

    /// <summary>
    /// Marks the next upcoming rehearsal so it stands out in the list (presentation only)
    /// </summary>
    [Parameter]
    public bool IsNext { get; set; }

    private string CardClass => "item-card rehearsal-item"
        + (Rehearsal.IsCanceled ? " rehearsal-item--cancelled" : "")
        + (IsPastRehearsal ? " rehearsal-item--past" : "")
        + (IsNext && !Rehearsal.IsCanceled ? " rehearsal-item--next" : "");

    private string TitleId => $"rehearsal-item-title-{Rehearsal.Id}";

    // Handler methods to ensure events fire properly
    private async Task HandleViewAttendances()
    {
        if (OnViewAttendances.HasDelegate)
        {
            await OnViewAttendances.InvokeAsync();
        }
    }

    private async Task HandleViewDetails()
    {
        if (OnViewDetails.HasDelegate)
        {
            await OnViewDetails.InvokeAsync();
        }
    }

    private async Task HandleMarkAttendance()
    {
        if (OnMarkAttendance.HasDelegate)
        {
            await OnMarkAttendance.InvokeAsync();
        }
    }

    private async Task HandleEditAttendance()
    {
        if (OnEditAttendance.HasDelegate)
        {
            await OnEditAttendance.InvokeAsync();
        }
    }

    private async Task HandleRemoveAttendance()
    {
        if (OnRemoveAttendance.HasDelegate)
        {
            await OnRemoveAttendance.InvokeAsync();
        }
    }

    private async Task HandleEdit()
    {
        if (OnEdit.HasDelegate)
        {
            await OnEdit.InvokeAsync();
        }
    }

    private async Task HandleDelete()
    {
        if (OnDelete.HasDelegate)
        {
            await OnDelete.InvokeAsync();
        }
    }
    
    private async Task HandleSendPushNotification()
    {
        if (OnSendPushNotification.HasDelegate)
        {
            await OnSendPushNotification.InvokeAsync();
        }
    }
    
    private async Task HandleCancel()
    {
        if (OnCancel.HasDelegate)
        {
            await OnCancel.InvokeAsync();
        }
    }
    
    private async Task HandleUncancel()
    {
        if (OnUncancel.HasDelegate)
        {
            await OnUncancel.InvokeAsync();
        }
    }

    // Helper method to get day of week in Portuguese
    private string GetDayOfWeek(DateTime date) => date.ToPortugueseWeekdayName();
    
    // Track previous state for ShouldRender optimization
    private int _previousRehearsalId;
    private bool _previousIsCanceled;
    private int _previousAttendanceCount;
    private bool _previousHasAttendance;
    private bool _previousWillAttend;
    private bool _previousAttended;
    private bool _previousIsAdmin;
    private bool _previousIsPastRehearsal;
    private bool _previousHasPendingApprovals;
    private bool _previousIsNext;
    private string? _previousLocation;
    private string? _previousTheme;
    private string? _previousDescription;
    private string? _previousNotes;
    
    /// <summary>
    /// Optimize rendering - only re-render when key parameters change.
    /// This is especially important for RehearsalCard as it's used in lists.
    /// </summary>
    protected override bool ShouldRender()
    {
        var rehearsalId = Rehearsal?.Id ?? 0;
        var isCanceled = Rehearsal?.IsCanceled ?? false;
        var hasAttendance = UserAttendance != null;
        var willAttend = UserAttendance?.WillAttend ?? false;
        var attended = UserAttendance?.Attended ?? false;
        var location = Rehearsal?.Location;
        var theme = Rehearsal?.Theme;
        var description = Rehearsal?.Description;
        var notes = Rehearsal?.Notes;
        
        if (rehearsalId != _previousRehearsalId ||
            isCanceled != _previousIsCanceled ||
            AttendanceCount != _previousAttendanceCount ||
            hasAttendance != _previousHasAttendance ||
            willAttend != _previousWillAttend ||
            attended != _previousAttended ||
            IsAdmin != _previousIsAdmin ||
            IsPastRehearsal != _previousIsPastRehearsal ||
            HasPendingApprovals != _previousHasPendingApprovals ||
            IsNext != _previousIsNext ||
            location != _previousLocation ||
            theme != _previousTheme ||
            description != _previousDescription ||
            notes != _previousNotes)
        {
            _previousRehearsalId = rehearsalId;
            _previousIsCanceled = isCanceled;
            _previousAttendanceCount = AttendanceCount;
            _previousHasAttendance = hasAttendance;
            _previousWillAttend = willAttend;
            _previousAttended = attended;
            _previousIsAdmin = IsAdmin;
            _previousIsPastRehearsal = IsPastRehearsal;
            _previousHasPendingApprovals = HasPendingApprovals;
            _previousIsNext = IsNext;
            _previousLocation = location;
            _previousTheme = theme;
            _previousDescription = description;
            _previousNotes = notes;
            return true;
        }
        return false;
    }
}
