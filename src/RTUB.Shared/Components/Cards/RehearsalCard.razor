@namespace RTUB.Shared
@using RTUB.Application.Extensions
@*
    RehearsalCard Component
    Compact card for displaying rehearsal information with attendance actions
*@

<div class="card rehearsal-card h-100@(Rehearsal.IsCanceled ? " rehearsal-card--cancelled" : string.Empty)">
    <div class="position-relative rehearsal-card__top">
        @if (IsAdmin)
        {
            <div class="rehearsal-card__header-actions">
                <div class="rehearsal-card__header-left">
                    @if (!IsPastRehearsal)
                    {
                        @if (Rehearsal.IsCanceled)
                        {
                            <button class="btn btn-sm btn-warning music-btn-uncancel rehearsal-card__header-button"
                                    @onclick="HandleUncancel"
                                    title="Reativar ensaio">
                                <i class="bi bi-arrow-counterclockwise"></i>
                            </button>
                        }
                        else
                        {
                            @if (ShowCancelButton)
                            {
                                <button class="btn btn-sm btn-danger music-btn-cancel rehearsal-card__header-button"
                                        @onclick="HandleCancel"
                                        title="Cancelar ensaio">
                                    <i class="bi bi-x-circle-fill"></i>
                                </button>
                            }
                            <button class="btn btn-sm btn-admin-notification rehearsal-card__header-button"
                                    @onclick="HandleSendPushNotification"
                                    title="Notificar por push">
                                <i class="bi bi-bell-fill"></i>
                            </button>
                        }
                    }
                </div>
                <div class="rehearsal-admin-overlay">
                    <button class="btn btn-sm music-btn-edit rehearsal-card__header-button" @onclick="HandleEdit" title="Editar">
                        <i class="bi bi-pencil music-icon-edit"></i>
                    </button>
                    @if (ShowDeleteButton)
                    {
                        <button class="btn btn-sm music-btn-delete rehearsal-card__header-button" @onclick="HandleDelete" title="Eliminar">
                            <i class="bi bi-trash music-icon-delete"></i>
                        </button>
                    }
                </div>
            </div>
        }
        <div class="rehearsal-icon-header">
            <div class="rehearsal-icon-circle">
                <i class="bi bi-music-note-beamed"></i>
            </div>
        </div>
    </div>
    <div class="card-body d-flex flex-column">
        
        <div class="rehearsal-info">
         
            <!-- Date, Time and Day in one row -->
            <div class="rehearsal-info-row">
                <i class="bi bi-calendar3 rehearsal-icon"></i>
                <span class="rehearsal-text">@Rehearsal.Date.ToString("dd MMM yyyy")</span>
                <span class="rehearsal-day">(@GetDayOfWeek(Rehearsal.Date))</span>
            </div>
            
            <div class="rehearsal-info-row">
                <i class="bi bi-clock rehearsal-icon"></i>
                <span class="rehearsal-text">@Rehearsal.StartTime.ToString(@"hh\:mm") - @Rehearsal.EndTime.ToString(@"hh\:mm")</span>
                @if (Rehearsal.IsCanceled)
                {
                    <span class="badge bg-danger fs-6 rehearsal-cancel-badge d-inline-flex align-items-center gap-1">
                        <i class="bi bi-x-circle-fill"></i>
                        CANCELADO
                    </span>
                }
                else
                {
                    <DateBadge Date="@Rehearsal.Date" />
                }
            </div>
            
            @if (!string.IsNullOrEmpty(Rehearsal.Location))
            {
                <div class="rehearsal-info-row">
                    <i class="bi bi-geo-alt rehearsal-icon"></i>
                    <span class="rehearsal-text">@Rehearsal.Location</span>
                </div>
            }
            
            @if (!string.IsNullOrEmpty(Rehearsal.Theme))
            {
                <div class="rehearsal-theme-row">
                    <span class="rehearsal-theme-label">Tema:</span>
                    <span class="rehearsal-theme-text">@Rehearsal.Theme</span>
                </div>
            }
        </div>

        @if (!Rehearsal.IsCanceled)
        {
            <div class="rehearsal-actions-section mt-auto p-2 rounded">
                <!-- First row: View Details and View Attendances buttons -->
                <div class="d-flex gap-2 align-items-center justify-content-center mb-2">
                    <!-- View Details button -->
                    <button class="btn btn-sm btn-outline-primary d-flex align-items-center gap-1" 
                            @onclick="HandleViewDetails" 
                            title="Ver Detalhes">
                        <i class="bi bi-eye-fill icon-size-1rem"></i>
                        <span>Ver</span>
                    </button>

                    <!-- View Attendances button -->
                    <button class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1" 
                            @onclick="HandleViewAttendances" 
                            title="Ver Presenças">
                        <i class="bi bi-people icon-size-1rem"></i>
                        <span>@AttendanceCount</span>
                    </button>
                </div>

                @if (!IsPastRehearsal)
                {
                    <!-- Second row: User attendance action buttons (toggle-style like EventCard) -->
                    <div class="d-flex gap-2 align-items-center justify-content-center">
                        @if (UserAttendance == null)
                        {
                            <!-- Add attendance button (green +) - create attendance -->
                            <button class="btn rehearsal-icon-btn btn-add-attendance" 
                                    @onclick="OnAttendPending" 
                                    title="Marcar Presença">
                                <i class="bi bi-plus-circle-fill"></i>
                            </button>
                            
                            <!-- Not Going button (red, smaller) - mark as not going -->
                            <button class="btn rehearsal-icon-btn btn-not-attending btn-secondary-small" 
                                    @onclick="OnAttendNotGoing" 
                                    title="Não vou participar">
                                <i class="bi bi-x-circle-fill"></i>
                            </button>
                        }
                        else if (UserAttendance.WillAttend)
                        {
                            @if (UserAttendance.Attended)
                            {
                                <!-- Approved attendance (green, selected) -->
                                <button class="btn rehearsal-icon-btn btn-approved btn-selected" 
                                        @onclick="OnEditAttendance" 
                                        title="Presença Aprovada - Editar">
                                    <i class="bi bi-check-circle-fill"></i>
                                </button>
                            }
                            else
                            {
                                <!-- Pending attendance (yellow, selected) -->
                                <button class="btn rehearsal-icon-btn btn-pending btn-selected" 
                                        @onclick="OnEditAttendance" 
                                        title="Presença Pendente - Editar">
                                    <i class="bi bi-clock-fill"></i>
                                </button>
                            }
                            
                            <!-- Not Going button (red, smaller) - change to not going -->
                            <button class="btn rehearsal-icon-btn btn-not-attending btn-secondary-small" 
                                    @onclick="OnAttendNotGoing" 
                                    title="Não vou participar">
                                <i class="bi bi-x-circle-fill"></i>
                            </button>
                        }
                        else
                        {
                            <!-- Add attendance button (green +, smaller) - change to going -->
                            <button class="btn rehearsal-icon-btn btn-add-attendance btn-secondary-small" 
                                    @onclick="OnAttendPending" 
                                    title="Marcar Presença">
                                <i class="bi bi-plus-circle-fill"></i>
                            </button>
                            
                            <!-- Not attending status (red, selected) -->
                            <button class="btn rehearsal-icon-btn btn-not-attending btn-selected" 
                                    @onclick="OnEditAttendance" 
                                    title="Não Vou - Editar">
                                <i class="bi bi-x-circle-fill"></i>
                            </button>
                        }
                    </div>
                    
                }
                else
                {
                    <!-- Past rehearsal: Only show delete button if attendance is pending -->
                    @if (UserAttendance != null && UserAttendance.WillAttend && !UserAttendance.Attended)
                    {
                        <div class="d-flex gap-2 align-items-center justify-content-center">
                            <!-- Delete attendance button -->
                            <button class="btn rehearsal-icon-btn btn-danger" 
                                    @onclick="OnRemoveAttendance" 
                                    title="Remover Presença Pendente">
                                <i class="bi bi-trash-fill"></i>
                            </button>
                        </div>
                    }
                }
            </div>
        }
        else
        {
            <!-- For cancelled rehearsals, only show View Details button -->
            <div class="rehearsal-actions-section mt-auto p-2 rounded">
                <div class="d-flex gap-2 align-items-center justify-content-center">
                    <!-- View Details button -->
                    <button class="btn btn-sm btn-outline-primary d-flex align-items-center gap-1" 
                            @onclick="HandleViewDetails" 
                            title="Ver Detalhes">
                        <i class="bi bi-eye-fill icon-size-1rem"></i>
                        <span>Ver</span>
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@code {
    /// <summary>
    /// The rehearsal to display
    /// </summary>
    [Parameter]
    public Rehearsal Rehearsal { get; set; } = null!;

    /// <summary>
    /// The current user's attendance for this rehearsal (if any)
    /// </summary>
    [Parameter]
    public RehearsalAttendance? UserAttendance { get; set; }

    /// <summary>
    /// Total number of attendances for this rehearsal
    /// </summary>
    [Parameter]
    public int AttendanceCount { get; set; }

    /// <summary>
    /// Whether the current user has admin privileges
    /// </summary>
    [Parameter]
    public bool IsAdmin { get; set; }

    /// <summary>
    /// Whether this is a past rehearsal (changes display behavior)
    /// </summary>
    [Parameter]
    public bool IsPastRehearsal { get; set; }

    /// <summary>
    /// Callback when the edit button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnEdit { get; set; }

    /// <summary>
    /// Callback when the delete button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnDelete { get; set; }

    /// <summary>
    /// Callback when the mark attendance button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnMarkAttendance { get; set; }

    /// <summary>
    /// Callback when the "pending" (going) attendance button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnAttendPending { get; set; }

    /// <summary>
    /// Callback when the "not going" attendance button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnAttendNotGoing { get; set; }

    /// <summary>
    /// Callback when the view attendances button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnViewAttendances { get; set; }

    /// <summary>
    /// Callback when the edit attendance button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnEditAttendance { get; set; }

    /// <summary>
    /// Callback when the remove attendance button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnRemoveAttendance { get; set; }

    /// <summary>
    /// Callback when the view details button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnViewDetails { get; set; }
    
    /// <summary>
    /// Callback when the send push notification button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnSendPushNotification { get; set; }
    
    /// <summary>
    /// Callback when the cancel button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnCancel { get; set; }
    
    /// <summary>
    /// Callback when the uncancel button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnUncancel { get; set; }
    
    /// <summary>
    /// Whether to show the delete button (default: true)
    /// Can be set to false for users with restricted permissions (e.g., Caloiro Admins)
    /// </summary>
    [Parameter]
    public bool ShowDeleteButton { get; set; } = true;
    
    /// <summary>
    /// Whether to show the cancel button (default: true)
    /// Can be set to false for users with restricted permissions (e.g., Caloiro Admins)
    /// </summary>
    [Parameter]
    public bool ShowCancelButton { get; set; } = true;

    // Handler methods to ensure events fire properly
    private async Task HandleViewAttendances()
    {
        if (OnViewAttendances.HasDelegate)
        {
            await OnViewAttendances.InvokeAsync();
        }
    }

    private async Task HandleViewDetails()
    {
        if (OnViewDetails.HasDelegate)
        {
            await OnViewDetails.InvokeAsync();
        }
    }

    private async Task HandleMarkAttendance()
    {
        if (OnMarkAttendance.HasDelegate)
        {
            await OnMarkAttendance.InvokeAsync();
        }
    }

    private async Task HandleEditAttendance()
    {
        if (OnEditAttendance.HasDelegate)
        {
            await OnEditAttendance.InvokeAsync();
        }
    }

    private async Task HandleRemoveAttendance()
    {
        if (OnRemoveAttendance.HasDelegate)
        {
            await OnRemoveAttendance.InvokeAsync();
        }
    }

    private async Task HandleEdit()
    {
        if (OnEdit.HasDelegate)
        {
            await OnEdit.InvokeAsync();
        }
    }

    private async Task HandleDelete()
    {
        if (OnDelete.HasDelegate)
        {
            await OnDelete.InvokeAsync();
        }
    }
    
    private async Task HandleSendPushNotification()
    {
        if (OnSendPushNotification.HasDelegate)
        {
            await OnSendPushNotification.InvokeAsync();
        }
    }
    
    private async Task HandleCancel()
    {
        if (OnCancel.HasDelegate)
        {
            await OnCancel.InvokeAsync();
        }
    }
    
    private async Task HandleUncancel()
    {
        if (OnUncancel.HasDelegate)
        {
            await OnUncancel.InvokeAsync();
        }
    }

    // Helper method to get day of week in Portuguese
    private string GetDayOfWeek(DateTime date) => date.ToPortugueseWeekdayName();
    
    // Track previous state for ShouldRender optimization
    private int _previousRehearsalId;
    private bool _previousIsCanceled;
    private int _previousAttendanceCount;
    private bool _previousWillAttend;
    private bool _previousIsAdmin;
    private bool _previousIsPastRehearsal;
    
    /// <summary>
    /// Optimize rendering - only re-render when key parameters change.
    /// This is especially important for RehearsalCard as it's used in lists.
    /// </summary>
    protected override bool ShouldRender()
    {
        var rehearsalId = Rehearsal?.Id ?? 0;
        var isCanceled = Rehearsal?.IsCanceled ?? false;
        var willAttend = UserAttendance?.WillAttend ?? false;
        
        if (rehearsalId != _previousRehearsalId ||
            isCanceled != _previousIsCanceled ||
            AttendanceCount != _previousAttendanceCount ||
            willAttend != _previousWillAttend ||
            IsAdmin != _previousIsAdmin ||
            IsPastRehearsal != _previousIsPastRehearsal)
        {
            _previousRehearsalId = rehearsalId;
            _previousIsCanceled = isCanceled;
            _previousAttendanceCount = AttendanceCount;
            _previousWillAttend = willAttend;
            _previousIsAdmin = IsAdmin;
            _previousIsPastRehearsal = IsPastRehearsal;
            return true;
        }
        return false;
    }
}

