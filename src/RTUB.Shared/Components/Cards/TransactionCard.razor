@namespace RTUB.Shared
@using RTUB.Core.Entities
@*
    TransactionCard Component
    Compact card for displaying financial transaction information with admin controls
    Redesigned to match LabelCard style with header icon
*@

<div class="card transaction-card h-100">
    <div class="position-relative">
        @if (ShowActions)
        {
            <div class="transaction-admin-overlay">
                <button class="btn btn-sm music-btn-edit" 
                        @onclick="HandleEdit" 
                        @onclick:stopPropagation="true"
                        title="Editar transação"
                        aria-label="Editar transação">
                    <i class="bi bi-pencil music-icon-edit"></i>
                </button>
                <button class="btn btn-sm music-btn-delete" 
                        @onclick="HandleDelete" 
                        @onclick:stopPropagation="true"
                        title="Eliminar transação"
                        aria-label="Eliminar transação">
                    <i class="bi bi-trash music-icon-delete"></i>
                </button>
            </div>
        }
        <div class="transaction-header @(Transaction.Type == "Income" ? "income-header" : "expense-header")">
            <div class="transaction-icon-circle @(Transaction.Type == "Income" ? "income-circle" : "expense-circle")">
                <i class="bi @(Transaction.Type == "Income" ? "bi-cash-coin" : "bi-credit-card")" aria-hidden="true"></i>
            </div>
        </div>
    </div>
    <div class="card-body d-flex flex-column p-2">
        <div class="transaction-info">
            <!-- Type Badge -->
            <div class="transaction-meta mb-1">
                <span class="badge @(Transaction.Type == "Income" ? "bg-success" : "bg-danger")" style="font-size: 0.7rem;">
                    @(Transaction.Type == "Income" ? "Receita" : "Despesa")
                </span>
            </div>

            <!-- Description -->
            <h6 class="transaction-title mb-1" title="@Transaction.Description">
                @Transaction.Description
            </h6>

            <!-- Date -->
            <div class="transaction-date-row mb-1">
                <span class="transaction-date text-muted">
                    <i class="bi bi-calendar3 me-1" aria-hidden="true"></i>@Transaction.Date.ToString("dd/MM/yy")
                </span>
            </div>

            <!-- Category -->
            <div class="transaction-info-row mb-1">
                <i class="bi bi-tag transaction-icon" aria-hidden="true"></i>
                <span class="transaction-text text-muted small">@Transaction.Category</span>
            </div>

            <!-- Amount -->
            <div class="transaction-amount @(Transaction.Type == "Income" ? "text-success" : "text-danger")">
                @(Transaction.Type == "Income" ? "+" : "-")€@Transaction.Amount.ToString("N2")
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Transaction.ReceiptUrl))
        {
            <div class="transaction-actions mt-auto">
                <div class="d-flex gap-2 align-items-center justify-content-center">
                    <button class="btn btn-sm btn-purple transaction-action-btn" 
                            @onclick="HandleViewReceipt"
                            @onclick:stopPropagation="true"
                            title="Ver recibo"
                            aria-label="Ver recibo da transação">
                        <i class="bi bi-eye-fill" aria-hidden="true"></i>
                        <span>Ver Recibo</span>
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@code {
    /// <summary>
    /// The transaction to display
    /// </summary>
    [Parameter, EditorRequired]
    public Transaction Transaction { get; set; } = null!;

    /// <summary>
    /// Whether to show admin action buttons (edit/delete)
    /// </summary>
    [Parameter]
    public bool ShowActions { get; set; } = false;

    /// <summary>
    /// Callback when the edit button is clicked
    /// </summary>
    [Parameter]
    public EventCallback<Transaction> OnEdit { get; set; }

    /// <summary>
    /// Callback when the delete button is clicked
    /// </summary>
    [Parameter]
    public EventCallback<Transaction> OnDelete { get; set; }

    /// <summary>
    /// Callback when the view receipt button is clicked
    /// </summary>
    [Parameter]
    public EventCallback<string> OnViewReceipt { get; set; }

    private async Task HandleEdit()
    {
        if (OnEdit.HasDelegate)
        {
            await OnEdit.InvokeAsync(Transaction);
        }
    }

    private async Task HandleDelete()
    {
        if (OnDelete.HasDelegate)
        {
            await OnDelete.InvokeAsync(Transaction);
        }
    }

    private async Task HandleViewReceipt()
    {
        if (OnViewReceipt.HasDelegate && !string.IsNullOrEmpty(Transaction.ReceiptUrl))
        {
            await OnViewReceipt.InvokeAsync(Transaction.ReceiptUrl);
        }
    }
}
