@namespace RTUB.Shared
@using RTUB.Core.Entities

@* CharacterCard Component - Displays a character card for My Tuno battles *@

<div class="character-card card h-100">
    <div class="card-body d-flex flex-column">
        <!-- Character Avatar/Image -->
        <div class="character-card-avatar mb-3">
            @if (Character?.User != null)
            {
                <img src="@Character.User.ProfilePictureSrc" 
                     alt="@Character.User.Nickname" 
                     class="character-card-image rounded-circle" />
            }
            else
            {
                <div class="character-card-image-placeholder rounded-circle">
                    <i class="bi bi-person"></i>
                </div>
            }
        </div>

        <!-- Character Info -->
        <div class="character-card-info text-center mb-3">
            @if (Character?.User != null)
            {
                <h6 class="mb-1">@Character.User.Nickname</h6>
                <small class="text-muted d-block mb-2">Nível @Character.Level</small>
            }
            else
            {
                <h6 class="mb-1">Personagem</h6>
                <small class="text-muted d-block mb-2">Nível @(Character?.Level ?? 1)</small>
            }

            <!-- Stats -->
            <div class="character-card-stats">
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-danger"><i class="bi bi-heart-fill"></i> HP:</span>
                    <strong>@(Character?.TotalHP ?? 0)</strong>
                </div>
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-warning"><i class="bi bi-lightning-fill"></i> Poder:</span>
                    <strong>@(Character?.TotalPower ?? 0)</strong>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-info"><i class="bi bi-speedometer2"></i> Velocidade:</span>
                    <strong>@(Character?.TotalSpeed ?? 0)</strong>
                </div>
            </div>
        </div>

        <!-- Fight Button -->
        <div class="mt-auto">
            <button class="btn btn-primary w-100" 
                    @onclick="() => OnFight.InvokeAsync(Character)"
                    disabled="@(IsDisabled || Character == null)">
                @if (IsFighting)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                    <text>A lutar...</text>
                }
                else
                {
                    <i class="bi bi-sword me-2"></i>
                    <text>Lutar</text>
                }
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public Character? Character { get; set; }

    [Parameter]
    public EventCallback<Character> OnFight { get; set; }

    [Parameter]
    public bool IsDisabled { get; set; } = false;

    [Parameter]
    public bool IsFighting { get; set; } = false;
}
