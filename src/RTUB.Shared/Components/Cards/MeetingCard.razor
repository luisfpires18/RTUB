@namespace RTUB.Shared
@using RTUB.Core.Entities
@using RTUB.Core.Enums
@using RTUB.Core.Helpers
@*
    MeetingCard Component
    Card for displaying meeting information with admin controls and participation
*@

<div class="card meeting-card h-100">
    <div class="meeting-card__top position-relative">
        @* VOU/NAO VOU badges at top left - only show if user has participated *@
        @if (UserParticipation != null)
        {
            <div class="position-absolute top-0 start-0 p-2">
                @if (UserParticipation.WillAttend)
                {
                    <span class="badge bg-success fs-6">
                        <i class="bi bi-check-circle-fill me-1"></i>@(IsMeetingCompleted() ? "FUI" : "VOU")
                    </span>
                }
                else
                {
                    <span class="badge bg-danger fs-6">
                        <i class="bi bi-x-circle-fill me-1"></i>@(IsMeetingCompleted() ? "NÃO FUI" : "NÃO VOU")
                    </span>
                }
            </div>
        }
        @* Status badges (Realizada/Agendada/Cancelada) at bottom left *@
        <div class="position-absolute bottom-0 start-0 p-2">
            <span class="meeting-status-badge-inline @GetMeetingStatusClass()">
                @GetMeetingStatus()
            </span>
        </div>
        @if (IsAdmin)
        {
            <div class="admin-overlay">
                <button class="btn btn-sm music-btn-edit" @onclick="HandleEdit" title="Editar">
                    <i class="bi bi-pencil music-icon-edit"></i>
                </button>
                <button class="btn btn-sm music-btn-delete" @onclick="HandleDelete" title="Eliminar">
                    <i class="bi bi-trash music-icon-delete"></i>
                </button>
            </div>
        }
        <div class="meeting-icon-header">
            <div class="meeting-icon-circle">
                <i class="bi bi-calendar3"></i>
            </div>
        </div>
    </div>
    <div class="card-body d-flex flex-column">
        <div class="d-flex flex-wrap align-items-start justify-content-between gap-2 mb-2">
            <h5 class="meeting-title mb-0">@Meeting.Title</h5>
            <span class="badge @GetMeetingTypeBadgeClass()">@GetMeetingTypeFullName()</span>
        </div>

        <div class="meeting-info">
            <div class="meeting-info-row">
                <i class="bi bi-calendar3 meeting-icon"></i>
                <span class="meeting-text">
                    @Meeting.Date.ToString("dd MMM yyyy") (@GetDayOfWeek(Meeting.Date))
                    <DateBadge Date="@Meeting.Date" />
                </span>
            </div>

            <div class="meeting-info-row">
                <i class="bi bi-clock meeting-icon"></i>
                <span class="meeting-text">@Meeting.Date.ToString("HH:mm")</span>
            </div>

            @if (!string.IsNullOrEmpty(Meeting.Location))
            {
                <div class="meeting-info-row">
                    <i class="bi bi-geo-alt meeting-icon"></i>
                    <span class="meeting-text">@Meeting.Location</span>
                </div>
            }

            @if (Organizer != null && Organizer.Positions != null && Organizer.Positions.Any())
            {
                <div class="meeting-info-row mb-2">
                    <i class="bi bi-person-badge meeting-icon"></i>
                    <span class="meeting-text">Organizador: @Organizer.Nickname, @PositionHelper.GetDisplayName(Organizer.Positions.First())</span>
                </div>
            }

            @if (Meeting.Type == MeetingType.ConselhoVeteranos && Meeting.TunoRepresentative != null)
            {
                <div class="meeting-info-row mb-2">
                    <i class="bi bi-person-badge meeting-icon text-warning"></i>
                    <span class="meeting-text">Representante: @Meeting.TunoRepresentative.Nickname</span>
                </div>
            }
        </div>

        @* Participation Section - for upcoming meetings *@
        @if (!Meeting.IsCancelled && !IsMeetingCompleted())
        {
            <div class="participation-section mt-3 p-2 rounded">
                <div class="d-flex flex-column gap-2">
                    <!-- Row 1: View Participants Button -->
                    <div class="event-buttons-container justify-content-center">
                        <button class="btn event-icon-btn event-icon-btn-with-count btn-outline-primary" 
                                @onclick="OnViewParticipants" 
                                title="Participantes">
                            <i class="bi bi-people"></i>
                            <span class="enrollment-count-centered">@ParticipationCount</span>
                        </button>
                    </div>

                    <!-- Row 2: VOU/NAO VOU action buttons -->
                    <div class="event-buttons-container">
                        <!-- Green "Vou" button -->
                        <button class="btn event-icon-btn btn-going @GetGoingButtonClass()" 
                                @onclick="OnParticipateGoing" 
                                title="@GetGoingButtonTitle()">
                            <i class="bi bi-check-circle-fill"></i>
                        </button>
                        
                        <!-- Red "Não vou" button -->
                        <button class="btn event-icon-btn btn-not-going @GetNotGoingButtonClass()" 
                                @onclick="OnParticipateNotGoing" 
                                title="@GetNotGoingButtonTitle()">
                            <i class="bi bi-x-circle-fill"></i>
                        </button>
                    </div>
                </div>
            </div>
        }
        
        @* Participation Section - for past meetings (like events) *@
        @if (!Meeting.IsCancelled && IsMeetingCompleted())
        {
            <div class="participation-section mt-3 p-2 rounded">
                <div class="d-flex flex-column gap-2">
                    <!-- View Participants Button -->
                    <div class="event-buttons-container justify-content-center">
                        <button class="btn event-icon-btn event-icon-btn-with-count btn-outline-primary" 
                                @onclick="OnViewParticipants" 
                                title="Participantes">
                            <i class="bi bi-people"></i>
                            <span class="enrollment-count-centered">@ParticipationCount</span>
                        </button>
                    </div>
                    
                    <!-- Participation management for past meetings -->
                    @if (UserParticipation != null)
                    {
                        <div class="event-buttons-container mt-2">
                            <!-- Remove participation button for user's own participation -->
                            <button class="btn event-icon-btn btn-danger" 
                                    @onclick="HandleRemoveParticipation" 
                                    title="Remover Participação">
                                <i class="bi bi-x-circle-fill"></i>
                            </button>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="meeting-actions mt-auto">
            <div class="d-flex justify-content-center align-items-center gap-2 flex-wrap">
                <button class="btn btn-sm btn-primary d-flex align-items-center gap-2"
                        @onclick="HandleViewDetails"
                        title="Ver Detalhes">
                    <i class="bi bi-eye-fill"></i>
                    <span>Ver Detalhes</span>
                </button>
                @if (!Meeting.IsCancelled && IsMeetingCompleted() && CanCreateAta)
                {
                    <button class="btn btn-sm btn-primary d-flex align-items-center gap-2"
                            @onclick="HandleAta"
                            title="Criar/Editar Ata">
                        <i class="bi bi-file-text"></i>
                        <span>Ata</span>
                    </button>
                }
                @if (!Meeting.IsCancelled && IsMeetingCompleted() && !CanCreateAta && HasAta)
                {
                    <button class="btn btn-sm btn-outline-primary d-flex align-items-center gap-2"
                            @onclick="HandleViewAta"
                            title="Ver Ata">
                        <i class="bi bi-eye-fill"></i>
                        <span>Ver Ata</span>
                    </button>
                }
                @if (IsAdmin && !Meeting.IsCancelled && !IsMeetingCompleted())
                {
                    <button class="btn btn-sm btn-primary d-flex align-items-center gap-2"
                            @onclick="HandleSendEmail"
                            title="Enviar notificação por email">
                        <i class="bi bi-envelope-fill"></i>
                        <span>Email</span>
                    </button>
                    <button class="btn btn-sm btn-primary btn-primary-purple d-flex align-items-center gap-2"
                            @onclick="HandleSendPushNotification"
                            title="Enviar notificação push">
                        <i class="bi bi-bell-fill"></i>
                        <span>Push</span>
                    </button>
                    <button class="btn btn-sm btn-danger d-flex align-items-center gap-2"
                            @onclick="HandleCancel"
                            title="Cancelar reunião">
                        <i class="bi bi-x-circle-fill"></i>
                        <span>Cancelar</span>
                    </button>
                }
                @if (IsAdmin && Meeting.IsCancelled)
                {
                    <button class="btn btn-sm btn-warning d-flex align-items-center gap-2"
                            @onclick="HandleUncancel"
                            title="Reverter cancelamento">
                        <i class="bi bi-arrow-counterclockwise"></i>
                        <span>Reverter</span>
                    </button>
                }
            </div>
        </div>
    </div>
</div>

@code {
    /// <summary>
    /// The meeting to display
    /// </summary>
    [Parameter]
    public Meeting Meeting { get; set; } = null!;

    /// <summary>
    /// The organizer of the meeting
    /// </summary>
    [Parameter]
    public ApplicationUser? Organizer { get; set; }

    /// <summary>
    /// Whether the current user has admin privileges
    /// </summary>
    [Parameter]
    public bool IsAdmin { get; set; }

    /// <summary>
    /// Callback when the edit button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnEdit { get; set; }

    /// <summary>
    /// Callback when the delete button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnDelete { get; set; }

    /// <summary>
    /// Callback when the view details button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnViewDetails { get; set; }

    /// <summary>
    /// Callback when the send email button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnSendEmail { get; set; }

    /// <summary>
    /// Callback when the send push notification button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnSendPushNotification { get; set; }

    /// <summary>
    /// Callback when the cancel button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnCancel { get; set; }

    /// <summary>
    /// Callback when the uncancel button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnUncancel { get; set; }

    /// <summary>
    /// User's participation in this meeting (if any)
    /// </summary>
    [Parameter]
    public MeetingParticipation? UserParticipation { get; set; }

    /// <summary>
    /// Total number of participants who confirmed attendance
    /// </summary>
    [Parameter]
    public int ParticipationCount { get; set; }

    /// <summary>
    /// Callback when user clicks "Vou" (going) button
    /// </summary>
    [Parameter]
    public EventCallback OnParticipateGoing { get; set; }

    /// <summary>
    /// Callback when user clicks "Não vou" (not going) button
    /// </summary>
    [Parameter]
    public EventCallback OnParticipateNotGoing { get; set; }

    /// <summary>
    /// Callback when user wants to edit their participation
    /// </summary>
    [Parameter]
    public EventCallback OnEditParticipation { get; set; }

    /// <summary>
    /// Callback when user wants to remove their participation
    /// </summary>
    [Parameter]
    public EventCallback OnRemoveParticipation { get; set; }

    /// <summary>
    /// Callback when user wants to view all participants
    /// </summary>
    [Parameter]
    public EventCallback OnViewParticipants { get; set; }

    /// <summary>
    /// Whether the current user can create/edit the ata for this meeting
    /// </summary>
    [Parameter]
    public bool CanCreateAta { get; set; }

    /// <summary>
    /// Callback when the ata button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnAta { get; set; }

    /// <summary>
    /// Whether an ata exists for this meeting (for showing view button)
    /// </summary>
    [Parameter]
    public bool HasAta { get; set; }

    /// <summary>
    /// Callback when the view ata button is clicked (for non-admin users)
    /// </summary>
    [Parameter]
    public EventCallback OnViewAta { get; set; }

    private async Task HandleEdit()
    {
        if (OnEdit.HasDelegate)
        {
            await OnEdit.InvokeAsync();
        }
    }

    private async Task HandleDelete()
    {
        if (OnDelete.HasDelegate)
        {
            await OnDelete.InvokeAsync();
        }
    }

    private async Task HandleViewDetails()
    {
        if (OnViewDetails.HasDelegate)
        {
            await OnViewDetails.InvokeAsync();
        }
    }

    private async Task HandleSendEmail()
    {
        if (OnSendEmail.HasDelegate)
        {
            await OnSendEmail.InvokeAsync();
        }
    }

    private async Task HandleSendPushNotification()
    {
        if (OnSendPushNotification.HasDelegate)
        {
            await OnSendPushNotification.InvokeAsync();
        }
    }

    private async Task HandleCancel()
    {
        if (OnCancel.HasDelegate)
        {
            await OnCancel.InvokeAsync();
        }
    }

    private async Task HandleUncancel()
    {
        if (OnUncancel.HasDelegate)
        {
            await OnUncancel.InvokeAsync();
        }
    }

    private async Task HandleRemoveParticipation()
    {
        if (OnRemoveParticipation.HasDelegate)
        {
            await OnRemoveParticipation.InvokeAsync();
        }
    }

    private async Task HandleAta()
    {
        if (OnAta.HasDelegate)
        {
            await OnAta.InvokeAsync();
        }
    }

    private async Task HandleViewAta()
    {
        if (OnViewAta.HasDelegate)
        {
            await OnViewAta.InvokeAsync();
        }
    }

    private string GetMeetingTypeLabel()
    {
        return Meeting.Type switch
        {
            MeetingType.AssembleiaGeralOrdinaria => "ASSEMBLEIA GERAL ORDINÁRIA",
            MeetingType.AssembleiaGeralExtraordinaria => "ASSEMBLEIA GERAL EXTRAORDINÁRIA",
            MeetingType.ConselhoVeteranos => "CONSELHO DE VETERANOS",
            _ => ""
        };
    }

    private string GetMeetingTypeCssClass()
    {
        // All badges are now purple
        return "meeting-type-badge";
    }

    private string GetMeetingTypeFullName()
    {
        return Meeting.Type switch
        {
            MeetingType.AssembleiaGeralOrdinaria => "Assembleia Geral Ordinária",
            MeetingType.AssembleiaGeralExtraordinaria => "Assembleia Geral Extraordinária",
            MeetingType.ConselhoVeteranos => "Conselho de Veteranos",
            MeetingType.ReuniaoDirecao => "Reunião de Direção",
            _ => ""
        };
    }

    private string GetMeetingStatus()
    {
        if (Meeting.IsCancelled)
            return "Cancelada";
        return Meeting.Date.Date < DateTime.Today ? "Realizada" : "Agendada";
    }

    private bool IsMeetingCompleted()
    {
        return !Meeting.IsCancelled && Meeting.Date.Date <= DateTime.Today;
    }

    private string GetMeetingStatusClass()
    {
        if (Meeting.IsCancelled)
            return "meeting-status-cancelled";
        return Meeting.Date.Date < DateTime.Today ? "meeting-status-past" : "meeting-status-upcoming";
    }

    private string GetDayOfWeek(DateTime date)
    {
        return date.DayOfWeek switch
        {
            DayOfWeek.Monday => "Segunda",
            DayOfWeek.Tuesday => "Terça",
            DayOfWeek.Wednesday => "Quarta",
            DayOfWeek.Thursday => "Quinta",
            DayOfWeek.Friday => "Sexta",
            DayOfWeek.Saturday => "Sábado",
            DayOfWeek.Sunday => "Domingo",
            _ => ""
        };
    }

    private string GetMeetingTypeBadgeClass()
    {
        return Meeting.Type switch
        {
            MeetingType.ConselhoVeteranos => "bg-secondary",  // Grey for veteran council
            MeetingType.AssembleiaGeralOrdinaria => "bg-primary",  // Blue for ordinary assembly
            MeetingType.AssembleiaGeralExtraordinaria => "bg-primary",  // Blue for extraordinary assembly
            MeetingType.ReuniaoDirecao => "bg-info",  // Light blue for board meetings
            _ => "bg-secondary"
        };
    }
    
    private string GetGoingButtonClass()
    {
        if (UserParticipation?.WillAttend == true)
            return "btn-selected";
        if (UserParticipation != null && !UserParticipation.WillAttend)
            return "btn-secondary-small";
        return string.Empty;
    }
    
    private string GetNotGoingButtonClass()
    {
        if (UserParticipation != null && !UserParticipation.WillAttend)
            return "btn-selected";
        if (UserParticipation?.WillAttend == true)
            return "btn-secondary-small";
        return string.Empty;
    }
    
    private string GetGoingButtonTitle()
    {
        return UserParticipation?.WillAttend == true 
            ? "Editar participação" 
            : "Vou participar";
    }
    
    private string GetNotGoingButtonTitle()
    {
        return UserParticipation != null && !UserParticipation.WillAttend 
            ? "Editar impossibilidade" 
            : "Não vou participar";
    }
}

<style>
    .meeting-card {
        background-color: #151516;
        border: 1px solid var(--bs-border-color);
        border-radius: 0.5rem;
        overflow: hidden;
        transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .meeting-card:hover {
        transform: translateY(-3px);
        border-color: rgba(var(--bs-primary-rgb), 0.6);
        box-shadow: 0 4px 12px rgba(var(--bs-primary-rgb), 0.25);
    }

    .meeting-card__top {
        position: relative;
        z-index: 2;
    }

    .meeting-icon-header {
        width: 100%;
        height: 110px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, rgba(var(--bs-primary-rgb), 0.15) 0%, rgba(var(--bs-primary-rgb), 0.05) 100%);
        border-bottom: 2px solid rgba(var(--bs-primary-rgb), 0.3);
    }

    .meeting-icon-circle {
        width: 65px;
        height: 65px;
        border-radius: 50%;
        background-color: rgba(var(--bs-primary-rgb), 0.2);
        border: 2px solid var(--bs-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
    }

    .meeting-card:hover .meeting-icon-circle {
        background-color: rgba(var(--bs-primary-rgb), 0.3);
        transform: scale(1.05);
    }

    .meeting-icon-circle i {
        font-size: 1.875rem;
        color: var(--bs-link-color);
    }

    .meeting-status-badge-inline {
        display: inline-flex;
        align-items: center;
        padding: 0.2rem 0.55rem;
        border-radius: 0.3rem;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .meeting-status-upcoming {
        background: linear-gradient(135deg, rgba(0, 188, 140, 0.25) 0%, rgba(0, 188, 140, 0.15) 100%);
        color: var(--bs-success);
        border: 1px solid rgba(0, 188, 140, 0.4);
    }

    .meeting-status-cancelled {
        background: linear-gradient(135deg, rgba(220, 53, 69, 0.25) 0%, rgba(220, 53, 69, 0.15) 100%);
        color: #dc3545;
        border: 1px solid rgba(220, 53, 69, 0.4);
    }

    .meeting-status-past {
        background: linear-gradient(135deg, rgba(108, 117, 125, 0.25) 0%, rgba(108, 117, 125, 0.15) 100%);
        color: #6c757d;
        border: 1px solid rgba(108, 117, 125, 0.4);
    }

    .meeting-title {
        color: var(--text-primary);
        font-weight: 600;
        font-size: 1.1rem;
    }

    .meeting-info {
        display: flex;
        flex-direction: column;
        gap: 0.625rem;
        margin-bottom: 0.75rem;
    }

    .meeting-info-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--text-secondary);
        font-size: 0.9375rem;
        line-height: 1.4;
        flex-wrap: wrap;
    }

    .meeting-icon {
        color: var(--bs-primary);
        font-size: 1rem;
        flex-shrink: 0;
        width: 1.125rem;
        text-align: center;
    }

    .meeting-text {
        flex: 1;
        font-weight: 500;
    }

    .meeting-today-badge {
        display: inline-flex;
        align-items: center;
        margin-left: 0.5rem;
        padding: 0.2rem 0.55rem;
        background: linear-gradient(135deg, rgba(0, 188, 140, 0.25) 0%, rgba(0, 188, 140, 0.15) 100%);
        color: var(--bs-success);
        border: 1px solid rgba(0, 188, 140, 0.4);
        border-radius: 0.3rem;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
    }

    .meeting-actions {
        padding-top: 0.75rem;
        border-top: 1px solid rgba(var(--bs-primary-rgb), 0.15);
        margin-top: auto;
    }

    /* Participation section styles */
    .participation-section {
        background-color: rgba(var(--bs-primary-rgb), 0.05);
        border: 1px solid rgba(var(--bs-primary-rgb), 0.15);
    }

    /* Event buttons container (from EventCard) */
    .event-buttons-container {
        display: flex;
        gap: 0.5rem;
        align-items: center;
        justify-content: center;
        width: 100%;
        max-width: 100%;
        min-width: 0;
        overflow-x: auto;
        flex-wrap: nowrap;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: thin;
        padding: 0.25rem 0;
    }

    /* Hide scrollbar for cleaner look */
    .event-buttons-container::-webkit-scrollbar {
        height: 4px;
    }

    .event-buttons-container::-webkit-scrollbar-track {
        background: rgba(111, 66, 193, 0.1);
        border-radius: 2px;
    }

    .event-buttons-container::-webkit-scrollbar-thumb {
        background: rgba(111, 66, 193, 0.3);
        border-radius: 2px;
    }

    .event-buttons-container::-webkit-scrollbar-thumb:hover {
        background: rgba(111, 66, 193, 0.5);
    }

    /* Icon-only square buttons */
    .event-icon-btn {
        width: 52px;
        height: 52px;
        min-width: 52px;
        min-height: 52px;
        padding: 0;
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: center;
        gap: 0.25rem;
        border-radius: 0.75rem;
        position: relative;
        flex-shrink: 0;
        transition: all 0.2s ease;
    }

    .event-icon-btn i {
        font-size: 1.25rem;
        line-height: 1;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Enrollment count to the right of icon */
    .event-icon-btn .enrollment-count-centered {
        position: relative;
        color: inherit;
        font-size: 1.25rem;
        font-weight: 700;
        line-height: 1;
    }

    /* Participants button with count needs to be wider */
    .event-icon-btn-with-count {
        width: auto;
        min-width: 52px;
        padding: 0 0.5rem;
    }

    /* Button hover effects */
    .event-icon-btn:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
    }

    .event-icon-btn:disabled {
        opacity: 0.65;
        cursor: not-allowed;
    }

    /* Going button (green success style) */
    .btn-going {
        background-color: #198754;
        border-color: #198754;
        color: white;
        opacity: 0.6;
    }

    .btn-going:hover:not(:disabled) {
        background-color: #157347;
        border-color: #146c43;
        color: white;
        opacity: 1;
    }

    .btn-going.btn-selected {
        opacity: 1;
    }

    /* Not Going button (red danger style) */
    .btn-not-going {
        background-color: #dc3545;
        border-color: #dc3545;
        color: white;
        opacity: 0.6;
    }

    .btn-not-going:hover:not(:disabled) {
        background-color: #bb2d3b;
        border-color: #b02a37;
        color: white;
        opacity: 1;
    }

    .btn-not-going.btn-selected {
        opacity: 1;
    }

    /* Smaller secondary button (for non-selected state) */
    .event-icon-btn.btn-secondary-small {
        width: 36px;
        height: 36px;
        min-width: 36px;
        min-height: 36px;
    }

    .event-icon-btn.btn-secondary-small i {
        font-size: 1rem;
    }

    /* Responsive adjustments */
    @@media (max-width: 768px) {
        .event-buttons-container {
            justify-content: center;
            padding-left: 0.25rem;
            padding-right: 0.25rem;
            flex-wrap: wrap;
            gap: 0.375rem;
        }

        .event-icon-btn {
