@namespace RTUB.Shared
@*
    EventCard: one event as an event, not a record (docs/design/RTUB_UI_REFACTOR.md section 25).
    Image (when there is one) -> date tile + title + when/where -> quiet counts -> the member's
    own answer (Vou / Não vou). Management actions live in the CardMenu; delete is last.
*@

<article class="@CardClass"
         aria-labelledby="@TitleId">
    @if (HasImage)
    {
        <div class="event-item__media">
            <img src="@(ImageUrl ?? Event.ImageSrc)" class="event-item__image" alt="@Event.Name" loading="lazy"
                 @onerror="HandleImageError">
        </div>
    }

    <div class="event-item__body">
        <div class="event-item__head">
            <DateTile Date="@Event.Date" ShowYear="@(IsPastEvent || Event.Date.Year != DateTime.Today.Year)" Muted="@(IsPastEvent || Event.IsCancelled)" />
            <div class="event-item__heading">
                @if (Event.IsCancelled)
                {
                    <p class="item-status item-status--danger"><i class="bi bi-x-octagon-fill" aria-hidden="true"></i>Cancelado</p>
                }
                else if (UserEnrollment != null && IsPastEvent)
                {
                    @if (UserEnrollment.WillAttend)
                    {
                        <p class="item-status item-status--success"><i class="bi bi-check-circle-fill" aria-hidden="true"></i>Fui</p>
                    }
                    else
                    {
                        <p class="item-status"><i class="bi bi-x-circle" aria-hidden="true"></i>Não fui</p>
                    }
                }
                <h3 class="item-card__title" id="@TitleId">
                    @Event.Name
                    @if (ShowTrophyCorner && Event.Type == EventType.Festival)
                    {
                        <i class="bi bi-trophy-fill event-item__trophy" title="Festival" aria-hidden="true"></i>
                        <span class="visually-hidden">(Festival)</span>
                    }
                </h3>
                <p class="item-card__meta item-card__meta--strong">
                    <i class="bi bi-clock" aria-hidden="true"></i>
                    @if (Event.EndDate.HasValue && Event.EndDate.Value.Date != Event.Date.Date)
                    {
                        <span>@Event.Date.ToString("dd MMM") - @Event.EndDate.Value.ToString("dd MMM yyyy")</span>
                    }
                    else
                    {
                        <span>@Event.Date.ToString("dd MMM yyyy")@(Event.Date.TimeOfDay != TimeSpan.Zero ? $", {Event.Date:HH:mm}h" : "") <DateBadge Date="@Event.Date" /></span>
                    }
                </p>
                @if (!string.IsNullOrEmpty(Event.Location))
                {
                    <p class="item-card__meta">
                        <i class="bi bi-geo-alt" aria-hidden="true"></i>
                        <span>@Event.Location</span>
                    </p>
                }
            </div>
            @if (IsAdmin)
            {
                <CardMenu Label="@Event.Name">
                    <CardMenuItem Label="Editar evento" Icon="bi-pencil" OnClick="OnEdit" />
                    @if (!IsPastEvent && !Event.IsCancelled)
                    {
                        <CardMenuItem Label="Notificar por push" Icon="bi-bell" OnClick="OnSendPushNotification" />
                        <CardMenuItem Label="Notificar por email" Icon="bi-envelope" OnClick="OnSendEmail" />
                    }
                    @if (!IsPastEvent && Event.IsCancelled)
                    {
                        <CardMenuItem Label="Reativar evento" Icon="bi-arrow-counterclockwise" OnClick="OnUncancelEvent" />
                    }
                    @if (!IsPastEvent && !Event.IsCancelled && ShowCancelButton)
                    {
                        <CardMenuItem Label="Cancelar evento" Icon="bi-x-octagon" Danger="true" Divider="true" OnClick="OnCancelEvent" />
                    }
                    @if (ShowDeleteButton)
                    {
                        <CardMenuItem Label="Eliminar evento" Icon="bi-trash" Danger="true"
                                      Divider="@(IsPastEvent || Event.IsCancelled || !ShowCancelButton)" OnClick="OnDelete" />
                    }
                </CardMenu>
            }
        </div>

        @if (ShowOnlyTrophy)
        {
            <div class="item-card__footer">
                <div class="item-card__links">
                    @if (Event.Type == EventType.Festival)
                    {
                        @TrophiesChip
                    }
                    @VideosChip
                </div>
            </div>
        }
        else if (ShowButtons)
        {
            <div class="item-card__footer">
                <div class="item-card__links">
                    <button type="button" class="item-chip item-chip--link" @onclick="OnViewDetails" title="Detalhes">
                        <i class="bi bi-info-circle" aria-hidden="true"></i><span>Detalhes</span>
                    </button>
                    @if (!Event.IsCancelled)
                    {
                        <button type="button" class="item-chip" @onclick="OnViewEnrollments" title="Participantes"
                                aria-label="@($"Participantes ({EnrollmentCount})")">
                            <i class="bi bi-people" aria-hidden="true"></i><span>@EnrollmentCount</span>
                        </button>
                        <button type="button" class="item-chip" @onclick="OnWatchRepertoire" title="Repertório"
                                aria-label="@($"Repertório ({RepertoireCount})")">
                            <i class="bi bi-music-note-list" aria-hidden="true"></i><span>@RepertoireCount</span>
                        </button>
                        <button type="button" class="item-chip" @onclick="OnViewDiscussion" title="Discussão"
                                aria-label="@($"Discussão ({DiscussionCount})")">
                            <i class="bi bi-chat-dots" aria-hidden="true"></i><span>@DiscussionCount</span>
                        </button>
                        @if (IsPastEvent)
                        {
                            @if (ShowTrophy && Event.Type == EventType.Festival)
                            {
                                @TrophiesChip
                            }
                            @VideosChip
                        }
                    }
                </div>

                @if (!Event.IsCancelled && !IsPastEvent)
                {
                    var going = UserEnrollment?.WillAttend == true;
                    var notGoing = UserEnrollment != null && !UserEnrollment.WillAttend;
                    <div class="participation@(UserEnrollment != null ? " participation--answered" : null)"
                         role="group" aria-label="@($"A tua participação: {Event.Name}")">
                        <button type="button" class="participation__option participation__option--yes"
                                aria-pressed="@(going ? "true" : "false")"
                                title="@(going ? "Editar inscrição" : "Vou participar")"
                                @onclick="OnEnrollGoing">
                            <i class="bi @(going ? "bi-check-circle-fill" : "bi-check-lg")" aria-hidden="true"></i>Vou
                        </button>
                        <button type="button" class="participation__option participation__option--no"
                                aria-pressed="@(notGoing ? "true" : "false")"
                                title="@(notGoing ? "Editar impossibilidade" : "Não vou participar")"
                                @onclick="OnEnrollNotGoing">
                            <i class="bi @(notGoing ? "bi-x-circle-fill" : "bi-x-lg")" aria-hidden="true"></i>Não vou
                        </button>
                    </div>
                }
                else if (!Event.IsCancelled && UserEnrollment is { WillAttend: true })
                {
                    <div class="event-item__own">
                        <button type="button" class="item-chip item-chip--danger" @onclick="OnRemoveEnrollment" title="Remover Inscrição">
                            <i class="bi bi-x-circle" aria-hidden="true"></i><span>Remover inscrição</span>
                        </button>
                    </div>
                }
            </div>
        }
    </div>
</article>

@code {
    /// <summary>
    /// The event to display
    /// </summary>
    [Parameter]
    public Event Event { get; set; } = null!;

    /// <summary>
    /// The current user's enrollment for this event (if any)
    /// </summary>
    [Parameter]
    public Enrollment? UserEnrollment { get; set; }

    /// <summary>
    /// Total number of enrollments for this event
    /// </summary>
    [Parameter]
    public int EnrollmentCount { get; set; }

    /// <summary>
    /// Total number of repertoire songs for this event
    /// </summary>
    [Parameter]
    public int RepertoireCount { get; set; }

    /// <summary>
    /// Total number of discussion posts for this event
    /// </summary>
    [Parameter]
    public int DiscussionCount { get; set; }

    /// <summary>
    /// Total number of videos for this event
    /// </summary>
    [Parameter]
    public int VideoCount { get; set; }

    /// <summary>
    /// Total number of trophies for this event
    /// </summary>
    [Parameter]
    public int TrophyCount { get; set; }

    /// <summary>
    /// Whether the current user has admin privileges
    /// </summary>
    [Parameter]
    public bool IsAdmin { get; set; }

    /// <summary>
    /// Whether this is a past event (changes display behavior)
    /// </summary>
    [Parameter]
    public bool IsPastEvent { get; set; }

    /// <summary>
    /// Callback when the edit button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnEdit { get; set; }

    /// <summary>
    /// Callback when the delete button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnDelete { get; set; }

    /// <summary>
    /// Callback when the send email button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnSendEmail { get; set; }

    /// <summary>
    /// Callback when the send push notification button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnSendPushNotification { get; set; }
    /// <summary>
    /// Callback when the "Going" enrollment button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnEnrollGoing { get; set; }

    /// <summary>
    /// Callback when the "Not Going" enrollment button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnEnrollNotGoing { get; set; }

    /// <summary>
    /// Callback when the view enrollments button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnViewEnrollments { get; set; }

    /// <summary>
    /// Callback when the edit enrollment button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnEditEnrollment { get; set; }

    /// <summary>
    /// Callback when the remove enrollment button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnRemoveEnrollment { get; set; }

    /// <summary>
    /// Callback when the watch repertoire button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnWatchRepertoire { get; set; }

    /// <summary>
    /// Callback when the view details button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnViewDetails { get; set; }

    /// <summary>
    /// Callback when the view trophies button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnViewTrophies { get; set; }
    
    /// <summary>
    /// Callback when the view videos button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnViewVideos { get; set; }
    
    /// <summary>
    /// Callback when the view discussion button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnViewDiscussion { get; set; }
    
    /// <summary>
    /// Callback when the cancel event button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnCancelEvent { get; set; }
    
    /// <summary>
    /// Callback when the uncancel event button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnUncancelEvent { get; set; }

    /// <summary>
    /// Optional image URL to display (supports cache-busting)
    /// </summary>
    [Parameter]
    public string? ImageUrl { get; set; }

    /// <summary>
    /// Whether to show the trophy button in action section (for past events)
    /// </summary>
    [Parameter]
    public bool ShowTrophy { get; set; }

    /// <summary>
    /// Whether to show trophy corner badge (for AboutUsContent)
    /// </summary>
    [Parameter]
    public bool ShowTrophyCorner { get; set; }

    /// <summary>
    /// Whether to show action buttons (default: true, false for public portal)
    /// </summary>
    [Parameter]
    public bool ShowButtons { get; set; } = true;

    /// <summary>
    /// Whether to show only the trophy button (for public portal with trophies)
    /// </summary>
    [Parameter]
    public bool ShowOnlyTrophy { get; set; }
    
    /// <summary>
    /// Whether to show the delete button (default: true)
    /// Can be set to false for users with restricted permissions (e.g., Caloiro Admins)
    /// </summary>
    [Parameter]
    public bool ShowDeleteButton { get; set; } = true;
    
    /// <summary>
    /// Whether to show the cancel event button (default: true)
    /// Can be set to false for users with restricted permissions (e.g., Caloiro Admins)
    /// </summary>
    [Parameter]
    public bool ShowCancelButton { get; set; } = true;
    
    private string CardClass => "item-card event-item"
        + (Event.IsCancelled ? " event-item--cancelled" : "")
        + (IsPastEvent ? " event-item--past" : "");

    private string TitleId => $"event-item-title-{Event.Id}";

    private bool HasImage => !imageFailed && (!string.IsNullOrEmpty(ImageUrl) || !string.IsNullOrEmpty(Event.ImageSrc));

    // A broken image drops the media area instead of showing a broken-image box
    private bool imageFailed;

    private void HandleImageError()
    {
        imageFailed = true;
        StateHasChanged();
    }

    private RenderFragment TrophiesChip => @<button type="button" class="item-chip" @onclick="OnViewTrophies" title="Prémios"
                                                   aria-label="@($"Prémios ({TrophyCount})")">
        <i class="bi bi-trophy" aria-hidden="true"></i><span>@TrophyCount</span>
    </button>;

    private RenderFragment VideosChip => @<button type="button" class="item-chip" @onclick="OnViewVideos" title="Vídeos"
                                                 aria-label="@($"Vídeos ({VideoCount})")">
        <i class="bi bi-camera-video" aria-hidden="true"></i><span>@VideoCount</span>
    </button>;

    // Track previous state for ShouldRender optimization
    private bool _previousImageFailed;
    private int _previousEventId;
    private bool _previousIsCancelled;
    private int _previousEnrollmentCount;
    private int _previousRepertoireCount;
    private int _previousDiscussionCount;
    private int _previousVideoCount;
    private int _previousTrophyCount;
    private bool _previousHasEnrollment;
    private bool _previousWillAttend;
    private bool _previousIsAdmin;
    private bool _previousIsPastEvent;
    private string? _previousImageUrl;
    private string? _previousEventImageSrc;
    
    /// <summary>
    /// Optimize rendering - only re-render when key parameters change.
    /// This is especially important for EventCard as it's used in lists with many instances.
    /// </summary>
    protected override bool ShouldRender()
    {
        // Check key parameters that would require a visual update
        var eventId = Event?.Id ?? 0;
        var isCancelled = Event?.IsCancelled ?? false;
        var hasEnrollment = UserEnrollment != null;
        var willAttend = UserEnrollment?.WillAttend ?? false;
        var eventImageSrc = Event?.ImageSrc;
        
        if (eventId != _previousEventId ||
            isCancelled != _previousIsCancelled ||
            EnrollmentCount != _previousEnrollmentCount ||
            RepertoireCount != _previousRepertoireCount ||
            DiscussionCount != _previousDiscussionCount ||
            VideoCount != _previousVideoCount ||
            TrophyCount != _previousTrophyCount ||
            hasEnrollment != _previousHasEnrollment ||
            willAttend != _previousWillAttend ||
            IsAdmin != _previousIsAdmin ||
            IsPastEvent != _previousIsPastEvent ||
            ImageUrl != _previousImageUrl ||
            eventImageSrc != _previousEventImageSrc ||
            imageFailed != _previousImageFailed)
        {
            _previousEventId = eventId;
            _previousIsCancelled = isCancelled;
            _previousEnrollmentCount = EnrollmentCount;
            _previousRepertoireCount = RepertoireCount;
            _previousDiscussionCount = DiscussionCount;
            _previousVideoCount = VideoCount;
            _previousTrophyCount = TrophyCount;
            _previousHasEnrollment = hasEnrollment;
            _previousWillAttend = willAttend;
            _previousIsAdmin = IsAdmin;
            _previousIsPastEvent = IsPastEvent;
            _previousImageUrl = ImageUrl;
            _previousEventImageSrc = eventImageSrc;
            _previousImageFailed = imageFailed;
            return true;
        }
        return false;
    }
}
