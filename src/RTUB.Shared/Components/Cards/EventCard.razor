@namespace RTUB.Shared
@*
    EventCard Component
    Reusable card for displaying event information with enrollment actions
*@

<div class="card event-card h-100">
    <div class="position-relative">
        @if (!string.IsNullOrEmpty(ImageUrl) || !string.IsNullOrEmpty(Event.ImageSrc))
        {
            <img src="@(ImageUrl ?? Event.ImageSrc)" class="card-img-top event-image" alt="@Event.Name" loading="lazy">
        }
        else
        {
            <div class="card-img-top event-image-placeholder">
                <i class="bi bi-calendar-event music-icon-large"></i>
            </div>
        }
        
        @* Cancellation badge *@
        @if (Event.IsCancelled)
        {
            <div class="position-absolute top-0 start-0 p-2">
                <span class="badge bg-danger fs-6">
                    <i class="bi bi-x-circle-fill me-1"></i>CANCELADO
                </span>
            </div>
        }
        
        @* Trophy corner badge for AboutUsContent (Festival events only) *@
        @if (ShowTrophyCorner && Event.Type == EventType.Festival)
        {
            <div class="position-absolute top-0 end-0 p-2">
                <div class="badge bg-warning text-dark">
                    <i class="bi bi-trophy-fill"></i>
                </div>
            </div>
        }
        
        @if (IsAdmin)
        {
            <div class="admin-overlay">
                <button class="btn btn-sm music-btn-edit" 
                        @onclick="OnEdit" 
                        title="Editar evento">
                    <i class="bi bi-pencil music-icon-edit"></i>
                </button>
                @if (ShowDeleteButton)
                {
                    <button class="btn btn-sm music-btn-delete" 
                            @onclick="OnDelete" 
                            title="Eliminar evento">
                        <i class="bi bi-trash music-icon-delete"></i>
                    </button>
                }
            </div>
            
            @* Email notification and cancellation buttons in bottom-right corner *@
            @if (!IsPastEvent)
            {
                <div class="position-absolute bottom-0 end-0 p-2 d-flex flex-row gap-2">
                    @if (!Event.IsCancelled)
                    {
                        <button class="btn btn-sm btn-admin-notification" 
                                @onclick="OnSendPushNotification" 
                                title="Notificar por push">
                            <i class="bi bi-bell-fill"></i>
                        </button>
                        <button class="btn btn-sm btn-admin-notification" 
                                @onclick="OnSendEmail" 
                                title="Notificar por email">
                            <i class="bi bi-envelope-fill"></i>
                        </button>
                        @if (ShowCancelButton)
                        {
                            <button class="btn btn-sm btn-danger music-btn-cancel" 
                                    @onclick="OnCancelEvent" 
                                    title="Cancelar evento">
                                <i class="bi bi-x-circle-fill"></i>
                            </button>
                        }
                    }
                    else
                    {
                        <button class="btn btn-sm btn-warning music-btn-uncancel" 
                                @onclick="OnUncancelEvent" 
                                title="Reativar evento">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </button>
                    }
                </div>
            }
        }
    </div>
    <div class="card-body d-flex flex-column p-3">
        <h5 class="card-title mb-2">@Event.Name</h5>
        <p class="card-text text-white mb-2">
            <small>
                <i class="bi bi-calendar me-1"></i>
                @if (Event.EndDate.HasValue && Event.EndDate.Value.Date != Event.Date.Date)
                {
                    <span>@Event.Date.ToString("dd MMM") - @Event.EndDate.Value.ToString("dd MMM yyyy")</span>
                }
                else
                {
                    <span>@Event.Date.ToString("dd MMM yyyy")</span>
                    @* Show time if it's not midnight (single date with time) *@
                    @if (Event.Date.TimeOfDay != TimeSpan.Zero)
                    {
                        <span>, @Event.Date.ToString("HH:mm")h</span>
                    }
                }
                <DateBadge Date="@Event.Date" />
            </small>
        </p>
        @if (!string.IsNullOrEmpty(Event.Location))
        {
            <p class="card-text text-white mb-2">
                <small>
                    <i class="bi bi-geo-alt me-1"></i> @Event.Location
                </small>
            </p>
        }

        @if (ShowOnlyTrophy)
        {
            <!-- Show only trophy button (for public portal) -->
            @if (Event.Type == EventType.Festival)
            {
                <div class="enrollment-section mt-auto p-2 rounded">
                    <div class="event-buttons-container">
                        <button class="btn event-icon-btn btn-warning" 
                                @onclick="OnViewTrophies" 
                                title="Prémios">
                            <i class="bi bi-trophy-fill"></i>
                        </button>
                    </div>
                </div>
            }
        }
        else if (ShowButtons)
        {
            @if (!IsPastEvent)
            {
                <div class="enrollment-section mt-auto p-2 rounded">
                    @if (Event.IsCancelled)
                    {
                        <!-- For cancelled events, only show View Details button -->
                        <div class="event-buttons-container">
                            <!-- View Details button -->
                            <button class="btn event-icon-btn btn-outline-secondary" 
                                    @onclick="OnViewDetails" 
                                    title="Detalhes">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                    }
                    else
                    {
                        <!-- Event buttons row -->
                        <div class="event-buttons-container mb-2">
                            <!-- View Details button -->
                            <button class="btn event-icon-btn btn-outline-secondary" 
                                    @onclick="OnViewDetails" 
                                    title="Detalhes">
                                <i class="bi bi-eye"></i>
                            </button>

                            <!-- View Enrollments button with centered count -->
                            <button class="btn event-icon-btn event-icon-btn-with-count btn-outline-secondary" 
                                    @onclick="OnViewEnrollments" 
                                    title="Participantes">
                                <i class="bi bi-people"></i>
                                <span class="enrollment-count-centered">@EnrollmentCount</span>
                            </button>

                            <!-- Watch Repertoire button with count -->
                            <button class="btn event-icon-btn event-icon-btn-with-count btn-outline-primary" 
                                    @onclick="OnWatchRepertoire" 
                                    title="Repertório">
                                <i class="bi bi-music-note-list"></i>
                                <span class="enrollment-count-centered">@RepertoireCount</span>
                            </button>

                            <!-- Discussion button with count -->
                            <button class="btn event-icon-btn event-icon-btn-with-count btn-outline-info" 
                                    @onclick="OnViewDiscussion" 
                                    title="Discussão">
                                <i class="bi bi-chat-dots"></i>
                                <span class="enrollment-count-centered">@DiscussionCount</span>
                            </button>
                        </div>

                        <!-- Enrollment action buttons row (simple 2-button toggle) -->
                        <div class="event-buttons-container">
                            <!-- Green "Vou" button - always visible, selected state when WillAttend=true -->
                            <button class="btn event-icon-btn btn-going @(UserEnrollment?.WillAttend == true ? "btn-selected" : (UserEnrollment != null && !UserEnrollment.WillAttend ? "btn-secondary-small" : ""))" 
                                    @onclick="OnEnrollGoing" 
                                    title="Vou participar">
                                <i class="bi bi-check-circle-fill"></i>
                            </button>
                            
                            <!-- Red "Não vou" button - always visible, selected state when WillAttend=false -->
                            <button class="btn event-icon-btn btn-not-going @(UserEnrollment != null && !UserEnrollment.WillAttend ? "btn-selected" : (UserEnrollment?.WillAttend == true ? "btn-secondary-small" : ""))" 
                                    @onclick="OnEnrollNotGoing" 
                                    title="Não vou participar">
                                <i class="bi bi-x-circle-fill"></i>
                            </button>
                        </div>
                    }
                </div>
            }
            else
            {
                <!-- Past event buttons -->
                <div class="enrollment-section mt-auto p-2 rounded">
                    @if (Event.IsCancelled)
                    {
                        <!-- For cancelled past events, only show View Details button -->
                        <div class="event-buttons-container">
                            <!-- View Details button -->
                            <button class="btn event-icon-btn btn-outline-secondary" 
                                    @onclick="OnViewDetails" 
                                    title="Detalhes">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="event-buttons-container">
                            <!-- View Details button -->
                            <button class="btn event-icon-btn btn-outline-secondary" 
                                    @onclick="OnViewDetails" 
                                    title="Detalhes">
                                <i class="bi bi-eye"></i>
                            </button>

                            <!-- View Enrollments button with centered count -->
                            <button class="btn event-icon-btn event-icon-btn-with-count btn-outline-secondary" 
                                    @onclick="OnViewEnrollments" 
                                    title="Participantes">
                                <i class="bi bi-people"></i>
                                <span class="enrollment-count-centered">@EnrollmentCount</span>
                            </button>

                            <!-- Watch Repertoire button with count -->
                            <button class="btn event-icon-btn event-icon-btn-with-count btn-outline-primary" 
                                    @onclick="OnWatchRepertoire" 
                                    title="Repertório">
                                <i class="bi bi-music-note-list"></i>
                                <span class="enrollment-count-centered">@RepertoireCount</span>
                            </button>

                            <!-- Discussion button with count -->
                            <button class="btn event-icon-btn event-icon-btn-with-count btn-outline-info" 
                                    @onclick="OnViewDiscussion" 
                                    title="Discussão">
                                <i class="bi bi-chat-dots"></i>
                                <span class="enrollment-count-centered">@DiscussionCount</span>
                            </button>

                            <!-- Trophy button (for Festival events only) -->
                            @if (ShowTrophy && Event.Type == EventType.Festival)
                            {
                                <button class="btn event-icon-btn btn-warning" 
                                        @onclick="OnViewTrophies" 
                                        title="Prémios">
                                    <i class="bi bi-trophy-fill"></i>
                                </button>
                            }
                        </div>
                        
                        <!-- Enrollment management for past events -->
                        @if (UserEnrollment != null && UserEnrollment.WillAttend)
                        {
                            <div class="event-buttons-container mt-2">
                                <!-- Remove enrollment button for user's own enrollment -->
                                <button class="btn event-icon-btn btn-danger" 
                                        @onclick="OnRemoveEnrollment" 
                                        title="Remover Inscrição">
                                    <i class="bi bi-x-circle-fill"></i>
                                </button>
                            </div>
                        }
                    }
                </div>
            }
        }
    </div>
</div>

@code {
    /// <summary>
    /// The event to display
    /// </summary>
    [Parameter]
    public Event Event { get; set; } = null!;

    /// <summary>
    /// The current user's enrollment for this event (if any)
    /// </summary>
    [Parameter]
    public Enrollment? UserEnrollment { get; set; }

    /// <summary>
    /// Total number of enrollments for this event
    /// </summary>
    [Parameter]
    public int EnrollmentCount { get; set; }

    /// <summary>
    /// Total number of repertoire songs for this event
    /// </summary>
    [Parameter]
    public int RepertoireCount { get; set; }

    /// <summary>
    /// Total number of discussion posts for this event
    /// </summary>
    [Parameter]
    public int DiscussionCount { get; set; }

    /// <summary>
    /// Whether the current user has admin privileges
    /// </summary>
    [Parameter]
    public bool IsAdmin { get; set; }

    /// <summary>
    /// Whether this is a past event (changes display behavior)
    /// </summary>
    [Parameter]
    public bool IsPastEvent { get; set; }

    /// <summary>
    /// Callback when the edit button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnEdit { get; set; }

    /// <summary>
    /// Callback when the delete button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnDelete { get; set; }

    /// <summary>
    /// Callback when the send email button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnSendEmail { get; set; }

    /// <summary>
    /// Callback when the send push notification button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnSendPushNotification { get; set; }
    /// <summary>
    /// Callback when the "Going" enrollment button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnEnrollGoing { get; set; }

    /// <summary>
    /// Callback when the "Not Going" enrollment button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnEnrollNotGoing { get; set; }

    /// <summary>
    /// Callback when the view enrollments button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnViewEnrollments { get; set; }

    /// <summary>
    /// Callback when the edit enrollment button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnEditEnrollment { get; set; }

    /// <summary>
    /// Callback when the remove enrollment button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnRemoveEnrollment { get; set; }

    /// <summary>
    /// Callback when the watch repertoire button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnWatchRepertoire { get; set; }

    /// <summary>
    /// Callback when the view details button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnViewDetails { get; set; }

    /// <summary>
    /// Callback when the view trophies button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnViewTrophies { get; set; }
    
    /// <summary>
    /// Callback when the view discussion button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnViewDiscussion { get; set; }
    
    /// <summary>
    /// Callback when the cancel event button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnCancelEvent { get; set; }
    
    /// <summary>
    /// Callback when the uncancel event button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnUncancelEvent { get; set; }

    /// <summary>
    /// Optional image URL to display (supports cache-busting)
    /// </summary>
    [Parameter]
    public string? ImageUrl { get; set; }

    /// <summary>
    /// Whether to show the trophy button in action section (for past events)
    /// </summary>
    [Parameter]
    public bool ShowTrophy { get; set; }

    /// <summary>
    /// Whether to show trophy corner badge (for AboutUsContent)
    /// </summary>
    [Parameter]
    public bool ShowTrophyCorner { get; set; }

    /// <summary>
    /// Whether to show action buttons (default: true, false for public portal)
    /// </summary>
    [Parameter]
    public bool ShowButtons { get; set; } = true;

    /// <summary>
    /// Whether to show only the trophy button (for public portal with trophies)
    /// </summary>
    [Parameter]
    public bool ShowOnlyTrophy { get; set; }
    
    /// <summary>
    /// Whether to show the delete button (default: true)
    /// Can be set to false for users with restricted permissions (e.g., Caloiro Admins)
    /// </summary>
    [Parameter]
    public bool ShowDeleteButton { get; set; } = true;
    
    /// <summary>
    /// Whether to show the cancel event button (default: true)
    /// Can be set to false for users with restricted permissions (e.g., Caloiro Admins)
    /// </summary>
    [Parameter]
    public bool ShowCancelButton { get; set; } = true;
    
    // Track previous state for ShouldRender optimization
    private int _previousEventId;
    private bool _previousIsCancelled;
    private int _previousEnrollmentCount;
    private int _previousRepertoireCount;
    private int _previousDiscussionCount;
    private bool _previousWillAttend;
    private bool _previousIsAdmin;
    private bool _previousIsPastEvent;
    
    /// <summary>
    /// Optimize rendering - only re-render when key parameters change.
    /// This is especially important for EventCard as it's used in lists with many instances.
    /// </summary>
    protected override bool ShouldRender()
    {
        // Check key parameters that would require a visual update
        var eventId = Event?.Id ?? 0;
        var isCancelled = Event?.IsCancelled ?? false;
        var willAttend = UserEnrollment?.WillAttend ?? false;
        
        if (eventId != _previousEventId ||
            isCancelled != _previousIsCancelled ||
            EnrollmentCount != _previousEnrollmentCount ||
            RepertoireCount != _previousRepertoireCount ||
            DiscussionCount != _previousDiscussionCount ||
            willAttend != _previousWillAttend ||
            IsAdmin != _previousIsAdmin ||
            IsPastEvent != _previousIsPastEvent)
        {
            _previousEventId = eventId;
            _previousIsCancelled = isCancelled;
            _previousEnrollmentCount = EnrollmentCount;
            _previousRepertoireCount = RepertoireCount;
            _previousDiscussionCount = DiscussionCount;
            _previousWillAttend = willAttend;
            _previousIsAdmin = IsAdmin;
            _previousIsPastEvent = IsPastEvent;
            return true;
        }
        return false;
    }
}
