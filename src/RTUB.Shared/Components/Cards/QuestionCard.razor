@namespace RTUB.Shared
@using RTUB.Core.Entities
@using RTUB.Core.Enums
@using RTUB.Core.Helpers
@*
    QuestionCard Component
    Card for displaying question information with reply and action controls
*@

<div class="card question-card h-100">
    <div class="question-card__top position-relative">
        <!-- Author Info -->
        <div class="question-author-section">
            <img src="@(Question.Author.ProfilePictureSrc ?? "")"
                 class="question-author-avatar"
                 alt="@(Question.Author.Nickname ?? Question.Author.UserName ?? "Autor")" />
            <div class="question-author-info">
                <div class="question-author-name">@(Question.Author.Nickname ?? Question.Author.UserName)</div>
            </div>
        </div>

        <!-- Admin Actions (top right) -->
        @if (IsAuthor)
        {
            <div class="admin-overlay">
                @if (Question.Status != QuestionStatus.Closed)
                {
                    <button class="btn btn-sm btn-success" 
                            @onclick="HandleClose" 
                            title="Fechar pergunta">
                        <i class="bi bi-check-lg"></i>
                    </button>
                }
                <button class="btn btn-sm music-btn-delete" @onclick="HandleDelete" title="Eliminar">
                    <i class="bi bi-trash music-icon-delete"></i>
                </button>
            </div>
        }
        
        <!-- Header Section (center) -->
        <div class="question-icon-header">
            <div class="question-icon-circle">
                <i class="bi bi-question-circle"></i>
            </div>
        </div>
    </div>
    
    <div class="card-body d-flex flex-column">
        <!-- Assigned Member Info -->
        @if (Question.AssignedMember != null)
        {
            var receiverGroup = OrgaoSocialHelper.GetGroupForPosition(Question.AssignedPosition);
            var receiverRoleText = receiverGroup.HasValue ? GetRoleDisplayText(receiverGroup.Value, Question.AssignedPosition) : PositionHelper.GetDisplayName(Question.AssignedPosition);
            
            <div class="question-recipient-section mb-2">
                <div class="d-flex align-items-center gap-2">
                    <img src="@(Question.AssignedMember.ProfilePictureSrc ?? "")"
                         class="question-recipient-avatar"
                         alt="@(Question.AssignedMember.Nickname ?? Question.AssignedMember.UserName ?? "Destinatário")" />
                    <div class="question-recipient-info">
                        <div class="question-recipient-name">@(Question.AssignedMember.Nickname ?? Question.AssignedMember.UserName)</div>
                        <div class="question-recipient-role">@receiverRoleText</div>
                    </div>
                </div>
            </div>
        }
        
        <!-- Title -->
        <h5 class="question-title mb-2">@Question.Title</h5>
        
        <!-- Content (truncated) -->
        <p class="question-content mb-2">
            @if (Question.Content.Length > ContentTruncateLength)
            {
                @Question.Content.Substring(0, ContentTruncateLength)<text>...</text>
            }
            else
            {
                @Question.Content
            }
        </p>
        
        <!-- Reply Count and Date -->
        <div class="question-meta mb-3">
            <span class="question-meta-item">
                <i class="bi bi-chat-left-dots"></i>
                @ReplyCount @(ReplyCount == 1 ? "resposta" : "respostas")
            </span>
            <span class="question-meta-item">
                <i class="bi bi-clock"></i>
                @Question.CreatedAt.ToString("dd MMM yyyy")
            </span>
        </div>
        
        <!-- Footer Actions -->
        <div class="question-actions mt-auto">
            <div class="d-flex justify-content-center align-items-center gap-2 flex-wrap mb-2">
                <button class="btn btn-sm btn-primary d-flex align-items-center gap-2"
                        @onclick="HandleReply"
                        title="@(IsAuthor ? "Responder" : "Ver")">
                    <i class="bi @(IsAuthor ? "bi-reply-fill" : "bi-eye")"></i>
                    <span>@(IsAuthor ? "Responder" : "Ver")</span>
                </button>
                @if (IsAuthor && Question.Status != QuestionStatus.Closed)
                {
                    <button class="btn btn-sm btn-light d-flex align-items-center gap-2"
                            @onclick="HandleNotify"
                            title="Enviar lembrete">
                        <i class="bi bi-bell-fill"></i>
                        <span>Notificar</span>
                    </button>
                }
            </div>
            
            <!-- Status Badge (centered) -->
            <div class="d-flex justify-content-center">
                @if (Question.Status == QuestionStatus.Closed)
                {
                    <span class="badge bg-secondary">
                        <i class="bi bi-check-circle-fill"></i> Fechada
                    </span>
                }
                else if (Question.Status == QuestionStatus.Unanswered)
                {
                    <span class="badge bg-warning text-dark">
                        <i class="bi bi-hourglass-split"></i> Aguarda
                    </span>
                }
                else if (Question.Status == QuestionStatus.Answered)
                {
                    <span class="badge bg-success">
                        <i class="bi bi-check-circle"></i> Respondida
                    </span>
                }
                else
                {
                    <span class="badge bg-primary">
                        <i class="bi bi-chat-dots"></i> Em Discussão
                    </span>
                }
            </div>
        </div>
    </div>
</div>

@code {
    /// <summary>
    /// The question to display
    /// </summary>
    [Parameter]
    public Question Question { get; set; } = null!;

    /// <summary>
    /// Number of replies (excluding deleted)
    /// </summary>
    [Parameter]
    public int ReplyCount { get; set; }

    /// <summary>
    /// Maximum content length to display before truncation
    /// </summary>
    [Parameter]
    public int ContentTruncateLength { get; set; } = 120;

    /// <summary>
    /// Whether the current user is the question author
    /// </summary>
    [Parameter]
    public bool IsAuthor { get; set; }

    /// <summary>
    /// Callback when the reply button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnReply { get; set; }

    /// <summary>
    /// Callback when the notify button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnNotify { get; set; }

    /// <summary>
    /// Callback when the close button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>
    /// Callback when the delete button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnDelete { get; set; }

    private async Task HandleReply()
    {
        if (OnReply.HasDelegate)
        {
            await OnReply.InvokeAsync();
        }
    }

    private async Task HandleNotify()
    {
        if (OnNotify.HasDelegate)
        {
            await OnNotify.InvokeAsync();
        }
    }

    private async Task HandleClose()
    {
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    private async Task HandleDelete()
    {
        if (OnDelete.HasDelegate)
        {
            await OnDelete.InvokeAsync();
        }
    }

    private string GetRoleDisplayText(OrgaoSocialGroup group, Position position)
    {
        // Only show "Group - Position" for Direção members, otherwise just show position
        if (group == OrgaoSocialGroup.Direcao)
        {
            return $"{OrgaoSocialHelper.GetDisplayName(group)} - {PositionHelper.GetDisplayName(position)}";
        }
        return PositionHelper.GetDisplayName(position);
    }
}

<style>
    .question-card {
        background-color: #151516;
        border: 1px solid var(--bs-border-color);
        border-radius: 0.5rem;
        overflow: hidden;
        transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .question-card:hover {
        transform: translateY(-3px);
        border-color: rgba(var(--bs-primary-rgb), 0.6);
        box-shadow: 0 4px 12px rgba(var(--bs-primary-rgb), 0.25);
    }

    .question-card__top {
        position: relative;
        z-index: 2;
    }

    .question-author-section {
        position: absolute;
        top: 50%;
        left: 0.75rem;
        transform: translateY(-50%);
        display: flex;
        align-items: center;
        gap: 0.625rem;
    }

    .question-author-avatar {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid var(--bs-primary);
    }

    .question-author-info {
        display: flex;
        flex-direction: column;
    }

    .question-author-name {
        font-weight: 600;
        font-size: 0.95rem;
        color: var(--text-primary);
    }

    .question-icon-header {
        width: 100%;
        height: 120px;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        padding-left: 110px;
        padding-right: 80px;
        background: linear-gradient(135deg, rgba(var(--bs-primary-rgb), 0.15) 0%, rgba(var(--bs-primary-rgb), 0.05) 100%);
        border-bottom: 2px solid rgba(var(--bs-primary-rgb), 0.3);
    }

    .question-icon-circle {
        width: 65px;
        height: 65px;
        border-radius: 50%;
        background-color: rgba(var(--bs-primary-rgb), 0.2);
        border: 2px solid var(--bs-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
    }

    .question-card:hover .question-icon-circle {
        background-color: rgba(var(--bs-primary-rgb), 0.3);
        transform: scale(1.05);
    }

    .question-icon-circle i {
        font-size: 1.875rem;
        color: var(--bs-link-color);
    }

    .question-recipient-section {
        padding: 0.25rem 0;
    }

    .question-recipient-avatar {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        object-fit: cover;
    }

    .question-recipient-info {
        display: flex;
        flex-direction: column;
        gap: 0.125rem;
    }

    .question-recipient-name {
        font-weight: 600;
        font-size: 0.95rem;
        color: var(--text-primary);
    }

    .question-recipient-role {
        font-size: 0.8rem;
        color: var(--text-secondary);
    }

    .question-title {
        color: var(--text-primary);
        font-weight: 600;
        font-size: 1.1rem;
        line-height: 1.3;
    }

    .question-content {
        color: var(--text-secondary);
        font-size: 0.9rem;
        line-height: 1.5;
        overflow: hidden;
        text-overflow: ellipsis;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
    }

    .question-meta {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
        font-size: 0.85rem;
        color: var(--text-secondary);
    }

    .question-meta-item {
        display: flex;
        align-items: center;
        gap: 0.375rem;
    }

    .question-meta-item i {
        color: var(--bs-primary);
        font-size: 0.95rem;
    }

    .question-actions {
        padding-top: 0.75rem;
        border-top: 1px solid rgba(var(--bs-primary-rgb), 0.15);
        margin-top: auto;
    }

    .admin-overlay {
        position: absolute;
        top: 0.5rem;
        right: 0.5rem;
        display: flex;
        gap: 0.375rem;
        z-index: 10;
    }

    .question-card:hover .admin-overlay {
        opacity: 1;
    }

    .admin-overlay .btn {
        min-width: 36px;
        min-height: 36px;
        padding: 0.375rem;
    }

    /* Responsive adjustments */
    @@media (max-width: 576px) {
        .question-title {
            font-size: 1rem;
        }

        .question-content {
            font-size: 0.85rem;
        }

        .question-icon-header {
            height: 100px;
            padding-left: 90px;
            padding-right: 70px;
        }

        .question-icon-circle {
            width: 55px;
            height: 55px;
        }

        .question-icon-circle i {
            font-size: 1.5rem;
        }

        .question-author-avatar {
            width: 54px;
            height: 54px;
        }

        .question-recipient-avatar {
            width: 52px;
            height: 52px;
        }
    }
</style>
