@namespace RTUB.Shared
@using Microsoft.AspNetCore.Components
@*
    ActivityCard Component
    Compact card for displaying activity information with financial summary
*@

<div class="card activity-card h-100">
    <div class="position-relative activity-card__top">
        @if (IsAdmin)
        {
            <div class="activity-card__header-actions">
                <div class="activity-admin-overlay">
                    <button class="btn btn-sm music-btn-edit activity-card__header-button" @onclick="HandleEdit" title="Editar">
                        <i class="bi bi-pencil music-icon-edit"></i>
                    </button>
                    <button class="btn btn-sm music-btn-delete activity-card__header-button" @onclick="HandleDelete" title="Eliminar">
                        <i class="bi bi-trash music-icon-delete"></i>
                    </button>
                </div>
            </div>
        }
        <div class="activity-icon-header">
            <div class="activity-icon-circle">
                <i class="bi bi-calendar-event"></i>
            </div>
        </div>
    </div>
    <div class="card-body d-flex flex-column">
        
        <div class="activity-info">
            <!-- Activity Name -->
            <div class="activity-name-row">
                <h5 class="activity-name">@Activity.Name</h5>
            </div>
            
            <!-- Date -->
            <div class="activity-info-row">
                <i class="bi bi-calendar3 activity-icon"></i>
                <span class="activity-text">@GetActivityDateDisplay()</span>
            </div>
            
            <!-- Balance Badge -->
            <div class="activity-info-row">
                <i class="bi bi-cash-stack activity-icon"></i>
                <span class="badge @(Activity.Balance >= 0 ? "bg-success" : "bg-danger") fs-6 activity-balance-badge">
                    Saldo: €@Activity.Balance.ToString("N2")
                </span>
            </div>
            
            <!-- Financial Summary -->
            <div class="activity-financial-row">
                <div class="financial-item">
                    <span class="financial-label">Receitas:</span>
                    <span class="financial-value text-success">€@Activity.TotalIncome.ToString("N2")</span>
                </div>
                <div class="financial-item">
                    <span class="financial-label">Despesas:</span>
                    <span class="financial-value text-danger">€@Activity.TotalExpenses.ToString("N2")</span>
                </div>
            </div>
            
            @if (!string.IsNullOrEmpty(Activity.Description))
            {
                <div class="activity-description-row">
                    <span class="activity-description-label">Descrição:</span>
                    <span class="activity-description-text">@Activity.Description</span>
                </div>
            }
        </div>

        <!-- Actions section at bottom -->
        <div class="activity-actions-section mt-auto">
            <!-- View Transactions button -->
            <button class="btn btn-sm btn-outline-primary d-flex align-items-center justify-content-center gap-1 w-100" 
                    @onclick="HandleViewTransactions" 
                    title="Ver Transações">
                <i class="bi bi-list-ul icon-size-1rem"></i>
                <span>Ver Transações</span>
            </button>
        </div>
    </div>
</div>

@code {
    /// <summary>
    /// The activity to display
    /// </summary>
    [Parameter]
    [EditorRequired]
    public Activity Activity { get; set; } = null!;

    /// <summary>
    /// Whether the current user has admin privileges
    /// </summary>
    [Parameter]
    public bool IsAdmin { get; set; }

    /// <summary>
    /// Callback when the edit button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnEdit { get; set; }

    /// <summary>
    /// Callback when the delete button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnDelete { get; set; }

    /// <summary>
    /// Callback when the view transactions button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnViewTransactions { get; set; }

    protected override void OnParametersSet()
    {
        if (Activity == null)
        {
            throw new ArgumentNullException(nameof(Activity), "Activity parameter is required.");
        }
    }

    // Handler methods to ensure events fire properly
    private async Task HandleEdit()
    {
        if (OnEdit.HasDelegate)
        {
            await OnEdit.InvokeAsync();
        }
    }

    private async Task HandleDelete()
    {
        if (OnDelete.HasDelegate)
        {
            await OnDelete.InvokeAsync();
        }
    }

    private async Task HandleViewTransactions()
    {
        if (OnViewTransactions.HasDelegate)
        {
            await OnViewTransactions.InvokeAsync();
        }
    }

    // Helper method to format activity date display
    private string GetActivityDateDisplay()
    {
        var endDate = Activity.EndDate;
        if (endDate.HasValue)
        {
            return $"{Activity.StartDate:dd MMM yyyy} - {endDate.Value:dd MMM yyyy}";
        }
        return Activity.StartDate.ToString("dd MMM yyyy");
    }
    
    // Track previous state for ShouldRender optimization
    private int _previousActivityId;
    private string? _previousName;
    private string? _previousDescription;
    private DateTime _previousStartDate;
    private DateTime? _previousEndDate;
    private decimal _previousBalance;
    private decimal _previousTotalIncome;
    private decimal _previousTotalExpenses;
    private bool _previousIsAdmin;
    
    /// <summary>
    /// Optimize rendering - only re-render when key parameters change.
    /// This is especially important for ActivityCard as it's used in lists.
    /// </summary>
    protected override bool ShouldRender()
    {
        // Always render if Activity is null (shouldn't happen due to validation)
        if (Activity == null)
        {
            return true;
        }
        
        var activityId = Activity.Id;
        var name = Activity.Name;
        var description = Activity.Description;
        var startDate = Activity.StartDate;
        var endDate = Activity.EndDate;
        var balance = Activity.Balance;
        var totalIncome = Activity.TotalIncome;
        var totalExpenses = Activity.TotalExpenses;
        
        if (activityId != _previousActivityId ||
            name != _previousName ||
            description != _previousDescription ||
            startDate != _previousStartDate ||
            endDate != _previousEndDate ||
            balance != _previousBalance ||
            totalIncome != _previousTotalIncome ||
            totalExpenses != _previousTotalExpenses ||
            IsAdmin != _previousIsAdmin)
        {
            _previousActivityId = activityId;
            _previousName = name;
            _previousDescription = description;
            _previousStartDate = startDate;
            _previousEndDate = endDate;
            _previousBalance = balance;
            _previousTotalIncome = totalIncome;
            _previousTotalExpenses = totalExpenses;
            _previousIsAdmin = IsAdmin;
            return true;
        }
        return false;
    }
}
