{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": false,
    "sourceMap": true,
    "outDir": "../wwwroot/js",
    "rootDir": ".",
    "types": ["pixi.js"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "vite.config.ts"
  ]
}
