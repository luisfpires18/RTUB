@model RTUB.Web.EmailTemplates.Models.EventReminderNotificationModel
@using RTUB.Application.Utilities
@{
    Layout = "~/EmailTemplates/_EmailLayout.cshtml";
    ViewData["Preheader"] = "Lembrete: a atuação aproxima-se. Confirma a tua presença.";
    ViewData["PreferencesLink"] = Model.PreferencesLink;
}

@{
    var displayName = !string.IsNullOrEmpty(Model.FullName) 
        ? $"{Model.Nickname} ({Model.FullName})" 
        : Model.Nickname;
    
    var daysText = Model.DaysUntilEvent switch
    {
        0 => "é hoje!",
        1 => "é já amanhã!",
        _ => $"faltam {Model.DaysUntilEvent} dias!"
    };
    
    // Format date with range using DateFormatHelper
    var formattedDate = DateFormatHelper.FormatEventDateRangeForEmail(Model.StartDate, Model.EndDate);
}

<h1 style="margin: 0 0 16px 0; padding: 0; font-size: 28px; line-height: 1.3; font-weight: 600; color: #0B0B0F;">
    Lembrete de Atuação
</h1>

<p style="margin: 0 0 16px 0; font-size: 16px; line-height: 1.5; color: #333333;">
    <text>Olá, @Html.Raw(displayName)!</text>
</p>

<p style="margin: 0 0 16px 0; font-size: 16px; line-height: 1.5; color: #333333;">
    A atuação <strong>@Html.Raw(Model.EventTitle)</strong> está para breve e @Html.Raw(daysText)!
</p>

<!-- Event Details -->
<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" class="event-meta" style="background-color: #F7F7FB; padding: 16px 24px; border-radius: 8px; margin: 16px 0;">
    <tr>
        <td>
            <p class="event-meta-item" style="font-size: 16px; line-height: 1.6; color: #333333; margin: 4px 0;">
                <span class="emoji-icon" style="display: inline-block; margin-right: 8px;">📅</span>
                <strong>@Html.Raw(formattedDate)</strong>
            </p>
            <p class="event-meta-item" style="font-size: 16px; line-height: 1.6; color: #333333; margin: 4px 0;">
                <span class="emoji-icon" style="display: inline-block; margin-right: 8px;">📍</span>
                @Html.Raw(Model.EventLocation)
            </p>
        </td>
    </tr>
</table>

@if (!string.IsNullOrEmpty(Model.EventDescription))
{
    <p style="margin: 16px 0; font-size: 16px; line-height: 1.5; color: #333333;">
        @Html.Raw(Model.EventDescription)
    </p>
}

@if (Model.Participants?.Any() == true)
{
    var orderedParticipants = Model.Participants
        .OrderBy(p =>
        {
            var cat = p.Category?.ToUpperInvariant();

            return cat == "TUNO" ? 0
                 : cat == "CALOIRO" ? 1
                 : cat == "LEITAO" ? 2
                 : 3;
        });

    <div style="margin: 24px 0 16px 0;">
        <h3 style="margin: 0 0 12px 0; padding: 0; font-size: 18px; line-height: 1.3; font-weight: 600; color: #0B0B0F;">
            Já contamos com os seguintes participantes:
        </h3>

        <ul style="margin: 0; padding: 0; list-style: none;">
            @foreach (var participant in orderedParticipants)
            {
                <li style="margin: 0 0 8px 0; padding: 8px 0; font-size: 15px; line-height: 1.5; color: #333333; border-bottom: 1px solid #E5E5E7;">
                    <strong>@participant.DisplayName</strong> – @participant.Category
                </li>
            }
        </ul>
    </div>
}

@if (Model.RepertoireSongs?.Any() == true)
{
    var songsByDate = Model.RepertoireSongs
        .GroupBy(s => s.RepertoireDate.Date)
        .OrderBy(g => g.Key)
        .ToList();
    
    var hasMultipleDates = songsByDate.Count > 1;

    <div style="margin: 24px 0 16px 0;">
        <h3 style="margin: 0 0 12px 0; padding: 0; font-size: 18px; line-height: 1.3; font-weight: 600; color: #0B0B0F;">
            Repertório:
        </h3>

        @foreach (var dateGroup in songsByDate)
        {
            var repertoireDate = dateGroup.Key.ToString("dd/MM/yyyy");
            
            <div style="margin: 0 0 16px 0;">
                @if (hasMultipleDates)
                {
                    <h4 style="margin: 0 0 8px 0; padding: 0; font-size: 16px; line-height: 1.3; font-weight: 600; color: #6E56CF;">
                        @repertoireDate
                    </h4>
                }
                
                <ul style="margin: 0; padding: 0; list-style: none;">
                    @foreach (var song in dateGroup.OrderBy(s => s.Title))
                    {
                        <li style="margin: 0 0 6px 0; padding: 6px 0; font-size: 15px; line-height: 1.5; color: #333333; border-bottom: 1px solid #E5E5E7;">
                            <strong>@song.Title</strong>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>
}

<!-- Reminder Points -->
<div style="background-color: #FFF9E6; border-left: 4px solid #F59E0B; padding: 16px; margin: 24px 0; border-radius: 4px;">
    <h3 style="margin: 0 0 12px 0; font-size: 18px; color: #92400E; font-weight: 600;">
        Pontos Importantes:
    </h3>
    <ul style="margin: 0; padding-left: 20px; color: #92400E;">
        <li style="margin-bottom: 8px;">
            <strong>Confirma a tua presença</strong> se ainda não o fizeste. É importante para a organização saber quem vai participar!
        </li>
        <li style="margin-bottom: 8px;">
            Consulta a <strong>secção de publicações</strong> para organizar veículos e logística da deslocação.
        </li>
        <li style="margin-bottom: 0;">
            Não te esqueças de indicar se vais ou não, a tua resposta é fundamental para o sucesso da atuação!
        </li>
    </ul>
</div>

@if (Model.Participants != null && Model.Participants.Any())
{
    <p style="margin: 0 0 16px 0; font-size: 16px; line-height: 1.5; color: #333333; font-style: italic;">
        Junta-te a nós para termos mais histórias para contar.
    </p>
}

<!-- Primary CTA Button -->
@await Html.PartialAsync("~/EmailTemplates/Partials/_Button.cshtml", new RTUB.Web.EmailTemplates.Models.ButtonModel
{
    Href = Model.EventLink,
    Label = "Confirmar presença",
    BgColor = "#6E56CF",
    TextColor = "#FFFFFF"
})
