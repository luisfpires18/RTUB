@code {
    private ApplicationUser? currentUser;
    private string? _lastLocation;
    private System.Threading.Timer? _debounceTimer;
    private AuthenticationState? _cachedAuthState;
    private bool _shouldShowGestaoDropdown;
    private bool _showBeVisibleToAdminOnly;
    private bool _showBeVisibleToModAdminAndTunoOnly;
    private string? _previousUserNickname;
    private string? _previousAvatarUrl;
    
    /// <summary>
    /// Optimize rendering - only re-render when user data or dropdowns change
    /// </summary>
    protected override bool ShouldRender()
    {
        if (currentUser == null)
        {
            return _previousUserNickname != null; // Render if we had a user before
        }
        
        var currentNickname = currentUser.Nickname;
        var currentAvatar = currentUser.ProfilePictureSrc;
        
        if (currentNickname != _previousUserNickname || currentAvatar != _previousAvatarUrl)
        {
            _previousUserNickname = currentNickname;
            _previousAvatarUrl = currentAvatar;
            return true;
        }
        
        return false;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrentUser();

        // Subscribe to profile picture updates
        ProfilePictureUpdateService.OnProfilePictureUpdated += HandleProfilePictureUpdated;

        // Subscribe to location changes
        NavigationManager.LocationChanged += HandleLocationChanged;
        _lastLocation = NavigationManager.Uri;
    }



    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // Debounce to avoid double fires
        _debounceTimer?.Dispose();

        _debounceTimer = new System.Threading.Timer(_ =>
        {
            try
            {
                var newLocation = e.Location;

                // Check if we have a valid previous location
                if (string.IsNullOrEmpty(_lastLocation))
                {
                    _lastLocation = newLocation;
                    return;
                }

                var oldUri = new Uri(_lastLocation);
                var newUri = new Uri(newLocation);

                // Check if it's a hash change only (same path)
                bool isHashChangeOnly = oldUri.GetLeftPart(UriPartial.Path) == newUri.GetLeftPart(UriPartial.Path);

                // OPTIMIZATION: Only reload user when navigating away from profile page (avatar may have changed)
                // This prevents unnecessary DB queries on every navigation
                if (_lastLocation.Contains("/profile", StringComparison.OrdinalIgnoreCase) && 
                    !newLocation.Contains("/profile", StringComparison.OrdinalIgnoreCase))
                {
                    _ = InvokeAsync(async () =>
                    {
                        await LoadCurrentUser();
                        StateHasChanged();
                    });
                }

                _lastLocation = newLocation;
            }
            catch
            {
                // Ignore errors during navigation or disposal
            }
        }, null, 50, Timeout.Infinite);
    }

    private async Task LoadCurrentUser()
    {
        _cachedAuthState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var claimsPrincipal = _cachedAuthState.User;

        if (claimsPrincipal?.Identity?.IsAuthenticated == true)
        {
            // Try multiple ways to get the user identifier
            var userName = claimsPrincipal.Identity.Name;
            var nameIdentifierClaim = claimsPrincipal.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            var nameClaim = claimsPrincipal.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value;

            ApplicationUser? user = null;

            // Try to find by username first
            if (!string.IsNullOrEmpty(userName))
            {
                user = await UserManager.FindByNameAsync(userName);
            }

            // Try by name claim
            if (user == null && !string.IsNullOrEmpty(nameClaim))
            {
                user = await UserManager.FindByNameAsync(nameClaim);
                if (user == null)
                {
                    user = await UserManager.FindByEmailAsync(nameClaim);
                }
            }

            // Try by user ID from NameIdentifier claim
            if (user == null && !string.IsNullOrEmpty(nameIdentifierClaim))
            {
                user = await UserManager.FindByIdAsync(nameIdentifierClaim);
            }

            // Reload the user to ensure we have the latest data from database
            if (user != null)
            {
                // Force Entity Framework to reload from database instead of using cached data
                var entry = UserManager.Users.AsNoTracking().FirstOrDefault(u => u.Id == user.Id);
                currentUser = entry ?? user;
            }
        }
        
        // Update authorization flags after loading user
        await UpdateAuthorizationFlags();
    }
    
    private async Task EnsureCachedAuthStateAsync()
    {
        if (_cachedAuthState == null)
        {
            _cachedAuthState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        }
    }
    
    private async Task UpdateAuthorizationFlags()
    {
        await EnsureCachedAuthStateAsync();
        
        // Execute authorization checks concurrently for better performance
        var tasks = Task.WhenAll(
            ShouldShowGestaoDropdown(),
            ShowBeVisibleToAdminOnly(),
            ShowBeVisibleToModAdminAndTunoOnly()
        );
        
        var results = await tasks;
        _shouldShowGestaoDropdown = results[0];
        _showBeVisibleToAdminOnly = results[1];
        _showBeVisibleToModAdminAndTunoOnly = results[2];
    }

    // Routes behind each navigation menu. The menu's toggle is marked active while one of them
    // is the current page, so the section stays visible when its menu is closed. Presentation
    // only: which menus and items a user sees is still decided by the conditions in the markup.
    private static readonly string[] MembersGroup = { "/members", "/member/map", "/hierarchy", "/roles", "/hall-of-fame" };
    private static readonly string[] GamesGroup = { "/my-tuno", "/games", "/bets" };
    private static readonly string[] InventoryGroup = { "/inventory", "/shop" };
    private static readonly string[] ManagementGroup = { "/meetings", "/documentation", "/logistics", "/finance", "/mbway", "/nerba", "/requests", "/questions" };
    private static readonly string[] OperationsGroup = { "/emails", "/notifications", "/images", "/labels", "/users", "/owner" };

    private string GroupClass(string[] routes)
    {
        var path = "/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('?', '#')[0];
        return routes.Any(route => path.Equals(route, StringComparison.OrdinalIgnoreCase)
                                   || path.StartsWith(route + "/", StringComparison.OrdinalIgnoreCase))
            ? "active"
            : string.Empty;
    }

    private string GetNavbarAvatarUrl()
    {
        if (currentUser == null) return "/images/default-avatar.webp";
        return currentUser.ProfilePictureSrc ?? "/images/default-avatar.webp";
    }

    private void HandleProfilePictureUpdated()
    {
        // Reload user data when profile picture is updated
        _ = InvokeAsync(async () =>
        {
            await LoadCurrentUser();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;
        ProfilePictureUpdateService.OnProfilePictureUpdated -= HandleProfilePictureUpdated;
        _debounceTimer?.Dispose();
    }

    /// <summary>
    /// Determines if the "Gestão" dropdown should be shown to the current user.
    /// Visibility rules:
    /// - LEITÃO: HIDE (always)
    /// - CALOIRO + MEMBER: HIDE
    /// - CALOIRO + ADMIN: SHOW
    /// - CALOIRO + MOD: SHOW
    /// - TUNO + any role: SHOW
    /// - Admin: SHOW (always)
    /// - Mod: SHOW (always)
    /// - Owner: SHOW (always)
    /// </summary>
    private async Task<bool> ShouldShowGestaoDropdown()
    {
        if (currentUser == null)
        {
            return false;
        }

        await EnsureCachedAuthStateAsync();
        var user = _cachedAuthState!.User;

        // Admin / Owner / Mod always see it
        if (user.IsInRole("Admin") || user.IsInRole("Owner") || user.IsInRole("Mod"))
        {
            return true;
        }

        // Everyone else except Leitão sees it
        return !currentUser.IsLeitao();
    }


    /// <summary>
    /// Determines if the "Images" menu item should be shown.
    /// Shown to: Admin and Owner.
    /// </summary>
    private async Task<bool> ShowBeVisibleToAdminOnly()
    {
        if (currentUser == null) return false;

        await EnsureCachedAuthStateAsync();
        var isAdmin = _cachedAuthState!.User.IsInRole("Admin");
        
        return isAdmin;
    }

    /// <summary>
    /// Determines if the "Images" menu item should be shown.
    /// Shown to: Admin and Owner.
    /// </summary>
    private async Task<bool> ShowBeVisibleToModAdminAndTunoOnly()
    {
        if (currentUser == null) return false;
        
        await EnsureCachedAuthStateAsync();
        var user = _cachedAuthState!.User;
        var isTuno = currentUser.IsTuno();
        var isMod = _cachedAuthState.User.IsInRole("Mod");
        var isAdmin = _cachedAuthState.User.IsInRole("Admin");
        
        return isAdmin || isMod || isTuno;
    }
}
