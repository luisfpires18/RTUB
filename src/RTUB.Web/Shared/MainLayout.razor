@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using RTUB.Application.Data
@using RTUB.Application.Helpers
@using RTUB.Application.Extensions
@using RTUB.Core.Entities
@using RTUB.Components
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject RTUB.Web.Services.ProfilePictureUpdateService ProfilePictureUpdateService
@implements IDisposable

@* Fallback title for a route that sets none; every page sets its own through AppTitle. *@
<AppTitle />

@* First focusable element of every page (UI refactor 034). Hidden until focused; navOffcanvas.js
   moves focus to <main>, because a bare "#content" resolves against <base href="/"> and would
   leave the page. *@
<a class="skip-link" href="#content">Saltar para o conteúdo</a>

@* App shell (UI refactor 034, contract: docs/design/RTUB_UI_REFACTOR.md section 21).
   >= 1200px (xl): brand, horizontal navigation, account menu.
   <  1200px: brand, account menu and a menu button that opens the navigation drawer - the same
   breakpoint at which pages switch their header actions for MobileBottomNav. *@
<header class="navbar navbar-expand-xl navbar-dark navbar-main">
    <div class="container-xxl rtub-wide px-xxl-4 navbar-main__inner">
        <a class="navbar-brand" href="/">RTUB</a>

        <div class="offcanvas offcanvas-end offcanvas-xl" tabindex="-1" id="topNav" aria-labelledby="topNavLabel">
            <div class="offcanvas-header d-xl-none">
                <h2 class="offcanvas-title" id="topNavLabel">Navegação</h2>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Fechar menu"></button>
            </div>
            <div class="offcanvas-body">
            <nav class="navbar-main__nav" aria-label="Principal">
            <ul class="navbar-nav">

                <!-- 1. Música (Public / Member) -->
                <li class="nav-item"><NavLink class="nav-link" href="/music"><i class="bi bi-music-note-beamed" aria-hidden="true"></i> Música</NavLink></li>

                <!-- 2. Pedidos (Public only) -->
                <AuthorizeView>
                    <NotAuthorized>
                        <li class="nav-item"><NavLink class="nav-link" href="/request"><i class="bi bi-envelope" aria-hidden="true"></i> Pedidos</NavLink></li>
                    </NotAuthorized>
                </AuthorizeView>

                <!-- 3. Atuações (Public / Member) -->
                <li class="nav-item"><NavLink class="nav-link" href="/events"><i class="bi bi-calendar-event" aria-hidden="true"></i> Atuações</NavLink></li>

                <AuthorizeView Context="mainAuthContext">
                    <Authorized>
                        <!-- 4. Ensaios (Member) -->
                        <li class="nav-item"><NavLink class="nav-link" href="/rehearsals"><i class="bi bi-music-note-list" aria-hidden="true"></i> Ensaios</NavLink></li>
                        <!-- 5. Naipes (Member) -->
                        <li class="nav-item"><NavLink class="nav-link" href="/naipes"><i class="bi bi-music-player" aria-hidden="true"></i> Naipes</NavLink></li>
                    </Authorized>
                </AuthorizeView>

                <!-- 7. Órgãos Sociais (Public only) -->
                <AuthorizeView>
                    <NotAuthorized>
                        <li class="nav-item"><NavLink class="nav-link" href="/roles"><i class="bi bi-bank" aria-hidden="true"></i> Órgãos Sociais</NavLink></li>
                    </NotAuthorized>
                </AuthorizeView>

                <AuthorizeView Context="mainAuthContext2">
                    <Authorized>

                        <!-- 5. Membros (Member Dropdown) -->
                        <li class="nav-item dropdown">
                            <button class="nav-link dropdown-toggle @GroupClass(MembersGroup)" type="button" id="membersDropdown" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                                <i class="bi bi-people" aria-hidden="true"></i> Membros
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="membersDropdown">
                                <li><NavLink class="dropdown-item" href="/members"><i class="bi bi-people" aria-hidden="true"></i> Membros</NavLink></li>
                                <li><NavLink class="dropdown-item" href="/hierarchy"><i class="bi bi-diagram-3" aria-hidden="true"></i> Hierarquia</NavLink></li>
                                <li><NavLink class="dropdown-item" href="/roles"><i class="bi bi-bank" aria-hidden="true"></i> Órgãos Sociais</NavLink></li>
                                <li><NavLink class="dropdown-item" href="/hall-of-fame"><i class="bi bi-trophy" aria-hidden="true"></i> Hall of Fame</NavLink></li>
                            </ul>
                        </li>

                        <!-- 6. Classificação (Member) -->
                        <li class="nav-item"><NavLink class="nav-link" href="/leaderboard"><i class="bi bi-trophy-fill" aria-hidden="true"></i> Classificação</NavLink></li>

                        <!-- 6.5 Jogos (Member Dropdown) -->
                        <li class="nav-item dropdown">
                            <button class="nav-link dropdown-toggle @GroupClass(GamesGroup)" type="button" id="gamesDropdown" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                                <i class="bi bi-controller" aria-hidden="true"></i> Jogos
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="gamesDropdown">
                                <li><NavLink class="dropdown-item" href="/my-tuno"><i class="bi bi-joystick" aria-hidden="true"></i> My Tuno</NavLink></li>
                                <li><NavLink class="dropdown-item" href="/games"><i class="bi bi-controller" aria-hidden="true"></i> Mini Jogos</NavLink></li>
                                <li><NavLink class="dropdown-item" href="/bets"><i class="bi bi-cash-coin" aria-hidden="true"></i> Apostas</NavLink></li>
                            </ul>
                        </li>

                    </Authorized>
                </AuthorizeView>

                <!-- 6.5 Galeria (Public / Member) -->
                <li class="nav-item"><NavLink class="nav-link" href="/gallery"><i class="bi bi-images" aria-hidden="true"></i> Galeria</NavLink></li>

                <AuthorizeView Context="mainAuthContext3">
                    <Authorized>

                        <!-- 7. Inventário (Member Dropdown) -->
                        <li class="nav-item dropdown">
                            <button class="nav-link dropdown-toggle @GroupClass(InventoryGroup)" type="button" id="inventoryDropdown" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                                <i class="bi bi-box-seam" aria-hidden="true"></i> Inventário
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="inventoryDropdown">
                                <li><NavLink class="dropdown-item" href="/inventory"><i class="bi bi-music-note" aria-hidden="true"></i> Instrumentos</NavLink></li>
                                <li><NavLink class="dropdown-item" href="/shop"><i class="bi bi-bag" aria-hidden="true"></i> Loja</NavLink></li>
                            </ul>
                        </li>

                        <!-- 8. Gestão (Member Dropdown) -->
                        @if (_shouldShowGestaoDropdown)
                        {
                            <li class="nav-item dropdown">
                                <button class="nav-link dropdown-toggle @GroupClass(ManagementGroup)" type="button" id="managementDropdown" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                                    <i class="bi bi-gear-fill" aria-hidden="true"></i> Gestão
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="managementDropdown">
                                    <li><NavLink class="dropdown-item" href="/meetings"><i class="bi bi-calendar3" aria-hidden="true"></i> Reuniões</NavLink></li>
                                    <li><NavLink class="dropdown-item" href="/documentation"><i class="bi bi-file-earmark-text" aria-hidden="true"></i> Documentação</NavLink></li>
                                    @if (_showBeVisibleToModAdminAndTunoOnly)
                                    {
                                        <li><NavLink class="dropdown-item" href="/logistics"><i class="bi bi-kanban" aria-hidden="true"></i> Logística</NavLink></li>
                                        <li><NavLink class="dropdown-item" href="/finance"><i class="bi bi-cash-stack" aria-hidden="true"></i> Tesouraria</NavLink></li>
                                    }

                                    @if (_showBeVisibleToAdminOnly)
                                    {
                                        <li><NavLink class="dropdown-item" href="/requests"><i class="bi bi-envelope" aria-hidden="true"></i> Pedidos</NavLink></li>
                                    }
                                    <li><NavLink class="dropdown-item" href="/questions"><i class="bi bi-question-circle" aria-hidden="true"></i> Perguntas</NavLink></li>
                                </ul>
                            </li>
                        }
                    </Authorized>
                </AuthorizeView>

                @if (_showBeVisibleToAdminOnly)
                {
                <AuthorizeView Roles="Admin">
                    <Authorized Context="adminOwnerAuth">
                        <li class="nav-item dropdown">
                            <button class="nav-link dropdown-toggle @GroupClass(OperationsGroup)" type="button" id="ownerDropdown"
                                    data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                                <i class="bi bi-tools" aria-hidden="true"></i> Operações
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="ownerDropdown">
                                <li><NavLink class="dropdown-item" href="/emails"><i class="bi bi-envelope" aria-hidden="true"></i> Email</NavLink></li>
                                <li><NavLink class="dropdown-item" href="/notifications"><i class="bi bi-bell" aria-hidden="true"></i> Notificações</NavLink></li>
                                <li><NavLink class="dropdown-item" href="/images"><i class="bi bi-images" aria-hidden="true"></i> Imagens</NavLink></li>
                                <li><NavLink class="dropdown-item" href="/labels"><i class="bi bi-tag" aria-hidden="true"></i> Conteúdo</NavLink></li>

                                <AuthorizeView Roles="Owner">
                                    <Authorized Context="ownerAuth">
                                        <li><hr class="dropdown-divider" /></li>
                                        <li><NavLink class="dropdown-item" href="/users"><i class="bi bi-people" aria-hidden="true"></i> Funções</NavLink></li>
                                        <li><NavLink class="dropdown-item" href="/owner/tracing"><i class="bi bi-shield-check" aria-hidden="true"></i> Tracing</NavLink></li>
                                        <li><NavLink class="dropdown-item" href="/owner/db"><i class="bi bi-database" aria-hidden="true"></i> Database</NavLink></li>
                                    </Authorized>
                                </AuthorizeView>
                            </ul>
                        </li>
                    </Authorized>
                </AuthorizeView>
                }
            </ul>
            </nav>
            </div>
        </div>

        @* Account: outside the drawer, so it stays one tap away on phones. *@
        <AuthorizeView>
            <Authorized>
                <div class="dropdown navbar-account">
                    <button class="navbar-account__toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <img src="@GetNavbarAvatarUrl()"
                             alt=""
                             class="navbar-avatar"
                             data-avatar-fallback />
                        <span class="visually-hidden">Conta de @(currentUser?.Nickname ?? "utilizador")</span>
                        <UnreadMessagesBadge CssClass="navbar-message-badge" />
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end navbar-account__menu">
                        @if (currentUser != null)
                        {
                            <li class="navbar-account__header">
                                <span class="navbar-account__name">@currentUser.Nickname</span>
                                @if (currentUser.IsLeitao())
                                {
                                    <CategoryBadge Category="MemberCategory.Leitao" />
                                }
                                else if (currentUser.IsCaloiro())
                                {
                                    <CategoryBadge Category="MemberCategory.Caloiro" />
                                }
                                else if (currentUser.IsTuno())
                                {
                                    if (currentUser.Positions.Contains(Position.Magister))
                                    {
                                        <PositionBadge Position="Position.Magister" />
                                    }
                                    else
                                    {
                                        <CategoryBadge Category="MemberCategory.Tuno" />
                                    }
                                }
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                        }
                        <li>
                            <NavLink class="dropdown-item" href="/profile">
                                <i class="bi bi-person-circle" aria-hidden="true"></i>
                                <span>Meu Perfil</span>
                            </NavLink>
                        </li>
                        <li>
                            <NavLink class="dropdown-item" href="/messages">
                                <i class="bi bi-chat-dots" aria-hidden="true"></i>
                                <span>Mensagens</span>
                                <UnreadMessagesBadge CssClass="ms-auto" />
                            </NavLink>
                        </li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <form method="post" action="/auth/logout" @formname="LogoutForm" class="logout-form">
                                <AntiforgeryToken />
                                <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right" aria-hidden="true"></i> Sair</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </Authorized>
            <NotAuthorized>
                <a class="btn btn-primary navbar-login" href="/login">Entrar</a>
            </NotAuthorized>
        </AuthorizeView>

        <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#topNav" aria-controls="topNav" aria-expanded="false" aria-label="Abrir menu de navegação">
            <i class="bi bi-list" aria-hidden="true"></i>
        </button>
    </div>
</header>

