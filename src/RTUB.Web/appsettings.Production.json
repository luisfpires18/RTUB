{
  "UseSqlServer": false,
  "Toggles": {
    "MapEnabled": true
  },
  "ImageCaching": {
    "CacheDurationInSeconds": 86400
  },
  "DatabaseBackup": {
    "Enabled": true,
    "ScheduledTime": "03:30"
  },
  "LoginPopup": {
    "Enabled": true,
    "ReadOnce": true,
    "Version": "v1.1",
    "Title": "RTUB App",
    "Description": "A guitarra e o bandolim CHEGARAM! Só demoraram 83 dias (11 semanas). Parabéns.",
    "ButtonText": "Incrível"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
