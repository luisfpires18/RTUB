@using Microsoft.AspNetCore.Components.Authorization
@using RTUB.Components
@namespace RTUB

<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    @* Viewport optimized for mobile PWA - prevents auto-zoom on inputs with 16px font-size *@
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes" />
    <base href="/" />
    @* PWA manifest must be in static HTML for Android/Chrome detection *@
    <link rel="manifest" href="/manifest.webmanifest" />
    @* Apple touch icon for iOS (can be dynamic, but included here for consistency) *@
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/rtub-logo-180.png" type="image/png" />
    @* Apple web app title for iOS home screen *@
    <meta name="apple-mobile-web-app-title" content="RTUB" />
    @* Mobile optimizations *@
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="format-detection" content="telephone=no" />
    @* Preconnect for performance *@
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    @* HeadOutlet allows MainLayout to inject additional head content dynamically *@
    <HeadOutlet />
</head>
<body>
    <CascadingAuthenticationState>
        <Router AppAssembly="@typeof(Program).Assembly">
            <Found Context="routeData">
                <AuthorizeRouteView RouteData="routeData" DefaultLayout="@typeof(RTUB.Shared.MainLayout)">
                    <NotAuthorized>
                        @if (context.User.Identity?.IsAuthenticated != true)
                        {
                            <RedirectToLogin />
                        }
                        else
                        {
                            <LayoutView Layout="@typeof(RTUB.Shared.MainLayout)">
                                <p role="alert">You are not authorized to access this resource.</p>
                            </LayoutView>
                        }
                    </NotAuthorized>
                </AuthorizeRouteView>
                <FocusOnNavigate RouteData="routeData" Selector="h1" />
            </Found>
            <NotFound>
                <LayoutView Layout="@typeof(RTUB.Shared.MainLayout)">
                    <p role="alert">Sorry, there's nothing at this address.</p>
                </LayoutView>
            </NotFound>
        </Router>
    </CascadingAuthenticationState>
    
    @* .NET 10 Blazor reconnection UI - automatically shows/hides based on circuit state *@
    <ReconnectModal />
</body>
</html>