@using Microsoft.AspNetCore.Components.Authorization
@using RTUB.Components
@namespace RTUB

<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    @* Viewport optimized for mobile PWA - prevents auto-zoom on inputs with 16px font-size.
       viewport-fit=cover makes iOS report env(safe-area-inset-*): with the black-translucent
       status bar below, the installed app draws under the status bar, and the shell pads its
       header, drawer, footer and bottom bars by those insets (UI refactor 034). *@
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes, viewport-fit=cover" />
    <base href="/" />
    @* PWA manifest must be in static HTML for Android/Chrome detection *@
    <link rel="manifest" href="/manifest.webmanifest" />
    @* Apple touch icon for iOS (can be dynamic, but included here for consistency) *@
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/rtub-logo-180.png" type="image/png" />
    @* Apple web app title for iOS home screen *@
    <meta name="apple-mobile-web-app-title" content="RTUB" />
    @* Mobile optimizations *@
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="format-detection" content="telephone=no" />
    @* Avatar fallback listener. Loaded from <head> so it is attached before any
       avatar <img> is parsed - it replaces per-element inline onerror handlers. *@
    <VersionedAsset Path="/js/avatarFallback.js" Type="VersionedAsset.AssetType.Js" />
    @* Service worker registration lives in /js/sw-register.js, loaded from MainLayout.
       There is deliberately none here: registering the same script under the same scope
       twice is idempotent, so the head copy only duplicated work. *@
    @* HeadOutlet allows MainLayout to inject additional head content dynamically *@
    <HeadOutlet />
</head>
<body>
    <CascadingAuthenticationState>
        <Router AppAssembly="@typeof(Program).Assembly">
            <Found Context="routeData">
                <AuthorizeRouteView RouteData="routeData" DefaultLayout="@typeof(RTUB.Shared.MainLayout)">
                    <NotAuthorized>
                        @if (context.User.Identity?.IsAuthenticated != true)
                        {
                            <RedirectToLogin />
                        }
                        else
                        {
                            <LayoutView Layout="@typeof(RTUB.Shared.MainLayout)">
                                <AppTitle>Sem permissão</AppTitle>
                                <p role="alert">Não tens permissão para aceder a esta página.</p>
                            </LayoutView>
                        }
                    </NotAuthorized>
                </AuthorizeRouteView>
                <FocusOnNavigate RouteData="routeData" Selector="h1" />
            </Found>
            <NotFound>
                <LayoutView Layout="@typeof(RTUB.Shared.MainLayout)">
                    <AppTitle>Página não encontrada</AppTitle>
                    <p role="alert">Não existe nenhuma página neste endereço.</p>
                </LayoutView>
            </NotFound>
        </Router>
    </CascadingAuthenticationState>
    
    @* .NET 10 Blazor reconnection UI - automatically shows/hides based on circuit state *@
    <ReconnectModal />

    @* Shown by Blazor when an unhandled exception ends the circuit (not on a lost connection -
       that is ReconnectModal). The exception stays in the server log; no detail is shown.
       Buttons are wired by /js/blazorStartup.js: the circuit is already gone. UI refactor 036. *@
    <div id="blazor-error-ui" role="alert">
        <div class="blazor-error-ui__inner">
            <i class="bi bi-exclamation-octagon-fill blazor-error-ui__icon" aria-hidden="true"></i>
            <p class="blazor-error-ui__text">
                Ocorreu um erro inesperado e a página deixou de responder.
                <span>O problema foi registado. Recarregue para continuar.</span>
            </p>
            <button type="button" class="btn btn-primary btn-sm blazor-error-reload">Recarregar</button>
            <button type="button" class="btn btn-outline-secondary btn-sm blazor-error-dismiss">Fechar</button>
        </div>
    </div>
</body>
</html>