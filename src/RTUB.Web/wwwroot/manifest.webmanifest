{
  "id": "/",
  "name": "RTUB - Real Tuna Universitária de Bragança",
  "short_name": "RTUB",
  "description": "Real Tuna Universitária de Bragança - Plataforma de Gestão",
  "theme_color": "#3F2A86",
  "background_color": "#000000",
  "display": "standalone",
  "orientation": "portrait-primary",
  "scope": "/",
  "start_url": "/?utm_source=pwa",
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "categories": ["music", "education", "lifestyle", "entertainment"],
  "dir": "ltr",
  "lang": "pt",
  "display_override": ["standalone", "minimal-ui"],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=ipb.pt.rtub.app",
      "id": "ipb.pt.rtub.app"
    }
  ],
  "edge_side_panel": {
    "preferred_width": 420
  },
  "icons": [
    {
      "src": "/icons/rtub-logo-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/rtub-logo-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/rtub-logo-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/icons/rtub-logo-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "RTUB - Real Tuna Universitária de Bragança"
    },
    {
      "src": "/icons/rtub-logo-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "wide",
      "label": "RTUB - Real Tuna Universitária de Bragança"
    }
  ],
  "shortcuts": [
    {
      "name": "Atuações",
      "short_name": "Atuações",
      "description": "Ver próximas atuações",
      "url": "/events",
      "icons": [
        {
          "src": "/icons/rtub-logo-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Ensaios",
      "short_name": "Ensaios",
      "description": "Ver próximos ensaios",
      "url": "/rehearsals",
      "icons": [
        {
          "src": "/icons/rtub-logo-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Galeria",
      "short_name": "Galeria",
      "description": "Ver galeria de fotos",
      "url": "/gallery",
      "icons": [
        {
          "src": "/icons/rtub-logo-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
