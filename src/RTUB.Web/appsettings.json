{
  "UseSqlServer": false,
  "Toggles": {
    "MapEnabled": true
  },
  "WebPush": {
    "Enabled": true
  },
  "ImageCaching": {
    "CacheDurationInSeconds": 86400
  },
  "Cloudflare": {
    "R2": {
      "Bucket": "rtub"
    }
  },
  "Gallery": {
    "MaxVideoSizeMB": 100
  },
  "Ranking": {
    "XpPerRehearsal": 12,
    "XpPerEventType": {
      "Festival": 80,
      "Nerba": 60,
      "Convivio": 50,
      "Casamento": 40,
      "Atuacao": 30,
      "Batizado": 30,
      "Serenata": 25,
      "Arraial": 20,
      "Missa": 20
    },
    "Levels": [
      {
        "Level": 1,
        "Name": "Lei Seca",
        "XpThreshold": 0
      },
      {
        "Level": 2,
        "Name": "Vai mais um copo",
        "XpThreshold": 200
      },
      {
        "Level": 3,
        "Name": "Malefício do copo",
        "XpThreshold": 400
      },
      {
        "Level": 4,
        "Name": "Noites Presentes",
        "XpThreshold": 650
      },
      {
        "Level": 5,
        "Name": "Cantor Gregoriano",
        "XpThreshold": 900
      },
      {
        "Level": 6,
        "Name": "Manhãs Ausentes",
        "XpThreshold": 1200
      },
      {
        "Level": 7,
        "Name": "Poeta da Saudade",
        "XpThreshold": 1500
      },
      {
        "Level": 8,
        "Name": "Caçador de Raposas",
        "XpThreshold": 1850
      },
      {
        "Level": 9,
        "Name": "Trovador de Bragança",
        "XpThreshold": 2200
      },
      {
        "Level": 10,
        "Name": "Boémio de Bragança",
        "XpThreshold": 2600
      },
      {
        "Level": 11,
        "Name": "Tuno Natural de Bragança",
        "XpThreshold": 3000
      },
      {
        "Level": 12,
        "Name": "Rei da noite",
        "XpThreshold": 3500
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient.Nominatim": "Warning",
      "Microsoft.Extensions.Http.DefaultHttpClientFactory": "Warning"
    }
  },
  "AllowedHosts": "*"
