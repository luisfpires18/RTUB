@page "/games"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using RTUB.Application.Helpers
@using RTUB.Application.Interfaces
@using RTUB.Application.DTOs
@using RTUB.Shared
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IGameScoreService GameScoreService

<div class="d-flex flex-column gap-3 mb-4">
    <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
        <div>
            <h1 class="mb-2"><i class="bi bi-controller"></i> Jogos</h1>
            <p class="lead page-header-subtitle mb-0 text-light-theme">Diverte-te com os nossos jogos!</p>
        </div>
    </div>
</div>

@if (games == null)
{
    <p>A carregar jogos...</p>
}
else if (!games.Any())
{
    <EmptyState Title="Nenhum jogo disponível ainda"
               Icon="bi-controller" 
               Message="Brevemente teremos jogos disponíveis!" />
}
else
{
    <div class="games-grid">
        @foreach (var game in paginatedGames)
        {
            <GameCard GameId="@game.Id"
                     Title="@game.Title"
                     Description="@game.Description"
                     ImageUrl="@game.ImageUrl"
                     OnPlay="HandlePlayGame"
                     OnLeaderboard="HandleShowLeaderboard" />
        }
    </div>

    @if (games.Count > paginationHelper.PageSize)
    {
        <TablePagination CurrentPage="@paginationHelper.CurrentPage"
                        PageSize="@paginationHelper.PageSize"
                        TotalItems="@games.Count"
                        ItemLabel="jogos"
                        PageSizeOptions="@(new[] { 6, 12, 18, 24 })"
                        OnPageChanged="@HandlePageChange"
                        OnPageSizeChanged="@HandlePageSizeChange" />
    }
}

<!-- Leaderboard Modal -->
<Modal Show="@showLeaderboardModal"
       ShowChanged="@((value) => showLeaderboardModal = value)"
       Title="@($"Classificação - {selectedGameTitle}")"
       Size="Modal.ModalSize.Large"
       ShowCloseButton="true">
    <BodyContent>
        @if (isLoadingLeaderboard)
        {
            <div class="text-center py-4">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">A carregar...</span>
                </div>
            </div>
        }
        else if (leaderboardScores == null || !leaderboardScores.Any())
        {
            <div class="leaderboard-container">
                <EmptyState Title="Nenhuma pontuação registada"
                           Icon="bi-trophy" 
                           Message="Sê o primeiro a jogar e conquista o primeiro lugar!" />
            </div>
        }
        else
        {
            <div class="game-leaderboard">
                @foreach (var score in leaderboardScores)
                {
                    <div class="leaderboard-entry @(score.Rank <= 3 ? $"rank-{score.Rank}" : "")">
                        <div class="rank-position">
                            @if (score.Rank == 1)
                            {
                                <span class="rank-medal gold">🥇</span>
                            }
                            else if (score.Rank == 2)
                            {
                                <span class="rank-medal silver">🥈</span>
                            }
                            else if (score.Rank == 3)
                            {
                                <span class="rank-medal bronze">🥉</span>
                            }
                            else
                            {
                                <span class="rank-number">#@score.Rank</span>
                            }
                        </div>
                        <div class="player-info">
                            <img src="@(score.ProfilePictureSrc ?? "/images/default-avatar.webp")" 
                                 alt="@score.Username" 
                                 class="player-avatar"
                                 onerror="this.onerror=null; this.src='/images/default-avatar.webp';" />
                            <span class="player-name">@score.Username</span>
                        </div>
                        <div class="score-info">
                            <div class="score-main">
                                <i class="bi bi-trophy-fill text-warning"></i>
                                <span class="score-value">@score.Score pts</span>
                            </div>
                            <div class="score-level">
                                <i class="bi bi-graph-up text-info"></i>
                                <span>Nível @score.Level</span>
                            </div>
                        </div>
                        <div class="score-date">
                            <small class="text-muted">@score.PlayedAt.ToString("dd/MM/yyyy HH:mm")</small>
                        </div>
                    </div>
                }
            </div>
        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="CloseLeaderboardModal">Fechar</button>
    </FooterContent>
</Modal>

@code {
    // Simple game model for now
    private class Game
    {
        public int Id { get; set; }
        public string GameId { get; set; } = string.Empty; // For database lookups
        public string Title { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string? ImageUrl { get; set; }
        public string Route { get; set; } = string.Empty;
    }

    private List<Game>? games;
    private List<Game> paginatedGames = new();
    private PaginationHelper<Game> paginationHelper = new() { PageSize = 6 };
    
    private bool showLeaderboardModal = false;
    private bool isLoadingLeaderboard = false;
    private string selectedGameTitle = string.Empty;
    private string selectedGameId = string.Empty;
    private IEnumerable<GameScoreDto>? leaderboardScores;

    protected override void OnInitialized()
    {
        LoadGames();
    }

    private void LoadGames()
    {
        // For now, hardcoded list with one game
        // In the future, this could be loaded from a database
        games = new List<Game>
        {
            new Game
            {
                Id = 1,
                GameId = "avoid-questions",
                Title = "Evitar Perguntas",
                Description = "Evita as perguntas dos órgãos sociais! Use as teclas ← → para mover o teu personagem.",
                ImageUrl = null, // Can be set to a game thumbnail later
                Route = "/games/avoid-questions"
            }
        };

        UpdatePagination();
    }

    private void UpdatePagination()
    {
        if (games != null)
        {
            paginatedGames = paginationHelper.GetPageData(games);
        }
    }

    private Task HandlePageChange(int newPage)
    {
        if (paginationHelper.GoToPage(newPage))
        {
            UpdatePagination();
        }
        return Task.CompletedTask;
    }

    private Task HandlePageSizeChange(int newPageSize)
    {
        paginationHelper.PageSize = newPageSize;
        paginationHelper.Reset();
        UpdatePagination();
        return Task.CompletedTask;
    }

    private void HandlePlayGame(int gameId)
    {
        var game = games?.FirstOrDefault(g => g.Id == gameId);
        if (game != null && !string.IsNullOrEmpty(game.Route))
        {
            NavigationManager.NavigateTo(game.Route);
        }
    }

    private async Task HandleShowLeaderboard(int gameId)
    {
        var game = games?.FirstOrDefault(g => g.Id == gameId);
        if (game != null)
        {
            selectedGameTitle = game.Title;
            selectedGameId = game.GameId;
            showLeaderboardModal = true;
            isLoadingLeaderboard = true;
            leaderboardScores = null;
            StateHasChanged();
            
            try
            {
                leaderboardScores = await GameScoreService.GetLeaderboardAsync(game.GameId, 20);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error loading leaderboard: {ex.Message}");
                leaderboardScores = Enumerable.Empty<GameScoreDto>();
            }
            finally
            {
                isLoadingLeaderboard = false;
                StateHasChanged();
            }
        }
    }

    private void CloseLeaderboardModal()
    {
        showLeaderboardModal = false;
        selectedGameTitle = string.Empty;
        selectedGameId = string.Empty;
        leaderboardScores = null;
    }
}
