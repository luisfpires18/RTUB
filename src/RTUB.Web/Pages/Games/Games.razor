@page "/games"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using RTUB.Application.Interfaces
@using RTUB.Application.DTOs
@using RTUB.Application.Data
@using RTUB.Core.Enums
@using RTUB.Shared
@using RTUB.Shared.Base
@inject NavigationManager NavigationManager
@inject IGameScoreService GameScoreService
@inject IGameService GameService
@inject IGameFilterService GameFilterService
@inject ITimeFormatter TimeFormatter
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@attribute [Authorize]

<div class="games-container">
    <div class="games-header">
        <h2><i class="bi bi-controller"></i> Jogos</h2>
        <p class="text-white-opacity">Diverte-te com os jogos da RTUB e compete pelo melhor lugar na classificação!</p>
    </div>

    @if (loading)
    {
        <div class="text-center py-4">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">A carregar...</span>
            </div>
        </div>
    }
    else if (!filteredGames.Any())
    {
        <EmptyState Title="Sem jogos disponíveis"
                    Message="Neste momento não temos jogos disponíveis."
                    Icon="bi-controller" />
    }
    else
    {
        <div class="games-grid">
            @foreach (var game in paginatedGames)
            {
                <GameCard @key="game.Key" 
                    Title="@game.Title"
                    Description="@game.Description"
                    ImageUrl="@game.ImageUrl"
                    GameKey="@game.Key"
                    ComingSoon="@game.IsComingSoon"
                    MembersOnly="@game.MembersOnly"
                    ShowAdminControls="@isAdmin"
                    OnPlay="@(() => NavigateToGame(game.PlayRoute))"
                    OnShowLeaderboard="@(() => OpenLeaderboardModal(game.Key, game.Title))"
                    OnEdit="@(() => OpenEditModal(game))" />
            }
        </div>

        @if (filteredGames.Count > pageSize)
        {
            <div class="mt-4">
                <TablePagination CurrentPage="@currentPage"
                                 PageSize="@pageSize"
                                 TotalItems="@filteredGames.Count"
                                 ItemLabel="jogos"
                                 PageSizeOptions="@(new[] { 6, 12, 18 })"
                                 OnPageChanged="@HandlePageChanged"
                                 OnPageSizeChanged="@HandlePageSizeChanged" />
            </div>
        }
    }
</div>

<!-- Edit Game Modal -->
@if (modals.IsOpen(ModalType.Edit) && editingGame != null)
{
    <Modal Show="@modals.IsOpen(ModalType.Edit)"
           ShowChanged="@((bool show) => modals.Toggle(ModalType.Edit, show))"
           Title="Editar Jogo"
           Size="Modal.ModalSize.Default"
           Centered="true">
        <BodyContent>
            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <i class="bi bi-controller text-primary me-2"></i>Título
                </label>
                <input type="text" class="form-control" @bind="editingGame.Title" readonly />
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <i class="bi bi-text-paragraph text-primary me-2"></i>Descrição
                </label>
                <textarea class="form-control" rows="3" @bind="editingGame.Description" placeholder="Descrição do jogo..."></textarea>
            </div>
            <div class="mb-3">
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" id="gameComingSoon" @bind="editingGame.IsComingSoon" />
                    <label class="form-check-label" for="gameComingSoon">
                        <i class="bi bi-clock text-warning me-2"></i>Em Breve (desativa o botão Jogar)
                    </label>
                </div>
            </div>
            <div class="mb-3">
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" id="gameMembersOnly" @bind="editingGame.MembersOnly" />
                    <label class="form-check-label" for="gameMembersOnly">
                        <i class="bi bi-people-fill text-info me-2"></i>Apenas Membros (oculta de Leitões)
                    </label>
                </div>
            </div>
        </BodyContent>
        <FooterContent>
            <button type="button" class="btn btn-secondary" @onclick="CloseEditModal">Cancelar</button>
            <button type="button" class="btn btn-success" @onclick="SaveGame" disabled="@saving">
                @if (saving)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                }
                Guardar
            </button>
        </FooterContent>
    </Modal>
}

<!-- Leaderboard Modal (keep existing) -->

@if (modals.IsOpen(ModalType.Leaderboard))
{
    <Modal Show="@modals.IsOpen(ModalType.Leaderboard)"
           ShowChanged="@((bool show) => modals.Toggle(ModalType.Leaderboard, show))"
           Title="@($"Classificação - {selectedGameTitle}")"
           Size="Modal.ModalSize.Large"
           Centered="true">
        <BodyContent>
            @if (leaderboardLoading)
            {
                <LoadingSpinner Message="A carregar leaderboard..." />
            }
            else if (leaderboardScores == null || !leaderboardScores.Any())
            {
                <div class="text-center py-4">
                    <i class="bi bi-trophy display-4 text-muted mb-3 d-block"></i>
                    <p class="text-muted">Ainda não há pontuações para este jogo.</p>
                    <p class="text-white-opacity">Sê o primeiro a jogar e entra na classificação!</p>
                </div>
            }
            else
            {
                <div class="mb-3">
                    <SearchBar @bind-Value="leaderboardSearchTerm"
                               Placeholder="Pesquisar jogador..."
                               OnSearch="HandleLeaderboardSearch"
                               Compact="true" />
                </div>
                
                <div class="stats-card-grid">
                    @{
                        var filteredScores = GameScoreService.FilterLeaderboardScores(leaderboardScores ?? new List<GameScoreDto>(), leaderboardSearchTerm);
                        var startIndex = (leaderboardPage - 1) * leaderboardPageSize;
                        var paginatedScores = filteredScores.Skip(startIndex).Take(leaderboardPageSize).ToList();
                    }
                    @for (int i = 0; i < paginatedScores.Count; i++)
                    {
                        var score = paginatedScores[i];
                        var position = score.Position;
                        <div class="stats-card">
                            <div class="stats-card-position">
                                @if (position == 1)
                                {
                                    <span class="stats-medal gold">🥇</span>
                                }
                                else if (position == 2)
                                {
                                    <span class="stats-medal silver">🥈</span>
                                }
                                else if (position == 3)
                                {
                                    <span class="stats-medal bronze">🥉</span>
                                }
                                else
                                {
                                    <span class="stats-position">@position</span>
                                }
                            </div>
                            <img src="@(score.ProfilePictureSrc ?? "/images/default-avatar.webp")" 
                                 alt="@(score.UserNickname ?? score.UserName)" 
                                 class="stats-avatar"
                                 onerror="this.onerror=null; this.src='/images/default-avatar.webp';" />
                            <div class="stats-card-content">
                                <div class="stats-card-title">@(score.UserNickname ?? score.UserName)</div>
                                @if (selectedGameKey != "bmr-bebe-mais-rui" && selectedGameKey != "tomato-thrower" && selectedGameKey != "passaro-maluco")
                                {
                                    <div class="stats-card-subtitle">Nível @score.MaxLevel • @TimeFormatter.FormatTimeSurvived(score.TimeSurvived)</div>
                                }
                            </div>
                            <div class="stats-card-count">
                                <i class="bi bi-star-fill"></i>
                                <span>@score.Points</span>
                            </div>
                        </div>
                    }
                </div>
                
                @if (filteredScores.Count > leaderboardPageSize)
                {
                    <div class="mt-3">
                        <TablePagination CurrentPage="@leaderboardPage"
                                         PageSize="@leaderboardPageSize"
                                         TotalItems="@filteredScores.Count"
                                         ItemLabel="jogadores"
                                         PageSizeOptions="@(new[] { 5, 10, 15, 20 })"
                                         OnPageChanged="@HandleLeaderboardPageChanged"
                                         OnPageSizeChanged="@HandleLeaderboardPageSizeChanged" />
                    </div>
                }
            }
        </BodyContent>
        <FooterContent>
            <button type="button" class="btn btn-secondary" @onclick="CloseLeaderboardModal">Fechar</button>
        </FooterContent>
    </Modal>
}

@code {
    private List<GameDto> allGames = new();
    private List<GameDto> filteredGames = new();
    private List<GameDto> paginatedGames = new();
    private int currentPage = 1;
    private int pageSize = 6;
    private bool loading = true;
    private bool isAdmin = false;
    private bool isLeitao = false;

    // Edit modal state
    private enum ModalType { Edit, Leaderboard }
    private readonly MultiModalState<ModalType> modals = new();
    private bool saving = false;
    private GameDto? editingGame;

    // Leaderboard modal state
    private bool leaderboardLoading = false;
    private string selectedGameKey = string.Empty;
    private string selectedGameTitle = string.Empty;
    private List<GameScoreDto>? leaderboardScores;
    private string leaderboardSearchTerm = string.Empty;
    private int leaderboardPage = 1;
    private int leaderboardPageSize = 10;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        
        isAdmin = user.IsInRole("Admin");
        
        if (user.Identity?.IsAuthenticated == true)
        {
            var currentUser = await UserManager.GetUserAsync(user);
            if (currentUser != null)
            {
                isLeitao = currentUser.Categories.Contains(MemberCategory.Leitao);
            }
        }
        
        await LoadGames();
    }

    private async Task LoadGames()
    {
        loading = true;
        StateHasChanged();
        
        try
        {
            allGames = await GameService.GetAllGamesAsync() ?? new List<GameDto>();
            // If the filter service isn't configured (e.g. in tests), fall back to minimal rules:
            // - Admin: sees all
            // - Leitao: hides MembersOnly games
            filteredGames = GameFilterService.FilterGamesByUserCategory(allGames, isLeitao, isAdmin)
                ?? (isAdmin
                    ? allGames
                    : (isLeitao ? allGames.Where(g => !g.MembersOnly).ToList() : allGames));
            ApplyPagination();
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private void ApplyPagination()
    {
        var skip = (currentPage - 1) * pageSize;
        paginatedGames = filteredGames.Skip(skip).Take(pageSize).ToList();
    }

    private Task HandlePageChanged(int newPage)
    {
        currentPage = newPage;
        ApplyPagination();
        return Task.CompletedTask;
    }

    private Task HandlePageSizeChanged(int newPageSize)
    {
        pageSize = newPageSize;
        currentPage = 1;
        ApplyPagination();
        return Task.CompletedTask;
    }

    private void NavigateToGame(string? playRoute)
    {
        if (!string.IsNullOrEmpty(playRoute))
        {
            NavigationManager.NavigateTo(playRoute);
        }
    }

    // Edit modal methods
    private void OpenEditModal(GameDto game)
    {
        editingGame = new GameDto
        {
            Id = game.Id,
            Key = game.Key,
            Title = game.Title,
            Description = game.Description,
            ImageUrl = game.ImageUrl,
            PlayRoute = game.PlayRoute,
            IsComingSoon = game.IsComingSoon,
            MembersOnly = game.MembersOnly,
            IsActive = game.IsActive
        };
        modals.Open(ModalType.Edit);
    }

    private void CloseEditModal()
    {
        modals.Close(ModalType.Edit);
        editingGame = null;
    }

    private async Task SaveGame()
    {
        if (editingGame == null) return;
        
        saving = true;
        StateHasChanged();
        
        try
        {
            await GameService.UpdateGameAsync(
                editingGame.Id,
                editingGame.Title,
                editingGame.Description,
                editingGame.IsComingSoon,
                editingGame.MembersOnly
            );
            
            await LoadGames();
            CloseEditModal();
        }
        finally
        {
            saving = false;
            StateHasChanged();
        }
    }

    // Leaderboard modal methods
    private async Task OpenLeaderboardModal(string gameKey, string gameTitle)
    {
        selectedGameKey = gameKey;
        selectedGameTitle = gameTitle;
        modals.Open(ModalType.Leaderboard);
        leaderboardLoading = true;
        leaderboardScores = null;
        leaderboardSearchTerm = string.Empty;
        leaderboardPage = 1;
        StateHasChanged();

        try
        {
            leaderboardScores = await GameScoreService.GetLeaderboardAsync(gameKey, 100);
        }
        catch
        {
            leaderboardScores = new List<GameScoreDto>();
        }
        finally
        {
            leaderboardLoading = false;
            StateHasChanged();
        }
    }

    private void CloseLeaderboardModal()
    {
        modals.Close(ModalType.Leaderboard);
        selectedGameKey = string.Empty;
        selectedGameTitle = string.Empty;
        leaderboardScores = null;
        leaderboardSearchTerm = string.Empty;
        leaderboardPage = 1;
    }
    
    
    private Task HandleLeaderboardSearch(string searchTerm)
    {
        leaderboardSearchTerm = searchTerm;
        leaderboardPage = 1;
        StateHasChanged();
        return Task.CompletedTask;
    }
    
    private Task HandleLeaderboardPageChanged(int newPage)
    {
        leaderboardPage = newPage;
        StateHasChanged();
        return Task.CompletedTask;
    }
    
    private Task HandleLeaderboardPageSizeChanged(int newSize)
    {
        leaderboardPageSize = newSize;
        leaderboardPage = 1;
        StateHasChanged();
        return Task.CompletedTask;
    }

}
