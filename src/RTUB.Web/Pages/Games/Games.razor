@page "/games"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using RTUB.Application.Interfaces
@using RTUB.Application.DTOs
@using RTUB.Shared
@inject NavigationManager NavigationManager
@inject IGameScoreService GameScoreService
@attribute [Authorize]

<div class="games-container">
    <div class="games-header">
        <h2><i class="bi bi-controller"></i> Jogos</h2>
        <p class="text-white-opacity">Diverte-te com os jogos da RTUB e compete pelo melhor lugar na classificação!</p>
    </div>

    <div class="games-grid">
        @foreach (var game in paginatedGames)
        {
            <GameCard 
                Title="@game.Title"
                Description="@game.Description"
                ImageUrl="@game.ImageUrl"
                GameKey="@game.Key"
                ComingSoon="@game.ComingSoon"
                OnPlay="@(() => NavigateToGame(game.PlayRoute))"
                OnShowLeaderboard="@(() => OpenLeaderboardModal(game.Key, game.Title))" />
        }
    </div>

    @if (allGames.Count > pageSize)
    {
        <div class="mt-4">
            <TablePagination CurrentPage="@currentPage"
                             PageSize="@pageSize"
                             TotalItems="@allGames.Count"
                             ItemLabel="jogos"
                             PageSizeOptions="@(new[] { 6, 12, 18 })"
                             OnPageChanged="@HandlePageChanged"
                             OnPageSizeChanged="@HandlePageSizeChanged" />
        </div>
    }
</div>

@if (showLeaderboardModal)
{
    <Modal Show="@showLeaderboardModal"
           ShowChanged="@OnLeaderboardModalShowChanged"
           Title="@($"Classificação - {selectedGameTitle}")"
           Size="Modal.ModalSize.Large"
           Centered="true">
        <BodyContent>
            @if (leaderboardLoading)
            {
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">A carregar...</span>
                    </div>
                </div>
            }
            else if (leaderboardScores == null || !leaderboardScores.Any())
            {
                <div class="text-center py-4">
                    <i class="bi bi-trophy display-4 text-muted mb-3 d-block"></i>
                    <p class="text-muted">Ainda não há pontuações para este jogo.</p>
                    <p class="text-white-opacity">Sê o primeiro a jogar e entra na classificação!</p>
                </div>
            }
            else
            {
                <!-- Search bar -->
                <div class="mb-3">
                    <SearchBar @bind-Value="leaderboardSearchTerm"
                               Placeholder="Pesquisar jogador..."
                               OnSearch="HandleLeaderboardSearch"
                               Compact="true" />
                </div>
                
                <div class="stats-card-grid">
                    @{
                        var filteredScores = FilterLeaderboardScores();
                        var startIndex = (leaderboardPage - 1) * leaderboardPageSize;
                        var paginatedScores = filteredScores.Skip(startIndex).Take(leaderboardPageSize).ToList();
                    }
                    @for (int i = 0; i < paginatedScores.Count; i++)
                    {
                        var score = paginatedScores[i];
                        var position = score.Position;
                        <div class="stats-card">
                            <div class="stats-card-position">
                                @if (position == 1)
                                {
                                    <span class="stats-medal gold">🥇</span>
                                }
                                else if (position == 2)
                                {
                                    <span class="stats-medal silver">🥈</span>
                                }
                                else if (position == 3)
                                {
                                    <span class="stats-medal bronze">🥉</span>
                                }
                                else
                                {
                                    <span class="stats-position">@position</span>
                                }
                            </div>
                            <img src="@(score.ProfilePictureSrc ?? "/images/default-avatar.webp")" 
                                 alt="@(score.UserNickname ?? score.UserName)" 
                                 class="stats-avatar"
                                 onerror="this.onerror=null; this.src='/images/default-avatar.webp';" />
                            <div class="stats-card-content">
                                <div class="stats-card-title">@(score.UserNickname ?? score.UserName)</div>
                                <div class="stats-card-subtitle">Nível @score.MaxLevel • @FormatTimeSurvived(score.TimeSurvived)</div>
                            </div>
                            <div class="stats-card-count">
                                <i class="bi bi-star-fill"></i>
                                <span>@score.Points</span>
                            </div>
                        </div>
                    }
                </div>
                
                @if (filteredScores.Count > leaderboardPageSize)
                {
                    <div class="mt-3">
                        <TablePagination CurrentPage="@leaderboardPage"
                                         PageSize="@leaderboardPageSize"
                                         TotalItems="@filteredScores.Count"
                                         ItemLabel="jogadores"
                                         PageSizeOptions="@(new[] { 5, 10, 15, 20 })"
                                         OnPageChanged="@HandleLeaderboardPageChanged"
                                         OnPageSizeChanged="@HandleLeaderboardPageSizeChanged" />
                    </div>
                }
            }
        </BodyContent>
        <FooterContent>
            <button type="button" class="btn btn-secondary" @onclick="CloseLeaderboardModal">Fechar</button>
        </FooterContent>
    </Modal>
}

@code {
    private List<GameInfo> allGames = new();
    private List<GameInfo> paginatedGames = new();
    private int currentPage = 1;
    private int pageSize = 6;

    private bool showLeaderboardModal = false;
    private bool leaderboardLoading = false;
    private string selectedGameKey = string.Empty;
    private string selectedGameTitle = string.Empty;
    private List<GameScoreDto>? leaderboardScores;
    
    // Leaderboard pagination and search
    private string leaderboardSearchTerm = string.Empty;
    private int leaderboardPage = 1;
    private int leaderboardPageSize = 10;

    protected override void OnInitialized()
    {
        allGames = new List<GameInfo>
        {
            new GameInfo
            {
                Key = "avoid-questions",
                Title = "Evitar Perguntas",
                Description = "Joga como um Magister e evita as perguntas dos membros que caem do céu. Sobrevive o máximo tempo possível!",
                ImageUrl = "/sprites/games/avoid-questions-thumb.svg",
                PlayRoute = "/games/avoid-questions",
                ComingSoon = false
            }
        };

        ApplyPagination();
    }

    private void ApplyPagination()
    {
        var skip = (currentPage - 1) * pageSize;
        paginatedGames = allGames.Skip(skip).Take(pageSize).ToList();
    }

    private Task HandlePageChanged(int newPage)
    {
        currentPage = newPage;
        ApplyPagination();
        return Task.CompletedTask;
    }

    private Task HandlePageSizeChanged(int newPageSize)
    {
        pageSize = newPageSize;
        currentPage = 1;
        ApplyPagination();
        return Task.CompletedTask;
    }

    private void NavigateToGame(string? playRoute)
    {
        if (!string.IsNullOrEmpty(playRoute))
        {
            NavigationManager.NavigateTo(playRoute);
        }
    }

    private async Task OpenLeaderboardModal(string gameKey, string gameTitle)
    {
        selectedGameKey = gameKey;
        selectedGameTitle = gameTitle;
        showLeaderboardModal = true;
        leaderboardLoading = true;
        leaderboardScores = null;
        leaderboardSearchTerm = string.Empty;
        leaderboardPage = 1;
        StateHasChanged();

        try
        {
            leaderboardScores = await GameScoreService.GetLeaderboardAsync(gameKey, 100);
        }
        catch
        {
            leaderboardScores = new List<GameScoreDto>();
        }
        finally
        {
            leaderboardLoading = false;
            StateHasChanged();
        }
    }

    private void OnLeaderboardModalShowChanged(bool show)
    {
        showLeaderboardModal = show;
        if (!show) CloseLeaderboardModal();
    }

    private void CloseLeaderboardModal()
    {
        showLeaderboardModal = false;
        selectedGameKey = string.Empty;
        selectedGameTitle = string.Empty;
        leaderboardScores = null;
        leaderboardSearchTerm = string.Empty;
        leaderboardPage = 1;
    }
    
    private List<GameScoreDto> FilterLeaderboardScores()
    {
        if (leaderboardScores == null) return new List<GameScoreDto>();
        if (string.IsNullOrWhiteSpace(leaderboardSearchTerm)) return leaderboardScores;
        
        var search = leaderboardSearchTerm.ToLower();
        return leaderboardScores.Where(s => 
            (s.UserName?.ToLower().Contains(search) ?? false) ||
            (s.UserNickname?.ToLower().Contains(search) ?? false)
        ).ToList();
    }
    
    private Task HandleLeaderboardSearch(string searchTerm)
    {
        leaderboardSearchTerm = searchTerm;
        leaderboardPage = 1;
        StateHasChanged();
        return Task.CompletedTask;
    }
    
    private Task HandleLeaderboardPageChanged(int newPage)
    {
        leaderboardPage = newPage;
        StateHasChanged();
        return Task.CompletedTask;
    }
    
    private Task HandleLeaderboardPageSizeChanged(int newSize)
    {
        leaderboardPageSize = newSize;
        leaderboardPage = 1;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private string FormatTimeSurvived(TimeSpan time)
    {
        if (time.TotalMinutes >= 1)
            return $"{(int)time.TotalMinutes}m {time.Seconds}s";
        return $"{time.Seconds}s";
    }

    private class GameInfo
    {
        public string Key { get; set; } = string.Empty;
        public string Title { get; set; } = string.Empty;
        public string? Description { get; set; }
        public string? ImageUrl { get; set; }
        public string? PlayRoute { get; set; }
        public bool ComingSoon { get; set; }
    }
}
