@page "/bets/{betId:int}/discussion"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Identity
@using RTUB.Application.Interfaces
@using RTUB.Core.Entities
@attribute [Authorize]
@inject IBetService BetService
@inject IDiscussionService DiscussionService
@inject IPostService PostService
@inject ICommentService CommentService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation

<PageTitle>Discussão - @(bet?.Title ?? "Aposta")</PageTitle>

<div class="discussion-page-wrapper">
    @if (bet == null)
    {
        <LoadingSpinner />
    }
    else
    {
        <!-- Page Header -->
        <div class="discussion-header mb-4">
            <div class="discussion-header-actions">
                <button class="btn btn-outline-secondary btn-sm" @onclick="NavigateBack">
                    <i class="bi bi-arrow-left"></i>
                </button>
            </div>

            <div class="discussion-header-title">
                <h1 class="mb-2"><i class="bi bi-chat-dots"></i> Discussão</h1>
                <p class="mb-0 text-muted">@bet.Title</p>
            </div>

            @if (canCreatePost)
            {
                <div class="discussion-header-actions page-header-actions justify-content-end justify-content-lg-end">
                    <button class="btn btn-success" @onclick="OpenCreatePostModal" title="Criar Novo Post">
                        <i class="bi bi-plus-lg"></i> Adicionar Post
                    </button>
                </div>
            }
        </div>

        <!-- Search Bar -->
        <SearchBar @bind-Value="searchTerm"
                   Placeholder="Pesquisar posts por título, conteúdo ou autor..."
                   OnSearch="HandleSearch" />

        <!-- Posts Section -->
        @if (posts == null)
        {
            <LoadingSpinner />
        }
        else if (posts.Count == 0)
        {
            <EmptyState Title="Nenhum post encontrado" 
                       Message="@(string.IsNullOrWhiteSpace(searchTerm) ? "Seja o primeiro a iniciar uma discussão sobre esta aposta!" : "Nenhum resultado encontrado para a sua pesquisa.")" 
                       Icon="bi-chat-dots" />
        }
        else
        {
            <div class="posts-list">
                @foreach (var post in posts)
                {
                    var postComments = GetPostComments(post.Id);
                    var commentCount = GetPostCommentCount(post.Id);
                    var isExpanded = expandedPostIds.Contains(post.Id);
                    
                    <div class="post-wrapper mb-3">
                        <!-- PostCard as clickable header with action buttons -->
                        <PostCard Post="@post"
                                 CommentCount="@commentCount"
                                 EventName="@bet.Title"
                                 OnClick="@(() => TogglePost(post.Id))"
                                 ShowAuthorControls="@IsAuthor(post)"
                                 ShowAdminControls="@isAdmin"
                                 ShowOwnerControls="@(isOwner && !IsAuthor(post))"
                                 OnEdit="@(() => OpenEditPostModal(post))"
                                 OnDelete="@(() => ShowDeletePostConfirm(post))"
                                 OnTogglePin="@(() => TogglePin(post))"
                                 OnToggleLock="@(() => ToggleLock(post))" />
                        
                        <!-- Expanded content -->
                        @if (isExpanded)
                        {
                            <div class="post-expanded-content">
                                <!-- Comments Section -->
                                <div class="comments-section">
                                    <h6 class="mb-3">
                                        <i class="bi bi-chat-left-text me-2"></i>Comentários (@commentCount)
                                    </h6>
                                    
                                    @if (commentCount == 0)
                                    {
                                        <p class="text-muted"><em>Nenhum comentário ainda.</em></p>
                                    }
                                    else
                                    {
                                        <div class="comments-list mb-3">
                                            @foreach (var comment in postComments)
                                            {
                                                <CommentItem Comment="@comment" 
                                                            CanEdit="@(IsCommentAuthor(comment))"
                                                            CanDelete="@(isOwner || IsCommentAuthor(comment))"
                                                            OnEdit="@(async (body) => await EditComment(comment, body))"
                                                            OnDelete="@(() => ShowDeleteCommentConfirm(comment, post.Id))" />
                                            }
                                        </div>
                                    }

                                    <!-- Add Comment -->
                                    @if (!post.IsLocked && canCreatePost)
                                    {
                                        <div class="mt-3">
                                            <CommentComposer OnSubmit="@(async (body) => await CreateComment(post.Id, body))" />
                                        </div>
                                    }
                                    else if (post.IsLocked)
                                    {
                                        <div class="alert alert-warning mt-3 d-flex align-items-center">
                                            <i class="bi bi-lock-fill me-2"></i>
                                            <span>Este post está bloqueado. Não é possível adicionar novos comentários.</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            @if (totalPosts > pageSize)
            {
                <div class="pagination-wrapper mt-4">
                    <TablePagination CurrentPage="@currentPage"
                                    PageSize="@pageSize"
                                    TotalItems="@totalPosts"
                                    ItemLabel="posts"
                                    PageSizeOptions="@(new[] { 20, 50, 100 })"
                                    OnPageChanged="@HandlePageChange"
                                    OnPageSizeChanged="@HandlePageSizeChange" />
                </div>
            }
        }

        <!-- Create/Edit Post Modal -->
        @if (showPostModal)
        {
            <Modal Show="@showPostModal"
                   ShowChanged="@((bool show) => showPostModal = show)"
                   Title="@(editingPost?.Id > 0 ? "Editar Post" : "Criar Novo Post")"
                   Size="Modal.ModalSize.Large"
                   Centered="true">
                <BodyContent>
                    @if (editingPost != null && editingPost.Id > 0)
                    {
                        <PostComposer Title="@editingPost.Title"
                                     Body="@editingPost.Body"
                                     OnSubmit="@(async (tuple) => await UpdatePostFromTuple(tuple.Item1, tuple.Item2))" />
                    }
                    else
                    {
                        <PostComposer OnSubmit="@(async (tuple) => await CreatePostFromTuple(tuple))" />
                    }
                </BodyContent>
            </Modal>
        }

        <!-- Delete Post Confirmation -->
        <ConfirmDialog Show="@showDeletePostConfirm"
                      ShowChanged="@((bool show) => showDeletePostConfirm = show)"
                      Title="Confirmar Eliminação"
                      Message="Tem a certeza de que pretende eliminar este post?"
                      WarningMessage="Esta ação não pode ser anulada e todos os comentários serão eliminados."
                      ConfirmText="Eliminar"
                      CancelText="Cancelar"
                      ConfirmButtonClass="btn-danger"
                      OnConfirm="DeletePost"
                      OnCancel="CancelDeletePost" />

        <!-- Delete Comment Confirmation -->
        <ConfirmDialog Show="@showDeleteCommentConfirm"
                      ShowChanged="@((bool show) => showDeleteCommentConfirm = show)"
                      Title="Confirmar Eliminação"
                      Message="Tem a certeza de que pretende eliminar este comentário?"
                      WarningMessage="Esta ação não pode ser anulada."
                      ConfirmText="Eliminar"
                      CancelText="Cancelar"
                      ConfirmButtonClass="btn-danger"
                      OnConfirm="DeleteComment"
                      OnCancel="CancelDeleteComment" />
    }
</div>

@code {
    [Parameter]
    public int BetId { get; set; }

    private Bet? bet;
    private ApplicationUser? currentUser;
    private bool isAdmin = false;
    private bool isOwner = false;
    private bool canCreatePost = false;

    private List<Post> posts = new();
    private Dictionary<int, List<Comment>> commentsCache = new();
    private HashSet<int> expandedPostIds = new();

    private string searchTerm = string.Empty;
    private int currentPage = 1;
    private int pageSize = 20;
    private int totalPosts = 0;

    private bool showPostModal = false;
    private Post? editingPost;

    private bool showDeletePostConfirm = false;
    private Post? deletingPost;

    private bool showDeleteCommentConfirm = false;
    private Comment? deletingComment;
    private int deletingCommentPostId = 0;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            currentUser = await UserManager.GetUserAsync(user);
            isAdmin = user.IsInRole("Admin");
            isOwner = user.IsInRole("Owner");
            canCreatePost = true;
        }

        await LoadBet();
        await LoadPosts();
    }

    private async Task LoadBet()
    {
        bet = await BetService.GetBetByIdAsync(BetId);

        if (bet != null && bet.Discussion == null)
        {
            // Discussion doesn't exist - show error or redirect
            // For now, we'll just leave bet.Discussion as null and handle in UI
        }
    }

    private async Task LoadPosts()
    {
        if (bet?.Discussion == null) return;

        var allPosts = await PostService.GetByDiscussionIdAsync(bet.Discussion.Id, 1, 1000, searchTerm);

        totalPosts = await PostService.GetCountByDiscussionIdAsync(bet.Discussion.Id, searchTerm);

        // Apply pagination
        posts = allPosts
            .OrderByDescending(p => p.IsPinned)
            .ThenByDescending(p => p.CreatedAt)
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();

        // Load comments for all posts
        foreach (var post in posts)
        {
            var comments = await CommentService.GetByPostIdAsync(post.Id, 1, 100);
            commentsCache[post.Id] = comments.OrderBy(c => c.CreatedAt).ToList();
        }
    }

    private List<Comment> GetPostComments(int postId)
    {
        return commentsCache.TryGetValue(postId, out var comments) ? comments : new List<Comment>();
    }

    private int GetPostCommentCount(int postId)
    {
        return GetPostComments(postId).Count;
    }

    private void TogglePost(int postId)
    {
        if (expandedPostIds.Contains(postId))
        {
            expandedPostIds.Remove(postId);
        }
        else
        {
            expandedPostIds.Add(postId);
        }
    }

    private bool IsAuthor(Post post)
    {
        return currentUser != null && post.AuthorId == currentUser.Id;
    }

    private bool IsCommentAuthor(Comment comment)
    {
        return currentUser != null && comment.AuthorId == currentUser.Id;
    }

    private void NavigateBack()
    {
        Navigation.NavigateTo("/bets");
    }

    private async Task HandleSearch(string search)
    {
        searchTerm = search;
        currentPage = 1;
        await LoadPosts();
    }

    private async Task HandlePageChange(int newPage)
    {
        currentPage = newPage;
        await LoadPosts();
    }

    private async Task HandlePageSizeChange(int newPageSize)
    {
        pageSize = newPageSize;
        currentPage = 1;
        await LoadPosts();
    }

    // Post management
    private void OpenCreatePostModal()
    {
        if (bet?.Discussion == null || currentUser == null) return;

        editingPost = null; // Just set to null for create mode
        showPostModal = true;
    }

    private void OpenEditPostModal(Post post)
    {
        editingPost = post;
        showPostModal = true;
    }

    private void ClosePostModal()
    {
        showPostModal = false;
        editingPost = null;
    }

    private async Task CreatePostFromTuple((string title, string body, IReadOnlyList<IBrowserFile> videos) tuple)
    {
        try
        {
            if (bet?.Discussion == null || currentUser == null) return;

            await PostService.CreateAsync(bet.Discussion.Id, currentUser.Id, tuple.title, tuple.body, null, null, tuple.videos);
            await LoadPosts();
            ClosePostModal();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error creating post: {ex.Message}");
        }
    }

    private async Task UpdatePostFromTuple(string title, string body)
    {
        try
        {
            if (editingPost == null) return;

            await PostService.UpdateAsync(editingPost.Id, title, body);
            await LoadPosts();
            ClosePostModal();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating post: {ex.Message}");
        }
    }

    private void ShowDeletePostConfirm(Post post)
    {
        deletingPost = post;
        showDeletePostConfirm = true;
    }

    private void CancelDeletePost()
    {
        showDeletePostConfirm = false;
        deletingPost = null;
    }

    private async Task DeletePost()
    {
        if (deletingPost == null) return;

        try
        {
            await PostService.SoftDeleteAsync(deletingPost.Id);
            await LoadPosts();
            CancelDeletePost();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting post: {ex.Message}");
        }
    }

    private async Task TogglePin(Post post)
    {
        try
        {
            if (post.IsPinned)
            {
                await PostService.UnpinAsync(post.Id);
            }
            else
            {
                await PostService.PinAsync(post.Id);
            }
            await LoadPosts();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error toggling pin: {ex.Message}");
        }
    }

    private async Task ToggleLock(Post post)
    {
        try
        {
            if (post.IsLocked)
            {
                await PostService.UnlockAsync(post.Id);
            }
            else
            {
                await PostService.LockAsync(post.Id);
            }
            await LoadPosts();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error toggling lock: {ex.Message}");
        }
    }

    // Comment management
    private async Task CreateComment(int postId, string body)
    {
        if (currentUser == null || string.IsNullOrWhiteSpace(body)) return;

        try
        {
            await CommentService.CreateAsync(postId, currentUser.Id, body);
            await LoadPosts();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error creating comment: {ex.Message}");
        }
    }

    private async Task EditComment(Comment comment, string newBody)
    {
        try
        {
            await CommentService.UpdateAsync(comment.Id, newBody);
            await LoadPosts();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error editing comment: {ex.Message}");
        }
    }

    private void ShowDeleteCommentConfirm(Comment comment, int postId)
    {
        deletingComment = comment;
        deletingCommentPostId = postId;
        showDeleteCommentConfirm = true;
    }

    private void CancelDeleteComment()
    {
        showDeleteCommentConfirm = false;
        deletingComment = null;
        deletingCommentPostId = 0;
    }

    private async Task DeleteComment()
    {
        if (deletingComment == null) return;

        try
        {
            await CommentService.SoftDeleteAsync(deletingComment.Id);
            await LoadPosts();
            CancelDeleteComment();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting comment: {ex.Message}");
        }
    }
}
