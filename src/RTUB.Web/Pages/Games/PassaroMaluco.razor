@page "/games/passaro-maluco"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.JSInterop
@using RTUB.Application.Data
@using RTUB.Application.Interfaces
@inject IJSRuntime JSRuntime
@inject IGameScoreService GameScoreService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavigationManager
@inject ILogger<PassaroMaluco> Logger
@implements IAsyncDisposable
@attribute [Authorize]

<div class="passaro-maluco-container">
    <!-- Page Header -->
    <div class="d-flex flex-column gap-3 mb-4 page-header-block">
        <div class="d-flex align-items-center gap-3 page-header-row">
            <button class="btn btn-outline-secondary btn-sm back-button" @onclick="GoBack">
                <i class="bi bi-arrow-left"></i>
            </button>
            <div class="page-header-text flex-grow-1 text-center">
                <h1 class="mb-0"><i class="bi bi-twitter"></i> Passaro Maluco</h1>
            </div>
            <!-- Empty element to balance the layout -->
            <div style="width: 38px;"></div>
        </div>
    </div>

    <div class="game-stats">
        <div class="stat-item">
            <i class="bi bi-star-fill text-warning"></i>
            <span class="stat-value">@currentScore</span>
            <span class="stat-label">Pontos</span>
        </div>
        <div class="stat-item">
            <i class="bi bi-trophy-fill text-success"></i>
            <span class="stat-value">@highScore</span>
            <span class="stat-label">Recorde</span>
        </div>
    </div>

    <div class="game-canvas-wrapper">
        <canvas id="gameCanvas" width="800" height="500"></canvas>
        
        @if (!gameStarted)
        {
            <div class="game-overlay">
                <div class="overlay-content">
                    <h3>Passaro Maluco</h3>
                    <p class="mb-3">Ajuda o pássaro a voar entre os canos! Toca ou pressiona espaço para bater as asas.</p>
                    <ul class="game-instructions">
                        <li><i class="bi bi-hand-index me-2"></i>Toca no ecrã ou pressiona Espaço para voar</li>
                        <li><i class="bi bi-arrow-up-circle me-2"></i>Também podes usar a seta para cima</li>
                        <li><i class="bi bi-exclamation-triangle me-2"></i>Evita os canos e o chão!</li>
                        <li><i class="bi bi-trophy me-2"></i>Cada cano passado = 1 ponto</li>
                    </ul>
                    <button class="btn btn-primary btn-lg" @onclick="StartGame">
                        <i class="bi bi-play-fill me-1"></i>Iniciar Jogo
                    </button>
                </div>
            </div>
        }
        
        @if (gameOver)
        {
            <div class="game-overlay game-over-overlay">
                <div class="overlay-content">
                    <h3 class="text-danger">Game Over!</h3>
                    <div class="final-stats mb-4">
                        <div class="final-stat">
                            <span class="final-stat-value">@finalScore</span>
                            <span class="final-stat-label">Pontos</span>
                        </div>
                        @if (isNewHighScore)
                        {
                            <div class="final-stat">
                                <span class="final-stat-value text-warning">🏆</span>
                                <span class="final-stat-label">Novo Recorde!</span>
                            </div>
                        }
                        <div class="final-stat">
                            <span class="final-stat-value text-success">+1.00</span>
                            <span class="final-stat-label">Fidelis Ganhos</span>
                        </div>
                    </div>
                    @if (scoreSaved)
                    {
                        <p class="text-success mb-3"><i class="bi bi-check-circle me-1"></i>Pontuação guardada!</p>
                    }
                    else if (savingScore)
                    {
                        <p class="text-muted mb-3"><i class="bi bi-hourglass-split me-1"></i>A guardar pontuação...</p>
                    }
                    <div class="d-flex gap-2 justify-content-center">
                        <button class="btn btn-primary" @onclick="RestartGame">
                            <i class="bi bi-arrow-repeat me-1"></i>Jogar Novamente
                        </button>
                        <button class="btn btn-outline-secondary" @onclick="GoBack">
                            <i class="bi bi-arrow-left me-1"></i>Voltar
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Mobile touch button -->
    @if (gameStarted && !gameOver)
    {
        <div class="mobile-controls">
            <button class="btn btn-lg btn-warning touch-jump-button" @onclick="TriggerJump">
                <i class="bi bi-arrow-up-circle-fill"></i> Voar
            </button>
        </div>
    }
    
    <!-- Customization note -->
    <div class="mt-4 text-center">
        <small class="text-white-opacity">
            <i class="bi bi-info-circle me-1"></i>
            Sprites personalizáveis em: wwwroot/sprites/games/passaro-maluco/
        </small>
    </div>
</div>

<style>
    .passaro-maluco-container {
        max-width: 850px;
        margin: 0 auto;
        padding: 1rem;
    }

    .game-stats {
        display: flex;
        justify-content: center;
        gap: 2rem;
        margin-bottom: 1rem;
    }

    .stat-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        background: rgba(255, 255, 255, 0.1);
        padding: 0.75rem 1.5rem;
        border-radius: 12px;
    }

    .stat-value {
        font-size: 1.5rem;
        font-weight: bold;
        color: white;
    }

    .stat-label {
        font-size: 0.875rem;
        color: rgba(255, 255, 255, 0.7);
    }

    .game-canvas-wrapper {
        position: relative;
        display: flex;
        justify-content: center;
        background: #1a1a1b;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
    }

    #gameCanvas {
        display: block;
        max-width: 100%;
        height: auto;
        cursor: pointer;
    }

    .game-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.85);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10;
    }

    .overlay-content {
        text-align: center;
        padding: 2rem;
        color: white;
        max-width: 500px;
    }

    .overlay-content h3 {
        font-size: 2rem;
        margin-bottom: 1rem;
    }

    .game-instructions {
        list-style: none;
        padding: 0;
        text-align: left;
        margin: 1.5rem auto;
        max-width: 350px;
    }

    .game-instructions li {
        padding: 0.5rem 0;
        color: rgba(255, 255, 255, 0.9);
    }

    .final-stats {
        display: flex;
        justify-content: center;
        gap: 2rem;
        flex-wrap: wrap;
    }

    .final-stat {
        text-align: center;
    }

    .final-stat-value {
        display: block;
        font-size: 2.5rem;
        font-weight: bold;
        color: white;
    }

    .final-stat-label {
        font-size: 0.875rem;
        color: rgba(255, 255, 255, 0.7);
    }

    .mobile-controls {
        display: flex;
        justify-content: center;
        margin-top: 1rem;
    }

    .touch-jump-button {
        padding: 1rem 3rem;
        font-size: 1.25rem;
        border-radius: 50px;
        box-shadow: 0 4px 15px rgba(255, 193, 7, 0.3);
    }

    @@media (min-width: 768px) {
        .mobile-controls {
            display: none;
        }
    }
</style>

@code {
    private const string GameKey = "passaro-maluco";
    
    private bool gameStarted = false;
    private bool gameOver = false;
    private int currentScore = 0;
    private int highScore = 0;
    private int finalScore = 0;
    private bool isNewHighScore = false;
    
    private bool savingScore = false;
    private bool scoreSaved = false;
    
    private string? currentUserId;
    private ApplicationUser? currentUser;
    private DotNetObjectReference<PassaroMaluco>? objRef;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            currentUser = await UserManager.GetUserAsync(user);
            currentUserId = currentUser?.Id;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            objRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("passaroMalucoGame.init", "gameCanvas", objRef);
            
            // Get high score from JS
            try
            {
                highScore = await JSRuntime.InvokeAsync<int>("passaroMalucoGame.getHighScore");
                StateHasChanged();
            }
            catch
            {
                // Ignore if method not available yet
            }
        }
    }

    private async Task StartGame()
    {
        gameStarted = true;
        gameOver = false;
        scoreSaved = false;
        isNewHighScore = false;
        currentScore = 0;
        
        StateHasChanged();
        await JSRuntime.InvokeVoidAsync("passaroMalucoGame.start");
    }

    private async Task RestartGame() => await StartGame();

    private async Task TriggerJump()
    {
        await JSRuntime.InvokeVoidAsync("passaroMalucoGame.triggerJump");
    }

    private void GoBack() => NavigationManager.NavigateTo("/games");

    [JSInvokable]
    public void UpdateStats(int score)
    {
        currentScore = score;
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnGameOver(int score, int newHighScore)
    {
        gameOver = true;
        gameStarted = false;
        finalScore = score;
        
        if (newHighScore > highScore)
        {
            isNewHighScore = true;
            highScore = newHighScore;
        }
        
        StateHasChanged();

        if (!string.IsNullOrEmpty(currentUserId))
        {
            savingScore = true;
            StateHasChanged();
            
            try
            {
                // Save score
                await GameScoreService.SubmitScoreAsync(currentUserId, GameKey, finalScore, 1, TimeSpan.Zero);
                scoreSaved = true;
                
                // Award 1 Fidelis for playing
                if (currentUser != null)
                {
                    currentUser.FidelisBalance += 1.0m;
                    await UserManager.UpdateAsync(currentUser);
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error saving Passaro Maluco score for user {UserId}", currentUserId);
            }
            finally
            {
                savingScore = false;
                StateHasChanged();
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        try 
        { 
            await JSRuntime.InvokeVoidAsync("passaroMalucoGame.dispose"); 
        } 
        catch (JSDisconnectedException) 
        { 
            // Expected when circuit disconnects
        }
        catch (InvalidOperationException) 
        { 
            // Expected during prerendering
        }
        objRef?.Dispose();
    }
}
