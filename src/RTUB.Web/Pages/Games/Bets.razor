    private async Task HandleCommentMediaSelected(IBrowserFile file)
    {
        try
        {
            if (file != null)
            {
                var maxFileSize = 100 * 1024 * 1024; // 100 MB for videos
                if (file.Size > maxFileSize)
                {
                    ShowError("O ficheiro é demasiado grande. Tamanho máximo: 100 MB");
                    return;
                }

                selectedCommentMediaFile = file;
                
                // Determine media type
                var contentType = file.ContentType.ToLower();
                if (contentType.StartsWith("image/"))
                {
                    uploadedCommentMediaType = "image";
                }
                else if (contentType.StartsWith("video/"))
                {
                    uploadedCommentMediaType = "video";
                }
                else
                {
                    ShowError("Apenas imagens e vídeos são permitidos");
                    selectedCommentMediaFile = null;
                    uploadedCommentMediaType = null;
                    return;
                }
            }
        }
        catch (Exception ex)
        {
            ShowError($"Erro ao selecionar ficheiro: {ex.Message}");
        }
    }
    
    private async Task AddComment()
    {
        if (selectedBet == null || currentUser == null) return;
        
        // Allow empty text if media is provided
        if (string.IsNullOrWhiteSpace(newCommentText) && selectedCommentMediaFile == null) return;
        
        isAddingComment = true;
        try
        {
            string? mediaUrl = null;
            string? mediaType = null;
            
            // Upload media if selected
            if (selectedCommentMediaFile != null && uploadedCommentMediaType != null)
            {
                // Use MemoryStream for seekable stream (required for checksum calculation)
                using var memoryStream = new MemoryStream();
                using var fileStream = selectedCommentMediaFile.OpenReadStream(maxAllowedSize: 100 * 1024 * 1024);
                await fileStream.CopyToAsync(memoryStream);
                memoryStream.Position = 0;
                
                var folder = uploadedCommentMediaType == "image" ? "bet-comments/images" : "bet-comments/videos";
                var fileName = $"{Guid.NewGuid()}{Path.GetExtension(selectedCommentMediaFile.Name)}";
                var entityId = $"bet-{selectedBet.Id}-comment-{Guid.NewGuid()}";
                
                mediaUrl = await ImageStorageService.UploadImageAsync(memoryStream, fileName, selectedCommentMediaFile.ContentType, folder, entityId);
                mediaType = uploadedCommentMediaType;
            }
            
            // Create the comment - allow empty text if media is present
            await BetCommentService.AddCommentAsync(
                betId: selectedBet.Id,
                authorId: currentUser.Id,
                text: string.IsNullOrWhiteSpace(newCommentText) ? "" : newCommentText.Trim(),
                mediaUrl: mediaUrl,
                mediaType: mediaType
            );
            
            newCommentText = string.Empty;
            selectedCommentMediaFile = null;
            uploadedCommentMediaType = null;
            
            // Reload comments
            await LoadBetComments();
            
            // Update comment count cache
            discussionCountsCache[selectedBet.Id] = (discussionCountsCache.GetValueOrDefault(selectedBet.Id, 0)) + 1;
        }
        catch (Exception ex)
        {
            ShowError($"Erro ao adicionar comentário: {ex.Message}");
        }
        finally
        {
            isAddingComment = false;
        }
    }
    
    private async Task DeleteComment(int commentId)
    {
        if (currentUser == null) return;
        
        try
        {
            await BetCommentService.DeleteCommentAsync(commentId, currentUser.Id, isAdmin);
            
            // Reload comments
            await LoadBetComments();
            
            // Update comment count cache
            if (selectedBet != null)
            {
                discussionCountsCache[selectedBet.Id] = Math.Max(0, (discussionCountsCache.GetValueOrDefault(selectedBet.Id, 0)) - 1);
            }
        }
        catch (Exception ex)
        {
            ShowError($"Erro ao eliminar comentário: {ex.Message}");
        }
    }
    
