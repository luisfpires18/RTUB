    // All Bets Modal methods
    private async Task OpenAllBetsModal(Bet bet)
    {
        selectedBetForAllBets = bet;
        allUserBetsForBet = null;
        paginatedUserBetsForBet = new List<UserBetDisplayInfo>();
        allBetsCurrentPage = 1;
        isLoadingAllBets = true;
        modals.Open(ModalType.AllBets);
        StateHasChanged();
        
        try
        {
            // Load all user bets for this bet with user information for display
            var userBets = await UserBetRepository.GetByBetIdWithUsersAsync(bet.Id);
            var betOptions = GetBetOptions(bet.Id);
            
            allUserBetsForBet = userBets.Select(ub => 
            {
                var option = betOptions.FirstOrDefault(o => o.Id == ub.BetOptionId);
                var displayName = ub.User != null 
                    ? ub.User.GetDisplayName() 
                    : "Unknown";
                return new UserBetDisplayInfo
                {
                    UserId = ub.UserId,
                    DisplayName = displayName,
                    AvatarUrl = ub.User?.ProfilePictureSrc,
                    OptionTitle = option?.Title ?? "Unknown",
                    FidelisAmount = ub.FidelisAmount,
                    PotentialWinnings = ub.FidelisAmount * (option?.Odds ?? 1m)
                };
            })
            .OrderByDescending(x => x.FidelisAmount)
            .ToList();
            
            ApplyAllBetsPagination();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading all bets: {ex.Message}");
            allUserBetsForBet = new List<UserBetDisplayInfo>();
        }
        finally
        {
            isLoadingAllBets = false;
            StateHasChanged();
        }
    }
    
    private void CloseAllBetsModal()
    {
        modals.Close(ModalType.AllBets);
        selectedBetForAllBets = null;
        allUserBetsForBet = null;
        paginatedUserBetsForBet = new List<UserBetDisplayInfo>();
    }
    
    private void ApplyAllBetsPagination()
    {
        if (allUserBetsForBet == null) return;
        
        var skip = (allBetsCurrentPage - 1) * allBetsPageSize;
        paginatedUserBetsForBet = allUserBetsForBet.Skip(skip).Take(allBetsPageSize).ToList();
    }
    
    private void HandleAllBetsPageChanged(int newPage)
    {
        allBetsCurrentPage = newPage;
        ApplyAllBetsPagination();
        StateHasChanged();
    }
    
    private void HandleAllBetsPageSizeChanged(int newPageSize)
    {
        allBetsPageSize = newPageSize;
        allBetsCurrentPage = 1;
        ApplyAllBetsPagination();
        StateHasChanged();
    }
