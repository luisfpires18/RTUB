@* View All Bets Modal *@
<Modal Show="@modals.IsOpen(ModalType.AllBets)"
       ShowChanged="@((bool show) => modals.Toggle(ModalType.AllBets, show))"
       Title="@($"Apostas - {selectedBetForAllBets?.Title}")"
       Size="Modal.ModalSize.Large"
       Centered="true">
    <BodyContent>
        @if (isLoadingAllBets)
        {
            <LoadingSpinner Message="A carregar apostas..." />
        }
        else if (allUserBetsForBet == null || !allUserBetsForBet.Any())
        {
            <EmptyState Title="Nenhuma aposta encontrada"
                        Message="Ainda ninguém apostou nesta aposta."
                        Icon="bi-cash-coin" />
        }
        else
        {
            @if (selectedBetForAllBets != null)
            {
                var options = GetBetOptions(selectedBetForAllBets.Id);
                <div class="d-flex flex-wrap justify-content-center gap-3 mb-4">
                    @foreach (var option in options)
                    {
                        var bettorsForOption = allUserBetsForBet!.Where(u => u.OptionTitle == option.Title).ToList();
                        var totalWagered = bettorsForOption.Sum(u => u.FidelisAmount);
                        <div class="bet-option-summary-card">
                            <div class="bet-option-summary-title">@option.Title</div>
                            <div class="bet-option-summary-odds">@option.Odds.ToString("F2")x</div>
                            <div class="bet-option-summary-stats">
                                <span><i class="bi bi-people-fill me-1"></i>@bettorsForOption.Count</span>
                                <span><i class="bi bi-coin me-1"></i>@Fmt(totalWagered)</span>
                            </div>
                        </div>
                    }
                </div>
            }

            <div class="mb-4">
                <h5 class="mb-3"><i class="bi bi-people-fill"></i> Apostas dos Membros</h5>
                <div class="stats-card-grid">
                    @foreach (var userBetInfo in paginatedUserBetsForBet)
                    {
                        <div class="stats-card" @key="userBetInfo.UserId">
                            <div class="stats-card-position">
                                <img src="@(userBetInfo.AvatarUrl ?? "/images/default-avatar.webp")" 
                                     alt="@userBetInfo.DisplayName" 
                                     class="rounded-circle member-avatar-medium" />
                            </div>
                            <div class="stats-card-content">
                                <div class="stats-card-title">@userBetInfo.DisplayName</div>
                                <div class="stats-card-subtitle">@userBetInfo.OptionTitle</div>
                            </div>
                            <div class="stats-card-count d-flex flex-column align-items-end">
                                <span class="text-warning fw-bold">
                                    <i class="bi bi-coin"></i> @Fmt(userBetInfo.FidelisAmount)
                                </span>
                                <small class="text-success">
                                    <i class="bi bi-trophy"></i> @Fmt(userBetInfo.PotentialWinnings)
                                </small>
                            </div>
                        </div>
                    }
                </div>
                @if (allUserBetsForBet.Count > allBetsPageSize)
                {
                    <TablePagination 
                        CurrentPage="@allBetsCurrentPage"
                        PageSize="@allBetsPageSize"
                        TotalItems="@allUserBetsForBet.Count"
                        ItemLabel="apostas"
                        PageSizeOptions="@(new[] { 5, 10, 15, 20, 25 })"
                        OnPageChanged="@HandleAllBetsPageChanged"
                        OnPageSizeChanged="@HandleAllBetsPageSizeChanged" />
                }
            </div>
        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="CloseAllBetsModal">Voltar Atrás</button>
    </FooterContent>
</Modal>

<!-- Mobile Bottom Nav -->
<MobileBottomNav Items="@mobileNavItems" ActiveKey="" OnSelect="HandleMobileNavSelect" />

@code {
    // Helpers
    private static string Fmt(decimal value) => NumberFormatter.Compact(value);

    // User and auth
    private ApplicationUser? currentUser;
    private bool isAdmin = false;
    private IReadOnlyList<MobileBottomNav.MobileNavItem> mobileNavItems = new List<MobileBottomNav.MobileNavItem> { new("action-add", "Adicionar", "bi-plus-lg") };

    // Bets data
    private List<Bet> futureBets = new();
    private List<Bet> pastBets = new();
    private List<Bet> filteredPastBets = new();
    private Dictionary<int, UserBet?> userBetsCache = new();
    private Dictionary<int, List<BetOption>> betOptionsCache = new();
    private Dictionary<int, int> discussionCountsCache = new();

    // Pagination
    private int futureBetsCurrentPage = 1;
    private int futureBetsPageSize = 9;
    private List<Bet> paginatedFutureBets = new();

    private int pastBetsCurrentPage = 1;
    private int pastBetsPageSize = 9;
    private List<Bet> paginatedPastBets = new();
    private string pastBetsSearch = string.Empty;

    // Modals
    private enum ModalType { Edit, Delete, PlaceBet, Details, Resolve, Success, ResolveSuccess, DeleteComment, PushNotification, AllBets, Cropper, Error }
    private readonly MultiModalState<ModalType> modals = new();
    private string errorMessage = string.Empty;
    private bool isCreateMode = false;
    private bool isSaving = false;
    private bool isSendingPushNotification = false;
    private bool isLoadingAllBets = false;
    private int? deletingCommentId = null;
    private Bet? selectedBetForPush = null;
    private Bet? selectedBetForAllBets = null;
    
    // All Bets Modal data
    private List<UserBetDisplayInfo>? allUserBetsForBet;
    private List<UserBetDisplayInfo> paginatedUserBetsForBet = new();
    private int allBetsCurrentPage = 1;
    private int allBetsPageSize = 10;
    

    // Edit/Create
    private Bet? editingBet;
    private Bet? deletingBet;
    private Bet? selectedBet;
    private ImageUploadManager? imageUploadManager;
    private IBrowserFile? selectedImageFile;
    
    // Image Cropper
    private ImageCropper? imageCropper;
    private string? uploadedImagePath;
    
    // Cropped image for BetCard display
    private byte[]? croppedImageBytes;
    private string? croppedImageFileName = "bet-image.webp";
    
    // Original image for full display (not cropped) - reserved for future use
    private byte[]? originalImageBytes;
    private string? originalImageFileName;
    private string? originalImageContentType;

    // Place Bet
    private int selectedBetOptionId = 0;
    private decimal betAmount = 0;

    // Resolve Bet
    private int selectedWinningOptionId = 0;
    
    // Comments in Details Modal (using BetComment instead of Post)
    private List<BetCommentDto>? betComments;
    private string newCommentText = string.Empty;
    private bool isAddingComment = false;
    private MediaUploadManager? commentMediaUploadManager;
    private IBrowserFile? selectedCommentMediaFile;
    private string? uploadedCommentMediaType;
    
    // MATCH category - member selection
    private List<ApplicationUser> selectedMatchMembers = new();
    private List<ApplicationUser> allMembers = new();
    private List<ApplicationUser> filteredAvailableMembersForMatch = new();
    private string matchMemberSearchTerm = string.Empty;
    private Dictionary<string, decimal> memberOdds = new();
    private const decimal DEFAULT_MATCH_ODDS = 1.50m;
    private bool membersLoaded = false;
    
    // DECISION category - custom options
    private List<DecisionOptionModel> decisionOptions = new();
    
    /// <summary>
    /// Validates whether the bet form has all required fields filled correctly.
    /// </summary>
    private bool IsFormValid
    {
        get
        {
            if (editingBet == null) return false;
            if (string.IsNullOrWhiteSpace(editingBet.Title)) return false;

            if (editingBet.BetCategory == BetCategory.MATCH)
            {
                if (selectedMatchMembers.Count != 2) return false;
                foreach (var member in selectedMatchMembers)
                {
                    if (!memberOdds.TryGetValue(member.Id, out var odds) || odds < 1.01m)
                        return false;
                }
            }
            else if (editingBet.BetCategory == BetCategory.DECISION)
            {
                var validOptions = decisionOptions.Count(o => !string.IsNullOrWhiteSpace(o.Title) && o.Odds >= 1.01m);
                if (validOptions < 2) return false;
            }

            return true;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            currentUser = await UserManager.GetUserAsync(user);
            isAdmin = user.IsInRole("Admin");
        }

        await LoadBets();
        // Don't load members on initialization - will be loaded when MATCH modal is opened
    }

    private async Task HandleMobileNavSelect(string key)
    {
        if (key == "action-add") await OpenCreateModal();
    }

    private async Task LoadAllMembers()
    {
        if (membersLoaded) return; // Avoid reloading
        
        try
        {
            // Load all users for member selection - include ALL members (expelled, retired, etc.)
            // For now, limit to first 100 users ordered by name
            allMembers = await UserManager.Users
                .OrderBy(u => u.FirstName)
                .ThenBy(u => u.LastName)
                .Take(100)
                .ToListAsync();
            membersLoaded = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading members: {ex.Message}");
        }
    }
    
    // DECISION options methods
    private void AddDecisionOption()
    {
        var maxId = decisionOptions.Any() ? decisionOptions.Max(o => o.Id) : 0;
        decisionOptions.Add(new DecisionOptionModel
        {
            Id = maxId + 1,
            Title = string.Empty,
            Odds = DEFAULT_MATCH_ODDS
        });
    }
    
    private void RemoveDecisionOption(DecisionOptionModel option)
    {
        decisionOptions.Remove(option);
    }

    private async Task LoadBets()
    {
        try
        {
            var futureBetsTask = BetService.GetFutureBetsAsync();
            var pastBetsTask = BetService.GetPastBetsAsync();

            await Task.WhenAll(futureBetsTask, pastBetsTask);

            futureBets = (await futureBetsTask).OrderBy(b => b.DateTime).ToList();
            pastBets = (await pastBetsTask).OrderByDescending(b => b.DateTime).ToList();
            filteredPastBets = pastBets;

            // Load user bets and options for all bets
            if (currentUser != null)
            {
                var userBets = await BetService.GetUserBetsAsync(currentUser.Id);
                userBetsCache = userBets.ToDictionary(ub => ub.BetId, ub => (UserBet?)ub);
            }

            // Batch load bet options and discussion counts for all bets to avoid N+1 queries
            var allBetIds = futureBets.Concat(pastBets).Select(b => b.Id).ToList();
            
            if (allBetIds.Any())
            {
                // Batch load bet options
                var betOptionsDict = await BetService.GetBetOptionsByBetIdsAsync(allBetIds);
                foreach (var kvp in betOptionsDict)
                {
                    betOptionsCache[kvp.Key] = kvp.Value;
                }
                
                // Batch load discussion counts
                var discussionCountsDict = await BetCommentService.GetCommentCountsByBetIdsAsync(allBetIds);
                foreach (var kvp in discussionCountsDict)
                {
                    discussionCountsCache[kvp.Key] = kvp.Value;
                }
            }

            ApplyFutureBetsPagination();
            ApplyPastBetsFiltersAndPagination();
        }
        catch (Exception ex)
        {
            // Log error
            Console.WriteLine($"Error loading bets: {ex.Message}");
        }
    }

    private void ApplyFutureBetsPagination()
    {
        var skip = (futureBetsCurrentPage - 1) * futureBetsPageSize;
        paginatedFutureBets = futureBets.Skip(skip).Take(futureBetsPageSize).ToList();
    }

    private void ApplyPastBetsFiltersAndPagination()
    {
        filteredPastBets = pastBets;

        if (!string.IsNullOrWhiteSpace(pastBetsSearch))
        {
            var search = pastBetsSearch.ToLower();
            filteredPastBets = pastBets.Where(b =>
                b.Title.ToLower().Contains(search) ||
                (b.Description?.ToLower().Contains(search) ?? false) ||
                (b.Location?.ToLower().Contains(search) ?? false)
            ).ToList();
        }

        var skip = (pastBetsCurrentPage - 1) * pastBetsPageSize;
        paginatedPastBets = filteredPastBets.Skip(skip).Take(pastBetsPageSize).ToList();
    }

    private UserBet? GetUserBet(int betId)
    {
        return userBetsCache.TryGetValue(betId, out var userBet) ? userBet : null;
    }

    private List<BetOption> GetBetOptions(int betId)
    {
        return betOptionsCache.TryGetValue(betId, out var options) ? options : new List<BetOption>();
    }

    private int GetDiscussionCount(int betId)
    {
        return discussionCountsCache.TryGetValue(betId, out var count) ? count : 0;
    }

    private async Task<int> GetDiscussionPostCount(int betId)
    {
        try
        {
            // Use efficient count query instead of loading all comments
            return await BetCommentService.GetCommentCountForBetAsync(betId);
        }
        catch { }
        return 0;
    }

    private string GetBetImageUrl(string? imageSrc)
    {
        if (string.IsNullOrEmpty(imageSrc)) return "/images/default-bet.webp";
        return imageSrc;
    }

    // Pagination handlers
    private Task HandleFutureBetsPageChange(int newPage)
    {
        futureBetsCurrentPage = newPage;
        ApplyFutureBetsPagination();
        return Task.CompletedTask;
    }

    private Task HandleFutureBetsPageSizeChange(int newPageSize)
    {
        futureBetsPageSize = newPageSize;
        futureBetsCurrentPage = 1;
        ApplyFutureBetsPagination();
        return Task.CompletedTask;
    }

    private Task HandlePastBetsPageChange(int newPage)
    {
        pastBetsCurrentPage = newPage;
        ApplyPastBetsFiltersAndPagination();
        return Task.CompletedTask;
    }

    private Task HandlePastBetsPageSizeChange(int newPageSize)
    {
        pastBetsPageSize = newPageSize;
        pastBetsCurrentPage = 1;
        ApplyPastBetsFiltersAndPagination();
        return Task.CompletedTask;
    }

    private Task HandlePastBetsSearch(string searchTerm)
    {
        pastBetsSearch = searchTerm;
        pastBetsCurrentPage = 1;
        ApplyPastBetsFiltersAndPagination();
        return Task.CompletedTask;
    }
    
    // Helper method to calculate potential winnings for display
    private string GetPotentialWinnings(int betId)
    {
        var userBet = GetUserBet(betId);
        if (userBet == null) return "N/A";
        
        var option = GetBetOptions(betId).FirstOrDefault(o => o.Id == userBet.BetOptionId);
        if (option == null) return "N/A";
        
        var winnings = userBet.FidelisAmount * option.Odds;
        return $"{Fmt(winnings)} Fidelis";
    }

    // Modal handlers
    private async Task OpenCreateModal()
    {
        isCreateMode = true;
        editingBet = new Bet
        {
            Title = string.Empty,
            Description = string.Empty,
            Location = string.Empty,
            DateTime = DateTime.Now.AddDays(7),
            BetCategory = BetCategory.DECISION
        };
        selectedImageFile = null;
        uploadedImagePath = null;
        originalImageBytes = null;
        originalImageFileName = null;
        originalImageContentType = null;
        selectedMatchMembers.Clear();
        memberOdds.Clear();
        matchMemberSearchTerm = string.Empty;
        filteredAvailableMembersForMatch.Clear();
        decisionOptions.Clear();
        
        // Load members when modal is opened (for MATCH category member selection)
        await LoadAllMembers();
        
        modals.Open(ModalType.Edit);
    }

    private async Task OpenEditModal(Bet bet)
    {
        isCreateMode = false;
        editingBet = bet;
        selectedImageFile = null;
        uploadedImagePath = null;
        originalImageBytes = null;
        originalImageFileName = null;
        originalImageContentType = null;
        
        // Load members when modal is opened (for admins and creators who can edit bets)
        await LoadAllMembers();

        // Populate existing options for the bet being edited
        selectedMatchMembers.Clear();
        memberOdds.Clear();
        matchMemberSearchTerm = string.Empty;
        filteredAvailableMembersForMatch.Clear();
        decisionOptions.Clear();

        var existingOptions = GetBetOptions(bet.Id);
        if (bet.BetCategory == BetCategory.MATCH)
        {
            foreach (var option in existingOptions)
            {
                // For MATCH, MemberAId is the "winning" member for that option
                if (!string.IsNullOrEmpty(option.MemberAId))
                {
                    var member = allMembers.FirstOrDefault(m => m.Id == option.MemberAId);
                    if (member != null && !selectedMatchMembers.Any(m => m.Id == member.Id))
                    {
                        selectedMatchMembers.Add(member);
                        memberOdds[member.Id] = option.Odds;
                    }
                }
            }
        }
        else if (bet.BetCategory == BetCategory.DECISION)
        {
            foreach (var option in existingOptions)
            {
                decisionOptions.Add(new DecisionOptionModel
                {
                    Id = option.Id,
                    Title = option.Title,
                    Odds = option.Odds
                });
            }
        }
        
        modals.Open(ModalType.Edit);
    }

    private void CloseEditModal()
    {
        modals.Close(ModalType.Edit);
        editingBet = null;
        selectedImageFile = null;
        uploadedImagePath = null;
        originalImageBytes = null;
        originalImageFileName = null;
        originalImageContentType = null;
        selectedMatchMembers.Clear();
        memberOdds.Clear();
        decisionOptions.Clear();
    }

    private async Task SaveBet()
    {
        if (editingBet == null) return;

        isSaving = true;
        try
        {
            if (isCreateMode)
            {
                var normalizedName = S3KeyNormalizer.NormalizeForS3Key(editingBet.Title);
                
                // Upload original image (shown in DetailsModal)
                if (originalImageBytes != null && originalImageBytes.Length > 0)
                {
                    using var stream = new MemoryStream(originalImageBytes);
                    var imageUrl = await ImageStorageService.UploadImageAsync(stream, originalImageFileName ?? "bet-image", originalImageContentType ?? "image/webp", "bets", normalizedName);
                    editingBet.SetImage(imageUrl);
                }
                
                // Upload cropped thumbnail (shown on BetCard)
                if (croppedImageBytes != null && croppedImageBytes.Length > 0)
                {
                    using var stream = new MemoryStream(croppedImageBytes);
                    var thumbnailUrl = await ImageStorageService.UploadImageAsync(stream, croppedImageFileName!, "image/webp", "bets/thumbnails", normalizedName);
                    editingBet.SetThumbnail(thumbnailUrl);
                }
                
                // Create the bet first
                var createdBet = await BetService.CreateBetAsync(editingBet);
                
                // Note: Discussion for bets is no longer needed since we use BetComment directly
                
                // If MATCH category, create bet options for the selected members
                if (editingBet.BetCategory == BetCategory.MATCH && selectedMatchMembers.Count == 2)
                {
                    var member1 = selectedMatchMembers[0];
                    var member2 = selectedMatchMembers[1];
                    
                    // Use TryGetValue to avoid double dictionary lookup
                    var odds1 = memberOdds.TryGetValue(member1.Id, out var odds1Value) ? odds1Value : DEFAULT_MATCH_ODDS;
                    var odds2 = memberOdds.TryGetValue(member2.Id, out var odds2Value) ? odds2Value : DEFAULT_MATCH_ODDS;
                    
                    // Create option for member1 winning (includes both member IDs for reference)
                    var option1 = BetOption.CreateMatchOption(
                        betId: createdBet.Id,
                        title: $"{member1.GetDisplayName()} vence",
                        odds: odds1,
                        memberAId: member1.Id,
                        memberBId: member2.Id
                    );
                    await BetOptionRepository.AddAsync(option1);
                    
                    // Create option for member2 winning
                    var option2 = BetOption.CreateMatchOption(
                        betId: createdBet.Id,
                        title: $"{member2.GetDisplayName()} vence",
                        odds: odds2,
                        memberAId: member2.Id,
                        memberBId: member1.Id
                    );
                    await BetOptionRepository.AddAsync(option2);
                }
                
                // If DECISION category, create bet options from the custom list
                if (editingBet.BetCategory == BetCategory.DECISION && decisionOptions.Any())
                {
                    foreach (var decisionOption in decisionOptions.Where(o => !string.IsNullOrWhiteSpace(o.Title)))
                    {
                        var betOption = BetOption.CreateDecisionOption(
                            betId: createdBet.Id,
                            title: decisionOption.Title.Trim(),
                            odds: decisionOption.Odds
                        );
                        await BetOptionRepository.AddAsync(betOption);
                    }
                }
                
                // Send push notification for new bet to all subscribers
                try
                {
                    var baseUrl = Navigation.BaseUri.TrimEnd('/');
                    var notification = PushNotificationFactory.CreateBetNotification(createdBet, baseUrl);
                    await PushNotificationService.BroadcastAsync(notification);
                }
                catch
                {
                    // Silently fail push notification - don't block bet creation
                }
            }
            else
            {
                // Verify ownership: only admin or creator can update
                if (!isAdmin && editingBet.CreatedBy != currentUser?.UserName)
                {
                    ShowError("Não tem permissão para editar esta aposta.");
                    return;
                }

                // Update mode - upload new images if provided
                if (uploadedImagePath != null)
                {
                    var normalizedName = S3KeyNormalizer.NormalizeForS3Key(editingBet.Title);
                    
                    // Upload new original image (shown in DetailsModal)
                    if (originalImageBytes != null && originalImageBytes.Length > 0)
                    {
                        using var stream = new MemoryStream(originalImageBytes);
                        var imageUrl = await ImageStorageService.UploadImageAsync(stream, originalImageFileName ?? "bet-image", originalImageContentType ?? "image/webp", "bets", normalizedName);
                        editingBet.SetImage(imageUrl);
                    }
                    
                    // Upload new cropped thumbnail (shown on BetCard)
                    if (croppedImageBytes != null && croppedImageBytes.Length > 0)
                    {
                        using var stream = new MemoryStream(croppedImageBytes);
                        var thumbnailUrl = await ImageStorageService.UploadImageAsync(stream, croppedImageFileName!, "image/webp", "bets/thumbnails", normalizedName);
                        editingBet.SetThumbnail(thumbnailUrl);
                    }
                }
                await BetService.UpdateBetAsync(editingBet);
            }

            await LoadBets();
            CloseEditModal();
        }
        catch (Exception ex)
        {
            // Show error to user
            ShowError($"Erro ao guardar aposta: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

