@page "/bets"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using RTUB.Application.Interfaces
@using RTUB.Application.Extensions
@using RTUB.Application.Utilities
@using RTUB.Application.DTOs
@using RTUB.Core.Entities
@using RTUB.Core.Enums
@using RTUB.Core.Helpers
@using RTUB.Shared
@using RTUB.Shared.Base
@inject IBetService BetService
@inject IBetOptionRepository BetOptionRepository
@inject IUserBetRepository UserBetRepository
@inject IBetCommentService BetCommentService
@inject IImageStorageService ImageStorageService
@inject IPushNotificationService PushNotificationService
@inject IPushNotificationFactory PushNotificationFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation
@attribute [Authorize]

<PageTitle>Apostas - RTUB</PageTitle>

<div class="bets-page container-fluid">
    <div class="page-header-centered">
        <div class="page-header-left"></div>
        <div class="page-header-center">
            <h1><i class="bi bi-cash-coin"></i> Apostas</h1>
            <p class="lead page-header-subtitle text-light-theme">
                Próximas apostas e resultados anteriores.
                @if (currentUser != null)
                {
                    <br />
                    <span class="badge bg-success mt-2">
                        <i class="bi bi-coin me-1"></i>
                        Saldo: @Fmt(currentUser.FidelisBalance) Fidelis
                    </span>
                }
            </p>
        </div>
        <div class="page-header-right d-none d-xl-flex">
            <button class="btn btn-success" @onclick="OpenCreateModal" title="Adicionar Nova Aposta">
                <i class="bi bi-plus-lg"></i> Adicionar Aposta
            </button>
        </div>
    </div>
        
    <!-- Purple Alert - Fidelis information -->
    <Alert Type="Alert.AlertType.Purple" 
           Icon="bi-coin"
           Message=" Ganhe Fidelis jogando jogos! O seu saldo atual pode ser usado para apostar em duelos, decisões, entre outros!" />

    @if (futureBets == null || pastBets == null)
    {
        <LoadingSpinner />
    }
    else if (!futureBets.Any() && !pastBets.Any())
    {
        <EmptyState Title="Nenhuma aposta encontrada"
                    Message="Ainda não há apostas disponíveis. Aguarde novidades!"
                    Icon="bi-cash-coin" />
    }
    else
    {
        @* Future Bets Section *@
        @if (futureBets.Any())
        {
            <div class="mb-4">
                <h2 class="mb-3">Apostas Futuras</h2>
                <div class="row g-3">
                    @foreach (var bet in paginatedFutureBets)
                    {
                        <div class="col-12 col-sm-6 col-md-4 mb-3" @key="bet.Id">
                            @{
                                var userBet = GetUserBet(bet.Id);
                                var betOptions = GetBetOptions(bet.Id);
                                var discussionCount = GetDiscussionCount(bet.Id);
                            }
                             <BetCard Bet="@bet"
                                     UserBet="@userBet"
                                     BetOptions="@betOptions"
                                     DiscussionCount="@discussionCount"
                                     IsAdmin="@isAdmin"
                                     IsCreator="@(bet.CreatedBy == currentUser?.UserName)"
                                     IsResolvable="@((isAdmin || bet.CreatedBy == currentUser?.UserName) && bet.DateTime.Date <= DateTime.Today)"
                                     IsPastBet="false"
                                     OnEdit="@(() => OpenEditModal(bet))"
                                     OnDelete="@(() => OpenDeleteModal(bet))"
                                     OnResolve="@(() => OpenResolveModal(bet))"
                                     OnSendPushNotification="@(() => OpenPushNotificationModal(bet))"
                                     OnPlaceBet="@(() => OpenPlaceBetModal(bet))"
                                     OnViewDetails="@(() => OpenBetDetailsModal(bet))"
                                     OnViewAllBets="@(() => OpenAllBetsModal(bet))" />
                        </div>
                    }
                </div>

                @if (futureBets.Count > futureBetsPageSize)
                {
                    <TablePagination CurrentPage="@futureBetsCurrentPage"
                                     PageSize="@futureBetsPageSize"
                                     TotalItems="@futureBets.Count"
                                     ItemLabel="apostas"
                                     PageSizeOptions="@(new[] { 9, 18, 27, 36, 45 })"
                                     OnPageChanged="@HandleFutureBetsPageChange"
                                     OnPageSizeChanged="@HandleFutureBetsPageSizeChange" />
                }
            </div>
        }

        @* Previous Bets Section *@
        <hr class="my-5" />

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2>Apostas Anteriores</h2>
        </div>

        <SearchBar @bind-Value="pastBetsSearch"
                   Placeholder="Pesquisar apostas anteriores..."
                   OnSearch="@HandlePastBetsSearch" />

        @if (!filteredPastBets.Any())
        {
            <EmptyState Title="Nenhuma aposta anterior encontrada"
                        Message="Não existem apostas passadas para mostrar."
                        Icon="bi-calendar-x" />
        }
        else
        {
            <div class="row g-3">
                @foreach (var bet in paginatedPastBets)
                {
                    <div class="col-12 col-sm-6 col-md-4 mb-3" @key="bet.Id">
                        @{
                            var userBet = GetUserBet(bet.Id);
                            var betOptions = GetBetOptions(bet.Id);
                            var discussionCount = GetDiscussionCount(bet.Id);
                        }
                        <BetCard Bet="@bet"
                                 UserBet="@userBet"
                                 BetOptions="@betOptions"
                                 DiscussionCount="@discussionCount"
                                 IsAdmin="@isAdmin"
                                 IsCreator="@(bet.CreatedBy == currentUser?.UserName)"
                                 IsResolvable="@(isAdmin || bet.CreatedBy == currentUser?.UserName)"
                                 IsPastBet="true"
                                 OnEdit="@(() => OpenEditModal(bet))"
                                 OnDelete="@(() => OpenDeleteModal(bet))"
                                 OnResolve="@(() => OpenResolveModal(bet))"
                                 OnViewDetails="@(() => OpenBetDetailsModal(bet))"
                                 OnViewAllBets="@(() => OpenAllBetsModal(bet))" />
                    </div>
                }
            </div>

            @if (filteredPastBets.Count > pastBetsPageSize)
            {
                <TablePagination CurrentPage="@pastBetsCurrentPage"
                                 PageSize="@pastBetsPageSize"
                                 TotalItems="@filteredPastBets.Count"
                                 ItemLabel="apostas"
                                 PageSizeOptions="@(new[] { 9, 18, 27, 36, 45 })"
                                 OnPageChanged="@HandlePastBetsPageChange"
                                 OnPageSizeChanged="@HandlePastBetsPageSizeChange" />
            }
        }
    }
</div>

@* Create/Edit Bet Modal *@
<Modal Show="@modals.IsOpen(ModalType.Edit)"
       ShowChanged="@((bool show) => modals.Toggle(ModalType.Edit, show))"
       Title="@(isCreateMode ? "Criar Nova Aposta" : "Editar Aposta")"
       Size="Modal.ModalSize.Large"
       Centered="true">
    <BodyContent>
        @if (editingBet != null)
        {
            <EditForm Model="editingBet" OnValidSubmit="SaveBet" id="editBetForm">
                <DataAnnotationsValidator />
                <ErrorDisplay />

                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-cash-coin text-primary me-2"></i>Título da Aposta
                    </label>
                    <InputText class="form-control" @bind-Value="editingBet.Title" />
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-calendar3 text-primary me-2"></i>Data e Hora
                        </label>
                        <InputDate Type="InputDateType.DateTimeLocal" class="form-control" @bind-Value="editingBet.DateTime" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-tag text-primary me-2"></i>Categoria
                        </label>
                        <InputSelect class="form-select" @bind-Value="editingBet.BetCategory">
                            <option value="@BetCategory.MATCH">Duelo (entre dois membros)</option>
                            <option value="@BetCategory.DECISION">Decisão (opções personalizadas)</option>
                        </InputSelect>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-geo-alt text-primary me-2"></i>Localização
                    </label>
                    <InputText class="form-control" @bind-Value="editingBet.Location" />
                </div>

                <ImageUploadManager @ref="imageUploadManager"
                                    Label="Imagem da Aposta"
                                    CurrentImageUrl="@(!string.IsNullOrEmpty(editingBet.ImageSrc) ? GetBetImageUrl(editingBet.ImageSrc) : null)"
                                    ShowCurrentImage="true"
                                    PreviewCssClass="slideshow-preview"
                                    OnFileSelected="HandleImageSelected" />

                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-text-paragraph text-primary me-2"></i>Descrição
                    </label>
                    <InputTextArea class="form-control" rows="4" @bind-Value="editingBet.Description" />
                </div>

                @* MATCH Category - Member Selection *@
                @if (editingBet.BetCategory == BetCategory.MATCH)
                {
                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-people text-primary me-2"></i>Membros do Duelo
                        </label>
                        
                        @* Selected members as chips with odds *@
                        @if (selectedMatchMembers.Any())
                        {
                            <div class="selected-members-chips mb-2">
                                @foreach (var member in selectedMatchMembers)
                                {
                                    <div class="member-chip-with-odds mb-2" @key="member.Id">
                                        <span class="member-chip">
                                            <img src="@member.ProfilePictureSrc" alt="@member.GetDisplayName()" class="member-chip-avatar" />
                                            <span class="member-chip-name">@member.GetDisplayName()</span>
                                            <button type="button" class="member-chip-remove" @onclick="() => RemoveMatchMember(member)" title="Remover">
                                                <i class="bi bi-x"></i>
                                            </button>
                                        </span>
                                        <div class="odds-input-container">
                                            <label class="form-label small mb-1">Odds:</label>
                                            <input type="number" 
                                                   class="form-control form-control-sm" 
                                                   step="0.01" 
                                                   min="1.01" 
                                                   max="999.99"
                                                   @bind="memberOdds[member.Id]"
                                                   placeholder="1.50" />
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        
                        @* Can only select 2 members for MATCH *@
                        @if (selectedMatchMembers.Count < 2)
                        {
                            <SearchBar @bind-Value="matchMemberSearchTerm"
                                       Placeholder="Pesquisar membro por nome..."
                                       OnSearch="@HandleMatchMemberSearchChanged"
                                       Compact="true" />
                            
                            @if (!string.IsNullOrWhiteSpace(matchMemberSearchTerm) && filteredAvailableMembersForMatch.Any())
                            {
                                <div class="member-list member-list-scrollable mt-2 member-list-scrollable-override">
                                    @foreach (var member in filteredAvailableMembersForMatch)
                                    {
                                        <div class="member-item p-2 mb-2 border rounded clickable-row"
                                             @onclick="() => AddMatchMember(member)">
                                            <div class="d-flex align-items-center">
                                                <img src="@member.ProfilePictureSrc" alt="@member.GetDisplayName()"
                                                     class="member-avatar-small me-2" />
                                                <div>
                                                    <strong>@member.GetDisplayName()</strong>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else if (!string.IsNullOrWhiteSpace(matchMemberSearchTerm))
                            {
                                <p class="text-muted mt-2 small">Nenhum membro encontrado.</p>
                            }
                        }
                        else
                        {
                            <p class="text-muted small">Máximo de 2 membros selecionados para o duelo.</p>
                        }

                        @if (selectedMatchMembers.Count == 2 && selectedMatchMembers.Any(m => !memberOdds.TryGetValue(m.Id, out var o) || o < 1.01m))
                        {
                            <p class="text-danger small mt-2"><i class="bi bi-exclamation-triangle me-1"></i>Defina odds válidas (≥ 1.01) para ambos os membros.</p>
                        }
                    </div>
                }
                
                @* DECISION Category - Custom Options *@
                @if (editingBet.BetCategory == BetCategory.DECISION)
                {
                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-list-check text-primary me-2"></i>Opções de Aposta
                        </label>
                        
                        @* Existing decision options *@
                        @foreach (var option in decisionOptions)
                        {
                            <div class="d-flex align-items-center gap-2 mb-2" @key="option.Id">
                                <input type="text" 
                                       class="form-control" 
                                       @bind="option.Title" 
                                       placeholder="Nome da opção..." />
                                <input type="number" 
                                       class="form-control odds-input-narrow" 
                                       step="0.01" 
                                       min="1.01" 
                                       max="999.99"
                                       @bind="option.Odds"
                                       placeholder="Odds" />
                                <button type="button" 
                                        class="btn btn-outline-danger btn-sm" 
                                        @onclick="() => RemoveDecisionOption(option)" 
                                        title="Remover opção">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                        }
                        
                        <button type="button" class="btn btn-outline-primary btn-sm" @onclick="AddDecisionOption">
                            <i class="bi bi-plus-lg me-1"></i>Adicionar Opção
                        </button>
                        
                        @if (!decisionOptions.Any())
                        {
                            <p class="text-muted small mt-2">Adicione pelo menos 2 opções para a aposta.</p>
                        }
                        else if (decisionOptions.Count(o => !string.IsNullOrWhiteSpace(o.Title) && o.Odds >= 1.01m) < 2)
                        {
                            <p class="text-danger small mt-2"><i class="bi bi-exclamation-triangle me-1"></i>Preencha pelo menos 2 opções com título e odds válidas (≥ 1.01).</p>
                        }
                    </div>
                }

            </EditForm>
        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="CloseEditModal">Cancelar</button>
        <button type="submit" form="editBetForm" class="btn btn-primary btn-primary-purple" disabled="@(isSaving || !IsFormValid)">
            @if (isSaving)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
            }
            Guardar
        </button>
    </FooterContent>
</Modal>

@* Delete Confirmation Modal *@
<ConfirmDialog Show="@modals.IsOpen(ModalType.Delete)"
               ShowChanged="@((bool show) => modals.Toggle(ModalType.Delete, show))"
               Title="Confirmar Eliminação"
               Message="@($"Tem a certeza de que pretende eliminar a aposta {deletingBet?.Title}?")"
               WarningMessage="Esta ação não pode ser anulada e todos os participantes serão reembolsados."
               ConfirmText="Eliminar"
               CancelText="Cancelar"
               ConfirmButtonClass="btn-danger"
               OnConfirm="DeleteBet"
               OnCancel="CloseDeleteModal" />

@* Success Dialog for Bet Placement *@
<ConfirmDialog Show="@modals.IsOpen(ModalType.Success)"
               ShowChanged="@((bool show) => modals.Toggle(ModalType.Success, show))"
               Title="Aposta Realizada"
               Message="Aposta realizada com sucesso!"
               ConfirmText="OK"
               CancelText=""
               ConfirmButtonClass="btn-success"
               ShowCloseButton="false"
               OnConfirm="CloseSuccessModal"
               OnCancel="CloseSuccessModal" />

@* Success Dialog for Bet Resolution *@
<ConfirmDialog Show="@modals.IsOpen(ModalType.ResolveSuccess)"
               ShowChanged="@((bool show) => modals.Toggle(ModalType.ResolveSuccess, show))"
               Title="Aposta Resolvida"
               Message="Aposta resolvida com sucesso!"
               ConfirmText="OK"
               CancelText=""
               ConfirmButtonClass="btn-success"
               ShowCloseButton="false"
               OnConfirm="CloseResolveSuccessModal"
               OnCancel="CloseResolveSuccessModal" />

@* Delete Comment Confirmation *@
<ConfirmDialog Show="@modals.IsOpen(ModalType.DeleteComment)"
               ShowChanged="@((bool show) => modals.Toggle(ModalType.DeleteComment, show))"
               Title="Confirmar Eliminação"
               Message="Tem a certeza de que pretende eliminar este comentário?"
               ConfirmText="Eliminar"
               CancelText="Cancelar"
               ConfirmButtonClass="btn-danger"
               OnConfirm="ConfirmDeleteComment"
               OnCancel="CloseDeleteCommentModal" />

@* Error Dialog (replaces browser alert()) *@
<ConfirmDialog Show="@modals.IsOpen(ModalType.Error)"
               ShowChanged="@((bool show) => modals.Toggle(ModalType.Error, show))"
               Title="Erro"
               Message="@errorMessage"
               ConfirmText="OK"
               CancelText=""
               ConfirmButtonClass="btn-danger"
               ShowCloseButton="false"
               OnConfirm="CloseErrorModal"
               OnCancel="CloseErrorModal" />

@* Push Notification Modal (Admin Only) *@
<Modal Show="@modals.IsOpen(ModalType.PushNotification)"
       ShowChanged="@((bool show) => modals.Toggle(ModalType.PushNotification, show))"
       Title="Notificar por Push"
       Size="Modal.ModalSize.Default"
       Centered="true">
    <BodyContent>
        <div class="mb-3">
            <p class="mb-2">
                <i class="bi bi-bell text-primary me-2"></i>
                Será enviada uma notificação push para todos os utilizadores subscritos.
            </p>
            @if (selectedBetForPush != null)
            {
                <EmptyState Title="Aposta selecionada"
                            Message="@($"Aposta: {selectedBetForPush.Title} • Data: {selectedBetForPush.DateTime:dd/MM/yyyy HH:mm}")"
                            Icon="bi-megaphone" />
            }
        </div>
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="ClosePushNotificationModal" disabled="@isSendingPushNotification">Cancelar</button>
        <button type="button" class="btn btn-primary" @onclick="SendBetPushNotification" disabled="@isSendingPushNotification">
            @if (isSendingPushNotification)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
            }
            Enviar Notificação
        </button>
    </FooterContent>
</Modal>

@* Place Bet Modal *@
<Modal Show="@modals.IsOpen(ModalType.PlaceBet)"
       ShowChanged="@((bool show) => modals.Toggle(ModalType.PlaceBet, show))"
       Title="@($"Apostar - {selectedBet?.Title}")"
       Size="Modal.ModalSize.Default"
       Centered="true">
    <BodyContent>
        @if (selectedBet != null && currentUser != null)
        {
            <div class="mb-3">
                <div class="d-flex align-items-center justify-content-center">
                    <span class="badge badge-purple">
                        <i class="bi bi-coin me-2"></i>
                        <strong>Saldo Atual:</strong> @currentUser.FidelisBalance.ToString("N2") Fidelis
                    </span>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <i class="bi bi-list-check text-primary me-2"></i>Opção
                </label>
                <select class="form-select" @bind="selectedBetOptionId">
                    <option value="0">Selecione uma opção...</option>
                    @foreach (var option in GetBetOptions(selectedBet.Id))
                    {
                        <option value="@option.Id" @key="option.Id">@option.Title (Odds: @option.Odds.ToString("F2")x)</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <i class="bi bi-cash text-primary me-2"></i>Montante de Fidelis
                </label>
                <input type="number" class="form-control" @bind="betAmount" min="0.01" step="0.01" max="@currentUser.FidelisBalance" />
                @if (selectedBetOptionId > 0 && betAmount > 0)
                {
                    var selectedOption = GetBetOptions(selectedBet.Id).FirstOrDefault(o => o.Id == selectedBetOptionId);
                    if (selectedOption != null)
                    {
                        var potentialWinnings = betAmount * selectedOption.Odds;
                        <small class="text-purple">
                            <i class="bi bi-trophy me-1"></i>
                            Ganhos potenciais: @Fmt(potentialWinnings) Fidelis
                        </small>
                    }
                }
            </div>

        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="ClosePlaceBetModal">Cancelar</button>
        <button type="button" class="btn btn-success" @onclick="PlaceBet" disabled="@(isSaving || selectedBetOptionId == 0 || betAmount <= 0 || betAmount > (currentUser?.FidelisBalance ?? 0))">
            @if (isSaving)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
            }
            Apostar
        </button>
    </FooterContent>
</Modal>

@* Bet Details Modal (with Discussion) *@
<DetailsModal Show="@modals.IsOpen(ModalType.Details)" 
              ShowChanged="@((bool show) => modals.Toggle(ModalType.Details, show))"
              Title="Detalhes da Aposta" 
              HeaderTitle="@(selectedBet?.Title ?? "")"
              ImageUrl="@(selectedBet != null && !string.IsNullOrEmpty(selectedBet.ImageSrc) ? GetBetImageUrl(selectedBet.ImageSrc) : null)"
              IconClass="@(selectedBet != null && string.IsNullOrEmpty(selectedBet.ImageSrc) ? "bi-cash-coin" : null)"
              UseRectangularImage="true"
              OnClose="CloseDetailsModal">
    <BadgesContent>
        @if (selectedBet != null)
        {
            @if (selectedBet.BetCategory == BetCategory.MATCH)
            {
                <span class="badge bg-primary">Duelo</span>
            }
            else
            {
                <span class="badge bg-success">Decisão</span>
            }
            @if (selectedBet.IsCancelled)
            {
                <span class="badge bg-danger">Cancelado</span>
            }
            else if (selectedBet.WinningOptionId.HasValue)
            {
                <span class="badge badge-purple-resolved">Resolvido</span>
            }
        }
    </BadgesContent>
    <Sections>
        @if (selectedBet != null)
        {
            <!-- Bet Information Section -->
            <InfoSection SectionTitle="Informações da Aposta" 
                        IconClass="bi-info-circle-fill" 
                        CssClass="mb-4">
                <ProfileField Label="Data e Hora" Value="@selectedBet.DateTime.ToString("dd MMM yyyy, HH:mm'h'")" Icon="bi-calendar-fill" />
                @if (!string.IsNullOrEmpty(selectedBet.Location))
                {
                    <ProfileField Label="Localização" Value="@selectedBet.Location" Icon="bi-geo-alt-fill" />
                }
                @if (!string.IsNullOrEmpty(selectedBet.Description))
                {
                    <ProfileField Label="Descrição" Value="@selectedBet.Description" Icon="bi-text-paragraph" />
                }
            </InfoSection>

            <InfoSection SectionTitle="Opções de Aposta" 
                        IconClass="bi-list-check" 
                        CssClass="mb-4">
                @foreach (var option in GetBetOptions(selectedBet.Id))
                {
                    var isWinning = selectedBet.WinningOptionId.HasValue && selectedBet.WinningOptionId.Value == option.Id;
                    var isUserOption = GetUserBet(selectedBet.Id)?.BetOptionId == option.Id;
                    var optionStyle = isWinning ? "background-color: #28a745; color: white;" : 
                                     (isUserOption ? "background-color: #8a2be2; color: white;" : "background-color: #6c757d; color: white;");
                    
                    <div class="alert mb-2" style="@optionStyle">
                        <div class="d-flex justify-content-between align-items-center">
                            <span>
                                @option.Title
                                @if (isWinning)
                                {
                                    <i class="bi bi-trophy-fill text-warning ms-2"></i>
                                }
                                @if (isUserOption && !isWinning)
                                {
                                    <i class="bi bi-person-fill ms-2"></i>
                                }
                            </span>
                            <span class="badge bg-warning text-dark">Odds: @option.Odds.ToString("F2")x</span>
                        </div>
                    </div>
                }
            </InfoSection>

            @if (GetUserBet(selectedBet.Id) != null)
            {
                <InfoSection SectionTitle="A Sua Aposta" 
                            IconClass="bi-cash-coin" 
                            CssClass="mb-4">
                    <ProfileField Label="Opção" Value="@(GetBetOptions(selectedBet.Id).FirstOrDefault(o => o.Id == GetUserBet(selectedBet.Id)!.BetOptionId)?.Title ?? "N/A")" Icon="bi-check-circle-fill" />
                    <ProfileField Label="Montante" Value="@($"{Fmt(GetUserBet(selectedBet.Id)!.FidelisAmount)} Fidelis")" Icon="bi-coin" />
                    <ProfileField Label="Ganhos Potenciais" Value="@GetPotentialWinnings(selectedBet.Id)" Icon="bi-trophy-fill" />
                    <div class="profile-field">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-hourglass-split me-2 text-secondary"></i>
                            <div class="profile-field-content">
                                <span class="profile-field-label">Estado</span>
                                <span class="profile-field-value">
                                    @if (GetUserBet(selectedBet.Id)!.IsWon.HasValue)
                                    {
                                        @if (GetUserBet(selectedBet.Id)!.IsWon == true)
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-trophy-fill me-1"></i>
                                                Ganhou @Fmt(GetUserBet(selectedBet.Id)!.FidelisWinnings) Fidelis
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                <i class="bi bi-x-circle-fill me-1"></i>
                                                Perdeu
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            <i class="bi bi-clock-fill me-1"></i>
                                            Pendente
                                        </span>
                                    }
                                </span>
                            </div>
                        </div>
                    </div>
                </InfoSection>
            }

            <!-- Comments Section -->
            <InfoSection SectionTitle="Comentários"
                        IconClass="bi-chat-left-text"
                        CssClass="mb-3">
                @if (currentUser != null)
                {
                    <!-- Add Comment Form -->
                    <div class="add-comment-form mb-3">
                        <textarea class="form-control mb-3" 
                                  rows="3" 
                                  placeholder="Escrever um comentário..."
                                  maxlength="1000"
                                  @bind="newCommentText"></textarea>
                        
                        <!-- Media Upload -->
                        <div class="mb-3">
                            <MediaUploadManager @ref="commentMediaUploadManager"
                                               Label=""
                                               ShowCurrentMedia="false"
                                               OnFileSelected="HandleCommentMediaSelected" />
                        </div>
                        
                        @if (selectedCommentMediaFile != null)
                        {
                            <small class="form-text text-muted d-block mb-2">
                                Ficheiro selecionado: @selectedCommentMediaFile.Name
                            </small>
                        }
                        
                        <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top">
                            <small class="text-muted">@(newCommentText?.Length ?? 0) / 1000</small>
                            <button class="btn btn-primary btn-sm" 
                                    @onclick="AddComment"
                                    disabled="@((string.IsNullOrWhiteSpace(newCommentText) && selectedCommentMediaFile == null) || isAddingComment)">
                                @if (isAddingComment)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                Publicar
                            </button>
                        </div>
                    </div>
                }
                
                <!-- Comments List -->
                @if (betComments == null)
                {
                    <div class="text-center py-3">
                        <div class="spinner-border spinner-border-sm text-primary" role="status">
                            <span class="visually-hidden">A carregar comentários...</span>
                        </div>
                    </div>
                }
                else if (!betComments.Any())
                {
                    <EmptyState Title="Ainda não há comentários"
                                Message="Seja o primeiro a comentar!"
                                Icon="bi-chat-dots" />
                }
                else
                {
                    <div class="comments-list">
                        @foreach (var comment in betComments)
                        {
                            <div class="leaderboard-comment-item mb-3" @key="comment.Id">
                                <div class="comment-header d-flex justify-content-between align-items-start mb-2">
                                    <div class="d-flex align-items-center">
                                        <img src="@(comment.AuthorAvatarUrl ?? "/images/default-avatar.webp")" 
                                             alt="@comment.AuthorName" 
                                             class="comment-avatar me-2" />
                                        <div class="comment-meta">
                                            <span class="comment-author fw-bold">@comment.AuthorName</span>
                                            <span class="comment-date text-muted small ms-2">@comment.CreatedAt.ToString("dd MMM, HH:mm")</span>
                                        </div>
                                    </div>
                                    @if (comment.CanDelete)
                                    {
                                        <button class="btn btn-sm music-btn-delete comment-delete-btn" 
                                                @onclick="() => OpenDeleteCommentModal(comment.Id)"
                                                title="Eliminar">
                                            <i class="bi bi-trash music-icon-delete"></i>
                                        </button>
                                    }
                                </div>
                                <div class="comment-body mb-2 comment-body-pre-line">
                                    @comment.Text
                                </div>
                                @if (!string.IsNullOrEmpty(comment.MediaUrl))
                                {
                                    <div class="comment-media mt-2">
                                        @if (comment.MediaType == "image")
                                        {
                                            <img src="@comment.MediaUrl" alt="Imagem" class="img-fluid rounded comment-media" />
                                        }
                                        else if (comment.MediaType == "video")
                                        {
                                            <video controls playsinline preload="metadata" class="w-100 rounded comment-media">
                                                <source src="@comment.MediaUrl" type="video/mp4" />
                                                <source src="@comment.MediaUrl" type="video/quicktime" />
                                                <p class="text-warning p-2 small">
                                                    Formato de vídeo não suportado. Pode ter um codec (HEVC/H.265) não suportado.
                                                    Experimente usar o Safari ou um navegador móvel.
                                                </p>
                                            </video>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </InfoSection>
        }
    </Sections>
</DetailsModal>

@* Resolve Bet Modal (Admin Only) *@
<Modal Show="@modals.IsOpen(ModalType.Resolve)"
       ShowChanged="@((bool show) => modals.Toggle(ModalType.Resolve, show))"
       Title="@($"Resolver Aposta - {selectedBet?.Title}")"
       Size="Modal.ModalSize.Default"
       Centered="true">
    <BodyContent>
        @if (selectedBet != null)
        {
            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle me-2"></i>
                <strong>Atenção:</strong> Esta ação irá determinar os vencedores e distribuir os prémios. Não poderá ser revertida.
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <i class="bi bi-trophy text-primary me-2"></i>Opção Vencedora
                </label>
                <select class="form-select" @bind="selectedWinningOptionId">
                    <option value="0">Selecione a opção vencedora...</option>
                    @foreach (var option in GetBetOptions(selectedBet.Id))
                    {
                        <option value="@option.Id" @key="option.Id">@option.Title (Odds: @option.Odds.ToString("F2")x)</option>
                    }
                </select>
            </div>

        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="CloseResolveModal">Cancelar</button>
        <button type="button" class="btn btn-warning" @onclick="ResolveBet" disabled="@(isSaving || selectedWinningOptionId == 0)">
            @if (isSaving)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
            }
            Resolver Aposta
        </button>
    </FooterContent>
</Modal>

<!-- Image Cropper Component -->
<ImageCropper @ref="imageCropper"
              ShowModal="@modals.IsOpen(ModalType.Cropper)"
              ShowModalChanged="@((bool show) => modals.Toggle(ModalType.Cropper, show))"
              OnImageCropped="OnImageCropped"
              AspectRatio="1.5"
              AspectRatioHelp="As imagens de apostas são exibidas em proporção 3:2 para melhor apresentação"
              ImageFormat="image/webp"
