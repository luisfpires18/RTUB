@page "/games/avoid-questions"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Options
@using System.Text.Json
@using RTUB.Application.Configuration
@using RTUB.Application.Data
@using RTUB.Application.Interfaces
@inject IJSRuntime JSRuntime
@inject IOptions<AvoidQuestionsConfiguration> GameConfig
@inject IGameScoreService GameScoreService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavigationManager
@implements IAsyncDisposable
@attribute [Authorize]

<div class="avoid-questions-container">
    <!-- Page Header (matching EventEnrollments layout) -->
    <div class="d-flex flex-column gap-3 mb-4 page-header-block">
        <div class="d-flex align-items-center gap-3 page-header-row">
            <button class="btn btn-outline-secondary btn-sm back-button" @onclick="GoBack">
                <i class="bi bi-arrow-left"></i>
            </button>
            <div class="page-header-text flex-grow-1 text-center">
                <h1 class="mb-0"><i class="bi bi-controller"></i> Evitar Perguntas</h1>
            </div>
            <!-- Empty element to balance the layout -->
            <div style="width: 38px;"></div>
        </div>
    </div>

    <div class="game-stats">
        <div class="stat-item">
            <i class="bi bi-heart-fill text-danger"></i>
            <span class="stat-value">@lives</span>
            <span class="stat-label">Vidas</span>
        </div>
        <div class="stat-item">
            <i class="bi bi-lightning-fill text-warning"></i>
            <span class="stat-value">@level</span>
            <span class="stat-label">Nível</span>
        </div>
        <div class="stat-item">
            <i class="bi bi-star-fill text-primary"></i>
            <span class="stat-value">@points</span>
            <span class="stat-label">Pontos</span>
        </div>
        <div class="stat-item">
            <i class="bi bi-clock-fill text-info"></i>
            <span class="stat-value">@FormatTime(timeElapsed)</span>
            <span class="stat-label">Tempo</span>
        </div>
    </div>

    <div class="game-canvas-wrapper">
        <canvas id="gameCanvas" width="800" height="600"></canvas>
        
        @if (!gameStarted)
        {
            <div class="game-overlay">
                <div class="overlay-content">
                    <h3>Evitar Perguntas</h3>
                    <p class="mb-3">Joga como um Magister e evita as perguntas dos membros!</p>
                    <ul class="game-instructions">
                        <li><i class="bi bi-keyboard me-2"></i>Usa <kbd>A</kbd>/<kbd>D</kbd> ou <kbd>←</kbd>/<kbd>→</kbd> para mover</li>
                        <li><i class="bi bi-phone me-2"></i>No telemóvel, toca nos lados do ecrã</li>
                        <li><i class="bi bi-heart me-2"></i>Tens @GameConfig.Value.MaxLives vidas</li>
                        <li><i class="bi bi-star me-2"></i>Ganha @GameConfig.Value.PointsPerDodge ponto por cada pergunta evitada</li>
                    </ul>
                    <button class="btn btn-primary btn-lg" @onclick="StartGame">
                        <i class="bi bi-play-fill me-1"></i>Iniciar Jogo
                    </button>
                </div>
            </div>
        }
        
        @if (gameOver)
        {
            <div class="game-overlay game-over-overlay">
                <div class="overlay-content">
                    <h3 class="text-danger">Fim de Jogo!</h3>
                    <div class="final-stats mb-4">
                        <div class="final-stat">
                            <span class="final-stat-value">@finalPoints</span>
                            <span class="final-stat-label">Pontos</span>
                        </div>
                        <div class="final-stat">
                            <span class="final-stat-value">@finalLevel</span>
                            <span class="final-stat-label">Nível Máximo</span>
                        </div>
                        <div class="final-stat">
                            <span class="final-stat-value">@FormatTime(finalTime)</span>
                            <span class="final-stat-label">Tempo Sobrevivido</span>
                        </div>
                    </div>
                    @if (scoreSaved)
                    {
                        <p class="text-success mb-3"><i class="bi bi-check-circle me-1"></i>Pontuação guardada!</p>
                    }
                    else if (savingScore)
                    {
                        <p class="text-muted mb-3"><i class="bi bi-hourglass-split me-1"></i>A guardar pontuação...</p>
                    }
                    <div class="d-flex gap-2 justify-content-center">
                        <button class="btn btn-primary" @onclick="RestartGame">
                            <i class="bi bi-arrow-repeat me-1"></i>Jogar Novamente
                        </button>
                        <button class="btn btn-outline-secondary" @onclick="GoBack">
                            <i class="bi bi-arrow-left me-1"></i>Voltar
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="game-controls-mobile">
        <button class="control-btn control-left" @ontouchstart="@(() => StartMoveLeft())" @ontouchend="@(() => StopMove())" @onmousedown="@(() => StartMoveLeft())" @onmouseup="@(() => StopMove())">
            <i class="bi bi-chevron-left"></i>
        </button>
        <button class="control-btn control-right" @ontouchstart="@(() => StartMoveRight())" @ontouchend="@(() => StopMove())" @onmousedown="@(() => StartMoveRight())" @onmouseup="@(() => StopMove())">
            <i class="bi bi-chevron-right"></i>
        </button>
    </div>
</div>

@code {
    private const string GameKey = "avoid-questions";
    
    private bool gameStarted = false;
    private bool gameOver = false;
    private int lives = 5;
    private int level = 1;
    private int points = 0;
    private double timeElapsed = 0;
    
    private int finalPoints = 0;
    private int finalLevel = 0;
    private double finalTime = 0;
    
    private bool savingScore = false;
    private bool scoreSaved = false;
    
    private string? currentUserId;
    private DotNetObjectReference<AvoidQuestions>? objRef;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            var currentUser = await UserManager.GetUserAsync(user);
            currentUserId = currentUser?.Id;
        }
        
        lives = GameConfig.Value.MaxLives;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            objRef = DotNetObjectReference.Create(this);
            
            var configJson = JsonSerializer.Serialize(new
            {
                questions = GameConfig.Value.Questions,
                baseSpawnRate = GameConfig.Value.BaseSpawnRate,
                baseFallingSpeed = GameConfig.Value.BaseFallingSpeed,
                spawnRateDecreasePerLevel = GameConfig.Value.SpawnRateDecreasePerLevel,
                speedIncreasePerLevel = GameConfig.Value.SpeedIncreasePerLevel,
                levelDurationSeconds = GameConfig.Value.LevelDurationSeconds,
                maxLives = GameConfig.Value.MaxLives,
                pointsPerDodge = GameConfig.Value.PointsPerDodge
            });
            
            await JSRuntime.InvokeVoidAsync("avoidQuestionsGame.init", "gameCanvas", objRef, configJson);
        }
    }

    private async Task StartGame()
    {
        gameStarted = true;
        gameOver = false;
        scoreSaved = false;
        lives = GameConfig.Value.MaxLives;
        level = 1;
        points = 0;
        timeElapsed = 0;
        
        StateHasChanged();
        await JSRuntime.InvokeVoidAsync("avoidQuestionsGame.start");
    }

    private async Task RestartGame() => await StartGame();

    private void GoBack() => NavigationManager.NavigateTo("/games");

    private async Task StartMoveLeft() => await JSRuntime.InvokeVoidAsync("avoidQuestionsGame.startMove", -1);
    private async Task StartMoveRight() => await JSRuntime.InvokeVoidAsync("avoidQuestionsGame.startMove", 1);
    private async Task StopMove() => await JSRuntime.InvokeVoidAsync("avoidQuestionsGame.stopMove");

    [JSInvokable]
    public void UpdateStats(int newLives, int newLevel, int newPoints, double newTime)
    {
        lives = newLives;
        level = newLevel;
        points = newPoints;
        timeElapsed = newTime;
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnGameOver(int finalPts, int maxLvl, double survivedTime)
    {
        gameOver = true;
        gameStarted = false;
        finalPoints = finalPts;
        finalLevel = maxLvl;
        finalTime = survivedTime;
        StateHasChanged();

        if (!string.IsNullOrEmpty(currentUserId))
        {
            savingScore = true;
            StateHasChanged();
            
            try
            {
                await GameScoreService.SubmitScoreAsync(currentUserId, GameKey, finalPoints, finalLevel, TimeSpan.FromSeconds(finalTime));
                scoreSaved = true;
            }
            catch { }
            finally
            {
                savingScore = false;
                StateHasChanged();
            }
        }
    }

    private string FormatTime(double seconds)
    {
        var ts = TimeSpan.FromSeconds(seconds);
        if (ts.TotalMinutes >= 1) return $"{(int)ts.TotalMinutes}:{ts.Seconds:D2}";
        return $"0:{(int)seconds:D2}";
    }

    public async ValueTask DisposeAsync()
    {
        try { await JSRuntime.InvokeVoidAsync("avoidQuestionsGame.dispose"); } catch { }
        objRef?.Dispose();
    }
}
