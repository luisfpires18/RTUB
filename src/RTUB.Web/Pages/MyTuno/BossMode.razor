    private static string Fmt(long value) => value.ToString("N0");
    private static string Fmt(decimal value) => value.ToString("N0");

    private async Task CancelRunIfInProgressAsync()
    {
        if (runInProgress && character != null && runStartingHp.HasValue)
        {
            // Capture interactive boss HP before destroying the session.
            // Without this, navigating away mid-fight saves the pre-computed boss HP
            // instead of the actual interactive HP.
            long disposeBossHP = _combatSession?.Enemies?.FirstOrDefault()?.CurrentHP ?? 0;
            long disposeBossMaxHP = _combatSession?.Enemies?.FirstOrDefault()?.MaxHP ?? 0;

            try
            {
                await BossModeService.CancelBossRunAsync(character.Id, runStartingHp.Value, runStartingShotBuffBattles, runStartingCigarroBuff, runStartingCanhaoBuff, runStartingPenaltyBuff);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error cancelling boss run during disposal");
            }

            // Overwrite pre-computed boss HP with the interactive session value.
            if (currentUser != null && disposeBossHP > 0 && disposeBossMaxHP > 0)
            {
                try
                {
                    await BossModeService.SaveBossRemainingHPAsync(
                        currentUser.Id, disposeBossHP, disposeBossMaxHP);
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Error saving boss HP during disposal");
                }
            }

            runInProgress = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;

        await CancelRunIfInProgressAsync();

        // Capture interactive boss HP before the session/game is destroyed.
        long disposeBossHP = _combatSession?.Enemies?.FirstOrDefault()?.CurrentHP ?? 0;
        long disposeBossMaxHP = _combatSession?.Enemies?.FirstOrDefault()?.MaxHP ?? 0;

        if (pendingDefeatRewards && character != null && bossesCleared > 0)
        {
            try
            {
                await BossModeService.ApplyBossRunRewardsAsync(
                    character.Id, totalFidelisEarned, totalLeitaoDropped, totalFinosDropped, totalCanecasDropped, totalCigarrosDropped, totalCanhaosDropped, totalShotsDropped, totalPenaltiesDropped,
                    defeatRestoreHp,
                    totalInstrumentPartsDropped.Count > 0 ? totalInstrumentPartsDropped : null,
                    expireShotBuff: runStartingShotBuffBattles > 0 || character.ShotBuffBattlesRemaining > 0,
                    expirePenaltyBuff: runStartingPenaltyBuff.HasValue || character.HasPenaltyBuff,
                    startBossFloor: runStartingBossStage,
                    endBossFloor: defeatedAtBossStage);
            }
            catch (Exception) { }
            pendingDefeatRewards = false;
        }

        // Save interactive boss HP to overwrite any pre-computed value.
        if (currentUser != null && disposeBossHP > 0 && disposeBossMaxHP > 0)
        {
            try
            {
                await BossModeService.RecordInteractiveDefeatAsync(
                    currentUser.Id, disposeBossHP, disposeBossMaxHP);
            }
            catch (Exception) { }
        }

        if (hasRendered)
        {
            try { await JSRuntime.InvokeVoidAsync("stageBattleGame.destroy"); }
            catch { }
        }

        objRef?.Dispose();
        _bossLock.Dispose();
    }
