    private async Task LoadConsumableQuantitiesAsync()
    {
        if (currentUser == null) return;
        try
        {
            var inventorySummary = await InventoryService.GetUserInventorySummaryAsync(currentUser.Id);
            shotQuantity = inventorySummary.GetValueOrDefault(InventoryItemType.Shot);
            cigarroQuantity = inventorySummary.GetValueOrDefault(InventoryItemType.Cigarro);
            canhaoQuantity = inventorySummary.GetValueOrDefault(InventoryItemType.Canhao);
            penaltyQuantity = inventorySummary.GetValueOrDefault(InventoryItemType.Penalty);

            var stageProgressTask = StageService.GetOrCreateStageProgressAsync(currentUser.Id);
            await RefreshCurrentUserAsync();
            var stageProgress = await stageProgressTask;
            consumableHighestStage = stageProgress?.HighestStage ?? 1;
            fitabBalance = currentUser?.FitabBalance ?? 0;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading consumable quantities");
        }
    }

    private async Task TryAgainBoss()
    {
        if (_disposed || character == null || currentUser == null) return;
        if (fighting) return;

        showBuffScreen = false;
        buffToastMessage = null;

        // Consume buff charges for the completed run before starting a new one.
        // This ensures each run only costs 1 charge, not N charges for N bosses.
        // Always check the current character state (not just the run snapshot) because
        // the player may have activated a buff on the buff screen after dying.
        var needsSave = false;
        if (character.ShotBuffBattlesRemaining > 0 && (runStartingShotBuffBattles > 0 || character.ShotBuffBattlesRemaining > 0))
        {
            character.ExpireShotBuff();
            needsSave = true;
        }
        // Penalty uses pause/resume like Canhão — carry over remaining time to next run
        // (already paused by ApplyBossRunRewardsAsync; don't expire it here)
        if (needsSave)
        {
            await CharacterService.UpdateCharacterAsync(character);
        }

        // Reload character to get updated buff state
        character = await CharacterService.GetOrCreateCharacterAsync(currentUser.Id);

        // Resume Penalty buff for the new run (carry over remaining time like Canhão)
        if (character.PenaltyBuffRemainingMs > 0)
        {
            character.ResumePenaltyBuff();
            await CharacterService.UpdateCharacterAsync(character);
        }

        // Start a new boss run (costs 1 FITAB)
        try
        {
            bossModeProgress = await BossModeService.StartBossModeRunAsync(currentUser.Id);
            fitabBalance = Math.Max(0, fitabBalance - 1);
        }
        catch (InvalidOperationException ex)
        {
            buffToastMessage = ex.Message.Contains("FITAB")
                ? "Não tens FITAB suficiente para tentar de novo."
                : ex.Message;
            buffToastIsError = true;
            showBuffScreen = true;
            StateHasChanged();
            return;
        }

        // Re-store run starting state with current buffs
        runStartingHp = character.CurrentHP;
        runStartingShotBuffBattles = character.ShotBuffBattlesRemaining;
        runStartingCigarroBuff = character.CigarroShieldHitsRemaining;
        runStartingCanhaoBuff = character.CanhaoBuffExpiresAt;
        runStartingPenaltyBuff = character.PenaltyBuffExpiresAt;
        runStartingPenaltyRemainingMs = character.PenaltyBuffRemainingMs;
        runInProgress = true;
        pendingDefeatRewards = true;
        currentBattle = null;

        StateHasChanged();
        await Task.Delay(150);
        await FightBoss();
    }

    private async Task EndRunFromBuffScreen()
    {
        if (_disposed) return;

        // Apply accumulated rewards and expire run-scoped buffs
        // Check actual character state (not just snapshot) because player may have
        // activated buffs on the buff screen after dying.
        if (character != null && bossesCleared > 0)
        {
            try
            {
                await BossModeService.ApplyBossRunRewardsAsync(
                    character.Id, totalFidelisEarned, totalLeitaoDropped, totalFinosDropped, totalCanecasDropped, totalCigarrosDropped, totalCanhaosDropped, totalShotsDropped, totalPenaltiesDropped,
                    defeatRestoreHp,
                    totalInstrumentPartsDropped.Count > 0 ? totalInstrumentPartsDropped : null,
                    expireShotBuff: runStartingShotBuffBattles > 0 || character.ShotBuffBattlesRemaining > 0,
                    expirePenaltyBuff: runStartingPenaltyBuff.HasValue || character.HasPenaltyBuff,
                    startBossFloor: runStartingBossStage,
                    endBossFloor: defeatedAtBossStage);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error applying boss run rewards from buff screen");
            }
        }
        else if (character != null && runStartingHp.HasValue)
        {
            // Cancel: expire any buff the player activated on the buff screen
            // (it was consumed from inventory so it should not persist)
            if (character.HasPenaltyBuff)
            {
                character.ExpirePenaltyBuff();
                await CharacterService.UpdateCharacterAsync(character);
            }
            await BossModeService.CancelBossRunAsync(character.Id, runStartingHp.Value, runStartingShotBuffBattles, runStartingCigarroBuff, runStartingCanhaoBuff, null);
        }

        pendingDefeatRewards = false;
        runInProgress = false;
        runStartingHp = null;
        showBuffScreen = false;
        currentBattle = null;

        // Ensure the run is ended server-side. OnBattleFinished should have already
        // ended the run, but call RecordInteractiveDefeatAsync as a safety net —
        // it will EndRun only if still active, and always persists via the DB.
        if (currentUser != null)
        {
            try
            {
                await BossModeService.RecordInteractiveDefeatAsync(currentUser.Id, 0, 0);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Error ending boss run from buff screen");
            }
            bossModeProgress = await BossModeService.GetBossModeProgressAsync(currentUser.Id);
        }

        // Navigate directly to My Tuno
        ResetRunTotals();
        Navigation.NavigateTo("/my-tuno");
    }

