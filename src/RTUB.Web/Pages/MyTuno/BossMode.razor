    /// <summary>
    /// Called by JS on each tick to advance spell cooldowns.
    /// Returns updated cooldown map.
    /// </summary>
    [JSInvokable]
    public Task<string> OnTickCooldowns(double elapsedSeconds)
    {
        if (_combatSession == null || _combatSession.IsComplete)
            return Task.FromResult("{}");

        var cooldowns = CombatActionService.TickCooldowns(_combatSession, elapsedSeconds);

        var result = new Dictionary<string, object>
        {
            ["spells"] = cooldowns,
            ["consumables"] = new Dictionary<string, double>(_combatSession.ConsumableCooldowns)
        };
        return Task.FromResult(JsonSerializer.Serialize(result, _spellJsonOptions));
    }

    /// <summary>
    /// Called by JS when the user clicks a consumable button during combat.
    /// Consumes the item and applies its effect to the combat session.
    /// Boss mode uses ConsumeItemAsync directly (same as stage mode) because
    /// character DB writes happen per-battle via UpdateCharacterAsync.
    /// </summary>
    [JSInvokable]
    public async Task<string> OnUseConsumable(string type)
    {
        if (character == null || currentUser == null)
            return JsonSerializer.Serialize(new { success = false, message = "Personagem não encontrado." }, _spellJsonOptions);

        try
        {
            var result = await CombatActionService.ApplyConsumableAsync(_combatSession, currentUser.Id, type, character);

            if (!result.Success)
                return JsonSerializer.Serialize(new { success = false, message = result.Message }, _spellJsonOptions);

            // Decrement local UI quantity tracker
            var newQuantity = DecrementConsumableQuantity(type);

            // Build the JSON response expected by JS
            if (result.HealAmount.HasValue)
                return JsonSerializer.Serialize(new { success = true, type, newQuantity, healAmount = result.HealAmount, playerHP = result.PlayerHP, playerMaxHP = result.PlayerMaxHP, cooldownSeconds = result.CooldownSeconds }, _spellJsonOptions);
            if (result.NewActionTime.HasValue && result.NewActionTime > 0)
                return JsonSerializer.Serialize(new { success = true, type, newQuantity, buffMessage = result.BuffMessage, buffActive = result.BuffActive, newActionTime = result.NewActionTime }, _spellJsonOptions);
            return JsonSerializer.Serialize(new { success = true, type, newQuantity, buffMessage = result.BuffMessage, buffActive = result.BuffActive }, _spellJsonOptions);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Error using consumable {Type} in boss mode", type);
            return JsonSerializer.Serialize(new { success = false, message = "Erro ao usar consumível." }, _spellJsonOptions);
        }
    }

    /// <summary>
    /// Decrements the local UI consumable quantity tracker and returns the new value.
    /// </summary>
    private int DecrementConsumableQuantity(string type)
    {
        return type.ToLowerInvariant() switch
        {
            "fino" => _finoQty = Math.Max(0, _finoQty - 1),
            "caneca" => _canecaQty = Math.Max(0, _canecaQty - 1),
            "cigarro" => cigarroQuantity = Math.Max(0, cigarroQuantity - 1),
            "canhao" => canhaoQuantity = Math.Max(0, canhaoQuantity - 1),
            "shot" => shotQuantity = Math.Max(0, shotQuantity - 1),
            "penalty" => penaltyQuantity = Math.Max(0, penaltyQuantity - 1),
            _ => 0
        };
    }

    [JSInvokable]
    public async Task OnBattleFinished()
    {
        if (_disposed) return;
        if (currentBattle == null) return;

        // Use interactive session outcome if available, otherwise fall back to pre-computed
        var didWin = _combatSession != null
            ? (_combatSession.Winner == _combatSession.Player.Identifier)
            : (currentBattle.Outcome == BattleOutcome.AttackerWon);

        // Sync interactive session state back to character so the DB has the correct
        // buff remaining counts and HP (not the pre-computed ones which may differ).
        if (_combatSession != null && character != null)
        {
            character.CurrentHP = _combatSession.Player.CurrentHP > 0
                ? _combatSession.Player.CurrentHP : null;
            character.CigarroShieldHitsRemaining = _combatSession.CigarroShieldRemaining;
            character.CanhaoDamageBoostHitsRemaining = _combatSession.CanhaoBoostRemaining;
            try
            {
                await CharacterService.UpdateCharacterAsync(character);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Error syncing interactive session state to character");
            }
        }

        // If interactive session says win but pre-computed said loss (pendingDefeatRewards was
        // set prematurely), correct the state so the run continues properly.
        if (didWin && pendingDefeatRewards)
        {
            pendingDefeatRewards = false;
            runInProgress = true;

            // The deterministic engine predicted a loss, so UpdateProgressAfterBattle
            // called EndRun() (CurrentBossStage = 0) and saved to DB. Correct the
            // server-side progress to undo the EndRun and advance the boss stage.
            if (currentUser != null)
            {
                try
                {
                    await BossModeService.CorrectInteractiveWinAsync(currentUser.Id);
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Error correcting interactive win for boss mode");
                }
            }
        }

        _combatSession = null;

        if (didWin)
        {
            // Accumulate rewards
            totalXPEarned += currentBattle.XPReward;
            totalFidelisEarned += currentBattle.FidelisReward;
            totalFinosDropped += currentBattle.FinosDropped;
            totalCanecasDropped += currentBattle.CanecasDropped;
            totalCigarrosDropped += currentBattle.CigarrosDropped;
            totalCanhaosDropped += currentBattle.CanhaosDropped;
            totalShotsDropped += currentBattle.ShotsDropped;
            totalPenaltiesDropped += currentBattle.PenaltiesDropped;
            bossesCleared++;

            foreach (var part in currentBattle.InstrumentPartsDropped)
            {
                if (totalInstrumentPartsDropped.ContainsKey(part))
                    totalInstrumentPartsDropped[part]++;
                else
                    totalInstrumentPartsDropped[part] = 1;
            }

            foreach (var equip in currentBattle.EquipmentDropped)
            {
                if (totalEquipmentDropped.ContainsKey(equip))
                    totalEquipmentDropped[equip]++;
                else
                    totalEquipmentDropped[equip] = 1;
            }

            // Reload character to get updated HP
            if (currentUser != null)
            {
                character = await CharacterService.GetOrCreateCharacterAsync(currentUser.Id);
                bossModeProgress = await BossModeService.GetBossModeProgressAsync(currentUser.Id);
            }

            StateHasChanged();

            // Auto-start next boss fight
            await Task.Delay(200);
            await FightBoss();
        }
        else
        {
            // Defeated — show buff screen (use consumables & try again)
            defeatedAtBossStage = currentBattle.BossStage;

            // Destroy the Phaser game so canvas doesn't block interactions
            if (hasRendered)
            {
                try { await JSRuntime.InvokeVoidAsync("stageBattleGame.destroy"); }
                catch { }
            }

            // Reload character and restore HP so buffs can be used
            if (currentUser != null)
            {
                character = await CharacterService.GetOrCreateCharacterAsync(currentUser.Id);
                if (character != null && (character.CurrentHP == null || character.CurrentHP <= 0))
                {
                    character.CurrentHP = runStartingHp ?? character.TotalHP;
                    await CharacterService.UpdateCharacterAsync(character);
                }
            }

            // Load consumable quantities for buff screen
            await LoadConsumableQuantitiesAsync();

            showBattleAnimation = false;
            showBuffScreen = true;
            buffToastMessage = null;
            currentEnemyStats.Clear();

            StateHasChanged();
        }
    }

