        totalFidelisEarned = 0;
        totalFinosDropped = 0;
        totalCanecasDropped = 0;
        totalCigarrosDropped = 0;
        totalCanhaosDropped = 0;
        totalShotsDropped = 0;
        totalPenaltiesDropped = 0;
