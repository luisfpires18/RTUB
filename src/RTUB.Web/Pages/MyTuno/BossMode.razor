    private async Task EndRunEarly()
    {
        if (_disposed) return;

        try
        {
            // Capture boss HP from the interactive session BEFORE destroying the game/session
            long earlyStopBossHP = _combatSession?.Enemies?.FirstOrDefault()?.CurrentHP ?? 0;
            long earlyStopBossMaxHP = _combatSession?.Enemies?.FirstOrDefault()?.MaxHP ?? 0;
            _combatSession = null;

            if (hasRendered)
            {
                try { await JSRuntime.InvokeVoidAsync("stageBattleGame.destroy"); }
                catch { }
            }

            defeatedAtBossStage = currentBattle?.BossStage ?? bossModeProgress?.CurrentBossStage ?? 0;

            if (character != null && bossesCleared > 0)
            {
                try
                {
                    await BossModeService.ApplyBossRunRewardsAsync(
                        character.Id, totalFidelisEarned, totalLeitaoDropped, totalFinosDropped, totalCanecasDropped, totalCigarrosDropped, totalCanhaosDropped, totalShotsDropped, totalPenaltiesDropped,
                        runStartingHp,
                        totalInstrumentPartsDropped.Count > 0 ? totalInstrumentPartsDropped : null,
                        expireShotBuff: runStartingShotBuffBattles > 0 || character.ShotBuffBattlesRemaining > 0,
                        expirePenaltyBuff: false,
                        startBossFloor: runStartingBossStage,
                        endBossFloor: runStartingBossStage + bossesCleared - 1);
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Error applying boss run rewards on early end");
                }
            }
            else if (character != null && runStartingHp.HasValue)
            {
                // No bosses cleared, pre-computed engine predicted WIN —
                // restore character to pre-run state and end the run.
                await BossModeService.CancelBossRunAsync(character.Id, runStartingHp.Value, runStartingShotBuffBattles, runStartingCigarroBuff, runStartingCanhaoBuff, runStartingPenaltyBuff);
            }
            // else: pre-computed engine predicted LOSS on first boss (bossesCleared==0,
            // runStartingHp==null). UpdateProgressAfterBattle already ended the run and
            // saved *pre-computed* boss HP. We still need to overwrite it below.

            // Always save interactive boss HP and ensure the run is ended server-side.
            // This is critical because the pre-computed engine may have already saved a
            // DIFFERENT boss HP (from its simulation) that doesn't match the interactive
            // session. Without this, each early stop accumulates pre-computed damage.
            // RecordInteractiveDefeatAsync is idempotent: saves HP unconditionally,
            // calls EndRun only if the run is still active.
            if (currentUser != null && earlyStopBossHP > 0 && earlyStopBossMaxHP > 0)
            {
                try
                {
                    await BossModeService.RecordInteractiveDefeatAsync(
                        currentUser.Id, earlyStopBossHP, earlyStopBossMaxHP);
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Error saving boss HP on early end");
                }
            }

            runInProgress = false;
            runStartingHp = null;
            pendingDefeatRewards = false;

            // Refresh progress and character from DB after the run has been ended server-side
            if (currentUser != null)
            {
                bossModeProgress = await BossModeService.GetBossModeProgressAsync(currentUser.Id);
                character = await CharacterService.GetOrCreateCharacterAsync(currentUser.Id);
                await RefreshCurrentUserAsync();
            }

            showBattleAnimation = false;
            showDefeatSummary = true;
            currentEnemyStats.Clear();
            currentBattle = null;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error ending boss run early");
        }
    }

