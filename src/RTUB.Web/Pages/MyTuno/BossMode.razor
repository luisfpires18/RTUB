        catch (Exception ex)
        {
            Logger.LogError(ex, "Error using shot in boss mode");
            buffToastMessage = "Erro ao usar Shot.";
            buffToastIsError = true;
        }
        finally
        {
            usingShot = false;
            StateHasChanged();
        }
    }

