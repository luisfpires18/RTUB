@page "/my-tuno/boss-mode"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.JSInterop
@using RTUB.Application.Interfaces
@using RTUB.Application.Data
@using RTUB.Application.DTOs
@using RTUB.Core.Entities
@using RTUB.Core.Enums
@using RTUB.Core.Helpers
@using System.Text.Json.Serialization
@using RTUB.Shared
@using RTUB.Shared.Base
@using RTUB.Shared.Components.UI
@using RTUB.Shared.Components.Game
@using System.Text.Json
@using Microsoft.Extensions.Options
@using RTUB.Application.Configuration
@using Microsoft.EntityFrameworkCore
@attribute [Authorize]
@inject IBossModeService BossModeService
@inject ICharacterService CharacterService
@inject INaipeService NaipeService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject ILogger<BossMode> Logger
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject IAuditLogService AuditLogService
@inject IInventoryService InventoryService
@inject IStageService StageService
@inject ICombatActionService CombatActionService
@inject IInventoryRepository InventoryRepository
@inject IOptions<MyTunoScalingConfiguration> ScalingConfigOptions
@implements IAsyncDisposable

<PageTitle>Boss Mode - My Tuno - RTUB</PageTitle>

<div class="stage-page">
    @if (!showBuffScreen && !showDefeatSummary)
    {
    <div class="boss-header">
        <button class="boss-back-btn" @onclick="GoBack" title="Voltar">
            <i class="bi bi-arrow-left"></i>
        </button>
        <h1 class="boss-title"><i class="bi bi-lightning-fill"></i> Boss Mode</h1>
        <div class="boss-header-spacer"></div>
    </div>
    }

    @if (loading)
    {
        <LoadingSpinner />
    }
    else if (character == null)
    {
        <EmptyState Title="Personagem não encontrado"
                    Message="Ocorreu um erro ao carregar o teu personagem."
                    Icon="bi-person-x" />
    }
    else if (errorMessage != string.Empty)
    {
        <div class="boss-error-panel">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@errorMessage</span>
        </div>
    }
    else
    {
        @if (showBattleAnimation)
        {
            <div class="battle-screen">
                <div id="phaserBattleContainer" class="battle-canvas"></div>
                <div class="battle-top-bar">
                    <div class="d-flex align-items-center gap-2">
                        <h5 class="mb-0 text-white">
                            <i class="bi bi-lightning-fill text-warning me-2"></i>
                            @if (currentBattle != null)
                            {
                                <text>Boss #@currentBattle.BossStage</text>
                            }
                            else
                            {
                                <text>A carregar...</text>
                            }
                        </h5>
                    </div>

                    @* ── Compact rewards strip (matching Stage mode top bar) ── *@
                    @if (bossesCleared > 0)
                    {
                        <div class="battle-rewards-strip">
                            <span class="reward-tag reward-tag--fidelis">
                                <i class="bi bi-coin"></i> @Fmt(totalFidelisEarned) Fidelis
                            </span>
                            @if (totalLeitaoDropped > 0)
                            {
                                <span class="reward-tag reward-tag--drink" style="color: #ff9800;">
                                    <i class="bi bi-piggy-bank"></i> @totalLeitaoDropped Leitão
                                </span>
                            }
                            @if (totalFinosDropped > 0)
                            {
                                <span class="reward-tag reward-tag--drink">
                                    <i class="bi bi-cup-straw"></i> @Fmt(totalFinosDropped) Fino
                                </span>
                            }
                            @if (totalCanecasDropped > 0)
                            {
                                <span class="reward-tag reward-tag--drink">
                                    <i class="bi bi-cup-straw"></i> @Fmt(totalCanecasDropped) Caneca
                                </span>
                            }
                            @if (totalCigarrosDropped > 0)
                            {
                                <span class="reward-tag reward-tag--drink">
                                    <i class="bi bi-cloud"></i> @Fmt(totalCigarrosDropped) Cigarro
                                </span>
                            }
                            @if (totalCanhaosDropped > 0)
                            {
                                <span class="reward-tag reward-tag--drink">
                                    <i class="bi bi-bullseye"></i> @Fmt(totalCanhaosDropped) Canhão
                                </span>
                            }
                            @if (totalShotsDropped > 0)
                            {
                                <span class="reward-tag reward-tag--drink">
                                    <i class="bi bi-cup"></i> @totalShotsDropped Shot
                                </span>
                            }
                            @if (totalPenaltiesDropped > 0)
                            {
                                <span class="reward-tag reward-tag--drink">
                                    <i class="bi bi-lightning-charge-fill"></i> @totalPenaltiesDropped Penalty
                                </span>
                            }
                        </div>
                    }

                    <div class="battle-controls">
                        <button class="battle-ctrl-btn @(battleSpeed == 1.0 ? "active" : "")" @onclick="() => SetBattleSpeed(1.0)">1x</button>
                        <button class="battle-ctrl-btn @(battleSpeed == 5.0 ? "active" : "")" @onclick="() => SetBattleSpeed(5.0)">5x</button>
                        <button class="battle-ctrl-btn battle-ctrl-btn--audio" @onclick="ToggleAudio" title="Som">
                            <i class="bi @(audioEnabled ? "bi-volume-up" : "bi-volume-mute")"></i>
                        </button>
                        <button class="battle-ctrl-btn battle-ctrl-btn--stop" @onclick="EndRunEarly" title="Acabar">
                            <i class="bi bi-stop-fill"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Active Buff Indicators (matching Stage mode style) -->
            @if (character != null && (character.ShotBuffBattlesRemaining > 0 || character.CigarroShieldHitsRemaining > 0))
            {
                <div class="boss-buff-strip">
                    @if (character.ShotBuffBattlesRemaining > 0)
                    {
                        <span class="boss-buff-tag boss-buff-tag--shot"><i class="bi bi-cup"></i>+@((int)((character.EffectiveShotBuffMultiplier - 1) * 100))% Stats</span>
                    }
                    @if (character.CigarroShieldHitsRemaining > 0)
                    {
                        <span class="boss-buff-tag boss-buff-tag--dodge"><i class="bi bi-wind"></i>@((int)(character.EffectiveCigarroDodgeChance * 100))% Dodge @character.CigarroShieldHitsRemaining runs</span>
                    }
                </div>
            }

            @if (bossesCleared > 0)
            {
                <div class="boss-fantasy-panel">
                    <div class="boss-panel-header"><i class="bi bi-gift"></i> Progresso</div>
                    <div class="boss-loot-grid">
                        <FantasyTile Icon="bi-check-circle-fill" Label="Bosses" Value="@Fmt(bossesCleared)" Color="green" Size="sm" />
                        <FantasyTile Icon="bi-coin" Label="Fidelis" Value="@($"+{Fmt(totalFidelisEarned)}")" Color="purple" Size="sm" />
                        @if (totalLeitaoDropped > 0)
                        {
                            <FantasyTile Icon="bi-piggy-bank" Label="Leitão" Value="@($"+{Fmt(totalLeitaoDropped)}")" Color="red" Size="sm" />
                        }
                        @if (totalFinosDropped > 0)
                        {
                            <FantasyTile Icon="bi-cup-straw" Label="Fino" Value="@($"+{Fmt(totalFinosDropped)}")" Color="yellow" Size="sm" />
                        }
                        @if (totalCanecasDropped > 0)
                        {
                            <FantasyTile Icon="bi-cup-straw" Label="Caneca" Value="@($"+{Fmt(totalCanecasDropped)}")" Color="yellow" Size="sm" />
                        }
                        @if (totalCigarrosDropped > 0)
                        {
                            <FantasyTile Icon="bi-cloud" Label="Cigarro" Value="@($"+{Fmt(totalCigarrosDropped)}")" Color="gray" Size="sm" />
                        }
                        @if (totalCanhaosDropped > 0)
                        {
                            <FantasyTile Icon="bi-bullseye" Label="Canhão" Value="@($"+{Fmt(totalCanhaosDropped)}")" Color="red" Size="sm" />
                        }
                        @if (totalShotsDropped > 0)
                        {
                            <FantasyTile Icon="bi-cup" Label="Shot" Value="@($"+{Fmt(totalShotsDropped)}")" Color="cyan" Size="sm" />
                        }
                        @if (totalPenaltiesDropped > 0)
                        {
                            <FantasyTile Icon="bi-lightning-charge-fill" Label="Penalty" Value="@($"+{Fmt(totalPenaltiesDropped)}")" Color="blue" Size="sm" />
                        }
                    </div>
                </div>
            }

            @if (currentEnemyStats.Count > 0)
            {
                <div class="boss-fantasy-panel">
                    <div class="boss-panel-header"><i class="bi bi-lightning-fill"></i> Boss Stats</div>
                    @foreach (var enemy in currentEnemyStats)
                    {
                        <div class="boss-panel-enemy-name">@enemy.Name</div>
                        <div class="boss-stats-grid">
                            <FantasyTile Icon="bi-heart-fill" Label="HP"
                                         Value="@(enemy.MaxHP is > 0 && enemy.HP < enemy.MaxHP ? $"{Fmt(enemy.HP)}/{Fmt(enemy.MaxHP.Value)}" : Fmt(enemy.HP))"
                                         Color="red" Size="sm" />
                            <FantasyTile Icon="bi-lightning-fill" Label="Poder" Value="@Fmt(enemy.Power)" Color="green" Size="sm" />
                            <FantasyTile Icon="bi-shield-fill" Label="Defesa" Value="@Fmt(enemy.Defense)" Color="gray" Size="sm" />
                            <FantasyTile Icon="bi-speedometer2" Label="Velocidade" Value="@($"{enemy.ActionTime:0.#}s")" Color="blue" Size="sm" />
                        </div>
                    }
                </div>
            }
        }

        @if (showBuffScreen)
        {
            <div class="defeat-overlay">
                <div class="defeat-panel buff-panel">
                    <div class="defeat-banner">
                        <span>DERROTADO</span>
                    </div>
                    <div class="defeat-stage">Boss @Fmt(defeatedAtBossStage)</div>

                    @* Accumulated Rewards *@
                    @if (bossesCleared > 0)
                    {
                        <div class="defeat-rewards">
                            <div class="defeat-reward-row">
                                <i class="bi bi-lightning-fill text-warning"></i>
                                <span>@Fmt(bossesCleared) Bosses Derrotados</span>
                            </div>
                            <div class="defeat-reward-row">
                                <i class="bi bi-coin" style="color: #7c4dff;"></i>
                                <span>+@Fmt(totalFidelisEarned) Fidelis</span>
                            </div>
                            @if (totalLeitaoDropped > 0)
                            {
                                <div class="defeat-reward-row">
                                    <span style="font-size: 1rem;">🐷</span>
                                    <span>+@Fmt(totalLeitaoDropped) Leitão</span>
                                </div>
                            }
                            @if (totalFinosDropped > 0)
                            {
                                <div class="defeat-reward-row">
                                    <i class="bi bi-cup-straw text-warning"></i>
                                    <span>+@Fmt(totalFinosDropped) Fino</span>
                                </div>
                            }
                            @if (totalCanecasDropped > 0)
                            {
                                <div class="defeat-reward-row">
                                    <i class="bi bi-cup-straw text-warning"></i>
                                    <span>+@Fmt(totalCanecasDropped) Caneca</span>
                                </div>
                            }
                            @if (totalCigarrosDropped > 0)
                            {
                                <div class="defeat-reward-row">
                                    <i class="bi bi-cloud text-secondary"></i>
                                    <span>+@Fmt(totalCigarrosDropped) Cigarro</span>
                                </div>
                            }
                            @if (totalCanhaosDropped > 0)
                            {
                                <div class="defeat-reward-row">
                                    <i class="bi bi-bullseye text-danger"></i>
                                    <span>+@Fmt(totalCanhaosDropped) Canhão</span>
                                </div>
                            }
                            @if (totalShotsDropped > 0)
                            {
                                <div class="defeat-reward-row">
                                    <i class="bi bi-cup text-danger"></i>
                                    <span>+@totalShotsDropped Shot</span>
                                </div>
                            }
                            @if (totalPenaltiesDropped > 0)
                            {
                                <div class="defeat-reward-row">
                                    <i class="bi bi-lightning-charge-fill" style="color: #0dcaf0;"></i>
                                    <span>+@totalPenaltiesDropped Penalty</span>
                                </div>
                            }
                            @foreach (var (partType, qty) in totalInstrumentPartsDropped)
                            {
                                var instrumentType = InstrumentTypeHelper.FromInventoryPartType(partType);
                                var instrumentName = instrumentType.HasValue ? InstrumentTypeHelper.GetDisplayName(instrumentType.Value) : partType.ToString();
                                <div class="defeat-reward-row">
                                    <i class="bi bi-music-note" style="color: #a855f7;"></i>
                                    <span>+@qty @instrumentName</span>
                                </div>
                            }
                        </div>
                    }

                    @* Current Buffs Section *@
                    <div class="buff-section">
                        <h6 class="buff-section-title"><i class="bi bi-shield-check me-1"></i>Buffs Ativos</h6>
                        @if (character != null && (character.ShotBuffBattlesRemaining > 0 || character.CigarroShieldHitsRemaining > 0))
                        {
                            <div class="buff-active-list">
                                @if (character.ShotBuffBattlesRemaining > 0)
                                {
                                    <span class="boss-buff-tag boss-buff-tag--shot">
                                        <i class="bi bi-cup"></i> +@((int)((character.EffectiveShotBuffMultiplier - 1) * 100))% Stats
                                    </span>
                                }
                                @if (character.CigarroShieldHitsRemaining > 0)
                                {
                                    <span class="boss-buff-tag boss-buff-tag--dodge">
                                        <i class="bi bi-wind"></i> @((int)(character.EffectiveCigarroDodgeChance * 100))% Dodge
                                    </span>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="buff-none">Nenhum buff ativo</p>
                        }
                    </div>

                    @* FITAB Balance *@
                    <div class="buff-fitab">
                        <i class="bi bi-ticket-perforated-fill me-1"></i>
                        <span>@Fmt(fitabBalance) FITAB</span>
                        <span class="buff-fitab__cost">(1 FITAB por tentativa)</span>
                    </div>

                    @* Toast message *@
                    @if (!string.IsNullOrEmpty(buffToastMessage))
                    {
                        <div class="buff-toast @(buffToastIsError ? "buff-toast--error" : "buff-toast--success")">
                            <i class="bi @(buffToastIsError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") me-1"></i>
                            @buffToastMessage
                        </div>
                    }

                    @* Consumables Grid *@
                    <div class="buff-section">
                        <h6 class="buff-section-title"><i class="bi bi-cup-straw me-1"></i>Consumíveis</h6>
                        <div class="buff-item-grid">
                            @{
                                var isCharacterDead = character?.CurrentHP == null || character.CurrentHP <= 0;
                                var isFullHp = character != null && character.CurrentHP >= character.TotalHP;
                                var buffConsumables = new (string Name, string Icon, string Desc, string CssVariant, int UnlockStage, int Qty, bool Using, InventoryItemType ItemType, Func<Task> UseAction, bool ExtraDisabled)[]
                                {
                                    ("Cigarro", "bi-cloud", $"+{(int)(character!.EffectiveCigarroDodgeChance * 100)}% Dodge x5", "shot", 2001, cigarroQuantity, usingCigarro, InventoryItemType.Cigarro, UseCigarroBoss, isCharacterDead || character?.CigarroShieldHitsRemaining > 0),
                                    ("Shot", "bi-droplet-fill", $"+{(int)((character!.EffectiveShotBuffMultiplier - 1) * 100)}% Stats x5", "shot", 5001, shotQuantity, usingShot, InventoryItemType.Shot, UseShotBoss, isCharacterDead || character?.ShotBuffBattlesRemaining > 0),
                                    ("Canhão", "bi-bullseye", "Stage Only", "shot", 7001, canhaoQuantity, usingCanhao, InventoryItemType.Canhao, UseCanhaoBoss, true),
                    ("Penalty", "bi-lightning-charge-fill", $"Lifesteal {(character!.EffectivePenaltyLifesteal * 100):F1}% HP {character!.EffectivePenaltyMinutes}min", "penalty", 9001, penaltyQuantity, usingPenalty, InventoryItemType.Penalty, UsePenaltyBoss, isCharacterDead || character?.HasPenaltyBuff == true),
                                };
                            }

                            @foreach (var c in buffConsumables)
                            {
                                var isLocked = c.UnlockStage > consumableHighestStage;
                                var isDisabled = isLocked || c.Using || c.Qty == 0 || c.ExtraDisabled;

                                <div class="buff-item-card buff-item-card--@c.CssVariant @(isLocked ? "buff-item-card--locked" : "") @(isDisabled && !isLocked ? "buff-item-card--disabled" : "")"
                                     @onclick="async () => { if (!isDisabled) await c.UseAction(); }"
                                     style="cursor: @(isDisabled ? "not-allowed" : "pointer")"
                                     title="@(isLocked ? $"Desbloqueia no Stage {c.UnlockStage}" : c.Desc)">
                                    <div class="buff-item-card__qty">
                                        @if (isLocked)
                                        {
                                            <i class="bi bi-lock-fill"></i>
                                        }
                                        else
                                        {
                                            @Fmt(c.Qty)
                                        }
                                    </div>
                                    <div class="buff-item-card__icon">
                                        @if (isLocked)
                                        {
                                            <i class="bi bi-lock-fill" style="opacity: 0.4;"></i>
                                        }
                                        else if (c.Using)
                                        {
                                            <span class="spinner-border spinner-border-sm text-info"></span>
                                        }
                                        else
                                        {
                                            <i class="bi @c.Icon"></i>
                                        }
                                    </div>
                                    <div class="buff-item-card__name">@c.Name</div>
                                    <div class="buff-item-card__desc">@c.Desc</div>
                                </div>
                            }
                        </div>
                    </div>

                    @* Action Buttons *@
                    <div class="buff-actions">
                        <button class="defeat-btn buff-btn--retry" @onclick="TryAgainBoss" disabled="@(fighting || isCharacterDead)">
                            <i class="bi bi-arrow-clockwise me-1"></i>TENTAR DE NOVO
                        </button>
                        <button class="defeat-btn buff-btn--end" @onclick="EndRunFromBuffScreen">
                            IR MY TUNO
                        </button>
                    </div>
                </div>
            </div>
        }

        @if (showDefeatSummary)
        {
            <div class="defeat-overlay">
                <div class="defeat-panel">
                    <div class="defeat-banner">
                        <span>BOSS MODE</span>
                    </div>
                    <div class="defeat-stage">Boss @Fmt(defeatedAtBossStage)</div>
                    @if (bossesCleared > 0)
                    {
                        <div class="defeat-rewards">
                            <div class="defeat-reward-row">
                                <i class="bi bi-lightning-fill text-warning"></i>
                                <span>@Fmt(bossesCleared) Bosses Derrotados</span>
                            </div>
                            <div class="defeat-reward-row">
                                <i class="bi bi-coin" style="color: #7c4dff;"></i>
                                <span>+@Fmt(totalFidelisEarned) Fidelis</span>
                            </div>
                            @if (totalLeitaoDropped > 0)
                            {
                                <div class="defeat-reward-row">
                                    <span style="font-size: 1rem;">🐷</span>
                                    <span>+@Fmt(totalLeitaoDropped) Leitão</span>
                                </div>
                            }
                            @if (totalFinosDropped > 0)
                            {
                                <div class="defeat-reward-row">
                                    <i class="bi bi-cup-straw text-warning"></i>
                                    <span>+@Fmt(totalFinosDropped) Fino</span>
                                </div>
                            }
                            @if (totalCanecasDropped > 0)
                            {
                                <div class="defeat-reward-row">
                                    <i class="bi bi-cup-straw text-warning"></i>
                                    <span>+@Fmt(totalCanecasDropped) Caneca</span>
                                </div>
                            }
                            @if (totalCigarrosDropped > 0)
                            {
                                <div class="defeat-reward-row">
                                    <i class="bi bi-cloud text-secondary"></i>
                                    <span>+@Fmt(totalCigarrosDropped) Cigarro</span>
                                </div>
                            }
                            @if (totalCanhaosDropped > 0)
                            {
                                <div class="defeat-reward-row">
                                    <i class="bi bi-bullseye text-danger"></i>
                                    <span>+@Fmt(totalCanhaosDropped) Canhão</span>
                                </div>
                            }
                            @if (totalShotsDropped > 0)
                            {
                                <div class="defeat-reward-row">
                                    <i class="bi bi-cup text-danger"></i>
                                    <span>+@totalShotsDropped Shot</span>
                                </div>
                            }
                            @if (totalPenaltiesDropped > 0)
                            {
                                <div class="defeat-reward-row">
                                    <i class="bi bi-lightning-charge-fill" style="color: #0dcaf0;"></i>
                                    <span>+@totalPenaltiesDropped Penalty</span>
                                </div>
                            }
                            @foreach (var (partType, qty) in totalInstrumentPartsDropped)
                            {
                                var instrumentType = InstrumentTypeHelper.FromInventoryPartType(partType);
                                var instrumentName = instrumentType.HasValue ? InstrumentTypeHelper.GetDisplayName(instrumentType.Value) : partType.ToString();
                                <div class="defeat-reward-row">
                                    <i class="bi bi-music-note" style="color: #a855f7;"></i>
                                    <span>+@qty @instrumentName</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="defeat-no-rewards">Nenhum boss derrotado.</p>
                    }
                    <button class="defeat-btn" @onclick="DefeatGoBack">
                        IR MY TUNO
                    </button>
                </div>
            </div>
        }
    }
</div>

@code {
    private Character? character;
    private ApplicationUser? currentUser;

    /// <summary>
    /// Reloads the current user from a fresh DbContext.
    /// UserManager.FindByIdAsync returns stale tracked entities from the scoped DI context.
    /// </summary>
    private async Task RefreshCurrentUserAsync()
    {
        if (currentUser == null) return;
        await using var ctx = DbContextFactory.CreateDbContext();
        var fresh = await ctx.Users.AsNoTracking().FirstOrDefaultAsync(u => u.Id == currentUser.Id);
        if (fresh != null)
            currentUser = fresh;
    }

    private BossModeProgress? bossModeProgress;
    private BossModeBattleResult? currentBattle;
    private bool loading = true;
    private bool fighting = false;
    private bool showBattleAnimation = false;
    private string errorMessage = string.Empty;
    private DotNetObjectReference<BossMode>? objRef;
    private bool hasRendered = false;
    private bool battleAutoStarted = false;

    // Battle controls
    private double battleSpeed = 1.0;
    private bool audioEnabled = true;

    // Accumulated loot tracker
    private decimal totalFidelisEarned = 0;
    private int totalLeitaoDropped = 0;
    private int totalFinosDropped = 0;
    private int totalCanecasDropped = 0;
    private int totalCigarrosDropped = 0;
    private int totalCanhaosDropped = 0;
    private int totalShotsDropped = 0;
    private int totalPenaltiesDropped = 0;
    private Dictionary<InventoryItemType, int> totalInstrumentPartsDropped = new();
    private int bossesCleared = 0;

    // Run state tracking
    private long? runStartingHp;
    private int runStartingBossStage;
    private int runStartingShotBuffBattles = 0;
    private int runStartingCigarroBuff = 0;
    private DateTime? runStartingCanhaoBuff;
    private DateTime? runStartingPenaltyBuff;
    private long runStartingPenaltyRemainingMs = 0;
    private bool runInProgress = false;
    private bool pendingDefeatRewards = false;
    private bool _disposed = false;
    private bool _runAlreadyStarted = false;
    private bool _precomputedWin = false;

    // Defeat summary
    private bool showDefeatSummary = false;
    private int defeatedAtBossStage = 0;
    private long? defeatRestoreHp;

    // Consumable state (post-defeat buff screen)
    private bool showBuffScreen = false;
    private int cigarroQuantity, canhaoQuantity, shotQuantity, penaltyQuantity;
    private bool usingCigarro, usingCanhao, usingShot, usingPenalty;
    private string? buffToastMessage;
    private bool buffToastIsError;
    private int consumableHighestStage = 1;
    private int fitabBalance = 0;

    private readonly SemaphoreSlim _bossLock = new(1, 1);
    private List<EnemyStatsInfo> currentEnemyStats = new();

    // Interactive combat session (spells / Blade Crafter mode)
    private CombatSession? _combatSession;
    private List<RTUB.Core.Entities.SpecialAttack>? _starterSpells;

    // In-combat consumable quantities (Fino & Caneca healing)
    private int _finoQty, _canecaQty;

    private static readonly JsonSerializerOptions _spellJsonOptions = new()
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull
    };

    protected override async Task OnInitializedAsync()
    {
        showBattleAnimation = false;
        fighting = false;
        await LoadDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            hasRendered = true;

            // Start the boss run here (not in OnInitializedAsync/LoadDataAsync)
            // because OnAfterRenderAsync NEVER fires during prerender.
            // OnInitializedAsync fires twice in InteractiveServer mode (prerender + circuit),
            // which would cause double FITAB deduction.
            if (character != null && currentUser != null && bossModeProgress != null
                && bossModeProgress.CurrentBossStage <= 0 && !_runAlreadyStarted)
            {
                try
                {
                    _runAlreadyStarted = true;
                    bossModeProgress = await BossModeService.StartBossModeRunAsync(currentUser.Id);
                    StateHasChanged();
                }
                catch (InvalidOperationException ex) when (ex.Message.Contains("FITAB") || ex.Message.Contains("Level"))
                {
                    errorMessage = ex.Message.Contains("Level")
                        ? "Precisas de Level 100 para aceder ao Boss Mode."
                        : "Não tens FITAB suficiente para entrar no Boss Mode.";
                    Logger.LogWarning(ex, "User tried to enter Boss Mode without meeting requirements");
                    StateHasChanged();
                    return;
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Error starting boss mode run");
                    errorMessage = "Erro ao iniciar Boss Mode.";
                    StateHasChanged();
                    return;
                }
            }

            if (character != null && currentBattle == null && !battleAutoStarted)
            {
                battleAutoStarted = true;
                await Task.Delay(50);
                try
                {
                    await FightBoss();
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Auto-start boss battle failed");
                    errorMessage = "Failed to start battle. Please try again.";
                    StateHasChanged();
                }
            }
        }
    }

    private async Task LoadDataAsync()
    {
        try
        {
            loading = true;
            errorMessage = string.Empty;

            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                currentUser = await UserManager.GetUserAsync(user);
                if (currentUser != null)
                {
                    // Refresh from fresh context — scoped DI context has stale data
                    await RefreshCurrentUserAsync();
                    var characterTask = CharacterService.GetOrCreateCharacterAsync(currentUser.Id);
                    var progressTask = BossModeService.GetOrCreateBossModeProgressAsync(currentUser.Id);
                    await Task.WhenAll(characterTask, progressTask);
                    character = characterTask.Result;
                    bossModeProgress = progressTask.Result;

                    if (character != null && bossModeProgress != null)
                    {
                        // Safety net: pause any active Canhão timer (only ticks in stage mode)
                        if (character.CanhaoBuffExpiresAt.HasValue)
                        {
                            character.PauseCanhaoBuff();
                            await CharacterService.UpdateCharacterAsync(character);
                        }
                        // Safety net: pause any active Penalty timer
                        if (character.PenaltyBuffExpiresAt.HasValue)
                        {
                            character.PausePenaltyBuff();
                            await CharacterService.UpdateCharacterAsync(character);
                        }

                        // Level gate: must be level 100+
                        if (character.Level < 100)
                        {
                            errorMessage = "Precisas de Level 100 para aceder ao Boss Mode.";
                            return;
                        }

                        // Run is started in OnAfterRenderAsync to avoid double FITAB
                        // deduction from prerender. Just load the data here.
                    }
                }
            }
        }
        catch (InvalidOperationException ex) when (ex.Message.Contains("FITAB") || ex.Message.Contains("Level"))
        {
            errorMessage = ex.Message.Contains("Level")
                ? "Precisas de Level 100 para aceder ao Boss Mode."
                : "Não tens FITAB suficiente para entrar no Boss Mode.";
            Logger.LogWarning(ex, "User tried to enter Boss Mode without meeting requirements");
        }
        catch (NavigationException)
        {
            throw;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading boss mode data");
            errorMessage = "Erro ao carregar dados do Boss Mode.";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task FightBoss()
    {
        if (_disposed) return;
        if (character == null || currentUser == null || bossModeProgress == null) return;
        if (fighting) return;
        if (!await _bossLock.WaitAsync(0)) return;

        try
        {
            fighting = true;
            var wasAlreadyAnimating = showBattleAnimation;
            showBattleAnimation = true;
            errorMessage = string.Empty;

// Ensure the server-side run is started. This handles the timing race where
        // OnAfterRenderAsync(firstRender: true) fired before LoadDataAsync completed,
        // so the run-start block was skipped.
        if (bossModeProgress.CurrentBossStage <= 0 && !_runAlreadyStarted)
        {
            try
            {
                _runAlreadyStarted = true;
                bossModeProgress = await BossModeService.StartBossModeRunAsync(currentUser.Id);
            }
            catch (InvalidOperationException ex) when (ex.Message.Contains("FITAB") || ex.Message.Contains("Level"))
            {
                errorMessage = ex.Message.Contains("Level")
                    ? "Precisas de Level 100 para aceder ao Boss Mode."
                    : "Não tens FITAB suficiente para entrar no Boss Mode.";
                Logger.LogWarning(ex, "User tried to enter Boss Mode without meeting requirements");
                return;
            }
        }

        if (!runInProgress)
            {
                runStartingHp = character.CurrentHP;
                runStartingBossStage = bossModeProgress.CurrentBossStage;
                runStartingShotBuffBattles = character.ShotBuffBattlesRemaining;
                runStartingCigarroBuff = character.CigarroShieldHitsRemaining;
                runStartingCanhaoBuff = character.CanhaoBuffExpiresAt;
                runStartingPenaltyBuff = character.PenaltyBuffExpiresAt;
                runStartingPenaltyRemainingMs = character.PenaltyBuffRemainingMs;
                runInProgress = true;

                // Resume paused Penalty buff so the timer starts ticking during the run
                if (character.PenaltyBuffRemainingMs > 0)
                {
                    character.ResumePenaltyBuff();
                    await CharacterService.UpdateCharacterAsync(character);
                }

                // Load consumable quantities for in-fight bar (once per run)
                try
                {
                    var inv = await InventoryService.GetUserInventorySummaryAsync(currentUser.Id);
                    _finoQty = inv.GetValueOrDefault(InventoryItemType.Fino);
                    _canecaQty = inv.GetValueOrDefault(InventoryItemType.Caneca);
                    cigarroQuantity = inv.GetValueOrDefault(InventoryItemType.Cigarro);
                    canhaoQuantity = inv.GetValueOrDefault(InventoryItemType.Canhao);
                    shotQuantity = inv.GetValueOrDefault(InventoryItemType.Shot);
                    penaltyQuantity = inv.GetValueOrDefault(InventoryItemType.Penalty);
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Failed to load consumable quantities for boss run");
                }

                Logger.LogInformation("Boss Mode run started by {UserName} at boss stage {Stage}",
                    currentUser.UserName, bossModeProgress.CurrentBossStage);
            }

            if (!wasAlreadyAnimating)
            {
                StateHasChanged();
                await JSRuntime.InvokeVoidAsync("window.scrollTo", 0, 0);
                await Task.Delay(50);
            }

            // Capture pre-battle state BEFORE ExecuteBossBattleAsync mutates the tracked
            // entity (via EF Core shared DbContext). The service writes post-battle HP and
            // consumed buff counts, but the interactive session needs the original pre-battle values.
            var preBattleHp = character.CurrentHP ?? character.TotalHP;
            var preBattleShotBuff = character.ShotBuffBattlesRemaining > 0;
            var preBattlePenaltyBuff = character.HasPenaltyBuff;
            var preBattleCigarroBuff = character.CigarroShieldHitsRemaining;
            var preBattleCanhaoBuff = character.CanhaoBuffExpiresAt;

            currentBattle = await BossModeService.ExecuteBossBattleAsync(character.Id);
            _precomputedWin = currentBattle.Outcome == BattleOutcome.AttackerWon;

            if (currentBattle.Outcome != BattleOutcome.AttackerWon)
            {
                defeatRestoreHp = runStartingHp;
                runInProgress = false;
                runStartingHp = null;
                pendingDefeatRewards = true;
            }

            if (!string.IsNullOrEmpty(currentBattle.ReplayJson))
            {
                try
                {
                    objRef ??= DotNetObjectReference.Create(this);

                    var replayData = JsonSerializer.Deserialize<JsonElement>(currentBattle.ReplayJson);
                    var eventsJson = replayData.TryGetProperty("Events", out var eventsProp) ? eventsProp.GetRawText() : currentBattle.ReplayJson;

                    List<string> enemySpritePaths = new();
                    if (replayData.TryGetProperty("EnemySprites", out var spritesProp) && spritesProp.ValueKind == JsonValueKind.Array)
                    {
                        foreach (var sprite in spritesProp.EnumerateArray())
                            enemySpritePaths.Add(sprite.GetString() ?? "/sprites/games/my-tuno/enemies/forest/boss_1_bear.png");
                    }
                    if (enemySpritePaths.Count == 0)
                        enemySpritePaths.Add("/sprites/games/my-tuno/enemies/forest/boss_1_bear.png");

                    currentEnemyStats.Clear();
                    if (replayData.TryGetProperty("EnemyStats", out var statsProp) && statsProp.ValueKind == JsonValueKind.Array)
                    {
                        foreach (var stat in statsProp.EnumerateArray())
                        {
                            var name = stat.TryGetProperty("Name", out var np) ? np.GetString() ?? "Boss" : "Boss";
                            var hp = stat.TryGetProperty("HP", out var hpP) ? hpP.GetInt64() : 0L;
                            var maxHp = stat.TryGetProperty("MaxHP", out var mhpP) ? mhpP.GetInt64() : hp;
                            var power = stat.TryGetProperty("Power", out var ppP) ? ppP.GetInt64() : 0L;
                            var defense = stat.TryGetProperty("Defense", out var dp) ? dp.GetInt64() : 0L;
                            var actionTime = stat.TryGetProperty("ActionTime", out var atp) ? atp.GetDouble() : 5.0;
                            currentEnemyStats.Add(new EnemyStatsInfo(name, hp, maxHp, power, defense, actionTime));
                        }
                    }

                    // ── Interactive combat session (spells / Blade Crafter mode) ──
                    RTUB.Core.Enums.InstrumentType? combatInstrumentType = null;
                    if (character.EquippedWeapon1.HasValue)
                    {
                        var weapons = await InventoryService.GetForgedWeaponsAsync(currentUser.Id);
                        var equippedWeapon = weapons.FirstOrDefault(w => w.Id == character.EquippedWeapon1.Value);
                        if (equippedWeapon != null)
                            combatInstrumentType = InstrumentTypeHelper.FromInventoryPartType(equippedWeapon.SourceInstrument);
                    }
                    _starterSpells = null; // Special attacks disabled in Boss Mode
                    var enemyStates = currentEnemyStats.Select((e, i) => new CombatantState
                    {
                        Identifier = $"Enemy{i}",
                        Name = e.Name,
                        CurrentHP = e.HP,
                        MaxHP = e.MaxHP ?? e.HP,
                        Power = e.Power,
                        Defense = e.Defense,
                        CriticalChance = 0.05,
                        ActionTimeSeconds = e.ActionTime
                    }).ToList();

                    // Build a combat character copy that matches what the pre-computed engine
                    // uses (shot buff / penalty buff scaling). Restore the pre-battle HP and
                    // consumable buff charges so the interactive session starts with the correct
                    // state (ExecuteBossBattleAsync already consumed them in the pre-computed sim).
                    var savedHp = character.CurrentHP;
                    character.CurrentHP = preBattleHp;
                    character.CigarroShieldHitsRemaining = preBattleCigarroBuff;
                    character.CanhaoBuffExpiresAt = preBattleCanhaoBuff;
                    Character sessionChar = character;
                    if (preBattleShotBuff)
                        sessionChar = Character.CreateShotBuffedCopy(character);

                    // Create the session BEFORE restoring post-battle HP — sessionChar is the
                    // same reference as character (when no shot buff), so restoring afterward
                    // would cause the session to start with post-battle HP instead of pre-battle.
                    _combatSession = CombatActionService.CreateSession(
                        sessionChar, enemyStates, currentBattle.Seed, _starterSpells, "boss");

                    character.CurrentHP = savedHp; // Restore post-battle HP on the tracked entity

                    var battleData = new
                    {
                        EventsJson = eventsJson,
                        DotNetRef = objRef,
                        StageNumber = currentBattle.BossStage,
                        EnemyType = "boss",
                        EnemyCount = 1,
                        PlayerName = character.User?.Nickname ?? character.User?.UserName ?? "Player",
                        EnemyName = currentBattle.BossName,
                        BackgroundPath = BossModeService.GetBackgroundPath(),
                        PlayerSpritePath = !string.IsNullOrEmpty(character.CustomSpritePath) ? character.CustomSpritePath : "/sprites/games/my-tuno/default_tuno.png",
                        EnemySprites = enemySpritePaths,
                        EnemyPlacements = new List<int> { 0 },
                        BattleSpeed = battleSpeed,
                        HasShotBuff = character.ShotBuffBattlesRemaining > 0,
                        // ── Interactive combat data ──
                        InteractiveMode = true,
                        PlayerHP = _combatSession!.Player.CurrentHP,
                        PlayerMaxHP = _combatSession.Player.MaxHP,
                        PlayerActionTime = _combatSession.Player.ActionTimeSeconds,
                        Enemies = _combatSession.Enemies.Select((e, i) => new
                        {
                            e.Name,
                            HP = e.CurrentHP,
                            e.MaxHP,
                            ActionTime = e.ActionTimeSeconds
                        }),
                        Spells = Array.Empty<object>(),
                        Consumables = new
                        {
                            Fino = _finoQty,
                            Caneca = _canecaQty,
                            Cigarro = cigarroQuantity,
                            Canhao = canhaoQuantity,
                            Shot = shotQuantity,
                            Penalty = penaltyQuantity
                        },
                        ConsumableCooldowns = new Dictionary<string, double>(_combatSession.ConsumableCooldowns),
                        ActiveBuffs = new
                        {
                            Cigarro = _combatSession.HasCigarroBuff,
                            Canhao = _combatSession.HasCanhaoBuff,
                            Shot = _combatSession.HasShotBuff,
                            Penalty = _combatSession.HasPenaltyBuff
                        },
                        // Penalty countdown bar: pass expiry UTC so JS can render a depleting timer bar
                        PenaltyBuffExpiresAtUtc = character.PenaltyBuffExpiresAt.HasValue
                            ? character.PenaltyBuffExpiresAt.Value.ToString("o")
                            : (string?)null
                    };

                    await JSRuntime.InvokeVoidAsync("stageBattleGame.nextBattle", battleData);
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Error starting boss battle animation");
                }
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error executing boss battle");
            errorMessage = "Erro ao executar batalha de boss.";
            showBattleAnimation = false;
            StateHasChanged();
        }
        finally
        {
            fighting = false;
            _bossLock.Release();
        }
    }

