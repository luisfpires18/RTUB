@page "/my-tuno/all-characters"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using RTUB.Application.Interfaces
@using RTUB.Core.Entities
@using RTUB.Core.Helpers
@using RTUB.Shared
@using RTUB.Shared.Base
@attribute [Authorize]
@inherits CrudTablePageBase<Character>
@inject ICharacterService CharacterService
@inject ILogger<AllCharacters> Logger
@inject RTUB.Web.Services.AdminRefreshService AdminRefreshService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>Todos os Personagens - RTUB</PageTitle>

<div class="all-characters-page container-fluid">
    <div class="page-header-centered mb-4">
        <div class="page-header-left d-none d-lg-flex">
            <a href="/my-tuno" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i>
            </a>
        </div>
        <div class="page-header-center">
            <h1><i class="bi bi-people"></i> Todos os Personagens</h1>
            <p class="page-header-subtitle">Classificação de todos os personagens.</p>
        </div>
        <div class="page-header-right d-none d-xl-flex">
            <AuthorizeView Roles="Owner">
                <button type="button" class="btn btn-danger" disabled
                        title="Reset temporariamente desativado">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> <span class="btn-text">Reset Data</span>
                </button>
            </AuthorizeView>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(toastMessage))
    {
        <div class="mb-3">
            <Alert Type="@(toastIsError ? Alert.AlertType.Error : Alert.AlertType.Success)"
                   Message="@toastMessage"
                   Dismissible="true"
                   OnDismiss="@(() => toastMessage = null)" />
        </div>
    }

    @if (loading)
    {
        <LoadingSpinner />
    }
    else if (AllItems == null || AllItems.Count == 0)
    {
        <EmptyState Title="Nenhum personagem encontrado"
                    Message="Ainda não existem personagens criados."
                    Icon="bi-person-x" />
    }
    else
    {
        <!-- Search -->
        <div class="mb-4">
            <SearchBar Placeholder="Pesquisar por nome..."
                       Value="@SearchTerm"
                       OnSearch="UpdateSearch" />
        </div>

        <!-- Stats & Sort -->
        var levelActive = SortHelper.SortColumn == "level";
        var ratingActive = SortHelper.SortColumn == "rating";
        var stageActive = SortHelper.SortColumn == "stage";
        var sortArrow = SortHelper.SortAscending ? "bi-arrow-up" : "bi-arrow-down";
        <div class="mb-4">
            <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                <div class="badge bg-primary fs-6 py-2 px-3">
                    <i class="bi bi-people me-1"></i> Total: @FilteredItems.Count
                </div>
            </div>
            <div class="d-flex flex-wrap gap-2 align-items-center">
                <span class="text-muted small me-1">Ordenar:</span>
            <button class="btn sort-badge @(levelActive ? "sort-badge--active" : "")" @onclick="@(() => SortBy("level"))">
                <i class="bi bi-star-fill me-1"></i>Nível
                @if (levelActive)
                {
                    <i class="bi @sortArrow ms-1"></i>
                }
            </button>
            <button class="btn sort-badge @(ratingActive ? "sort-badge--active" : "")" @onclick="@(() => SortBy("rating"))">
                <i class="bi bi-trophy-fill me-1"></i>Rating
                @if (ratingActive)
                {
                    <i class="bi @sortArrow ms-1"></i>
                }
            </button>
            <button class="btn sort-badge @(stageActive ? "sort-badge--active" : "")" @onclick="@(() => SortBy("stage"))">
                <i class="bi bi-layers me-1"></i>Stage
                @if (stageActive)
                {
                    <i class="bi @sortArrow ms-1"></i>
                }
            </button>
            </div>
        </div>

        <!-- Character Grid -->
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 g-3 mb-4">
            @foreach (var character in PaginatedItems)
            {
                <div class="col" @key="character.Id">
                    <div class="fantasy-character-card">
                        <!-- Owner-only Delete (top-right) -->
                        <AuthorizeView Roles="Owner">
                            <button class="fantasy-card-delete-btn"
                                    @onclick="@(() => OpenDeleteCharacterModal(character))"
                                    @onclick:stopPropagation="true"
                                    title="Eliminar personagem">
                                <i class="bi bi-trash"></i>
                            </button>
                        </AuthorizeView>

                        <!-- Avatar + Name -->
                        <div class="fantasy-character-card-header">
                            @if (character.User != null && !string.IsNullOrEmpty(character.User.ProfilePictureSrc))
                            {
                                <img src="@CacheBuster.Bust(character.User.ProfilePictureSrc)"
                                     alt="@GetDisplayName(character)"
                                     class="fantasy-character-avatar"
                                     loading="lazy" />
                            }
                            else
                            {
                                <div class="fantasy-character-avatar-placeholder">
                                    <i class="bi bi-person"></i>
                                </div>
                            }
                            <div>
                                <h6 class="mb-0">@GetDisplayName(character)</h6>
                                <span class="badge bg-primary">Nível @character.Level</span>
                            </div>
                        </div>

                        <!-- Rank Badge -->
                        @{ var rank = RankHelper.GetRank(character.ArenaRating); }
                        <div class="fantasy-character-rank rank-tinted @RankHelper.GetRankColorClass(character.ArenaRating)">
                            <i class="bi @rank.Icon rank-tinted__icon"></i>
                            <span class="rank-tinted__name">@rank.Name</span>
                            <span class="u-fs-80 text-muted ms-auto">@character.ArenaRating</span>
                        </div>

                        <!-- Character Sprite -->
                        @{
                            var spritePath = !string.IsNullOrEmpty(character.CustomSpritePath)
                                ? character.CustomSpritePath
                                : "/sprites/games/my-tuno/default_tuno.png";
                        }
                        <div class="text-center my-2">
                            <img src="@CacheBuster.Bust(spritePath)" alt="@GetDisplayName(character)"
                                 class="u-maxh-100 u-of-contain" loading="lazy" />
                        </div>

                        <!-- Player Stats -->
                        <div class="fantasy-section-label"><i class="bi bi-bar-chart-fill me-1"></i>Estatísticas</div>
                        <div class="fantasy-character-stats">
                            <FantasyTile Icon="bi-heart-fill" Label="HP" Value="@Fmt(character.TotalHP)" Color="red" Size="sm" />
                            <FantasyTile Icon="bi-lightning-fill" Label="Poder" Value="@Fmt(character.TotalPower)" Color="green" Size="sm" />
                            <FantasyTile Icon="bi-shield-fill" Label="Defesa" Value="@Fmt(character.TotalDefense)" Color="gray" Size="sm" />
                            <FantasyTile Icon="bi-speedometer2" Label="Velocidade" Value="@($"{character.ActionTime:F1}s")" Color="blue" Size="sm" />
                            <FantasyTile Icon="bi-bullseye" Label="Crítico" Value="@($"{character.TotalCriticalChance * 100:F1}%")" Color="yellow" Size="sm" />
                        </div>

                        <hr class="fantasy-divider" />

                        <!-- Classification Stats -->
                        <div class="fantasy-section-label"><i class="bi bi-trophy-fill me-1"></i>Conquistas</div>
                        <div class="fantasy-character-stats">
                            <FantasyTile Icon="bi-layers" Label="Stage" Value="@GetStageMax(character)" Color="yellow" Size="sm" />
                            <FantasyTile Icon="bi-flag-fill" Label="Boss" Value="@GetBossMax(character)" Color="orange" Size="sm" />
                            <FantasyTile Icon="bi-check-circle-fill" Label="Vitórias" Value="@character.ArenaWins.ToString()" Color="green" Size="sm" />
                            <FantasyTile Icon="bi-x-circle-fill" Label="Derrotas" Value="@character.ArenaLosses.ToString()" Color="red" Size="sm" />
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        <TablePagination CurrentPage="@PaginationHelper.CurrentPage"
                         PageSize="@PaginationHelper.PageSize"
                         TotalItems="@FilteredItems.Count"
                         ItemLabel="personagens"
                         OnPageChanged="ChangePage"
                         OnPageSizeChanged="ChangePageSize"
                         PageSizeOptions="@(new[] { 20, 50, 100 })" />
    }
</div>

<!-- Delete Character Confirmation (Owner only) -->
@if (characterToDelete != null)
{
    <ConfirmDialog Show="@showDeleteCharacterModal"
                   ShowChanged="@((bool v) => { if (!v) CloseDeleteCharacterModal(); })"
                   Title="Eliminar Personagem"
                   Message="@($"Tens a certeza que queres eliminar o personagem de {GetDisplayName(characterToDelete)}? Todos os dados de jogo serão eliminados permanentemente.")"
                   WarningMessage="Esta ação é irreversível!"
                   ConfirmText="Eliminar"
                   CancelText="Cancelar"
                   ConfirmButtonClass="btn-danger"
                   Disabled="@deletingCharacter"
                   OnConfirm="ConfirmDeleteCharacter"
                   OnCancel="CloseDeleteCharacterModal" />
}

<!-- Reset All Data Confirmation (Owner only) -->
<ConfirmDialog Show="@showResetDataModal"
               ShowChanged="@((bool v) => { if (!v) CloseResetDataModal(); })"
               Title="Reset de TODOS os Dados"
               Message="Tens a certeza que queres resetar TODOS os dados de jogo? Isto vai eliminar TODOS os personagens, inventários, armas, progressos de stages, boss mode, survive mode e scores de TODOS os jogadores."
               WarningMessage="ATENÇÃO: Esta ação elimina permanentemente TODOS os dados de jogo de TODOS os jogadores. Não é possível reverter!"
               ConfirmText="Resetar Tudo"
               CancelText="Cancelar"
               ConfirmButtonClass="btn-danger"
               Disabled="@resettingData"
               OnConfirm="ConfirmResetData"
               OnCancel="CloseResetDataModal" />


<MobileBottomNav Items="@mobileNavItems" ActiveKey="" OnSelect="HandleMobileNavSelect" />

@code {
    private bool loading = true;
    private Dictionary<string, int> stageMap = new();
    private Dictionary<string, int> bossMap = new();
    private Character? characterToDelete;
    private bool showDeleteCharacterModal = false;
    private bool deletingCharacter = false;
    private bool showResetDataModal = false;
    private bool resettingData = false;
    private string? toastMessage;
    private bool toastIsError;
    private IReadOnlyList<MobileBottomNav.MobileNavItem> mobileNavItems = Array.Empty<MobileBottomNav.MobileNavItem>();

    protected override async Task OnInitializedAsync()
    {
        // Build mobile nav items
        var items = new List<MobileBottomNav.MobileNavItem>
        {
            new("action-back", "Voltar", "bi-arrow-left")
        };

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var isOwner = authState.User.IsInRole("Owner");
        // Reset temporarily disabled
        // if (isOwner)
        //     items.Add(new("action-reset", "Reset", "bi-arrow-counterclockwise"));

        mobileNavItems = items;

        await LoadItemsAsync();
        loading = false;
    }

    private void HandleMobileNavSelect(string key)
    {
        switch (key)
        {
            case "action-back": Navigation.NavigateTo("/my-tuno"); break;
            case "action-reset": OpenResetDataModal(); break;
        }
    }

    protected override async Task LoadItemsAsync()
    {
        try
        {
            var charsTask = CharacterService.GetAllCharactersOrderedByLevelAsync();
            var progressTask = CharacterService.GetStageAndBossProgressAsync();
            await Task.WhenAll(charsTask, progressTask);
            AllItems = charsTask.Result;
            var (stageResult, bossResult) = progressTask.Result;
            stageMap = stageResult;
            bossMap = bossResult;

            // Default sort: Level desc → Rating desc
            AllItems = AllItems
                .OrderByDescending(c => c.Level)
                .ThenByDescending(c => c.ArenaRating)
                .ToList();

            ApplyFiltersAndPagination();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading characters");
            AllItems = new();
        }
    }

    protected override Dictionary<string, Func<Character, IComparable>> GetSortColumnSelectors()
    {
        return new Dictionary<string, Func<Character, IComparable>>
        {
            ["rating"] = c => c.ArenaRating,
            ["stage"] = c => stageMap.TryGetValue(c.UserId, out var s) ? s : 0,
            ["level"] = c => c.Level,
            ["name"] = c => c.User?.Nickname ?? ""
        };
    }

    protected override List<Func<Character, string>> GetSearchSelectors()
    {
        return new List<Func<Character, string>>
        {
            c => c.User?.Nickname ?? "",
            c => $"Nível {c.Level}"
        };
    }

    // Helpers
    private static string GetDisplayName(Character character)
    {
        if (character.User == null) return "Personagem";
        return !string.IsNullOrEmpty(character.User.Nickname)
            ? character.User.Nickname
            : "Personagem";
    }

    private string GetStageMax(Character character) =>
        stageMap.TryGetValue(character.UserId, out var s) ? s.ToString() : "0";

    private string GetBossMax(Character character) =>
        bossMap.TryGetValue(character.UserId, out var b) ? b.ToString() : "0";

    private static string Fmt(long value) => NumberFormatter.Compact(value);

    // Delete character (owner only)
    private void OpenDeleteCharacterModal(Character character)
    {
        characterToDelete = character;
        showDeleteCharacterModal = true;
    }

    private void CloseDeleteCharacterModal()
    {
        showDeleteCharacterModal = false;
        characterToDelete = null;
    }

    private async Task ConfirmDeleteCharacter()
    {
        if (characterToDelete == null || deletingCharacter) return;
        deletingCharacter = true;

        try
        {
            var name = GetDisplayName(characterToDelete);
            var (success, message) = await CharacterService.DeleteCharacterAsync(characterToDelete.UserId);
            showDeleteCharacterModal = false;
            characterToDelete = null;

            if (success)
            {
                await LoadItemsAsync();
                toastMessage = $"{name}: {message}";
                toastIsError = false;
            }
            else
            {
                toastMessage = message;
                toastIsError = true;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting character");
            toastMessage = "Erro ao eliminar personagem.";
            toastIsError = true;
        }
        finally
        {
            deletingCharacter = false;
        }
    }

    // Reset all data (owner only)
    private void OpenResetDataModal() => showResetDataModal = true;
    private void CloseResetDataModal() => showResetDataModal = false;

    private async Task ConfirmResetData()
    {
        if (resettingData) return;
        resettingData = true;

        try
        {
            var (success, message) = await CharacterService.ResetAllGameDataAsync();
            showResetDataModal = false;
            toastMessage = message;
            toastIsError = !success;
            if (success)
            {
                await LoadItemsAsync();
                // Notify all connected circuits to refresh user data (FidelisBalance)
                _ = AdminRefreshService.TriggerRefreshAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error resetting all game data");
            toastMessage = "Erro ao resetar dados.";
            toastIsError = true;
        }
        finally
        {
            resettingData = false;
        }
    }
}
