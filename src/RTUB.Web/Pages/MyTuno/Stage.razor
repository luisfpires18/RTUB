@page "/my-tuno/stages"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.JSInterop
@using RTUB.Application.Interfaces
@using RTUB.Application.Data
@using RTUB.Application.DTOs
@using RTUB.Core.Entities
@using RTUB.Core.Enums
@using RTUB.Core.Helpers
@using RTUB.Shared
@using RTUB.Shared.Base
@using RTUB.Shared.Components.UI
@using System.Text.Json
@using System.Text.Json.Serialization
@using Microsoft.EntityFrameworkCore
@attribute [Authorize]
@inject IStageService StageService
@inject ICharacterService CharacterService
@inject INaipeService NaipeService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject ILogger<Stage> Logger
@inject IStageBiomeService BiomeService
@inject IAuditLogService AuditLogService
@inject ICombatActionService CombatActionService
@inject IInventoryService InventoryService
@inject IInventoryRepository InventoryRepository
@inject IItemTypeConfigService ItemTypeConfigService
@inject Microsoft.Extensions.Options.IOptions<RTUB.Application.Configuration.MyTunoScalingConfiguration> ScalingConfig
@inject IConfiguration Configuration
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@implements IAsyncDisposable

<PageTitle>Stage Mode - My Tuno - RTUB</PageTitle>

<div class="stage-page">
    @if (loading)
    {
        <div class="stage-loading">
            <LoadingSpinner />
        </div>
    }
    else if (character == null)
    {
        <div class="stage-loading">
            <EmptyState Title="Personagem não encontrado"
                        Message="Ocorreu um erro ao carregar o teu personagem."
                        Icon="bi-person-x" />
        </div>
    }
    else if (errorMessage != string.Empty)
    {
        <div class="stage-loading">
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
            </div>
        </div>
    }
    else
    {
        @if (showBattleAnimation)
        {
            <!-- ═══ Fullscreen Battle Screen (WOO-inspired) ═══ -->
            <div class="battle-screen">
                <!-- Canvas fills the entire battle area -->
                <div id="phaserBattleContainer" class="battle-canvas"></div>

                <!-- ── TOP BAR: Back + Floor (center) + Rewards + Controls ── -->
                <div class="battle-top-bar">
                    <!-- Left: Back button -->
                    <button class="battle-back-btn" @onclick="GoBack" title="Voltar">
                        <i class="bi bi-chevron-left"></i>
                    </button>

                    <!-- Center: Floor indicator (absolutely positioned) -->
                    <div class="battle-floor-indicator">
                        <span class="floor-label">FLOOR</span>
                        @if (currentBattle != null)
                        {
                            <span class="floor-num">@currentBattle.StageNumber</span>
                        }
                        else
                        {
                            <span class="floor-num">—</span>
                        }
                    </div>

                    <!-- Left-middle: Compact rewards tracker -->
                    @if (stagesCleared > 0)
                    {
                        <div class="battle-rewards-strip">
                            <span class="reward-tag reward-tag--xp">
                                <i class="bi bi-star-fill"></i> @Fmt(totalXPEarned) XP
                            </span>
                            <span class="reward-tag reward-tag--fidelis">
                                <i class="bi bi-coin"></i> @Fmt(totalFidelisEarned) Fidelis
                            </span>
                            @if (totalFinosDropped > 0)
                            {
                                <span class="reward-tag reward-tag--drink">
                                    <i class="bi bi-cup-straw"></i> @Fmt(totalFinosDropped) Fino
                                </span>
                            }
                            @if (totalCanecasDropped > 0)
                            {
                                <span class="reward-tag reward-tag--drink">
                                    <i class="bi bi-cup-straw"></i> @Fmt(totalCanecasDropped) Caneca
                                </span>
                            }
                            @if (totalCigarrosDropped > 0)
                            {
                                <span class="reward-tag reward-tag--drink">
                                    <i class="bi bi-cloud"></i> @Fmt(totalCigarrosDropped) Cigarro
                                </span>
                            }
                            @if (totalCanhaosDropped > 0)
                            {
                                <span class="reward-tag reward-tag--drink">
                                    <i class="bi bi-bullseye"></i> @Fmt(totalCanhaosDropped) Canhão
                                </span>
                            }
                            @if (totalShotsDropped > 0)
                            {
                                <span class="reward-tag reward-tag--drink">
                                    <i class="bi bi-cup"></i> @totalShotsDropped Shot
                                </span>
                            }
                            @if (totalPenaltiesDropped > 0)
                            {
                                <span class="reward-tag reward-tag--drink">
                                    <i class="bi bi-lightning-charge-fill"></i> @totalPenaltiesDropped Penalty
                                </span>
                            }
                            @if (totalFitabDropped > 0)
                            {
                                <span class="reward-tag reward-tag--drink" style="color: #e040fb;">
                                    <i class="bi bi-lightning-fill"></i> @totalFitabDropped FITAB
                                </span>
                            }
                            @if (totalLeitaoDropped > 0)
                            {
                                <span class="reward-tag reward-tag--drink" style="color: #ff9800;">
                                    <i class="bi bi-piggy-bank"></i> @totalLeitaoDropped Leitão
                                </span>
                            }
                            @if (totalInstrumentPartsDropped.Count > 0)
                            {
                                <span class="reward-tag reward-tag--instrument">
                                    <i class="bi bi-music-note"></i> @totalInstrumentPartsDropped.Values.Sum() Instrumentos
                                </span>
                            }
                            @if (totalRareSetDropped.Count > 0)
                            {
                                <span class="reward-tag reward-tag--rare" style="color: #ffd700; text-shadow: 0 0 6px #ffd700;">
                                    <i class="bi bi-gem"></i> @totalRareSetDropped.Count Equipamento Raro
                                </span>
                            }

                        </div>
                    }
                    
                    <!-- Controls (right side) -->
                    <div class="battle-controls">
                        <button class="battle-ctrl-btn @(battleSpeed == 1.0 ? "active" : "")" @onclick="() => SetBattleSpeed(1.0)">1x</button>
                        <button class="battle-ctrl-btn @(battleSpeed == 5.0 ? "active" : "")" @onclick="() => SetBattleSpeed(5.0)">5x</button>
                        <button class="battle-ctrl-btn battle-ctrl-btn--audio" @onclick="ToggleAudio" title="Som">
                            <i class="bi @(audioEnabled ? "bi-volume-up" : "bi-volume-mute")"></i>
                        </button>
                        <button class="battle-ctrl-btn battle-ctrl-btn--stop" @onclick="EndRunEarly" title="Acabar">
                            <i class="bi bi-stop-fill"></i>
                        </button>
                    </div>
                </div>

                <!-- ── Active Buff Indicators (below top bar) ── -->
                @if (character != null && (character.ShotBuffBattlesRemaining > 0 || character.CigarroShieldHitsRemaining > 0))
                {
                    <div class="battle-buffs-strip">
                        @if (character.ShotBuffBattlesRemaining > 0)
                        {
                            <span class="buff-tag buff-tag--shot"><i class="bi bi-cup"></i>+@((int)((character.EffectiveShotBuffMultiplier - 1) * 100))% Stats</span>
                        }
                        @if (character.CigarroShieldHitsRemaining > 0)
                        {
                            <span class="buff-tag buff-tag--dodge"><i class="bi bi-wind"></i>@((int)(character.EffectiveCigarroDodgeChance * 100))% Dodge @character.CigarroShieldHitsRemaining runs</span>
                        }
                    </div>
                }
            </div>
        }

        @if (showDefeatSummary)
        {
            <div class="defeat-overlay">
                <div class="defeat-panel">
                    <div class="defeat-banner">
                        <span>STAGE END</span>
                    </div>
                    <div class="defeat-stage">Floor @defeatedAtStage</div>
                    @if (stagesCleared > 0)
                    {
                        <div class="defeat-rewards">
                            <div class="defeat-reward-row">
                                <i class="bi bi-check-circle-fill text-success"></i>
                                <span>@Fmt(stagesCleared) Floors</span>
                            </div>
                            <div class="defeat-reward-row">
                                <i class="bi bi-star-fill text-warning"></i>
                                <span>+@Fmt(totalXPEarned) XP</span>
                            </div>
                            <div class="defeat-reward-row">
                                <i class="bi bi-coin" style="color: #7c4dff;"></i>
                                <span>+@Fmt(totalFidelisEarned) Fidelis</span>
                            </div>
                            @if (totalFinosDropped > 0)
                            {
                                <div class="defeat-reward-row">
                                    <i class="bi bi-cup-straw text-warning"></i>
                                    <span>+@Fmt(totalFinosDropped) Fino</span>
                                </div>
                            }
                            @if (totalCanecasDropped > 0)
                            {
                                <div class="defeat-reward-row">
                                    <i class="bi bi-cup-straw text-warning"></i>
                                    <span>+@Fmt(totalCanecasDropped) Caneca</span>
                                </div>
                            }
                            @if (totalCigarrosDropped > 0)
                            {
                                <div class="defeat-reward-row">
                                    <i class="bi bi-cloud text-secondary"></i>
                                    <span>+@Fmt(totalCigarrosDropped) Cigarro</span>
                                </div>
                            }
                            @if (totalCanhaosDropped > 0)
                            {
                                <div class="defeat-reward-row">
                                    <i class="bi bi-bullseye text-danger"></i>
                                    <span>+@Fmt(totalCanhaosDropped) Canhão</span>
                                </div>
                            }
                            @if (totalShotsDropped > 0)
                            {
                                <div class="defeat-reward-row">
                                    <i class="bi bi-cup text-danger"></i>
                                    <span>+@totalShotsDropped Shot</span>
                                </div>
                            }
                            @if (totalPenaltiesDropped > 0)
                            {
                                <div class="defeat-reward-row">
                                    <i class="bi bi-lightning-charge-fill" style="color: #0dcaf0;"></i>
                                    <span>+@totalPenaltiesDropped Penalty</span>
                                </div>
                            }
                            @if (totalFitabDropped > 0)
                            {
                                <div class="defeat-reward-row">
                                    <i class="bi bi-lightning-fill" style="color: #e040fb;"></i>
                                    <span>+@totalFitabDropped FITAB</span>
                                </div>
                            }
                            @if (totalLeitaoDropped > 0)
                            {
                                <div class="defeat-reward-row">
                                    <i class="bi bi-piggy-bank" style="color: #ff9800;"></i>
                                    <span>+@totalLeitaoDropped Leitão</span>
                                </div>
                            }
                            @foreach (var (partType, qty) in totalInstrumentPartsDropped)
                            {
                                var instrumentType = InstrumentTypeHelper.FromInventoryPartType(partType);
                                var instrumentName = instrumentType.HasValue ? InstrumentTypeHelper.GetDisplayName(instrumentType.Value) : partType.ToString();
                                var imageUrl = instrumentPartImages.GetValueOrDefault(partType);
                                <div class="defeat-reward-row instrument-part-reward">
                                    @if (!string.IsNullOrEmpty(imageUrl))
                                    {
                                        <img src="@CacheBuster.Bust(imageUrl)" alt="@instrumentName" class="instrument-drop-icon" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-music-note" style="color: #a855f7;"></i>
                                    }
                                    <span>+@qty @instrumentName</span>
                                </div>
                            }
                            @foreach (var rareType in totalRareSetDropped)
                            {
                                var rareSlotKey = EquipmentDropHelper.GetRareSetSlotKey(rareType);
                                var rareName = rareSlotKey != null
                                    && ScalingConfig.Value.StageMode.RareSet.Pieces.TryGetValue(rareSlotKey, out var pc)
                                    ? pc.Name : rareType.ToString();
                                <div class="defeat-reward-row" style="color: #ffd700; text-shadow: 0 0 4px #ffd700;">
                                    <i class="bi bi-gem" style="color: #ffd700;"></i>
                                    <span>+1 @rareName <small style="opacity:.7">(Equipamento Raro)</small></span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="defeat-no-rewards">Nenhum floor completado.</p>
                    }
                    <div class="d-flex gap-2 justify-content-center">
                        @if (showAfkChallenge)
                        {
                            <div class="afk-challenge">
                                <p class="afk-challenge-text">@afkChallengeQuestion</p>
                                <div class="d-flex gap-2 align-items-center justify-content-center">
                                    <input type="number" class="afk-challenge-input" @bind="afkChallengeInput" @bind:event="oninput"
                                           @onkeydown="AfkChallengeKeyDown" placeholder="?" />
                                    <button class="defeat-btn" @onclick="SubmitAfkChallenge">
                                        <i class="bi bi-check-lg"></i>
                                    </button>
                                </div>
                                @if (afkChallengeWrong)
                                {
                                    <p class="afk-challenge-wrong">Resposta errada!</p>
                                }
                            </div>
                        }
                        else
                        {
                            <button class="defeat-btn" @onclick="RetryFromCheckpoint">
                                <i class="bi bi-arrow-clockwise me-1"></i>RECOMEÇAR
                            </button>
                        }
                        <button class="defeat-btn" @onclick="DefeatGoBack">
                            IR MY TUNO
                        </button>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    private Character? character;
    private ApplicationUser? currentUser;

    /// <summary>
    /// Reloads the current user from a fresh DbContext.
    /// UserManager uses the scoped DI context which returns stale tracked entities
    /// after services write via IDbContextFactory.
    /// </summary>
    private async Task RefreshCurrentUserAsync()
    {
        if (currentUser == null) return;
        await using var ctx = DbContextFactory.CreateDbContext();
        var fresh = await ctx.Users.AsNoTracking().FirstOrDefaultAsync(u => u.Id == currentUser.Id);
        if (fresh != null)
            currentUser = fresh;
    }

    private StageProgress? stageProgress;
    private StageBattleResult? currentBattle;
    private bool loading = true;
    private bool fighting = false;
    private bool showBattleAnimation = false;
    private string errorMessage = string.Empty;
    private DotNetObjectReference<Stage>? objRef;
    private bool hasRendered = false;
    private bool battleAutoStarted = false;
    private int currentStageNumber = 1;
    private int checkpointStage = 1;


    // Battle controls
    private double battleSpeed = 1.0;
    private bool audioEnabled = false;

    // Accumulated loot tracker for the current run
    private int totalXPEarned = 0;
    private decimal totalFidelisEarned = 0;
    private int totalFinosDropped = 0;
    private int totalCanecasDropped = 0;
    private int totalCigarrosDropped = 0;
    private int totalCanhaosDropped = 0;
    private int totalShotsDropped = 0;
    private int totalPenaltiesDropped = 0;
    private int totalFitabDropped = 0;
    private int totalLeitaoDropped = 0;
    private Dictionary<InventoryItemType, int> totalInstrumentPartsDropped = new();
    private Dictionary<InventoryItemType, string?> instrumentPartImages = new();
    private List<InventoryItemType> totalRareSetDropped = new();
    private int stagesCleared = 0;

    // Run state tracking for cancel/exit functionality
    private long? runStartingHp;
    private int? runStartingStage;
    private int runStartingShotBuffBattles = 0;
    private int runStartingCigarroBuff = 0;
    private DateTime? runStartingCanhaoBuff = null;
    private long runStartingCanhaoRemainingMs = 0;
    private DateTime? runStartingPenaltyBuff = null;
    private long runStartingPenaltyRemainingMs = 0;
    private bool runInProgress = false;
    private bool pendingDefeatRewards = false;
    private bool _disposed = false;

    // Defeat summary state
    private bool showDefeatSummary = false;
    private int defeatedAtStage = 0;
    private long? defeatRestoreHp; // HP to restore after defeat (saved from runStartingHp)
    private int? defeatStartStage; // The starting stage of the run (saved at defeat for logging)
    private int? retryStartStage; // The stage the user started the run from (for RECOMEÇAR)

    // Anti-AFK: every N consecutive retries, show a simple math challenge
    private int consecutiveRetries = 0;
    private const int RetriesBeforeChallenge = 3;
    private bool showAfkChallenge = false;
    private string afkChallengeQuestion = "";
    private int afkChallengeAnswer = 0;
    private string afkChallengeInput = "";
    private bool afkChallengeWrong = false;
    
    // Semaphore to prevent concurrent stage operations (fight/cancel) sharing the same DbContext
    private readonly SemaphoreSlim _stageLock = new(1, 1);

    // Current battle enemy stats
    private List<EnemyStatsInfo> currentEnemyStats = new();

    // Watchdog: if JS doesn't call OnBattleFinished within this time, force-end
    // the run to prevent permanent stall (e.g. JS crash / WebGL context loss).
    // Max battle SimTime is 300s (5 min) at 1x speed, so 6 min covers the worst case.
    private CancellationTokenSource? _watchdogCts;
    private const int WatchdogTimeoutMs = 360_000; // 6 minutes

    // Tracks whether the current battle's replay was already sent to JS (so we can
    // release the JSON string early to reduce GC pressure on long runs).
    private bool _replaySentToJs;

    // Interactive combat session (spells / Blade Crafter mode)
    private CombatSession? _combatSession;

    // Consumable quantities for in-fight bar
    private int _finoQty, _canecaQty, _cigarroQty, _canhaoQty, _shotQty, _penaltyQty;

    // Consumable cooldowns (persist across stage transitions within a run)
    // Key = consumable type ("fino", "caneca"), Value = remaining cooldown in seconds
    private Dictionary<string, double> _consumableCooldowns = new();

    // Consumable image URLs from ItemTypeConfig (proxied to avoid CORS)
    private Dictionary<string, string> _consumableImages = new();

    /// <summary>
    /// Converts a full Cloudflare R2 public URL to a same-origin proxy URL.
    /// e.g. "https://pub-xxx.r2.dev/images/prod/fino.webp" → "/api/cdn/image?path=images/prod/fino.webp"
    /// </summary>
    private static string ToProxiedUrl(string fullUrl, string r2PublicUrl)
    {
        if (!string.IsNullOrEmpty(r2PublicUrl) && fullUrl.StartsWith(r2PublicUrl, StringComparison.OrdinalIgnoreCase))
        {
            var relativePath = fullUrl[(r2PublicUrl.Length)..].TrimStart('/');
            return $"/api/cdn/image?path={Uri.EscapeDataString(relativePath)}";
        }
        // Not an R2 URL — return as-is (local SVGs etc.)
        return fullUrl;
    }

    // Spell cooldowns preserved across stage transitions (copied from old session before destroy)
    private Dictionary<string, double>? _preservedSpellCooldowns;

    private static readonly JsonSerializerOptions _spellJsonOptions = new()
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull
    };

    // Start stage is now set in the DB before navigation (from MyTunoHome checkpoint selection)
    // No query parameter needed — eliminates prerender/redirect race conditions

    protected override async Task OnInitializedAsync()
    {
        // Reset animation state on page load
        showBattleAnimation = false;
        fighting = false;
        await LoadDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            hasRendered = true;
            
            // Auto-start battle after first render (only once)
            if (character != null && currentBattle == null && !battleAutoStarted)
            {
                battleAutoStarted = true;
                await Task.Delay(150); // Brief delay for UI to settle
                try
                {
                    await FightStageEnemy();
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Auto-start battle failed");
                    errorMessage = "Failed to start battle automatically. Please try again.";
                    StateHasChanged();
                }
            }
        }
    }

    private async Task LoadDataAsync()
    {
        try
        {
            loading = true;
            errorMessage = string.Empty;

            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                currentUser = await UserManager.GetUserAsync(user);
                if (currentUser != null)
                {
                    // Refresh from fresh context — scoped DI context has stale data
                    await RefreshCurrentUserAsync();
                    // Load character and stage progress in parallel (independent queries)
                    var characterTask = CharacterService.GetOrCreateCharacterAsync(currentUser.Id);
                    var stageProgressTask = StageService.GetOrCreateStageProgressAsync(currentUser.Id);
                    await Task.WhenAll(characterTask, stageProgressTask);
                    character = await characterTask;
                    stageProgress = await stageProgressTask;
                    if (character != null)
                    {
                        if (stageProgress != null)
                        {
                            currentStageNumber = stageProgress.CurrentStage;
                            checkpointStage = stageProgress.LastCheckpoint;
                        }
                    }
                }
            }
        }
        catch (NavigationException)
        {
            // Blazor uses this exception for flow control during NavigateTo — let it propagate
            throw;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading stage data");
            errorMessage = "Erro ao carregar dados do estágio.";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task FightStageEnemy()
    {
        if (_disposed) return;
        if (character == null || currentUser == null || stageProgress == null) return;
        
        // Prevent multiple concurrent battles
        if (fighting) return;

        // User clicked "Acabar" — don't start a new fight
        if (_endingRun) return;
        
        // Acquire lock to prevent concurrent DbContext access (e.g. dispose cancel vs fight)
        if (!await _stageLock.WaitAsync(0)) return;

        try
        {
            fighting = true;
            var wasAlreadyAnimating = showBattleAnimation;
            showBattleAnimation = true;
            errorMessage = string.Empty;
            _replaySentToJs = false;
            
            // Store run starting state for cancel functionality (only on first battle of run)
            if (!runInProgress)
            {
                runStartingHp = character.CurrentHP;
                runStartingStage = stageProgress.CurrentStage;
                runStartingShotBuffBattles = character.ShotBuffBattlesRemaining;
                runStartingCigarroBuff = character.CigarroShieldHitsRemaining;
                runStartingCanhaoBuff = character.CanhaoBuffExpiresAt;
                runStartingCanhaoRemainingMs = character.CanhaoBuffRemainingMs;
                runStartingPenaltyBuff = character.PenaltyBuffExpiresAt;
                runStartingPenaltyRemainingMs = character.PenaltyBuffRemainingMs;
                runInProgress = true;

                // Resume paused Canhão buff so the timer starts ticking during the run
                if (character.CanhaoBuffRemainingMs > 0)
                {
                    character.ResumeCanhaoBuff();
                    // Persist to DB so the active ExpiresAt is stored — prevents timer from
                    // resetting to the old paused value if the run ends or user navigates away.
                    await CharacterService.UpdateCharacterAsync(character);
                }
                // Resume paused Penalty buff so the timer starts ticking during the run
                if (character.PenaltyBuffRemainingMs > 0)
                {
                    character.ResumePenaltyBuff();
                    await CharacterService.UpdateCharacterAsync(character);
                }
                // Reset cooldowns for the new run
                _consumableCooldowns.Clear();
                _preservedSpellCooldowns = null;
                Logger.LogInformation("Stage mode started by {UserName} at floor {Stage}", currentUser.UserName, stageProgress.CurrentStage);

                // Load consumable quantities for in-fight bar (once per run)
                try
                {
                    var inv = await InventoryService.GetUserInventorySummaryAsync(currentUser.Id);
                    _finoQty = inv.GetValueOrDefault(InventoryItemType.Fino);
                    _canecaQty = inv.GetValueOrDefault(InventoryItemType.Caneca);
                    _cigarroQty = inv.GetValueOrDefault(InventoryItemType.Cigarro);
                    _canhaoQty = inv.GetValueOrDefault(InventoryItemType.Canhao);
                    _shotQty = inv.GetValueOrDefault(InventoryItemType.Shot);
                    _penaltyQty = inv.GetValueOrDefault(InventoryItemType.Penalty);
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Failed to load consumable quantities for stage run");
                }

                // Load consumable image URLs from config (proxied to avoid CORS)
                try
                {
                    if (_consumableImages.Count == 0)
                    {
                        var r2PublicUrl = Configuration["Cloudflare:R2:PublicUrl"]?.TrimEnd('/') ?? "";
                        var allConfigs = await ItemTypeConfigService.GetAllConfigsAsync();
                        _consumableImages = allConfigs
                            .Where(c => !string.IsNullOrEmpty(c.PictureUrl))
                            .ToDictionary(
                                c => c.TypeKey,
                                c => ToProxiedUrl(c.PictureUrl!, r2PublicUrl));
                    }
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Failed to load consumable images for stage run");
                }
            }
            
            // Only update UI if we weren't already animating (first battle)
            if (!wasAlreadyAnimating)
            {
                StateHasChanged();
                await JSRuntime.InvokeVoidAsync("window.scrollTo", 0, 0);
                // Wait for container to be rendered on first battle
                await Task.Delay(50);
            }

            // Save pre-battle state before deterministic sim modifies it.
            // The deterministic engine sets character.CurrentHP to null on predicted loss
            // and consumes cigarro/canhao charges — but the interactive session drives real combat.
            var preBattleHp = character.CurrentHP;
            var preBattleCigarroBuff = character.CigarroShieldHitsRemaining;
            var preBattleCanhaoBuff = character.CanhaoBuffExpiresAt;

            // Execute stage battle (pre-computes for rewards/progression metadata)
            // Pass in-memory stageProgress + character so the service modifies them
            // directly instead of re-fetching stale DB copies each battle.
            currentBattle = await StageService.ExecuteStageBattleAsync(character.Id,
                totalRareSetDropped.Count > 0 ? totalRareSetDropped : null,
                stageProgress, character);

            // Restore pre-battle state — the interactive session drives real combat
            character.CurrentHP = preBattleHp;
            character.CigarroShieldHitsRemaining = preBattleCigarroBuff;
            character.CanhaoBuffExpiresAt = preBattleCanhaoBuff;

            // Create interactive combat session from enemy metadata
            // This drives the REAL combat — player auto-attacks only (no special attacks in stage mode for now)
            List<RTUB.Core.Entities.SpecialAttack>? starterSpells = null;
            var enemyStates = currentBattle.EnemyStats.Select((e, i) => new RTUB.Application.DTOs.CombatantState
            {
                Identifier = $"Enemy{i}",
                Name = e.Name,
                CurrentHP = e.HP,
                MaxHP = e.HP,
                Power = e.Power,
                Defense = e.Defense,
                CriticalChance = e.CritChance, // Biome-based enemy crit chance
                ActionTimeSeconds = e.ActionTime
            }).ToList();
            // Use buffed copies when consumable buffs are active — matches the
            // pre-computed engine so HP/Power/ActionTime are consistent.
            Character sessionChar = character;
            if (character.ShotBuffBattlesRemaining > 0)
                sessionChar = Character.CreateShotBuffedCopy(character);
            _combatSession = CombatActionService.CreateSession(
                sessionChar,
                enemyStates,
                currentBattle.Seed,
                starterSpells,
                "stage");

            // Restore preserved cooldowns from previous stage (so they don't reset)
            if (_preservedSpellCooldowns != null)
            {
                foreach (var kvp in _preservedSpellCooldowns)
                {
                    if (_combatSession.SpellCooldowns.ContainsKey(kvp.Key) && kvp.Value > 0)
                        _combatSession.SpellCooldowns[kvp.Key] = kvp.Value;
                }
                _preservedSpellCooldowns = null;
            }
            // Restore consumable cooldowns (persist across entire run)
            foreach (var kvp in _consumableCooldowns)
            {
                if (kvp.Value > 0)
                    _combatSession.ConsumableCooldowns[kvp.Key] = kvp.Value;
            }

            // If the player lost, immediately mark the run as finished so that
            // CancelRunIfInProgressAsync (called on dispose/navigate-away) will NOT
            // restore HP while the defeat animation is still playing.
            if (currentBattle.Outcome != BattleOutcome.AttackerWon)
            {
                // Save the pre-run HP before clearing run state
                defeatRestoreHp = runStartingHp;
                // Save starting stage for logging and RECOMEÇAR before clearing
                defeatStartStage = runStartingStage ?? currentStageNumber;
                retryStartStage = runStartingStage ?? currentStageNumber;
                // Mark run as finished IMMEDIATELY
                runInProgress = false;
                runStartingHp = null;
                runStartingStage = null;
                pendingDefeatRewards = true;
            }

            // Start live battle animation
            if (!string.IsNullOrEmpty(currentBattle.ReplayJson))
            {
                try
                {
                    // Initialize DotNetObjectReference if not already done
                    if (objRef == null)
                    {
                        objRef = DotNetObjectReference.Create(this);
                    }

                    var battleStageNumber = currentBattle.StageNumber;
                    var enemyTypeName = GetEnemyTypeName(currentBattle.EnemyType);

                    // Use pre-parsed metadata from StageBattleResult (avoids re-deserializing
                    // ReplayJson every stage, which caused ~150KB of GC pressure per battle)
                    var enemySpritePaths = currentBattle.EnemySpritePaths;
                    if (enemySpritePaths.Count == 0)
                    {
                        var fallbackSprite = GetDefaultEnemySpriteForType(currentBattle.EnemyType);
                        enemySpritePaths = Enumerable.Repeat(fallbackSprite, currentBattle.EnemyCount).ToList();
                    }

                    currentEnemyStats.Clear();
                    foreach (var stat in currentBattle.EnemyStats)
                    {
                        currentEnemyStats.Add(new EnemyStatsInfo(stat.Name, stat.HP, null, stat.Power, stat.Defense, stat.ActionTime));
                    }

                    var enemyPlacements = currentBattle.EnemyPlacements;
                    while (enemyPlacements.Count < currentBattle.EnemyCount)
                    {
                        enemyPlacements.Add(0);
                    }

                    // Send interactive battle data (no pre-computed events — JS drives combat)
                    var battleData = new
                    {
                        EventsJson = currentBattle.ReplayJson,
                        DotNetRef = objRef,
                        StageNumber = battleStageNumber,
                        EnemyType = enemyTypeName,
                        EnemyCount = currentBattle.EnemyCount,
                        PlayerName = character.User?.Nickname ?? character.User?.UserName ?? "Player",
                        EnemyName = currentBattle.EnemyName,
                        BackgroundPath = BiomeService.GetBackgroundForStage(battleStageNumber),
                        PlayerSpritePath = !string.IsNullOrEmpty(character.CustomSpritePath) ? character.CustomSpritePath : "/sprites/games/my-tuno/default_tuno.png",
                        EnemySprites = enemySpritePaths,
                        EnemyPlacements = enemyPlacements,
                        BattleSpeed = battleSpeed,
                        HasShotBuff = character.ShotBuffBattlesRemaining > 0,
                        HasPenaltyBuff = character.HasPenaltyBuff,
                        // ── Interactive combat data (spells / Blade Crafter mode) ──
                        InteractiveMode = true,
                        PlayerHP = _combatSession!.Player.CurrentHP,
                        PlayerMaxHP = _combatSession.Player.MaxHP,
                        PlayerActionTime = _combatSession.Player.ActionTimeSeconds,
                        Enemies = _combatSession.Enemies.Select((e, i) => new
                        {
                            e.Name,
                            HP = e.CurrentHP,
                            e.MaxHP,
                            ActionTime = e.ActionTimeSeconds
                        }),
                        Spells = Array.Empty<object>(),
                        Consumables = new
                        {
                            Fino = _finoQty,
                            Caneca = _canecaQty,
                            Cigarro = _cigarroQty,
                            Canhao = _canhaoQty,
                            Shot = _shotQty,
                            Penalty = _penaltyQty
                        },
                        ConsumableImages = new
                        {
                            Fino = _consumableImages.GetValueOrDefault("Fino"),
                            Caneca = _consumableImages.GetValueOrDefault("Caneca"),
                            Cigarro = _consumableImages.GetValueOrDefault("Cigarro"),
                            Canhao = _consumableImages.GetValueOrDefault("Canhao")
                        },
                        ConsumableCooldowns = new Dictionary<string, double>(_combatSession.ConsumableCooldowns),
                        SpellCooldowns = new Dictionary<string, double>(_combatSession.SpellCooldowns),
                        ActiveBuffs = new
                        {
                            Cigarro = _combatSession.HasCigarroBuff,
                            Canhao = _combatSession.HasCanhaoBuff,
                            Shot = _combatSession.HasShotBuff,
                            Penalty = _combatSession.HasPenaltyBuff
                        },
                        // Canhão countdown bar: pass expiry UTC so JS can render a depleting timer bar
                        CanhaoBuffExpiresAtUtc = character.CanhaoBuffExpiresAt.HasValue
                            ? character.CanhaoBuffExpiresAt.Value.ToString("o")
                            : (string?)null,
                        // Penalty countdown bar: same pattern as Canhão
                        PenaltyBuffExpiresAtUtc = character.PenaltyBuffExpiresAt.HasValue
                            ? character.PenaltyBuffExpiresAt.Value.ToString("o")
                            : (string?)null
                    };

                    // nextBattle handles both first battle (falls back to start) and subsequent battles
                    await JSRuntime.InvokeVoidAsync("stageBattleGame.nextBattle", battleData);

                    // If user clicked "Acabar" while nextBattle was in-flight,
                    // destroy the just-started scene immediately to avoid an orphan.
                    if (_endingRun)
                    {
                        try { await JSRuntime.InvokeVoidAsync("stageBattleGame.destroy"); }
                        catch { /* EndRunEarly will also try – ok if this fails */ }
                    }

                    // Release the large ReplayJson string now that JS has it — reduces GC
                    // pressure during long farming runs (hundreds of stages)
                    _replaySentToJs = true;
                    currentBattle.ReplayJson = string.Empty;
                }
                catch (JSException ex)
                {
                    Logger.LogError(ex, "Error starting battle animation: {Message}", ex.Message);
                    errorMessage = "Error starting battle animation.";
                    showBattleAnimation = false;
                    if (!_disposed) StateHasChanged();
                }
                catch (JSDisconnectedException) { throw; } // Let outer catch handle
                catch (TaskCanceledException) { throw; }   // Let outer catch handle
                catch (OperationCanceledException) { throw; } // Let outer catch handle
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Unexpected error starting battle animation");
                    errorMessage = "Unexpected error starting battle animation.";
                    showBattleAnimation = false;
                    if (!_disposed) StateHasChanged();
                }
            }
            else
            {
                showBattleAnimation = false;
            }

            // stageProgress is updated in-memory by ExecuteStageBattleAsync (stage
            // advancement, enemy defeats). character.CurrentHP is restored to pre-battle
            // value above — the interactive session drives real HP changes.
            if (stageProgress != null)
            {
                currentStageNumber = stageProgress.CurrentStage;
                checkpointStage = stageProgress.LastCheckpoint;
            }
        }
        catch (JSDisconnectedException)
        {
            // Circuit disconnected - exit silently
        }
        catch (TaskCanceledException)
        {
            // JS interop canceled (user navigated away during battle) - exit silently
        }
        catch (OperationCanceledException)
        {
            // Operation canceled during disposal - exit silently
        }
        catch (Exception ex)
        {
            // Always catch — never let exceptions escape unhandled (crashes the process)
            if (!_disposed)
            {
                Logger.LogError(ex, "Error starting stage battle");
                errorMessage = $"Erro ao iniciar batalha: {ex.Message}";
                showBattleAnimation = false;
            }
        }
        finally
        {
            fighting = false;
            try { if (!_disposed) _stageLock.Release(); } catch (ObjectDisposedException) { }
            if (!_disposed)
            {
                if (currentBattle == null || (!_replaySentToJs && string.IsNullOrEmpty(currentBattle.ReplayJson)))
                {
                    showBattleAnimation = false;
                }
                else if (runInProgress || pendingDefeatRewards)
                {
                    // Battle animation is playing — start watchdog in case JS never calls back
                    StartWatchdog();
                }
                StateHasChanged();
            }
        }
    }

    private async Task ContinueToNextStage()
    {
        if (_disposed || _endingRun) return;
        // Preserve cooldowns before destroying session
        PreserveCooldownsFromSession();
        // Reset battle state and start next fight
        currentBattle = null;
        _combatSession = null;
        await FightStageEnemy();
    }

