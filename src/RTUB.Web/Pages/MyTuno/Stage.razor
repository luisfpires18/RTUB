        return Task.FromResult(JsonSerializer.Serialize(result, _spellJsonOptions));
    }

    /// <summary>
    /// Called by JS when the user clicks a consumable button during combat.
    /// Consumes the item and applies its effect to the combat session.
    /// </summary>
    [JSInvokable]
    public async Task<string> OnUseConsumable(string type)
    {
        if (character == null || currentUser == null)
            return JsonSerializer.Serialize(new { success = false, message = "Personagem não encontrado." }, _spellJsonOptions);

        try
        {
            // Stage mode uses ConsumeItemAsync directly (not UseXxxAsync) because
            // stage batches character DB writes at run end. The UseXxxAsync methods
            // reload character from DB and check state (HP full, buff already active)
            // which fails since the DB character isn't updated during the run.
            switch (type.ToLowerInvariant())
            {
                case "fino":
                {
                    if (_combatSession == null) return JsonSerializer.Serialize(new { success = false, message = "Sessão inválida." }, _spellJsonOptions);
                    // Check consumable cooldown (2.5 minutes for Fino)
                    if (_combatSession.ConsumableCooldowns.TryGetValue("fino", out var finoCd) && finoCd > 0)
                        return JsonSerializer.Serialize(new { success = false, message = $"Fino em cooldown ({finoCd:F0}s)." }, _spellJsonOptions);
                    if (_combatSession.Player.CurrentHP >= _combatSession.Player.MaxHP)
                        return JsonSerializer.Serialize(new { success = false, message = "HP já está cheio." }, _spellJsonOptions);
                    var consumed = await InventoryRepository.ConsumeItemAsync(currentUser.Id, InventoryItemType.Fino, 1);
                    if (!consumed) return JsonSerializer.Serialize(new { success = false, message = "Sem Fino disponível." }, _spellJsonOptions);
                    var maxHp = _combatSession.Player.MaxHP;
                    var healAmount = (int)(maxHp * 0.25);
                    _combatSession.Player.CurrentHP = Math.Min(_combatSession.Player.CurrentHP + healAmount, maxHp);
                    character.CurrentHP = _combatSession.Player.CurrentHP;
                    _finoQty = Math.Max(0, _finoQty - 1);
                    // Set 2.5 minute cooldown
                    _combatSession.ConsumableCooldowns["fino"] = 150;
                    return JsonSerializer.Serialize(new { success = true, type, newQuantity = _finoQty, healAmount, playerHP = _combatSession.Player.CurrentHP, playerMaxHP = maxHp, cooldownSeconds = 150 }, _spellJsonOptions);
                }
                case "caneca":
                {
                    if (_combatSession == null) return JsonSerializer.Serialize(new { success = false, message = "Sessão inválida." }, _spellJsonOptions);
                    // Check consumable cooldown (5 minutes for Caneca)
                    if (_combatSession.ConsumableCooldowns.TryGetValue("caneca", out var canecaCd) && canecaCd > 0)
                        return JsonSerializer.Serialize(new { success = false, message = $"Caneca em cooldown ({canecaCd:F0}s)." }, _spellJsonOptions);
                    if (_combatSession.Player.CurrentHP >= _combatSession.Player.MaxHP)
                        return JsonSerializer.Serialize(new { success = false, message = "HP já está cheio." }, _spellJsonOptions);
                    var consumed = await InventoryRepository.ConsumeItemAsync(currentUser.Id, InventoryItemType.Caneca, 1);
                    if (!consumed) return JsonSerializer.Serialize(new { success = false, message = "Sem Caneca disponível." }, _spellJsonOptions);
                    var maxHp = _combatSession.Player.MaxHP;
                    var healAmount = (int)(maxHp * 0.50);
                    _combatSession.Player.CurrentHP = Math.Min(_combatSession.Player.CurrentHP + healAmount, maxHp);
                    character.CurrentHP = _combatSession.Player.CurrentHP;
                    _canecaQty = Math.Max(0, _canecaQty - 1);
                    // Set 5 minute cooldown
                    _combatSession.ConsumableCooldowns["caneca"] = 300;
                    return JsonSerializer.Serialize(new { success = true, type, newQuantity = _canecaQty, healAmount, playerHP = _combatSession.Player.CurrentHP, playerMaxHP = maxHp, cooldownSeconds = 300 }, _spellJsonOptions);
                }
                case "cigarro":
                {
                    if (_combatSession == null) return JsonSerializer.Serialize(new { success = false, message = "Sessão inválida." }, _spellJsonOptions);
                    if (_combatSession.CigarroShieldRemaining > 0)
                        return JsonSerializer.Serialize(new { success = false, message = "Escudo já ativo!" }, _spellJsonOptions);
                    var consumed = await InventoryRepository.ConsumeItemAsync(currentUser.Id, InventoryItemType.Cigarro, 1);
                    if (!consumed) return JsonSerializer.Serialize(new { success = false, message = "Sem Cigarro disponível." }, _spellJsonOptions);
                    _combatSession.CigarroShieldRemaining = 3;
                    character.CigarroShieldHitsRemaining = 3;
                    _cigarroQty = Math.Max(0, _cigarroQty - 1);
                    return JsonSerializer.Serialize(new { success = true, type, newQuantity = _cigarroQty, buffMessage = "🛡️ ESCUDO x3", buffActive = true }, _spellJsonOptions);
                }
                case "canhao":
                {
                    if (_combatSession == null) return JsonSerializer.Serialize(new { success = false, message = "Sessão inválida." }, _spellJsonOptions);
                    if (_combatSession.CanhaoBoostRemaining > 0)
                        return JsonSerializer.Serialize(new { success = false, message = "Boost já ativo!" }, _spellJsonOptions);
                    var consumed = await InventoryRepository.ConsumeItemAsync(currentUser.Id, InventoryItemType.Canhao, 1);
                    if (!consumed) return JsonSerializer.Serialize(new { success = false, message = "Sem Canhão disponível." }, _spellJsonOptions);
                    _combatSession.CanhaoBoostRemaining = 3;
                    character.CanhaoDamageBoostHitsRemaining = 3;
                    _canhaoQty = Math.Max(0, _canhaoQty - 1);
                    return JsonSerializer.Serialize(new { success = true, type, newQuantity = _canhaoQty, buffMessage = "💣 +30% DMG x3", buffActive = true }, _spellJsonOptions);
                }
                case "shot":
                {
                    if (character.ShotBuffBattlesRemaining > 0)
                        return JsonSerializer.Serialize(new { success = false, message = "Shot já ativo!" }, _spellJsonOptions);
                    var consumed = await InventoryRepository.ConsumeItemAsync(currentUser.Id, InventoryItemType.Shot, 1);
                    if (!consumed) return JsonSerializer.Serialize(new { success = false, message = "Sem Shot disponível." }, _spellJsonOptions);
                    character.ShotBuffBattlesRemaining = 5;
                    // Apply +20% power to current combat session immediately
                    if (_combatSession != null)
                    {
                        _combatSession.Player.Power = (int)Math.Round(_combatSession.Player.Power * 1.2);
                        _combatSession.HasShotBuff = true;
                    }
                    _shotQty = Math.Max(0, _shotQty - 1);
                    return JsonSerializer.Serialize(new { success = true, type, newQuantity = _shotQty, buffMessage = "🥃 SHOT +20% x5", buffActive = true }, _spellJsonOptions);
                }
                case "penalty":
                {
                    if (character.PenaltyBuffActive > 0)
                        return JsonSerializer.Serialize(new { success = false, message = "Penalty já ativo!" }, _spellJsonOptions);
                    var consumed = await InventoryRepository.ConsumeItemAsync(currentUser.Id, InventoryItemType.Penalty, 1);
                    if (!consumed) return JsonSerializer.Serialize(new { success = false, message = "Sem Penalty disponível." }, _spellJsonOptions);
                    character.PenaltyBuffActive = 1;
                    // Apply -0.5s speed and +50% crit to current combat session immediately
                    double newActionTime = 0;
                    if (_combatSession != null)
                    {
                        _combatSession.Player.ActionTimeSeconds = Math.Max(0.5, _combatSession.Player.ActionTimeSeconds - 0.5);
                        _combatSession.Player.CriticalChance = Math.Min(1.0, _combatSession.Player.CriticalChance + 0.5);
                        _combatSession.HasPenaltyBuff = true;
                        newActionTime = _combatSession.Player.ActionTimeSeconds;
                    }
                    _penaltyQty = Math.Max(0, _penaltyQty - 1);
                    return JsonSerializer.Serialize(new { success = true, type, newQuantity = _penaltyQty, buffMessage = "⚡ PENALTY!", buffActive = true, newActionTime }, _spellJsonOptions);
                }
                default:
                    return JsonSerializer.Serialize(new { success = false, message = "Consumível desconhecido." }, _spellJsonOptions);
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Error using consumable {Type}", type);
            return JsonSerializer.Serialize(new { success = false, message = "Erro ao usar consumível." }, _spellJsonOptions);
        }
    }

    [JSInvokable]
    public async Task OnBattleFinished()
    {
        // Cancel watchdog — JS called back successfully
        CancelWatchdog();

        // Guard: component may have been disposed while JS animation was playing
        if (_disposed) return;

        // Guard: user clicked "Acabar" while JS animation was playing — don't continue
        // Note: on defeat, runInProgress is set to false immediately in FightStageEnemy
        // to prevent CancelRunIfInProgressAsync from restoring HP during the animation.
        // So we also check pendingDefeatRewards to allow defeat processing to proceed.
        if (_endingRun) return;
        if (!runInProgress && !pendingDefeatRewards) return;

        // Auto-continue to next stage if victory (don't hide battle animation)
        // Use interactive session outcome if available, otherwise fall back to pre-computed
        var didWin = _combatSession != null
            ? (_combatSession.Winner == _combatSession.Player.Identifier)
            : (currentBattle != null && currentBattle.Outcome == BattleOutcome.AttackerWon);

        // If interactive session says win but pre-computed said loss (pendingDefeatRewards was
        // set prematurely), correct the state so the run continues properly.
        if (didWin && pendingDefeatRewards)
        {
            pendingDefeatRewards = false;
            runInProgress = true;

            // The deterministic engine predicted a loss, so
            // UpdateCharacterAndProgressInMemory skipped stage advancement.
            // Advance stage progress in memory now (no DB save during runs).
            if (stageProgress != null && currentBattle != null)
            {
                for (int i = 0; i < currentBattle.EnemyCount; i++)
                {
                    stageProgress.RecordEnemyDefeat();
                }
                if (currentBattle.EnemyType == EnemyType.Boss)
                {
                    stageProgress.RecordBossDefeat();
                }
                var totalEnemies = BiomeService.GetEnemyCountForStage(stageProgress.CurrentStage);
                if (stageProgress.EnemiesDefeatedInCurrentStage >= totalEnemies)
                {
                    stageProgress.AdvanceStage();
                }
                currentStageNumber = stageProgress.CurrentStage;
                checkpointStage = stageProgress.LastCheckpoint;
            }
        }

        // Update character HP from interactive session (overrides pre-computed value)
        if (_combatSession != null && character != null)
        {
            character.CurrentHP = _combatSession.Player.CurrentHP > 0
                ? _combatSession.Player.CurrentHP
                : null;
            // Update buff remaining counts from session
            character.CigarroShieldHitsRemaining = _combatSession.CigarroShieldRemaining;
            character.CanhaoDamageBoostHitsRemaining = _combatSession.CanhaoBoostRemaining;
        }

        if (didWin && currentBattle != null)
        {
            try
            {
                // Accumulate rewards for the run
                totalXPEarned += currentBattle.XPReward;
                totalFidelisEarned += currentBattle.FidelisReward;
                totalFinosDropped += currentBattle.FinosDropped;
                totalCanecasDropped += currentBattle.CanecasDropped;
                totalCigarrosDropped += currentBattle.CigarrosDropped;
                totalCanhaosDropped += currentBattle.CanhaosDropped;
                totalShotsDropped += currentBattle.ShotsDropped;
                totalPenaltiesDropped += currentBattle.PenaltiesDropped;
                totalFitabDropped += currentBattle.FitabDropped;

                // Accumulate instrument part drops
                foreach (var partType in currentBattle.InstrumentPartsDropped)
                {
                    if (totalInstrumentPartsDropped.ContainsKey(partType))
                        totalInstrumentPartsDropped[partType]++;
                    else
                        totalInstrumentPartsDropped[partType] = 1;

                    // Load image for this instrument part if not already loaded
                    if (!instrumentPartImages.ContainsKey(partType))
                    {
                        await LoadInstrumentPartImageAsync(partType);
                    }
                }

                // Accumulate equipment drops
                foreach (var equipType in currentBattle.EquipmentDropped)
                {
                    if (totalEquipmentDropped.ContainsKey(equipType))
                        totalEquipmentDropped[equipType]++;
                    else
                        totalEquipmentDropped[equipType] = 1;
                }

                stagesCleared++;
                
                // Brief delay then start next stage automatically
                // Keep showBattleAnimation = true to avoid hiding/recreating the container
                await Task.Delay(200);
                if (_disposed) return;
                // Preserve cooldowns before destroying session
                PreserveCooldownsFromSession();
                currentBattle = null;
                _combatSession = null;
                
                // Only update UI after starting next battle to minimize flicker
                await FightStageEnemy();
                // Note: FightStageEnemy already calls StateHasChanged in its finally block
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error in OnBattleFinished victory path, ending run");
                if (!_disposed)
                {
                    try { await EndRunEarly(); } catch { /* last resort */ }
                }
            }
        }
        else
        {
            // Run ended (defeat) - restore HP to pre-run value and apply accumulated rewards
            if (character != null)
            {
                try
                {
                    await StageService.ApplyRunRewardsAsync(
                        character.Id, totalXPEarned, totalFidelisEarned, totalFinosDropped, totalCanecasDropped, totalCigarrosDropped, totalCanhaosDropped, totalShotsDropped, totalPenaltiesDropped, totalFitabDropped, defeatRestoreHp,
                        totalInstrumentPartsDropped.Count > 0 ? totalInstrumentPartsDropped : null,
                        totalEquipmentDropped.Count > 0 ? totalEquipmentDropped : null);
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Error applying run rewards");
                }
            }

            // Mark run as complete (may already be false from FightStageEnemy)
            runInProgress = false;
            runStartingHp = null;
            runStartingStage = null;
            pendingDefeatRewards = false;

            // Return to checkpoint but do NOT auto-restart — show defeat summary instead
            if (!_disposed && currentUser != null && stageProgress != null)
            {
                try
                {
                    // Save the stage where the player was defeated before returning to checkpoint
                    defeatedAtStage = currentBattle?.StageNumber ?? currentStageNumber;

                    stageProgress = await StageService.ReturnToCheckpointAsync(currentUser.Id);
                    currentStageNumber = stageProgress.CurrentStage;
                    checkpointStage = stageProgress.LastCheckpoint;
                    
                    // Reload character to get fresh HP
                    character = await CharacterService.GetOrCreateCharacterAsync(currentUser.Id);
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Error returning to checkpoint after defeat");
                }
            }

            // Stop the battle animation and show defeat summary
            showBattleAnimation = false;
            showDefeatSummary = true;
            currentEnemyStats.Clear();
            currentBattle = null;
            _combatSession = null;
            
            if (!_disposed) StateHasChanged();
        }
    }

