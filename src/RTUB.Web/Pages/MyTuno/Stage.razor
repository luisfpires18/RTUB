    /// <summary>
    /// Loads the naipe PictureUrl for an instrument part type to display in the loot tracker.
    /// </summary>
    private async Task LoadInstrumentPartImageAsync(InventoryItemType partType)
    {
        try
        {
            var instrumentType = InstrumentTypeHelper.FromInventoryPartType(partType);
            if (instrumentType == null)
            {
                instrumentPartImages[partType] = null;
                return;
            }

            var configs = await NaipeService.GetAllTypeConfigsAsync();
            var config = configs.FirstOrDefault(c => c.InstrumentType == instrumentType.Value);
            instrumentPartImages[partType] = config?.PictureUrl;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load naipe image for {PartType}", partType);
            instrumentPartImages[partType] = null;
        }
    }

