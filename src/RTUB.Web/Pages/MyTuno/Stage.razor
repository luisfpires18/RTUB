        }
    }

    private async Task GoBack()
    {
        // If a run is in progress, cancel it and restore the starting state
        await CancelRunIfInProgressAsync();
        Navigation.NavigateTo("/my-tuno");
    }

    private async Task CancelRunIfInProgressAsync()
    {
        if (runInProgress && character != null && runStartingHp.HasValue && runStartingStage.HasValue)
        {
            // Wait for any in-progress fight to complete before cancelling
            await _stageLock.WaitAsync();
            try
            {
                // Re-check after acquiring lock (fight may have finished and cleared runInProgress)
                if (runInProgress && runStartingHp.HasValue && runStartingStage.HasValue)
                {
                    await StageService.CancelRunAsync(character.Id, runStartingHp.Value, runStartingStage.Value, runStartingShotBuffBattles);
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error cancelling run");
            }
            finally
            {
                runInProgress = false;
                runStartingHp = null;
                runStartingStage = null;
                _stageLock.Release();
            }
        }
    }

    private static string Fmt(int value) => NumberFormatter.Compact(value);
    private static string Fmt(decimal value) => NumberFormatter.Compact(value);

    private void ResetRunTotals()
    {
        totalXPEarned = 0;
        totalFidelisEarned = 0;
        totalBeersDropped = 0;
        totalShotsDropped = 0;
        totalInstrumentPartsDropped.Clear();
        totalEquipmentDropped.Clear();
        stagesCleared = 0;
        currentEnemyStats.Clear();
    }

    private void DefeatGoBack()
    {
        showDefeatSummary = false;
        ResetRunTotals();
        Navigation.NavigateTo("/my-tuno");
    }

    private async Task EndRunEarly()
    {
        if (_disposed) return;

        try
        {
            // Destroy JS battle animation
            if (hasRendered)
            {
                try { await JSRuntime.InvokeVoidAsync("stageBattleGame.destroy"); }
                catch { /* JS interop may fail */ }
            }

            // Cancel the timeout since we're ending manually
            battleTimeoutCts?.Cancel();

            // Save defeated-at stage before applying rewards
            defeatedAtStage = currentBattle?.StageNumber ?? currentStageNumber;

            // Apply accumulated rewards from the run
            if (character != null && stagesCleared > 0)
            {
                try
                {
                    await StageService.ApplyRunRewardsAsync(
                        character.Id, totalXPEarned, totalFidelisEarned, totalBeersDropped, totalShotsDropped, runStartingHp,
                        totalInstrumentPartsDropped.Count > 0 ? totalInstrumentPartsDropped : null,
                        totalEquipmentDropped.Count > 0 ? totalEquipmentDropped : null);
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Error applying run rewards on early end");
                }
            }
            else if (character != null && runStartingHp.HasValue)
            {
                // No stages cleared — restore HP to pre-run value
                await StageService.CancelRunAsync(character.Id, runStartingHp.Value, runStartingStage ?? currentStageNumber, runStartingShotBuffBattles);
            }

            // Clear run state
            runInProgress = false;
            runStartingHp = null;
            runStartingStage = null;
            pendingDefeatRewards = false;

            // Return to checkpoint
            if (currentUser != null && stageProgress != null)
            {
                try
                {
                    stageProgress = await StageService.ReturnToCheckpointAsync(currentUser.Id);
                    currentStageNumber = stageProgress.CurrentStage;
                    checkpointStage = stageProgress.LastCheckpoint;
                    character = await CharacterService.GetOrCreateCharacterAsync(currentUser.Id);
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Error returning to checkpoint on early end");
                }
            }

            // Show reward summary
            showBattleAnimation = false;
            showDefeatSummary = true;
            currentEnemyStats.Clear();
            currentBattle = null;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error ending run early");
        }
    }

    /// <summary>
    /// Gets the enemy type name for JavaScript
    /// </summary>
    private static string GetEnemyTypeName(EnemyType enemyType)
    {
        return enemyType switch
        {
            EnemyType.Boss => "boss",
            _ => "normal"
        };
    }

    /// <summary>
    /// Gets default enemy sprite path as fallback when database sprite is not available
    /// </summary>
    private static string GetDefaultEnemySpriteForType(EnemyType enemyType)
    {
        return enemyType switch
        {
            EnemyType.Boss => "/sprites/games/my-tuno/enemies/forest/boss_1_bear.png",
            _ => "/sprites/games/my-tuno/enemies/forest/wolf.png"
        };
    }

    /// <summary>
    /// Loads the naipe PictureUrl for an instrument part type to display in the loot tracker.
    /// </summary>
    private async Task LoadInstrumentPartImageAsync(InventoryItemType partType)
    {
        try
        {
            var instrumentType = InstrumentTypeHelper.FromInventoryPartType(partType);
            if (instrumentType == null)
            {
                instrumentPartImages[partType] = null;
                return;
            }

            var configs = await NaipeService.GetAllTypeConfigsAsync();
            var config = configs.FirstOrDefault(c => c.InstrumentType == instrumentType.Value);
            instrumentPartImages[partType] = config?.PictureUrl;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load naipe image for {PartType}", partType);
            instrumentPartImages[partType] = null;
        }
    }

    /// <summary>
    /// Gets the custom sprite path for an equipment slot from scaling config.
    /// Returns null if no custom sprite is configured (UI will fall back to icon).
    /// </summary>
    private string? GetEquipmentSpritePath(EquipmentSlot? slot)
    {
        if (slot == null) return null;

        var equipmentDrops = ScalingConfig.Value.StageMode.DropRates.EquipmentDrops;
        var config = equipmentDrops.FirstOrDefault(e =>
            string.Equals(e.Slot, slot.Value.ToString(), StringComparison.OrdinalIgnoreCase));
        return config?.SpritePath;
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;

        // Cancel and dispose timeout token first to prevent further callbacks
        battleTimeoutCts?.Cancel();
        battleTimeoutCts?.Dispose();

        // Cancel any run in progress (restore HP and stage) - uses lock to wait for fight to finish
        await CancelRunIfInProgressAsync();

        // Apply pending defeat rewards if OnBattleFinished never fired
        // (e.g., user navigated away during the death animation)
        if (pendingDefeatRewards && character != null && stagesCleared > 0)
        {
            try
            {
                await StageService.ApplyRunRewardsAsync(
                    character.Id, totalXPEarned, totalFidelisEarned, totalBeersDropped, totalShotsDropped, defeatRestoreHp,
                    totalInstrumentPartsDropped.Count > 0 ? totalInstrumentPartsDropped : null,
                    totalEquipmentDropped.Count > 0 ? totalEquipmentDropped : null);
            }
            catch (Exception)
            {
                // Best-effort during disposal
            }
            pendingDefeatRewards = false;
        }
        
        if (hasRendered)
        {
            try
            {
                // Destroy stage battle game
                await JSRuntime.InvokeVoidAsync("stageBattleGame.destroy");
            }
            catch (Exception)
            {
                // Ignore all JS interop errors during disposal
                // (JSDisconnectedException, TaskCanceledException, InvalidOperationException, JSException, etc.)
            }
        }
        
        objRef?.Dispose();
        _stageLock.Dispose();
    }
}
