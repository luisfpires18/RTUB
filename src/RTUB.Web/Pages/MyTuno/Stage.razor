    /// <summary>
    /// Retry from the last checkpoint — reloads data and auto-starts a new run.
    /// </summary>
    private async Task RetryFromCheckpoint()
    {
        consecutiveRetries++;

        // Check if we need an AFK challenge before proceeding
        if (consecutiveRetries > 0 && consecutiveRetries % RetriesBeforeChallenge == 0 && !showAfkChallenge)
        {
            GenerateAfkChallenge();
            showAfkChallenge = true;
            return;
        }

        showAfkChallenge = false;
        showDefeatSummary = false;
        ResetRunTotals();
        battleAutoStarted = false;
        showBattleAnimation = false;
        fighting = false;
        _endingRun = false;
        currentBattle = null;
        _combatSession = null;

        // Destroy JS scene so nextBattle creates a fresh one on the new DOM element
        try { await JSRuntime.InvokeVoidAsync("stageBattleGame.destroySceneOnly"); }
        catch { /* scene may already be gone */ }

        // Restore stage to the checkpoint the user STARTED from (not the latest checkpoint)
        if (retryStartStage.HasValue && currentUser != null)
        {
            await StageService.SetStartStageAsync(currentUser.Id, retryStartStage.Value);
        }
        retryStartStage = null;

        // Reload character + stage progress from DB
        await LoadDataAsync();
        StateHasChanged();

        // Auto-start battle (same as first render)
        if (character != null && hasRendered)
        {
            battleAutoStarted = true;
            await Task.Delay(150);
            if (!_disposed)
            {
                try { await FightStageEnemy(); }
                catch (Exception ex) { Logger.LogError(ex, "Retry auto-start failed"); }
            }
        }
    }

    private void StartWatchdog()
    {
        CancelWatchdog();
        _watchdogCts = new CancellationTokenSource();
        var token = _watchdogCts.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(WatchdogTimeoutMs, token);
                if (!token.IsCancellationRequested && !_disposed && (runInProgress || pendingDefeatRewards))
                {
                    await InvokeAsync(async () =>
                    {
                        if (_disposed || _endingRun) return;
                        Logger.LogWarning("Watchdog triggered: JS OnBattleFinished not received within {Timeout}ms, forcing EndRunEarly", WatchdogTimeoutMs);
                        try { await EndRunEarly(); } catch (Exception ex) { Logger.LogError(ex, "Watchdog EndRunEarly failed"); }
                    });
                }
            }
            catch (TaskCanceledException) { /* expected */ }
        });
    }

    private void CancelWatchdog()
    {
        try { _watchdogCts?.Cancel(); } catch { }
        _watchdogCts?.Dispose();
        _watchdogCts = null;
    }

    private bool _endingRun = false;

    private async Task EndRunEarly()
    {
        if (_disposed || _endingRun) return;
        _endingRun = true;
        CancelWatchdog();

        try
        {
            // Wait for the lock — if FightStageEnemy is in progress, wait up to 5s for it to finish
            if (!await _stageLock.WaitAsync(5000))
            {
                Logger.LogWarning("EndRunEarly: could not acquire lock after 5s, forcing end");
            }

            try
            {
                // Stop any in-progress fight from continuing
                fighting = false;

                // Hide battle canvas IMMEDIATELY — before any async DB work.
                // This prevents intermediate StateHasChanged() calls from other
                // callbacks re-rendering the live canvas while we tear down.
                showBattleAnimation = false;
                _combatSession = null;
                StateHasChanged();

                // Destroy JS battle animation
                if (hasRendered)
                {
                    try { await JSRuntime.InvokeVoidAsync("stageBattleGame.destroy"); }
                    catch { /* JS interop may fail */ }
                }

                // Save defeated-at stage before applying rewards
                defeatedAtStage = currentBattle?.StageNumber ?? currentStageNumber;

                // Apply accumulated rewards and return to checkpoint atomically
                if (character != null && stagesCleared > 0 && currentUser != null)
                {
                    try
                    {
                        var rewards = new EndRunRewardsDto
                        {
                            Xp = totalXPEarned,
                            Fidelis = totalFidelisEarned,
                            Finos = totalFinosDropped,
                            Canecas = totalCanecasDropped,
                            Cigarros = totalCigarrosDropped,
                            Canhaos = totalCanhaosDropped,
                            Shots = totalShotsDropped,
                            Penalties = totalPenaltiesDropped,
                            Fitab = totalFitabDropped,
                            RestoreHp = runStartingHp,
                            InstrumentParts = totalInstrumentPartsDropped.Count > 0 ? totalInstrumentPartsDropped : null,
                            ExpirePenaltyBuff = false,
                            StartStage = runStartingStage ?? currentStageNumber,
                            EndStage = currentStageNumber,
                            RareSetPieces = totalRareSetDropped.Count > 0 ? totalRareSetDropped : null,
                            Leitao = totalLeitaoDropped,
                            HighestStage = stageProgress?.HighestStage ?? 1,
                            LastCheckpoint = stageProgress?.LastCheckpoint ?? 1,
                            TotalStagesCleared = stageProgress?.TotalStagesCleared ?? 0,
                            TotalBossesDefeated = stageProgress?.TotalBossesDefeated ?? 0,
                            EndlessModeUnlocked = stageProgress?.EndlessModeUnlocked ?? false
                        };
                        stageProgress = await StageService.EndRunAsync(character.Id, currentUser.Id, rewards);
                        currentStageNumber = stageProgress.CurrentStage;
                        checkpointStage = stageProgress.LastCheckpoint;
                        character = await CharacterService.GetOrCreateCharacterAsync(currentUser.Id);
                        await RefreshCurrentUserAsync();
                    }
                    catch (Exception ex)
                    {
                        Logger.LogError(ex, "Error applying run rewards on early end");
                    }
                }
                else if (character != null && runStartingHp.HasValue)
                {
                    // No stages cleared — restore HP to pre-run value
                    await StageService.CancelRunAsync(character.Id, runStartingHp.Value, runStartingStage ?? currentStageNumber, runStartingShotBuffBattles, runStartingCigarroBuff, runStartingCanhaoBuff, runStartingPenaltyBuff, runStartingCanhaoRemainingMs);
                }

                // Clear run state
                runInProgress = false;
                runStartingHp = null;
                runStartingStage = null;
                pendingDefeatRewards = false;

                // Show reward summary (showBattleAnimation already set false above)
                showDefeatSummary = true;
                currentEnemyStats.Clear();
                currentBattle = null;

                StateHasChanged();
            }
            finally
            {
                try { _stageLock.Release(); } catch (ObjectDisposedException) { }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error ending run early");
        }
        finally
        {
            _endingRun = false;
        }
    }

    /// <summary>
    /// Gets the enemy type name for JavaScript
