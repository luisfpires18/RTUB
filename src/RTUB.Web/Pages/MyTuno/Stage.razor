    /// <summary>
    /// Called by JS when the user clicks a consumable button during combat.
    /// Consumes the item and applies its effect to the combat session.
    /// </summary>
    [JSInvokable]
    public async Task<string> OnUseConsumable(string type)
    {
        if (character == null || currentUser == null)
            return JsonSerializer.Serialize(new { success = false, message = "Personagem não encontrado." }, _spellJsonOptions);

        try
        {
            var result = await CombatActionService.ApplyConsumableAsync(_combatSession, currentUser.Id, type, character);

            if (!result.Success)
                return JsonSerializer.Serialize(new { success = false, message = result.Message }, _spellJsonOptions);

            // Decrement local UI quantity tracker
            var newQuantity = DecrementConsumableQuantity(type);

            // Build the JSON response expected by JS
            if (result.HealAmount.HasValue)
                return JsonSerializer.Serialize(new { success = true, type, newQuantity, healAmount = result.HealAmount, playerHP = result.PlayerHP, playerMaxHP = result.PlayerMaxHP, cooldownSeconds = result.CooldownSeconds }, _spellJsonOptions);
            if (result.NewActionTime.HasValue && result.NewActionTime > 0)
                return JsonSerializer.Serialize(new { success = true, type, newQuantity, buffMessage = result.BuffMessage, buffActive = result.BuffActive, newActionTime = result.NewActionTime }, _spellJsonOptions);
            return JsonSerializer.Serialize(new { success = true, type, newQuantity, buffMessage = result.BuffMessage, buffActive = result.BuffActive }, _spellJsonOptions);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Error using consumable {Type}", type);
            return JsonSerializer.Serialize(new { success = false, message = "Erro ao usar consumível." }, _spellJsonOptions);
        }
    }

    /// <summary>
    /// Decrements the local UI consumable quantity tracker and returns the new value.
    /// </summary>
    private int DecrementConsumableQuantity(string type)
    {
        return type.ToLowerInvariant() switch
        {
            "fino" => _finoQty = Math.Max(0, _finoQty - 1),
            "caneca" => _canecaQty = Math.Max(0, _canecaQty - 1),
            "cigarro" => _cigarroQty = Math.Max(0, _cigarroQty - 1),
            "canhao" => _canhaoQty = Math.Max(0, _canhaoQty - 1),
            "shot" => _shotQty = Math.Max(0, _shotQty - 1),
            "penalty" => _penaltyQty = Math.Max(0, _penaltyQty - 1),
            _ => 0
        };
    }

    [JSInvokable]
    public async Task OnBattleFinished()
    {
        // Cancel watchdog — JS called back successfully
        CancelWatchdog();

        // Guard: component may have been disposed while JS animation was playing
        if (_disposed) return;

        // Guard: user clicked "Acabar" while JS animation was playing — don't continue
        // Note: on defeat, runInProgress is set to false immediately in FightStageEnemy
        // to prevent CancelRunIfInProgressAsync from restoring HP during the animation.
        // So we also check pendingDefeatRewards to allow defeat processing to proceed.
        if (_endingRun) return;
        if (!runInProgress && !pendingDefeatRewards) return;

        // Auto-continue to next stage if victory (don't hide battle animation)
        // Use interactive session outcome if available, otherwise fall back to pre-computed
        var didWin = _combatSession != null
            ? (_combatSession.Winner == _combatSession.Player.Identifier)
            : (currentBattle != null && currentBattle.Outcome == BattleOutcome.AttackerWon);

        // If interactive session says win but pre-computed said loss (pendingDefeatRewards was
        // set prematurely), correct the state so the run continues properly.
        if (didWin && pendingDefeatRewards)
        {
            pendingDefeatRewards = false;
            runInProgress = true;

            // The predicted-loss path cleared runStartingStage and saved it into
            // retryStartStage. Restore it now so that any subsequent predicted-loss
            // on the next stage still returns to the original starting checkpoint
            // rather than snapping to the latest stage reached.
            if (runStartingStage == null && retryStartStage.HasValue)
            {
                runStartingStage = retryStartStage.Value;
                retryStartStage = null;
            }

            // The deterministic engine predicted a loss, so
            // UpdateCharacterAndProgressInMemory skipped stage advancement.
            // Advance stage progress in memory now (no DB save during runs).
            if (stageProgress != null && currentBattle != null)
            {
                // Recalculate rewards — currentBattle.XPReward/FidelisReward are 0
                // because the deterministic sim predicted a loss.
                var (recoveredXp, recoveredFidelis) = StageService.GetWinRewardsForStage(
                    currentBattle.StageNumber, currentBattle.EnemyCount, stageProgress.HighestStage);
                totalXPEarned += recoveredXp;
                totalFidelisEarned += recoveredFidelis;

                for (int i = 0; i < currentBattle.EnemyCount; i++)
                {
                    stageProgress.RecordEnemyDefeat();
                }
                if (currentBattle.EnemyType == EnemyType.Boss)
                {
                    stageProgress.RecordBossDefeat();
                }
                var totalEnemies = BiomeService.GetEnemyCountForStage(stageProgress.CurrentStage);
                if (stageProgress.EnemiesDefeatedInCurrentStage >= totalEnemies)
                {
                    stageProgress.AdvanceStage();
                }
                currentStageNumber = stageProgress.CurrentStage;
                checkpointStage = stageProgress.LastCheckpoint;
            }
        }

        // Update character HP from interactive session (overrides pre-computed value)
        if (_combatSession != null && character != null)
        {
            character.CurrentHP = _combatSession.Player.CurrentHP > 0
                ? _combatSession.Player.CurrentHP
                : null;
            // Buff remaining counts are now per-run (not per-hit), no session sync needed
        }

        if (didWin && currentBattle != null)
        {
            try
            {
                // Accumulate rewards for the run
                totalXPEarned += currentBattle.XPReward;
                totalFidelisEarned += currentBattle.FidelisReward;
                totalFinosDropped += currentBattle.FinosDropped;
                totalCanecasDropped += currentBattle.CanecasDropped;
                totalCigarrosDropped += currentBattle.CigarrosDropped;
                totalCanhaosDropped += currentBattle.CanhaosDropped;
                totalShotsDropped += currentBattle.ShotsDropped;
                totalPenaltiesDropped += currentBattle.PenaltiesDropped;
                totalFitabDropped += currentBattle.FitabDropped;
                totalLeitaoDropped += currentBattle.LeitaoDropped;

                // Accumulate instrument part drops
                foreach (var partType in currentBattle.InstrumentPartsDropped)
                {
                    if (totalInstrumentPartsDropped.ContainsKey(partType))
                        totalInstrumentPartsDropped[partType]++;
                    else
                        totalInstrumentPartsDropped[partType] = 1;

                    // Load image for this instrument part if not already loaded
                    if (!instrumentPartImages.ContainsKey(partType))
                    {
                        await LoadInstrumentPartImageAsync(partType);
                    }
                }

                // Accumulate rare set piece drops
                foreach (var rareType in currentBattle.RareSetPiecesDropped)
                {
                    totalRareSetDropped.Add(rareType);
                }

                stagesCleared++;
                
                // Brief delay then start next stage automatically
                // Keep showBattleAnimation = true to avoid hiding/recreating the container
                await Task.Delay(200);
                if (_disposed || _endingRun) return;
                // Preserve cooldowns before destroying session
                PreserveCooldownsFromSession();
                currentBattle = null;
                _combatSession = null;
                
                // Only update UI after starting next battle to minimize flicker
                await FightStageEnemy();
                // Note: FightStageEnemy already calls StateHasChanged in its finally block
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error in OnBattleFinished victory path, ending run");
                if (!_disposed)
                {
                    try { await EndRunEarly(); } catch { /* last resort */ }
                }
            }
        }
        else
        {
            // Run ended (defeat) - apply accumulated rewards and return to checkpoint atomically
            // Save the starting stage BEFORE clearing run state — used by RECOMEÇAR
            retryStartStage ??= runStartingStage ?? currentStageNumber;

            if (character != null && currentUser != null)
            {
                try
                {
                    defeatedAtStage = currentBattle?.StageNumber ?? currentStageNumber;
                    var rewards = new EndRunRewardsDto
                    {
                        Xp = totalXPEarned,
                        Fidelis = totalFidelisEarned,
                        Finos = totalFinosDropped,
                        Canecas = totalCanecasDropped,
                        Cigarros = totalCigarrosDropped,
                        Canhaos = totalCanhaosDropped,
                        Shots = totalShotsDropped,
                        Penalties = totalPenaltiesDropped,
                        Fitab = totalFitabDropped,
                        RestoreHp = defeatRestoreHp,
                        InstrumentParts = totalInstrumentPartsDropped.Count > 0 ? totalInstrumentPartsDropped : null,
                        ExpirePenaltyBuff = true,
                        StartStage = defeatStartStage ?? currentStageNumber,
                        EndStage = currentStageNumber,
                        RareSetPieces = totalRareSetDropped.Count > 0 ? totalRareSetDropped : null,
                        Leitao = totalLeitaoDropped,
                        HighestStage = stageProgress?.HighestStage ?? 1,
                        LastCheckpoint = stageProgress?.LastCheckpoint ?? 1,
                        TotalStagesCleared = stageProgress?.TotalStagesCleared ?? 0,
                        TotalBossesDefeated = stageProgress?.TotalBossesDefeated ?? 0,
                        EndlessModeUnlocked = stageProgress?.EndlessModeUnlocked ?? false
                    };
                    stageProgress = await StageService.EndRunAsync(character.Id, currentUser.Id, rewards);
                    currentStageNumber = stageProgress.CurrentStage;
                    checkpointStage = stageProgress.LastCheckpoint;

                    // Reload character and user to get fresh HP and Fidelis balance
                    character = await CharacterService.GetOrCreateCharacterAsync(currentUser.Id);
                    await RefreshCurrentUserAsync();
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Error ending run after defeat");
                }
            }

            runInProgress = false;
            runStartingHp = null;
            runStartingStage = null;
            pendingDefeatRewards = false;

            // Stop the battle animation and show defeat summary
            showBattleAnimation = false;
            showDefeatSummary = true;
            currentEnemyStats.Clear();
            currentBattle = null;
            _combatSession = null;
            
            if (!_disposed) StateHasChanged();
        }
    }

    private async Task SetBattleSpeed(double speed)
    {
        // Clamp to allowed values to prevent exploit via tampered calls
        speed = speed switch { 5.0 => 5.0, _ => 1.0 };
