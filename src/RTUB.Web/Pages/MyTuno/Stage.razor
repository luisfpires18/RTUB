    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        CancelWatchdog();

        // Cancel any run in progress (restore HP and stage) - uses lock to wait for fight to finish
        await CancelRunIfInProgressAsync();

        // Apply pending defeat rewards if OnBattleFinished never fired
        // (e.g., user navigated away during the death animation)
        if (pendingDefeatRewards && character != null && stagesCleared > 0 && currentUser != null)
        {
            try
            {
                var rewards = new EndRunRewardsDto
                {
                    Xp = totalXPEarned,
                    Fidelis = totalFidelisEarned,
                    Finos = totalFinosDropped,
                    Canecas = totalCanecasDropped,
                    Cigarros = totalCigarrosDropped,
                    Canhaos = totalCanhaosDropped,
                    Shots = totalShotsDropped,
                    Penalties = totalPenaltiesDropped,
                    Fitab = totalFitabDropped,
                    RestoreHp = defeatRestoreHp,
                    InstrumentParts = totalInstrumentPartsDropped.Count > 0 ? totalInstrumentPartsDropped : null,
                    ExpirePenaltyBuff = true,
                    StartStage = defeatStartStage ?? runStartingStage ?? currentStageNumber,
                    EndStage = currentStageNumber,
                    RareSetPieces = totalRareSetDropped.Count > 0 ? totalRareSetDropped : null,
                    Leitao = totalLeitaoDropped,
                    HighestStage = stageProgress?.HighestStage ?? 1,
                    LastCheckpoint = stageProgress?.LastCheckpoint ?? 1,
                    TotalStagesCleared = stageProgress?.TotalStagesCleared ?? 0,
                    TotalBossesDefeated = stageProgress?.TotalBossesDefeated ?? 0,
                    EndlessModeUnlocked = stageProgress?.EndlessModeUnlocked ?? false
                };
                await StageService.EndRunAsync(character.Id, currentUser.Id, rewards);
            }
            catch (Exception)
            {
                // Best-effort during disposal
            }
            pendingDefeatRewards = false;
        }
        
        if (hasRendered)
        {
            try
            {
                // Destroy stage battle game
                await JSRuntime.InvokeVoidAsync("stageBattleGame.destroy");
            }
            catch (Exception)
            {
                // Ignore all JS interop errors during disposal
                // (JSDisconnectedException, TaskCanceledException, InvalidOperationException, JSException, etc.)
            }
        }
        
        objRef?.Dispose();
        _stageLock.Dispose();
    }

    // ── Anti-AFK Challenge ──────────────────────────────────────────────

    private void GenerateAfkChallenge()
    {
        var a = Random.Shared.Next(1, 20);
        var b = Random.Shared.Next(1, 20);
        afkChallengeQuestion = $"Quanto é {a} + {b}?";
        afkChallengeAnswer = a + b;
        afkChallengeInput = "";
        afkChallengeWrong = false;
    }

    private async Task SubmitAfkChallenge()
    {
        if (int.TryParse(afkChallengeInput, out var answer) && answer == afkChallengeAnswer)
        {
            showAfkChallenge = false;
            afkChallengeWrong = false;
            await RetryFromCheckpoint();
        }
        else
        {
            afkChallengeWrong = true;
            afkChallengeInput = "";
        }
    }

    private async Task AfkChallengeKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SubmitAfkChallenge();
        }
    }
