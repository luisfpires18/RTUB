@page "/my-tuno/stages"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.JSInterop
@using RTUB.Application.Interfaces
@using RTUB.Application.Data
@using RTUB.Application.DTOs
@using RTUB.Core.Entities
@using RTUB.Core.Enums
@using RTUB.Core.Helpers
@using RTUB.Shared
@using RTUB.Shared.Base
@using RTUB.Shared.Components.UI
@using System.Text.Json
@using RTUB.Application.Configuration
@using Microsoft.Extensions.Options
@attribute [Authorize]
@inject IStageService StageService
@inject ICharacterService CharacterService
@inject INaipeService NaipeService
@inject IOptions<MyTunoScalingConfiguration> ScalingConfig
@inject IStageProgressRepository StageProgressRepository
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject ILogger<Stage> Logger
@inject IStageBiomeService BiomeService
@inject IAuditLogService AuditLogService
@implements IAsyncDisposable

<PageTitle>Stage Mode - My Tuno - RTUB</PageTitle>

<div class="stage-page container-fluid">
    <div class="d-flex flex-column gap-3 mb-4">
        <div class="d-flex justify-content-between align-items-center gap-3">
            <!-- Left: Back button -->
            <button class="btn btn-outline-secondary" @onclick="GoBack" title="Voltar">
                <i class="bi bi-arrow-left"></i>
            </button>
            
            <!-- Center: Title (takes remaining space + centers text) -->
            <div class="flex-grow-1 text-center">
                <h1 class="mb-2"><i class="bi bi-trophy"></i> Stage Mode</h1>
            </div>
            
            <!-- Right: Invisible spacer (maintains symmetry) -->
            <div style="width: 48px;"></div>
        </div>
    </div>

    @if (loading)
    {
        <LoadingSpinner />
    }
    else if (character == null)
    {
        <EmptyState Title="Personagem não encontrado"
                    Message="Ocorreu um erro ao carregar o teu personagem."
                    Icon="bi-person-x" />
    }
    else if (errorMessage != string.Empty)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
        </div>
    }
    else
    {
        <!-- Battle Screen - Always show container when animating to preserve PixiJS game -->
        @if (showBattleAnimation)
        {
            <div class="card mb-4 battle-card">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-sword me-2"></i>
                        @if (currentBattle != null)
                        {
                            <text>Stage @currentBattle.StageNumber</text>
                        }
                        else
                        {
                            <text>A carregar batalha...</text>
                        }
                    </h5>
                    <div class="btn-group btn-group-sm" role="group" aria-label="Battle speed controls">
                        <button type="button" class="btn btn-outline-light @(battleSpeed == 1.0 ? "active" : "")" 
                                @onclick="() => SetBattleSpeed(1.0)">
                            1x
                        </button>
                        <button type="button" class="btn btn-outline-light @(battleSpeed == 2.0 ? "active" : "")" 
                                @onclick="() => SetBattleSpeed(2.0)">
                            2x
                        </button>
                        <button type="button" class="btn btn-outline-light @(battleSpeed == 3.0 ? "active" : "")" 
                                @onclick="() => SetBattleSpeed(3.0)">
                            3x
                        </button>
                        <button type="button" class="btn btn-outline-warning" @onclick="ToggleAudio" title="Alternar som">
                            <i class="bi @(audioEnabled ? "bi-volume-up" : "bi-volume-mute")"></i>
                        </button>
                        <button type="button" class="btn btn-outline-danger" @onclick="EndRunEarly" title="Acabar Stage">
                            <i class="bi bi-stop-fill me-1"></i>Acabar
                        </button>
                    </div>
                </div>
                <div class="card-body p-0 d-flex justify-content-center">
                    <div id="phaserBattleContainer"></div>
                </div>
            </div>

            <!-- Accumulated Loot Tracker - Separate card on mobile for better visibility -->
            @if (stagesCleared > 0)
            {
                <div class="card mb-4 rewards-card">
                    <div class="card-body">
                        <h6 class="mb-3"><i class="bi bi-gift me-2"></i>Progresso:</h6>
                        <div class="d-flex align-items-center gap-3 flex-wrap">
                            <span class="badge bg-success">
                                <i class="bi bi-check-circle me-1"></i>@Fmt(stagesCleared) Stages
                            </span>
                            <span class="badge bg-warning text-dark">
                                <i class="bi bi-star-fill me-1"></i>+@Fmt(totalXPEarned) XP
                            </span>
                            <span class="badge bg-info text-dark">
                                <i class="bi bi-coin me-1"></i>+@Fmt(totalFidelisEarned) Fidelis
                            </span>
                            @if (totalBeersDropped > 0)
                            {
                                <span class="badge bg-warning text-dark">
                                    <i class="bi bi-cup-straw me-1"></i>+@Fmt(totalBeersDropped) Cerveja
                                </span>
                            }
                            @if (totalShotsDropped > 0)
                            {
                                <span class="badge bg-danger">
                                    <i class="bi bi-cup me-1"></i>+@Fmt(totalShotsDropped) Shot
                                </span>
                            }
                            @foreach (var (partType, qty) in totalInstrumentPartsDropped)
                            {
                                var instrumentType = InstrumentTypeHelper.FromInventoryPartType(partType);
                                var instrumentName = instrumentType.HasValue ? InstrumentTypeHelper.GetDisplayName(instrumentType.Value) : partType.ToString();
                                var imageUrl = instrumentPartImages.GetValueOrDefault(partType);
                                <span class="badge bg-purple text-white instrument-drop-badge">
                                    @if (!string.IsNullOrEmpty(imageUrl))
                                    {
                                        <img src="@imageUrl" alt="@instrumentName" class="instrument-drop-icon me-1" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-music-note me-1"></i>
                                    }
                                    +@qty @instrumentName
                                </span>
                            }
                            @foreach (var (equipType, qty) in totalEquipmentDropped)
                            {
                                var slot = EquipmentDropHelper.FromInventoryItemType(equipType);
                                var equipName = slot.HasValue ? EquipmentDropHelper.GetDisplayName(slot.Value) : equipType.ToString();
                                var equipSprite = GetEquipmentSpritePath(slot);
                                var fallbackIcon = slot.HasValue ? EquipmentDropHelper.GetFallbackIcon(slot.Value) : "bi-gem";
                                <span class="badge bg-equipment text-white equipment-drop-badge">
                                    @if (!string.IsNullOrEmpty(equipSprite))
                                    {
                                        <img src="@equipSprite" alt="@equipName" class="equipment-drop-icon me-1" />
                                    }
                                    else
                                    {
                                        <i class="bi @fallbackIcon me-1"></i>
                                    }
                                    +@qty @equipName
                                </span>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- Enemy Stats Card -->
            @if (currentEnemyStats.Count > 0)
            {
                <div class="card mb-4 enemy-stats-card">
                    <div class="card-body">
                        <h6 class="mb-3"><i class="bi bi-person-fill-exclamation me-2"></i>Stats dos Inimigos:</h6>
                        @foreach (var enemy in currentEnemyStats)
                        {
                            <div class="mb-2">
                                <small class="fw-bold d-block mb-1">@enemy.Name</small>
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <span class="badge bg-danger">
                                        <i class="bi bi-heart-fill me-1"></i>@Fmt(enemy.HP) HP
                                    </span>
                                    <span class="badge bg-warning text-dark">
                                        <i class="bi bi-lightning-fill me-1"></i>@Fmt(enemy.Power) Poder
                                    </span>
                                    <span class="badge bg-info text-dark">
                                        <i class="bi bi-shield-fill me-1"></i>@Fmt(enemy.Defense) Defesa
                                    </span>
                                    <span class="badge bg-secondary">
                                        <i class="bi bi-speedometer2 me-1"></i>@enemy.ActionTime.ToString("0.#") s
                                    </span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }

        @if (showDefeatSummary)
        {
            <div class="defeat-overlay">
                <div class="defeat-panel">
                    <div class="defeat-banner">
                        <span>STAGE LIMPA</span>
                    </div>
                    <div class="defeat-stage">Stage @Fmt(defeatedAtStage)</div>
                    @if (stagesCleared > 0)
                    {
                        <div class="defeat-rewards">
                            <div class="defeat-reward-row">
                                <i class="bi bi-check-circle-fill text-success"></i>
                                <span>@Fmt(stagesCleared) Stages</span>
                            </div>
                            <div class="defeat-reward-row">
                                <i class="bi bi-star-fill text-warning"></i>
                                <span>+@Fmt(totalXPEarned) XP</span>
                            </div>
                            <div class="defeat-reward-row">
                                <i class="bi bi-coin" style="color: #7c4dff;"></i>
                                <span>+@Fmt(totalFidelisEarned) Fidelis</span>
                            </div>
                            @if (totalBeersDropped > 0)
                            {
                                <div class="defeat-reward-row">
                                    <i class="bi bi-cup-straw text-warning"></i>
                                    <span>+@Fmt(totalBeersDropped) Cerveja</span>
                                </div>
                            }
                            @if (totalShotsDropped > 0)
                            {
                                <div class="defeat-reward-row">
                                    <i class="bi bi-cup text-danger"></i>
                                    <span>+@totalShotsDropped Shot</span>
                                </div>
                            }
                            @foreach (var (partType, qty) in totalInstrumentPartsDropped)
                            {
                                var instrumentType = InstrumentTypeHelper.FromInventoryPartType(partType);
                                var instrumentName = instrumentType.HasValue ? InstrumentTypeHelper.GetDisplayName(instrumentType.Value) : partType.ToString();
                                var imageUrl = instrumentPartImages.GetValueOrDefault(partType);
                                <div class="defeat-reward-row instrument-part-reward">
                                    @if (!string.IsNullOrEmpty(imageUrl))
                                    {
                                        <img src="@imageUrl" alt="@instrumentName" class="instrument-drop-icon" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-music-note" style="color: #a855f7;"></i>
                                    }
                                    <span>+@qty @instrumentName</span>
                                </div>
                            }
                            @foreach (var (equipType, qty) in totalEquipmentDropped)
                            {
                                var slot = EquipmentDropHelper.FromInventoryItemType(equipType);
                                var equipName = slot.HasValue ? EquipmentDropHelper.GetDisplayName(slot.Value) : equipType.ToString();
                                var equipSprite = GetEquipmentSpritePath(slot);
                                var fallbackIcon = slot.HasValue ? EquipmentDropHelper.GetFallbackIcon(slot.Value) : "bi-gem";
                                <div class="defeat-reward-row equipment-reward">
                                    @if (!string.IsNullOrEmpty(equipSprite))
                                    {
                                        <img src="@equipSprite" alt="@equipName" class="equipment-drop-icon" />
                                    }
                                    else
                                    {
                                        <i class="bi @fallbackIcon" style="color: #f59e0b;"></i>
                                    }
                                    <span>+@qty @equipName</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="defeat-no-rewards">Nenhuma stage completada.</p>
                    }
                    <button class="defeat-btn" @onclick="DefeatGoBack">
                        IR MY TUNO
                    </button>
                </div>
            </div>
        }
    }
</div>

@code {
    private Character? character;
    private ApplicationUser? currentUser;
    private StageProgress? stageProgress;
    private StageBattleResult? currentBattle;
    private bool loading = true;
    private bool fighting = false;
    private bool showBattleAnimation = false;
    private string errorMessage = string.Empty;
    private DotNetObjectReference<Stage>? objRef;
    private bool hasRendered = false;
    private bool battleAutoStarted = false;
    private int currentStageNumber = 1;
    private int checkpointStage = 1;


    // Battle controls
    private double battleSpeed = 1.0;
    private bool audioEnabled = true;
    
    // Cancellation token for battle animation timeout
    private CancellationTokenSource? battleTimeoutCts;

    // Accumulated loot tracker for the current run
    private int totalXPEarned = 0;
    private decimal totalFidelisEarned = 0;
    private int totalBeersDropped = 0;
    private int totalShotsDropped = 0;
    private Dictionary<InventoryItemType, int> totalInstrumentPartsDropped = new();
    private Dictionary<InventoryItemType, string?> instrumentPartImages = new();
    private Dictionary<InventoryItemType, int> totalEquipmentDropped = new();
    private int stagesCleared = 0;

    // Run state tracking for cancel/exit functionality
    private int? runStartingHp;
    private int? runStartingStage;
    private int runStartingShotBuffBattles = 0;
    private bool runInProgress = false;
    private bool pendingDefeatRewards = false;
    private bool _disposed = false;

    // Defeat summary state
    private bool showDefeatSummary = false;
    private int defeatedAtStage = 0;
    private int? defeatRestoreHp; // HP to restore after defeat (saved from runStartingHp)
    
    // Semaphore to prevent concurrent stage operations (fight/cancel) sharing the same DbContext
    private readonly SemaphoreSlim _stageLock = new(1, 1);

    // Current battle enemy stats
    private List<EnemyStatsInfo> currentEnemyStats = new();

    // Query parameter for starting stage
    [SupplyParameterFromQuery(Name = "start")]
    public int? StartStage { get; set; }

    private record EnemyStatsInfo(string Name, int HP, int Power, int Defense, int Speed, double ActionTime);

    protected override async Task OnInitializedAsync()
    {
        // Reset animation state on page load
        showBattleAnimation = false;
        fighting = false;
        await LoadDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            hasRendered = true;
            
            // Auto-start battle after first render (only once)
            if (character != null && currentBattle == null && !battleAutoStarted)
            {
                battleAutoStarted = true;
                await Task.Delay(500); // Brief delay for UI to settle
                try
                {
                    await FightStageEnemy();
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Auto-start battle failed");
                    errorMessage = "Failed to start battle automatically. Please try again.";
                    StateHasChanged();
                }
            }
        }
    }

    private async Task LoadDataAsync()
    {
        try
        {
            loading = true;
            errorMessage = string.Empty;

            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                currentUser = await UserManager.GetUserAsync(user);
                if (currentUser != null)
                {
                    character = await CharacterService.GetOrCreateCharacterAsync(currentUser.Id);
                    if (character != null)
                    {
                        stageProgress = await StageService.GetOrCreateStageProgressAsync(currentUser.Id);
                        if (stageProgress != null)
                        {
                            // Handle start query parameter - persist to DB if different
                            if (StartStage.HasValue && StartStage.Value > 0)
                            {
                                // Validate start stage: can go to any previously reached stage, not beyond
                                var targetStage = Math.Clamp(StartStage.Value, 1, stageProgress.HighestStage);
                                
                                // Update DB if different from current
                                if (targetStage != stageProgress.CurrentStage)
                                {
                                    stageProgress.CurrentStage = targetStage;
                                    stageProgress.CurrentRegion = StageProgress.GetRegionForStage(targetStage);
                                    await StageProgressRepository.UpdateAsync(stageProgress);
                                }
                                
                                currentStageNumber = targetStage;
                                
                                // Clean URL to prevent reuse/tampering
                                Navigation.NavigateTo("/my-tuno/stages", replace: true);
                            }
                            else
                            {
                                currentStageNumber = stageProgress.CurrentStage;
                            }
                            
                            checkpointStage = stageProgress.LastCheckpoint;
                        }
                    }
                }
            }
        }
        catch (NavigationException)
        {
            // Blazor uses this exception for flow control during NavigateTo — let it propagate
            throw;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading stage data");
            errorMessage = "Erro ao carregar dados do estágio.";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task FightStageEnemy()
    {
        if (_disposed) return;
        if (character == null || currentUser == null || stageProgress == null) return;
        
        // Prevent multiple concurrent battles
        if (fighting) return;
        
        // Acquire lock to prevent concurrent DbContext access (e.g. dispose cancel vs fight)
        if (!await _stageLock.WaitAsync(0)) return;

        try
        {
            fighting = true;
            var wasAlreadyAnimating = showBattleAnimation;
            showBattleAnimation = true;
            errorMessage = string.Empty;
            
            // Store run starting state for cancel functionality (only on first battle of run)
            if (!runInProgress)
            {
                runStartingHp = character.CurrentHP;
                runStartingStage = stageProgress.CurrentStage;
                runStartingShotBuffBattles = character.ShotBuffBattlesRemaining;
                runInProgress = true;
                Logger.LogInformation("Stage mode started by {UserName} at stage {Stage}", currentUser.UserName, stageProgress.CurrentStage);
                await AuditLogService.AddAsync(new AuditLog
                {
                    EntityType = "StageRun",
                    Action = "Started",
                    UserName = currentUser.UserName,
                    UserId = currentUser.Id,
                    Timestamp = DateTime.UtcNow,
                    EntityDisplayName = $"Stage {stageProgress.CurrentStage}",
                    Changes = System.Text.Json.JsonSerializer.Serialize(new { Stage = stageProgress.CurrentStage, HP = character.CurrentHP })
                });
            }
            
            // Only update UI if we weren't already animating (first battle)
            if (!wasAlreadyAnimating)
            {
                StateHasChanged();
                await JSRuntime.InvokeVoidAsync("window.scrollTo", 0, 0);
                // Wait for container to be rendered on first battle
                await Task.Delay(100);
            }

            // Execute stage battle
            currentBattle = await StageService.ExecuteStageBattleAsync(character.Id);

            // If the player lost, immediately mark the run as finished so that
            // CancelRunIfInProgressAsync (called on dispose/navigate-away) will NOT
            // restore HP while the defeat animation is still playing.
            if (currentBattle.Outcome != BattleOutcome.AttackerWon)
            {
                // Save the pre-run HP before clearing run state
                defeatRestoreHp = runStartingHp;
                // Mark run as finished IMMEDIATELY
                runInProgress = false;
                runStartingHp = null;
                runStartingStage = null;
                pendingDefeatRewards = true;
            }

            // Start live battle animation
            if (!string.IsNullOrEmpty(currentBattle.ReplayJson))
            {
                try
                {
                    // Initialize DotNetObjectReference if not already done
                    if (objRef == null)
                    {
                        objRef = DotNetObjectReference.Create(this);
                    }

                    // Get enemy type config for this stage (use the battle's stage number, not the local variable)
                    var battleStageNumber = currentBattle.StageNumber;
                    var enemyTypeName = GetEnemyTypeName(currentBattle.EnemyType);
                    
                    // Parse the replay JSON to get enemy sprites and count
                    var replayData = JsonSerializer.Deserialize<JsonElement>(currentBattle.ReplayJson);
                    var enemyCount = replayData.TryGetProperty("EnemyCount", out var countProp) ? countProp.GetInt32() : 1;
                    var eventsJson = replayData.TryGetProperty("Events", out var eventsProp) ? eventsProp.GetRawText() : currentBattle.ReplayJson;
                    
                    // Get enemy sprite paths from replay data (array of paths for each enemy)
                    List<string> enemySpritePaths = new();
                    if (replayData.TryGetProperty("EnemySprites", out var spritesProp) && spritesProp.ValueKind == JsonValueKind.Array)
                    {
                        foreach (var sprite in spritesProp.EnumerateArray())
                        {
                            enemySpritePaths.Add(sprite.GetString() ?? GetDefaultEnemySpriteForType(currentBattle.EnemyType));
                        }
                    }
                    
                    // Fallback: use default sprite for enemy type
                    if (enemySpritePaths.Count == 0)
                    {
                        var fallbackSprite = GetDefaultEnemySpriteForType(currentBattle.EnemyType);
                        enemySpritePaths = Enumerable.Repeat(fallbackSprite, enemyCount).ToList();
                    }

                    // Parse enemy stats from replay data
                    currentEnemyStats.Clear();
                    if (replayData.TryGetProperty("EnemyStats", out var statsProp) && statsProp.ValueKind == JsonValueKind.Array)
                    {
                        foreach (var stat in statsProp.EnumerateArray())
                        {
                            var name = stat.TryGetProperty("Name", out var nameProp) ? nameProp.GetString() ?? "Enemy" : "Enemy";
                            var hp = stat.TryGetProperty("HP", out var hpProp) ? hpProp.GetInt32() : 0;
                            var power = stat.TryGetProperty("Power", out var powerProp) ? powerProp.GetInt32() : 0;
                            var defense = stat.TryGetProperty("Defense", out var defenseProp) ? defenseProp.GetInt32() : 0;
                            var speed = stat.TryGetProperty("Speed", out var speedProp) ? speedProp.GetInt32() : 0;
                            var actionTime = stat.TryGetProperty("ActionTime", out var atProp) ? atProp.GetDouble() : 5.0;
                            currentEnemyStats.Add(new EnemyStatsInfo(name, hp, power, defense, speed, actionTime));
                        }
                    }

                    // Parse enemy placements (0=Terrestrial, 1=Aerial)
                    var enemyPlacements = new List<int>();
                    if (replayData.TryGetProperty("EnemyPlacements", out var placementsProp) && placementsProp.ValueKind == JsonValueKind.Array)
                    {
                        foreach (var p in placementsProp.EnumerateArray())
                        {
                            enemyPlacements.Add(p.GetInt32());
                        }
                    }
                    // Default to terrestrial if no placements found
                    while (enemyPlacements.Count < enemyCount)
                    {
                        enemyPlacements.Add(0);
                    }

                    // Create stage battle data object for new stage battle scene
                    var battleData = new
                    {
                        EventsJson = eventsJson,
                        DotNetRef = objRef,
                        StageNumber = battleStageNumber,
                        EnemyType = enemyTypeName,
                        EnemyCount = enemyCount,
                        PlayerName = character.User?.Nickname ?? character.User?.UserName ?? "Player",
                        EnemyName = currentBattle.EnemyName,
                        BackgroundPath = BiomeService.GetBackgroundForStage(battleStageNumber),
                        PlayerSpritePath = "/sprites/games/my-tuno/default_tuno.png",
                        EnemySprites = enemySpritePaths, // Array of sprite paths
                        EnemyPlacements = enemyPlacements, // 0=Terrestrial, 1=Aerial
                        BattleSpeed = battleSpeed, // Pass current speed setting
                        HasShotBuff = character.ShotBuffBattlesRemaining > 0
                    };

                    // nextBattle handles both first battle (falls back to start) and subsequent battles
                    await JSRuntime.InvokeVoidAsync("stageBattleGame.nextBattle", battleData);

                    // Cancel any previous timeout and create new one
                    battleTimeoutCts?.Cancel();
                    battleTimeoutCts = new CancellationTokenSource();
                    var timeoutToken = battleTimeoutCts.Token;
                    
                    // Set a timeout to reset animation state if JS doesn't call OnBattleFinished
                    _ = Task.Run(async () =>
                    {
                        try
                        {
                            await Task.Delay(120000, timeoutToken); // 120 seconds max
                            if (showBattleAnimation && !_disposed)
                            {
                                Logger.LogWarning("Battle animation timeout - resetting showBattleAnimation");
                                showBattleAnimation = false;
                                await InvokeAsync(StateHasChanged);
                            }
                        }
                        catch (TaskCanceledException)
                        {
                            // Timeout was cancelled because battle finished normally - this is expected
                        }
                        catch (ObjectDisposedException)
                        {
                            // Component was disposed while timeout was pending - expected
                        }
                    });
                }
                catch (JSException ex)
                {
                    Logger.LogError(ex, "Error starting battle animation: {Message}", ex.Message);
                    errorMessage = "Error starting battle animation.";
                    showBattleAnimation = false;
                    StateHasChanged();
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Unexpected error starting battle animation");
                    errorMessage = "Unexpected error starting battle animation.";
                    showBattleAnimation = false;
                    StateHasChanged();
                }
            }
            else
            {
                showBattleAnimation = false;
            }

            // Reload character and stage progress after battle
            var userId = currentUser.Id;
            character = await CharacterService.GetOrCreateCharacterAsync(userId);
            stageProgress = await StageService.GetOrCreateStageProgressAsync(userId);
            if (stageProgress != null)
            {
                currentStageNumber = stageProgress.CurrentStage;
                checkpointStage = stageProgress.LastCheckpoint;
            }
        }
        catch (JSDisconnectedException)
        {
            // Circuit disconnected - exit silently
            return;
        }
        catch (Exception ex) when (!_disposed)
        {
            Logger.LogError(ex, "Error starting stage battle");
            errorMessage = $"Erro ao iniciar batalha: {ex.Message}";
            showBattleAnimation = false;
        }
        finally
        {
            fighting = false;
            _stageLock.Release();
            if (!_disposed)
            {
                if (currentBattle == null || string.IsNullOrEmpty(currentBattle.ReplayJson))
                {
                    showBattleAnimation = false;
                }
                StateHasChanged();
            }
        }
    }

    private async Task ContinueToNextStage()
    {
        if (_disposed) return;
        // Reset battle state and start next fight
        currentBattle = null;
        await FightStageEnemy();
    }

    [JSInvokable]
    public async Task OnBattleFinished()
    {
        // Guard: component may have been disposed while JS animation was playing
        if (_disposed) return;

        // Auto-continue to next stage if victory (don't hide battle animation)
        if (currentBattle != null && currentBattle.Outcome == BattleOutcome.AttackerWon)
        {
            // Accumulate rewards for the run
            totalXPEarned += currentBattle.XPReward;
            totalFidelisEarned += currentBattle.FidelisReward;
            totalBeersDropped += currentBattle.BeersDropped;
            totalShotsDropped += currentBattle.ShotsDropped;

            // Accumulate instrument part drops
            foreach (var partType in currentBattle.InstrumentPartsDropped)
            {
                if (totalInstrumentPartsDropped.ContainsKey(partType))
                    totalInstrumentPartsDropped[partType]++;
                else
                    totalInstrumentPartsDropped[partType] = 1;

                // Load image for this instrument part if not already loaded
                if (!instrumentPartImages.ContainsKey(partType))
                {
                    await LoadInstrumentPartImageAsync(partType);
                }
            }

            // Accumulate equipment drops
            foreach (var equipType in currentBattle.EquipmentDropped)
            {
                if (totalEquipmentDropped.ContainsKey(equipType))
                    totalEquipmentDropped[equipType]++;
                else
                    totalEquipmentDropped[equipType] = 1;
            }

            stagesCleared++;
            
            // Brief delay then start next stage automatically
            // Keep showBattleAnimation = true to avoid hiding/recreating the container
            await Task.Delay(200);
            if (_disposed) return;
            currentBattle = null;
            
            // Only update UI after starting next battle to minimize flicker
            await FightStageEnemy();
            if (!_disposed) StateHasChanged();
        }
        else
        {
            // Run ended (defeat) - restore HP to pre-run value and apply accumulated rewards
            if (character != null)
            {
                try
                {
                    await StageService.ApplyRunRewardsAsync(
                        character.Id, totalXPEarned, totalFidelisEarned, totalBeersDropped, totalShotsDropped, defeatRestoreHp,
                        totalInstrumentPartsDropped.Count > 0 ? totalInstrumentPartsDropped : null,
                        totalEquipmentDropped.Count > 0 ? totalEquipmentDropped : null);
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Error applying run rewards");
                }
            }

            // Mark run as complete (may already be false from FightStageEnemy)
            runInProgress = false;
            runStartingHp = null;
            runStartingStage = null;
            pendingDefeatRewards = false;
            
            // Cancel the timeout since battle finished normally
            battleTimeoutCts?.Cancel();

            // Return to checkpoint but do NOT auto-restart — show defeat summary instead
            if (!_disposed && currentUser != null && stageProgress != null)
            {
                try
                {
                    // Save the stage where the player was defeated before returning to checkpoint
                    defeatedAtStage = currentBattle?.StageNumber ?? currentStageNumber;

                    stageProgress = await StageService.ReturnToCheckpointAsync(currentUser.Id);
                    currentStageNumber = stageProgress.CurrentStage;
                    checkpointStage = stageProgress.LastCheckpoint;
                    
                    // Reload character to get fresh HP
                    character = await CharacterService.GetOrCreateCharacterAsync(currentUser.Id);
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Error returning to checkpoint after defeat");
                }
            }

            // Stop the battle animation and show defeat summary
            showBattleAnimation = false;
            showDefeatSummary = true;
            currentEnemyStats.Clear();
            currentBattle = null;
            
            if (!_disposed) StateHasChanged();
        }
    }

    private async Task SetBattleSpeed(double speed)
    {
        battleSpeed = speed;
        try
        {
            await JSRuntime.InvokeVoidAsync("stageBattleGame.setSpeed", speed);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Error setting battle speed");
        }
    }

    private async Task ToggleAudio()
    {
        audioEnabled = !audioEnabled;
        try
        {
            await JSRuntime.InvokeVoidAsync("stageBattleGame.setAudioEnabled", audioEnabled);
        }
        catch (Exception ex)
        {
