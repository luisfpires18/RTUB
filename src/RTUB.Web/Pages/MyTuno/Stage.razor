    private async Task GoBack()
    {
        // If a run is in progress, cancel it and restore the starting state
        await CancelRunIfInProgressAsync();
        Navigation.NavigateTo("/my-tuno");
    }

    private async Task CancelRunIfInProgressAsync()
    {
        if (runInProgress && character != null && runStartingHp.HasValue && runStartingStage.HasValue)
        {
            // Wait for any in-progress fight to complete before cancelling
            try { await _stageLock.WaitAsync(); } catch (ObjectDisposedException) { return; }
            try
            {
                // Re-check after acquiring lock (fight may have finished and cleared runInProgress)
                if (runInProgress && runStartingHp.HasValue && runStartingStage.HasValue)
                {
                    await StageService.CancelRunAsync(character.Id, runStartingHp.Value, runStartingStage.Value, runStartingShotBuffBattles, runStartingCigarroShield, runStartingCanhaoBoost, runStartingPenaltyBuff);
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error cancelling run");
            }
            finally
            {
                runInProgress = false;
                runStartingHp = null;
                runStartingStage = null;
                try { _stageLock.Release(); } catch (ObjectDisposedException) { }
            }
        }
    }

