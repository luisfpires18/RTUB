    private async Task StartFromStage(int stage)
    {
        // Validate stage number
        if (stage < 1)
        {
            Logger.LogWarning("Invalid stage number: {Stage}. Must be at least 1.", stage);
            stage = 1;
        }
        
        if (stageProgress != null && stage > stageProgress.HighestStage)
        {
            Logger.LogWarning("Stage {Stage} exceeds highest reached {Highest}. Using highest.", stage, stageProgress.HighestStage);
            stage = stageProgress.HighestStage;
        }

        // Update current stage in DB before navigating — avoids fragile query parameter handling
        if (currentUser != null)
        {
            try
            {
                await StageService.SetStartStageAsync(currentUser.Id, stage);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error setting start stage to {Stage}", stage);
            }
        }

        showStageModal = false;
        Navigation.NavigateTo("/my-tuno/stages");
    }

