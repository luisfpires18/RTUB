@page "/my-tuno"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using RTUB.Application.Interfaces
@using RTUB.Core.Entities
@using RTUB.Core.Enums
@using RTUB.Shared
@using RTUB.Shared.Base
@using RTUB.Application.DTOs
@using RTUB.Shared.Components.UI
@using RTUB.Application.Configuration
@using Microsoft.Extensions.Options
@using Microsoft.Extensions.Configuration
@attribute [Authorize]
@inject ICharacterService CharacterService
@inject IUpgradeService UpgradeService
@inject ICharacterRepository CharacterRepository
@inject IInventoryService InventoryService
@inject IStageService StageService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation
@inject ILogger<MyTunoHome> Logger
@inject IConfiguration Configuration
@inject IOptions<MyTunoScalingConfiguration> MyTunoConfig

<PageTitle>My Tuno - RTUB</PageTitle>

<div class="my-tuno-home-page container-fluid">
    <div class="d-flex flex-column gap-3 mb-4">
        <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
            <div>
                <h1 class="mb-2"><i class="bi bi-joystick"></i> My Tuno</h1>
                <p class="lead page-header-subtitle mb-0 text-light-theme">
                    Luta contra oponentes AI e melhora o teu personagem.
                </p>
            </div>
            <button class="btn btn-outline-primary" @onclick="OpenInfoModal">
                <i class="bi bi-info-circle me-2"></i>Sobre My Tuno
            </button>
        </div>
    </div>

    @if (loading)
    {
        <LoadingSpinner />
    }
    else if (character == null)
    {
        <EmptyState Title="Personagem não encontrado"
                    Message="Ocorreu um erro ao carregar o teu personagem."
                    Icon="bi-person-x" />
    }
    else
    {
        var isCharacterDead = character != null && (character.CurrentHP ?? character.TotalHP) <= 0;
        var displayMaxHpForCheck = GetDisplayMaxHP(character);
        var isFullHp = character != null && (character.CurrentHP ?? character.TotalHP) >= displayMaxHpForCheck;
        <div class="row g-4">
            <!-- Inventory -->
            <div class="col-lg-4">
                <div class="card h-100">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="bi bi-archive me-2"></i>Inventory</h5>
                    </div>
                    <div class="card-body">
                        @if (currentUser != null)
                        {
                            <div class="inventory-grid">
                                <!-- Fidelis -->
                                <div class="inventory-box inventory-box-fidelis">
                                    <div class="inventory-icon">
                                        <i class="bi bi-coin text-success"></i>
                                    </div>
                                    <div class="inventory-value text-success">@currentUser.FidelisBalance.ToString("F2")</div>
                                    <div class="inventory-label">Fidelis</div>
                                </div>
                                
                                <!-- Cerveja (Beer) -->
                                <div class="inventory-box inventory-box-beer">
                                    <div class="inventory-icon">
                                        <i class="bi bi-cup-straw text-warning"></i>
                                    </div>
                                    <div class="inventory-value text-warning">@beerQuantity</div>
                                    <div class="inventory-label">Cerveja</div>
                                    <button class="btn btn-sm btn-warning inventory-action-btn mt-2" 
                                            @onclick="UseBeer"
                                            disabled="@(usingBeer || beerQuantity == 0 || character == null || isCharacterDead || isFullHp)">
                                        @if (usingBeer)
                                        {
                                            <span class="spinner-border spinner-border-sm"></span>
                                        }
                                        else
                                        {
                                            <text>Usar</text>
                                        }
                                    </button>
                                </div>
                                
                                <!-- Shot -->
                                <div class="inventory-box inventory-box-shot">
                                    <div class="inventory-icon">
                                        <i class="bi bi-droplet-fill text-info"></i>
                                    </div>
                                    <div class="inventory-value text-info">@shotQuantity</div>
                                    <div class="inventory-label">Shot</div>
                                    <button class="btn btn-sm btn-info inventory-action-btn mt-2" 
                                            @onclick="UseShot"
                                            disabled="@(usingShot || shotQuantity == 0 || character == null || isCharacterDead || character.ShotBuffBattlesRemaining > 0)">
                                        @if (usingShot)
                                        {
                                            <span class="spinner-border spinner-border-sm"></span>
                                        }
                                        else
                                        {
                                            <text>Usar</text>
                                        }
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Character Summary Card -->
            <div class="col-lg-4">
                <div class="card h-100">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="bi bi-person me-2"></i>Personagem</h5>
                    </div>
                    <div class="card-body">
                        <!-- HP Bar (above character sprite) -->
                        @{
                            var currentHP = character!.CurrentHP ?? character.TotalHP;
                            var displayMaxHP = GetDisplayMaxHP(character);
                            var hpProgress = displayMaxHP > 0 ? Math.Min(100, (currentHP * 100.0 / displayMaxHP)) : 0;
                        }
                        <div class="xp-bar-container mb-3">
                            <div class="xp-bar-bg">
                                <div class="xp-bar-fill hp-bar-fill" 
                                     style="width: @(hpProgress.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%"
                                     role="progressbar" 
                                     aria-valuenow="@currentHP" 
                                     aria-valuemin="0" 
                                     aria-valuemax="@displayMaxHP">
                                </div>
                            </div>
                            <div class="xp-bar-text">
                                <span class="xp-current">HP: @currentHP</span>
                                <span class="xp-separator">/</span>
                                <span class="xp-max">@displayMaxHP</span>
                            </div>
                        </div>
                        
                        <!-- Character Sprite -->
                        <div class="text-center mb-3">
                            <img src="/sprites/games/my-tuno/default_tuno.png" 
                                 alt="My Tuno Character" 
                                 class="character-sprite img-fluid"
                                 style="max-height: 200px; max-width: 100%; object-fit: contain;" />
                        </div>
                        
                        <div class="mb-3">
                            <h4 class="text-center mb-3">Nível @character.Level</h4>
                            @{
                                var xpForNextLevel = character.Level * 100;
                                var xpProgress = xpForNextLevel > 0 ? Math.Min(100, (character.XP * 100.0 / xpForNextLevel)) : 0;
                            }
                            <!-- XP Bar matching Profile.razor style -->
                            <div class="xp-bar-container">
                                <div class="xp-bar-bg">
                                    <div class="xp-bar-fill" 
                                         style="width: @(xpProgress.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%"
                                         role="progressbar" 
                                         aria-valuenow="@character.XP" 
                                         aria-valuemin="0" 
                                         aria-valuemax="@xpForNextLevel">
                                    </div>
                                </div>
                                <div class="xp-bar-text">
                                    <span class="xp-current">@character.XP XP</span>
                                    <span class="xp-separator">/</span>
                                    <span class="xp-max">@xpForNextLevel XP</span>
                                </div>
                            </div>
                        </div>
                        <hr />
                        
                        <!-- Colored Stat Boxes -->
                        <div class="d-flex flex-column gap-2">
                            <!-- HP Stat Box -->
                            @{
                                var hasEnhancementHP = character.ShotBuffBattlesRemaining > 0;
                                var hpColorClass = hasEnhancementHP ? "text-info" : "text-danger";
                                var hpBorderClass = hasEnhancementHP ? "border-info" : "border-danger";
                            }
                            <div class="p-2 border @hpBorderClass rounded d-flex justify-content-between align-items-center" style="background-color: #1e1e1e;">
                                <span class="d-flex align-items-center">
                                    <i class="bi bi-heart-fill @hpColorClass me-2"></i>
                                    <span>HP</span>
                                    @if (hasEnhancementHP)
                                    {
                                        <i class="bi bi-arrow-up-circle-fill text-info ms-1" title="+20% (Shot)"></i>
                                    }
                                </span>
                                <strong class="@hpColorClass">@currentHP / @displayMaxHP</strong>
                            </div>
                            
                            <!-- Restore HP Button (appears when HP < Max and character is alive) -->
                            @if (currentHP > 0 && currentHP < displayMaxHP)
                            {
                                <div class="p-2 border border-success rounded d-flex justify-content-between align-items-center" 
                                     style="background-color: #1e1e1e;">
                                    <span class="d-flex align-items-center">
                                        <i class="bi bi-heart-pulse text-success me-2"></i>
                                        <span>Restaurar HP</span>
                                    </span>
                                    <div class="d-flex align-items-center gap-2">
                                        <strong class="text-success">@GetRestoreCost() <i class="bi bi-coin text-warning"></i></strong>
                                        <button class="btn btn-sm btn-success" 
                                                @onclick="RestoreHP"
                                                disabled="@(restoringHP || currentUser == null || currentUser.FidelisBalance < GetRestoreCost())">
                                            @if (restoringHP)
                                            {
                                                <span class="spinner-border spinner-border-sm"></span>
                                            }
                                            else
                                            {
                                                <text>Restaurar</text>
                                            }
                                        </button>
                                    </div>
                                </div>
                            }
                            
                            @{
                                var hasEnhancement = character.ShotBuffBattlesRemaining > 0;
                                var enhancedClass = hasEnhancement ? "text-info" : "";
                                var enhancedBorderClass = hasEnhancement ? "border-info" : "border-success";
                                var enhancedSpeedBorderClass = hasEnhancement ? "border-info" : "border-primary";
                                var enhancedCritBorderClass = hasEnhancement ? "border-info" : "border-warning";
                            }
                            
                            <!-- Power Stat Box -->
                            <div class="p-2 border @(hasEnhancement ? "border-info" : "border-success") rounded d-flex justify-content-between align-items-center" style="background-color: #1e1e1e;">
                                <span class="d-flex align-items-center">
                                    <i class="bi bi-lightning-fill @(hasEnhancement ? "text-info" : "text-success") me-2"></i>
                                    <span>Power</span>
                                    @if (hasEnhancement)
                                    {
                                        <i class="bi bi-arrow-up-circle-fill text-info ms-1" title="+20% (Shot)"></i>
                                    }
                                </span>
                                <strong class="@(hasEnhancement ? "text-info" : "text-success")">@character.TotalPower</strong>
                            </div>
                            
                            <!-- Speed Stat Box -->
                            <div class="p-2 border @(hasEnhancement ? "border-info" : "border-primary") rounded d-flex justify-content-between align-items-center" style="background-color: #1e1e1e;">
                                <span class="d-flex align-items-center">
                                    <i class="bi bi-speedometer2 @(hasEnhancement ? "text-info" : "text-primary") me-2"></i>
                                    <span>Speed</span>
                                    @if (hasEnhancement)
                                    {
                                        <i class="bi bi-arrow-up-circle-fill text-info ms-1" title="+20% (Shot)"></i>
                                    }
                                </span>
                                <strong class="@(hasEnhancement ? "text-info" : "text-primary")">@($"{character.ActionTime:F1}s")</strong>
                            </div>
                            
                            <!-- Critical Stat Box -->
                            <div class="p-2 border @(hasEnhancement ? "border-info" : "border-warning") rounded d-flex justify-content-between align-items-center" style="background-color: #1e1e1e;">
                                <span class="d-flex align-items-center">
                                    <i class="bi bi-bullseye @(hasEnhancement ? "text-info" : "text-warning") me-2"></i>
                                    <span>Crítico</span>
                                    @if (hasEnhancement)
                                    {
                                        <i class="bi bi-arrow-up-circle-fill text-info ms-1" title="+20% (Shot)"></i>
                                    }
                                </span>
                                <strong class="@(hasEnhancement ? "text-info" : "text-warning")">@($"{character.TotalCriticalChance * 100:F1}%")</strong>
                            </div>
                            
                            <!-- Defense Stat Box -->
                            <div class="p-2 border @(hasEnhancement ? "border-info" : "border-secondary") rounded d-flex justify-content-between align-items-center" style="background-color: #1e1e1e;">
                                <span class="d-flex align-items-center">
                                    <i class="bi bi-shield-fill @(hasEnhancement ? "text-info" : "") me-2" style="color: @(hasEnhancement ? "" : "white")"></i>
                                    <span>Defense</span>
                                    @if (hasEnhancement)
                                    {
                                        <i class="bi bi-arrow-up-circle-fill text-info ms-1" title="+20% (Shot)"></i>
                                    }
                                </span>
                                <strong class="@(hasEnhancement ? "text-info" : "")" style="color: @(hasEnhancement ? "" : "white")">@character.TotalDefense</strong>
                            </div>
                        </div>
                        
                        <!-- Active Enhancements Section -->
                        @if (character.ShotBuffBattlesRemaining > 0)
                        {
                            <div class="mt-3">
                                <h6 class="text-info mb-2"><i class="bi bi-magic me-2"></i>Melhorias Ativas</h6>
                                <div class="p-2 border border-info rounded d-flex justify-content-between align-items-center" style="background-color: #1e1e1e;">
                                    <span class="d-flex align-items-center">
                                        <i class="bi bi-droplet-fill text-info me-2"></i>
                                        <span>Shot (+20% stats)</span>
                                    </span>
                                    <span class="badge bg-info">@character.ShotBuffBattlesRemaining batalhas</span>
                                </div>
                                <small class="text-muted d-block mt-1">
                                    <i class="bi bi-info-circle me-1"></i>Apenas em batalhas de Arena
                                </small>
                            </div>
                        }
                        
                        @if (currentHP <= 0)
                        {
                            var reviveCost = GetReviveCost();
                            var canAffordRevive = currentUser?.FidelisBalance >= reviveCost;
                            
                            <div class="alert alert-danger mt-3 mb-3" role="alert">
                                <i class="bi bi-exclamation-triangle me-2"></i>
                                <strong>Personagem derrotado!</strong> Precisa de reviver para lutar.
                            </div>
                            <button class="btn btn-success w-100 mb-2" @onclick="ReviveCharacter" disabled="@(reviving || !canAffordRevive)">
                                @if (reviving)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    <text>A reviver...</text>
                                }
                                else
                                {
                                    <i class="bi bi-heart-fill me-2"></i>
                                    <text>Reviver (@reviveCost.ToString("F2") Fidelis)</text>
                                }
                            </button>
                            @if (currentUser != null && !canAffordRevive)
                            {
                                <small class="text-danger d-block mt-2 text-center">
                                    <i class="bi bi-exclamation-triangle me-1"></i>
                                    Saldo insuficiente
                                </small>
                            }
                        }
                        
                        <hr />
                        <div class="d-flex gap-2">
                            <button class="btn btn-primary btn-lg flex-grow-1" @onclick="NavigateToArena" disabled="@(currentHP <= 0)">
                                <i class="bi bi-sword me-2"></i>Arena
                            </button>
                            <button class="btn btn-success btn-lg flex-grow-1" @onclick="OpenStageModal" disabled="@(currentHP <= 0)">
                                <i class="bi bi-layers me-2"></i>Stages
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Leaderboard -->
            <div class="col-lg-4">
                <div class="card h-100">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="bi bi-trophy-fill me-2"></i>Leaderboard</h5>
                    </div>
                    <div class="card-body">
                        @if (leaderboardLoading)
                        {
                            <LoadingSpinner Message="A carregar leaderboard..." />
                        }
                        else if (leaderboardEntries == null || !leaderboardEntries.Any())
                        {
                            <EmptyState Title="Leaderboard vazio"
                                        Message="Ainda não há jogadores com vitórias."
                                        Icon="bi-trophy" />
                        }
                        else
                        {
                            <!-- Leaderboard Type Tabs -->
                            <ul class="nav nav-pills nav-fill mb-3">
                                <li class="nav-item">
                                    <button class="nav-link @(leaderboardTab == "arena" ? "active" : "")" @onclick='() => leaderboardTab = "arena"'>
                                        <i class="bi bi-shield-fill me-1"></i>Arena
                                    </button>
                                </li>
                                <li class="nav-item">
                                    <button class="nav-link @(leaderboardTab == "stage" ? "active" : "")" @onclick='() => leaderboardTab = "stage"'>
                                        <i class="bi bi-flag-fill me-1"></i>Stage
                                    </button>
                                </li>
                            </ul>
                            
                            <div class="stats-card-grid">
                                @{
                                    var sortedLeaderboard = leaderboardTab == "arena"
                                        ? leaderboardEntries.OrderByDescending(e => e.Wins).ThenByDescending(e => e.Level).ToList()
                                        : leaderboardEntries.OrderByDescending(e => e.HighestStage).ThenByDescending(e => e.Level).ToList();
                                    var paginatedItems = sortedLeaderboard.Skip((leaderboardCurrentPage - 1) * leaderboardPageSize).Take(leaderboardPageSize).ToList();
                                }
                                @for (int i = 0; i < paginatedItems.Count; i++)
                                {
                                    var entry = paginatedItems[i];
                                    var position = ((leaderboardCurrentPage - 1) * leaderboardPageSize) + i + 1;
                                    <div class="stats-card">
                                        <div class="stats-card-position">
                                            @if (position == 1)
                                            {
                                                <span class="stats-medal gold">🥇</span>
                                            }
                                            else if (position == 2)
                                            {
                                                <span class="stats-medal silver">🥈</span>
                                            }
                                            else if (position == 3)
                                            {
                                                <span class="stats-medal bronze">🥉</span>
                                            }
                                            else
                                            {
                                                <span class="stats-position">@position</span>
                                            }
                                        </div>
                                        <img src="@(entry.AvatarUrl ?? "/images/default-avatar.webp")"
                                             alt="@entry.DisplayName"
                                             class="stats-avatar"
                                             onerror="this.onerror=null; this.src='/images/default-avatar.webp';" />
                                        <div class="stats-card-content">
                                            <div class="stats-card-title">@entry.DisplayName</div>
                                            @if (leaderboardTab == "arena")
                                            {
                                                <div class="stats-card-subtitle">Nível @entry.Level</div>
                                            }
                                            else
                                            {
                                                <div class="stats-card-subtitle">Nível @entry.Level</div>
                                            }
                                        </div>
                                        <div class="stats-card-count">
                                            @if (leaderboardTab == "arena")
                                            {
                                                <i class="bi bi-trophy"></i>
                                                <span>@entry.Wins</span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-flag-fill"></i>
                                                <span>@entry.HighestStage</span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                            
                            @if (leaderboardEntries.Count > leaderboardPageSize)
                            {
                                <div class="mt-3">
                                    <TablePagination CurrentPage="@leaderboardCurrentPage"
                                                    PageSize="@leaderboardPageSize"
                                                    TotalItems="@leaderboardEntries.Count"
                                                    ItemLabel="jogadores"
                                                    OnPageChanged="ChangeLeaderboardPage"
                                                    PageSizeOptions="@(new[] { 5, 10, 20 })"
                                                    OnPageSizeChanged="ChangeLeaderboardPageSize"
                                                    ShowInfo="false" />
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Upgrade Shop Section -->
        <div class="mt-4">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-arrow-up-circle me-2"></i>Loja de Upgrades</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted mb-3">
                        Melhora as estatísticas do teu personagem usando Fidelis.
                        @if (currentUser != null)
                        {
                            <span class="badge bg-success ms-2 mytuno-balance-badge">
                                <i class="bi bi-coin me-1"></i>
                                Saldo: @currentUser.FidelisBalance.ToString("F2") Fidelis
                            </span>
                        }
                    </p>

                    <div class="row g-4">
                        <!-- HP Upgrade Card -->
                        <div class="col-md-6 col-xl-3">
                            <div class="card h-100 upgrade-card upgrade-card--hp">
                                <div class="card-header upgrade-card__header">
                                    <h5 class="mb-0"><i class="bi bi-heart-fill me-2"></i>HP <span class="badge bg-secondary">@(character.HpUpgrades)/50</span></h5>
                                </div>
                                <div class="card-body upgrade-card__body" style="background-color: #1e1e1e;">
                                    <div class="upgrade-card__stats mb-3">
                                        <div class="d-flex justify-content-between align-items-center upgrade-card__stat">
                                            <span class="text-muted">HP Atual:</span>
                                            <strong class="fs-5">@character.TotalHP</strong>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center upgrade-card__stat">
                                            <span class="text-muted">Upgrades:</span>
                                            <strong>@character.HpUpgrades</strong>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center upgrade-card__stat">
                                            <span class="text-muted">Próximo Upgrade:</span>
                                            <strong class="text-success">+10 HP</strong>
                                        </div>
                                    </div>
                                    <hr />
                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between align-items-center upgrade-card__cost">
                                            <span class="text-muted">Custo:</span>
                                            @if (hpCostLoading)
                                            {
                                                <span class="spinner-border spinner-border-sm" role="status"></span>
                                            }
                                            else
                                            {
                                                <span class="upgrade-card__price">
                                                    <i class="bi bi-coin"></i>
                                                    <strong>@hpCost.ToString("F2") Fidelis</strong>
                                                </span>
                                            }
                                        </div>
                                    </div>
                                    <button class="btn btn-danger w-100 upgrade-card__button" 
                                            @onclick="() => PurchaseUpgrade(StatType.HP)"
                                            disabled="@(purchasing || hpCostLoading || (currentUser?.FidelisBalance ?? 0) < hpCost)">
                                        @if (purchasing && purchasingStat == StatType.HP)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                            <text>A comprar...</text>
                                        }
                                        else
                                        {
                                            <i class="bi bi-cart-plus me-2"></i>
                                            <text>Comprar Upgrade</text>
                                        }
                                    </button>
                                    @if (currentUser != null && currentUser.FidelisBalance < hpCost)
                                    {
                                        <small class="text-danger d-block mt-2 text-center">
                                            <i class="bi bi-exclamation-triangle me-1"></i>
                                            Saldo insuficiente
                                        </small>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Power Upgrade Card -->
                        <div class="col-md-6 col-xl-3">
                            <div class="card h-100 upgrade-card upgrade-card--power">
                                <div class="card-header upgrade-card__header bg-success text-white">
                                    <h5 class="mb-0"><i class="bi bi-lightning-fill me-2"></i>Power <span class="badge bg-dark">@(character.PowerUpgrades)/50</span></h5>
                                </div>
                                <div class="card-body upgrade-card__body" style="background-color: #1e1e1e;">
                                    <div class="upgrade-card__stats mb-3">
                                        <div class="d-flex justify-content-between align-items-center upgrade-card__stat">
                                            <span class="text-muted">Power Atual:</span>
                                            <strong class="fs-5">@character.TotalPower</strong>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center upgrade-card__stat">
                                            <span class="text-muted">Upgrades:</span>
                                            <strong>@character.PowerUpgrades</strong>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center upgrade-card__stat">
                                            <span class="text-muted">Próximo Upgrade:</span>
                                            <strong class="text-success">+2 Power</strong>
                                        </div>
                                    </div>
                                    <hr />
                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between align-items-center upgrade-card__cost">
                                            <span class="text-muted">Custo:</span>
                                            @if (powerCostLoading)
                                            {
                                                <span class="spinner-border spinner-border-sm" role="status"></span>
