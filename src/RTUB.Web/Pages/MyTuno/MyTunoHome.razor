    private int GetResourceQuantity(InventoryItemType type)
    {
        return resourceQuantities.TryGetValue(type, out var qty) ? qty : 0;
    }

    private string GetResourceName(InventoryItemType type)
    {
        var res = activeResources.FirstOrDefault(r => r.Type == type.ToString());
        return res?.Name ?? type.ToString();
    }

    private int GetResourceEnergyCost(InventoryItemType type)
    {
        var res = activeResources.FirstOrDefault(r => r.Type == type.ToString());
        return res?.EnergyCost ?? int.MaxValue;
    }

