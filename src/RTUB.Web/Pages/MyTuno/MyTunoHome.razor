    private async Task HealWithFidelis()
    {
        try
        {
            healingWithFidelis = true;
            StateHasChanged();

            if (currentUser == null || character == null)
            {
                toastMessage = "Erro ao identificar usuário";
                toastIsError = true;
                return;
            }

            var maxHp = GetDisplayMaxHP(character);
            var hp = character.CurrentHP ?? maxHp;
            var isDead = hp <= 0;
            var cost = isDead
                ? MyTunoConfig.Value.BattleRewards.ReviveCost
                : MyTunoConfig.Value.BattleRewards.RestoreHPCost;

            if (currentUser.FidelisBalance < cost)
            {
                toastMessage = "Fidelis insuficiente!";
                toastIsError = true;
                return;
            }

            // Deduct Fidelis
            currentUser.FidelisBalance -= cost;
            await UserManager.UpdateAsync(currentUser);

            // Heal to full
            character.CurrentHP = null; // null = full HP
            await CharacterService.UpdateCharacterAsync(character);

            toastMessage = isDead ? $"Revivido! (-{Fmt(cost)} Fidelis)" : $"HP restaurado! (-{Fmt(cost)} Fidelis)";
            toastIsError = false;
        }
        catch (Exception ex)
        {
            toastMessage = "Erro ao curar personagem";
            toastIsError = true;
            Logger.LogError(ex, "Error healing character with Fidelis");
        }
        finally
        {
            healingWithFidelis = false;
            StateHasChanged();
        }
    }

