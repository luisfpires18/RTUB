@page "/my-tuno"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using RTUB.Application.Interfaces
@using RTUB.Core.Entities
@using RTUB.Core.Enums
@using RTUB.Shared
@using RTUB.Shared.Base
@using RTUB.Shared.Components.UI
@using RTUB.Application.Configuration
@using RTUB.Core.Helpers
@using Microsoft.Extensions.Options
@using RTUB.Pages.MyTuno.Components
@using Microsoft.EntityFrameworkCore
@attribute [Authorize]
@implements IDisposable
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject ICharacterService CharacterService
@inject IUpgradeService UpgradeService
@inject IImprovementService ImprovementService
@inject IConsumableUpgradeService ConsumableUpgradeService
@inject IInventoryService InventoryService
@inject INaipeService NaipeService
@inject IStageService StageService
@inject IBossModeService BossModeService
@inject ISurviveModeService SurviveModeService
@inject IShopService ShopService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation
@inject ILogger<MyTunoHome> Logger
@inject IOptions<MyTunoScalingConfiguration> MyTunoConfig
@inject IItemTypeConfigService ItemTypeConfigService
@inject RTUB.Web.Services.AdminRefreshService AdminRefreshService

<PageTitle>My Tuno - RTUB</PageTitle>

<div class="my-tuno-home-page container-fluid">
    <div class="page-header-centered mb-4">
        <div class="page-header-left"></div>
        <div class="page-header-center">
            <h1><i class="bi bi-joystick"></i> My Tuno</h1>
            <p class="page-header-subtitle">Luta contra oponentes AI e melhora o teu personagem.</p>
        </div>
        <div class="page-header-right d-none d-xl-flex">
            <a href="/my-tuno/all-characters" class="btn btn-outline-primary">
                <i class="bi bi-trophy-fill me-2"></i><span class="btn-text">Classificação</span>
            </a>
            <AuthorizeView Roles="Owner">
                <Authorized>
                    <a href="/owner/stage-enemies" class="btn btn-outline-warning">
                        <i class="bi bi-bug me-1"></i><span class="btn-text">Stage Enemies</span>
                    </a>
                    <a href="/owner/weapon-drink-config" class="btn btn-outline-warning">
                        <i class="bi bi-sliders me-1"></i><span class="btn-text">Config</span>
                    </a>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>

    @if (loading)
    {
        <LoadingSpinner />
    }
    else if (character == null)
    {
        <EmptyState Title="Personagem não encontrado"
                    Message="Ocorreu um erro ao carregar o teu personagem."
                    Icon="bi-person-x" />
    }
    else
    {
        var displayMaxHpForCheck = GetDisplayMaxHP(character);
        var isFullHp = character != null && (character.CurrentHP ?? GetDisplayMaxHP(character)) >= displayMaxHpForCheck;

        <!-- Fidelis Balance Bar -->
        @if (currentUser != null)
        {
            <div class="fidelis-bar">
                <div class="fidelis-bar__inner">
                    <div class="fidelis-bar__icon">
                        <i class="bi bi-coin"></i>
                    </div>
                    <div class="fidelis-bar__info">
                        <span class="fidelis-bar__label">Fidelis</span>
                        <span class="fidelis-bar__value">@Fmt(currentUser.FidelisBalance)</span>
                    </div>
                    <div class="fidelis-bar__icon ms-3" style="color: #ffffff;">
                        <i class="bi bi-lightning-fill"></i>
                    </div>
                    <div class="fidelis-bar__info">
                        <span class="fidelis-bar__label" style="color: #e040fb;">FITAB</span>
                        <span class="fidelis-bar__value">@fitabQuantity</span>
                    </div>
                    <div class="fidelis-bar__icon ms-3" style="color: #f8bbd0;">
                        <span>🐷</span>
                    </div>
                    <div class="fidelis-bar__info">
                        <span class="fidelis-bar__label" style="color: #f8bbd0;">Leitões</span>
                        <span class="fidelis-bar__value">@leitaoQuantity</span>
                    </div>
                    <div class="ms-auto">
                        @if (CanClaimDailyReward)
                        {
                            <button class="btn btn-sm btn-warning" @onclick="ClaimDailyReward" disabled="@claimingDailyReward">
                                @if (claimingDailyReward)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                <i class="bi bi-gift-fill me-1"></i>Daily Reward
                            </button>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                <i class="bi bi-clock me-1"></i>Daily Reward @DailyRewardTimeRemaining
                            </span>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- Global Toast Messages -->
        @if (!string.IsNullOrEmpty(toastMessage))
        {
            <div class="mb-3">
                <Alert Type="@(toastIsError ? Alert.AlertType.Error : Alert.AlertType.Success)"
                       Message="@toastMessage"
                       Dismissible="true"
                       OnDismiss="@(() => toastMessage = string.Empty)" />
            </div>
        }

        <div class="row g-4">
            <!-- Inventário -->
            <div class="col-lg-4 order-3">
                <div class="card h-100">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="bi bi-archive me-2"></i>Inventário</h5>
                    </div>
                    <div class="card-body p-3 d-flex flex-column">
                        @if (currentUser != null)
                        {
                            <!-- Inventory tabs -->
                            <ul class="nav nav-tabs nav-fill mb-2" style="font-size: 0.75rem;">
                                <li class="nav-item">
                                    <button type="button" class="nav-link @(inventoryTab == 0 ? "active" : "")" @onclick="() => inventoryTab = 0">
                                        <i class="bi bi-cup-straw me-1"></i>Consumíveis
                                    </button>
                                </li>
                                <li class="nav-item">
                                    <button type="button" class="nav-link @(inventoryTab == 1 ? "active" : "")" @onclick="() => inventoryTab = 1">
                                        <i class="bi bi-hammer me-1"></i>Craft
                                    </button>
                                </li>
                                <li class="nav-item">
                                    <button type="button" class="nav-link @(inventoryTab == 2 ? "active" : "")" @onclick="() => inventoryTab = 2">
                                        <i class="bi bi-shield-shaded me-1"></i>Equipável
                                        @if (rareSetInventory.Count > 0)
                                        {
                                            <span class="badge ms-1" style="background: linear-gradient(135deg, #ffd700, #daa520); color: #1a1200; font-size: 0.55rem; vertical-align: top; animation: rare-tab-pulse 2s ease-in-out infinite;">
                                                <i class="bi bi-gem"></i> @rareSetInventory.Count
                                            </span>
                                        }
                                    </button>
                                </li>
                            </ul>

                            @if (inventoryTab == 0)
                            {
                                <!-- Consumables: ordered by unlock stage -->
                                <div class="item-grid">
                                    @{
                                        var consumableHighestStage = stageProgress?.HighestStage ?? 1;
                                        var consumableUnlocks = new (string Name, string Icon, string FallbackIcon, string Desc, string CssVariant, int UnlockStage, int Qty, bool Using, InventoryItemType ItemType, Func<Task> UseAction, bool ExtraDisabled, string? CombatOnlyTooltip)[]
                                        {
                                            ("Fino", "bi-cup-straw", "bi-cup-straw", "Cura 25% HP", "beer", 1, finoQuantity, usingFino, InventoryItemType.Fino, UseFino, true, "Apenas utilizável em combate"),
                                            ("Cigarro", "bi-cloud", "bi-cloud", $"+{(int)(character!.EffectiveCigarroDodgeChance * 100)}% Dodge x5", "shot", 2001, cigarroQuantity, usingCigarro, InventoryItemType.Cigarro, UseCigarro, character == null || character?.CigarroShieldHitsRemaining > 0, null),
                                            ("Shot", "bi-droplet-fill", "bi-droplet-fill", $"+{(int)((character!.EffectiveShotBuffMultiplier - 1) * 100)}% Stats x5", "shot", 5001, shotQuantity, usingShot, InventoryItemType.Shot, UseShot, character == null || character?.ShotBuffBattlesRemaining > 0, null),
                                            ("Canhão", "bi-bullseye", "bi-bullseye", $"AOE {character!.EffectiveCanhaoMinutes} min", "shot", 7001, canhaoQuantity, usingCanhao, InventoryItemType.Canhao, UseCanhao, character == null || character?.HasCanhaoBuff == true, null),
                                            ("Penalty", "bi-lightning-charge-fill", "bi-lightning-charge-fill", $"Lifesteal {(character!.EffectivePenaltyLifesteal * 100):F1}% HP {character!.EffectivePenaltyMinutes}min", "penalty", 9001, penaltyQuantity, usingPenalty, InventoryItemType.Penalty, UsePenalty, character == null || character?.HasPenaltyBuff == true, null),
                                            ("Caneca", "bi-cup-hot", "bi-cup-hot", "Cura 50% HP", "beer", 11001, canecaQuantity, usingCaneca, InventoryItemType.Caneca, UseCaneca, true, "Apenas utilizável em combate"),
                                        };
                                    }

                                    @foreach (var c in consumableUnlocks)
                                    {
                                        var isConsumableLocked = c.UnlockStage > consumableHighestStage;
                                        var unlockBiomeName = isConsumableLocked
                                            ? MyTunoConfig.Value.StageMode.Biomes.FirstOrDefault(b => b.StageMin <= c.UnlockStage && b.StageMax >= c.UnlockStage)?.Name ?? $"Floor {c.UnlockStage}"
                                            : "";
                                        var isActionDisabled = isConsumableLocked || c.Using || c.Qty == 0 || c.ExtraDisabled;

                                        <div class="item-card item-card--@c.CssVariant @(isConsumableLocked ? "item-card--locked" : "")"
                                             @onclick="async () => { if (!isActionDisabled) await c.UseAction(); }"
                                             style="cursor: @(isActionDisabled ? "not-allowed" : "pointer")"
                                             title="@(isConsumableLocked ? $"{c.Name} — Desbloqueia no Floor {c.UnlockStage} ({unlockBiomeName})" : c.CombatOnlyTooltip ?? c.Name)">
                                            <div class="item-card__qty">
                                                @if (isConsumableLocked)
                                                {
                                                    <i class="bi bi-lock-fill"></i>
                                                }
                                                else
                                                {
                                                    @Fmt(c.Qty)
                                                }
                                            </div>
                                            <div class="item-card__icon">
                                                @if (isConsumableLocked)
                                                {
                                                    <i class="bi bi-lock-fill" style="opacity: 0.4;"></i>
                                                }
                                                else if (c.Using)
                                                {
                                                    <span class="spinner-border spinner-border-sm @(c.CssVariant == "beer" ? "text-warning" : "text-info")"></span>
                                                }
                                                else if (GetDrinkPictureUrl(c.ItemType) is string imgUrl)
                                                {
                                                    <img src="@CacheBuster.Bust(imgUrl)" alt="@c.Name" class="gather-sprite" />
                                                }
                                                else
                                                {
                                                    <i class="bi @c.FallbackIcon"></i>
                                                }
                                            </div>
                                            <div class="item-card__name">@c.Name</div>
                                            @if (isConsumableLocked)
                                            {
                                                <div class="item-card__desc" style="font-size: 0.55rem; opacity: 0.6;">@unlockBiomeName</div>
                                            }
                                            else
                                            {
                                                <div class="item-card__desc">@c.Desc</div>
                                            }
                                        </div>
                                    }

                                    @for (var i = 0; i < 1; i++)
                                    {
                                        <div class="item-card item-card--empty"></div>
                                    }
                                </div>
                            }
                            else if (inventoryTab == 1)
                            {
                                <!-- Craftable: Gathering resources + Instrument parts -->
                                <div class="item-grid">
                                    @foreach (var res in activeResources)
                                    {
                                        var resType = Enum.Parse<InventoryItemType>(res.Type);
                                        var cssModifier = res.Type.ToLower();
                                        <div class="item-card item-card--@cssModifier" title="@res.Name — Recurso de craft">
                                            <div class="item-card__qty">@GetResourceQuantity(resType)</div>
                                            <div class="item-card__icon">
                                                @if (GetDrinkPictureUrl(res.Type) is string craftDrinkImg)
                                                {
                                                    <img src="@CacheBuster.Bust(craftDrinkImg)" alt="@res.Name" class="gather-sprite" />
                                                }
                                                else if (!string.IsNullOrEmpty(res.SpritePath))
                                                {
                                                    <img src="@CacheBuster.Bust(res.SpritePath)" alt="@res.Name" class="gather-sprite" />
                                                }
                                                else
                                                {
                                                    <i class="bi @res.Icon"></i>
                                                }
                                            </div>
                                            <div class="item-card__name">@res.Name</div>
                                            <div class="item-card__desc">Craft</div>
                                        </div>
                                    }

                                    @foreach (var kvp in instrumentParts)
                                    {
                                        var invInstrType = InstrumentTypeHelper.FromInventoryPartType(kvp.Key);
                                        var invInstrName = invInstrType.HasValue ? InstrumentTypeHelper.GetDisplayName(invInstrType.Value) : kvp.Key.ToString();
                                        var invImgUrl = invInstrType.HasValue && instrumentImages.TryGetValue(invInstrType.Value, out var invUrl) ? invUrl : null;
                                        var invItemKey = kvp.Key;
                                        <div class="item-card item-card--instrument item-card--clickable" title="@invInstrName" @onclick="() => OnInventoryItemClick(invItemKey)" style="cursor: pointer;">
                                            <div class="item-card__qty">@kvp.Value</div>
                                            <div class="item-card__icon">
                                                @if (!string.IsNullOrEmpty(invImgUrl))
                                                {
                                                    <img src="@CacheBuster.Bust(invImgUrl)" alt="@invInstrName" class="gather-sprite" />
                                                }
                                                else
                                                {
                                                    <i class="bi bi-music-note-beamed"></i>
                                                }
                                            </div>
                                            <div class="item-card__name" style="font-size: 0.55rem;">@invInstrName</div>
                                        </div>
                                    }

                                    @{
                                        var craftEmpty = Math.Max(0, 8 - activeResources.Count - instrumentParts.Count);
                                        for (var i = 0; i < craftEmpty; i++)
                                        {
                                            <div class="item-card item-card--empty"></div>
                                        }
                                    }
                                </div>
                            }
                            else
                            {
                                @* ── Rare Set Pieces in Inventory (shown first) ── *@
                                @if (rareSetInventory.Count > 0)
                                {
                                    <div class="mb-3 p-2 rounded" style="background: rgba(255, 215, 0, 0.06); border: 1px solid rgba(255, 215, 0, 0.25);">
                                        <div class="d-flex align-items-center gap-1 mb-2" style="font-size: 0.75rem; color: #ffd700;">
                                            <i class="bi bi-gem"></i>
                                            <strong>Rare Set Pieces</strong>
                                        </div>
                                        <div class="d-flex flex-wrap gap-2">
                                            @foreach (var kv in rareSetInventory)
                                            {
                                                var rareSlotKey = Core.Helpers.EquipmentDropHelper.GetRareSetSlotKey(kv.Key);
                                                var rareSlot = Core.Helpers.EquipmentDropHelper.FromRareInventoryItemType(kv.Key);
                                                var alreadyApplied = rareSlot.HasValue && character!.IsRareSetSlotApplied(rareSlot.Value);
                                                var pieceName = MyTunoConfig.Value.StageMode.RareSet.Pieces.GetValueOrDefault(rareSlotKey ?? "")?.Name ?? rareSlotKey?.ToUpper() ?? "RARE";
                                                <div class="d-flex flex-column align-items-center p-2 rounded"
                                                     style="background: rgba(255, 215, 0, 0.08); border: 1px solid rgba(255, 215, 0, 0.3); min-width: 90px;">
                                                    <i class="bi bi-gem" style="color: #ffd700; font-size: 1.2rem;"></i>
                                                    <span style="font-size: 0.6rem; color: #ffd700; font-weight: 600;">@pieceName</span>
                                                    @if (alreadyApplied)
                                                    {
                                                        <span class="badge bg-secondary mt-1" style="font-size: 0.55rem;">Applied</span>
                                                    }
                                                    else
                                                    {
                                                        <button class="btn btn-sm mt-1 px-2 py-0" disabled="@applyingRarePiece"
                                                                style="font-size: 0.6rem; background: linear-gradient(135deg, #ffd700, #daa520); color: #1a1200; font-weight: 700; border: none;"
                                                                @onclick="() => ApplyRareSetPieceAsync(kv.Key)">
                                                            @if (applyingRarePiece)
                                                            {
                                                                <span class="spinner-border spinner-border-sm"></span>
                                                            }
                                                            else
                                                            {
                                                                <i class="bi bi-arrow-up-circle me-1"></i><text>APPLY</text>
                                                            }
                                                        </button>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }

                                // Equipable: Equipment pieces (unstacked) + Forged Weapons
                                // Build flat list: each equipment unit as a separate entry
                                var equipableItems = new List<(string Type, string Name, string Icon, InventoryItemType? ItemType, ForgedWeapon? Weapon)>();
                                foreach (var weapon in forgedWeapons.Where(w => !w.IsEquipped))
                                {
                                    var wTitle = weapon.Level > 0 ? weapon.Name + " +" + weapon.Level : weapon.Name;
                                    var wIcon = WeaponTypeHelper.GetIcon(weapon.WeaponType);
                                    equipableItems.Add(("weapon", wTitle, wIcon, null, weapon));
                                }

                                var totalEquipablePages = Math.Max(1, (int)Math.Ceiling(equipableItems.Count / (double)EquipablePageSize));
                                if (equipablePage > totalEquipablePages) equipablePage = totalEquipablePages;
                                var pagedItems = equipableItems.Skip((equipablePage - 1) * EquipablePageSize).Take(EquipablePageSize).ToList();
                                <div class="item-grid">
                                    @foreach (var item in pagedItems)
                                    {
                                        if (item.Type == "weapon" && item.Weapon != null)
                                        {
                                            var wLocal = item.Weapon;
                                            <div class="item-card item-card--equipment item-card--clickable" 
                                                 title="@item.Name" 
                                                 @onclick="() => OnForgedWeaponClick(wLocal)" style="cursor: pointer;">
                                                @if (wLocal.Level > 0)
                                                {
                                                    <div class="item-card__qty">+@wLocal.Level</div>
                                                }
                                                <div class="item-card__icon">
                                                    @if (GetForgedWeaponPictureUrl(wLocal) is string eqWpnImg)
                                                    {
                                                        <img src="@CacheBuster.Bust(eqWpnImg)" alt="@item.Name" class="gather-sprite" style="filter: drop-shadow(0 0 2px var(--bs-warning));" />
                                                    }
                                                    else
                                                    {
                                                        <i class="bi @item.Icon" style="color: var(--bs-warning);"></i>
                                                    }
                                                </div>
                                                <div class="item-card__name" style="font-size: 0.5rem;">@item.Name</div>
                                            </div>
                                        }
                                        else if (item.ItemType.HasValue)
                                        {
                                            var eqItemKey = item.ItemType.Value;
                                            var invSlot = EquipmentDropHelper.FromInventoryItemType(eqItemKey);
                                            var invSlotLevel = invSlot.HasValue ? GetSlotEnhancementLevel(invSlot.Value) : 0;
                                            <div class="item-card item-card--equipment item-card--clickable" title="@item.Name" @onclick="() => OnInventoryItemClick(eqItemKey)" style="cursor: pointer;">
                                                @if (invSlotLevel > 0)
                                                {
                                                    <div class="item-card__qty">+@invSlotLevel</div>
                                                }
                                                <div class="item-card__icon">
                                                    @if (GetEquipmentPictureUrl(eqItemKey) is string eqImg)
                                                    {
                                                        <img src="@CacheBuster.Bust(eqImg)" alt="@item.Name" class="gather-sprite" />
                                                    }
                                                    else
                                                    {
                                                        <i class="bi @item.Icon"></i>
                                                    }
                                                </div>
                                                <div class="item-card__name" style="font-size: 0.55rem;">@item.Name</div>
                                            </div>
                                        }
                                    }

                                    @{
                                        var equipEmpty = Math.Max(0, EquipablePageSize - pagedItems.Count);
                                        for (var i = 0; i < equipEmpty; i++)
                                        {
                                            <div class="item-card item-card--empty"></div>
                                        }
                                    }
                                </div>
                                @if (totalEquipablePages > 1)
                                {
                                    <div class="d-flex justify-content-center align-items-center gap-2 mt-2" style="font-size: 0.75rem;">
                                        <button class="btn btn-sm btn-outline-secondary py-0 px-1" disabled="@(equipablePage <= 1)" @onclick="() => equipablePage--">
                                            <i class="bi bi-chevron-left"></i>
                                        </button>
                                        <span>@equipablePage / @totalEquipablePages</span>
                                        <button class="btn btn-sm btn-outline-secondary py-0 px-1" disabled="@(equipablePage >= totalEquipablePages)" @onclick="() => equipablePage++">
                                            <i class="bi bi-chevron-right"></i>
                                        </button>
                                    </div>
                                }
                                @if (equipableItems.Count > 0)
                                {
                                    <div class="d-flex justify-content-center mt-2">
                                        <button class="btn btn-outline-danger btn-sm" @onclick="() => showDiscardAllConfirm = true" disabled="@discardingAll">
                                            @if (discardingAll)
                                            {
                                                <span class="spinner-border spinner-border-sm me-1"></span>
                                            }
                                            <i class="bi bi-trash me-1"></i>Descartar Tudo (@equipableItems.Count itens)
                                        </button>
                                    </div>
                                }

                                <ConfirmDialog Show="@showDiscardAllConfirm"
                                               ShowChanged="@((bool v) => showDiscardAllConfirm = v)"
                                               Title="Descartar Tudo"
                                               Message="Tens a certeza que queres descartar todos os itens equipáveis e armas não equipadas? Esta ação é irreversível."
                                               ConfirmText="Descartar Tudo"
                                               CancelText="Cancelar"
                                               ConfirmButtonClass="btn-danger"
                                               Disabled="@discardingAll"
                                               OnConfirm="ExecuteDiscardAll"
                                               OnCancel="() => showDiscardAllConfirm = false" />
                            }
                        }
                    </div>
                </div>
            </div>

            <!-- Character Summary Card -->
            <div class="col-lg-4 order-1">
                <div class="card h-100">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="bi bi-person me-2"></i>Personagem</h5>
                    </div>
                    <div class="card-body">
                        <!-- Nickname -->
                        <h5 class="text-center mb-2" style="font-weight: 700;">@(currentUser?.Nickname ?? "Personagem")</h5>

                        <!-- HP Bar (above character sprite) -->
                        @{
                            var currentHP = character!.CurrentHP ?? GetDisplayMaxHP(character);
                            var displayMaxHP = GetDisplayMaxHP(character);
                            var hpProgress = displayMaxHP > 0 ? Math.Min(100, (currentHP * 100.0 / displayMaxHP)) : 0;
                        }
                        <div class="xp-bar-container mb-3">
                            <div class="xp-bar-bg">
                                <div class="xp-bar-fill hp-bar-fill" 
                                     style="width: @(hpProgress.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%"
                                     role="progressbar" 
                                     aria-valuenow="@currentHP" 
                                     aria-valuemin="0" 
                                     aria-valuemax="@displayMaxHP">
                                </div>
                            </div>
                            <div class="xp-bar-text">
                                <span class="xp-current">HP: @Fmt(currentHP)</span>
                                <span class="xp-separator">/</span>
                                <span class="xp-max">@Fmt(displayMaxHP)</span>
                            </div>
                        </div>
                        
                        <!-- Character Sprite -->
                        <div class="text-center mb-3">
                            <img src="@CacheBuster.Bust(PlayerSpritePath)" 
                                 alt="My Tuno Character" 
                                 class="character-sprite img-fluid @(character.ShotBuffBattlesRemaining > 0 ? "shot-buff-aura" : "")"
                                 style="max-height: 200px; max-width: 100%; object-fit: contain;" />
                        </div>
                        
                        <div class="mb-3">
                            <h4 class="text-center mb-3">Nível @character.Level</h4>
                            @{
                                var xpForNextLevel = RTUB.Core.Entities.Character.XpForLevel(character.Level);
                                var xpProgress = xpForNextLevel > 0 ? Math.Min(100, (character.XP * 100.0 / xpForNextLevel)) : 0;
                            }
                            <!-- XP Bar matching Profile.razor style -->
                            <div class="xp-bar-container">
                                <div class="xp-bar-bg">
                                    <div class="xp-bar-fill" 
                                         style="width: @(xpProgress.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%"
                                         role="progressbar" 
                                         aria-valuenow="@character.XP" 
                                         aria-valuemin="0" 
                                         aria-valuemax="@xpForNextLevel">
                                    </div>
                                </div>
                                <div class="xp-bar-text">
                                    <span class="xp-current">@Fmt(character.XP) XP</span>
                                    <span class="xp-separator">/</span>
                                    <span class="xp-max">@Fmt(xpForNextLevel) XP</span>
                                </div>
                            </div>
                        </div>
                        <hr />
                        
                        <!-- Stat Tiles Grid -->
                        @{
                            var hasEnhancementHP = character.ShotBuffBattlesRemaining > 0;
                            var hasEnhancement = character.ShotBuffBattlesRemaining > 0;
                            var shotPct = $"+{(int)((character.EffectiveShotBuffMultiplier - 1) * 100)}% (Shot)";
                        }
                        <div class="ftile-grid ftile-grid--3col">
                            <FantasyTile Icon="bi-heart-fill" Label="HP" Value="@($"{Fmt(currentHP)}/{Fmt(displayMaxHP)}")"
                                         Color="red" Size="md" Highlighted="@hasEnhancementHP"
                                         Tooltip="@(hasEnhancementHP ? shotPct : "")" />
                            <FantasyTile Icon="bi-lightning-fill" Label="Poder" Value="@Fmt(character.GetDisplayTotalPower())"
                                         Color="green" Size="md" Highlighted="@hasEnhancement"
                                         Tooltip="@(hasEnhancement ? shotPct : "")" />
                            <FantasyTile Icon="bi-shield-fill" Label="Defesa" Value="@Fmt(character.GetDisplayTotalDefense())"
                                         Color="gray" Size="md" Highlighted="@hasEnhancement"
                                         Tooltip="@(hasEnhancement ? shotPct : "")" />
                            <FantasyTile Icon="bi-speedometer2" Label="Velocidade" Value="@($"{character.ActionTime:F1}s")"
                                         Color="blue" Size="md" />
                            <FantasyTile Icon="bi-bullseye" Label="Crítico" Value="@($"{character.TotalCriticalChance * 100:F1}%")"
                                         Color="yellow" Size="md" />
                        </div>
                        
                        <!-- Active Enhancements Section -->
                        @if (character.ShotBuffBattlesRemaining > 0 || character.CigarroShieldHitsRemaining > 0 || character.HasCanhaoBuff || character.HasPenaltyBuff)
                        {
                            <div class="mt-3">
                                <h6 class="text-info mb-2"><i class="bi bi-magic me-2"></i>Melhorias Ativas</h6>
                                @if (character.ShotBuffBattlesRemaining > 0)
                                {
                                    <div class="p-2 border border-info rounded d-flex justify-content-between align-items-center mb-2" style="background-color: #1e1e1e;">
                                        <span class="d-flex align-items-center">
                                            <i class="bi bi-droplet-fill text-info me-2"></i>
                                            <span>Shot (+@((int)((character.EffectiveShotBuffMultiplier - 1) * 100))% stats)</span>
                                        </span>
                                        <span class="badge bg-info">Ativo @character.ShotBuffBattlesRemaining @(character.ShotBuffBattlesRemaining == 1 ? "charge" : "charges")</span>
                                    </div>
                                }
                                @if (character.CigarroShieldHitsRemaining > 0)
                                {
                                    <div class="p-2 border border-info rounded d-flex justify-content-between align-items-center mb-2" style="background-color: #1e1e1e;">
                                        <span class="d-flex align-items-center">
                                            <i class="bi bi-wind text-info me-2"></i>
                                            <span>Cigarro (Dodge)</span>
                                        </span>
                                        <span class="badge bg-info">@((int)(character.EffectiveCigarroDodgeChance * 100))% Dodge @character.CigarroShieldHitsRemaining runs</span>
                                    </div>
                                }
                                @if (character.HasCanhaoBuff)
                                {
                                    <div class="p-2 border border-info rounded d-flex justify-content-between align-items-center mb-2" style="background-color: #1e1e1e;">
                                        <span class="d-flex align-items-center">
                                            <i class="bi bi-bullseye text-info me-2"></i>
                                            <span>Canhão (AOE)</span>
                                        </span>
                                        <span class="badge bg-info">@character.CanhaoBuffRemainingFormatted restantes</span>
                                    </div>
                                }
                                @if (character.HasPenaltyBuff)
                                {
                                    <div class="p-2 border border-info rounded d-flex justify-content-between align-items-center mb-2" style="background-color: #1e1e1e;">
                                        <span class="d-flex align-items-center">
                                            <i class="bi bi-lightning-charge-fill text-info me-2"></i>
                                            <span>Penalty — Lifesteal @((character.EffectivePenaltyLifesteal * 100).ToString("F1"))% HP por hit</span>
                                        </span>
                                        <span class="badge bg-info">@character.PenaltyBuffRemainingFormatted restantes</span>
                                    </div>
                                }
                            </div>
                        }
                        
                        @if (currentHP <= 0)
                        {
                            <div class="alert alert-warning mt-3 mb-3" role="alert">
                                <i class="bi bi-exclamation-triangle me-2"></i>
                                <strong>Personagem derrotado!</strong> Usa cervejas <i class="bi bi-cup-straw"></i> para recuperar HP.
                            </div>
                        }
                        
                        <hr />
                        <div class="ftile-grid ftile-grid--2col">
                            <FantasyTile Icon="bi-trophy" Label="Arena" Color="blue" Size="lg"
                                         Clickable="true" OnClick="@NavigateToArena" />
                            <FantasyTile Icon="bi-layers" Label="Floors" Color="green" Size="lg"
                                         Clickable="true" OnClick="@OpenStageModal" />
                            <FantasyTile Icon="bi-lightning-fill" Label="Boss Mode" Color="gold" Size="lg"
                                         Clickable="true" OnClick="@OpenBossModeModal" />
                            <AuthorizeView Roles="Owner">
                                <Authorized>
                                    <FantasyTile Icon="bi-bullseye" Label="Survive" Color="red" Size="lg"
                                                 Clickable="true" OnClick="@OpenSurviveModeModal" />
                                </Authorized>
                                <NotAuthorized>
                                    <FantasyTile Icon="bi-bullseye" Label="Survive" Color="red" Size="lg"
                                                 Disabled="true" Tooltip="Soon..." />
                                </NotAuthorized>
                            </AuthorizeView>
                        </div>
                    </div>
                </div>
            </div>


            <!-- Equipment Section -->
            <div class="col-lg-4 order-2">
                <div class="card h-100">
                    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="bi bi-shield-shaded me-2"></i>Equipamento</h5>
                    </div>
                    <div class="card-body p-2 d-flex flex-column">
                        @* Equipment Bonus Bar — Fidelis-bar style *@
                        @if (character!.EquipmentHPBonus > 0 || character.EquipmentPowerBonus > 0 || character.EquipmentDefenseBonus > 0)
                        {
                            <div class="equip-bonus-bar">
                                <div class="equip-bonus-bar__inner">
                                    @if (character.EquipmentHPBonus > 0)
                                    {
                                        <div class="equip-bonus-bar__stat">
                                            <span class="equip-bonus-bar__label">HP</span>
                                            <span class="equip-bonus-bar__value text-danger">+@Fmt(character.EquipmentHPBonus)</span>
                                        </div>
                                    }
                                    @if (character.EquipmentPowerBonus > 0)
                                    {
                                        <div class="equip-bonus-bar__stat">
                                            <span class="equip-bonus-bar__label">Poder</span>
                                            <span class="equip-bonus-bar__value text-success">+@Fmt(character.EquipmentPowerBonus)</span>
                                        </div>
                                    }
                                    @if (character.EquipmentDefenseBonus > 0)
                                    {
                                        <div class="equip-bonus-bar__stat">
                                            <span class="equip-bonus-bar__label">Def</span>
                                            <span class="equip-bonus-bar__value" style="color: #adb5bd;">+@Fmt(character.EquipmentDefenseBonus)</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        @* Rare Set Progress Indicator *@
                        @if (character.RareSetPiecesApplied > 0)
                        {
                            <div class="equip-bonus-bar" style="@(character.HasRareSetBonus ? "border-color: #ffd700; box-shadow: 0 0 8px #ffd70066;" : "")">
                                <div class="equip-bonus-bar__inner">
                                    <div class="equip-bonus-bar__stat">
                                        <span class="equip-bonus-bar__label" style="color: #ffd700;">
                                            <i class="bi bi-gem"></i> Rare Set
                                        </span>
                                        <span class="equip-bonus-bar__value" style="color: #ffd700;">
                                            @character.RareSetPiecesApplied/6
                                        </span>
                                    </div>
                                    @if (character.HasRareSetBonus)
                                    {
                                        <div class="equip-bonus-bar__stat">
                                            <span class="equip-bonus-bar__label" style="color: #ffd700;">SET BONUS</span>
                                            <span class="equip-bonus-bar__value" style="color: #ffd700;">+50% CRIT, -0.5s SPD</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="equip-bonus-bar__stat">
                                            <span class="equip-bonus-bar__label" style="color: #c0a040;">Crit</span>
                                            <span class="equip-bonus-bar__value" style="color: #c0a040;">+@((character.RareSetPiecesApplied * 5))%</span>
                                        </div>
                                        <div class="equip-bonus-bar__stat">
                                            <span class="equip-bonus-bar__label" style="color: #c0a040;">Spd</span>
                                            <span class="equip-bonus-bar__value" style="color: #c0a040;">-@((character.RareSetPiecesApplied * 0.05).ToString("F2"))s</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <div class="equip-layout">
                            <!-- Left slots (Head, Shoulders, Chest) -->
                            <div class="equip-layout__side">
                                @{ var headLevel = GetSlotEnhancementLevel(EquipmentSlot.Head); }
                                <div class="equip-slot equip-slot--filled @(character.RareHeadApplied ? "equip-slot--rare" : "")" title="HEAD — Clica para upgrade"
                                     @onclick="() => OnEquipSlotClick(InventoryItemType.EquipmentHead)"
                                     style="cursor: pointer">
                                    @if (headLevel > 0)
                                    {
                                        <div class="equip-slot__level">+@headLevel</div>
                                    }
                                    @if (GetEquipmentPictureUrl(InventoryItemType.EquipmentHead) is string headImg)
                                    {
                                        <img src="@CacheBuster.Bust(headImg)" alt="Head" class="gather-sprite" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-shield-shaded"></i>
                                    }
                                    @if (character.RareHeadApplied)
                                    {
                                        <div class="equip-slot__rare-badge" title="Rare Upgrade Applied"><i class="bi bi-gem"></i></div>
                                    }
                                    <span class="equip-slot__label">@GetSlotLabel(EquipmentSlot.Head)</span>
                                </div>

                                @{ var shouldersLevel = GetSlotEnhancementLevel(EquipmentSlot.Shoulders); }
                                <div class="equip-slot equip-slot--filled @(character.RareShouldersApplied ? "equip-slot--rare" : "")" title="SHOULDERS — Clica para upgrade"
                                     @onclick="() => OnEquipSlotClick(InventoryItemType.EquipmentShoulders)"
                                     style="cursor: pointer">
                                    @if (shouldersLevel > 0)
                                    {
                                        <div class="equip-slot__level">+@shouldersLevel</div>
                                    }
                                    @if (GetEquipmentPictureUrl(InventoryItemType.EquipmentShoulders) is string shouldersImg)
                                    {
                                        <img src="@CacheBuster.Bust(shouldersImg)" alt="Shoulders" class="gather-sprite" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-shield-shaded"></i>
                                    }
                                    @if (character.RareShouldersApplied)
                                    {
                                        <div class="equip-slot__rare-badge" title="Rare Upgrade Applied"><i class="bi bi-gem"></i></div>
                                    }
                                    <span class="equip-slot__label">@GetSlotLabel(EquipmentSlot.Shoulders)</span>
                                </div>

                                @{ var chestLevel = GetSlotEnhancementLevel(EquipmentSlot.Chest); }
                                <div class="equip-slot equip-slot--filled @(character.RareChestApplied ? "equip-slot--rare" : "")" title="CHEST — Clica para upgrade"
                                     @onclick="() => OnEquipSlotClick(InventoryItemType.EquipmentChest)"
                                     style="cursor: pointer">
                                    @if (chestLevel > 0)
                                    {
                                        <div class="equip-slot__level">+@chestLevel</div>
                                    }
                                    @if (GetEquipmentPictureUrl(InventoryItemType.EquipmentChest) is string chestImg)
                                    {
                                        <img src="@CacheBuster.Bust(chestImg)" alt="Chest" class="gather-sprite" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-shield-shaded"></i>
                                    }
                                    @if (character.RareChestApplied)
                                    {
                                        <div class="equip-slot__rare-badge" title="Rare Upgrade Applied"><i class="bi bi-gem"></i></div>
                                    }
                                    <span class="equip-slot__label">@GetSlotLabel(EquipmentSlot.Chest)</span>
                                </div>
                            </div>

                            <!-- Center character -->
                            <div class="equip-layout__center">
                                <img src="@CacheBuster.Bust(PlayerSpritePath)" 
                                     alt="Equipment Preview" 
                                     class="equip-layout__sprite" />
                            </div>

                            <!-- Right slots (Gloves, Legs, Boots) -->
                            <div class="equip-layout__side">
                                @{ var glovesLevel = GetSlotEnhancementLevel(EquipmentSlot.Gloves); }
                                <div class="equip-slot equip-slot--filled @(character.RareGlovesApplied ? "equip-slot--rare" : "")" title="GLOVES — Clica para upgrade"
                                     @onclick="() => OnEquipSlotClick(InventoryItemType.EquipmentGloves)"
                                     style="cursor: pointer">
                                    @if (glovesLevel > 0)
                                    {
                                        <div class="equip-slot__level">+@glovesLevel</div>
                                    }
                                    @if (GetEquipmentPictureUrl(InventoryItemType.EquipmentGloves) is string glovesImg)
                                    {
                                        <img src="@CacheBuster.Bust(glovesImg)" alt="Gloves" class="gather-sprite" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-shield-shaded"></i>
                                    }
                                    @if (character.RareGlovesApplied)
                                    {
                                        <div class="equip-slot__rare-badge" title="Rare Upgrade Applied"><i class="bi bi-gem"></i></div>
                                    }
                                    <span class="equip-slot__label">@GetSlotLabel(EquipmentSlot.Gloves)</span>
                                </div>

                                @{ var legsLevel = GetSlotEnhancementLevel(EquipmentSlot.Legs); }
                                <div class="equip-slot equip-slot--filled @(character.RareLegsApplied ? "equip-slot--rare" : "")" title="LEGS — Clica para upgrade"
                                     @onclick="() => OnEquipSlotClick(InventoryItemType.EquipmentLegs)"
                                     style="cursor: pointer">
                                    @if (legsLevel > 0)
                                    {
                                        <div class="equip-slot__level">+@legsLevel</div>
                                    }
                                    @if (GetEquipmentPictureUrl(InventoryItemType.EquipmentLegs) is string legsImg)
                                    {
                                        <img src="@CacheBuster.Bust(legsImg)" alt="Legs" class="gather-sprite" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-shield-shaded"></i>
                                    }
                                    @if (character.RareLegsApplied)
                                    {
                                        <div class="equip-slot__rare-badge" title="Rare Upgrade Applied"><i class="bi bi-gem"></i></div>
                                    }
                                    <span class="equip-slot__label">@GetSlotLabel(EquipmentSlot.Legs)</span>
                                </div>

                                @{ var bootsLevel = GetSlotEnhancementLevel(EquipmentSlot.Boots); }
                                <div class="equip-slot equip-slot--filled @(character.RareBootsApplied ? "equip-slot--rare" : "")" title="BOOTS — Clica para upgrade"
                                     @onclick="() => OnEquipSlotClick(InventoryItemType.EquipmentBoots)"
                                     style="cursor: pointer">
                                    @if (bootsLevel > 0)
                                    {
                                        <div class="equip-slot__level">+@bootsLevel</div>
                                    }
                                    @if (GetEquipmentPictureUrl(InventoryItemType.EquipmentBoots) is string bootsImg)
                                    {
                                        <img src="@CacheBuster.Bust(bootsImg)" alt="Boots" class="gather-sprite" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-shield-shaded"></i>
                                    }
                                    @if (character.RareBootsApplied)
                                    {
                                        <div class="equip-slot__rare-badge" title="Rare Upgrade Applied"><i class="bi bi-gem"></i></div>
                                    }
                                    <span class="equip-slot__label">@GetSlotLabel(EquipmentSlot.Boots)</span>
                                </div>
                            </div>
                        </div>

                        <!-- Weapon slots (Forged Weapons) below character -->
                        <div class="equip-weapons">
                            @{
                                var weapon1Id = character.EquippedWeapon1;
                                var weapon1 = weapon1Id.HasValue ? forgedWeapons.FirstOrDefault(w => w.Id == weapon1Id.Value) : null;
                                var weapon2Id = character.EquippedWeapon2;
                                var weapon2 = weapon2Id.HasValue ? forgedWeapons.FirstOrDefault(w => w.Id == weapon2Id.Value) : null;
                                var isTwoHanded = weapon1 != null && weapon1.IsTwoHanded;
                            }
                            <div class="equip-slot equip-slot--weapon @(weapon1 != null ? "equip-slot--filled" : "")" 
                                 title="@(weapon1 != null ? weapon1.Name + " — Clica para desequipar" : "Arma 1")"
                                 @onclick="() => OnWeaponSlotClick(1)"
                                 style="cursor: @(weapon1 != null ? "pointer" : "default")">
                                @if (weapon1 != null)
                                {
                                    if (GetForgedWeaponPictureUrl(weapon1) is string w1Img)
                                    {
                                        <img src="@CacheBuster.Bust(w1Img)" alt="@weapon1.Name" class="gather-sprite" />
                                    }
                                    else
                                    {
                                        <i class="bi @WeaponTypeHelper.GetIcon(weapon1.WeaponType)"></i>
                                    }
                                }
                                else
                                {
                                    <i class="bi bi-slash-lg"></i>
                                }
                                <span class="equip-slot__label">@(weapon1?.Name ?? "Arma 1")@if (weapon1?.Level > 0) { <span class="badge bg-warning text-dark ms-1" style="font-size: 0.5rem;">+@weapon1.Level</span> }</span>
                            </div>
                            @if (!isTwoHanded)
                            {
                                <div class="equip-slot equip-slot--weapon @(weapon2 != null ? "equip-slot--filled" : "")" 
                                     title="@(weapon2 != null ? weapon2.Name + " — Clica para desequipar" : "Arma 2")"
                                     @onclick="() => OnWeaponSlotClick(2)"
                                     style="cursor: @(weapon2 != null ? "pointer" : "default")">
                                    @if (weapon2 != null)
                                    {
                                        if (GetForgedWeaponPictureUrl(weapon2) is string w2Img)
                                        {
                                            <img src="@CacheBuster.Bust(w2Img)" alt="@weapon2.Name" class="gather-sprite" />
                                        }
                                        else
                                        {
                                            <i class="bi @WeaponTypeHelper.GetIcon(weapon2.WeaponType)"></i>
                                        }
                                    }
                                    else
                                    {
                                        <i class="bi bi-slash-lg"></i>
                                    }
                                    <span class="equip-slot__label">@(weapon2?.Name ?? "Arma 2")@if (weapon2?.Level > 0) { <span class="badge bg-warning text-dark ms-1" style="font-size: 0.5rem;">+@weapon2.Level</span> }</span>
                                </div>
                            }
                        </div>

                    </div>
                </div>
            </div>

            <!-- Destilaria (Resource Gathering) -->
            <div class="col-lg-4 order-4">
                <div class="card h-100">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="bi bi-moisture me-2"></i>Destilaria</h5>
                    </div>
                    <div class="card-body p-3 d-flex flex-column">
                        <!-- Energy Bar -->
                        <div class="energy-bar mb-3">
                            <div class="energy-bar__header">
                                <span class="energy-bar__label"><i class="bi bi-lightning-charge-fill me-1"></i>Energia</span>
                                <span class="energy-bar__value">@currentEnergy / @maxEnergy</span>
                            </div>
                            <div class="energy-bar__track">
                                <div class="energy-bar__fill" style="width: @(maxEnergy > 0 ? (int)(100.0 * currentEnergy / maxEnergy) : 0)%"></div>
                            </div>
                            @if (currentEnergy < maxEnergy)
                            {
                                <div class="energy-bar__regen">
                                    <i class="bi bi-arrow-repeat me-1"></i>+1 / @((int)character!.EffectiveRegenInterval)s
                                </div>
                            }
                        </div>

                        <!-- Cast Bar (shown during gathering) -->
                        @if (gathering != null)
                        {
                            <div class="cast-bar mb-3">
                                <div class="cast-bar__header">
                                    <span class="cast-bar__label">A destilar @GetResourceName(gathering.Value)...</span>
                                    <span class="cast-bar__time">@castTimeRemaining.ToString("F1")s</span>
                                </div>
                                <div class="cast-bar__track">
                                    <div class="cast-bar__fill" style="width: @((int)(100.0 * castProgress))%; transition: width 0.1s linear;"></div>
                                </div>
                            </div>
                        }

                        <!-- Double Gathering Flash Effect -->
                        @if (doubleGatherTriggered)
                        {
                            <div class="double-gather-flash">
                                <div class="double-gather-flash__icon">🔥</div>
                                <div class="double-gather-flash__text">DESTILAÇÃO DUPLA!</div>
                            </div>
                        }

                        <!-- Double Gathering Chance (if upgraded) -->
                        @if (character?.DoubleGatheringChance > 0)
                        {
                            <div class="text-center mb-2" style="font-size: 0.75rem; color: #ff9500;">
                                <i class="bi bi-fire me-1"></i> @((character.DoubleGatheringChance * 100).ToString("F0"))% chance dupla
                            </div>
                        }

                        <!-- Resource Nodes -->
                        <div class="gather-grid">
                            @{
                                var allResources = gatheringConfig.Resources.Where(r => r.IsActive).ToList();
                                var highestStageReached = stageProgress?.HighestStage ?? 1;
                            }
                            @foreach (var res in allResources)
                            {
                                var resType = Enum.Parse<InventoryItemType>(res.Type);
                                var cssModifier = res.Type.ToLower();
                                var isLocked = res.UnlockStage > highestStageReached;
                                var isDisabled = isLocked || currentEnergy < res.EnergyCost || gathering != null;
                                var unlockBiome = isLocked ? MyTunoConfig.Value.StageMode.Biomes.FirstOrDefault(b => b.StageMin <= res.UnlockStage && b.StageMax >= res.UnlockStage) : null;
                                <div class="gather-node gather-node--@cssModifier @(gathering == resType ? "gather-node--active" : "") @(isDisabled ? "gather-node--disabled" : "") @(isLocked ? "gather-node--locked" : "")"
                                     @onclick="async () => { if (!isLocked) await GatherResource(resType); }"
                                     title="@(isLocked ? $"{res.Name} — Desbloqueia no Floor {res.UnlockStage} ({unlockBiome?.Name ?? "?"})" : $"{res.Name} — {res.EnergyCost} Energia")">
                                    <div class="gather-node__cost">
                                        @if (isLocked)
                                        {
                                            <i class="bi bi-lock-fill"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-lightning-charge-fill"></i>@res.EnergyCost
                                        }
                                    </div>
                                    <div class="gather-node__icon">
                                        @if (isLocked)
                                        {
                                            <i class="bi bi-lock-fill" style="opacity: 0.4;"></i>
                                        }
                                        else if (gathering == resType)
                                        {
                                            <span class="spinner-border spinner-border-sm"></span>
                                        }
                                        else
                                        {
                                            if (GetDrinkPictureUrl(res.Type) is string gatherDrinkImg)
                                            {
                                                <img src="@CacheBuster.Bust(gatherDrinkImg)" alt="@res.Name" class="gather-sprite" />
                                            }
                                            else if (!string.IsNullOrEmpty(res.SpritePath))
                                            {
                                                <img src="@CacheBuster.Bust(res.SpritePath)" alt="@res.Name" class="gather-sprite" />
                                            }
                                            else
                                            {
                                                <i class="bi @res.Icon"></i>
                                            }
                                        }
                                    </div>
                                    <div class="gather-node__name">@res.Name</div>
                                    @if (isLocked)
                                    {
                                        <div class="gather-node__qty" style="font-size: 0.6rem; opacity: 0.6;">@(unlockBiome?.Name ?? $"Floor {res.UnlockStage}")</div>
                                    }
                                    else
                                    {
                                        <div class="gather-node__qty">@GetResourceQuantity(resType)</div>
                                    }
                                </div>
                            }
                        </div>

                        <div class="text-center mt-auto pt-2">
                            <small class="text-muted" style="font-size: 0.7rem;">Recolhe recursos para craft!</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Forging Section -->
            <div class="col-lg-4 order-5">
                <div class="card h-100">
                    <div class="card-header text-white" style="background-color: #6f42c1;">
                        <h5 class="mb-0"><i class="bi bi-hammer me-2"></i>Forge & Shop</h5>
                    </div>
                    <div class="card-body p-3 d-flex flex-column">
                        <!-- Purple toggle tabs (same pattern as Upgrades) -->
                        <div class="d-flex gap-1 mb-3">
                            <button class="btn btn-sm flex-fill @(forgeShopTab == 0 ? "" : "btn-outline-secondary")"
                                    style="@(forgeShopTab == 0 ? "background-color: #6f42c1; border-color: #6f42c1; color: white;" : "")"
                                    @onclick="() => forgeShopTab = 0">
                                <i class="bi bi-hammer me-1"></i>Forge
                            </button>
                            <button class="btn btn-sm flex-fill @(forgeShopTab == 1 ? "" : "btn-outline-secondary")"
                                    style="@(forgeShopTab == 1 ? "background-color: #6f42c1; border-color: #6f42c1; color: white;" : "")"
                                    @onclick="() => forgeShopTab = 1">
                                <i class="bi bi-shop me-1"></i>Shop
                            </button>
                        </div>

                        @{
                            var forgeDrinkResource = forgeDrink.HasValue
                                ? activeResources.FirstOrDefault(r => r.Type == forgeDrink.Value.ToString())
                                : null;
                            var forgeDrinkQtyNeeded = forgeDrinkResource?.ForgeCost ?? 1;
                            var forgeDrinkQtyHave = forgeDrink.HasValue ? GetResourceQuantity(forgeDrink.Value) : 0;
                            var forgeCanAfford = forgeDrinkQtyHave >= forgeDrinkQtyNeeded;
                        }

                        @if (forgeShopTab == 0)
                        {
                        <p class="text-muted mb-3" style="font-size: 0.75rem;">Combina um instrumento com uma bebida para forjar uma arma!</p>

                        <!-- Forge Slots -->
                        <div class="forge-slots mb-3">
                            <!-- Instrument Slot -->
                            <div class="forge-slot @(forgeInstrument.HasValue ? "forge-slot--filled" : "")"
                                 @onclick="ToggleForgeInstrumentPicker"
                                 title="@(forgeInstrument.HasValue ? GetEquipItemDisplayName(forgeInstrument.Value) : "Escolher instrumento")">
                                @if (forgeInstrument.HasValue)
                                {
                                    var fInstrType = InstrumentTypeHelper.FromInventoryPartType(forgeInstrument.Value);
                                    var fInstrImg = fInstrType.HasValue && instrumentImages.TryGetValue(fInstrType.Value, out var fUrl) ? fUrl : null;
                                    @if (!string.IsNullOrEmpty(fInstrImg))
                                    {
                                        <img src="@CacheBuster.Bust(fInstrImg)" alt="Instrumento" class="forge-slot__img" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-music-note-beamed"></i>
                                    }
                                    <span class="forge-slot__label" style="font-size: 0.55rem;">@GetEquipItemDisplayName(forgeInstrument.Value)</span>
                                }
                                else
                                {
                                    <i class="bi bi-music-note-beamed" style="opacity: 0.4;"></i>
                                    <span class="forge-slot__label">Instrumento</span>
                                }
                            </div>

                            <div class="forge-plus"><i class="bi bi-plus-lg"></i></div>

                            <!-- Drink Slot -->
                            <div class="forge-slot @(forgeDrink.HasValue ? "forge-slot--filled" : "")"
                                 @onclick="ToggleForgeDrinkPicker"
                                 title="@(forgeDrink.HasValue ? GetResourceName(forgeDrink.Value) : "Escolher bebida")">
                                @if (forgeDrink.HasValue)
                                {
                                    var drinkRes = activeResources.FirstOrDefault(r => r.Type == forgeDrink.Value.ToString());
                                    if (GetDrinkPictureUrl(forgeDrink.Value) is string forgeDrinkImg)
                                    {
                                        <img src="@CacheBuster.Bust(forgeDrinkImg)" alt="@GetResourceName(forgeDrink.Value)" class="gather-sprite" />
                                    }
                                    else
                                    {
                                        <i class="bi @(drinkRes?.Icon ?? "bi-droplet")"></i>
                                    }
                                    <span class="forge-slot__label" style="font-size: 0.55rem;">@GetResourceName(forgeDrink.Value)</span>
                                }
                                else
                                {
                                    <i class="bi bi-cup-straw" style="opacity: 0.4;"></i>
                                    <span class="forge-slot__label">Bebida</span>
                                }
                            </div>
                        </div>

                        <!-- Instrument Picker -->
                        @if (showForgeInstrumentPicker)
                        {
                            <div class="forge-picker mb-2">
                                @foreach (var kvp in instrumentParts)
                                {
                                    var pickInstrType = InstrumentTypeHelper.FromInventoryPartType(kvp.Key);
                                    var pickInstrName = pickInstrType.HasValue ? InstrumentTypeHelper.GetDisplayName(pickInstrType.Value) : kvp.Key.ToString();
                                    var pickKey = kvp.Key;
                                    <button class="forge-picker__item @(forgeInstrument == pickKey ? "forge-picker__item--selected" : "")"
                                            @onclick="() => SelectForgeInstrument(pickKey)">
                                        <i class="bi bi-music-note-beamed me-1"></i>@pickInstrName <span class="badge bg-dark">@kvp.Value</span>
                                    </button>
                                }
                                @if (!instrumentParts.Any())
                                {
                                    <small class="text-muted">Sem instrumentos no inventário.</small>
                                }
                            </div>
                        }

                        <!-- Drink Picker -->
                        @if (showForgeDrinkPicker)
                        {
                            <div class="forge-picker mb-2">
                                @foreach (var res in activeResources)
                                {
                                    var resType = Enum.Parse<InventoryItemType>(res.Type);
                                    var resQty = GetResourceQuantity(resType);
                                    var resForgeCost = res.ForgeCost > 0 ? res.ForgeCost : 1;
                                    if (resQty <= 0) continue;
                                    var canForgeWithThis = resQty >= resForgeCost;
                                    <button class="forge-picker__item @(forgeDrink == resType ? "forge-picker__item--selected" : "") @(!canForgeWithThis ? "opacity-50" : "")"
                                            @onclick="() => SelectForgeDrink(resType)">
                                        @if (GetDrinkPictureUrl(res.Type) is string pickerDrinkImg)
                                        {
                                            <img src="@CacheBuster.Bust(pickerDrinkImg)" alt="@res.Name" class="gather-sprite" style="width: 16px; height: 16px; vertical-align: middle;" />
                                        }
                                        else
                                        {
                                            <i class="bi @res.Icon me-1"></i>
                                        }
                                        @res.Name <span class="badge bg-dark">@resQty</span>
                                        @if (resForgeCost > 1) { <span class="badge bg-info bg-opacity-50 ms-1" style="font-size: 0.6rem;">@(resForgeCost)x</span> }
                                    </button>
                                }
                                @if (!activeResources.Any(r => GetResourceQuantity(Enum.Parse<InventoryItemType>(r.Type)) > 0))
                                {
                                    <small class="text-muted">Sem bebidas no inventário.</small>
                                }
                            </div>
                        }

                        <!-- Forge Cast Bar -->
                        @if (forging)
                        {
                            <div class="cast-bar mb-3">
                                <div class="cast-bar__header">
                                    <span class="cast-bar__label">A forjar arma...</span>
                                    <span class="cast-bar__time">@forgeCastTimeRemaining.ToString("F1")s</span>
                                </div>
                                <div class="cast-bar__track">
                                    <div class="cast-bar__fill" style="width: @((int)(100.0 * forgeCastProgress))%; transition: width 0.1s linear;"></div>
                                </div>
                            </div>
                        }

                        <!-- Forge Button -->
                        <div class="d-flex gap-2 flex-wrap justify-content-center mb-3">
                            <FantasyTile Icon="bi-hammer"
                                         Label="Forjar Arma"
                                         Value="@(forgeDrink.HasValue && forgeDrinkQtyNeeded > 1 ? $"{forgeDrinkQtyNeeded}× {forgeDrinkResource?.Name ?? "bebida"}" : "")"
                                         Color="gold"
                                         Clickable="true"
                                         Disabled="@(!forgeInstrument.HasValue || !forgeDrink.HasValue || !forgeCanAfford || forging)"
                                         Insufficient="@(forgeDrink.HasValue && !forgeCanAfford)"
                                         OnClick="StartForge" />

                            <FantasyTile Icon="bi-backpack2-fill"
                                         Label="Armas Forjadas"
                                         Value="@forgedWeapons.Count.ToString()"
                                         Color="purple"
                                         Clickable="true"
                                         OnClick="@(() => showWeaponsListModal = true)" />
                        </div>
                        }
                        @if (forgeShopTab == 1)
                        {
                        <div class="d-flex flex-column gap-2">
                            <div class="enhance-row">
                                <div class="enhance-row__icon" style="background: linear-gradient(135deg, #e67e22, #d35400); color: #fff;">
                                    <span style="font-size: 1.1rem;">🐷</span>
                                </div>
                                <div class="enhance-row__info">
                                    <div class="enhance-row__title">Leitão</div>
                                    <div class="enhance-row__desc">Troca 25 FITAB por 1 Leitão</div>
                                    <div class="enhance-row__stat">
                                        FITAB: <span class="@(fitabQuantity >= 25 ? "text-success" : "text-danger")">@fitabQuantity</span> / 25
                                        &nbsp;|&nbsp; 🐷 @leitaoQuantity
                                    </div>
                                </div>
                                <div class="enhance-row__action">
                                    <button class="btn enhance-row__btn"
                                            style="background: linear-gradient(180deg, #e67e22, #d35400, #b8450a); border-color: rgba(230, 126, 34, 0.4);"
                                            @onclick="BuyLeitaoWithFitab"
                                            disabled="@(buyingLeitao || fitabQuantity < 25)">
                                        @if (buyingLeitao)
                                        {
                                            <span class="spinner-border spinner-border-sm"></span>
                                        }
                                        else
                                        {
                                            <text>Trocar</text>
                                        }
                                    </button>
                                    <div class="enhance-row__cost">
                                        <span style="font-size: 0.7rem;">25 FITAB</span>
                                    </div>
                                </div>
                            </div>


                        </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Upgrades (merged: Stats + Melhorias + Poderes) -->
            <div class="col-lg-4 order-6">
                <div class="card h-100">
                    <div class="card-header text-white" style="background-color: #6f42c1;">
                        <h5 class="mb-0"><i class="bi bi-arrow-up-circle me-2"></i>Upgrades</h5>
                    </div>
                    <div class="card-body p-3 d-flex flex-column">
                        <!-- Purple toggle tabs -->
                        <div class="d-flex gap-1 mb-3">
                            <button class="btn btn-sm flex-fill @(upgradesTab == 0 ? "" : "btn-outline-secondary")"
                                    style="@(upgradesTab == 0 ? "background-color: #6f42c1; border-color: #6f42c1; color: white;" : "")"
                                    @onclick="() => upgradesTab = 0">
                                <i class="bi bi-bar-chart-fill me-1"></i>Stats
                            </button>
                            <button class="btn btn-sm flex-fill @(upgradesTab == 1 ? "" : "btn-outline-secondary")"
                                    style="@(upgradesTab == 1 ? "background-color: #6f42c1; border-color: #6f42c1; color: white;" : "")"
                                    @onclick="() => upgradesTab = 1">
                                <i class="bi bi-lightning-fill me-1"></i>Melhorias
                            </button>
                        </div>

                        <div class="upgrades-embedded">
                        @if (upgradesTab == 0)
                        {
                            <MyTunoUpgradeShop Character="@character"
                                               FidelisBalance="@(currentUser?.FidelisBalance ?? 0)"
                                               LeitaoBalance="@leitaoQuantity"
                                               Purchasing="@purchasing"
                                               PurchasingStat="@purchasingStat"
                                               OnPurchaseRequested="PurchaseUpgrade" />
                        }
                        else if (upgradesTab == 1)
                        {
                            <MyTunoImprovements Character="@character"
                                              FidelisBalance="@(currentUser?.FidelisBalance ?? 0)"
                                              LeitaoBalance="@leitaoQuantity"
                                              Purchasing="@purchasingImprovement"
                                              PurchasingType="@purchasingImprovementType"
                                              OnPurchaseRequested="PurchaseImprovement"
                                              ConsumablePurchasing="@purchasingConsumableUpgrade"
                                              ConsumablePurchasingType="@purchasingConsumableUpgradeType"
                                              OnConsumablePurchaseRequested="PurchaseConsumableUpgrade"
                                              ConsumableImageUrls="@itemTypePictures" />
                        }

                        </div>
                    </div>
                </div>
            </div>

        </div>
    }

    <!-- Forge Weapon Type & Name Modal -->
    @if (showForgeWeaponTypeModal)
    {
        <Modal Show="@showForgeWeaponTypeModal"
               ShowChanged="@((bool show) => { if (!show) CloseForgeWeaponTypeModal(); })"
               Title="Escolher Tipo de Arma"
               Size="Modal.ModalSize.Default"
               Centered="true">
            <BodyContent>
                <div class="text-center mb-3">
                    <i class="bi bi-hammer" style="font-size: 2rem; color: var(--bs-warning);"></i>
                    <p class="text-muted mt-2 mb-3" style="font-size: 0.85rem;">Escolhe o tipo de arma e dá-lhe um nome!</p>
                </div>
                <div class="mb-3">
                    <label class="form-label" style="font-size: 0.8rem;">Tipo de Arma</label>
                    <div class="d-flex flex-wrap gap-2 justify-content-center">
                        @foreach (var wt in WeaponTypeHelper.AllWeaponTypes)
                        {
                            var wtLocal = wt;
                            <button class="btn btn-sm @(selectedForgeWeaponType == wtLocal ? "btn-primary" : "btn-outline-secondary")"
                                    @onclick="() => SelectForgeWeaponType(wtLocal)">
                                @if (GetWeaponPictureUrl(wtLocal) is string forgeWtImg)
                                {
                                    <img src="@CacheBuster.Bust(forgeWtImg)" alt="@WeaponTypeHelper.GetDisplayName(wtLocal)" class="gather-sprite" style="width: 16px; height: 16px; vertical-align: middle;" />
                                }
                                else
                                {
                                    <i class="bi @WeaponTypeHelper.GetIcon(wtLocal) me-1"></i>
                                }
                                @WeaponTypeHelper.GetDisplayName(wtLocal)
                            </button>
                        }
                    </div>
                </div>
                <div class="mb-2">
                    <label class="form-label" style="font-size: 0.8rem;">Nome da Arma</label>
                    <input type="text" class="form-control" maxlength="100" @bind="forgeWeaponName" placeholder="@forgeWeaponDefaultName" />
                </div>
            </BodyContent>
            <FooterContent>
                <button class="btn btn-secondary" @onclick="CloseForgeWeaponTypeModal">
                    <i class="bi bi-arrow-left me-2"></i>Cancelar
                </button>
                <button class="btn btn-warning" @onclick="ConfirmForge" disabled="@(selectedForgeWeaponType == null)">
                    <i class="bi bi-hammer me-2"></i>Forjar!
                </button>
            </FooterContent>
        </Modal>
    }

    <!-- Forge Result Modal -->
    @if (showForgeResultModal && lastForgedWeapon != null)
    {
        <Modal Show="@showForgeResultModal"
               ShowChanged="@((bool show) => { if (!show) showForgeResultModal = false; })"
               Title="Arma Forjada!"
               Size="Modal.ModalSize.Default"
               Centered="true">
            <BodyContent>
                <div class="text-center">
                    <div class="forge-result-icon mb-3">
                        @if (GetForgedWeaponPictureUrl(lastForgedWeapon) is string forgeResultImg)
                        {
                            <img src="@CacheBuster.Bust(forgeResultImg)" alt="@lastForgedWeapon.Name" style="width: 64px; height: 64px; object-fit: contain; filter: drop-shadow(0 0 4px var(--bs-warning));" />
                        }
                        else
                        {
                            <i class="bi @WeaponTypeHelper.GetIcon(lastForgedWeapon.WeaponType)" style="font-size: 3rem; color: var(--bs-warning);"></i>
                        }
                    </div>
                    <h4 class="text-warning mb-2">@lastForgedWeapon.Name</h4>
                    <span class="badge bg-info bg-opacity-25 text-info mb-3">
                        @WeaponTypeHelper.GetDisplayName(lastForgedWeapon.WeaponType)
                    </span>
                    <div class="equip-confirm-stats mt-3">
                        <small class="d-block mb-2" style="color: #aaa; font-size: 0.75rem;"><i class="bi bi-plus-circle me-1"></i>Bónus:</small>
                        <div class="ftile-grid ftile-grid--bonus">
                            @if (lastForgedWeapon.BonusHP > 0) { <FantasyTile Icon="bi-heart-fill" Label="HP" Value="@($"+{Fmt(lastForgedWeapon.BonusHP)}")" Color="red" Size="sm" /> }
                            @if (lastForgedWeapon.BonusPower > 0) { <FantasyTile Icon="bi-lightning-fill" Label="Poder" Value="@($"+{Fmt(lastForgedWeapon.BonusPower)}")" Color="green" Size="sm" /> }
                            @if (lastForgedWeapon.BonusSpeed > 0) { <FantasyTile Icon="bi-speedometer2" Label="Vel" Value="@($"+{Fmt(lastForgedWeapon.BonusSpeed)}")" Color="blue" Size="sm" /> }
                            @if (lastForgedWeapon.BonusDefense > 0) { <FantasyTile Icon="bi-shield-fill" Label="Def" Value="@($"+{Fmt(lastForgedWeapon.BonusDefense)}")" Color="gray" Size="sm" /> }
                            @if (lastForgedWeapon.BonusCriticalChance > 0) { <FantasyTile Icon="bi-bullseye" Label="Crit" Value="@($"+{lastForgedWeapon.BonusCriticalChance * 100:F1}%")" Color="yellow" Size="sm" /> }
                        </div>
                    </div>
                </div>
            </BodyContent>
            <FooterContent>
                <button class="btn btn-primary" @onclick="() => showForgeResultModal = false">
                    <i class="bi bi-check-lg me-2"></i>Voltar Atrás
                </button>
            </FooterContent>
        </Modal>
    }

    <!-- Weapon Action Modal (Equip/Unequip forged weapon) -->
    @if (showWeaponActionModal && pendingWeapon != null)
    {
        var upgradeCost = InventoryService.GetWeaponUpgradeCost(pendingWeapon.Level);
        var wpnDrinkReqs = InventoryService.GetUpgradeDrinkRequirement(pendingWeapon.Level);
        var hasFidelis = currentUser != null && currentUser.FidelisBalance >= upgradeCost;
        var hasDrinks = wpnDrinkReqs.All(d => GetResourceQuantity(d.DrinkType) >= d.Quantity);
        var wpnLeitaoCost = InventoryService.GetUpgradeLeitaoCost(pendingWeapon.Level);
        var hasLeitaoWpn = wpnLeitaoCost == 0 || leitaoQuantity >= wpnLeitaoCost;
        var canAffordUpgrade = hasFidelis && hasDrinks && hasLeitaoWpn;
        var weaponDiscardValue = InventoryService.GetWeaponDiscardValue(pendingWeapon, character?.Level ?? 1);
        var nextDrinkTier = InventoryService.GetNextDrinkTier(pendingWeapon.SourceDrink);
        var drinkUpgradeCost = nextDrinkTier != null ? InventoryService.GetDrinkUpgradeCost(pendingWeapon.Level) : 0m;
        var canAffordDrinkUpgrade = nextDrinkTier != null && currentUser != null && currentUser.FidelisBalance >= drinkUpgradeCost;
        var nextDrinkRes = nextDrinkTier != null ? activeResources.FirstOrDefault(r => r.Type == nextDrinkTier.Value.ToString()) : null;
        var nextDrinkUnlocked = nextDrinkRes != null && (stageProgress?.HighestStage ?? 0) >= nextDrinkRes.UnlockStage;
        var currentDrinkRes = activeResources.FirstOrDefault(r => r.Type == pendingWeapon.SourceDrink.ToString());

        // Pre-compute projected stats after level upgrade (+1)
        var _wForging = MyTunoConfig.Value.StageMode.Forging;
        var _wBaseStats = MyTunoConfig.Value.StageMode.EquipmentStats.Instrument;
        var _wDrinkResource = MyTunoConfig.Value.Gathering.Resources.FirstOrDefault(r => r.Type == pendingWeapon.SourceDrink.ToString());
        var _wDrinkEnergyCost = _wDrinkResource?.EnergyCost ?? 1;
        var _wDrinkMult = 1.0 + (_wDrinkEnergyCost - 1) * _wForging.DrinkStatBonusPerTier;
        var _wHandedMult = pendingWeapon.IsTwoHanded ? _wForging.TwoHandedMultiplier : 1.0;
        var _wScale = _wDrinkMult * _wHandedMult;
        var _wHpPerLvl = MyTunoConfig.Value.StageMode.EquipmentHpPerLevel;
        var _wPowPerLvl = MyTunoConfig.Value.StageMode.EquipmentPowerPerLevel;
        var _wDefPerLvl = MyTunoConfig.Value.StageMode.EquipmentDefensePerLevel;
        var nextHP = (int)Math.Round((_wBaseStats.HP + (pendingWeapon.Level + 1) * _wHpPerLvl) * _wScale);
        var nextPow = (int)Math.Round((_wBaseStats.Power + (pendingWeapon.Level + 1) * _wPowPerLvl) * _wScale);
        var nextDef = (int)Math.Round((_wBaseStats.Defense + (pendingWeapon.Level + 1) * _wDefPerLvl) * _wScale);
        var lvlDeltaHP = nextHP - pendingWeapon.BonusHP;
        var lvlDeltaPow = nextPow - pendingWeapon.BonusPower;
        var lvlDeltaDef = nextDef - pendingWeapon.BonusDefense;

        <Modal Show="@showWeaponActionModal"
               ShowChanged="@((bool show) => { if (!show) showWeaponActionModal = false; })"
               Title="@pendingWeapon.Name"
               Size="Modal.ModalSize.Default"
               Centered="true">
            <BodyContent>
                <!-- Header: icon + name + level + type + drink -->
                <div class="item-detail-header">
                    <div class="equip-confirm-icon">
                        @if (GetForgedWeaponPictureUrl(pendingWeapon) is string pendingWpnImg)
                        {
                            <img src="@CacheBuster.Bust(pendingWpnImg)" alt="@pendingWeapon.Name" style="width: 56px; height: 56px; object-fit: contain; filter: drop-shadow(0 0 4px var(--bs-warning));" />
                        }
                        else
                        {
                            <i class="bi @WeaponTypeHelper.GetIcon(pendingWeapon.WeaponType)" style="font-size: 2.5rem; color: var(--bs-warning);"></i>
                        }
                    </div>
                    <h5 class="item-detail-name">
                        @if (renamingWeapon)
                        {
                            <div class="weapon-rename-row">
                                <input type="text" class="weapon-rename-input" maxlength="100"
                                       @bind="renameWeaponText" @bind:event="oninput"
                                       @onkeydown="OnRenameKeyDown" />
                                <button class="btn btn-sm btn-outline-success weapon-rename-btn" @onclick="ConfirmWeaponRename" disabled="@(weaponActioning || string.IsNullOrWhiteSpace(renameWeaponText))">
                                    <i class="bi bi-check-lg"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-secondary weapon-rename-btn" @onclick="CancelWeaponRename">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                        }
                        else
                        {
                            @pendingWeapon.Name
                            <button class="btn btn-sm weapon-rename-pencil" @onclick="StartWeaponRename" title="Renomear arma">
                                <i class="bi bi-pencil-fill"></i>
                            </button>
                        }
                        @if (pendingWeapon.Level > 0)
                        {
                            <span class="badge bg-warning text-dark ms-1" style="font-size: 0.7rem;">+@pendingWeapon.Level</span>
                        }
                    </h5>
                    <div class="item-detail-tags">
                        <span class="badge bg-info bg-opacity-25 text-info">@WeaponTypeHelper.GetDisplayName(pendingWeapon.WeaponType)</span>
                        @if (currentDrinkRes != null)
                        {
                            <span class="badge bg-purple bg-opacity-25 text-purple">
                                @if (!string.IsNullOrEmpty(GetDrinkPictureUrl(pendingWeapon.SourceDrink)))
                                {
                                    <img src="@CacheBuster.Bust(GetDrinkPictureUrl(pendingWeapon.SourceDrink))" alt="" style="width: 14px; height: 14px; vertical-align: -2px;" />
                                }
                                @(currentDrinkRes.Name ?? pendingWeapon.SourceDrink.ToString())
                            </span>
                        }
                    </div>
                </div>

                <!-- Current Stats with next-level preview -->
                <div class="item-detail-section">
                    <div class="item-detail-section__label"><i class="bi bi-bar-chart-fill me-1"></i>Bónus Atuais</div>
                    <div class="item-detail-stats">
                        @if (pendingWeapon.BonusHP > 0)
                        {
                            <div class="item-stat-row">
                                <span class="item-stat-row__icon item-stat-row__icon--hp"><i class="bi bi-heart-fill"></i></span>
                                <span class="item-stat-row__label">HP</span>
                                <span class="item-stat-row__value">+@Fmt(pendingWeapon.BonusHP)</span>
                                <span class="item-stat-row__delta">+@Fmt(lvlDeltaHP)</span>
                            </div>
                        }
                        @if (pendingWeapon.BonusPower > 0)
                        {
                            <div class="item-stat-row">
                                <span class="item-stat-row__icon item-stat-row__icon--pow"><i class="bi bi-lightning-fill"></i></span>
                                <span class="item-stat-row__label">Poder</span>
                                <span class="item-stat-row__value">+@Fmt(pendingWeapon.BonusPower)</span>
                                <span class="item-stat-row__delta">+@Fmt(lvlDeltaPow)</span>
                            </div>
                        }
                        @if (pendingWeapon.BonusDefense > 0)
                        {
                            <div class="item-stat-row">
                                <span class="item-stat-row__icon item-stat-row__icon--def"><i class="bi bi-shield-fill"></i></span>
                                <span class="item-stat-row__label">Defesa</span>
                                <span class="item-stat-row__value">+@Fmt(pendingWeapon.BonusDefense)</span>
                                <span class="item-stat-row__delta">+@Fmt(lvlDeltaDef)</span>
                            </div>
                        }
                        @if (pendingWeapon.BonusSpeed > 0)
                        {
                            <div class="item-stat-row">
                                <span class="item-stat-row__icon item-stat-row__icon--spd"><i class="bi bi-speedometer2"></i></span>
                                <span class="item-stat-row__label">Velocidade</span>
                                <span class="item-stat-row__value">+@Fmt(pendingWeapon.BonusSpeed)</span>
                                <span class="item-stat-row__delta"></span>
                            </div>
                        }
                        @if (pendingWeapon.BonusCriticalChance > 0)
                        {
                            <div class="item-stat-row">
                                <span class="item-stat-row__icon item-stat-row__icon--crit"><i class="bi bi-bullseye"></i></span>
                                <span class="item-stat-row__label">Crítico</span>
                                <span class="item-stat-row__value">+@($"{pendingWeapon.BonusCriticalChance * 100:F1}%")</span>
                                <span class="item-stat-row__delta"></span>
                            </div>
                        }
                    </div>
                </div>

                <!-- Level Upgrade Cost -->
                <div class="item-detail-section">
                    <div class="item-detail-section__label"><i class="bi bi-arrow-up-circle me-1"></i>Upgrade para +@(pendingWeapon.Level + 1)</div>
                    <div class="ftile-grid ftile-grid--2col">
                        <FantasyTile Icon="bi-coin" Label="Fidelis" Value="@Fmt(upgradeCost)"
                                     Color="gold" Size="md" Insufficient="@(!hasFidelis)">
                            <span class="ftile-stock @(hasFidelis ? "ftile-stock--ok" : "ftile-stock--low")">@Fmt(currentUser?.FidelisBalance ?? 0)</span>
                        </FantasyTile>
                        @foreach (var (drinkType, drinkQty) in wpnDrinkReqs)
                        {
                            var drinkName = GetResourceName(drinkType);
                            var drinkHave = GetResourceQuantity(drinkType);
                            var drinkRes = activeResources.FirstOrDefault(r => r.Type == drinkType.ToString());
                            var hasDrink = drinkHave >= drinkQty;
                            <FantasyTile ImageUrl="@(GetDrinkPictureUrl(drinkType))" Icon="@(drinkRes?.Icon ?? "bi-cup-straw")" Label="@drinkName" Value="@($"×{drinkQty}")"
                                         Color="purple" Size="md" Insufficient="@(!hasDrink)">
                                <span class="ftile-stock @(hasDrink ? "ftile-stock--ok" : "ftile-stock--low")">@drinkHave</span>
                            </FantasyTile>
                        }
                        @if (wpnLeitaoCost > 0)
                        {
                            <FantasyTile Icon="bi-piggy-bank" Label="Leitões" Value="@($"×{wpnLeitaoCost}")"
                                         Color="pink" Size="md" Insufficient="@(!hasLeitaoWpn)">
                                <span class="ftile-stock @(hasLeitaoWpn ? "ftile-stock--ok" : "ftile-stock--low")">@leitaoQuantity</span>
                            </FantasyTile>
                        }
                    </div>
                    <div class="text-center mt-2">
                    <button class="btn item-detail-upgrade-btn" @onclick="() => ConfirmWeaponUpgrade()" disabled="@(weaponActioning || !canAffordUpgrade)">
                        @if (weaponActioning)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        <i class="bi bi-arrow-up-circle me-1"></i>Upgrade +@(pendingWeapon.Level + 1)
                    </button>
                    </div>
                </div>

                @if (nextDrinkTier != null && nextDrinkUnlocked)
                {
                    // Pre-compute projected stats after drink tier upgrade
                    var _forging = MyTunoConfig.Value.StageMode.Forging;
                    var _baseStats = MyTunoConfig.Value.StageMode.EquipmentStats.Instrument;
                    var _nextEnergyCost = nextDrinkRes?.EnergyCost ?? 1;
                    var _nextDrinkMult = 1.0 + (_nextEnergyCost - 1) * _forging.DrinkStatBonusPerTier;
                    var _handedMult = pendingWeapon.IsTwoHanded ? _forging.TwoHandedMultiplier : 1.0;
                    var _nextScale = _nextDrinkMult * _handedMult;
                    var _hpPerLvl = MyTunoConfig.Value.StageMode.EquipmentHpPerLevel;
                    var _powPerLvl = MyTunoConfig.Value.StageMode.EquipmentPowerPerLevel;
                    var _defPerLvl = MyTunoConfig.Value.StageMode.EquipmentDefensePerLevel;
                    var projHP = (int)Math.Round((_baseStats.HP + pendingWeapon.Level * _hpPerLvl) * _nextScale);
                    var projPow = (int)Math.Round((_baseStats.Power + pendingWeapon.Level * _powPerLvl) * _nextScale);
                    var projDef = (int)Math.Round((_baseStats.Defense + pendingWeapon.Level * _defPerLvl) * _nextScale);
                    var deltaHP = projHP - pendingWeapon.BonusHP;
                    var deltaPow = projPow - pendingWeapon.BonusPower;
                    var deltaDef = projDef - pendingWeapon.BonusDefense;

                    <!-- Drink Tier Upgrade -->
                    <div class="item-detail-section">
                        <div class="item-detail-section__label"><i class="bi bi-cup-straw me-1"></i>Upgrade Bebida para @(nextDrinkRes?.Name ?? nextDrinkTier.Value.ToString())</div>
                        <div class="item-detail-stats mb-2">
                            @if (deltaHP != 0)
                            {
                                <div class="item-stat-row item-stat-row--preview">
                                    <span class="item-stat-row__icon item-stat-row__icon--hp"><i class="bi bi-heart-fill"></i></span>
                                    <span class="item-stat-row__label">HP</span>
                                    <span class="item-stat-row__value">+@Fmt(projHP)</span>
                                    <span class="item-stat-row__delta">+@Fmt(deltaHP)</span>
                                </div>
                            }
                            @if (deltaPow != 0)
                            {
                                <div class="item-stat-row item-stat-row--preview">
                                    <span class="item-stat-row__icon item-stat-row__icon--pow"><i class="bi bi-lightning-fill"></i></span>
                                    <span class="item-stat-row__label">Poder</span>
                                    <span class="item-stat-row__value">+@Fmt(projPow)</span>
                                    <span class="item-stat-row__delta">+@Fmt(deltaPow)</span>
                                </div>
                            }
                            @if (deltaDef != 0)
                            {
                                <div class="item-stat-row item-stat-row--preview">
                                    <span class="item-stat-row__icon item-stat-row__icon--def"><i class="bi bi-shield-fill"></i></span>
                                    <span class="item-stat-row__label">Defesa</span>
                                    <span class="item-stat-row__value">+@Fmt(projDef)</span>
                                    <span class="item-stat-row__delta">+@Fmt(deltaDef)</span>
                                </div>
                            }
                        </div>
                        <div class="ftile-grid ftile-grid--2col">
                            <FantasyTile Icon="bi-coin" Label="Fidelis" Value="@Fmt(drinkUpgradeCost)"
                                         Color="gold" Size="md" Insufficient="@(!canAffordDrinkUpgrade)">
                                <span class="ftile-stock @(canAffordDrinkUpgrade ? "ftile-stock--ok" : "ftile-stock--low")">@Fmt(currentUser?.FidelisBalance ?? 0)</span>
                            </FantasyTile>
                            <FantasyTile ImageUrl="@(GetDrinkPictureUrl(nextDrinkTier.Value))" Icon="@(nextDrinkRes?.Icon ?? "bi-cup-straw")" Label="@(nextDrinkRes?.Name ?? nextDrinkTier.Value.ToString())"
                                         Value="" Color="purple" Size="md" />
                        </div>
                        <div class="text-center mt-2">
                        <button class="btn item-detail-upgrade-btn item-detail-upgrade-btn--drink" @onclick="() => ConfirmWeaponDrinkUpgrade()" disabled="@(weaponActioning || !canAffordDrinkUpgrade)">
                            <i class="bi bi-cup-straw me-1"></i>Upgrade para @(nextDrinkRes?.Name ?? nextDrinkTier.Value.ToString())
                        </button>
                        </div>
                    </div>
                }
            </BodyContent>
            <FooterContent>
                <div class="item-detail-actions">
                    @if (pendingWeapon.IsEquipped)
                    {
                        <button class="btn btn-purple btn-sm" @onclick="() => ConfirmWeaponUnequip()" disabled="@weaponActioning">
                            <i class="bi bi-box-arrow-down me-1"></i>Desequipar
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-purple btn-sm" @onclick="() => ConfirmWeaponEquip(1)" disabled="@weaponActioning">
                            <i class="bi bi-box-arrow-in-up me-1"></i>Equipar Slot 1
                        </button>
                        @if (!pendingWeapon.IsTwoHanded)
                        {
                            <button class="btn btn-purple btn-sm opacity-75" @onclick="() => ConfirmWeaponEquip(2)" disabled="@weaponActioning">
                                <i class="bi bi-box-arrow-in-up me-1"></i>Slot 2
                            </button>
                        }
                    }
                    <button class="btn btn-outline-danger btn-sm" @onclick="() => ConfirmWeaponDiscard()" disabled="@weaponActioning">
                        <i class="bi bi-trash me-1"></i>Descartar
                        <small class="opacity-75">(@Fmt(weaponDiscardValue) <i class="bi bi-coin"></i>)</small>
                    </button>
                </div>
            </FooterContent>
        </Modal>
    }

    <!-- Weapons List Modal -->
    @if (showWeaponsListModal)
    {
        <Modal Show="@showWeaponsListModal"
               ShowChanged="@((bool show) => { if (!show) showWeaponsListModal = false; })"
               Title="Armas Forjadas"
               Size="Modal.ModalSize.Large"
               Centered="true">
            <BodyContent>
                @if (!forgedWeapons.Any())
                {
                    <EmptyState Title="Sem armas"
                                Message="Ainda não forjaste nenhuma arma. Combina um instrumento com uma bebida na Forja!"
                                Icon="bi-hammer" />
                }
                else
                {
                    <div class="stats-card-grid">
                        @foreach (var weapon in forgedWeapons)
                        {
                            var isEquippedW = weapon.IsEquipped;
                            <div @key="weapon.Id" class="stats-card @(isEquippedW ? "border-success" : "")" style="cursor: pointer;" @onclick="() => { showWeaponsListModal = false; OnForgedWeaponClick(weapon); }">
                                <div class="stats-card-position" style="width: 40px;">
                                    @if (GetForgedWeaponPictureUrl(weapon) is string listWpnImg)
                                    {
                                        <img src="@CacheBuster.Bust(listWpnImg)" alt="@weapon.Name" style="width: 32px; height: 32px; object-fit: contain; filter: drop-shadow(0 0 2px var(--bs-warning));" />
                                    }
                                    else
                                    {
                                        <i class="bi @WeaponTypeHelper.GetIcon(weapon.WeaponType)" style="font-size: 1.5rem; color: var(--bs-warning);"></i>
                                    }
                                </div>
                                <div class="stats-card-content">
                                    <div class="stats-card-title">
                                        @weapon.Name
                                        @if (weapon.Level > 0)
                                        {
                                            <span class="badge bg-warning text-dark ms-1" style="font-size: 0.65rem;">+@weapon.Level</span>
                                        }
                                    </div>
                                    <div class="stats-card-subtitle" style="font-size: 0.75rem; color: #aaa;">
                                        @WeaponTypeHelper.GetDisplayName(weapon.WeaponType)
                                        <span class="ms-2">
                                            @if (weapon.BonusHP > 0) { <span class="text-danger">+@Fmt(weapon.BonusHP) HP</span> }
                                            @if (weapon.BonusPower > 0) { <span class="text-success ms-1">+@Fmt(weapon.BonusPower) Pow</span> }
                                            @if (weapon.BonusSpeed > 0) { <span class="text-primary ms-1">+@Fmt(weapon.BonusSpeed) Vel</span> }
                                            @if (weapon.BonusDefense > 0) { <span class="text-secondary ms-1">+@Fmt(weapon.BonusDefense) Def</span> }
                                            @if (weapon.BonusCriticalChance > 0) { <span class="text-warning ms-1">+@($"{weapon.BonusCriticalChance * 100:F1}%") Crit</span> }
                                        </span>
                                    </div>
                                </div>
                                <div class="stats-card-count">
                                    @if (isEquippedW)
                                    {
                                        <span class="badge bg-success" style="font-size: 0.75rem;"><i class="bi bi-check-circle me-1"></i>Equipado</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-dark" style="font-size: 0.7rem;">Não equipado</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </BodyContent>
            <FooterContent>
                <button class="btn btn-secondary" @onclick="() => showWeaponsListModal = false">
                    <i class="bi bi-arrow-left me-2"></i>Voltar Atrás
                </button>
            </FooterContent>
        </Modal>
    }

    <!-- Item Action Modal (Equip / Discard) -->
    @if (showItemActionModal && pendingActionItem.HasValue)
    {
        var actionItemName = GetEquipItemDisplayName(pendingActionItem.Value);
        var actionItemIcon = GetEquipItemIcon(pendingActionItem.Value);
        var actionItemImgUrl = GetEquipItemImageUrl(pendingActionItem.Value);
        var actionItemStats = GetEquipItemStats(pendingActionItem.Value);
        var actionDiscardValues = MyTunoConfig.Value.StageMode.DiscardValues;
        var actionIsInstr = InstrumentTypeHelper.IsInstrumentPart(pendingActionItem.Value);
        var actionIsEquip = EquipmentDropHelper.IsEquipment(pendingActionItem.Value);
        var actionSlot = EquipmentDropHelper.FromInventoryItemType(pendingActionItem.Value);
        var actionBaseValue = actionIsInstr ? actionDiscardValues.InstrumentPart : actionDiscardValues.Equipment;
        var actionLevel = character?.Level ?? 1;
        var actionDiscardScale = 1.0 + actionLevel * MyTunoConfig.Value.StageMode.DiscardLevelScale;
        var actionSlotLevel = actionSlot.HasValue ? GetSlotEnhancementLevel(actionSlot.Value) : 0;
        var actionFidelisValue = Math.Round(actionBaseValue * (decimal)actionDiscardScale, 2);
        var actionStoredQuality = actionSlot switch
        {
            EquipmentSlot.Head => character?.EquippedHeadQuality ?? 0,
            EquipmentSlot.Shoulders => character?.EquippedShouldersQuality ?? 0,
            EquipmentSlot.Chest => character?.EquippedChestQuality ?? 0,
            EquipmentSlot.Gloves => character?.EquippedGlovesQuality ?? 0,
            EquipmentSlot.Legs => character?.EquippedLegsQuality ?? 0,
            EquipmentSlot.Boots => character?.EquippedBootsQuality ?? 0,
            _ => 0.0
        };
        var actionQualityPct = pendingActionIsEquipped && actionStoredQuality > 0 ? (int)Math.Round(actionStoredQuality * 100) : 0;

        // Pre-compute next-level stats for equipment
        EquipmentPieceStats? eqNextStats = null;
        if (actionIsEquip && actionSlot.HasValue && actionItemStats != null)
        {
            var _eqStageConfig = MyTunoConfig.Value.StageMode;
            var _eqLevelScale = 1.0 + (character?.Level ?? 1) * _eqStageConfig.EquipmentLevelScale;
            var _eqBaseStatsCfg = actionSlot.Value switch
            {
                EquipmentSlot.Head => _eqStageConfig.EquipmentStats.Head,
                EquipmentSlot.Shoulders => _eqStageConfig.EquipmentStats.Shoulders,
                EquipmentSlot.Chest => _eqStageConfig.EquipmentStats.Chest,
                EquipmentSlot.Gloves => _eqStageConfig.EquipmentStats.Gloves,
                EquipmentSlot.Legs => _eqStageConfig.EquipmentStats.Legs,
                EquipmentSlot.Boots => _eqStageConfig.EquipmentStats.Boots,
                _ => null
            };
            if (_eqBaseStatsCfg != null)
            {
                var _eqHpPerLvl = _eqStageConfig.EquipmentHpPerLevel;
                var _eqPowPerLvl = _eqStageConfig.EquipmentPowerPerLevel;
                var _eqDefPerLvl = _eqStageConfig.EquipmentDefensePerLevel;
                var _eqQualityAvg = (_eqStageConfig.EquipmentQualityMin + _eqStageConfig.EquipmentQualityMax) / 2.0;
                var _eqQuality = pendingActionIsEquipped && actionStoredQuality > 0 ? actionStoredQuality : _eqQualityAvg;
                var _eqNextLevel = actionSlotLevel + 1;
                eqNextStats = new EquipmentPieceStats
                {
                    HP = (int)Math.Round((_eqBaseStatsCfg.HP + _eqNextLevel * _eqHpPerLvl) * _eqQuality * _eqLevelScale),
                    Power = (int)Math.Round((_eqBaseStatsCfg.Power + _eqNextLevel * _eqPowPerLvl) * _eqQuality * _eqLevelScale),
                    Defense = (int)Math.Round((_eqBaseStatsCfg.Defense + _eqNextLevel * _eqDefPerLvl) * _eqQuality * _eqLevelScale),
                };
            }
        }

        <Modal Show="@showItemActionModal"
               ShowChanged="@((bool show) => { if (!show) CloseItemActionModal(); })"
               Title="@actionItemName"
               Size="Modal.ModalSize.Default"
               Centered="true">
            <BodyContent>
                <!-- Header -->
                <div class="item-detail-header">
                    <div class="equip-confirm-icon">
                        @if (!string.IsNullOrEmpty(actionItemImgUrl))
                        {
                            <img src="@CacheBuster.Bust(actionItemImgUrl)" alt="@actionItemName" style="width: 56px; height: 56px; object-fit: contain;" />
                        }
                        else
                        {
                            <i class="bi @actionItemIcon" style="font-size: 2.5rem; color: var(--bs-primary);"></i>
                        }
                    </div>
                    <h5 class="item-detail-name">
                        @actionItemName
                        @if (actionIsEquip && actionSlotLevel > 0)
                        {
                            <span class="badge bg-warning text-dark ms-1" style="font-size: 0.7rem;">+@actionSlotLevel</span>
                        }
                    </h5>
                    @if (actionIsInstr)
                    {
                        <div class="item-detail-tags">
                            <span class="badge bg-info bg-opacity-25 text-info"><i class="bi bi-hammer me-1"></i>Material de Craft</span>
                        </div>
                    }
                </div>

                @if (actionItemStats != null && actionIsEquip)
                {
                    <!-- Current Stats with next-level preview -->
                    <div class="item-detail-section">
                        <div class="item-detail-section__label"><i class="bi bi-bar-chart-fill me-1"></i>Bónus Atuais</div>
                        <div class="item-detail-stats">
                            @if (actionItemStats.HP > 0)
                            {
                                <div class="item-stat-row">
                                    <span class="item-stat-row__icon item-stat-row__icon--hp"><i class="bi bi-heart-fill"></i></span>
                                    <span class="item-stat-row__label">HP</span>
                                    <span class="item-stat-row__value">+@Fmt(actionItemStats.HP)</span>
                                    @if (eqNextStats != null)
                                    {
                                        <span class="item-stat-row__delta">+@Fmt(eqNextStats.HP - actionItemStats.HP)</span>
                                    }
                                </div>
                            }
                            @if (actionItemStats.Power > 0)
                            {
                                <div class="item-stat-row">
                                    <span class="item-stat-row__icon item-stat-row__icon--pow"><i class="bi bi-lightning-fill"></i></span>
                                    <span class="item-stat-row__label">Poder</span>
                                    <span class="item-stat-row__value">+@Fmt(actionItemStats.Power)</span>
                                    @if (eqNextStats != null)
                                    {
                                        <span class="item-stat-row__delta">+@Fmt(eqNextStats.Power - actionItemStats.Power)</span>
                                    }
                                </div>
                            }
                            @if (actionItemStats.Defense > 0)
                            {
                                <div class="item-stat-row">
                                    <span class="item-stat-row__icon item-stat-row__icon--def"><i class="bi bi-shield-fill"></i></span>
                                    <span class="item-stat-row__label">Defesa</span>
                                    <span class="item-stat-row__value">+@Fmt(actionItemStats.Defense)</span>
                                    @if (eqNextStats != null)
                                    {
                                        <span class="item-stat-row__delta">+@Fmt(eqNextStats.Defense - actionItemStats.Defense)</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Upgrade Cost (moved from footer) -->
                    @if (actionSlot.HasValue)
                    {
                        var eqSlotBonusLevel = character?.GetSlotBonusLevel(actionSlot.Value) ?? 0;
                        var eqUpgradeCost = InventoryService.GetEquipmentUpgradeCost(eqSlotBonusLevel);
                        var eqDrinkReqs = InventoryService.GetEquipmentUpgradeDrinkRequirements(eqSlotBonusLevel);
                        var eqLeitaoCost = InventoryService.GetEquipmentUpgradeLeitaoCost(eqSlotBonusLevel);
                        var hasLeitaoEq = eqLeitaoCost == 0 || leitaoQuantity >= eqLeitaoCost;
                        var hasFidelisEq = currentUser != null && currentUser.FidelisBalance >= eqUpgradeCost;
                        var hasDrinksEq = eqDrinkReqs.All(d => GetResourceQuantity(d.DrinkType) >= d.Quantity);
                        var canAffordEqUpgrade = hasFidelisEq && hasDrinksEq && hasLeitaoEq;
                        var upgradeSlot = actionSlot.Value;

                        <div class="item-detail-section">
                            <div class="item-detail-section__label"><i class="bi bi-arrow-up-circle me-1"></i>Upgrade para +@(actionSlotLevel + 1)</div>
                            <div class="ftile-grid ftile-grid--2col">
                                <FantasyTile Icon="bi-coin" Label="Fidelis" Value="@Fmt(eqUpgradeCost)"
                                             Color="gold" Size="md" Insufficient="@(!hasFidelisEq)">
                                    <span class="ftile-stock @(hasFidelisEq ? "ftile-stock--ok" : "ftile-stock--low")">@Fmt(currentUser?.FidelisBalance ?? 0)</span>
                                </FantasyTile>
                                @foreach (var (drinkType, drinkQty) in eqDrinkReqs)
                                {
                                    var drinkName = GetResourceName(drinkType);
                                    var drinkHave = GetResourceQuantity(drinkType);
                                    var drinkRes = activeResources.FirstOrDefault(r => r.Type == drinkType.ToString());
                                    var hasDrink = drinkHave >= drinkQty;
                                    <FantasyTile ImageUrl="@(GetDrinkPictureUrl(drinkType))" Icon="@(drinkRes?.Icon ?? "bi-cup-straw")" Label="@drinkName" Value="@($"×{drinkQty}")"
                                                 Color="purple" Size="md" Insufficient="@(!hasDrink)">
                                        <span class="ftile-stock @(hasDrink ? "ftile-stock--ok" : "ftile-stock--low")">@drinkHave</span>
                                    </FantasyTile>
                                }
                                @if (eqLeitaoCost > 0)
                                {
                                    <FantasyTile Icon="bi-piggy-bank" Label="Leitões" Value="@($"×{eqLeitaoCost}")"
                                                 Color="pink" Size="md" Insufficient="@(!hasLeitaoEq)">
                                        <span class="ftile-stock @(hasLeitaoEq ? "ftile-stock--ok" : "ftile-stock--low")">@leitaoQuantity</span>
                                    </FantasyTile>
                                }
                            </div>
                            <div class="text-center mt-2">
                            <button class="btn item-detail-upgrade-btn" @onclick="() => ConfirmEquipmentSlotUpgrade(upgradeSlot)" disabled="@(itemActioning || !canAffordEqUpgrade)">
                                @if (itemActioning)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                <i class="bi bi-arrow-up-circle me-1"></i>Upgrade +@(actionSlotLevel + 1)
                            </button>
                            </div>
                        </div>
                    }
                }

                @if (!actionIsEquip)
                {
                    <div class="discard-fidelis-reward">
                        <i class="bi bi-trash text-danger me-1"></i>
                        <span class="text-danger">Descartar: <strong>+@Fmt(actionFidelisValue) Fidelis</strong></span>
                    </div>
                }
            </BodyContent>
            <FooterContent>
                <div class="item-detail-actions">
                    @if (actionIsEquip)
                    {
                        <button class="btn btn-outline-danger btn-sm" @onclick="() => ConfirmItemAction(true)" disabled="@itemActioning">
                            <i class="bi bi-trash me-1"></i>Descartar
                            <small class="opacity-75">(@Fmt(actionFidelisValue) <i class="bi bi-coin"></i>)</small>
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-danger btn-sm" @onclick="() => ConfirmItemAction(true)" disabled="@itemActioning">
                            <i class="bi bi-trash me-1"></i>Descartar
                            <small class="opacity-75">(@Fmt(actionFidelisValue) <i class="bi bi-coin"></i>)</small>
                        </button>
                    }
                </div>
            </FooterContent>
        </Modal>
    }

    <!-- Stage Modal -->
    @if (showStageModal)
    {
        <Modal Show="@showStageModal"
               ShowChanged="@((bool show) => { if (!show) showStageModal = false; })"
               Title="Stage Mode"
               Size="Modal.ModalSize.Large"
               Centered="true">
            <BodyContent>
                @if (stageProgress != null)
                {
                    <div class="text-center mb-3">
                        <h5 class="mb-0">
                            <i class="bi bi-trophy text-warning me-2"></i>
                            Maior Floor Alcançado: <span class="text-success">Floor @stageProgress.HighestStage</span>
                        </h5>
                    </div>
                    
                    <div class="stage-biomes-list">
                        @{
                            var biomes = MyTunoConfig.Value.StageMode.Biomes;
                            var highestStage = stageProgress.HighestStage;
                        }
                        @foreach (var biome in biomes)
                        {
                            var isUnlocked = highestStage >= biome.StageMin;
                            var isCompleted = highestStage > biome.StageMax;
                            var isCurrent = highestStage >= biome.StageMin && highestStage <= biome.StageMax;
                            var biomeCheckpoints = GetCheckpointsForBiome(biome.StageMin, biome.StageMax, highestStage);
                            var icon = GetBiomeIcon(biome.Name);
                            var color = GetBiomeColor(biome.Name);
                            var rangeText = biome.StageMax >= 999999 ? $"{biome.StageMin}+" : $"{biome.StageMin}–{biome.StageMax}";
                            var isExpanded = expandedBiomes.Contains(biome.Name);

                            <div @key="biome.Name" class="biome-card @(isCurrent ? "biome-current" : "") @(isCompleted ? "biome-done" : "") @(!isUnlocked ? "biome-locked" : "")"
                                 style="--bc: @color;">
                                <div class="biome-row @(isUnlocked ? "biome-clickable" : "")"
                                     @onclick="() => { if (isUnlocked) ToggleBiomeExpanded(biome.Name); }">
                                    <i class="bi @icon" style="color: @color; font-size: 1.2rem; width: 22px; text-align: center;"></i>
                                    <div style="flex: 1; min-width: 0;">
                                        <div style="font-weight: 700; font-size: 0.9rem; color: #eee;">@biome.Name</div>
                                        <div style="font-size: 0.7rem; color: rgba(255,255,255,0.35);">Floors @rangeText</div>
                                    </div>
                                    @if (isCompleted)
                                    {
                                        <i class="bi bi-check-circle-fill" style="color: @color; font-size: 1rem;"></i>
                                    }
                                    else if (isCurrent)
                                    {
                                        <span class="badge" style="background: @color; font-size: 0.68rem;">Atual</span>
                                    }
                                    else if (!isUnlocked)
                                    {
                                        <i class="bi bi-lock-fill" style="color: rgba(255,255,255,0.2);"></i>
                                    }
                                    @if (isUnlocked)
                                    {
                                        <i class="bi @(isExpanded ? "bi-chevron-up" : "bi-chevron-down")" style="color: rgba(255,255,255,0.3);"></i>
                                    }
                                </div>
                                @if (isUnlocked && isExpanded && biomeCheckpoints.Count > 0)
                                {
                                    <div class="biome-grid">
                                        @foreach (var cp in biomeCheckpoints)
                                        {
                                            var isHighest = cp >= highestStage - 9 && cp <= highestStage;
                                            <button @key="cp" class="biome-cp @(isHighest ? "biome-cp-active" : "")"
                                                    style="--bc: @color;"
                                                    @onclick="() => StartFromStage(cp)">
                                                @cp
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center">
                        <LoadingSpinner Message="A carregar progresso..." />
                    </div>
                }
            </BodyContent>
            <FooterContent>
                <button class="btn btn-secondary" @onclick="CloseStageModal">
                    <i class="bi bi-arrow-left me-2"></i>Voltar Atrás
                </button>
            </FooterContent>
        </Modal>
    }

    <!-- Boss Mode Modal -->
    @if (showBossModeModal)
    {
        <Modal Show="@showBossModeModal"
               ShowChanged="@((bool show) => { if (!show) showBossModeModal = false; })"
               Title="Boss Mode"
               Size="Modal.ModalSize.Default"
               Centered="true">
            <BodyContent>
                <div class="bm-modal">
                    <div class="bm-modal__hero">
                        <i class="bi bi-lightning-fill bm-modal__hero-icon"></i>
                        <h5 class="bm-modal__title">Boss Mode</h5>
                        <p class="bm-modal__subtitle">Enfrenta bosses cada vez mais fortes numa batalha sem fim!</p>
                    </div>

                    @if (bossModeProgress != null)
                    {
                        <div class="bm-modal__record">
                            <span>Recorde: <strong class="bm-modal__record-val">Boss #@bossModeProgress.HighestBossStage</strong></span>
                            <span class="bm-modal__record-runs">Total de runs: @bossModeProgress.TotalRunsAttempted</span>
                        </div>
                    }

                    <div class="bm-modal__info-card bm-modal__info-card--fitab">
                        <i class="bi bi-lightning-fill"></i>
                        <span>Custa <strong>1 FITAB</strong> para entrar. Tens <strong>@fitabQuantity FITAB</strong>.</span>
                    </div>

                    <div class="bm-modal__info-card bm-modal__info-card--level">
                        <i class="bi bi-shield-lock"></i>
                        <span>Requer <strong>Level 100</strong> para entrar. O teu nível: <strong>@(character?.Level ?? 0)</strong>.</span>
                    </div>

                    <div class="bm-modal__info-card bm-modal__info-card--daily">
                        <i class="bi bi-arrow-repeat"></i>
                        <span>A batalha é <strong>contínua durante o dia</strong>. O progresso do boss (HP e floor) mantém-se entre runs até ao reset diário à <strong>00:00</strong>.</span>
                    </div>

                    @if ((character?.Level ?? 0) < 100)
                    {
                        <div class="bm-modal__warning">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <span>Precisas de atingir Level 100 para aceder ao Boss Mode.</span>
                        </div>
                    }
                    else if (fitabQuantity < 1)
                    {
                        <div class="bm-modal__warning">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <span>Não tens FITAB suficiente! FITAB é um drop raro nos Floors e Arena.</span>
                        </div>
                    }
                </div>
            </BodyContent>
            <FooterContent>
                <button class="bm-modal__btn bm-modal__btn--close" @onclick="CloseBossModeModal">
                    <i class="bi bi-arrow-left me-1"></i>Voltar Atrás
                </button>
                <button class="bm-modal__btn bm-modal__btn--enter" @onclick="StartBossMode" disabled="@(fitabQuantity < 1 || (character?.Level ?? 0) < 100)">
                    <i class="bi bi-lightning-fill me-1"></i>Entrar (1 FITAB)
                </button>
            </FooterContent>
        </Modal>
    }

    <!-- Survive Mode Modal -->
    @if (showSurviveModeModal)
    {
        <Modal Show="@showSurviveModeModal"
               ShowChanged="@((bool show) => { if (!show) showSurviveModeModal = false; })"
               Title="Survive Mode"
               Size="Modal.ModalSize.Large"
               Centered="true">
            <BodyContent>
                @if (surviveProgress != null)
                {
                    <div class="text-center mb-3">
                        <h5 class="mb-0">
                            <i class="bi bi-trophy text-warning me-2"></i>
                            Maior Nível: <span class="text-success">@surviveProgress.HighestLevel</span>
                            <small class="text-muted ms-2">(@SurviveModeProgress.GetBiomeName(surviveProgress.HighestLevel))</small>
                        </h5>
                        <div class="d-flex gap-3 justify-content-center mt-2">
                            <small class="text-muted">
                                <i class="bi bi-crosshair me-1"></i>@surviveProgress.TotalEnemiesKilled inimigos
                            </small>
                            <small class="text-muted">
                                <i class="bi bi-arrow-repeat me-1"></i>@surviveProgress.TotalRunsAttempted runs
                            </small>
                        </div>
                    </div>

                    <div class="stage-biomes-list">
                        @{
                            var surviveNames = new[] { "Forest", "Swamp", "Mountains", "Snowy", "Tropical", "Caverns", "Desert", "Volcanic", "Ruins", "Dark", "Void" };
                            var highestSurvive = surviveProgress.HighestLevel;
                        }
                        @foreach (var (name, idx) in surviveNames.Select((n, i) => (n, i)))
                        {
                            var level = idx + 1;
                            var isUnlocked = highestSurvive >= level;
                            var isCompleted = highestSurvive > level;
                            var isCurrent = surviveProgress.CurrentLevel == level;
                            var icon = GetSurviveBiomeIcon(name);
                            var color = GetSurviveBiomeColor(name);
                            var config = SurviveModeService.GetLevelConfig(level, character?.Level ?? 1);
                            var timer = config.TimerDurationSeconds;
                            var timerStr = timer >= 60 ? $"{(int)(timer / 60)}:{((int)(timer % 60)):D2}" : $"0:{(int)timer:D2}";

                            <div @key="name" class="biome-card @(isCurrent ? "biome-current" : "") @(isCompleted ? "biome-done" : "") @(!isUnlocked ? "biome-locked" : "")"
                                 style="--bc: @color;">
                                <div class="biome-row @(isUnlocked ? "biome-clickable" : "")"
                                     @onclick="async () => { if (isUnlocked) await StartSurviveLevel(level); }">
                                    <i class="bi @icon" style="color: @color; font-size: 1.2rem; width: 22px; text-align: center;"></i>
                                    <div style="flex: 1; min-width: 0;">
                                        <div style="font-weight: 700; font-size: 0.9rem; color: #eee;">Level @level — @name</div>
                                        <div style="font-size: 0.7rem; color: rgba(255,255,255,0.35);">Sobreviver @timerStr</div>
                                    </div>
                                    @if (isCompleted)
                                    {
                                        <i class="bi bi-check-circle-fill" style="color: @color; font-size: 1rem;"></i>
                                    }
                                    else if (isCurrent)
                                    {
                                        <span class="badge" style="background: @color; font-size: 0.68rem;">Próximo</span>
                                    }
                                    else if (!isUnlocked)
                                    {
                                        <i class="bi bi-lock-fill" style="color: rgba(255,255,255,0.2);"></i>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center">
                        <LoadingSpinner Message="A carregar progresso..." />
                    </div>
                }
            </BodyContent>
            <FooterContent>
                <button class="btn btn-secondary" @onclick="CloseSurviveModeModal">
                    <i class="bi bi-arrow-left me-2"></i>Voltar Atrás
                </button>
            </FooterContent>
        </Modal>
    }

</div>

