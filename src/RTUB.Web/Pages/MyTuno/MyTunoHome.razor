    private async Task GatherResource(InventoryItemType resourceType)
    {
        if (gathering != null || currentUser == null) return;

        var cost = GetResourceEnergyCost(resourceType);
        if (currentEnergy < cost) return;

        try
        {
            // Start cast bar
            gathering = resourceType;
            var castTime = gatheringConfig.CastTimeSeconds;
            if (castTime <= 0) castTime = 3;
            castTimeRemaining = castTime;
            castProgress = 0;
            castStartTime = DateTime.UtcNow;
            StateHasChanged();

            // Animate cast bar with a timer (update every 100ms)
            var castTcs = new TaskCompletionSource<bool>();
            castBarTimer?.Dispose();
            castBarTimer = new System.Threading.Timer(async _ =>
            {
                var elapsed = (DateTime.UtcNow - castStartTime).TotalSeconds;
                castProgress = Math.Min(1.0, elapsed / castTime);
                castTimeRemaining = Math.Max(0, castTime - elapsed);

                if (elapsed >= castTime)
                {
                    castBarTimer?.Dispose();
                    castBarTimer = null;
                    castTcs.TrySetResult(true);
                }

                await InvokeAsync(StateHasChanged);
            }, null, TimeSpan.FromMilliseconds(100), TimeSpan.FromMilliseconds(100));

            // Wait for cast to complete
            await castTcs.Task;

            // Cast finished — actually gather the resource
            var (success, gathered, remainingEnergy, message) = await InventoryService.GatherResourceAsync(currentUser.Id, resourceType);

            if (success)
            {
                currentEnergy = remainingEnergy;
                resourceQuantities[resourceType] = GetResourceQuantity(resourceType) + 1;

                toastMessage = message;
                toastIsError = false;
            }
            else
            {
                toastMessage = message;
                toastIsError = true;
            }
        }
        catch (Exception ex)
        {
            toastMessage = "Erro ao destilar recurso";
            toastIsError = true;
            Logger.LogError(ex, "Error gathering resource {Type}", resourceType);
        }
        finally
        {
            gathering = null;
            castProgress = 0;
            castTimeRemaining = 0;
            castBarTimer?.Dispose();
            castBarTimer = null;
            StateHasChanged();
        }
    }

    private void StartEnergyRegenTimer(int secondsUntilNext = 0)
    {
        energyRegenTimer?.Dispose();
        var regenInterval = character != null ? (int)character.EffectiveRegenInterval : gatheringConfig.RegenIntervalSeconds;
        if (regenInterval <= 0) regenInterval = 60;
        
        // Use the server-provided offset for the first tick, then full interval for subsequent ticks
        var initialDelay = secondsUntilNext > 0 ? secondsUntilNext : regenInterval;
        
        energyRegenTimer = new System.Threading.Timer(async _ =>
        {
            if (currentEnergy < maxEnergy)
            {
                currentEnergy = Math.Min(maxEnergy, currentEnergy + 1);
                await InvokeAsync(StateHasChanged);
            }
        }, null, TimeSpan.FromSeconds(initialDelay), TimeSpan.FromSeconds(regenInterval));
    }

    public void Dispose()
    {
        energyRegenTimer?.Dispose();
        castBarTimer?.Dispose();
        forgeCastBarTimer?.Dispose();
    }
