    private async Task PurchaseUpgrade(StatType statType)
    {
        if (currentUser == null) return;

        purchasingStat = statType;
        purchasing = true;
        StateHasChanged();

        try
        {
            var result = await UpgradeService.PurchaseUpgradeAsync(currentUser.Id, purchasingStat.Value);

            if (result.Success)
            {
                // Reload user and character to get updated values
                currentUser = await UserManager.FindByIdAsync(currentUser.Id);
                if (currentUser != null)
                {
                    character = await CharacterService.GetCharacterAsync(currentUser.Id);
                }

                toastMessage = $"Upgrade de {purchasingStat} comprado com sucesso!";
                toastIsError = false;
            }
            else
            {
                toastMessage = result.ErrorMessage ?? "Erro ao comprar upgrade.";
                toastIsError = true;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error purchasing upgrade");
            toastMessage = "Erro ao processar a compra. Por favor, tenta novamente.";
            toastIsError = true;
        }
        finally
        {
            purchasing = false;
            purchasingStat = null;
            StateHasChanged();
        }
    }

    private async Task PurchaseImprovement(ImprovementType improvementType)
    {
        if (currentUser == null) return;

        purchasingImprovementType = improvementType;
        purchasingImprovement = true;
        StateHasChanged();

        try
        {
            var result = await ImprovementService.PurchaseImprovementAsync(currentUser.Id, improvementType);

            if (result.Success)
            {
                currentUser = await UserManager.FindByIdAsync(currentUser.Id);
                if (currentUser != null)
                {
                    character = await CharacterService.GetCharacterAsync(currentUser.Id);
                }

                // Refresh energy bar and regen timer to reflect upgrades
                if (character != null)
                {
                    maxEnergy = character.EffectiveMaxEnergy;
                    currentEnergy = Math.Min(currentEnergy, maxEnergy);
                    StartEnergyRegenTimer();
                }

                toastMessage = $"Melhoria comprada com sucesso!";
                toastIsError = false;
            }
            else
            {
                toastMessage = result.ErrorMessage ?? "Erro ao comprar melhoria.";
                toastIsError = true;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error purchasing improvement");
            toastMessage = "Erro ao processar a compra. Por favor, tenta novamente.";
            toastIsError = true;
        }
        finally
        {
            purchasingImprovement = false;
            purchasingImprovementType = null;
            StateHasChanged();
        }
    }

