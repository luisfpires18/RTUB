    private async Task OnRenameKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await ConfirmWeaponRename();
        else if (e.Key == "Escape")
            CancelWeaponRename();
    }

    private async Task ConfirmWeaponRename()
    {
        if (pendingWeapon == null || currentUser == null || weaponActioning) return;
        if (string.IsNullOrWhiteSpace(renameWeaponText)) return;

        var trimmed = renameWeaponText.Trim();
        if (trimmed == pendingWeapon.Name)
        {
            renamingWeapon = false;
            return;
        }

        try
        {
            weaponActioning = true;
            StateHasChanged();

            var (success, message) = await InventoryService.RenameWeaponAsync(currentUser.Id, pendingWeapon.Id, trimmed);

            if (success)
            {
                pendingWeapon.Name = trimmed;
                // Update the weapon in the local list as well
                var localWeapon = forgedWeapons.FirstOrDefault(w => w.Id == pendingWeapon.Id);
                if (localWeapon != null) localWeapon.Name = trimmed;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to rename weapon {WeaponId}", pendingWeapon.Id);
        }
        finally
        {
            weaponActioning = false;
            renamingWeapon = false;
            StateHasChanged();
        }
    }

