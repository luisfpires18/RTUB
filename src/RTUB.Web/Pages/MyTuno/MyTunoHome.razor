    /// <summary>
    /// Reloads the current user from a fresh DbContext.
    /// UserManager.FindByIdAsync returns the stale tracked entity from the scoped
    /// DI context — mutations applied by services via IDbContextFactory are invisible.
    /// This helper creates a short-lived context to get the actual DB values.
    /// </summary>
    private async Task RefreshCurrentUserAsync()
    {
        if (currentUser == null) return;
        await using var ctx = DbContextFactory.CreateDbContext();
        var fresh = await ctx.Users.AsNoTracking().FirstOrDefaultAsync(u => u.Id == currentUser.Id);
        if (fresh != null)
            currentUser = fresh;
    }

    // Daily reward from config
    private decimal DailyRewardBase => MyTunoConfig.Value.DailyReward.BaseFidelis;
    private decimal DailyRewardPerLevel => MyTunoConfig.Value.DailyReward.PerLevelFidelis;

    private bool CanClaimDailyReward =>
        character != null &&
        (character.LastDailyRewardClaim == null ||
         character.LastDailyRewardClaim.Value.Date < DateTime.UtcNow.Date);

    private string DailyRewardTimeRemaining
    {
        get
        {
            if (character?.LastDailyRewardClaim == null) return "";
            var nextClaim = character.LastDailyRewardClaim.Value.Date.AddDays(1);
            var remaining = nextClaim - DateTime.UtcNow;
            if (remaining.TotalSeconds <= 0) return "";
            return $"{(int)remaining.TotalHours}h {remaining.Minutes}m";
        }
    }

    private decimal GetDailyRewardAmount()
    {
        var level = character?.Level ?? 1;
        var balance = currentUser?.FidelisBalance ?? 0m;
        return CharacterService.GetDailyRewardAmount(level, balance);
    }
    
    private async Task ClaimDailyReward()
    {
        if (currentUser == null || character == null || !CanClaimDailyReward) return;

        try
        {
            claimingDailyReward = true;

            var (success, message, reward) = await CharacterService.ClaimDailyRewardAsync(
                currentUser.Id, character.Level);

            toastMessage = message;
            toastIsError = !success;

            if (success)
            {
                // Reload user (Fidelis balance updated) and character (LastDailyRewardClaim updated)
                await RefreshCurrentUserAsync();
                character = await CharacterService.GetOrCreateCharacterAsync(currentUser.Id);
            }
            else if (message == "Já recebeste o Daily Reward hoje!")
            {
                // Sync claim timestamp from server
                character = await CharacterService.GetOrCreateCharacterAsync(currentUser.Id);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error claiming daily reward");
            toastMessage = "Erro ao receber Daily Reward.";
            toastIsError = true;
        }
        finally
        {
            claimingDailyReward = false;
        }
    }

    private static string Fmt(long value) => NumberFormatter.Compact(value);
    private static string Fmt(long? value) => NumberFormatter.Compact(value ?? 0);
    private static string Fmt(decimal value) => NumberFormatter.Compact(value);

    protected override async Task OnInitializedAsync()
    {
        AdminRefreshService.OnRefreshRequested += HandleAdminRefreshAsync;
        await LoadDataAsync();
        BuildMobileNavItems();
    }

    private void BuildMobileNavItems()
    {
        var items = new List<MobileBottomNav.MobileNavItem>();
        items.Add(new("nav-ranking", "Classificação", "bi-trophy-fill"));
        if (isOwner)
        {
            items.Add(new("nav-enemies", "Enemies", "bi-bug"));
            items.Add(new("nav-config", "Config", "bi-sliders"));
        }
        mobileNavItems = items;
    }

    private void HandleMobileNavSelect(string key)
    {
        switch (key)
        {
            case "nav-ranking": Navigation.NavigateTo("/my-tuno/all-characters"); break;
            case "nav-enemies": Navigation.NavigateTo("/owner/stage-enemies"); break;
            case "nav-config": Navigation.NavigateTo("/owner/weapon-drink-config"); break;
        }
    }

    private async Task LoadDataAsync()
    {
        try
        {
            loading = true;

            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                currentUser = await UserManager.GetUserAsync(user);
                isOwner = user.IsInRole("Owner");
                if (currentUser != null)
                {
                    // Refresh from fresh context — scoped DI context has stale data
                    await RefreshCurrentUserAsync();
                    character = await CharacterService.GetOrCreateCharacterAsync(currentUser.Id);
                    if (character != null)
                    {
                        // Safety net: if Canhão timer is actively ticking (ExpiresAt set),
                        // pause it so it only counts down during stage runs.
                        if (character.CanhaoBuffExpiresAt.HasValue)
                        {
                            character.PauseCanhaoBuff();
                            await CharacterService.UpdateCharacterAsync(character);
                        }
                        // Safety net: same for Penalty
                        if (character.PenaltyBuffExpiresAt.HasValue)
                        {
                            character.PausePenaltyBuff();
                            await CharacterService.UpdateCharacterAsync(character);
                        }

                        // Batch: single inventory query replaces ~13 individual calls
                        var inventorySummaryTask = InventoryService.GetUserInventorySummaryAsync(currentUser.Id);
                        // These are independent of inventory — run in parallel
                        var stageProgressTask = StageService.GetOrCreateStageProgressAsync(currentUser.Id);
                        var naipeConfigsTask = NaipeService.GetAllTypeConfigsAsync();
                        var itemConfigsTask = ItemTypeConfigService.GetAllConfigsAsync();
                        var forgeComboPicturesTask = ItemTypeConfigService.GetAllForgeComboPicturesAsync();
                        var forgedWeaponsTask = InventoryService.GetForgedWeaponsAsync(currentUser.Id);

                        await Task.WhenAll(
                            inventorySummaryTask,
                            stageProgressTask,
                            naipeConfigsTask,
                            itemConfigsTask,
                            forgeComboPicturesTask,
                            forgedWeaponsTask);

                        // Extract inventory quantities from the single summary
                        var inventorySummary = inventorySummaryTask.Result;
                        finoQuantity = inventorySummary.GetValueOrDefault(InventoryItemType.Fino);
                        canecaQuantity = inventorySummary.GetValueOrDefault(InventoryItemType.Caneca);
                        cigarroQuantity = inventorySummary.GetValueOrDefault(InventoryItemType.Cigarro);
                        canhaoQuantity = inventorySummary.GetValueOrDefault(InventoryItemType.Canhao);
                        shotQuantity = inventorySummary.GetValueOrDefault(InventoryItemType.Shot);
                        penaltyQuantity = inventorySummary.GetValueOrDefault(InventoryItemType.Penalty);
                        leitaoQuantity = inventorySummary.GetValueOrDefault(InventoryItemType.Leitao);
                        fitabQuantity = inventorySummary.GetValueOrDefault(InventoryItemType.Fitab);

                        // Extract instrument parts and equipment from the same summary
                        instrumentParts = inventorySummary
                            .Where(kv => Core.Helpers.InstrumentTypeHelper.IsInstrumentPart(kv.Key) && kv.Value > 0)
                            .ToDictionary(kv => kv.Key, kv => kv.Value);
                        equipmentItems = inventorySummary
                            .Where(kv => Core.Helpers.EquipmentDropHelper.IsEquipment(kv.Key) && kv.Value > 0)
                            .ToDictionary(kv => kv.Key, kv => kv.Value);
                        rareSetInventory = inventorySummary
                            .Where(kv => Core.Helpers.EquipmentDropHelper.IsRareSetPiece(kv.Key) && kv.Value > 0)
                            .ToDictionary(kv => kv.Key, kv => kv.Value);

                        // Stage progress
                        stageProgress = stageProgressTask.Result;
                        var highestStage = stageProgress?.HighestStage ?? 1;

                        // Resource quantities from the same inventory summary
                        gatheringConfig = MyTunoConfig.Value.Gathering;
                        activeResources = gatheringConfig.Resources.Where(r => r.IsActive && r.UnlockStage <= highestStage).ToList();
                        foreach (var res in activeResources)
                        {
                            if (Enum.TryParse<InventoryItemType>(res.Type, out var itemType))
                            {
                                resourceQuantities[itemType] = inventorySummary.GetValueOrDefault(itemType);
                            }
                        }
                        
                        // Energy from already-loaded character (0 extra DB queries for load)
                        var (energy, max, secondsUntilNext) = await InventoryService.GetCurrentEnergyForCharacterAsync(character);
                        currentEnergy = energy;
                        maxEnergy = max;

                        // Config data (already awaited above)
                        var naipeConfigs = naipeConfigsTask.Result;
                        foreach (var config in naipeConfigs)
                        {
                            instrumentImages[config.InstrumentType] = config.PictureUrl;
                        }
                        
                        var allItemConfigs = itemConfigsTask.Result;
                        itemTypePictures = allItemConfigs
                            .Where(c => !string.IsNullOrEmpty(c.PictureUrl))
                            .ToDictionary(c => c.TypeKey, c => c.PictureUrl!);
                        
                        forgeComboPictures = forgeComboPicturesTask.Result;
                        forgedWeapons = forgedWeaponsTask.Result;

                        // Auto-assign custom sprite if available and not yet set
                        if (string.IsNullOrEmpty(character.CustomSpritePath))
                        {
                            await CharacterService.AutoAssignCustomSpriteAsync(currentUser.Id);
                            character = await CharacterService.GetCharacterAsync(currentUser.Id);
                        }
                        
                        // Start energy regen timer (synced with server)
                        StartEnergyRegenTimer(secondsUntilNext);
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading My Tuno home data");
            toastMessage = "Erro ao carregar dados.";
            toastIsError = true;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task PurchaseUpgrade(StatType statType)
    {
        if (currentUser == null) return;

        purchasingStat = statType;
        purchasing = true;
        StateHasChanged();

        try
        {
            var result = await UpgradeService.PurchaseUpgradeAsync(currentUser.Id, purchasingStat.Value);

            if (result.Success)
            {
                // Reload from fresh context — UserManager returns stale tracked entity
                await RefreshCurrentUserAsync();
                if (currentUser != null)
                {
                    character = await CharacterService.GetCharacterAsync(currentUser.Id);
