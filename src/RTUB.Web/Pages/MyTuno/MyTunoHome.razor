    private async Task StartForge()
    {
        if (forging || !forgeInstrument.HasValue || !forgeDrink.HasValue || currentUser == null) return;

        try
        {
            forging = true;
            var castTime = MyTunoConfig.Value.StageMode.Forging?.CastTimeSeconds ?? 5;
            forgeCastTimeRemaining = castTime;
            forgeCastProgress = 0;
            forgeCastStartTime = DateTime.UtcNow;
            StateHasChanged();

            var castTcs = new TaskCompletionSource<bool>();
            forgeCastBarTimer?.Dispose();
            forgeCastBarTimer = new System.Threading.Timer(async _ =>
            {
                var elapsed = (DateTime.UtcNow - forgeCastStartTime).TotalSeconds;
                forgeCastProgress = Math.Min(1.0, elapsed / castTime);
                forgeCastTimeRemaining = Math.Max(0, castTime - elapsed);

                if (elapsed >= castTime)
                {
                    forgeCastBarTimer?.Dispose();
                    forgeCastBarTimer = null;
                    castTcs.TrySetResult(true);
                }

                await InvokeAsync(StateHasChanged);
            }, null, TimeSpan.FromMilliseconds(100), TimeSpan.FromMilliseconds(100));

            await castTcs.Task;

            // Cast finished — open weapon type + name modal
            selectedForgeWeaponType = WeaponType.SwordOneHand;
            forgeWeaponDefaultName = WeaponTypeHelper.GenerateDefaultName(WeaponType.SwordOneHand, forgeInstrument.Value, forgeDrink.Value);
            forgeWeaponName = forgeWeaponDefaultName;
            showForgeWeaponTypeModal = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error during forge cast");
            toastMessage = "Erro ao forjar arma.";
            toastIsError = true;
            forging = false;
        }
        finally
        {
            forgeCastProgress = 0;
            forgeCastTimeRemaining = 0;
            forgeCastBarTimer?.Dispose();
            forgeCastBarTimer = null;
            StateHasChanged();
        }
    }

    private void CloseForgeWeaponTypeModal()
    {
        showForgeWeaponTypeModal = false;
        forging = false;
    }

    private void SelectForgeWeaponType(WeaponType wt)
    {
        selectedForgeWeaponType = wt;
        if (forgeInstrument.HasValue && forgeDrink.HasValue)
        {
            forgeWeaponDefaultName = WeaponTypeHelper.GenerateDefaultName(wt, forgeInstrument.Value, forgeDrink.Value);
            forgeWeaponName = forgeWeaponDefaultName;
        }
    }

    private async Task ConfirmForge()
    {
        if (currentUser == null || !forgeInstrument.HasValue || !forgeDrink.HasValue || selectedForgeWeaponType == null) return;

        showForgeWeaponTypeModal = false;

        try
        {
            var weaponName = string.IsNullOrWhiteSpace(forgeWeaponName) ? forgeWeaponDefaultName : forgeWeaponName.Trim();
            var (success, weapon, message) = await InventoryService.ForgeWeaponAsync(
                currentUser.Id, forgeInstrument.Value, forgeDrink.Value, selectedForgeWeaponType.Value, weaponName);

            if (success && weapon != null)
            {
                lastForgedWeapon = weapon;
                showForgeResultModal = true;

                // Refresh inventory and forged weapons
                instrumentParts = await InventoryService.GetInstrumentPartsAsync(currentUser.Id);
                foreach (var res in activeResources)
                {
                    if (Enum.TryParse<InventoryItemType>(res.Type, out var itemType))
                    {
                        var qty = await InventoryService.GetResourceQuantityAsync(currentUser.Id, itemType);
                        resourceQuantities[itemType] = qty;
                    }
                }
                forgedWeapons = await InventoryService.GetForgedWeaponsAsync(currentUser.Id);

                toastMessage = message;
                toastIsError = false;
            }
            else
            {
                toastMessage = message;
                toastIsError = true;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error confirming forge");
            toastMessage = "Erro ao forjar arma.";
            toastIsError = true;
        }
        finally
        {
            forging = false;
            forgeInstrument = null;
            forgeDrink = null;
            StateHasChanged();
        }
    }

