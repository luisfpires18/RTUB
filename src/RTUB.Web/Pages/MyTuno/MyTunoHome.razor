    private async Task OpenStageModal()
    {
        if (currentUser != null)
        {
            // Load stage progress
            stageProgress = await StageService.GetOrCreateStageProgressAsync(currentUser.Id);
        }
        // Auto-expand the current biome
        expandedBiomes.Clear();
        if (stageProgress != null)
        {
            var biomes = MyTunoConfig.Value.StageMode.Biomes;
            var current = biomes.FirstOrDefault(b => stageProgress.HighestStage >= b.StageMin && stageProgress.HighestStage <= b.StageMax);
            if (current != null)
                expandedBiomes.Add(current.Name);
        }
        showStageModal = true;
    }

    private void ToggleBiomeExpanded(string biomeName)
