    private string GetEquipItemDisplayName(InventoryItemType itemType)
    {
        // Instrument part?
        var instrType = InstrumentTypeHelper.FromInventoryPartType(itemType);
        if (instrType.HasValue)
            return InstrumentTypeHelper.GetDisplayName(instrType.Value);

        // Equipment piece?
        var eqSlot = EquipmentDropHelper.FromInventoryItemType(itemType);
        if (eqSlot.HasValue)
            return EquipmentDropHelper.GetDisplayName(eqSlot.Value);

        return itemType.ToString();
    }

    private string GetEquipItemIcon(InventoryItemType itemType)
    {
        // Instrument → music note
        var instrType = InstrumentTypeHelper.FromInventoryPartType(itemType);
        if (instrType.HasValue)
            return "bi-music-note-beamed";

        // Equipment piece → slot icon
        var eqSlot = EquipmentDropHelper.FromInventoryItemType(itemType);
        if (eqSlot.HasValue)
            return EquipmentDropHelper.GetFallbackIcon(eqSlot.Value);

        return "bi-gem";
    }

    private string? GetEquipItemImageUrl(InventoryItemType itemType)
    {
        var instrType = InstrumentTypeHelper.FromInventoryPartType(itemType);
        if (instrType.HasValue && instrumentImages.TryGetValue(instrType.Value, out var url))
            return url;
        return null;
    }

    private EquipmentPieceStats? GetEquipItemStats(InventoryItemType itemType)
    {
        var config = MyTunoConfig.Value.StageMode.EquipmentStats;
        var stageConfig = MyTunoConfig.Value.StageMode;

        // Instrument part?
        var instrType = InstrumentTypeHelper.FromInventoryPartType(itemType);
        if (instrType.HasValue)
            return config.Instrument;

        // Equipment piece?
        var eqSlot = EquipmentDropHelper.FromInventoryItemType(itemType);
        var baseStats = eqSlot switch
        {
            EquipmentSlot.Head => config.Head,
            EquipmentSlot.Shoulders => config.Shoulders,
            EquipmentSlot.Chest => config.Chest,
            EquipmentSlot.Gloves => config.Gloves,
            EquipmentSlot.Legs => config.Legs,
            EquipmentSlot.Boots => config.Boots,
            _ => null
        };

        if (baseStats == null || character == null) return baseStats;

        // Apply same scaling as RecalculateEquipmentBonusesAsync
        var levelScale = 1.0 + character.Level * stageConfig.EquipmentLevelScale;
        var slotLevel = eqSlot.HasValue ? GetSlotEnhancementLevel(eqSlot.Value) : 0;
        var enhMult = 1.0 + slotLevel * stageConfig.EquipmentEnhancementBonus;

        // Use actual stored quality for equipped piece, average for inventory piece
        var qualityAvg = (stageConfig.EquipmentQualityMin + stageConfig.EquipmentQualityMax) / 2.0;
        var storedQuality = eqSlot switch
        {
            EquipmentSlot.Head => character.EquippedHeadQuality,
            EquipmentSlot.Shoulders => character.EquippedShouldersQuality,
            EquipmentSlot.Chest => character.EquippedChestQuality,
            EquipmentSlot.Gloves => character.EquippedGlovesQuality,
            EquipmentSlot.Legs => character.EquippedLegsQuality,
            EquipmentSlot.Boots => character.EquippedBootsQuality,
            _ => 0.0
        };
        var isEquipped = pendingActionIsEquipped;
        var quality = isEquipped && storedQuality > 0 ? storedQuality : qualityAvg;
        var totalMult = quality * levelScale * enhMult;

        return new EquipmentPieceStats
        {
            HP = (int)Math.Round(baseStats.HP * totalMult),
            Power = (int)Math.Round(baseStats.Power * totalMult),
            Defense = (int)Math.Round(baseStats.Defense * totalMult),
            Speed = (int)Math.Round(baseStats.Speed * totalMult),
            CriticalChance = baseStats.CriticalChance * totalMult
        };
    }

    /// <summary>Gets the enhancement level for a specific equipment slot: stageDerived + slotBonusLevel.</summary>
    private int GetSlotEnhancementLevel(EquipmentSlot slot)
    {
        var stageDerived = highestStageForEquip / 100;
        var slotBonus = character?.GetSlotBonusLevel(slot) ?? 0;
        return stageDerived + slotBonus;
    }

    private bool IsItemCurrentlyEquipped(InventoryItemType itemType)
    {
        if (character == null) return false;
        return character.EquippedHead == itemType
            || character.EquippedShoulders == itemType
            || character.EquippedChest == itemType
            || character.EquippedGloves == itemType
            || character.EquippedLegs == itemType
            || character.EquippedBoots == itemType;
    }

