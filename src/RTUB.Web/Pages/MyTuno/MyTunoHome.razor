    // Opens the unified item action modal from inventory card click
    private void OnInventoryItemClick(InventoryItemType itemType)
    {
        if (itemActioning || currentUser == null || character == null) return;
        pendingActionItem = itemType;
        pendingActionIsEquipped = IsItemCurrentlyEquipped(itemType);
        showItemActionModal = true;
    }

    // Equipment slot click (from Equipamento panel) — opens modal for equip/unequip/discard
    private void OnEquipSlotClick(InventoryItemType? itemType)
    {
        if (itemActioning || equipping || currentUser == null || character == null) return;
        if (itemType == null) return;

        pendingActionItem = itemType.Value;
        pendingActionIsEquipped = IsItemCurrentlyEquipped(itemType.Value);
        showItemActionModal = true;
    }

    // Handles Equip, Unequip, and Discard from the unified modal
    private async Task ConfirmItemAction(bool isDiscard)
    {
        if (pendingActionItem == null || currentUser == null) return;

        showItemActionModal = false;
        var item = pendingActionItem.Value;
        var wasEquipped = pendingActionIsEquipped;
        pendingActionItem = null;
        pendingActionIsEquipped = false;

        try
        {
            itemActioning = true;
            StateHasChanged();

            if (isDiscard)
            {
                // If item is currently equipped, unequip first before discarding
                if (wasEquipped)
                {
                    await UnequipItem(item);
                }
                var (success, fidelisGained, message) = await InventoryService.DiscardItemAsync(currentUser.Id, item);
                if (success)
                {
                    instrumentParts = await InventoryService.GetInstrumentPartsAsync(currentUser.Id);
                    equipmentItems = await InventoryService.GetEquipmentItemsAsync(currentUser.Id);
                    currentUser = await UserManager.FindByIdAsync(currentUser.Id);
                    toastMessage = message;
                    toastIsError = false;
                }
                else
                {
                    toastMessage = message;
                    toastIsError = true;
                }
            }
            else if (wasEquipped)
            {
                await PerformUnequip(item);
            }
            else
            {
                await EquipItem(item);
            }
        }
        finally
        {
            itemActioning = false;
            StateHasChanged();
        }
    }

    private async Task PerformUnequip(InventoryItemType itemType)
    {
        try
        {
            equipping = true;
            StateHasChanged();
            await UnequipItem(itemType);
        }
        finally
        {
            equipping = false;
            StateHasChanged();
        }
    }

