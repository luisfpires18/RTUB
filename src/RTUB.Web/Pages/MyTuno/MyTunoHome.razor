    private EquipmentPieceStats? GetEquipItemStats(InventoryItemType itemType)
    {
        var config = MyTunoConfig.Value.StageMode.EquipmentStats;
        var stageConfig = MyTunoConfig.Value.StageMode;

        // Instrument part?
        var instrType = InstrumentTypeHelper.FromInventoryPartType(itemType);
        if (instrType.HasValue)
            return config.Instrument;

        // Equipment piece?
        var eqSlot = EquipmentDropHelper.FromInventoryItemType(itemType);
        var baseStats = eqSlot switch
        {
            EquipmentSlot.Head => config.Head,
            EquipmentSlot.Shoulders => config.Shoulders,
            EquipmentSlot.Chest => config.Chest,
            EquipmentSlot.Gloves => config.Gloves,
            EquipmentSlot.Legs => config.Legs,
            EquipmentSlot.Boots => config.Boots,
            _ => null
        };

        if (baseStats == null || character == null) return baseStats;

        // Apply same scaling as RecalculateEquipmentBonusesAsync (flat per-level formula)
        var levelScale = 1.0 + character.Level * stageConfig.EquipmentLevelScale;
        var slotLevel = eqSlot.HasValue ? GetSlotEnhancementLevel(eqSlot.Value) : 0;
        var hpPerLvl = stageConfig.EquipmentHpPerLevel;
        var powPerLvl = stageConfig.EquipmentPowerPerLevel;
        var defPerLvl = stageConfig.EquipmentDefensePerLevel;

        // Use actual stored quality for equipped piece, average for inventory piece
        var qualityAvg = (stageConfig.EquipmentQualityMin + stageConfig.EquipmentQualityMax) / 2.0;
        var storedQuality = eqSlot switch
        {
            EquipmentSlot.Head => character.EquippedHeadQuality,
            EquipmentSlot.Shoulders => character.EquippedShouldersQuality,
            EquipmentSlot.Chest => character.EquippedChestQuality,
            EquipmentSlot.Gloves => character.EquippedGlovesQuality,
            EquipmentSlot.Legs => character.EquippedLegsQuality,
            EquipmentSlot.Boots => character.EquippedBootsQuality,
            _ => 0.0
        };
        var isEquipped = pendingActionIsEquipped;
        var quality = isEquipped && storedQuality > 0 ? storedQuality : qualityAvg;

        return new EquipmentPieceStats
        {
            HP = (int)Math.Round((baseStats.HP + slotLevel * hpPerLvl) * quality * levelScale),
            Power = (int)Math.Round((baseStats.Power + slotLevel * powPerLvl) * quality * levelScale),
            Defense = (int)Math.Round((baseStats.Defense + slotLevel * defPerLvl) * quality * levelScale),
            Speed = (int)Math.Round(baseStats.Speed * quality * levelScale),
            CriticalChance = baseStats.CriticalChance * quality * levelScale
        };
    }

