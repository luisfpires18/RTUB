@page "/my-tuno/survive"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.JSInterop
@using RTUB.Application.Interfaces
@using RTUB.Application.Data
@using RTUB.Application.DTOs
@using RTUB.Core.Entities
@using RTUB.Core.Enums
@using RTUB.Core.Helpers
@using RTUB.Shared
@using RTUB.Shared.Base
@using RTUB.Shared.Components.UI
@using System.Text.Json
@using Microsoft.EntityFrameworkCore
@attribute [Authorize]
@inject ISurviveModeService SurviveModeService
@inject ICharacterService CharacterService
@inject INaipeService NaipeService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject ILogger<SurviveMode> Logger
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject IAuditLogService AuditLogService
@inject IStageService StageService
@implements IAsyncDisposable

<PageTitle>Survive Mode - My Tuno - RTUB</PageTitle>

<div class="stage-page">
    @if (loading)
    {
        <div class="stage-loading">
            <LoadingSpinner />
        </div>
    }
    else if (character == null)
    {
        <div class="stage-loading">
            <EmptyState Title="Personagem não encontrado"
                        Message="Ocorreu um erro ao carregar o teu personagem."
                        Icon="bi-person-x" />
        </div>
    }
    else if (errorMessage != string.Empty)
    {
        <div class="stage-loading">
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
            </div>
        </div>
    }
    else
    {
        @* ─── Active Game ─── *@
        @if (showGame)
        {
            <div class="battle-screen">
                <div id="surviveGameContainer" class="battle-canvas"></div>

                @* ── TOP BAR: Back + Level (center) + Stats + Controls ── *@
                <div class="battle-top-bar">
                    <button class="battle-back-btn" @onclick="GoBack" title="Voltar">
                        <i class="bi bi-chevron-left"></i>
                    </button>

                    <div class="battle-floor-indicator">
                        <span class="floor-label">LEVEL</span>
                        <span class="floor-num">@currentLevel</span>
                    </div>

                    @if (levelsCompleted > 0 || totalEnemiesKilled > 0 || totalFidelis > 0)
                    {
                        <div class="battle-rewards-strip">
                            @if (levelsCompleted > 0)
                            {
                                <span class="reward-tag reward-tag--level">
                                    <i class="bi bi-check-circle-fill"></i> @Fmt(levelsCompleted) Levels
                                </span>
                            }
                            @if (totalEnemiesKilled > 0)
                            {
                                <span class="reward-tag reward-tag--kills">
                                    <i class="bi bi-crosshair"></i> @Fmt(totalEnemiesKilled)
                                </span>
                            }
                            @if (totalFidelis > 0)
                            {
                                <span class="reward-tag reward-tag--fidelis">
                                    <i class="bi bi-gem"></i> @Fmt(totalFidelis)
                                </span>
                            }
                            @if (totalFitab > 0)
                            {
                                <span class="u-c-magenta reward-tag reward-tag--drink">
                                    <i class="bi bi-lightning-fill"></i> @totalFitab FITAB
                                </span>
                            }
                            @if (totalLeitao > 0)
                            {
                                <span class="u-c-orange reward-tag reward-tag--drink">
                                    <i class="bi bi-piggy-bank"></i> @totalLeitao Leitão
                                </span>
                            }
                        </div>
                    }

                    <div class="battle-controls">
                        <button class="battle-ctrl-btn battle-ctrl-btn--audio" @onclick="ToggleAudio" title="Som">
                            <i class="bi @(audioEnabled ? "bi-volume-up" : "bi-volume-mute")"></i>
                        </button>
                        <button class="battle-ctrl-btn battle-ctrl-btn--stop" @onclick="EndRunEarly" title="Acabar">
                            <i class="bi bi-stop-fill"></i>
                        </button>
                    </div>
                </div>

                @* ── Active Buff Indicators — removed (survive mode has no buffs) ── *@
            </div>
        }

        @* ─── End Summary (mirrors Stage defeat-overlay) ─── *@
        @if (showDefeatSummary)
        {
            <div class="defeat-overlay">
                <div class="defeat-panel">
                    <div class="defeat-banner">
                        <span>SURVIVAL ENDED</span>
                    </div>
                    <div class="defeat-stage">Level @Fmt(defeatedAtLevel)</div>
                    @if (levelsCompleted > 0 || totalEnemiesKilled > 0 || totalFidelis > 0)
                    {
                        <div class="defeat-rewards">
                            @if (levelsCompleted > 0)
                            {
                                <div class="defeat-reward-row">
                                    <i class="bi bi-check-circle-fill text-success"></i>
                                    <span>@Fmt(levelsCompleted) Levels</span>
                                </div>
                            }
                            <div class="defeat-reward-row">
                                <i class="bi bi-crosshair text-info"></i>
                                <span>@Fmt(totalEnemiesKilled) Inimigos</span>
                            </div>
                            @if (totalFidelis > 0)
                            {
                                <div class="defeat-reward-row">
                                    <i class="bi bi-gem text-primary"></i>
                                    <span>@Fmt(totalFidelis) Fidelis</span>
                                </div>
                            }
                            @if (totalLeitao > 0)
                            {
                                <div class="defeat-reward-row">
                                    <i class="bi bi-piggy-bank text-warning"></i>
                                    <span>@Fmt(totalLeitao) Leitão</span>
                                </div>
                            }
                            @if (totalFitab > 0)
                            {
                                <div class="defeat-reward-row">
                                    <i class="bi bi-ticket-perforated text-info"></i>
                                    <span>@Fmt(totalFitab) FITAB</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="defeat-no-rewards">Nenhum nível completado.</p>
                    }
                    <div class="d-flex gap-2 justify-content-center">
                        <button class="defeat-btn" @onclick="RetryRun">
                            <i class="bi bi-arrow-clockwise me-1"></i>RECOMEÇAR
                        </button>
                        <button class="defeat-btn" @onclick="DefeatGoBack">
                            IR MY TUNO
                        </button>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    // ─── State ────────────────────────────────────────────────────
    private bool loading = true;
    private bool hasRendered = false;
    private bool _disposed = false;
    private string errorMessage = string.Empty;

    private Character? character;
    private ApplicationUser? currentUser;

    /// <summary>
    /// Reloads the current user from a fresh DbContext.
    /// UserManager.FindByIdAsync returns stale tracked entities from the scoped DI context.
    /// </summary>
    private async Task RefreshCurrentUserAsync()
    {
        if (currentUser == null) return;
        await using var ctx = DbContextFactory.CreateDbContext();
        var fresh = await ctx.Users.AsNoTracking().FirstOrDefaultAsync(u => u.Id == currentUser.Id);
        if (fresh != null)
            currentUser = fresh;
    }

    private SurviveModeProgress? surviveProgress;
    private DotNetObjectReference<SurviveMode>? objRef;

    // Game state
    private bool showGame = false;
    private bool showDefeatSummary = false;
    private bool runInProgress = false;
    private bool audioEnabled = true;
    private int currentLevel = 1;
    private string currentBiomeName = "Forest";

    // Run totals (rewards accumulated across the run)
    private int levelsCompleted = 0;
    private int totalEnemiesKilled = 0;
    private decimal totalFidelis = 0;
    private int totalLeitao = 0;
    private int totalFitab = 0;
    private SurviveModeLevelResult? lastResult;

    // Defeat summary
    private int defeatedAtLevel = 1;

    private readonly SemaphoreSlim _gameLock = new(1, 1);

    // Start level is now set in the DB before navigation (from MyTunoHome level selection)
    // No query parameter needed — eliminates prerender/redirect race conditions

    // ─── Lifecycle ────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated != true)
            {
                Navigation.NavigateTo("/login");
                return;
            }

            currentUser = await UserManager.GetUserAsync(user);
            if (currentUser == null)
            {
                errorMessage = "Utilizador não encontrado.";
                loading = false;
                return;
            }

            // Refresh from fresh context — scoped DI context has stale data
            await RefreshCurrentUserAsync();

            var characterTask = CharacterService.GetOrCreateCharacterAsync(currentUser.Id);
            var progressTask = SurviveModeService.GetOrCreateProgressAsync(currentUser.Id);
            var stageProgressTask = StageService.GetOrCreateStageProgressAsync(currentUser.Id);
            await Task.WhenAll(characterTask, progressTask, stageProgressTask);
            character = characterTask.Result;
            surviveProgress = progressTask.Result;
            var sp = stageProgressTask.Result;

            // Always use the player's actual progress level — no URL override allowed
            currentLevel = surviveProgress.CurrentLevel;

            currentBiomeName = SurviveModeProgress.GetBiomeName(currentLevel);

            // Cancel any stale runs
            if (surviveProgress.IsRunActive)
            {
                Logger.LogWarning("Found stale survive run for user {UserId}, cancelling.", currentUser.Id);
                await SurviveModeService.CancelRunAsync(character.Id);
                surviveProgress = await SurviveModeService.GetOrCreateProgressAsync(currentUser.Id);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading Survive Mode");
            errorMessage = "Erro ao carregar o modo Survive.";
        }
        finally
        {
            loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && character != null && !_disposed)
        {
            hasRendered = true;
            objRef = DotNetObjectReference.Create(this);

            // Auto-start the game (like Stage mode)
            await AutoStartRun();
        }
    }

    // ─── Game Flow ────────────────────────────────────────────────
    private async Task AutoStartRun()
    {
        if (character == null || currentUser == null) return;

        try
        {
            surviveProgress = await SurviveModeService.StartRunAsync(character.Id);
            // Always use the player's actual progress level
            currentLevel = surviveProgress.CurrentLevel;
            currentBiomeName = SurviveModeProgress.GetBiomeName(currentLevel);
            runInProgress = true;
            showGame = true;
            showDefeatSummary = false;
            ResetRunTotals();
            StateHasChanged();

            // Wait for the DOM to render the container
            await Task.Delay(100);
            await StartLevelGame();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error auto-starting survive run");
            errorMessage = "Erro ao iniciar a run.";
            showGame = false;
            StateHasChanged();
        }
    }

    private async Task StartLevelGame()
    {
        if (_disposed || character == null) return;

        try
        {
            var config = SurviveModeService.GetLevelConfig(currentLevel, character.Level);
            var enemySprites = await SurviveModeService.GetEnemySpritesAsync(currentLevel, 6);
            var bossSprites = await SurviveModeService.GetBossSpritesAsync(currentLevel, 4);
            var backgroundPath = SurviveModeService.GetBackgroundPath(currentLevel);

            // Get player sprite path
            var playerSpritePath = !string.IsNullOrEmpty(character.CustomSpritePath) ? character.CustomSpritePath : "/sprites/games/my-tuno/default_tuno.png";

            var levelData = new
            {
                config.Level,
                config.BiomeName,
                config.TimerDurationSeconds,
                config.BaseEnemyCount,
                config.MaxEnemyCount,
                config.SpawnIntervalSeconds,
                config.EnemySpeed,
                config.MaxEnemySpeed,
                config.PlayerSpeed,
                config.EnemyScale,
                config.HasEliteEnemies,
                config.EliteSpawnChance,
                config.MapWidth,
                config.MapHeight,
                config.ViewportWidth,
                config.ViewportHeight,
                config.IsFinalLevel,
                BackgroundPath = backgroundPath,
                EnemySprites = enemySprites.ToArray(),
                BossSprites = bossSprites.ToArray(),
                PlayerSpritePath = playerSpritePath
            };

            if (levelsCompleted == 0)
            {
                await JSRuntime.InvokeVoidAsync("surviveModeGame.start", "surviveGameContainer", levelData, objRef);
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("surviveModeGame.nextLevel", levelData);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error starting survive level {Level}", currentLevel);
            errorMessage = $"Erro ao carregar o nível {currentLevel}.";
        }
    }

    [JSInvokable]
    public async Task OnLevelComplete(int enemiesKilled, double survivalTime, int coinsCollected = 0, int bossesKilled = 0)
    {
        if (_disposed || character == null) return;

        if (!await _gameLock.WaitAsync(0))
        {
            Logger.LogWarning("OnLevelComplete called while locked");
            return;
        }

        try
        {
            var result = await SurviveModeService.CompleteLevelAsync(character.Id, enemiesKilled, survivalTime, bossesKilled);

            lastResult = result;
            levelsCompleted++;
            totalEnemiesKilled += enemiesKilled;
            totalFidelis += result.FidelisReward;
            totalLeitao += result.LeitaoDropped;
            totalFitab += result.FitabDropped;

            // Advance to next level (increment locally — don't re-read from DB
            // as progress.CurrentLevel may differ if StartLevelParam was used)
            currentLevel++;
            currentBiomeName = SurviveModeProgress.GetBiomeName(currentLevel);

            StateHasChanged();

            // Auto-start next level after brief delay
            await Task.Delay(2500);
            await StartLevelGame();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error completing survive level");
            errorMessage = "Erro ao processar conclusão do nível.";
            StateHasChanged();
        }
        finally
        {
            _gameLock.Release();
        }
    }

    [JSInvokable]
    public async Task OnPlayerDeath(int enemiesKilled, double survivalTime, int coinsCollected = 0, int bossesKilled = 0)
    {
        if (_disposed || character == null) return;

        if (!await _gameLock.WaitAsync(0))
        {
            Logger.LogWarning("OnPlayerDeath called while locked");
            return;
        }

        try
        {
            var result = await SurviveModeService.EndRunAsync(character.Id, enemiesKilled, survivalTime, bossesKilled);

            lastResult = result;
            totalEnemiesKilled += enemiesKilled;
            totalFidelis += result.FidelisReward;
            totalLeitao += result.LeitaoDropped;
            totalFitab += result.FitabDropped;
            defeatedAtLevel = currentLevel;

            // Apply accumulated rewards from entire run
            await SurviveModeService.ApplyRunRewardsAsync(
                character.Id,
                xp: 0,
                fidelis: totalFidelis,
                finos: totalLeitao,    // leitão
                canecas: totalFitab,   // fitab
                cigarros: 0, canhaos: 0, shots: 0,
                cancellationToken: default);

            // Destroy JS game
            try { await JSRuntime.InvokeVoidAsync("surviveModeGame.destroy"); }
            catch { }

            // Refresh data
            character = await CharacterService.GetOrCreateCharacterAsync(currentUser!.Id);
            await RefreshCurrentUserAsync();
            surviveProgress = await SurviveModeService.GetOrCreateProgressAsync(currentUser!.Id);

            showGame = false;
            showDefeatSummary = true;
            runInProgress = false;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error processing survive death");
            errorMessage = "Erro ao processar derrota.";
            StateHasChanged();
        }
        finally
        {
            _gameLock.Release();
        }
    }

    private async Task EndRunEarly()
    {
        if (_disposed) return;

        try
        {
            // Destroy JS game
            try { await JSRuntime.InvokeVoidAsync("surviveModeGame.destroy"); }
            catch { }

            defeatedAtLevel = currentLevel;

            // Cancel the run
            if (character != null)
            {
                await SurviveModeService.CancelRunAsync(character.Id);
            }

            // Refresh data
            if (currentUser != null)
            {
                character = await CharacterService.GetOrCreateCharacterAsync(currentUser.Id);
                await RefreshCurrentUserAsync();
                surviveProgress = await SurviveModeService.GetOrCreateProgressAsync(currentUser!.Id);
            }

            showGame = false;
            showDefeatSummary = true;
            runInProgress = false;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error ending survive run early");
        }
    }

    private async Task ToggleAudio()
    {
        audioEnabled = !audioEnabled;
        if (hasRendered)
        {
            try { await JSRuntime.InvokeVoidAsync("surviveModeGame.setAudioEnabled", audioEnabled); }
            catch { }
        }
    }

    private async Task RetryRun()
    {
        showDefeatSummary = false;
        ResetRunTotals();
        StateHasChanged();

        // Destroy any lingering JS scene
        try { await JSRuntime.InvokeVoidAsync("surviveModeGame.destroy"); }
        catch { /* scene may already be gone */ }

        // Reload character and restart
        if (character != null && currentUser != null)
        {
            character = await CharacterService.GetOrCreateCharacterAsync(currentUser.Id);
            await RefreshCurrentUserAsync();
        }

        await AutoStartRun();
    }

    private void DefeatGoBack()
    {
        Navigation.NavigateTo("/my-tuno");
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/my-tuno");
    }

    // ─── Helpers ──────────────────────────────────────────────────
    private void ResetRunTotals()
    {
        levelsCompleted = 0;
        totalEnemiesKilled = 0;
        totalFidelis = 0;
        totalLeitao = 0;
        totalFitab = 0;
        lastResult = null;
    }

    private static string Fmt(long value) => value.ToString("N0");
    private static string Fmt(decimal value) => value.ToString("N0");

    // ─── Dispose ──────────────────────────────────────────────────
    public async ValueTask DisposeAsync()
    {
        _disposed = true;

        // Cancel active run
        if (runInProgress && character != null)
        {
            try
            {
                await SurviveModeService.CancelRunAsync(character.Id);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error during survive mode disposal");
            }
        }

        if (hasRendered)
        {
            try { await JSRuntime.InvokeVoidAsync("surviveModeGame.destroy"); }
            catch { }
        }

        objRef?.Dispose();
        _gameLock.Dispose();
    }
}
