@page "/my-tuno/survive"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.JSInterop
@using RTUB.Application.Interfaces
@using RTUB.Application.Data
@using RTUB.Application.DTOs
@using RTUB.Core.Entities
@using RTUB.Core.Enums
@using RTUB.Core.Helpers
@using RTUB.Shared
@using RTUB.Shared.Base
@using RTUB.Shared.Components.UI
@using System.Text.Json
@attribute [Authorize]
@inject ISurviveModeService SurviveModeService
@inject ICharacterService CharacterService
@inject INaipeService NaipeService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject ILogger<SurviveMode> Logger
@inject IAuditLogService AuditLogService
@inject IStageService StageService
@implements IAsyncDisposable

<PageTitle>Survive Mode - My Tuno - RTUB</PageTitle>

<div class="stage-page">
    <div class="d-flex flex-column gap-3 mb-4">
        <div class="d-flex justify-content-between align-items-center gap-3">
            <button class="btn btn-outline-secondary" @onclick="GoBack" title="Voltar">
                <i class="bi bi-arrow-left"></i>
            </button>
            <div class="flex-grow-1 text-center">
                <h1 class="mb-2"><i class="bi bi-bullseye text-danger"></i> Survive Mode</h1>
            </div>
            <div style="width: 48px;"></div>
        </div>
    </div>

    @if (loading)
    {
        <LoadingSpinner />
    }
    else if (character == null)
    {
        <EmptyState Title="Personagem não encontrado"
                    Message="Ocorreu um erro ao carregar o teu personagem."
                    Icon="bi-person-x" />
    }
    else if (errorMessage != string.Empty)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
        </div>
    }
    else
    {
        @* ─── Active Game ─── *@
        @if (showGame)
        {
            <div class="battle-screen">
                <div id="surviveGameContainer" class="battle-canvas"></div>
                <div class="battle-top-bar">
                    <div class="d-flex align-items-center gap-2">
                        <h5 class="mb-0 text-white">
                            <i class="bi bi-bullseye text-danger me-2"></i>
                            Level @currentLevel — @currentBiomeName
                        </h5>
                    </div>
                    <div class="btn-group btn-group-sm" role="group">
                        <button type="button" class="btn btn-outline-warning" @onclick="ToggleAudio" title="Toggle sound">
                            <i class="bi @(audioEnabled ? "bi-volume-up" : "bi-volume-mute")"></i>
                        </button>
                        <button type="button" class="btn btn-outline-danger" @onclick="EndRunEarly" title="End Run">
                            <i class="bi bi-stop-fill me-1"></i>Acabar
                        </button>
                    </div>
                </div>
            </div>

            @* ─── Active Buff Indicators ─── *@
            @if (character != null && (character.CigarroShieldHitsRemaining > 0 || character.HasCanhaoBuff || character.HasPenaltyBuff))
            {
                <div class="d-flex gap-2 mb-3 flex-wrap">
                    @if (character.CigarroShieldHitsRemaining > 0)
                    {
                        <span class="badge bg-info fs-6">
                            <i class="bi bi-wind me-1"></i>10% Dodge @character.CigarroShieldHitsRemaining runs
                        </span>
                    }
                    @if (character.HasCanhaoBuff)
                    {
                        <span class="badge bg-info fs-6">
                            <i class="bi bi-bullseye me-1"></i>AOE @((int)(character.CanhaoBuffExpiresAt!.Value - DateTime.UtcNow).TotalMinutes)min
                        </span>
                    }
                    @if (character.HasPenaltyBuff)
                    {
                        <span class="badge bg-warning text-dark fs-6">
                            <i class="bi bi-lightning-charge-fill me-1"></i>Penalty — Lifesteal @((int)(character.PenaltyBuffExpiresAt!.Value - DateTime.UtcNow).TotalMinutes)min
                        </span>
                    }
                </div>
            }

            @* ─── Run Stats (no rewards in survive mode) ─── *@
            @if (levelsCompleted > 0)
            {
                <div class="card mb-3">
                    <div class="card-header bg-dark text-white">
                        <i class="bi bi-graph-up me-2"></i>Progresso (Nível @levelsCompleted completados)
                    </div>
                    <div class="card-body">
                        <div class="d-flex gap-3 flex-wrap">
                            @if (totalEnemiesKilled > 0)
                            {
                                <span class="badge bg-secondary"><i class="bi bi-crosshair me-1"></i>@totalEnemiesKilled Inimigos</span>
                            }
                            @if (totalCoinsCollected > 0)
                            {
                                <span class="badge bg-warning text-dark">🪙 @totalCoinsCollected Moedas</span>
                            }
                        </div>
                    </div>
                </div>
            }
        }

        @* ─── End Summary (mirrors Stage defeat-overlay) ─── *@
        @if (showDefeatSummary)
        {
            <div class="defeat-overlay">
                <div class="defeat-panel">
                    <div class="defeat-banner">
                        <span>SURVIVAL ENDED</span>
                    </div>
                    <div class="defeat-stage">Level @Fmt(defeatedAtLevel)</div>
                    @if (levelsCompleted > 0 || totalEnemiesKilled > 0)
                    {
                        <div class="defeat-rewards">
                            @if (levelsCompleted > 0)
                            {
                                <div class="defeat-reward-row">
                                    <i class="bi bi-check-circle-fill text-success"></i>
                                    <span>@Fmt(levelsCompleted) Levels</span>
                                </div>
                            }
                            <div class="defeat-reward-row">
                                <i class="bi bi-crosshair text-info"></i>
                                <span>@Fmt(totalEnemiesKilled) Inimigos</span>
                            </div>
                            @if (totalCoinsCollected > 0)
                            {
                                <div class="defeat-reward-row">
                                    <i class="bi bi-coin text-warning"></i>
                                    <span>🪙 @Fmt(totalCoinsCollected) Moedas</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="defeat-no-rewards">Nenhum nível completado.</p>
                    }
                    <button class="defeat-btn" @onclick="DefeatGoBack">
                        IR MY TUNO
                    </button>
                </div>
            </div>
        }
    }
</div>

@code {
    // ─── State ────────────────────────────────────────────────────
    private bool loading = true;
    private bool hasRendered = false;
    private bool _disposed = false;
    private string errorMessage = string.Empty;

    private Character? character;
    private ApplicationUser? currentUser;
    private SurviveModeProgress? surviveProgress;
    private DotNetObjectReference<SurviveMode>? objRef;

    // Game state
    private bool showGame = false;
    private bool showDefeatSummary = false;
    private bool runInProgress = false;
    private bool audioEnabled = true;
    private int currentLevel = 1;
    private string currentBiomeName = "Forest";

    // Run totals (stats only — no rewards in survive mode)
    private int levelsCompleted = 0;
    private int totalEnemiesKilled = 0;
    private int totalCoinsCollected = 0;
    private SurviveModeLevelResult? lastResult;

    // Defeat summary
    private int defeatedAtLevel = 1;

    private readonly SemaphoreSlim _gameLock = new(1, 1);

    // Start level is now set in the DB before navigation (from MyTunoHome level selection)
    // No query parameter needed — eliminates prerender/redirect race conditions

    // ─── Lifecycle ────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated != true)
            {
                Navigation.NavigateTo("/login");
                return;
            }

            currentUser = await UserManager.GetUserAsync(user);
            if (currentUser == null)
            {
                errorMessage = "Utilizador não encontrado.";
                loading = false;
                return;
            }

            var characterTask = CharacterService.GetOrCreateCharacterAsync(currentUser.Id);
            var progressTask = SurviveModeService.GetOrCreateProgressAsync(currentUser.Id);
            var stageProgressTask = StageService.GetOrCreateStageProgressAsync(currentUser.Id);
            await Task.WhenAll(characterTask, progressTask, stageProgressTask);
            character = characterTask.Result;
            surviveProgress = progressTask.Result;
            var sp = stageProgressTask.Result;

            // Always use the player's actual progress level — no URL override allowed
            currentLevel = surviveProgress.CurrentLevel;

            currentBiomeName = SurviveModeProgress.GetBiomeName(currentLevel);

            // Cancel any stale runs
            if (surviveProgress.IsRunActive)
            {
                Logger.LogWarning("Found stale survive run for user {UserId}, cancelling.", currentUser.Id);
                await SurviveModeService.CancelRunAsync(character.Id);
                surviveProgress = await SurviveModeService.GetOrCreateProgressAsync(currentUser.Id);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading Survive Mode");
            errorMessage = "Erro ao carregar o modo Survive.";
        }
        finally
        {
            loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && character != null && !_disposed)
        {
            hasRendered = true;
            objRef = DotNetObjectReference.Create(this);

            // Auto-start the game (like Stage mode)
            await AutoStartRun();
        }
    }

    // ─── Game Flow ────────────────────────────────────────────────
    private async Task AutoStartRun()
    {
        if (character == null || currentUser == null) return;

        try
        {
            surviveProgress = await SurviveModeService.StartRunAsync(character.Id);
            // Always use the player's actual progress level
            currentLevel = surviveProgress.CurrentLevel;
            currentBiomeName = SurviveModeProgress.GetBiomeName(currentLevel);
            runInProgress = true;
            showGame = true;
            showDefeatSummary = false;
            ResetRunTotals();
            StateHasChanged();

            // Wait for the DOM to render the container
            await Task.Delay(100);
            await StartLevelGame();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error auto-starting survive run");
            errorMessage = "Erro ao iniciar a run.";
            showGame = false;
            StateHasChanged();
        }
    }

    private async Task StartLevelGame()
    {
        if (_disposed || character == null) return;

        try
        {
            var config = SurviveModeService.GetLevelConfig(currentLevel, character.Level);
            var enemySprites = await SurviveModeService.GetEnemySpritesAsync(currentLevel, 6);
            var bossSprites = await SurviveModeService.GetBossSpritesAsync(currentLevel, 4);
            var backgroundPath = SurviveModeService.GetBackgroundPath(currentLevel);

            // Get player sprite path
            var playerSpritePath = "/sprites/games/my-tuno/default_tuno.png";

            var levelData = new
            {
                config.Level,
                config.BiomeName,
                config.TimerDurationSeconds,
                config.BaseEnemyCount,
                config.MaxEnemyCount,
                config.SpawnIntervalSeconds,
                config.EnemySpeed,
                config.MaxEnemySpeed,
                config.PlayerSpeed,
                config.EnemyScale,
                config.HasEliteEnemies,
                config.EliteSpawnChance,
                config.MapWidth,
                config.MapHeight,
                config.ViewportWidth,
                config.ViewportHeight,
                config.IsFinalLevel,
                BackgroundPath = backgroundPath,
                EnemySprites = enemySprites.ToArray(),
                BossSprites = bossSprites.ToArray(),
                PlayerSpritePath = playerSpritePath
            };

            if (levelsCompleted == 0)
            {
                await JSRuntime.InvokeVoidAsync("surviveModeGame.start", "surviveGameContainer", levelData, objRef);
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("surviveModeGame.nextLevel", levelData);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error starting survive level {Level}", currentLevel);
            errorMessage = $"Erro ao carregar o nível {currentLevel}.";
        }
    }

    [JSInvokable]
    public async Task OnLevelComplete(int enemiesKilled, double survivalTime, int coinsCollected = 0)
    {
        if (_disposed || character == null) return;

        if (!await _gameLock.WaitAsync(0))
        {
            Logger.LogWarning("OnLevelComplete called while locked");
            return;
        }

        try
        {
            var result = await SurviveModeService.CompleteLevelAsync(character.Id, enemiesKilled, survivalTime);

            lastResult = result;
            levelsCompleted++;
            totalEnemiesKilled += enemiesKilled;
            totalCoinsCollected += coinsCollected;

            // Advance to next level (increment locally — don't re-read from DB
            // as progress.CurrentLevel may differ if StartLevelParam was used)
            currentLevel++;
            currentBiomeName = SurviveModeProgress.GetBiomeName(currentLevel);

            StateHasChanged();

            // Auto-start next level after brief delay
            await Task.Delay(2500);
            await StartLevelGame();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error completing survive level");
            errorMessage = "Erro ao processar conclusão do nível.";
            StateHasChanged();
        }
        finally
        {
            _gameLock.Release();
        }
    }

    [JSInvokable]
    public async Task OnPlayerDeath(int enemiesKilled, double survivalTime, int coinsCollected = 0)
    {
        if (_disposed || character == null) return;

        if (!await _gameLock.WaitAsync(0))
        {
            Logger.LogWarning("OnPlayerDeath called while locked");
            return;
        }

        try
        {
            var result = await SurviveModeService.EndRunAsync(character.Id, enemiesKilled, survivalTime);

            lastResult = result;
            totalEnemiesKilled += enemiesKilled;
            totalCoinsCollected += coinsCollected;
            defeatedAtLevel = currentLevel;

            // Destroy JS game
            try { await JSRuntime.InvokeVoidAsync("surviveModeGame.destroy"); }
            catch { }

            // Refresh data
            character = await CharacterService.GetOrCreateCharacterAsync(currentUser!.Id);
            currentUser = await UserManager.FindByIdAsync(currentUser.Id);
            surviveProgress = await SurviveModeService.GetOrCreateProgressAsync(currentUser!.Id);

            showGame = false;
            showDefeatSummary = true;
            runInProgress = false;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error processing survive death");
            errorMessage = "Erro ao processar derrota.";
            StateHasChanged();
        }
        finally
        {
            _gameLock.Release();
        }
    }

    private async Task EndRunEarly()
    {
        if (_disposed) return;

        try
        {
            // Destroy JS game
            try { await JSRuntime.InvokeVoidAsync("surviveModeGame.destroy"); }
            catch { }

            defeatedAtLevel = currentLevel;

            // Cancel the run
            if (character != null)
            {
                await SurviveModeService.CancelRunAsync(character.Id);
            }

            // Refresh data
            if (currentUser != null)
            {
                character = await CharacterService.GetOrCreateCharacterAsync(currentUser.Id);
                currentUser = await UserManager.FindByIdAsync(currentUser.Id);
                surviveProgress = await SurviveModeService.GetOrCreateProgressAsync(currentUser!.Id);
            }

            showGame = false;
            showDefeatSummary = true;
            runInProgress = false;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error ending survive run early");
        }
    }

    private async Task ToggleAudio()
    {
        audioEnabled = !audioEnabled;
        if (hasRendered)
        {
            try { await JSRuntime.InvokeVoidAsync("surviveModeGame.setAudioEnabled", audioEnabled); }
            catch { }
        }
    }

    private void DefeatGoBack()
    {
        Navigation.NavigateTo("/my-tuno");
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/my-tuno");
    }

    // ─── Helpers ──────────────────────────────────────────────────
    private void ResetRunTotals()
    {
        levelsCompleted = 0;
        totalEnemiesKilled = 0;
        totalCoinsCollected = 0;
        lastResult = null;
    }

    private static string Fmt(long value) => value.ToString("N0");
    private static string Fmt(decimal value) => value.ToString("N0");

    // ─── Dispose ──────────────────────────────────────────────────
    public async ValueTask DisposeAsync()
    {
        _disposed = true;

        // Cancel active run
        if (runInProgress && character != null)
        {
            try
            {
                await SurviveModeService.CancelRunAsync(character.Id);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error during survive mode disposal");
            }
        }

        if (hasRendered)
        {
            try { await JSRuntime.InvokeVoidAsync("surviveModeGame.destroy"); }
            catch { }
        }

        objRef?.Dispose();
        _gameLock.Dispose();
    }
}
