@page "/my-tuno/arena"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.JSInterop
@using Microsoft.EntityFrameworkCore
@using RTUB.Application.Interfaces
@using RTUB.Application.Data
@using RTUB.Application.DTOs
@using RTUB.Core.Entities
@using RTUB.Core.Enums
@using RTUB.Core.Helpers
@using RTUB.Shared
@using RTUB.Shared.Base
@using RTUB.Shared.Components.UI
@using System.Text.Json
@using System.Text.Json.Serialization
@attribute [Authorize]
@inject ICharacterService CharacterService
@inject IBattleService BattleService
@inject ICharacterRepository CharacterRepository
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject ILogger<Arena> Logger
@inject IInventoryService InventoryService
@inject ICombatActionService CombatActionService
@implements IAsyncDisposable

<PageTitle>Arena - My Tuno - RTUB</PageTitle>

<div class="arena-page">
    <div class="d-flex flex-column gap-3 mb-4">
        <div class="d-flex justify-content-between align-items-center gap-3">
            <!-- Left: Back button -->
            <button class="btn btn-outline-secondary" @onclick="GoBack" title="Voltar">
                <i class="bi bi-arrow-left"></i>
            </button>
            
            <!-- Center: Title (takes remaining space + centers text) -->
            <div class="flex-grow-1 text-center">
                <h1 class="mb-2"><i class="bi bi-sword"></i> Arena</h1>
                <p class="lead page-header-subtitle mb-0 text-light-theme">
                    Escolhe um oponente para lutar.
                </p>
            </div>
            
            <!-- Right: Invisible spacer (maintains symmetry) -->
            <div style="width: 48px;"></div>
        </div>
    </div>

    @if (loading)
    {
        <LoadingSpinner />
    }
    else if (character == null)
    {
        <EmptyState Title="Personagem não encontrado"
                    Message="Ocorreu um erro ao carregar o teu personagem."
                    Icon="bi-person-x" />
    }
    else
    {
        <!-- Live Battle Animation -->
        @if (showBattleAnimation && currentBattle != null)
        {
            <div class="arena-battle-fullscreen">
            <div class="arena-battle-screen">
                <div id="phaserBattleContainer" class="arena-battle-canvas"></div>
                <div class="battle-top-bar">
                    <button class="battle-back-btn" @onclick="GoBack"><i class="bi bi-chevron-left"></i></button>
                    <div class="battle-floor-indicator">
                        <span class="floor-label">ARENA</span>
                    </div>
                    <div class="battle-controls">
                        <button class="battle-ctrl-btn @(battleSpeed == 1.0 ? "active" : "")" @onclick="() => SetBattleSpeed(1.0)">1x</button>
                        <button class="battle-ctrl-btn @(battleSpeed == 5.0 ? "active" : "")" @onclick="() => SetBattleSpeed(5.0)">5x</button>
                        <button class="battle-ctrl-btn battle-ctrl-btn--audio" @onclick="ToggleAudio" title="Som">
                            <i class="bi @(audioEnabled ? "bi-volume-up" : "bi-volume-mute")"></i>
                        </button>
                    </div>
                </div>
            </div>
            </div>
        }
        @if (showResultSummary && currentBattle != null)
        {
            <div class="result-overlay">
                <div class="result-panel">
                    <div class="result-banner @(currentBattle.Outcome == BattleOutcome.AttackerWon ? "result-banner-win" : "result-banner-loss")">
                        <span>@(currentBattle.Outcome == BattleOutcome.AttackerWon ? "VITÓRIA" : currentBattle.Outcome == BattleOutcome.DefenderWon ? "DERROTA" : "EMPATE")</span>
                    </div>
                    <div class="result-subtitle">Arena</div>
                    <div class="result-rewards">
                        <div class="result-reward-row">
                            <i class="bi bi-graph-up-arrow" style="color: #ffc107;"></i>
                            @if (currentBattle.RatingChange > 0)
                            {
                                <span class="text-success">+@currentBattle.RatingChange Rating</span>
                            }
                            else if (currentBattle.RatingChange < 0)
                            {
                                <span class="text-danger">@currentBattle.RatingChange Rating</span>
                            }
                            else
                            {
                                <span class="text-muted">+0 Rating</span>
                            }
                        </div>
                    </div>
                    @if (character?.ShotBuffBattlesRemaining > 0)
                    {
                        <div class="result-buff-row">
                            <i class="bi bi-droplet-fill text-info"></i>
                            <span>
                                Shot Buff ativo (@character.ShotBuffBattlesRemaining @(character.ShotBuffBattlesRemaining == 1 ? "charge" : "charges"))
                            </span>
                        </div>
                    }
                    @if (character?.CigarroShieldHitsRemaining > 0)
                    {
                        <div class="result-buff-row">
                            <i class="bi bi-wind text-info"></i>
                            <span>
                                10% Dodge @character.CigarroShieldHitsRemaining runs
                            </span>
                        </div>
                    }
                    @if (character?.CanhaoDamageBoostHitsRemaining > 0)
                    {
                        <div class="result-buff-row">
                            <i class="bi bi-bullseye text-info"></i>
                            <span>
                                @character.CanhaoDamageBoostHitsRemaining corridas com AOE
                            </span>
                        </div>
                    }
                    @if (character?.PenaltyBuffActive > 0)
                    {
                        <div class="result-buff-row">
                            <i class="bi bi-lightning-charge-fill text-warning"></i>
                            <span>
                                Penalty — Lifesteal 0.5% HP por hit
                            </span>
                        </div>
                    }
                    <div class="d-flex flex-column gap-2 mt-2 w-100">
                        <button class="result-btn" @onclick="ResultFightAgain">
                            <i class="bi bi-sword me-2"></i>LUTAR
                        </button>
                        <button class="result-btn result-btn-secondary" @onclick="ResultGoBack">
                            IR MY TUNO
                        </button>
                    </div>
                </div>
            </div>
        }

        <!-- Current Character Card -->
        @if (character != null && !showResultSummary)
        {
            var myRank = RankHelper.GetRank(character.ArenaRating);
            <div class="d-flex justify-content-center mb-4">
                <div class="arena-own-card">
                    <!-- Avatar + Name -->
                    <div class="arena-opponent-card-header">
                        @if (currentUser != null && !string.IsNullOrEmpty(currentUser.ProfilePictureSrc))
                        {
                            <img src="@CacheBuster.Bust(currentUser.ProfilePictureSrc)"
                                 alt="@GetOpponentName(character)"
                                 class="arena-opponent-avatar"
                                 loading="lazy" />
                        }
                        else
                        {
                            <div class="arena-opponent-avatar-placeholder">
                                <i class="bi bi-person"></i>
                            </div>
                        }
                        <div>
                            <h6 class="mb-0">@GetOpponentName(character)</h6>
                            <span class="badge bg-primary">Nível @character.Level</span>
                        </div>
                    </div>

                    <!-- Rank Badge -->
                    <div class="arena-opponent-rank" style="border-color: @myRank.Color;">
                        <i class="bi @myRank.Icon" style="color: @myRank.Color;"></i>
                        <span style="color: @myRank.Color; font-weight: 600;">@myRank.Name</span>
                        <span class="text-muted ms-auto" style="font-size: 0.8rem;">@character.ArenaRating</span>
                    </div>

                    <!-- Arena Record -->
                    <div class="arena-opponent-section-label"><i class="bi bi-trophy-fill me-1"></i>Registo</div>
                    <div class="arena-own-record">
                        <FantasyTile Icon="bi-graph-up-arrow" Label="Rating" Value="@Fmt(character.ArenaRating)" Color="gold" Size="sm" />
                        <FantasyTile Icon="bi-check-circle-fill" Label="Vitórias" Value="@Fmt(character.ArenaWins)" Color="green" Size="sm" />
                        <FantasyTile Icon="bi-x-circle-fill" Label="Derrotas" Value="@Fmt(character.ArenaLosses)" Color="red" Size="sm" />
                    </div>

                    <hr class="arena-opponent-divider" />

                    <!-- Player Stats -->
                    <div class="arena-opponent-section-label"><i class="bi bi-bar-chart-fill me-1"></i>Estatísticas</div>
                    <div class="arena-opponent-stats">
                        <FantasyTile Icon="bi-heart-fill" Label="HP" Value="@Fmt(character.TotalHP)" Color="red" Size="sm" />
                        <FantasyTile Icon="bi-lightning-fill" Label="Poder" Value="@Fmt(character.TotalPower)" Color="green" Size="sm" />
                        <FantasyTile Icon="bi-shield-fill" Label="Defesa" Value="@Fmt(character.TotalDefense)" Color="gray" Size="sm" />
                        <FantasyTile Icon="bi-speedometer2" Label="Velocidade" Value="@($"{character.ActionTime:F1}s")" Color="blue" Size="sm" />
                        <FantasyTile Icon="bi-bullseye" Label="Crítico" Value="@($"{character.TotalCriticalChance * 100:F1}%")" Color="yellow" Size="sm" />
                    </div>
                </div>
            </div>
        }

        <!-- Opponent Selection - Only show when battle/result is not active -->
        @if (!showBattleAnimation && !showResultSummary)
        {
            @if (opponentCharacters == null || !opponentCharacters.Any())
            {
                <EmptyState Title="Nenhum oponente disponível"
                            Message="Ainda não há outros personagens para lutar."
                            Icon="bi-person-x" />
            }
            else
            {
                <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 g-3 mb-4">
                    @foreach (var opponent in opponentCharacters)
                    {
                        var levelDiff = (character?.Level ?? 0) - opponent.Level;
                        var potentialRating = levelDiff >= 10 ? 0
                            : opponent.Level > (character?.Level ?? 0) ? 15
                            : 10;
                        var ratingColor = potentialRating == 0 ? "gray" : potentialRating >= 15 ? "#ffc107" : "#4caf50";
                        var rank = RankHelper.GetRank(opponent.ArenaRating);
                        var isFightingThis = fightingOpponentId == opponent.Id;
                        var isDisabled = fighting || showBattleAnimation;

                        <div class="col" @key="opponent.Id">
                            <div class="arena-opponent-card">
                                <!-- Avatar + Name -->
                                <div class="arena-opponent-card-header">
                                    @if (opponent.User != null && !string.IsNullOrEmpty(opponent.User.ProfilePictureSrc))
                                    {
                                        <img src="@CacheBuster.Bust(opponent.User.ProfilePictureSrc)"
                                             alt="@GetOpponentName(opponent)"
                                             class="arena-opponent-avatar"
                                             loading="lazy" />
                                    }
                                    else
                                    {
                                        <div class="arena-opponent-avatar-placeholder">
                                            <i class="bi bi-person"></i>
                                        </div>
                                    }
                                    <div>
                                        <h6 class="mb-0">@GetOpponentName(opponent)</h6>
                                        <span class="badge bg-primary">Nível @opponent.Level</span>
                                    </div>
                                </div>

                                <!-- Rank Badge -->
                                <div class="arena-opponent-rank" style="border-color: @rank.Color;">
                                    <i class="bi @rank.Icon" style="color: @rank.Color;"></i>
                                    <span style="color: @rank.Color; font-weight: 600;">@rank.Name</span>
                                    <span class="text-muted ms-auto" style="font-size: 0.8rem;">@opponent.ArenaRating</span>
                                </div>

                                <!-- Player Stats -->
                                <div class="arena-opponent-section-label"><i class="bi bi-bar-chart-fill me-1"></i>Estatísticas</div>
                                <div class="arena-opponent-stats">
                                    <FantasyTile Icon="bi-heart-fill" Label="HP" Value="@Fmt(opponent.TotalHP)" Color="red" Size="sm" />
                                    <FantasyTile Icon="bi-lightning-fill" Label="Poder" Value="@Fmt(opponent.TotalPower)" Color="green" Size="sm" />
                                    <FantasyTile Icon="bi-shield-fill" Label="Defesa" Value="@Fmt(opponent.TotalDefense)" Color="gray" Size="sm" />
                                    <FantasyTile Icon="bi-speedometer2" Label="Velocidade" Value="@($"{opponent.ActionTime:F1}s")" Color="blue" Size="sm" />
                                    <FantasyTile Icon="bi-bullseye" Label="Crítico" Value="@($"{opponent.TotalCriticalChance * 100:F1}%")" Color="yellow" Size="sm" />
                                </div>

                                <hr class="arena-opponent-divider" />

                                <!-- Rating Gain + Fight -->
                                <div class="arena-opponent-section-label"><i class="bi bi-trophy-fill me-1"></i>Recompensa</div>
                                <div class="text-center mb-2">
                                    <FantasyTile Icon="bi-graph-up-arrow"
                                                 Label="Vitória"
                                                 Value="@($"+{potentialRating}")"
                                                 Color="@(potentialRating == 0 ? "gray" : potentialRating >= 15 ? "gold" : "green")"
                                                 Size="sm"
                                                 Tooltip="Rating que ganhas se venceres" />
                                </div>

                                <button class="btn btn-primary w-100 arena-fight-btn"
                                        @onclick="() => FightOpponent(opponent)"
                                        disabled="@(isDisabled || !opponent.IsAlive())">
                                    @if (isFightingThis)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                        <text>A lutar...</text>
                                    }
                                    else
                                    {
                                        <i class="bi bi-sword me-2"></i>
                                        <text>Lutar</text>
                                    }
                                </button>
                            </div>
                        </div>
                    }
                </div>

                @if (totalItems > pageSize)
                {
                    <div class="mt-3">
                        <TablePagination CurrentPage="@currentPage"
                                        PageSize="@pageSize"
                                        TotalItems="@totalItems"
                                        ItemLabel="oponentes"
                                        PageSizeOptions="@(new[] { 20, 40, 60, 80, 100 })"
                                        OnPageChanged="@HandlePageChanged"
                                        OnPageSizeChanged="@HandlePageSizeChanged" />
                    </div>
                }
            }
        }
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <Alert Type="Alert.AlertType.Error" Message="@errorMessage" Dismissible="true" OnDismiss="() => errorMessage = string.Empty" />
    }
</div>

@code {
    private static string Fmt(long value) => NumberFormatter.Compact(value);
    private static string Fmt(decimal value) => NumberFormatter.Compact(value);

    private static string GetOpponentName(Character c)
    {
        if (c.User == null) return "Personagem";
        return !string.IsNullOrEmpty(c.User.Nickname) ? c.User.Nickname : "Personagem";
    }

    private Character? character;
    private ApplicationUser? currentUser;
    private List<Character>? allOpponentCharacters;
    private List<Character>? opponentCharacters;
    private BattleResult? currentBattle;
    private bool loading = true;
    private bool fighting = false;
    private bool showBattleAnimation = false;
    private bool showResultSummary = false;
    private int? fightingOpponentId = null;
    private string errorMessage = string.Empty;
    private DotNetObjectReference<Arena>? objRef;
    private bool hasRendered = false; // Track if component has rendered interactively

    // Pagination
    private int currentPage = 1;
    private int pageSize = 20;
    private int totalItems = 0;

    // Battle controls
    private double battleSpeed = 1.0;
    private bool audioEnabled = true;

    // Interactive combat session (spells / Blade Crafter mode)
    private CombatSession? _combatSession;
    private List<RTUB.Core.Entities.SpecialAttack>? _starterSpells;
    private Character? _currentOpponent;
    private static readonly JsonSerializerOptions _spellJsonOptions = new()
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull
    };
    
    // UI timing constant - ensures UI update completes before scrolling on mobile devices
    private const int UiUpdateDelayMs = 50;
    
    // Helper method to get display max HP accounting for buff
    // Delegates to Character.GetDisplayMaxHP()
    private static long GetDisplayMaxHP(Character? c)
    {
        if (c == null) return 0;
        return c.GetDisplayMaxHP();
    }

    protected override async Task OnInitializedAsync()
    {
        // Reset animation state on page load
        showBattleAnimation = false;
        fighting = false;
        await LoadDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // PixiJS is loaded globally via script tag in MainLayout
        // Mark that the component has been rendered interactively
        if (firstRender)
        {
            hasRendered = true;
        }
    }

    private async Task LoadDataAsync()
    {
        try
        {
            loading = true;
            errorMessage = string.Empty;

            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                currentUser = await UserManager.GetUserAsync(user);
                if (currentUser != null)
                {
                    character = await CharacterService.GetOrCreateCharacterAsync(currentUser.Id);
                    if (character != null)
                    {
                        await LoadOpponentsAsync();
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading arena data");
            errorMessage = "Erro ao carregar dados da arena.";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task LoadOpponentsAsync()
    {
        if (character == null) return;

        try
        {
            // Get all opponents ordered by level
            allOpponentCharacters = await CharacterRepository.GetArenaOpponentsAsync(character.Id);
            
            // Opponents always fight as CPU snapshots at full HP
            // Clear their HP and buff state so opponent card displays 100% HP
            foreach (var opponent in allOpponentCharacters)
            {
                opponent.CurrentHP = null; // null = full HP (TotalHP)
                opponent.ShotBuffBattlesRemaining = 0; // Don't show opponent's buff in card
            }

            totalItems = allOpponentCharacters.Count;
            ApplyPagination();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading opponents");
            errorMessage = "Erro ao carregar oponentes.";
        }
    }

    private void ApplyPagination()
    {
        if (allOpponentCharacters == null)
        {
            opponentCharacters = null;
            return;
        }

        var totalPages = Math.Max(1, (int)Math.Ceiling((double)totalItems / pageSize));
        if (currentPage > totalPages) currentPage = totalPages;
        if (currentPage < 1) currentPage = 1;

        opponentCharacters = allOpponentCharacters
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();
    }

    private Task HandlePageChanged(int page)
    {
        currentPage = page;
        ApplyPagination();
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task HandlePageSizeChanged(int newSize)
    {
        pageSize = newSize;
        currentPage = 1;
        ApplyPagination();
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task ResultFightAgain()
    {
        // Dismiss result and go back to opponent selection
        showResultSummary = false;
        currentBattle = null;
        // Reload opponents for fresh list
        if (character != null && currentUser != null)
        {
            character = await CharacterService.GetOrCreateCharacterAsync(currentUser.Id);
            await LoadOpponentsAsync();
        }
        StateHasChanged();
    }

    private async Task FightOpponent(Character opponent)
    {
        if (character == null || currentUser == null || opponent == null) return;

        // Check if character is alive
        if (!character.IsAlive())
        {
            errorMessage = "O teu personagem está derrotado. Precisa de reviver antes de lutar.";
            return;
        }

        try
        {
            fighting = true;
            fightingOpponentId = opponent.Id;
            showBattleAnimation = true;
            showResultSummary = false;
            errorMessage = string.Empty;
            currentBattle = null;
            _currentOpponent = opponent;
            StateHasChanged();

            // Scroll to battle on mobile/PWA only
            await Task.Delay(UiUpdateDelayMs);
            var isMobile = await JSRuntime.InvokeAsync<bool>("isMobileDevice");
            if (isMobile)
            {
                await JSRuntime.InvokeVoidAsync("window.scrollTo", new { top = 0, behavior = "smooth" });
            }

            // Create battle vs specific opponent (pre-computes for rewards metadata)
            currentBattle = await BattleService.CreateBattleVsOpponentAsync(character.Id, opponent.Id);

            // ── Interactive combat session (spells / Blade Crafter mode) ──
            RTUB.Core.Enums.InstrumentType? combatInstrumentType = null;
            if (character.EquippedWeapon1.HasValue)
            {
                var weapons = await InventoryService.GetForgedWeaponsAsync(currentUser.Id);
                var equippedWeapon = weapons.FirstOrDefault(w => w.Id == character.EquippedWeapon1.Value);
                if (equippedWeapon != null)
                    combatInstrumentType = InstrumentTypeHelper.FromInventoryPartType(equippedWeapon.SourceInstrument);
            }
            _starterSpells = null; // Special attacks disabled in Arena (Battle Mode)

            // Create CPU snapshot at full HP for the interactive session.
            // Use buffed copies when consumable buffs are active (matches the pre-computed engine).
            var opponentSnapshot = Character.CreateCpuSnapshot(opponent);
            Character sessionChar = character;
            if (character.ShotBuffBattlesRemaining > 0)
                sessionChar = Character.CreateShotBuffedCopy(character);
            _combatSession = CombatActionService.CreateSession(
                sessionChar,
                new List<Character> { opponentSnapshot },
                currentBattle.Seed,
                _starterSpells,
                "arena");

            // Start live battle animation via pixiBattle.js (interactive mode)
            if (!string.IsNullOrEmpty(currentBattle.ReplayJson))
            {
                try
                {
                    objRef ??= DotNetObjectReference.Create(this);

                    // Wait for container to be rendered
                    StateHasChanged();
                    await Task.Delay(100);

                    var battleData = new
                    {
                        EventsJson = currentBattle.ReplayJson,
                        DotNetRef = objRef,
                        AttackerName = character.User?.Nickname ?? character.User?.UserName ?? "Jogador",
                        DefenderName = opponent.User?.Nickname ?? opponent.User?.UserName ?? "Oponente",
                        BattleSpeed = battleSpeed,
                        HasShotBuff = character.ShotBuffBattlesRemaining > 0,
                        // ── Interactive combat data ──
                        InteractiveMode = true,
                        PlayerHP = _combatSession!.Player.CurrentHP,
                        PlayerMaxHP = _combatSession.Player.MaxHP,
                        PlayerActionTime = _combatSession.Player.ActionTimeSeconds,
                        Enemies = _combatSession.Enemies.Select((e, i) => new
                        {
                            e.Name,
                            HP = e.CurrentHP,
                            e.MaxHP,
                            ActionTime = e.ActionTimeSeconds
                        }),
                        Spells = Array.Empty<object>()
                    };

                    await JSRuntime.InvokeVoidAsync("myTunoGame.startBattle", "phaserBattleContainer", battleData);
                }
                catch (JSException ex)
                {
                    Logger.LogError(ex, "Error starting battle animation: {Message}", ex.Message);
                    errorMessage = "Erro ao iniciar a animação da batalha.";
                    showBattleAnimation = false;
                    StateHasChanged();
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Unexpected error starting battle animation");
                    errorMessage = "Erro inesperado ao iniciar a animação da batalha.";
                    showBattleAnimation = false;
                    StateHasChanged();
                }
            }
            else
            {
                showBattleAnimation = false;
            }

            // Reload character to show updated stats
            character = await CharacterService.GetOrCreateCharacterAsync(currentUser.Id);
            currentUser = await UserManager.FindByIdAsync(currentUser.Id);
            await LoadOpponentsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error starting battle");
            errorMessage = $"Erro ao iniciar batalha: {ex.Message}";
            showBattleAnimation = false;
        }
        finally
        {
            fighting = false;
            fightingOpponentId = null;
            // Reset showBattleAnimation if battle creation failed or has no replay data
            // If battle has replay data, let JS callback handle resetting it
            if (currentBattle == null || string.IsNullOrEmpty(currentBattle.ReplayJson))
            {
                showBattleAnimation = false;
            }
            StateHasChanged(); // Ensure UI updates
        }
    }

    // ── Interactive combat JSInvokable methods (Blade Crafter spell system) ──

    /// <summary>
    /// Called by JS when the player's speed bar fills — auto-attack fires.
    /// Returns CombatActionResult JSON for JS to animate.
    /// </summary>
    [JSInvokable]
    public Task<string> OnPlayerAutoAttack()
    {
        if (_combatSession == null || _combatSession.IsComplete)
            return Task.FromResult("{}");

        var result = CombatActionService.ProcessPlayerAutoAttack(_combatSession);
        return Task.FromResult(JsonSerializer.Serialize(result, _spellJsonOptions));
    }

    /// <summary>
    /// Called by JS when the user clicks a spell button.
    /// Returns CombatActionResult JSON for JS to animate.
    /// </summary>
    [JSInvokable]
    public Task<string> OnPlayerSpell(string attackId)
    {
        if (_combatSession == null || _combatSession.IsComplete)
            return Task.FromResult("{}");

        var result = CombatActionService.ProcessPlayerSpell(_combatSession, attackId);
        return Task.FromResult(JsonSerializer.Serialize(result, _spellJsonOptions));
    }

    /// <summary>
    /// Called by JS when an enemy's speed bar fills — enemy auto-attack fires.
    /// Returns CombatActionResult JSON for JS to animate.
    /// </summary>
    [JSInvokable]
    public Task<string> OnEnemyAttack(int enemyIndex)
    {
        if (_combatSession == null || _combatSession.IsComplete)
            return Task.FromResult("{}");

        var result = CombatActionService.ProcessEnemyAttack(_combatSession, enemyIndex);
        return Task.FromResult(JsonSerializer.Serialize(result, _spellJsonOptions));
    }

    /// <summary>
    /// Called by JS on each tick to advance spell cooldowns.
    /// Returns updated cooldown map.
    /// </summary>
    [JSInvokable]
    public Task<string> OnTickCooldowns(double elapsedSeconds)
    {
        if (_combatSession == null || _combatSession.IsComplete)
            return Task.FromResult("{}");

        var cooldowns = CombatActionService.TickCooldowns(_combatSession, elapsedSeconds);

        var result = new Dictionary<string, object>
        {
            ["spells"] = cooldowns,
            ["consumables"] = new Dictionary<string, double>(_combatSession.ConsumableCooldowns)
        };
        return Task.FromResult(JsonSerializer.Serialize(result, _spellJsonOptions));
    }

    [JSInvokable]
    public async Task OnBattleFinished()
    {
        showBattleAnimation = false;
        
        // Destroy the game (stops music and sounds)
        try
        {
            await JSRuntime.InvokeVoidAsync("myTunoGame.destroyBattle");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Error destroying arena battle game");
        }

        // Use interactive session outcome if available
        if (_combatSession != null && currentBattle != null)
        {
            var didWin = _combatSession.Winner == _combatSession.Player.Identifier;
            currentBattle.Outcome = didWin ? BattleOutcome.AttackerWon : BattleOutcome.DefenderWon;
            // Sync interactive session state back to BattleResult so FinalizeAndApplyRewardsAsync
            // persists the correct buff remaining counts and HP (not the pre-computed ones).
            currentBattle.AttackerFinalHP = _combatSession.Player.CurrentHP;
        }
        _combatSession = null;
        
        // Apply rewards now that battle animation has finished
        if (currentBattle != null)
        {
            try
            {
                var rewardsApplied = await BattleService.FinalizeAndApplyRewardsAsync(currentBattle);
                if (rewardsApplied)
                {
                    // Reload character to show updated stats
                    if (currentUser != null)
                    {
                        character = await CharacterService.GetOrCreateCharacterAsync(currentUser.Id);
                        currentUser = await UserManager.FindByIdAsync(currentUser.Id);
                    }
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error finalizing battle {BattleId}", currentBattle.BattleId);
            }
        }
        
        // Show the result summary panel
        showResultSummary = true;
        StateHasChanged();
    }

    private async Task SetBattleSpeed(double speed)
    {
        // Clamp to allowed values to prevent exploit via tampered calls
        speed = speed switch { 5.0 => 5.0, _ => 1.0 };
        battleSpeed = speed;
        try
        {
            await JSRuntime.InvokeVoidAsync("myTunoGame.setSpeed", speed);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Error setting battle speed");
        }
    }

    private async Task ToggleAudio()
    {
        audioEnabled = !audioEnabled;
        try
        {
            await JSRuntime.InvokeVoidAsync("myTunoGame.toggleAudio");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Error toggling audio");
        }
    }

    private void GoBack()
    {
        // Prevent navigation while battle is in progress
        if (fighting || showBattleAnimation)
        {
            return;
        }
        Navigation.NavigateTo("/my-tuno");
    }

    private void ResultGoBack()
    {
        showResultSummary = false;
        currentBattle = null;
        Navigation.NavigateTo("/my-tuno");
    }

    public async ValueTask DisposeAsync()
    {
        _combatSession = null;

        // Only attempt JS calls if the component has been rendered interactively
        if (hasRendered)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("myTunoGame.destroyBattle");
            }
            catch (JSDisconnectedException)
            {
                // Ignore if JS context is disconnected
            }
            catch (InvalidOperationException)
            {
                // Ignore if JS interop is not available (e.g., during static rendering)
            }
        }
        
        objRef?.Dispose();
    }
}
