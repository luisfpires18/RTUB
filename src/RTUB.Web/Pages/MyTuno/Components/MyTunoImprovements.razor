@using RTUB.Application.Configuration
@using RTUB.Application.Interfaces
@using RTUB.Core.Enums
@using RTUB.Core.Configuration
@using RTUB.Core.Helpers
@using Microsoft.Extensions.Options
@inject IImprovementService ImprovementService
@inject IOptions<MyTunoScalingConfiguration> MyTunoConfig

<div class="card h-100">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0"><i class="bi bi-gem me-2"></i>Melhorias</h5>
    </div>
    <div class="card-body p-2">
        <div class="d-flex flex-column gap-2">

        <!-- Energy Amount Upgrade Row -->
        <div class="enhance-row @(IsEnergyAmountMaxed ? "enhance-row--maxed" : "")">
            <div class="enhance-row__icon enhance-row__icon--energy">
                <i class="bi bi-battery-charging"></i>
            </div>
            <div class="enhance-row__info">
                <div class="enhance-row__title">Energia <span class="enhance-row__level">Lv@(Character.EnergyAmountUpgrades)</span></div>
                <div class="enhance-row__desc">Aumentar capacidade de energia</div>
                <div class="enhance-row__stat">
                    @if (IsEnergyAmountMaxed)
                    {
                        <text>@Character.EffectiveMaxEnergy</text>
                    }
                    else
                    {
                        var nextMaxEnergy = MyTunoScaling.BaseMaxEnergy + (int)((Character.EnergyAmountUpgrades + 1) * MyTunoScaling.EnergyAmountPerUpgrade);
                        <text>@Character.EffectiveMaxEnergy → <span class="text-success">@nextMaxEnergy</span></text>
                    }
                </div>
            </div>
            <div class="enhance-row__action">
                <button class="btn enhance-row__btn @(IsEnergyAmountMaxed ? "enhance-row__btn--maxed" : "")"
                        @onclick="() => RequestPurchase(ImprovementType.EnergyAmount)"
                        disabled="@(Purchasing || energyAmountCostLoading || IsEnergyAmountMaxed || FidelisBalance < energyAmountCost || (energyAmountLeitaoCost > 0 && LeitaoBalance < energyAmountLeitaoCost))">
                    @if (Purchasing && PurchasingType == ImprovementType.EnergyAmount)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    else
                    {
                        <text>Aumentar</text>
                    }
                </button>
                <div class="enhance-row__cost">
                    @if (IsEnergyAmountMaxed)
                    {
                        <i class="bi bi-coin"></i> <span>Max</span>
                    }
                    else if (energyAmountCostLoading)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    else
                    {
                        <i class="bi bi-coin"></i> <span>@FormatCost(energyAmountCost)</span>
                        @if (energyAmountLeitaoCost > 0)
                        {
                            <br /><span class="@(LeitaoBalance < energyAmountLeitaoCost ? "text-danger" : "")" title="Leitões">🐷 @energyAmountLeitaoCost</span>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- Energy Regen Upgrade Row -->
        <div class="enhance-row @(IsEnergyRegenMaxed ? "enhance-row--maxed" : "")">
            <div class="enhance-row__icon enhance-row__icon--regen">
                <i class="bi bi-arrow-repeat"></i>
            </div>
            <div class="enhance-row__info">
                <div class="enhance-row__title">Regeneração <span class="enhance-row__level">Lv@(Character.EnergyRegenUpgrades)</span></div>
                <div class="enhance-row__desc">Aumentar velocidade de regeneração</div>
                <div class="enhance-row__stat">
                    @if (IsEnergyRegenMaxed)
                    {
                        <text>@Character.EffectiveRegenInterval.ToString("F0")s</text>
                    }
                    else
                    {
                        var nextRegen = Math.Max(5.0, MyTunoScaling.BaseRegenInterval - (Character.EnergyRegenUpgrades + 1) * MyTunoScaling.RegenReductionPerUpgrade);
                        <text>@Character.EffectiveRegenInterval.ToString("F0")s → <span class="text-success">@nextRegen.ToString("F0")s</span></text>
                    }
                </div>
            </div>
            <div class="enhance-row__action">
                <button class="btn enhance-row__btn @(IsEnergyRegenMaxed ? "enhance-row__btn--maxed" : "")"
                        @onclick="() => RequestPurchase(ImprovementType.EnergyRegen)"
                        disabled="@(Purchasing || energyRegenCostLoading || IsEnergyRegenMaxed || FidelisBalance < energyRegenCost || (energyRegenLeitaoCost > 0 && LeitaoBalance < energyRegenLeitaoCost))">
                    @if (Purchasing && PurchasingType == ImprovementType.EnergyRegen)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    else
                    {
                        <text>Aumentar</text>
                    }
                </button>
                <div class="enhance-row__cost">
                    @if (IsEnergyRegenMaxed)
                    {
                        <i class="bi bi-coin"></i> <span>Max</span>
                    }
                    else if (energyRegenCostLoading)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    else
                    {
                        <i class="bi bi-coin"></i> <span>@FormatCost(energyRegenCost)</span>
                        @if (energyRegenLeitaoCost > 0)
                        {
                            <br /><span class="@(LeitaoBalance < energyRegenLeitaoCost ? "text-danger" : "")" title="Leitões">🐷 @energyRegenLeitaoCost</span>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- Cast Speed Upgrade Row -->
        <div class="enhance-row @(IsCastSpeedMaxed ? "enhance-row--maxed" : "")">
            <div class="enhance-row__icon enhance-row__icon--regen">
                <i class="bi bi-stopwatch"></i>
            </div>
            <div class="enhance-row__info">
                <div class="enhance-row__title">Destilação <span class="enhance-row__level">Lv@(Character.CastSpeedUpgrades)</span></div>
                <div class="enhance-row__desc">Reduz o casting time da destilação</div>
                <div class="enhance-row__stat">
                    @if (IsCastSpeedMaxed)
                    {
                        <text>@Character.EffectiveCastTime.ToString("F1")s</text>
                    }
                    else
                    {
                        var nextCast = Math.Max(MyTunoConfig.Value.Improvements.MinCastTime, Character.EffectiveCastTime - MyTunoConfig.Value.Improvements.CastSpeed.FlatBonus);
                        <text>@Character.EffectiveCastTime.ToString("F1")s → <span class="text-success">@nextCast.ToString("F1")s</span></text>
                    }
                </div>
            </div>
            <div class="enhance-row__action">
                <button class="btn enhance-row__btn @(IsCastSpeedMaxed ? "enhance-row__btn--maxed" : "")"
                        @onclick="() => RequestPurchase(ImprovementType.CastSpeed)"
                        disabled="@(Purchasing || castSpeedCostLoading || IsCastSpeedMaxed || FidelisBalance < castSpeedCost || (castSpeedLeitaoCost > 0 && LeitaoBalance < castSpeedLeitaoCost))">
                    @if (Purchasing && PurchasingType == ImprovementType.CastSpeed)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    else
                    {
                        <text>Aumentar</text>
                    }
                </button>
                <div class="enhance-row__cost">
                    @if (IsCastSpeedMaxed)
                    {
                        <i class="bi bi-coin"></i> <span>Max</span>
                    }
                    else if (castSpeedCostLoading)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    else
                    {
                        <i class="bi bi-coin"></i> <span>@FormatCost(castSpeedCost)</span>
                        @if (castSpeedLeitaoCost > 0)
                        {
                            <br /><span class="@(LeitaoBalance < castSpeedLeitaoCost ? "text-danger" : "")" title="Leit\u00f5es">🐷 @castSpeedLeitaoCost</span>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Character Character { get; set; } = default!;
    [Parameter] public decimal FidelisBalance { get; set; }
    [Parameter] public int LeitaoBalance { get; set; }
    [Parameter] public bool Purchasing { get; set; }
    [Parameter] public ImprovementType? PurchasingType { get; set; }
    [Parameter] public EventCallback<ImprovementType> OnPurchaseRequested { get; set; }

    private decimal energyAmountCost, energyRegenCost, castSpeedCost;
    private int energyAmountLeitaoCost, energyRegenLeitaoCost, castSpeedLeitaoCost;
    private bool energyAmountCostLoading = true, energyRegenCostLoading = true, castSpeedCostLoading = true;

    private int MaxEnergyAmountUpgrades => MyTunoConfig.Value.Improvements.EnergyAmount.MaxUpgrades;
    private int MaxEnergyRegenUpgrades => MyTunoConfig.Value.Improvements.EnergyRegen.MaxUpgrades;

    private bool IsEnergyAmountMaxed => MaxEnergyAmountUpgrades > 0 && Character.EnergyAmountUpgrades >= MaxEnergyAmountUpgrades;
    private bool IsEnergyRegenMaxed => (MaxEnergyRegenUpgrades > 0 && Character.EnergyRegenUpgrades >= MaxEnergyRegenUpgrades) || Character.EffectiveRegenInterval <= 5.0;
    private bool IsCastSpeedMaxed => Character.EffectiveCastTime <= MyTunoConfig.Value.Improvements.MinCastTime;

    protected override void OnParametersSet()
    {
        LoadCostsFromCharacter();
    }

    private void LoadCostsFromCharacter()
    {
        try
        {
            var costs = ImprovementService.GetAllImprovementCosts(Character);
            energyAmountCost = costs.GetValueOrDefault(ImprovementType.EnergyAmount);
            energyRegenCost = costs.GetValueOrDefault(ImprovementType.EnergyRegen);
            castSpeedCost = costs.GetValueOrDefault(ImprovementType.CastSpeed);

            // Leitão costs
            var p = MyTunoConfig.Value.BossMode.Piggies;
            energyAmountLeitaoCost = PiggiesCostConfig.CalculateCost(Character.EnergyAmountUpgrades, p.ImprovementStartLevel, p.ImprovementBaseCost, p.ImprovementCostEveryNLevels);
            energyRegenLeitaoCost = PiggiesCostConfig.CalculateCost(Character.EnergyRegenUpgrades, p.ImprovementStartLevel, p.ImprovementBaseCost, p.ImprovementCostEveryNLevels);
            castSpeedLeitaoCost = PiggiesCostConfig.CalculateCost(Character.CastSpeedUpgrades, p.ImprovementStartLevel, p.ImprovementBaseCost, p.ImprovementCostEveryNLevels);
        }
        catch
        {
            // Costs stay at 0
        }
        finally
        {
            energyAmountCostLoading = false;
            energyRegenCostLoading = false;
            castSpeedCostLoading = false;
        }
    }

    private async Task RequestPurchase(ImprovementType improvementType)
    {
        await OnPurchaseRequested.InvokeAsync(improvementType);
    }

    private static string FormatCost(decimal cost) => NumberFormatter.Compact(cost);
}
