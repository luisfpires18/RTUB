@using RTUB.Application.Configuration
@using RTUB.Application.Interfaces
@using RTUB.Core.Enums
@using RTUB.Core.Configuration
@using RTUB.Core.Helpers
@using RTUB.Core.Utilities
@using Microsoft.Extensions.Options
@inject IImprovementService ImprovementService
@inject IConsumableUpgradeService ConsumableUpgradeService
@inject IOptions<MyTunoScalingConfiguration> MyTunoConfig

<div class="card h-100">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0"><i class="bi bi-gem me-2"></i>Melhorias</h5>
    </div>
    <div class="card-body p-2">
        <div class="d-flex flex-column gap-2">

        <!-- Energy Amount Upgrade Row -->
        <div class="enhance-row @(IsEnergyAmountMaxed ? "enhance-row--maxed" : "")">
            <div class="enhance-row__icon enhance-row__icon--energy">
                <i class="bi bi-battery-charging"></i>
            </div>
            <div class="enhance-row__info">
                <div class="enhance-row__title">Energia <span class="enhance-row__level">Lv@(Character.EnergyAmountUpgrades)</span></div>
                <div class="enhance-row__desc">Aumentar capacidade de energia</div>
                <div class="enhance-row__stat">
                    @if (IsEnergyAmountMaxed)
                    {
                        <text>@Character.EffectiveMaxEnergy</text>
                    }
                    else
                    {
                        var nextMaxEnergy = MyTunoScaling.BaseMaxEnergy + (int)((Character.EnergyAmountUpgrades + 1) * MyTunoScaling.EnergyAmountPerUpgrade);
                        <text>@Character.EffectiveMaxEnergy → <span class="text-success">@nextMaxEnergy</span></text>
                    }
                </div>
            </div>
            <div class="enhance-row__action">
                <button class="btn enhance-row__btn @(IsEnergyAmountMaxed ? "enhance-row__btn--maxed" : "")"
                        @onclick="() => RequestPurchase(ImprovementType.EnergyAmount)"
                        disabled="@(Purchasing || energyAmountCostLoading || IsEnergyAmountMaxed || FidelisBalance < energyAmountCost || (energyAmountLeitaoCost > 0 && LeitaoBalance < energyAmountLeitaoCost))">
                    @if (Purchasing && PurchasingType == ImprovementType.EnergyAmount)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    else
                    {
                        <text>Aumentar</text>
                    }
                </button>
                <div class="enhance-row__cost">
                    @if (IsEnergyAmountMaxed)
                    {
                        <i class="bi bi-coin"></i> <span>Max</span>
                    }
                    else if (energyAmountCostLoading)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    else
                    {
                        <i class="bi bi-coin"></i> <span>@FormatCost(energyAmountCost)</span>
                        @if (energyAmountLeitaoCost > 0)
                        {
                            <br /><span class="@(LeitaoBalance < energyAmountLeitaoCost ? "text-danger" : "")" title="Leitões">🐷 @energyAmountLeitaoCost</span>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- Energy Regen Upgrade Row -->
        <div class="enhance-row @(IsEnergyRegenMaxed ? "enhance-row--maxed" : "")">
            <div class="enhance-row__icon enhance-row__icon--regen">
                <i class="bi bi-arrow-repeat"></i>
            </div>
            <div class="enhance-row__info">
                <div class="enhance-row__title">Regeneração <span class="enhance-row__level">Lv@(Character.EnergyRegenUpgrades)</span></div>
                <div class="enhance-row__desc">Aumentar velocidade de regeneração</div>
                <div class="enhance-row__stat">
                    @if (IsEnergyRegenMaxed)
                    {
                        <text>@Character.EffectiveRegenInterval.ToString("F0")s</text>
                    }
                    else
                    {
                        var nextRegen = Math.Max(5.0, MyTunoScaling.BaseRegenInterval - (Character.EnergyRegenUpgrades + 1) * MyTunoScaling.RegenReductionPerUpgrade);
                        <text>@Character.EffectiveRegenInterval.ToString("F0")s → <span class="text-success">@nextRegen.ToString("F0")s</span></text>
                    }
                </div>
            </div>
            <div class="enhance-row__action">
                <button class="btn enhance-row__btn @(IsEnergyRegenMaxed ? "enhance-row__btn--maxed" : "")"
                        @onclick="() => RequestPurchase(ImprovementType.EnergyRegen)"
                        disabled="@(Purchasing || energyRegenCostLoading || IsEnergyRegenMaxed || FidelisBalance < energyRegenCost || (energyRegenLeitaoCost > 0 && LeitaoBalance < energyRegenLeitaoCost))">
                    @if (Purchasing && PurchasingType == ImprovementType.EnergyRegen)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    else
                    {
                        <text>Aumentar</text>
                    }
                </button>
                <div class="enhance-row__cost">
                    @if (IsEnergyRegenMaxed)
                    {
                        <i class="bi bi-coin"></i> <span>Max</span>
                    }
                    else if (energyRegenCostLoading)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    else
                    {
                        <i class="bi bi-coin"></i> <span>@FormatCost(energyRegenCost)</span>
                        @if (energyRegenLeitaoCost > 0)
                        {
                            <br /><span class="@(LeitaoBalance < energyRegenLeitaoCost ? "text-danger" : "")" title="Leitões">🐷 @energyRegenLeitaoCost</span>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- Cast Speed Upgrade Row -->
        <div class="enhance-row @(IsCastSpeedMaxed ? "enhance-row--maxed" : "")">
            <div class="enhance-row__icon enhance-row__icon--regen">
                <i class="bi bi-stopwatch"></i>
            </div>
            <div class="enhance-row__info">
                <div class="enhance-row__title">Destilação <span class="enhance-row__level">Lv@(Character.CastSpeedUpgrades)</span></div>
                <div class="enhance-row__desc">Reduz o casting time da destilação</div>
                <div class="enhance-row__stat">
                    @if (IsCastSpeedMaxed)
                    {
                        <text>@Character.EffectiveCastTime.ToString("F1")s</text>
                    }
                    else
                    {
                        var nextCast = Math.Max(MyTunoConfig.Value.Improvements.MinCastTime, Character.EffectiveCastTime - MyTunoConfig.Value.Improvements.CastSpeed.FlatBonus);
                        <text>@Character.EffectiveCastTime.ToString("F1")s → <span class="text-success">@nextCast.ToString("F1")s</span></text>
                    }
                </div>
            </div>
            <div class="enhance-row__action">
                <button class="btn enhance-row__btn @(IsCastSpeedMaxed ? "enhance-row__btn--maxed" : "")"
                        @onclick="() => RequestPurchase(ImprovementType.CastSpeed)"
                        disabled="@(Purchasing || castSpeedCostLoading || IsCastSpeedMaxed || FidelisBalance < castSpeedCost || (castSpeedLeitaoCost > 0 && LeitaoBalance < castSpeedLeitaoCost))">
                    @if (Purchasing && PurchasingType == ImprovementType.CastSpeed)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    else
                    {
                        <text>Aumentar</text>
                    }
                </button>
                <div class="enhance-row__cost">
                    @if (IsCastSpeedMaxed)
                    {
                        <i class="bi bi-coin"></i> <span>Max</span>
                    }
                    else if (castSpeedCostLoading)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    else
                    {
                        <i class="bi bi-coin"></i> <span>@FormatCost(castSpeedCost)</span>
                        @if (castSpeedLeitaoCost > 0)
                        {
                            <br /><span class="@(LeitaoBalance < castSpeedLeitaoCost ? "text-danger" : "")" title="Leitões">🐷 @castSpeedLeitaoCost</span>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- Double Gathering (Destilaria) Upgrade Row -->
        <div class="enhance-row @(IsDoubleGatheringMaxed ? "enhance-row--maxed" : "")">
            <div class="enhance-row__icon enhance-row__icon--energy" style="background: linear-gradient(135deg, #ff6b35, #ff9500);">
                <i class="bi bi-fire"></i>
            </div>
            <div class="enhance-row__info">
                <div class="enhance-row__title">Destilaria <span class="enhance-row__level">Lv@(Character.DoubleGatheringUpgrades)</span></div>
                <div class="enhance-row__desc">Chance de destilação dupla</div>
                <div class="enhance-row__stat">
                    @if (IsDoubleGatheringMaxed)
                    {
                        <text>@((Character.DoubleGatheringChance * 100).ToString("F0"))%</text>
                    }
                    else
                    {
                        var nextChance = Math.Min(MyTunoConfig.Value.Improvements.MaxDoubleGatheringChance, (Character.DoubleGatheringUpgrades + 1) * MyTunoScaling.DoubleGatheringChancePerUpgrade);
                        <text>@((Character.DoubleGatheringChance * 100).ToString("F0"))% → <span class="text-success">@((nextChance * 100).ToString("F0"))%</span></text>
                    }
                </div>
            </div>
            <div class="enhance-row__action">
                <button class="btn enhance-row__btn @(IsDoubleGatheringMaxed ? "enhance-row__btn--maxed" : "")"
                        @onclick="() => RequestPurchase(ImprovementType.DoubleGathering)"
                        disabled="@(Purchasing || doubleGatheringCostLoading || IsDoubleGatheringMaxed || FidelisBalance < doubleGatheringCost || (doubleGatheringLeitaoCost > 0 && LeitaoBalance < doubleGatheringLeitaoCost))">
                    @if (Purchasing && PurchasingType == ImprovementType.DoubleGathering)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    else
                    {
                        <text>Aumentar</text>
                    }
                </button>
                <div class="enhance-row__cost">
                    @if (IsDoubleGatheringMaxed)
                    {
                        <i class="bi bi-coin"></i> <span>Max</span>
                    }
                    else if (doubleGatheringCostLoading)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    else
                    {
                        <i class="bi bi-coin"></i> <span>@FormatCost(doubleGatheringCost)</span>
                        @if (doubleGatheringLeitaoCost > 0)
                        {
                            <br /><span class="@(LeitaoBalance < doubleGatheringLeitaoCost ? "text-danger" : "")" title="Leitões">🐷 @doubleGatheringLeitaoCost</span>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- Separator: Consumable Upgrades -->
        <div class="mt-2 mb-1 px-1">
            <small class="text-muted fw-bold text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.05em;">Consumíveis</small>
            <hr class="mt-1 mb-0" style="border-color: rgba(255,255,255,0.15);" />
        </div>

        <!-- Cigarro Dodge Upgrade Row -->
        <div class="enhance-row @(IsCigarroDodgeMaxed ? "enhance-row--maxed" : "")">
            <div class="enhance-row__icon" style="background: linear-gradient(135deg, #6c757d, #495057);">
                @if (GetConsumableImage("Cigarro") is string cigarroImg)
                {
                    <img src="@CacheBuster.Bust(cigarroImg)" alt="Cigarro" class="enhance-row__img" />
                }
                else
                {
                    <span style="font-size: 1.1rem;">🚬</span>
                }
            </div>
            <div class="enhance-row__info">
                <div class="enhance-row__title">Cigarro <span class="enhance-row__level">Lv@(Character.CigarroDodgeUpgrades)/@(MaxCigarroDodgeRanks)</span></div>
                <div class="enhance-row__desc">Aumentar chance de dodge</div>
                <div class="enhance-row__stat">
                    @if (IsCigarroDodgeMaxed)
                    {
                        <text>@((Character.EffectiveCigarroDodgeChance * 100).ToString("F0"))%</text>
                    }
                    else
                    {
                        var nextDodge = Math.Min(MyTunoScaling.MaxCigarroDodge, Character.EffectiveCigarroDodgeChance + MyTunoScaling.CigarroDodgePerUpgrade);
                        <text>@((Character.EffectiveCigarroDodgeChance * 100).ToString("F0"))% → <span class="text-success">@((nextDodge * 100).ToString("F0"))%</span></text>
                    }
                </div>
            </div>
            <div class="enhance-row__action">
                <button class="btn enhance-row__btn @(IsCigarroDodgeMaxed ? "enhance-row__btn--maxed" : "")"
                        @onclick="() => RequestConsumablePurchase(ConsumableUpgradeType.CigarroDodge)"
                        disabled="@(ConsumablePurchasing || cigarroDodgeCostLoading || IsCigarroDodgeMaxed || FidelisBalance < cigarroDodgeCost)">
                    @if (ConsumablePurchasing && ConsumablePurchasingType == ConsumableUpgradeType.CigarroDodge)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    else
                    {
                        <text>Aumentar</text>
                    }
                </button>
                <div class="enhance-row__cost">
                    @if (IsCigarroDodgeMaxed)
                    {
                        <i class="bi bi-coin"></i> <span>Max</span>
                    }
                    else if (cigarroDodgeCostLoading)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    else
                    {
                        <i class="bi bi-coin"></i> <span>@FormatCost(cigarroDodgeCost)</span>
                    }
                </div>
            </div>
        </div>

        <!-- Shot Buff Upgrade Row -->
        <div class="enhance-row @(IsShotBuffMaxed ? "enhance-row--maxed" : "")">
            <div class="enhance-row__icon" style="background: linear-gradient(135deg, #d4a017, #b8860b);">
                @if (GetConsumableImage("Shot") is string shotImg)
                {
                    <img src="@CacheBuster.Bust(shotImg)" alt="Shot" class="enhance-row__img" />
                }
                else
                {
                    <span style="font-size: 1.1rem;">🥃</span>
                }
            </div>
            <div class="enhance-row__info">
                <div class="enhance-row__title">Shot <span class="enhance-row__level">Lv@(Character.ShotStatBuffUpgrades)/@(MaxShotBuffRanks)</span></div>
                <div class="enhance-row__desc">Aumentar buff de stats do Shot</div>
                <div class="enhance-row__stat">
                    @if (IsShotBuffMaxed)
                    {
                        <text>+@(((Character.EffectiveShotBuffMultiplier - 1) * 100).ToString("F0"))%</text>
                    }
                    else
                    {
                        var nextMultiplier = Math.Min(MyTunoScaling.MaxShotBuffMultiplier, Character.EffectiveShotBuffMultiplier + MyTunoScaling.ShotBuffPerUpgrade);
                        <text>+@(((Character.EffectiveShotBuffMultiplier - 1) * 100).ToString("F0"))% → <span class="text-success">+@(((nextMultiplier - 1) * 100).ToString("F0"))%</span></text>
                    }
                </div>
            </div>
            <div class="enhance-row__action">
                <button class="btn enhance-row__btn @(IsShotBuffMaxed ? "enhance-row__btn--maxed" : "")"
                        @onclick="() => RequestConsumablePurchase(ConsumableUpgradeType.ShotBuff)"
                        disabled="@(ConsumablePurchasing || shotBuffCostLoading || IsShotBuffMaxed || FidelisBalance < shotBuffCost)">
                    @if (ConsumablePurchasing && ConsumablePurchasingType == ConsumableUpgradeType.ShotBuff)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    else
                    {
                        <text>Aumentar</text>
                    }
                </button>
                <div class="enhance-row__cost">
                    @if (IsShotBuffMaxed)
                    {
                        <i class="bi bi-coin"></i> <span>Max</span>
                    }
                    else if (shotBuffCostLoading)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    else
                    {
                        <i class="bi bi-coin"></i> <span>@FormatCost(shotBuffCost)</span>
                    }
                </div>
            </div>
        </div>

        <!-- Canhão Timer Upgrade Row -->
        <div class="enhance-row @(IsCanhaoTimerMaxed ? "enhance-row--maxed" : "")">
            <div class="enhance-row__icon" style="background: linear-gradient(135deg, #dc3545, #a71d2a);">
                @if (GetConsumableImage("Canhao") is string canhaoImg)
                {
                    <img src="@CacheBuster.Bust(canhaoImg)" alt="Canhão" class="enhance-row__img" />
                }
                else
                {
                    <span style="font-size: 1.1rem;">💣</span>
                }
            </div>
            <div class="enhance-row__info">
                <div class="enhance-row__title">Canhão <span class="enhance-row__level">Lv@(Character.CanhaoTimerUpgrades)/@(MaxCanhaoTimerRanks)</span></div>
                <div class="enhance-row__desc">Aumentar duração do AOE</div>
                <div class="enhance-row__stat">
                    @if (IsCanhaoTimerMaxed)
                    {
                        <text>@(Character.EffectiveCanhaoMinutes)min</text>
                    }
                    else
                    {
                        var nextMinutes = Math.Min(MyTunoScaling.MaxCanhaoMinutes, Character.EffectiveCanhaoMinutes + MyTunoScaling.CanhaoMinutesPerUpgrade);
                        <text>@(Character.EffectiveCanhaoMinutes)min → <span class="text-success">@(nextMinutes)min</span></text>
                    }
                </div>
            </div>
            <div class="enhance-row__action">
                <button class="btn enhance-row__btn @(IsCanhaoTimerMaxed ? "enhance-row__btn--maxed" : "")"
                        @onclick="() => RequestConsumablePurchase(ConsumableUpgradeType.CanhaoTimer)"
                        disabled="@(ConsumablePurchasing || canhaoTimerCostLoading || IsCanhaoTimerMaxed || FidelisBalance < canhaoTimerCost)">
                    @if (ConsumablePurchasing && ConsumablePurchasingType == ConsumableUpgradeType.CanhaoTimer)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    else
                    {
                        <text>Aumentar</text>
                    }
                </button>
                <div class="enhance-row__cost">
                    @if (IsCanhaoTimerMaxed)
                    {
                        <i class="bi bi-coin"></i> <span>Max</span>
                    }
                    else if (canhaoTimerCostLoading)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    else
                    {
                        <i class="bi bi-coin"></i> <span>@FormatCost(canhaoTimerCost)</span>
                    }
                </div>
            </div>
        </div>

        <!-- Penalty Timer + Lifesteal Upgrade Row -->
        <div class="enhance-row @(IsPenaltyTimerMaxed ? "enhance-row--maxed" : "")">
            <div class="enhance-row__icon" style="background: linear-gradient(135deg, #6610f2, #4a0ea3);">
                @if (GetConsumableImage("Penalty") is string penaltyImg)
                {
                    <img src="@CacheBuster.Bust(penaltyImg)" alt="Penalty" class="enhance-row__img" />
                }
                else
                {
                    <span style="font-size: 1.1rem;">⚡</span>
                }
            </div>
            <div class="enhance-row__info">
                <div class="enhance-row__title">Penalty <span class="enhance-row__level">Lv@(Character.PenaltyTimerUpgrades)/@(MaxPenaltyTimerRanks)</span></div>
                <div class="enhance-row__desc">Aumentar duração e lifesteal</div>
                <div class="enhance-row__stat">
                    @if (IsPenaltyTimerMaxed)
                    {
                        <text>@(Character.EffectivePenaltyMinutes)min / @((Character.EffectivePenaltyLifesteal * 100).ToString("F1"))%</text>
                    }
                    else
                    {
                        var nextMinutes = Math.Min(MyTunoScaling.MaxPenaltyMinutes, Character.EffectivePenaltyMinutes + MyTunoScaling.PenaltyMinutesPerUpgrade);
                        var nextLifesteal = Math.Min(MyTunoScaling.MaxPenaltyLifesteal, Character.EffectivePenaltyLifesteal + MyTunoScaling.PenaltyLifestealPerUpgrade);
                        <text>@(Character.EffectivePenaltyMinutes)min / @((Character.EffectivePenaltyLifesteal * 100).ToString("F1"))% → <span class="text-success">@(nextMinutes)min / @((nextLifesteal * 100).ToString("F1"))%</span></text>
                    }
                </div>
            </div>
            <div class="enhance-row__action">
                <button class="btn enhance-row__btn @(IsPenaltyTimerMaxed ? "enhance-row__btn--maxed" : "")"
                        @onclick="() => RequestConsumablePurchase(ConsumableUpgradeType.PenaltyTimer)"
                        disabled="@(ConsumablePurchasing || penaltyTimerCostLoading || IsPenaltyTimerMaxed || FidelisBalance < penaltyTimerCost)">
                    @if (ConsumablePurchasing && ConsumablePurchasingType == ConsumableUpgradeType.PenaltyTimer)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    else
                    {
                        <text>Aumentar</text>
                    }
                </button>
                <div class="enhance-row__cost">
                    @if (IsPenaltyTimerMaxed)
                    {
                        <i class="bi bi-coin"></i> <span>Max</span>
                    }
                    else if (penaltyTimerCostLoading)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    else
                    {
                        <i class="bi bi-coin"></i> <span>@FormatCost(penaltyTimerCost)</span>
                    }
                </div>
            </div>
        </div>

        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Character Character { get; set; } = default!;
    [Parameter] public decimal FidelisBalance { get; set; }
    [Parameter] public int LeitaoBalance { get; set; }
    [Parameter] public bool Purchasing { get; set; }
    [Parameter] public ImprovementType? PurchasingType { get; set; }
    [Parameter] public EventCallback<ImprovementType> OnPurchaseRequested { get; set; }
    [Parameter] public bool ConsumablePurchasing { get; set; }
    [Parameter] public ConsumableUpgradeType? ConsumablePurchasingType { get; set; }
    [Parameter] public EventCallback<ConsumableUpgradeType> OnConsumablePurchaseRequested { get; set; }
    [Parameter] public Dictionary<string, string>? ConsumableImageUrls { get; set; }

    private decimal energyAmountCost, energyRegenCost, castSpeedCost, doubleGatheringCost;
    private int energyAmountLeitaoCost, energyRegenLeitaoCost, castSpeedLeitaoCost, doubleGatheringLeitaoCost;
    private bool energyAmountCostLoading = true, energyRegenCostLoading = true, castSpeedCostLoading = true, doubleGatheringCostLoading = true;

    // Consumable upgrade costs
    private decimal cigarroDodgeCost, shotBuffCost, canhaoTimerCost, penaltyTimerCost;
    private bool cigarroDodgeCostLoading = true, shotBuffCostLoading = true, canhaoTimerCostLoading = true, penaltyTimerCostLoading = true;

    private int MaxEnergyAmountUpgrades => MyTunoConfig.Value.Improvements.EnergyAmount.MaxUpgrades;
    private int MaxEnergyRegenUpgrades => MyTunoConfig.Value.Improvements.EnergyRegen.MaxUpgrades;

    private bool IsEnergyAmountMaxed => MaxEnergyAmountUpgrades > 0 && Character.EnergyAmountUpgrades >= MaxEnergyAmountUpgrades;
    private bool IsEnergyRegenMaxed => (MaxEnergyRegenUpgrades > 0 && Character.EnergyRegenUpgrades >= MaxEnergyRegenUpgrades) || Character.EffectiveRegenInterval <= 5.0;
    private bool IsCastSpeedMaxed => Character.EffectiveCastTime <= MyTunoConfig.Value.Improvements.MinCastTime;
    private bool IsDoubleGatheringMaxed => Character.DoubleGatheringChance >= MyTunoConfig.Value.Improvements.MaxDoubleGatheringChance;

    // Consumable upgrade max checks
    private int MaxCigarroDodgeRanks => MyTunoConfig.Value.ConsumableUpgrades.CigarroDodge.MaxUpgrades;
    private int MaxShotBuffRanks => MyTunoConfig.Value.ConsumableUpgrades.ShotBuff.MaxUpgrades;
    private int MaxCanhaoTimerRanks => MyTunoConfig.Value.ConsumableUpgrades.CanhaoTimer.MaxUpgrades;
    private int MaxPenaltyTimerRanks => MyTunoConfig.Value.ConsumableUpgrades.PenaltyTimer.MaxUpgrades;

    private bool IsCigarroDodgeMaxed => Character.CigarroDodgeUpgrades >= MaxCigarroDodgeRanks;
    private bool IsShotBuffMaxed => Character.ShotStatBuffUpgrades >= MaxShotBuffRanks;
    private bool IsCanhaoTimerMaxed => Character.CanhaoTimerUpgrades >= MaxCanhaoTimerRanks;
    private bool IsPenaltyTimerMaxed => Character.PenaltyTimerUpgrades >= MaxPenaltyTimerRanks;

    protected override void OnParametersSet()
    {
        LoadCostsFromCharacter();
    }

    private void LoadCostsFromCharacter()
    {
        try
        {
            var costs = ImprovementService.GetAllImprovementCosts(Character);
            energyAmountCost = costs.GetValueOrDefault(ImprovementType.EnergyAmount);
            energyRegenCost = costs.GetValueOrDefault(ImprovementType.EnergyRegen);
            castSpeedCost = costs.GetValueOrDefault(ImprovementType.CastSpeed);
            doubleGatheringCost = costs.GetValueOrDefault(ImprovementType.DoubleGathering);

            // Leitão costs
            var p = MyTunoConfig.Value.BossMode.Piggies;
            energyAmountLeitaoCost = PiggiesCostConfig.CalculateCost(Character.EnergyAmountUpgrades, p.ImprovementStartLevel, p.ImprovementBaseCost, p.ImprovementCostEveryNLevels);
            energyRegenLeitaoCost = PiggiesCostConfig.CalculateCost(Character.EnergyRegenUpgrades, p.ImprovementStartLevel, p.ImprovementBaseCost, p.ImprovementCostEveryNLevels);
            castSpeedLeitaoCost = PiggiesCostConfig.CalculateCost(Character.CastSpeedUpgrades, p.ImprovementStartLevel, p.ImprovementBaseCost, p.ImprovementCostEveryNLevels);
            doubleGatheringLeitaoCost = PiggiesCostConfig.CalculateCost(Character.DoubleGatheringUpgrades, p.ImprovementStartLevel, p.ImprovementBaseCost, p.ImprovementCostEveryNLevels);

            // Consumable upgrade costs
            var consumableCosts = ConsumableUpgradeService.GetAllConsumableUpgradeCosts(Character);
            cigarroDodgeCost = consumableCosts.GetValueOrDefault(ConsumableUpgradeType.CigarroDodge);
            shotBuffCost = consumableCosts.GetValueOrDefault(ConsumableUpgradeType.ShotBuff);
            canhaoTimerCost = consumableCosts.GetValueOrDefault(ConsumableUpgradeType.CanhaoTimer);
            penaltyTimerCost = consumableCosts.GetValueOrDefault(ConsumableUpgradeType.PenaltyTimer);
        }
        catch
        {
            // Costs stay at 0
        }
        finally
        {
            energyAmountCostLoading = false;
            energyRegenCostLoading = false;
            castSpeedCostLoading = false;
            doubleGatheringCostLoading = false;
            cigarroDodgeCostLoading = false;
            shotBuffCostLoading = false;
            canhaoTimerCostLoading = false;
            penaltyTimerCostLoading = false;
        }
    }

    private async Task RequestPurchase(ImprovementType improvementType)
    {
        await OnPurchaseRequested.InvokeAsync(improvementType);
    }

    private async Task RequestConsumablePurchase(ConsumableUpgradeType upgradeType)
    {
        await OnConsumablePurchaseRequested.InvokeAsync(upgradeType);
    }

    private static string FormatCost(decimal cost) => NumberFormatter.Compact(cost);

    private string? GetConsumableImage(string typeKey)
        => ConsumableImageUrls?.GetValueOrDefault(typeKey);
}
