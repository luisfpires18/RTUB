@using RTUB.Application.Configuration
@using RTUB.Application.Interfaces
@using RTUB.Core.Enums
@using RTUB.Core.Configuration
@using RTUB.Core.Helpers
@using Microsoft.Extensions.Options
@inject IPowerService PowerService
@inject IOptions<MyTunoScalingConfiguration> MyTunoConfig

<div class="card h-100">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0"><i class="bi bi-stars me-2"></i>Poderes</h5>
    </div>
    <div class="card-body p-2">
        <div class="d-flex flex-column gap-2">

        <!-- Heavy Attack Upgrade Row -->
        <div class="enhance-row @(IsHeavyMaxed ? "enhance-row--maxed" : "")">
            <div class="enhance-row__icon enhance-row__icon--heavy">
                <i class="bi bi-sword"></i>
            </div>
            <div class="enhance-row__info">
                <div class="enhance-row__title">Ataque Pesado <span class="enhance-row__level">Lv@(Character.HeavyAttackUpgrades)</span></div>
                <div class="enhance-row__desc">Aumentar dano do ataque pesado</div>
                <div class="enhance-row__stat">
                    @{
                        var currentHeavy = 2.0 + Character.HeavyAttackDamageBonus;
                        var nextHeavy = 2.0 + (Character.HeavyAttackUpgrades + 1) * MyTunoScaling.HeavyAttackBonusPerUpgrade;
                    }
                    @if (IsHeavyMaxed)
                    {
                        <text>@($"{currentHeavy:F2}")x</text>
                    }
                    else
                    {
                        <text>@($"{currentHeavy:F2}")x → <span class="text-success">@($"{nextHeavy:F2}")x</span></text>
                    }
                </div>
            </div>
            <div class="enhance-row__action">
                <button class="btn enhance-row__btn @(IsHeavyMaxed ? "enhance-row__btn--maxed" : "")"
                        @onclick="() => RequestPurchase(PowerType.HeavyAttack)"
                        disabled="@(Purchasing || heavyCostLoading || IsHeavyMaxed || FidelisBalance < heavyCost)">
                    @if (Purchasing && PurchasingType == PowerType.HeavyAttack)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    else
                    {
                        <text>Aumentar</text>
                    }
                </button>
                <div class="enhance-row__cost">
                    @if (IsHeavyMaxed)
                    {
                        <i class="bi bi-coin"></i> <span>Max</span>
                    }
                    else if (heavyCostLoading)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    else
                    {
                        <i class="bi bi-coin"></i> <span>@FormatCost(heavyCost)</span>
                    }
                </div>
            </div>
        </div>

        <!-- Special Attack Upgrade Row -->
        <div class="enhance-row @(IsSpecialMaxed ? "enhance-row--maxed" : "")">
            <div class="enhance-row__icon enhance-row__icon--special">
                <i class="bi bi-lightning-charge-fill"></i>
            </div>
            <div class="enhance-row__info">
                <div class="enhance-row__title">Ataque Especial <span class="enhance-row__level">Lv@(Character.SpecialAttackUpgrades)</span></div>
                <div class="enhance-row__desc">Aumentar dano do ataque especial</div>
                <div class="enhance-row__stat">
                    @{
                        var currentSpecialBonus = Character.SpecialAttackDamageBonus;
                        var nextSpecialBonus = (Character.SpecialAttackUpgrades + 1) * MyTunoScaling.SpecialAttackBonusPerUpgrade;
                    }
                    @if (IsSpecialMaxed)
                    {
                        <text>+@($"{currentSpecialBonus:F2}")x</text>
                    }
                    else
                    {
                        <text>+@($"{currentSpecialBonus:F2}")x → <span class="text-success">+@($"{nextSpecialBonus:F2}")x</span></text>
                    }
                </div>
            </div>
            <div class="enhance-row__action">
                <button class="btn enhance-row__btn @(IsSpecialMaxed ? "enhance-row__btn--maxed" : "")"
                        @onclick="() => RequestPurchase(PowerType.SpecialAttack)"
                        disabled="@(Purchasing || specialCostLoading || IsSpecialMaxed || FidelisBalance < specialCost)">
                    @if (Purchasing && PurchasingType == PowerType.SpecialAttack)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    else
                    {
                        <text>Aumentar</text>
                    }
                </button>
                <div class="enhance-row__cost">
                    @if (IsSpecialMaxed)
                    {
                        <i class="bi bi-coin"></i> <span>Max</span>
                    }
                    else if (specialCostLoading)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    else
                    {
                        <i class="bi bi-coin"></i> <span>@FormatCost(specialCost)</span>
                    }
                </div>
            </div>
        </div>

        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Character Character { get; set; } = default!;
    [Parameter] public decimal FidelisBalance { get; set; }
    [Parameter] public bool Purchasing { get; set; }
    [Parameter] public PowerType? PurchasingType { get; set; }
    [Parameter] public EventCallback<PowerType> OnPurchaseRequested { get; set; }

    private decimal heavyCost, specialCost;
    private bool heavyCostLoading = true, specialCostLoading = true;

    private int MaxHeavyUpgrades => MyTunoConfig.Value.Powers.HeavyAttack.MaxUpgrades;
    private int MaxSpecialUpgrades => MyTunoConfig.Value.Powers.SpecialAttack.MaxUpgrades;

    private bool IsHeavyMaxed => MaxHeavyUpgrades > 0 && Character.HeavyAttackUpgrades >= MaxHeavyUpgrades;
    private bool IsSpecialMaxed => MaxSpecialUpgrades > 0 && Character.SpecialAttackUpgrades >= MaxSpecialUpgrades;

    protected override void OnParametersSet()
    {
        LoadCostsFromCharacter();
    }

    private void LoadCostsFromCharacter()
    {
        try
        {
            var costs = PowerService.GetAllPowerCosts(Character);
            heavyCost = costs.GetValueOrDefault(PowerType.HeavyAttack);
            specialCost = costs.GetValueOrDefault(PowerType.SpecialAttack);
        }
        catch
        {
            // Costs stay at 0
        }
        finally
        {
            heavyCostLoading = false;
            specialCostLoading = false;
        }
    }

    private async Task RequestPurchase(PowerType powerType)
    {
        await OnPurchaseRequested.InvokeAsync(powerType);
    }

    private static string FormatCost(decimal cost) => NumberFormatter.Compact(cost);
}
