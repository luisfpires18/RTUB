    private async Task SendNewMessage()
    {
        if (selectedMember == null || string.IsNullOrWhiteSpace(newMessageText) || isSending)
            return;

        isSending = true;
        
        try
        {
            var messageDto = new SendMessageDto
            {
                ReceiverId = selectedMember.Id,
                Body = newMessageText.Trim()
            };

            var sentMessage = await MessagingService.SendDirectMessageAsync(currentUserId, messageDto);
            
            // Get or create conversation
            var conversation = await MessagingService.GetOrCreateConversationAsync(currentUserId, selectedMember.Id);
            
            await CloseNewMessageModal();
            
            // Reload conversations and select the new one
            await LoadConversationsAsync();
            await SelectConversation(conversation.Id);
        }
        finally
        {
            isSending = false;
        }
    }
    
