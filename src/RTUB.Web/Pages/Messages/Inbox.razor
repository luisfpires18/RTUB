    private async Task ToggleReadStatus()
    {
        if (selectedConversation == null) return;

        var previousUnreadCount = selectedConversation.UnreadCount;
        
        if (previousUnreadCount > 0)
        {
            await MessagingService.MarkConversationAsReadAsync(selectedConversation.Id, currentUserId);
            selectedConversation.UnreadCount = 0;
        }
        else
        {
            await MessagingService.MarkConversationAsUnreadAsync(selectedConversation.Id, currentUserId);
            selectedConversation.UnreadCount = 1;
        }
        
        var conversationInList = conversations.FirstOrDefault(c => c.Id == selectedConversation.Id);
        if (conversationInList != null)
        {
            conversationInList.UnreadCount = selectedConversation.UnreadCount;
        }
        
        // Notify navbar badge to refresh unread count
        UnreadMessagesBadge.RequestRefresh();
    }

    private async Task ToggleMute()
    {
        if (selectedConversation == null) return;

        var newMuteStatus = await MessagingService.ToggleMuteAsync(selectedConversation.Id, currentUserId);
        selectedConversation.IsMuted = newMuteStatus;
        
        // Update conversation in list
        var conversationInList = conversations.FirstOrDefault(c => c.Id == selectedConversation.Id);
        if (conversationInList != null)
        {
            conversationInList.IsMuted = newMuteStatus;
        }
    }

    private async Task TogglePin()
    {
        if (selectedConversation == null) return;

        var newPinStatus = await MessagingService.TogglePinAsync(selectedConversation.Id, currentUserId);
        selectedConversation.IsPinned = newPinStatus;
        
        // Update conversation in list
        var conversationInList = conversations.FirstOrDefault(c => c.Id == selectedConversation.Id);
        if (conversationInList != null)
        {
            conversationInList.IsPinned = newPinStatus;
        }
        
        // Re-sort conversations (pinned first, then by LastMessageAt)
        conversations = conversations
            .OrderByDescending(c => c.IsPinned)
            .ThenByDescending(c => c.LastMessageAt)
            .ToList();
        
        StateHasChanged();
    }

    private async Task DeleteConversation()
    {
        if (selectedConversation == null) return;

        // Store the unread count before deleting
        var unreadCountToRemove = selectedConversation.UnreadCount;
        
        var deleted = await MessagingService.DeleteConversationAsync(selectedConversation.Id, currentUserId);
        
        if (!deleted)
        {
            // Deletion was not allowed (should not happen if CanDelete is properly checked)
            return;
        }
        
        var conversationToRemove = conversations.FirstOrDefault(c => c.Id == selectedConversation.Id);
        if (conversationToRemove != null)
        {
            conversations.Remove(conversationToRemove);
        }
        
        // Notify navbar badge to refresh unread count if the deleted conversation had unread messages
        if (unreadCountToRemove > 0)
        {
            UnreadMessagesBadge.RequestRefresh();
        }
        
        BackToConversations();
    }

