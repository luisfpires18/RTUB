    private async Task OnMemberSearch(string searchTerm)
    {
        if (string.IsNullOrWhiteSpace(searchTerm) || searchTerm.Length < MinSearchTermLength)
        {
            filteredMembers.Clear();
            return;
        }

        var lowerSearch = searchTerm.ToLower();
        
        // Query database directly using EF.Functions.Like for better performance
        // Using AsNoTracking() for read-only search operation
        filteredMembers = await UserManager.Users
            .AsNoTracking()
            .Where(m => m.Id != currentUserId && // Don't show current user
                       (EF.Functions.Like(m.Nickname, $"%{searchTerm}%") ||
                        EF.Functions.Like(m.FirstName, $"%{searchTerm}%") ||
                        EF.Functions.Like(m.LastName, $"%{searchTerm}%")))
            .OrderBy(m => m.Nickname ?? m.FirstName)
            .Take(10)
            .ToListAsync();
    }

