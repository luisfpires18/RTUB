                                            <div class="rtub-messages__group-member-fullname">@participant.Name</div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseGroupMembersModal">Fechar</button>
                </div>
            </div>
        </div>
    </div>
