    // ========== SignalR Integration ==========
    
    private Dictionary<string, string> typingUsers = new();
    private bool isTyping = false;
    private int? currentConversationId;

    protected override async Task OnInitializedAsync()
    {
        // Subscribe to notification service events (server-side real-time updates)
        NotificationService.OnMessageReceived += HandleMessageReceived;
        NotificationService.OnMessageSeen += HandleMessageSeen;
        NotificationService.OnTypingStarted += HandleTypingStarted;
        NotificationService.OnTypingStopped += HandleTypingStopped;
        NotificationService.OnReactionUpdated += HandleReactionUpdated;
        
        // Original initialization code
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        
        if (user.Identity?.IsAuthenticated == true)
        {
            var currentUser = await UserManager.GetUserAsync(user);
            if (currentUser != null)
            {
                currentUserId = currentUser.Id;
                await LoadConversationsAsync();
            }
        }
    }

    private async Task HandleMessageReceived(MessageDto message)
    {
        // Only process this message if the current user is involved (either as sender or recipient)
        var isCurrentUserSender = message.SenderId == currentUserId;
        var isCurrentUserRecipient = message.RecipientIds.Contains(currentUserId);
        
        if (!isCurrentUserSender && !isCurrentUserRecipient)
        {
            // This message is not for the current user, ignore it
            return;
        }

        await InvokeAsync(async () =>
        {
            bool needsConversationReload = false;
            
            try
            {
                // Use cancellation token to handle disposal gracefully
                await _conversationsLock.WaitAsync(_disposalCancellationTokenSource.Token);
                try
                {
                    // Update conversation list
                    var conversation = conversations.FirstOrDefault(c => c.Id == message.ConversationId);
                    if (conversation != null)
                    {
                        // Skip updating preview if message is from current user (already updated in SendMessage)
                        // and only update if the incoming message is strictly newer than the current preview
                        // Use > to prevent messages with identical timestamps from overwriting each other
                        if (!isCurrentUserSender && message.CreatedAt > conversation.LastMessageAt)
                        {
                            conversation.LastMessageAt = message.CreatedAt;
                            // Truncate the preview if it exceeds the max length
                            conversation.LastMessagePreview = MessagingDisplayService.TruncateMessagePreview(message.Body, MessagePreviewMaxLength);
                            conversation.LastMessageSenderId = message.SenderId;
                        }
                        
                        // Only increment unread count if this is not the current conversation AND it's not from the current user
                        if (selectedConversation?.Id != message.ConversationId && !isCurrentUserSender)
                        {
                            conversation.UnreadCount++;
                        }
                        
                        // Re-sort conversations
                        conversations = conversations
                            .OrderByDescending(c => c.IsPinned)
                            .ThenByDescending(c => c.LastMessageAt)
                            .ToList();
                    }
                    else
                    {
                        // New conversation - mark for reload outside the lock to avoid deadlock
                        needsConversationReload = true;
                    }
                }
                finally
                {
                    _conversationsLock.Release();
                }
            }
            catch (ObjectDisposedException)
            {
                // Component is being disposed and cancellation token source has been disposed, exit gracefully
                return;
            }
            catch (OperationCanceledException)
            {
                // Component is being disposed, exit gracefully
                return;
            }
            
            // Reload conversations outside the lock to avoid deadlock
            if (needsConversationReload)
            {
                await LoadConversationsAsync();
            }
            
                // If this message is for the currently selected conversation, add it to the message list
                if (selectedConversation?.Id == message.ConversationId)
                {
                    // Only add if not already in the list (avoid duplicates from sender)
                    if (!messages.Any(m => m.Id == message.Id))
                {
                    messages.Add(message);
                    
                    // For messages sent by current user, always scroll to bottom
                    // For messages received from others, only scroll if user is near bottom
                    if (isCurrentUserSender)
                    {
                        shouldScrollToBottom = true;
                    }
                    else
                    {
                        shouldScrollIfNearEnd = true;
                    }
                }

                // If message is from another user, mark as read
                if (!isCurrentUserSender)
                {
                    await MessagingService.MarkConversationAsReadAsync(message.ConversationId, currentUserId);
                    
                    // Clear notifications for this conversation in PWA/browser
                    await ClearNotificationAsync(message.ConversationId);
                    
                    UnreadMessagesBadge.RequestRefresh();
                }
            }
            else
            {
                // Message is for a different conversation - notify badge
                if (!isCurrentUserSender)
                {
                    UnreadMessagesBadge.RequestRefresh();
                }
            }
            
            StateHasChanged();
        });
    }

    private async Task HandleMessageSeen(int conversationId, string userId, DateTime seenAt)
    {
        await InvokeAsync(() =>
        {
            // Update messages to show as read if they were sent by current user
            if (selectedConversation?.Id == conversationId && userId != currentUserId)
            {
                // The other user has read our messages - mark them as read in the UI
                foreach (var message in messages.Where(m => m.SenderId == currentUserId))
                {
                    message.IsRead = true;
                    
                    // For group chats, update ReadBy list
                    if (selectedConversation.IsGroup)
                    {
                        var readByIds = string.IsNullOrEmpty(message.ReadBy) 
                            ? new List<string>() 
                            : message.ReadBy.Split(';', StringSplitOptions.RemoveEmptyEntries).ToList();
                        
                        if (!readByIds.Contains(userId))
                        {
                            readByIds.Add(userId);
                            message.ReadBy = string.Join(";", readByIds);
                        }
                    }
                }
                StateHasChanged();
            }
            return Task.CompletedTask;
        });
    }

    private async Task HandleTypingStarted(int conversationId, string userId)
    {
        await InvokeAsync(async () =>
        {
            if (selectedConversation?.Id == conversationId && userId != currentUserId)
            {
                // Get user name
                string displayName;
                if (selectedConversation.IsGroup)
                {
                    var participant = selectedConversation.GroupParticipants.FirstOrDefault(p => p.UserId == userId);
                    displayName = participant?.Nickname ?? participant?.Name ?? "Alguém";
                }
                else
                {
                    // For 1-on-1 conversations, use the other participant's info
                    displayName = selectedConversation.OtherParticipantNickname ?? selectedConversation.OtherParticipantName ?? "Alguém";
                }
                
                typingUsers[userId] = displayName;
                StateHasChanged();
            }
        });
    }

    private async Task HandleTypingStopped(int conversationId, string userId)
    {
        await InvokeAsync(() =>
        {
            if (selectedConversation?.Id == conversationId)
            {
                typingUsers.Remove(userId);
                StateHasChanged();
            }
            return Task.CompletedTask;
        });
    }

    private string GetTypingUsersText()
    {
        var count = typingUsers.Count;
        if (count == 0) return string.Empty;
        if (count == 1) return $"{typingUsers.Values.First()} está a escrever...";
        if (count == 2) return $"{string.Join(" e ", typingUsers.Values)} estão a escrever...";
        return $"{count} pessoas estão a escrever...";
    }

    private string GetReadReceiptTooltip(MessageDto message)
    {
        if (selectedConversation == null || !selectedConversation.IsGroup)
        {
            return "Lida";
        }

        // For group chats, show who has read the message
        var readByIds = string.IsNullOrEmpty(message.ReadBy) 
            ? new List<string>() 
            : message.ReadBy.Split(';', StringSplitOptions.RemoveEmptyEntries).ToList();

        if (!readByIds.Any())
        {
            return "Enviada";
        }

        // Get participant names
        var readByNames = new List<string>();
        foreach (var userId in readByIds)
        {
            if (userId == currentUserId) continue; // Skip current user
            
            var participant = selectedConversation.GroupParticipants.FirstOrDefault(p => p.UserId == userId);
            if (participant != null)
            {
                var name = participant.Nickname ?? participant.Name ?? "Utilizador";
                readByNames.Add(name);
            }
        }

        if (!readByNames.Any())
        {
            return "Lida";
        }

        // Check if everyone has read it (excluding the sender)
        var totalParticipants = selectedConversation.GroupParticipants.Count(p => p.UserId != currentUserId);
        if (readByNames.Count == totalParticipants)
        {
            return "Lida por Todos";
        }

        return $"Lida por {string.Join(", ", readByNames)}";
    }

    private async Task SelectConversation(int conversationId)
    {
        // Stop typing indicator for the current conversation before switching
        await StopTyping();
        
        // Reset JS composer state (clears textarea text and typing flags without .NET callback)
        try { await JSRuntime.InvokeVoidAsync("messageComposer.reset"); } catch { }

        // Reset compose overlay state when switching conversations
        replyingToMessage = null;
        mentionSuggestions.Clear();
        isMentionDropdownOpen = false;
        isEmojiPickerOpen = false;
        reactionPickerOpenForMessageId = null;
        hoveredMessageId = null;

        typingUsers.Clear();
        isLoadingMessages = true;
        isInputFocusHandlerSetup = false;
        
        try
        {
            selectedConversation = await MessagingService.GetConversationAsync(conversationId, currentUserId);

            if (selectedConversation != null)
            {
                messages = (await MessagingService.GetConversationMessagesAsync(conversationId, currentUserId)).ToList();
                shouldScrollToBottom = true;

                // Get the unread count before marking as read
                var conversationInList = conversations.FirstOrDefault(c => c.Id == conversationId);
                var previousUnreadCount = conversationInList?.UnreadCount ?? selectedConversation.UnreadCount;
            
                // Mark as read
                await MessagingService.MarkConversationAsReadAsync(conversationId, currentUserId);
                
                // Clear notifications for this conversation in PWA/browser
                await ClearNotificationAsync(conversationId);
                
                // Update conversation unread count
                selectedConversation.UnreadCount = 0;
                if (conversationInList != null)
                {
                    conversationInList.UnreadCount = 0;
                }
                
                // Notify navbar badge to refresh unread count if messages were marked as read
                if (previousUnreadCount > 0)
                {
                    UnreadMessagesBadge.RequestRefresh();
                }
                
                // Track current conversation
                currentConversationId = conversationId;
            }
        }
        finally
        {
            isLoadingMessages = false;
        }
    }

    private async Task SendMessage()
    {
        if (selectedConversation == null || isSending)
            return;

        // Set sending state immediately so the UI shows feedback
        isSending = true;
        StateHasChanged();

        // Read text + clear textarea in a single JS interop call
        string messageText;
        try
        {
            messageText = await JSRuntime.InvokeAsync<string>("messageComposer.getTextAndClear");
        }
        catch
        {
            isSending = false;
            return;
        }

        if (string.IsNullOrWhiteSpace(messageText))
        {
            isSending = false;
            StateHasChanged();
            return;
        }

        var trimmedText = messageText.Trim();

        // Store conversation reference to prevent race conditions
        var conversation = selectedConversation;
        if (conversation == null)
        {
            isSending = false;
            return;
        }
        
        var conversationId = conversation.Id;

        // Capture and clear reply state before async operations
        var replyToId = replyingToMessage?.Id;
        replyingToMessage = null;
        mentionSuggestions.Clear();
        isMentionDropdownOpen = false;

        // Fire-and-forget typing stop — don't block the send on hub round-trips
        _ = StopTyping();

        try
        {
            MessageDto sentMessage;

            if (conversation.IsGroup)
            {
                sentMessage = await MessagingService.SendGroupMessageAsync(currentUserId, conversationId, trimmedText, replyToId);
            }
            else
            {
                var messageDto = new SendMessageDto
                {
                    ReceiverId = conversation.OtherParticipantId!,
                    Body = trimmedText,
                    ReplyToMessageId = replyToId
                };
                sentMessage = await MessagingService.SendDirectMessageAsync(currentUserId, messageDto);
            }
            
            // Add message if not already added by SignalR (avoid duplicates)
            if (!messages.Any(m => m.Id == sentMessage.Id))
            {
                messages.Add(sentMessage);
            }
            
            shouldScrollToBottom = true;

            // Update conversation in list - defensive check to prevent NullReferenceException
            // Guard against null conversations collection or null selectedConversation (race condition)
            try
            {
                // Use cancellation token to handle disposal gracefully
                await _conversationsLock.WaitAsync(_disposalCancellationTokenSource.Token);
                try
                {
                    if (conversations != null && conversations.Any())
                    {
                        var conversationInList = conversations.FirstOrDefault(c => c.Id == conversationId);
                        if (conversationInList != null)
                        {
                            conversationInList.LastMessageAt = sentMessage.CreatedAt;
                            // Truncate the preview if it exceeds the max length (for consistency with HandleMessageReceived)
                            conversationInList.LastMessagePreview = sentMessage.Body.Length > MessagePreviewMaxLength
                                ? sentMessage.Body[..MessagePreviewMaxLength] + "..."
                                : sentMessage.Body;
                            conversationInList.LastMessageSenderId = currentUserId;
                            
                            // Re-sort conversations
                            conversations = MessagingSortService.SortConversations(conversations);
                        }
                        else
                        {
                            Logger.LogWarning("Conversation {ConversationId} not found in conversations list after sending message for user {UserId}",
                                conversationId, currentUserId);
                        }
                    }
                    else
                    {
                        Logger.LogWarning("Conversations collection is null or empty when trying to update conversation {ConversationId} for user {UserId}",
                            conversationId, currentUserId);
                    }
                }
                finally
                {
                    _conversationsLock.Release();
                }
            }
            catch (ObjectDisposedException)
            {
                // Component is being disposed and cancellation token source has been disposed, exit gracefully
                return;
            }
            catch (OperationCanceledException)
            {
                // Component is being disposed, exit gracefully
                return;
            }
            
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error sending message in conversation {ConversationId} for user {UserId}",
                conversationId, currentUserId);
            // Don't rethrow - fail gracefully
        }
        finally
        {
            isSending = false;
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        // Cancel all pending operations that are waiting on the semaphore
        _disposalCancellationTokenSource?.Cancel();
        
        // Unsubscribe from notification service events
        NotificationService.OnMessageReceived -= HandleMessageReceived;
        NotificationService.OnMessageSeen -= HandleMessageSeen;
        NotificationService.OnTypingStarted -= HandleTypingStarted;
        NotificationService.OnTypingStopped -= HandleTypingStopped;
        NotificationService.OnReactionUpdated -= HandleReactionUpdated;
        
        _conversationsLock?.Dispose();
        _disposalCancellationTokenSource?.Dispose();
        
        // Dispose JS-managed composer
        try { await JSRuntime.InvokeVoidAsync("messageComposer.dispose"); }
        catch { /* JS runtime may already be disconnected */ }
        _composerDotNetRef?.Dispose();
        
        // Ensure body scroll is unlocked when component is disposed
        // This handles edge cases where modals might be open during navigation
        // and ensures body scroll is restored when leaving the messages page
        try
        {
            await JSRuntime.InvokeVoidAsync("modalHelper.unlockBodyScroll");
        }
        catch (JSDisconnectedException)
        {
            // JavaScript runtime is disconnected during disposal - expected during navigation
            // No action needed as body scroll will reset on page navigation anyway
        }
        catch (InvalidOperationException)
        {
            // Component is being statically rendered or JS interop not available
            // This is expected during server-side rendering or disposal
            // Body scroll will reset on page navigation anyway
        }
        catch (Exception ex)
        {
            // Log unexpected errors but don't throw during disposal
            Logger.LogWarning(ex, "Error unlocking body scroll during Inbox component disposal for user {UserId}", currentUserId);
        }
        
        await Task.CompletedTask;
    }
