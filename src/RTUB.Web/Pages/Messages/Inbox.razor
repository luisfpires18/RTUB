@page "/messages"
@page "/messages/{ConversationId:int?}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.SignalR
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using RTUB.Application.Interfaces
@using RTUB.Application.DTOs
@using RTUB.Core.Entities
@using RTUB.Shared
@using RTUB.Shared.Base
@using RTUB.Components
@attribute [Authorize]
@inject IMessagingService MessagingService
@inject IMentionService MentionService
@inject IMessagingDisplayService MessagingDisplayService
@inject IMessagingSortService MessagingSortService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject ILogger<Inbox> Logger
@inject RTUB.Web.Services.MessagesNotificationService NotificationService
@inject IHubContext<RTUB.Web.Hubs.MessagesHub, RTUB.Web.Hubs.IMessagesHubClient> HubContext
@implements IAsyncDisposable

<PageTitle>Mensagens - RTUB</PageTitle>

<div class="rtub-messages">
    <div class="container-fluid h-100">
        <div class="row g-0 h-100">
            @* Conversations List *@
            <div class="col-12 col-lg-4 rtub-messages__panel @(selectedConversation != null ? "d-none d-lg-block" : "")">
                @* Mobile-only header — just title *@
                <div class="rtub-messages__panel-header--mobile d-lg-none">
                    <h3 class="mb-0">Mensagens</h3>
                </div>
                @* Desktop header *@
                <div class="rtub-messages__panel-header d-none d-lg-flex">
                    <h3 class="mb-0"><i class="bi bi-chat-dots"></i> Mensagens</h3>
                    <div class="dropdown">
                        <button class="btn btn-sm btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                            <i class="bi bi-plus-lg"></i> Nova
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <button class="dropdown-item" @onclick="OpenNewMessageModal">
                                    <i class="bi bi-person"></i> Nova mensagem
                                </button>
                            </li>
                            <li>
                                <button class="dropdown-item" @onclick="OpenNewGroupModal">
                                    <i class="bi bi-people"></i> Nova conversa de grupo
                                </button>
                            </li>
                        </ul>
                    </div>
                </div>

                @if (isLoadingConversations)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">A carregar...</span>
                        </div>
                    </div>
                }
                else if (!conversations.Any())
                {
                    <div class="rtub-messages__empty text-center py-5">
                        <i class="bi bi-chat-dots display-1 text-muted"></i>
                        <p class="text-muted mt-3">Ainda não tem mensagens</p>
                        <button class="btn btn-primary" @onclick="OpenNewMessageModal">
                            <i class="bi bi-plus-lg"></i> Enviar primeira mensagem
                        </button>
                    </div>
                }
                else
                {
                    <div class="rtub-messages__list">
                        @foreach (var conversation in conversations)
                        {
                            <div class="rtub-messages__item @(selectedConversation?.Id == conversation.Id ? "is-active" : "")"
                                 @onclick="() => SelectConversation(conversation.Id)">
                                <div class="rtub-messages__avatar">
                                    @if (conversation.IsSystemConversation || conversation.IsAnnouncementOnly)
                                    {
                                        <img src="/icons/rtub-logo-192.png" alt="RTUB" />
                                    }
                                    else if (conversation.IsGroup)
                                    {
                                        <div class="rtub-messages__avatar--group">
                                            <i class="bi bi-people-fill"></i>
                                        </div>
                                    }
                                    else
                                    {
                                        <img src="@GetAvatarUrl(conversation.OtherParticipantAvatar)" 
                                             alt="@(conversation.OtherParticipantNickname ?? conversation.OtherParticipantName)" 
                                             onerror="this.onerror=null; this.src='/images/default-avatar.webp';" />
                                    }
                                </div>
                                <div class="rtub-messages__item-content">
                                    <div class="rtub-messages__item-header">
                                        <h5 class="rtub-messages__item-name">
                                            @if (conversation.IsPinned)
                                            {
                                                <i class="bi bi-pin-fill rtub-messages__item-status-icon text-primary me-1" title="Afixado"></i>
                                            }
                                            @if (conversation.IsMuted)
                                            {
                                                <i class="bi bi-bell-slash-fill rtub-messages__item-status-icon text-muted me-1" title="Silenciado"></i>
                                            }
                                            @if (conversation.IsSystemConversation)
                                            {
                                                <text>RTUB</text>
                                            }
                                            else if (conversation.IsGroup)
                                            {
                                                @conversation.Title
                                            }
                                            else
                                            {
                                                @(conversation.OtherParticipantNickname ?? conversation.OtherParticipantName)
                                            }
                                        </h5>
                                        <span class="rtub-messages__item-time">@GetRelativeTime(conversation.LastMessageAt)</span>
                                    </div>
                                    <div class="rtub-messages__item-preview">
                                        <span class="@(conversation.UnreadCount > 0 ? "fw-bold" : "")">
                                            @if (conversation.IsGroup && !string.IsNullOrEmpty(conversation.LastMessageSenderId))
                                            {
                                                var senderInfo = conversation.GroupParticipants.FirstOrDefault(p => p.UserId == conversation.LastMessageSenderId);
                                                var senderName = senderInfo?.Nickname ?? senderInfo?.Name?.Split(' ').FirstOrDefault() ?? "";
                                                @($"{senderName}: {conversation.LastMessagePreview}")
                                            }
                                            else
                                            {
                                                @conversation.LastMessagePreview
                                            }
                                        </span>
                                    </div>
                                </div>
                                @if (conversation.UnreadCount > 0)
                                {
                                    <span class="badge bg-danger rtub-messages__item-badge">@conversation.UnreadCount</span>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            @* Message Thread *@
            <div class="col-12 col-lg-8 rtub-messages__thread-panel @(selectedConversation == null ? "d-none d-lg-flex" : "")">
                @if (selectedConversation == null)
                {
                    <div class="rtub-messages__empty text-center py-5 w-100">
                        <i class="bi bi-chat-text display-1 text-muted"></i>
                        <p class="text-muted mt-3">Selecione uma conversa para começar</p>
                    </div>
                }
                else
                {
                    <div class="rtub-messages__thread">
                        <div class="rtub-messages__thread-header">
                            <button class="btn btn-link d-none me-2" @onclick="BackToConversations">
                                <i class="bi bi-arrow-left"></i>
                            </button>
                            <div class="d-flex align-items-center flex-grow-1">
                                <div class="rtub-messages__avatar me-2">
                                    @if (selectedConversation.IsSystemConversation || selectedConversation.IsAnnouncementOnly)
                                    {
                                        <img src="/icons/rtub-logo-192.png" alt="RTUB" />
                                    }
                                    else if (selectedConversation.IsGroup)
                                    {
                                        <div class="rtub-messages__avatar--group">
                                            <i class="bi bi-people-fill"></i>
                                        </div>
                                    }
                                    else
                                    {
                                        <img src="@GetAvatarUrl(selectedConversation.OtherParticipantAvatar)" 
                                             alt="@(selectedConversation.OtherParticipantNickname ?? selectedConversation.OtherParticipantName)" 
                                             onerror="this.onerror=null; this.src='/images/default-avatar.webp';" />
                                    }
                                </div>
                                <div class="d-flex flex-column">
                                    <h5 class="mb-0">
                                        @if (selectedConversation.IsSystemConversation)
                                        {
                                            <text>RTUB</text>
                                        }
                                        else if (selectedConversation.IsGroup)
                                        {
                                            @selectedConversation.Title
                                        }
                                        else
                                        {
                                            @(selectedConversation.OtherParticipantNickname ?? selectedConversation.OtherParticipantName)
                                        }
                                    </h5>
                                    @if (selectedConversation.IsGroup && selectedConversation.GroupParticipants?.Any() == true)
                                    {
                                        <small class="text-muted rtub-messages__group-preview" @onclick="OpenGroupMembersModal" @onclick:stopPropagation="true">
                                            <i class="bi bi-people me-1"></i>
                                            @selectedConversation.GroupParticipants.Count membros
                                            <i class="bi bi-chevron-right ms-1"></i>
                                        </small>
                                    }
                                </div>
                            </div>
                            <div class="rtub-messages__header-actions d-none d-lg-flex">
                                <button class="btn btn-link rtub-messages__header-btn @(selectedConversation.IsMuted ? "is-active" : "")" @onclick="ToggleMute" title="@(selectedConversation.IsMuted ? "Ativar notificações" : "Silenciar")">
                                    <i class="bi @(selectedConversation.IsMuted ? "bi-bell-slash-fill" : "bi-bell")"></i>
                                </button>
                                <button class="btn btn-link rtub-messages__header-btn @(selectedConversation.IsPinned ? "is-active" : "")" @onclick="TogglePin" title="@(selectedConversation.IsPinned ? "Desafixar" : "Afixar")">
                                    <i class="bi @(selectedConversation.IsPinned ? "bi-pin-fill" : "bi-pin")"></i>
                                </button>
                                @if (!selectedConversation.IsSystemConversation)
                                {
                                    <div class="dropdown">
                                        <button class="btn btn-link" type="button" data-bs-toggle="dropdown">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li>
                                                <button class="dropdown-item" @onclick="ToggleReadStatus">
                                                    <i class="bi bi-eye"></i> 
                                                    @(selectedConversation.UnreadCount > 0 ? "Marcar como lida" : "Marcar como não lida")
                                                </button>
                                            </li>
                                            @if (selectedConversation.CanDelete)
                                            {
                                                <li><hr class="dropdown-divider" /></li>
                                                <li>
                                                    <button class="dropdown-item text-danger" @onclick="DeleteConversation">
                                                        <i class="bi bi-trash"></i> Eliminar conversa
                                                    </button>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="rtub-messages__thread-body" @ref="messageThreadBody" @onclick="CloseAllOverlays">
                            <div class="rtub-messages__thread-wrapper">
                                @if (isLoadingMessages)
                                {
                                    <LoadingSpinner Message="A carregar mensagens..." />
                                }
                                else
                                {
                                    @for (var i = 0; i < messages.Count; i++)
                                    {
                                        var message = messages[i];
                                        var groupPosition = MessagingDisplayService.GetMessageGroupPosition(messages, i);
                                        var showAvatar = groupPosition == MessageGroupPosition.First || groupPosition == MessageGroupPosition.Single;
                                        var showTimestamp = groupPosition == MessageGroupPosition.Last || groupPosition == MessageGroupPosition.Single;
                                        var showSenderName = showAvatar && selectedConversation.IsGroup && message.SenderId != currentUserId && !message.IsSystem;
                                        
                                        <div class="rtub-messages__bubble @(message.SenderId == currentUserId ? "rtub-messages__bubble--sent" : "rtub-messages__bubble--received") @(message.IsSystem ? "rtub-messages__bubble--system" : string.Empty) @GetMessageGroupClass(groupPosition)"
                                             @onmouseenter="() => hoveredMessageId = message.Id"
                                             @onmouseleave="() => hoveredMessageId = null">
                                            @if (message.SenderId != currentUserId && !message.IsSystem)
                                            {
                                                @if (showAvatar)
                                                {
                                                    <div class="rtub-messages__bubble-avatar">
                                                        <img src="@GetAvatarUrl(message.SenderAvatar)"
                                                             alt="@(message.SenderNickname ?? message.SenderName)"
                                                             onerror="this.onerror=null; this.src='/images/default-avatar.webp';" />
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="rtub-messages__bubble-avatar-placeholder"></div>
                                                }
                                            }
                                            @if (message.IsSystem)
                                            {
                                                @if (showAvatar)
                                                {
                                                    <div class="rtub-messages__bubble-avatar">
                                                        <img src="/icons/rtub-logo-192.png" alt="RTUB" />
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="rtub-messages__bubble-avatar-placeholder"></div>
                                                }
                                            }
                                            <div class="rtub-messages__bubble-content">
                                                @if (showSenderName)
                                                {
                                                    <div class="rtub-messages__bubble-sender">
                                                        @(message.SenderNickname ?? message.SenderName)
                                                    </div>
                                                }
                                                <div class="rtub-messages__bubble-body @(message.IsSystem ? "rtub-messages__bubble-body--system" : string.Empty)">
                                                    @* Reply-to quoted preview *@
                                                    @if (message.ReplyToMessageId.HasValue && !string.IsNullOrEmpty(message.ReplyToBody))
                                                    {
                                                        <div class="rtub-messages__reply-preview">
                                                            <div class="rtub-messages__reply-preview-sender">@message.ReplyToSenderName</div>
                                                            <div class="rtub-messages__reply-preview-body">@message.ReplyToBody</div>
                                                        </div>
                                                    }

                                                    <p class="rtub-messages__bubble-text">@RenderMentionHighlighted(message.Body)</p>

                                                    @if (!string.IsNullOrEmpty(message.Link))
                                                    {
                                                        <div class="rtub-messages__bubble-actions">
                                                            <a href="@message.Link" class="rtub-messages__bubble-link">
                                                                <i class="bi bi-link-45deg"></i>
                                                                <span>Ver mais</span>
                                                            </a>
                                                        </div>
                                                    }
                                                </div>

                                                @* Reaction summary pills *@
                                                @if (message.Reactions.Any())
                                                {
                                                    <div class="rtub-messages__reactions">
                                                        @foreach (var reaction in message.Reactions)
                                                        {
                                                            var r = reaction;
                                                            var msgForReact = message;
                                                            <button class="rtub-messages__reaction-pill @(r.ReactedByCurrentUser ? "is-active" : "")"
                                                                    @onclick="() => SendReaction(msgForReact, r.Emoji)"
                                                                    title="@r.Count pessoa(s)">
                                                                @r.Emoji @r.Count
                                                            </button>
                                                        }
                                                    </div>
                                                }

                                                @if (showTimestamp)
                                                {
                                                    <div class="rtub-messages__bubble-time">
                                                        @message.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                                        @if (message.SenderId == currentUserId && !message.IsSystem)
                                                        {
                                                            @if (message.IsRead)
                                                            {
                                                                <i class="bi bi-check-all ms-1 text-primary" title="@GetReadReceiptTooltip(message)"></i>
                                                            }
                                                            else
                                                            {
                                                                <i class="bi bi-check ms-1" title="Enviada"></i>
                                                            }
                                                        }
                                                    </div>
                                                }
                                            </div>

                                            @* Hover action bar — reply + reaction *@
                                            @if (!message.IsSystem && hoveredMessageId == message.Id)
                                            {
                                                var hovMsg = message;
                                                <div class="rtub-messages__bubble-actions-bar @(message.SenderId == currentUserId ? "rtub-messages__bubble-actions-bar--sent" : "rtub-messages__bubble-actions-bar--received")">
                                                    <button class="rtub-messages__action-btn" @onclick="() => SetReply(hovMsg)" @onclick:stopPropagation="true" title="Responder">
                                                        <i class="bi bi-reply"></i>
                                                    </button>
                                                    <button class="rtub-messages__action-btn" @onclick="() => ToggleReactionPicker(hovMsg.Id)" @onclick:stopPropagation="true" title="Reagir">
                                                        <i class="bi bi-emoji-smile"></i>
                                                    </button>
                                                </div>
                                            }

                                            @* Reaction picker mini panel *@
                                            @if (reactionPickerOpenForMessageId == message.Id)
                                            {
                                                var rMsg = message;
                                                <div class="rtub-messages__reaction-picker @(message.SenderId == currentUserId ? "rtub-messages__reaction-picker--sent" : "rtub-messages__reaction-picker--received")"
                                                     @onclick:stopPropagation="true">
                                                    @foreach (var e in new[] { "👍", "❤️", "😂", "😮", "😢", "🙏" })
                                                    {
                                                        var emoji = e;
                                                        <button class="rtub-messages__reaction-picker-btn @(rMsg.Reactions.Any(rx => rx.Emoji == emoji && rx.ReactedByCurrentUser) ? "is-active" : "")"
                                                                @onclick="() => SendReaction(rMsg, emoji)">@emoji</button>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                    
                                    @* Typing indicator *@
                                    @if (typingUsers.Any())
                                    {
                                        <div class="rtub-messages__typing">
                                            <div class="rtub-messages__typing-content">
                                                <span class="rtub-messages__typing-dots">
                                                    <span></span>
                                                    <span></span>
                                                    <span></span>
                                                </span>
                                                <span class="rtub-messages__typing-text">
                                                    @GetTypingUsersText()
                                                </span>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>

                        @if (!selectedConversation.IsSystemConversation && selectedConversation.CanSendMessage)
                        {
                            <div class="rtub-messages__thread-footer" @onclick="CloseAllOverlays">
                                @* Reply strip — shows above composer when replying *@
                                @if (replyingToMessage != null)
                                {
                                    <div class="rtub-messages__reply-strip" @onclick:stopPropagation="true">
                                        <div class="rtub-messages__reply-strip-content">
                                            <div class="rtub-messages__reply-strip-sender">@(replyingToMessage.SenderNickname ?? replyingToMessage.SenderName ?? "Sistema")</div>
                                            <div class="rtub-messages__reply-strip-body">@(replyingToMessage.Body.Length > 80 ? replyingToMessage.Body[..80] + "…" : replyingToMessage.Body)</div>
                                        </div>
                                        <button class="rtub-messages__reply-strip-cancel" @onclick="CancelReply" @onclick:stopPropagation="true" title="Cancelar resposta">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </div>
                                }

                                @* Mention suggestions dropdown *@
                                @if (isMentionDropdownOpen && mentionSuggestions.Any())
                                {
                                    <div class="rtub-messages__mention-dropdown" @onclick:stopPropagation="true">
                                        @foreach (var s in mentionSuggestions)
                                        {
                                            var suggestion = s;
                                            <div class="rtub-messages__mention-item" @onclick="() => SelectMentionInChat(suggestion)" @key="suggestion.userId">
                                                <img class="rtub-messages__mention-item-avatar"
                                                     src="@GetAvatarUrl(suggestion.avatarUrl)"
                                                     alt="@suggestion.displayName"
                                                     onerror="this.onerror=null; this.src='/images/default-avatar.webp';" />
                                                <div>
                                                    <div class="rtub-messages__mention-item-username">@suggestion.displayName</div>
                                                    @if (!string.IsNullOrWhiteSpace(suggestion.fullName) && suggestion.fullName != suggestion.displayName)
                                                    {
                                                        <div class="rtub-messages__mention-item-fullname">@suggestion.fullName</div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }

                                @* Emoji picker panel *@
                                @if (isEmojiPickerOpen)
                                {
                                    <div class="rtub-messages__emoji-panel" @onclick:stopPropagation="true">
                                        @foreach (var emoji in EmojiList)
                                        {
                                            var e = emoji;
                                            <button class="rtub-messages__emoji-btn" @onclick="() => SelectEmoji(e)">@e</button>
                                        }
                                    </div>
                                }

                                <div class="rtub-messages__composer">
                                    <button class="rtub-messages__composer-emoji-btn"
                                            type="button"
                                            @onclick="() => { isEmojiPickerOpen = !isEmojiPickerOpen; isMentionDropdownOpen = false; reactionPickerOpenForMessageId = null; }"
                                            @onclick:stopPropagation="true"
                                            title="Emoji">
                                        <i class="bi bi-emoji-smile"></i>
                                    </button>
                                    <textarea @ref="messageInput" class="rtub-messages__composer-input messaging-input"
                                           placeholder="Escreva uma mensagem..."
                                           rows="1"
                                           maxlength="2000"
                                           disabled="@isSending"></textarea>
                                    <button class="rtub-messages__composer-send"
                                            @onclick="SendMessage"
                                            @onclick:stopPropagation="true"
                                            disabled="@isSending">
                                        @if (isSending)
                                        {
                                            <span class="spinner-border spinner-border-sm" role="status"></span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-send"></i>
                                        }
                                    </button>
                                </div>
                            </div>
                        }
                        else if (selectedConversation.IsAnnouncementOnly && !selectedConversation.CanSendMessage)
                        {
                            <div class="rtub-messages__thread-footer rtub-messages__thread-footer--readonly">
                                <div class="rtub-messages__readonly-notice">
                                    <i class="bi bi-megaphone"></i>
                                    <span>Canal apenas de anúncios</span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Mobile Bottom Nav (inside .rtub-messages so it's visible above z-index:1050 on mobile) -->
    <MobileBottomNav Items="@CurrentMobileNavItems" OnSelect="HandleMobileNavSelect" />
</div>
<Modal Show="@modals.IsOpen(ModalType.NewMessage)"
       ShowChanged="@(async (bool show) => { if (!show) await CloseNewMessageModal(); })"
       Title="Nova Mensagem"
       Centered="true"
       OnClose="CloseNewMessageModal">
    <BodyContent>
        <div class="mb-3">
            <label class="form-label">Destinatário</label>
            <SearchBar @bind-Value="memberSearchTerm"
                       Placeholder="Pesquisar membro por nome ou alcunha..."
                       OnSearch="OnMemberSearch"
                       OnClear="ClearMemberSelection"
                       Compact="true" />
        </div>

        @if (filteredMembers.Any())
        {
            <div class="rtub-messages__member-list mb-3">
                @foreach (var member in filteredMembers.Take(10))
                {
                    <div class="rtub-messages__member-item p-2 mb-2 border rounded rtub-messages__clickable" @key="member.Id"
                         @onclick="() => SelectMember(member)">
                        <div class="d-flex align-items-center">
                            <img src="@GetAvatarUrl(member.ImageUrl)" 
                                 alt="@(member.Nickname ?? $"{member.FirstName} {member.LastName}")"
                                 class="rtub-messages__member-avatar me-2" 
                                 onerror="this.onerror=null; this.src='/images/default-avatar.webp';" />
                            <div>
                                @if (!string.IsNullOrEmpty(member.Nickname))
                                {
                                    <div><strong>@member.Nickname</strong></div>
                                    <div class="text-muted small">@member.FirstName @member.LastName</div>
                                }
                                else
                                {
                                    <div><strong>@member.FirstName @member.LastName</strong></div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else if (!string.IsNullOrEmpty(memberSearchTerm) && selectedMember == null)
        {
            <div class="mt-2">
                <EmptyState Title="Nenhum membro encontrado"
                            Icon="bi-search"
                            Message="Tente ajustar os termos de pesquisa." />
            </div>
        }

        @if (selectedMember != null)
        {
            <div class="alert alert-success mb-3">
                <strong>Destinatário selecionado:</strong> 
                @(selectedMember.Nickname ?? $"{selectedMember.FirstName} {selectedMember.LastName}")
            </div>

            <div class="mb-3">
                <label class="form-label">Mensagem</label>
                <textarea class="form-control messaging-input" 
                          rows="4" 
                          placeholder="Escreva a sua mensagem..."
                          @bind="newMessageText"
                          maxlength="2000"></textarea>
                <small class="text-muted">@newMessageText.Length / 2000 caracteres</small>
            </div>
        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="CloseNewMessageModal">Cancelar</button>
        <button type="button" 
                class="btn btn-primary" 
                @onclick="SendNewMessage"
                disabled="@(selectedMember == null || string.IsNullOrWhiteSpace(newMessageText) || isSending)">
            @if (isSending)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
            }
            Enviar
        </button>
    </FooterContent>
</Modal>

@* New Group Modal *@
<Modal Show="@modals.IsOpen(ModalType.NewGroup)"
       ShowChanged="@(async (bool show) => { if (!show) await CloseNewGroupModal(); })"
       Title="Nova conversa de grupo"
       Size="Modal.ModalSize.Large"
       Centered="true"
       OnClose="CloseNewGroupModal">
    <BodyContent>
        @* Group name input *@
        <div class="mb-3">
            <label class="form-label">Nome do grupo</label>
            <input type="text" 
                   class="form-control messaging-input" 
                   placeholder="Inserir nome para o grupo..."
                   @bind="newGroupName"
                   maxlength="100" />
            <small class="text-muted">Escolha um nome descritivo para o grupo</small>
        </div>

        @* Member selection *@
        <div class="mb-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <label class="form-label mb-0">Adicionar membros</label>
                <span class="badge bg-primary">@selectedGroupMembers.Count selecionados</span>
            </div>
            <SearchBar @bind-Value="groupMemberSearchTerm"
                       Placeholder="Pesquisar membro por nome ou alcunha..."
                       OnSearch="OnGroupMemberSearch"
                       OnClear="ClearGroupMemberSearch"
                       Compact="true" />
        </div>

        @if (filteredGroupMembers.Any())
        {
            <div class="rtub-messages__member-list mb-3">
                @foreach (var member in filteredGroupMembers.Take(10))
                {
                    var isSelected = selectedGroupMembers.Any(m => m.Id == member.Id);
                    <div class="rtub-messages__member-item p-2 mb-2 border rounded rtub-messages__clickable @(isSelected ? "is-selected" : "")"
                         @onclick="() => ToggleGroupMember(member)">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center">
                                <img src="@GetAvatarUrl(member.ImageUrl)" 
                                     alt="@(member.Nickname ?? $"{member.FirstName} {member.LastName}")"
                                     class="rtub-messages__member-avatar me-2" 
                                     onerror="this.onerror=null; this.src='/images/default-avatar.webp';" />
                                <div>
                                    @if (!string.IsNullOrEmpty(member.Nickname))
                                    {
                                        <div><strong>@member.Nickname</strong></div>
                                        <div class="text-muted small">@member.FirstName @member.LastName</div>
                                    }
                                    else
                                    {
                                        <div><strong>@member.FirstName @member.LastName</strong></div>
                                    }
                                </div>
                            </div>
                            @if (isSelected)
                            {
                                <i class="bi bi-check-circle-fill text-success"></i>
                            }
                        </div>
                    </div>
                }
            </div>
        }

        @if (selectedGroupMembers.Any())
        {
            <div class="rtub-messages__selected-members mt-3">
                <label class="form-label">Membros selecionados:</label>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var member in selectedGroupMembers)
                    {
                        <span class="badge bg-primary d-flex align-items-center gap-1" @key="member.Id">
                            @(member.Nickname ?? $"{member.FirstName} {member.LastName}")
                            <button type="button" class="btn-close btn-close-white btn-sm" 
                                    @onclick="() => RemoveGroupMember(member)"
                                    @onclick:stopPropagation="true"></button>
                        </span>
                    }
                </div>
            </div>
        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="CloseNewGroupModal">Cancelar</button>
        <button type="button" 
                class="btn btn-primary" 
                @onclick="CreateGroup"
                disabled="@(string.IsNullOrWhiteSpace(newGroupName) || selectedGroupMembers.Count < MinimumGroupMembers || isCreatingGroup)">
            @if (isCreatingGroup)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
            }
            Criar grupo
        </button>
    </FooterContent>
</Modal>

@* Group Members Modal *@
<Modal Show="@(modals.IsOpen(ModalType.GroupMembers) && selectedConversation?.IsGroup == true && selectedConversation.GroupParticipants?.Any() == true)"
       ShowChanged="@(async (bool show) => { if (!show) await CloseGroupMembersModal(); })"
       Title="Membros do grupo"
       Centered="true"
       OnClose="CloseGroupMembersModal">
    <BodyContent>
        <p class="text-muted mb-3">@selectedConversation?.GroupParticipants?.Count membros neste grupo</p>

        @if (selectedConversation?.GroupParticipants?.Count > 20)
        {
            <div class="mb-3">
                <SearchBar @bind-Value="groupMembersSearchTerm"
                           Placeholder="Pesquisar membros do grupo..."
                           OnSearch="OnGroupMembersSearch"
                           OnClear="ClearGroupMembersSearch"
                           Compact="true" />
            </div>
        }

        @{
            var filteredParticipants = GetFilteredGroupParticipants().ToList();
        }

        <div class="rtub-messages__group-members-list">
            @if (!filteredParticipants.Any())
            {
                <EmptyState Title="Nenhum membro encontrado"
                            Icon="bi-search"
                            Message="Tente ajustar os termos de pesquisa." />
            }
            else
            {
                @foreach (var participant in filteredParticipants)
                {
                    <div class="rtub-messages__group-member" @key="participant.Id">
                        <img src="@GetAvatarUrl(participant.Avatar)"
                             alt="@(participant.Nickname ?? participant.Name)"
                             class="rtub-messages__group-member-avatar"
                             onerror="this.onerror=null; this.src='/images/default-avatar.webp';" />
                        <div class="rtub-messages__group-member-info">
                            <div class="rtub-messages__group-member-name">@(participant.Nickname ?? participant.Name)</div>
                            @if (!string.IsNullOrEmpty(participant.Nickname) && !string.IsNullOrEmpty(participant.Name))
                            {
                                <div class="rtub-messages__group-member-fullname">@participant.Name</div>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="CloseGroupMembersModal">Voltar Atrás</button>
    </FooterContent>
</Modal>

