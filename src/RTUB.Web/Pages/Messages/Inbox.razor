        if (msg != null)
        {
            msg.Reactions = reactions;
            StateHasChanged();
        }
    }

    private async Task HandleReactionUpdated(int conversationId, int messageId, List<MessageReactionSummaryDto> reactions)
    {
        if (selectedConversation?.Id != conversationId) return;
        HandleReactionUpdatedLocal(messageId, reactions);
        await InvokeAsync(StateHasChanged);
    }

    // ── Mention highlight rendering ─────────────────────────────────────

    private Microsoft.AspNetCore.Components.MarkupString RenderMentionHighlighted(string body)
    {
        if (string.IsNullOrEmpty(body) || !body.Contains('@'))
            return new Microsoft.AspNetCore.Components.MarkupString(System.Net.WebUtility.HtmlEncode(body));

        var parts = MentionHighlightRegex.Split(body);
        var sb = new System.Text.StringBuilder();
        foreach (var part in parts)
        {
            if (part.StartsWith('@') && part.Length > 1)
                sb.Append($"<span class=\"rtub-messages__mention\">{System.Net.WebUtility.HtmlEncode(part)}</span>");
            else
                sb.Append(System.Net.WebUtility.HtmlEncode(part));
        }
        return new Microsoft.AspNetCore.Components.MarkupString(sb.ToString());
    }

