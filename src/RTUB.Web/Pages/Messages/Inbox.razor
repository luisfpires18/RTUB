    private async Task SendReaction(MessageDto message, string emoji)
    {
        reactionPickerOpenForMessageId = null;
        if (selectedConversation == null) return;

        try
        {
            // Send via SignalR hub — hub handles toggle + broadcast
            await HubContext.Clients.User(currentUserId)
                .ReactionUpdated(selectedConversation.Id, message.Id, message.Reactions);

            // Call service directly and broadcast via hub
            var updatedReactions = await MessagingService.ToggleReactionAsync(message.Id, currentUserId, emoji);

            // Broadcast to all in the conversation
            var groupName = $"conversation-{selectedConversation.Id}";
            await HubContext.Clients.Group(groupName).ReactionUpdated(selectedConversation.Id, message.Id, updatedReactions);

            // Update local state immediately
            HandleReactionUpdatedLocal(message.Id, updatedReactions);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error sending reaction {Emoji} on message {MessageId}", emoji, message.Id);
        }
    }

    private void HandleReactionUpdatedLocal(int messageId, List<MessageReactionSummaryDto> reactions)
