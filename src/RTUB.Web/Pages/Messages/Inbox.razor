            var loadedConversations = (await MessagingService.GetUserConversationsAsync(currentUserId)).ToList();
            
            // Use cancellation token to handle disposal gracefully
            await _conversationsLock.WaitAsync(_disposalCancellationTokenSource.Token);
            try
            {
                conversations = loadedConversations;
            }
            finally
            {
                _conversationsLock.Release();
            }
        }
        catch (ObjectDisposedException)
        {
            // Component is being disposed and cancellation token source has been disposed, exit gracefully
        }
        catch (OperationCanceledException)
        {
            // Component is being disposed, exit gracefully
        }
        finally
        {
            isLoadingConversations = false;
        }
    }



    private void BackToConversations()
