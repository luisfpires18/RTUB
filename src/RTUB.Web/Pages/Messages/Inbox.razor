        var searchTerm = groupMembersSearchTerm.Trim().ToLowerInvariant();

        return selectedConversation.GroupParticipants
            .Where(p => (!string.IsNullOrEmpty(p.Nickname) && p.Nickname.ToLowerInvariant().Contains(searchTerm)) ||
                        (!string.IsNullOrEmpty(p.Name) && p.Name.ToLowerInvariant().Contains(searchTerm)))
            .ToList();
    }

