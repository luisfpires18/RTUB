    protected override async Task OnParametersSetAsync()
    {
        if (ConversationId.HasValue && ConversationId.Value > 0)
        {
            await SelectConversation(ConversationId.Value);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Lock body scroll on mobile when messages page loads
            // This prevents double-scroll issues on mobile devices
            await JSRuntime.InvokeVoidAsync("modalHelper.lockBodyScroll");
            
            // Clear all message notifications when entering the messages page
            // This ensures notifications are dismissed in PWA/browser mode
            await ClearAllMessageNotificationsAsync();
        }
        
        if (shouldScrollToBottom && !isLoadingMessages)
        {
            shouldScrollToBottom = false;
            await ScrollToLatestMessageAsync();
        }
        else if (shouldScrollIfNearEnd && !isLoadingMessages)
        {
            // For received messages, only scroll if user is near the bottom
            // This prevents jarring scrolls when user is reading history
            shouldScrollIfNearEnd = false;
            await JSRuntime.InvokeVoidAsync("messageScroller.scrollToBottomIfNearEnd", messageThreadBody);
        }
        
        // Setup input focus handler for mobile keyboard scrolling (only once)
        // Only setup when the textarea exists (not for system conversations or announcement-only)
        if (selectedConversation != null && 
            !selectedConversation.IsSystemConversation && 
            selectedConversation.CanSendMessage &&
            !isInputFocusHandlerSetup)
        {
            isInputFocusHandlerSetup = true;
            
            // Initialize JS-managed composer FIRST (handles Enter key, typing indicators, getTextAndClear)
            // This must succeed for sending to work — isolate viewport setup errors
            _composerDotNetRef ??= DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("messageComposer.init", messageInput, _composerDotNetRef);
            
            // Viewport/keyboard scroll setup — non-critical, don't block composer
            try { await JSRuntime.InvokeVoidAsync("messageScroller.setupInputFocusScroll", messageInput, messageThreadBody); }
            catch { /* viewport handler is optional — sending still works without it */ }
        }
    }

    private async Task LoadConversationsAsync()
