@page "/after-hours"
@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using RTUB.Application.Interfaces.AfterHours
@using RTUB.Core.Entities.AfterHours
@using RTUB.Core.Helpers.AfterHours
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IPlayerCycleStateService PlayerCycleStateService
@inject IGameCycleService GameCycleService
@inject IAfterHoursActionService Actions
@inject TimeProvider Clock

<PageTitle>After Hours - RTUB</PageTitle>

<div class="after-hours-page container">
    <div class="page-header-centered mb-4">
        <div class="page-header-center">
            <h1><i class="bi bi-moon-stars"></i> RTUB After Hours</h1>
            <p class="page-header-subtitle">A text-based crime RPG for RTUB members.</p>
        </div>
    </div>

    @if (!loaded)
    {
        <section class="after-hours-panel"><LoadingSpinner /></section>
    }
    else if (cycle is null || state is null)
    {
        <section class="after-hours-panel">
            <h2 class="after-hours-panel-title">No active cycle</h2>
            <p class="after-hours-panel-note">There is no After Hours cycle running right now. Check back soon.</p>
            <a class="btn btn-outline-light" href="/after-hours/yearbook"><i class="bi bi-journal-bookmark"></i> Yearbook</a>
        </section>
    }
    else
    {
        <section class="after-hours-panel">
            <h2 class="after-hours-panel-title">@cycle.Kind cycle · @cycle.FiscalYear?.FiscalYearString</h2>
            <dl class="after-hours-stats">
                <dt>Level</dt><dd>@state.Level</dd>
                <dt>XP</dt>
                <dd>
                    @state.XP
                    @if (state.Level < AfterHoursLevels.MaxLevel)
                    {
                        <span class="after-hours-muted">/ @AfterHoursLevels.XpForLevel(state.Level + 1)</span>
                        <progress class="after-hours-bar" value="@(state.XP - AfterHoursLevels.XpForLevel(state.Level))"
                                  max="@(AfterHoursLevels.XpForLevel(state.Level + 1) - AfterHoursLevels.XpForLevel(state.Level))"></progress>
                    }
                </dd>
                <dt>Wallet</dt><dd>$@state.WalletCash</dd>
                <dt>Bank</dt><dd>$@state.BankCash</dd>
                <dt>Energy</dt>
                <dd>
                    @state.Energy / @state.MaxEnergy
                    <progress class="after-hours-bar" value="@state.Energy" max="@state.MaxEnergy"></progress>
                </dd>
                <dt>Heat</dt><dd>@state.Heat</dd>
            </dl>

            @if (state.IsJailedAt(Now))
            {
                <p class="after-hours-alert" role="status"><i class="bi bi-lock"></i> In jail for @AfterHoursText.JailRemaining(state, Now).</p>
            }

            <div class="after-hours-links">
                <a class="btn btn-primary" href="/after-hours/crimes"><i class="bi bi-lightning"></i> Crimes</a>
                <a class="btn btn-outline-light" href="/after-hours/cargo"><i class="bi bi-box-seam"></i> Cargo &amp; buyers</a>
                <a class="btn btn-outline-light" href="/after-hours/training"><i class="bi bi-barbell"></i> Training</a>
                <a class="btn btn-outline-light" href="/after-hours/equipment"><i class="bi bi-shield"></i> Equipment</a>
                <a class="btn btn-outline-light" href="/after-hours/pvp"><i class="bi bi-crosshair"></i> PvP</a>
                <a class="btn btn-outline-light" href="/after-hours/family"><i class="bi bi-people"></i> Family</a>
                <a class="btn btn-outline-light" href="/after-hours/objectives"><i class="bi bi-list-check"></i> Objectives</a>
                <a class="btn btn-outline-light" href="/after-hours/leaderboards"><i class="bi bi-trophy"></i> Leaderboards</a>
                <a class="btn btn-outline-light" href="/after-hours/yearbook"><i class="bi bi-journal-bookmark"></i> Yearbook</a>
            </div>
        </section>

        <section class="after-hours-panel">
            <h2 class="after-hours-panel-title">Bank</h2>
            <p class="after-hours-panel-note">Wallet cash can be taken from you. Banked cash is safe. Deposits cost @AfterHoursActions.DepositFeePercent% (rounded up); withdrawals are free.</p>
            <div class="after-hours-bank">
                <label class="visually-hidden" for="ah-bank-amount">Amount</label>
                <input id="ah-bank-amount" class="form-control" type="number" min="1" step="1" inputmode="numeric" @bind="amount" />
                <button class="btn btn-outline-light" disabled="@busy" @onclick="DepositAsync">Deposit</button>
                <button class="btn btn-outline-light" disabled="@busy" @onclick="WithdrawAsync">Withdraw</button>
            </div>
        </section>

        @if (message is not null)
        {
            <p class="after-hours-result" role="status">@message</p>
        }
    }
</div>

@code {
    private bool loaded;
    private bool busy;
    private string? userId;
    private GameCycle? cycle;
    private PlayerCycleState? state;
    private long amount;
    private string? message;

    // One key per attempted action; kept until the action completes, so a double submit replays
    // instead of repeating it.
    private string pendingKey = Guid.NewGuid().ToString("N");

    private DateTime Now => Clock.GetUtcNow().UtcDateTime;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);

        // The folder policy guarantees an authenticated user; resolution is server-side only.
        if (userId is not null)
        {
            cycle = await GameCycleService.GetActiveCycleAsync();
            state = await PlayerCycleStateService.GetOrCreateForActiveCycleAsync(userId);
        }

        loaded = true;
    }

    private Task DepositAsync() => RunAsync(key => Actions.DepositAsync(userId!, amount, key));

    private Task WithdrawAsync() => RunAsync(key => Actions.WithdrawAsync(userId!, amount, key));

    private async Task RunAsync(Func<string, Task<AfterHoursActionResult>> action)
    {
        if (busy || userId is null) return;
        busy = true;
        try
        {
            var result = await action(pendingKey);
            state = result.State ?? state;
            message = result.Receipt is not null ? AfterHoursText.Describe(result.Receipt) : result.Error;
            pendingKey = Guid.NewGuid().ToString("N");
        }
        finally
        {
            busy = false;
        }
    }
}
