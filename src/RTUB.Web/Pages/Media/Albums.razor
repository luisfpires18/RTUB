    private string GetAlbumImageUrl(string imageSrc)
    {
        if (string.IsNullOrEmpty(imageSrc)) return string.Empty;
        
        // Add refresh trigger only when an image has been updated
        // This forces browser to re-fetch after edits while maintaining ETag caching
        if (imageRefreshTrigger > 0 && imageSrc.StartsWith("/api/images/"))
        {
            return $"{imageSrc}?r={imageRefreshTrigger}";
        }
        
        return imageSrc;
    }
    
    // Exclusive album member selection methods
    private Task HandleExclusiveMemberSearchChanged(string searchTerm)
    {
        exclusiveMemberSearchTerm = searchTerm;
        FilterAvailableMembersForExclusive();
        return Task.CompletedTask;
    }
    
    private void FilterAvailableMembersForExclusive()
    {
        if (string.IsNullOrWhiteSpace(exclusiveMemberSearchTerm))
        {
            filteredAvailableMembersForExclusive = new List<ApplicationUser>();
            return;
        }
        
        // Get list of already selected user IDs
        var selectedUserIds = selectedAuthorizedUsers.Select(u => u.Id).ToHashSet();
        
        // Filter members who are not already selected
        var search = exclusiveMemberSearchTerm.ToLower();
        filteredAvailableMembersForExclusive = allMembersForExclusive
            .Where(u => !selectedUserIds.Contains(u.Id))
            .Where(u => (u.FirstName?.ToLower().Contains(search) ?? false) ||
                       (u.LastName?.ToLower().Contains(search) ?? false) ||
                       (u.Nickname?.ToLower().Contains(search) ?? false))
            .OrderBy(u => u.FirstName)
            .Take(10) // Limit results for performance
            .ToList();
    }
    
    private void AddAuthorizedUser(ApplicationUser user)
    {
        if (!selectedAuthorizedUsers.Any(u => u.Id == user.Id))
        {
            selectedAuthorizedUsers.Add(user);
            exclusiveMemberSearchTerm = string.Empty;
            filteredAvailableMembersForExclusive = new List<ApplicationUser>();
            StateHasChanged();
        }
    }
    
    private void RemoveAuthorizedUser(ApplicationUser user)
    {
        selectedAuthorizedUsers.RemoveAll(u => u.Id == user.Id);
        StateHasChanged();
    }
    
    private void HandleMemberItemKeyDown(KeyboardEventArgs e, ApplicationUser member)
    {
        if (e.Key == "Enter" || e.Key == " ")
        {
            AddAuthorizedUser(member);
        }
    }
    
    private void OnExclusiveChanged()
    {
        // Clear search when exclusive checkbox is toggled
        if (editingAlbum != null && !editingAlbum.IsExclusive)
        {
            exclusiveMemberSearchTerm = string.Empty;
            filteredAvailableMembersForExclusive = new List<ApplicationUser>();
        }
        StateHasChanged();
    }
