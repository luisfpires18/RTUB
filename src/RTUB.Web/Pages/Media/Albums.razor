@page "/music"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Logging
@using RTUB.Application.Interfaces
@using RTUB.Application.Utilities
@using RTUB.Application.Helpers
@using RTUB.Shared
@inject IAlbumService AlbumService
@inject ISongService SongService
@inject IImageStorageService ImageStorageService
@inject NavigationManager NavigationManager
@inject IWebHostEnvironment Environment
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<Albums> Logger

<div class="d-flex flex-column gap-3 mb-4">
    <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
        <div>
            <h1 class="mb-2"><i class="bi bi-disc"></i> Música</h1>
            <p class="lead page-header-subtitle mb-0 text-light-theme">Discografia da RTUB</p>
        </div>

        <div class="page-header-actions justify-content-lg-end d-flex gap-2">
            <AuthorizeView>
                <Authorized>
                    <button class="btn btn-purple" style="font-weight: 400;" @onclick="OpenStatisticsModal" title="Ver Estatísticas">
                        <i class="bi bi-bar-chart-fill"></i> Estatísticas
                    </button>
                </Authorized>
            </AuthorizeView>
            
            <AuthorizeView Roles="Admin,Mod">
                <Authorized>
                    <button class="btn btn-success" @onclick="OpenCreateModal" title="Criar Novo Álbum">
                        <i class="bi bi-plus-lg"></i> Adicionar Álbum
                    </button>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>
</div>

@if (albums == null)
{
    <p>A carregar álbuns...</p>
}
else if (!albums.Any())
{
    <EmptyState Title="Nenhum album criado ainda"
               Icon="bi-info-circle" />
}
else
{
    <div class="row">
        @foreach (var album in paginatedAlbums)
        {
            <div class="col-md-4 col-lg-2 mb-4">
                <div class="card album-card h-100">
                    <div class="position-relative music-card-clickable" @onclick="() => NavigateToAlbum(album.Id)">
                        @if (!string.IsNullOrEmpty(album.CoverImageSrc))
                        {
                            <img src="@GetAlbumImageUrl(album.CoverImageSrc)" class="card-img-top music-square-image" alt="@album.Title">
                        }
                        else
                        {
                            <div class="card-img-top music-square-placeholder">
                                <i class="bi bi-disc music-icon-large"></i>
                            </div>
                        }
                        <AuthorizeView Roles="Admin,Mod">
                            <Authorized Context="modAuth">
                                <div class="admin-overlay">
                                    <button class="btn btn-sm music-btn-edit" @onclick:stopPropagation="true" @onclick="() => OpenEditModal(album)" title="Editar">
                                        <i class="bi bi-pencil music-icon-edit"></i>
                                    </button>
                                    <AuthorizeView Roles="Admin">
                                        <Authorized Context="adminAuth">
                                            <button class="btn btn-sm music-btn-delete" @onclick:stopPropagation="true" @onclick="() => OpenDeleteModal(album)" title="Eliminar">
                                                <i class="bi bi-trash music-icon-delete"></i>
                                            </button>
                                        </Authorized>
                                    </AuthorizeView>
                                </div>
                            </Authorized>
                        </AuthorizeView>
                    </div>
                    <div class="card-body d-flex flex-column music-card-clickable" @onclick="() => NavigateToAlbum(album.Id)">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <h5 class="card-title music-text-light mb-0">@album.Title</h5>
                            @if (album.IsPrivate)
                            {
                                <span class="badge bg-warning text-dark" title="Álbum privado">
                                    <i class="bi bi-lock-fill"></i>
                                </span>
                            }
                        </div>
                        @if (album.Year.HasValue)
                        {
                            <p class="card-text music-text-secondary">@album.Year.Value</p>
                        }
                        @if (!string.IsNullOrEmpty(album.Description))
                        {
                            <p class="card-text small flex-grow-1 music-text-secondary">@album.Description</p>
                        }
                        <div class="mt-auto">
                            <small class="music-text-secondary">
                                <i class="bi bi-music-note-list"></i> @GetSongCount(album.Id) músicas
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <TablePagination CurrentPage="@paginationHelper.CurrentPage"
                    PageSize="@paginationHelper.PageSize"
                    TotalItems="@albums.Count"
                    ItemLabel="álbuns"
                    PageSizeOptions="@(new[] { 6, 12, 18, 24 })"
                    OnPageChanged="@HandlePageChange"
                    OnPageSizeChanged="@HandlePageSizeChange" />
}

<!-- CRUD Modals -->
<CrudModalManager TEntity="Album"
                  ShowEditModal="@showEditModal"
                  ShowEditModalChanged="@((value) => showEditModal = value)"
                  IsCreateMode="@isCreateMode"
                  EditingEntity="@editingAlbum"
                  CreateTitle="Criar Novo Álbum"
                  EditTitle="Editar Álbum"
                  ModalSize="Modal.ModalSize.Default"
                  OnSave="SaveAlbum"
                  OnEditModalClosed="CloseEditModal"
                  ShowDeleteModal="@showDeleteModal"
                  ShowDeleteModalChanged="@((value) => showDeleteModal = value)"
                  DeletingEntity="@deletingAlbum"
                  DeleteTitle="Confirmar Eliminação"
                  OnDelete="DeleteAlbum"
                  OnDeleteModalClosed="CloseDeleteModal">
    <EditFormContent Context="album">
        <EditForm Model="album" OnValidSubmit="SaveAlbum" id="albumForm">
            <DataAnnotationsValidator />
            <ErrorDisplay />

            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <i class="bi bi-disc text-primary me-2"></i>Título
                </label>
                <InputText class="form-control" @bind-Value="album!.Title" placeholder="Inserir título do álbum..." />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <i class="bi bi-calendar3 text-primary me-2"></i>Ano (opcional)
                </label>
                <InputNumber class="form-control" @bind-Value="album!.Year" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <i class="bi bi-text-paragraph text-primary me-2"></i>Descrição (opcional)
                </label>
                <InputTextArea class="form-control" rows="3" @bind-Value="album!.Description" placeholder="Inserir descrição..." />
            </div>

            <div class="mb-3">
                <div class="rtub-checkbox-wrapper">
                    <div class="form-check">
                        <InputCheckbox class="form-check-input rtub-checkbox-large" id="albumIsPrivate" @bind-Value="album!.IsPrivate" />
                        <label class="form-check-label" for="albumIsPrivate">
                            <i class="bi bi-lock text-primary me-2"></i>Privado (apenas membros autenticados)
                        </label>
                    </div>
                </div>
            </div>

            <ImageUploadManager @ref="imageUploadManager"
                               Label="Imagem de Capa"
                               CurrentImageUrl="@(uploadedImagePath == null && !string.IsNullOrEmpty(album!.CoverImageSrc) ? GetAlbumImageUrl(album.CoverImageSrc) : null)"
                               ShowCurrentImage="@(uploadedImagePath == null)"
                               PreviewCssClass="music-album-preview"
                               OnFileSelected="HandleImageUpload" />
        </EditForm>
    </EditFormContent>
    <EditFormFooterContent Context="album">
        <button type="button" class="btn btn-secondary" @onclick="CloseEditModal">Cancelar</button>
        <button type="submit" form="albumForm" class="btn btn-success">Guardar</button>
    </EditFormFooterContent>
    <DeleteConfirmationContent Context="album">
        <p>Tem certeza que deseja eliminar o álbum <strong>@album?.Title</strong>?</p>
        <p class="text-warning"><i class="bi bi-exclamation-triangle"></i> Esta ação também eliminará todas as músicas associadas a este álbum.</p>
    </DeleteConfirmationContent>
</CrudModalManager>

<!-- Image Cropper Component -->
<ImageCropper @ref="imageCropper"
              ShowModal="showCropperModal"
              ShowModalChanged="OnCropperModalChanged"
              OnImageCropped="OnImageCropped"
              AspectRatio="1.0"
              AspectRatioHelp="Album covers are displayed in 1:1 aspect ratio (square) for consistent presentation"
              ImageFormat="image/webp"
              ImageQuality="0.85" />

<!-- Statistics Modal -->
<Modal Show="@showStatisticsModal"
       ShowChanged="@((value) => showStatisticsModal = value)"
       Title="Estatísticas de Música"
       Size="Modal.ModalSize.Large"
       ShowCloseButton="true">
    <BodyContent>
        @if (isLoadingStatistics)
        {
            <div class="text-center py-4">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">A carregar...</span>
                </div>
            </div>
        }
        else
        {
            <div class="statistics-container">
                <!-- Top Songs Section -->
                <div class="mb-4">
                    <h4 class="mb-3"><i class="bi bi-music-note-list"></i> Músicas Mais Tocadas</h4>
                    @if (paginatedSongsStats != null && paginatedSongsStats.Any())
                    {
                        <div class="stats-card-grid">
                            @{
                                var startIndex = (songsPaginationHelper.CurrentPage - 1) * songsPaginationHelper.PageSize;
                            }
                            @for (int i = 0; i < paginatedSongsStats.Count; i++)
                            {
                                var (song, playCount) = paginatedSongsStats[i];
                                var position = startIndex + i + 1;
                                <div class="stats-card">
                                    <div class="stats-card-position">
                                        @if (position == 1)
                                        {
                                            <span class="stats-medal gold">🥇</span>
                                        }
                                        else if (position == 2)
                                        {
                                            <span class="stats-medal silver">🥈</span>
                                        }
                                        else if (position == 3)
                                        {
                                            <span class="stats-medal bronze">🥉</span>
                                        }
                                        else
                                        {
                                            <span class="stats-position">@position</span>
                                        }
                                    </div>
                                    <div class="stats-card-content">
                                        <div class="stats-card-title">@song.Title</div>
                                        <div class="stats-card-subtitle">@song.Album?.Title</div>
                                    </div>
                                    <div class="stats-card-count">
                                        <i class="bi bi-play-circle"></i>
                                        <span>@playCount</span>
                                    </div>
                                </div>
                            }
                        </div>
                        <TablePagination 
                            CurrentPage="@songsPaginationHelper.CurrentPage"
                            PageSize="@songsPaginationHelper.PageSize"
                            TotalItems="@allSongsStats.Count"
                            ItemLabel="músicas"
                            PageSizeOptions="@(new[] { 5, 10, 15, 20, 25 })"
                            OnPageChanged="@HandleSongsPageChanged"
                            OnPageSizeChanged="@HandleSongsPageSizeChanged" />
                    }
                    else
                    {
                        <p class="text-muted">Ainda não há músicas tocadas.</p>
                    }
                </div>

                <!-- Top Albums Section -->
                <!-- Top Albums Section -->
                <div class="mb-4">
                    <h4 class="mb-3"><i class="bi bi-disc"></i> Álbuns Mais Tocados</h4>
                    @if (paginatedAlbumsStats != null && paginatedAlbumsStats.Any())
                    {
                        <div class="stats-card-grid">
                            @{
                                var albumStartIndex = (albumsPaginationHelper.CurrentPage - 1) * albumsPaginationHelper.PageSize;
                            }
                            @for (int i = 0; i < paginatedAlbumsStats.Count; i++)
                            {
                                var (album, playCount) = paginatedAlbumsStats[i];
                                var position = albumStartIndex + i + 1;
                                <div class="stats-card">
                                    <div class="stats-card-position">
                                        @if (position == 1)
                                        {
                                            <span class="stats-medal gold">🥇</span>
                                        }
                                        else if (position == 2)
                                        {
                                            <span class="stats-medal silver">🥈</span>
                                        }
                                        else if (position == 3)
                                        {
                                            <span class="stats-medal bronze">🥉</span>
                                        }
                                        else
                                        {
                                            <span class="stats-position">@position</span>
                                        }
                                    </div>
                                    <div class="stats-card-content">
                                        <div class="stats-card-title">@album.Title</div>
                                        <div class="stats-card-subtitle">@(album.Year?.ToString() ?? string.Empty)</div>
                                    </div>
                                    <div class="stats-card-count">
                                        <i class="bi bi-play-circle"></i>
                                        <span>@playCount</span>
                                    </div>
                                </div>
                            }
                        </div>
                        <TablePagination 
                            CurrentPage="@albumsPaginationHelper.CurrentPage"
                            PageSize="@albumsPaginationHelper.PageSize"
                            TotalItems="@allAlbumsStats.Count"
                            ItemLabel="álbuns"
                            PageSizeOptions="@(new[] { 5, 10, 15, 20, 25 })"
                            OnPageChanged="@HandleAlbumsPageChanged"
                            OnPageSizeChanged="@HandleAlbumsPageSizeChanged" />
                    }
                    else
                    {
                        <p class="text-muted">Ainda não há álbuns tocados.</p>
                    }
                </div>

                <!-- Admin Section - Detailed Stats -->
                <AuthorizeView Roles="Admin">
                    <Authorized>
                        <div class="mb-4">
                            <h4 class="mb-3"><i class="bi bi-person-badge"></i> Estatísticas Detalhadas por Utilizador</h4>
                            @if (allUserStats != null && allUserStats.Any())
                            {
                                <!-- Search Bar -->
                                <div class="mb-3">
                                    <SearchBar @bind-Value="userStatsSearchTerm"
                                               Placeholder="Pesquisar por nome..."
                                               OnSearch="@HandleUserStatsSearchChanged" />
                                </div>

                                @if (!filteredUserStats.Any())
                                {
                                    <EmptyState 
                                        Title="Nenhum utilizador encontrado com os critérios de pesquisa." 
                                        Icon="bi-search" />
                                }
                                else
                                {
                                    @foreach (var userGroup in paginatedUserStats)
                                    {
                                        var isExpanded = userStatsExpanded.GetValueOrDefault(userGroup.UserId, false);
                                        <div class="user-stats-group mb-4">
                                            <div class="user-stats-header" @onclick="() => ToggleUserStats(userGroup.UserId)" style="cursor: pointer;">
                                                <img src="@userGroup.ProfilePictureSrc" alt="@userGroup.Nickname" class="user-stats-avatar" />
                                                <div class="user-stats-info">
                                                    <div class="user-stats-nickname">@userGroup.Nickname</div>
                                                    <div class="user-stats-fullname">@userGroup.FirstName @userGroup.LastName</div>
                                                </div>
                                                <div class="user-stats-total">@userGroup.TotalPlays reproduções</div>
                                                <i class="bi @(isExpanded ? "bi-chevron-up" : "bi-chevron-down") ms-auto"></i>
                                            </div>
                                            @if (isExpanded)
                                            {
                                                <div class="stats-card-grid mt-2">
                                                    @foreach (var song in userGroup.Songs)
                                                    {
                                                        <div class="stats-card stats-card-detailed">
                                                            <div class="stats-card-content">
                                                                <div class="stats-card-title">@song.SongTitle</div>
                                                                <div class="stats-card-subtitle">@song.AlbumTitle</div>
                                                            </div>
                                                            <div class="stats-card-count">
                                                                <i class="bi bi-play-circle"></i>
                                                                <span>@song.PlayCount</span>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                    <TablePagination 
                                        CurrentPage="@usersPaginationHelper.CurrentPage"
                                        PageSize="@usersPaginationHelper.PageSize"
                                        TotalItems="@filteredUserStats.Count"
                                        ItemLabel="utilizadores"
                                        PageSizeOptions="@(new[] { 5, 10, 15, 20, 25 })"
                                        OnPageChanged="@HandleUsersPageChanged"
                                        OnPageSizeChanged="@HandleUsersPageSizeChanged" />
                                }
                            }
                            else
                            {
                                <p class="text-muted">Ainda não há estatísticas de utilizadores.</p>
                            }
                        </div>
                    </Authorized>
                </AuthorizeView>
            </div>
        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="CloseStatisticsModal">Fechar</button>
    </FooterContent>
</Modal>

@code {
    private List<Album>? albums;
    private List<Album> paginatedAlbums = new();
    private List<Song>? allSongs;
    private PaginationHelper<Album> paginationHelper = new() { PageSize = 6 };

    private bool showEditModal = false;
    private bool showDeleteModal = false;
    private bool showCropperModal = false;
    private bool showStatisticsModal = false;
    private bool isLoadingStatistics = false;
    private bool isCreateMode = false;
    private Album? editingAlbum;
    private Album? deletingAlbum;
    private string? uploadedImagePath;
    private ImageCropper? imageCropper;
    private IBrowserFile? selectedFile;
    private ImageUploadManager? imageUploadManager;
    private int imageRefreshTrigger = 0;
    private byte[]? croppedImageBytes;
    private string? croppedImageFileName = "album-cover.webp";
    
    // Statistics data
    private List<(Song Song, int PlayCount)> allSongsStats = new();
    private List<(Song Song, int PlayCount)> paginatedSongsStats = new();
    private List<(Album Album, int PlayCount)> allAlbumsStats = new();
    private List<(Album Album, int PlayCount)> paginatedAlbumsStats = new();
    private List<(UserPlayInfo User, Song Song, Album Album, int PlayCount)> detailedStats = new();
    private List<UserStatsGroup> allUserStats = new();
    private List<UserStatsGroup> filteredUserStats = new();
    private List<UserStatsGroup> paginatedUserStats = new();
    private Dictionary<string, bool> userStatsExpanded = new(); // Track collapsed/expanded state
    private string userStatsSearchTerm = string.Empty;
    
    // Statistics pagination helpers
    private PaginationHelper<(Song Song, int PlayCount)> songsPaginationHelper = new() { PageSize = 5 };
    private PaginationHelper<(Album Album, int PlayCount)> albumsPaginationHelper = new() { PageSize = 5 };
    private PaginationHelper<UserStatsGroup> usersPaginationHelper = new() { PageSize = 5 };
    
    // Helper class for grouping user stats
    public class UserStatsGroup
    {
        public string UserId { get; set; } = "";
        public string Nickname { get; set; } = "";
        public string FirstName { get; set; } = "";
        public string LastName { get; set; } = "";
        public string ProfilePictureSrc { get; set; } = "";
        public List<SongPlayInfo> Songs { get; set; } = new();
        public int TotalPlays => Songs.Sum(s => s.PlayCount);
    }
    
    public class SongPlayInfo
    {
        public string SongTitle { get; set; } = "";
        public string AlbumTitle { get; set; } = "";
        public int PlayCount { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAlbums();
    }

    private async Task LoadAlbums()
    {
        // Check if user is authenticated
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        bool isAuthenticated = user.Identity?.IsAuthenticated ?? false;

        if (isAuthenticated)
        {
            // Show all albums for authenticated users
            albums = (await AlbumService.GetAllAlbumsAsync())
                .OrderByDescending(a => a.Year.HasValue)  // Albums with year first
                .ThenBy(a => a.Year)                       // Then order by year ascending
                .ToList();
        }
        else
        {
            // Show only public albums for unauthenticated users
            albums = (await AlbumService.GetPublicAlbumsAsync())
                .OrderByDescending(a => a.Year.HasValue)  // Albums with year first
                .ThenBy(a => a.Year)                       // Then order by year ascending
                .ToList();
        }
        
        allSongs = (await SongService.GetAllSongsAsync()).ToList();
        UpdatePagination();
    }

    private void UpdatePagination()
    {
        if (albums != null)
        {
            paginatedAlbums = paginationHelper.GetPageData(albums);
        }
    }

    private async Task HandlePageChange(int newPage)
    {
        if (paginationHelper.GoToPage(newPage))
        {
            UpdatePagination();
        }
        await Task.CompletedTask;
    }

    private async Task HandlePageSizeChange(int newPageSize)
    {
        paginationHelper.PageSize = newPageSize;
        paginationHelper.Reset();
        UpdatePagination();
        await Task.CompletedTask;
    }

    private int GetSongCount(int albumId)
    {
        return allSongs?.Count(s => s.AlbumId == albumId) ?? 0;
    }

    private void NavigateToAlbum(int albumId)
    {
        NavigationManager.NavigateTo($"/music/songs/{albumId}");
    }

    private void OpenCreateModal()
    {
        isCreateMode = true;
        editingAlbum = new Album
        {
            Year = DateTime.Now.Year
        };
        uploadedImagePath = null;
        showEditModal = true;
    }

    private void OpenEditModal(Album album)
    {
        isCreateMode = false;
        editingAlbum = new Album
        {
            Id = album.Id,
            Title = album.Title,
            Description = album.Description,
            Year = album.Year,
            ImageUrl = album.ImageUrl,
            IsPrivate = album.IsPrivate
        };
        uploadedImagePath = null;
        showEditModal = true;
    }

    private void CloseEditModal()
    {
        showEditModal = false;
        editingAlbum = null;
        uploadedImagePath = null;
        croppedImageBytes = null;
        imageUploadManager?.Reset();
    }

    private async Task HandleImageUpload(IBrowserFile file)
    {
        try
        {
            if (file != null)
            {
                selectedFile = file;

                if (imageCropper != null)
                {
                    await imageCropper.LoadImageAsync(selectedFile);
                }
            }
        }
        catch (Exception)
        {
            // Handle error silently or show message
        }
    }

    private void OnImageCropped(byte[] croppedImageData)
    {
        try
        {
            if (editingAlbum != null && croppedImageData != null && croppedImageData.Length > 0)
            {
                // Store the cropped image bytes for upload when saving
                croppedImageBytes = croppedImageData;
                uploadedImagePath = "uploaded";
                
                StateHasChanged();
            }
        }
        catch (Exception)
        {
            // Handle error
        }
    }

    private void OnCropperModalChanged(bool isOpen)
    {
        showCropperModal = isOpen;
        StateHasChanged();
    }

    private async Task SaveAlbum()
    {
        if (editingAlbum == null) return;

        // Check if user has Admin or Mod role
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (!user.IsInRole("Admin") && !user.IsInRole("Mod"))
        {
            return; // Unauthorized
        }

        if (isCreateMode)
        {
            // Upload image BEFORE creating entity to include in single Create audit log
            string? imageUrl = null;
            if (croppedImageBytes != null && croppedImageBytes.Length > 0)
            {
                using var stream = new MemoryStream(croppedImageBytes);
                var normalizedName = S3KeyNormalizer.NormalizeForS3Key(editingAlbum.Title);
                imageUrl = await ImageStorageService.UploadImageAsync(stream, croppedImageFileName!, "image/webp", "albums", normalizedName);
            }

            await AlbumService.CreateAlbumAsync(
                editingAlbum.Title,
                editingAlbum.Year,
                editingAlbum.Description ?? string.Empty,
                imageUrl,
                editingAlbum.IsPrivate
            );
        }
        else
        {
            // Check if we're updating both details and image - combine into single transaction to avoid duplicate audit logs
            if (croppedImageBytes != null && croppedImageBytes.Length > 0 && uploadedImagePath != null)
            {
                using var stream = new MemoryStream(croppedImageBytes);
                await AlbumService.UpdateAlbumWithCoverAsync(
                    editingAlbum.Id,
                    editingAlbum.Title,
                    editingAlbum.Year,
                    editingAlbum.Description ?? string.Empty,
                    editingAlbum.IsPrivate,
                    stream,
                    croppedImageFileName!,
                    "image/webp");
                imageRefreshTrigger++;
            }
            else
            {
                // Only updating album details (no new image)
                await AlbumService.UpdateAlbumAsync(
                    editingAlbum.Id,
                    editingAlbum.Title,
                    editingAlbum.Year,
                    editingAlbum.Description ?? string.Empty,
                    editingAlbum.IsPrivate
                );
            }
        }

        await LoadAlbums();
        StateHasChanged();
        CloseEditModal();
    }

    private void OpenDeleteModal(Album album)
    {
        deletingAlbum = album;
        showDeleteModal = true;
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
        deletingAlbum = null;
    }

    private async Task DeleteAlbum()
    {
        if (deletingAlbum == null) return;

        // Check if user has Admin or Mod role
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (!user.IsInRole("Admin") && !user.IsInRole("Mod"))
        {
            return; // Unauthorized
        }

        await AlbumService.DeleteAlbumAsync(deletingAlbum.Id);
        await LoadAlbums();

        CloseDeleteModal();
    }
    
    private async Task OpenStatisticsModal()
    {
        showStatisticsModal = true;
        isLoadingStatistics = true;
        StateHasChanged();
        
        try
        {
            await LoadStatistics();
        }
        catch (Exception ex)
        {
            // Log error using proper logger
            Logger.LogError(ex, "Error loading statistics");
        }
        finally
        {
            isLoadingStatistics = false;
            StateHasChanged();
        }
    }
    
    private async Task LoadStatistics()
    {
        // Load all statistics data (not just top N)
        var allSongsTask = SongService.GetAllSongsWithPlayCountAsync();
        var allAlbumsTask = SongService.GetAllAlbumsWithPlayCountAsync();
        
        // Check if user is admin for detailed stats
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var authUser = authState.User;
        bool isAdmin = authUser.IsInRole("Admin");
        
        Task<IEnumerable<(UserPlayInfo, Song, Album, int)>>? detailedStatsTask = null;
        if (isAdmin)
        {
            detailedStatsTask = SongService.GetDetailedPlayStatsAsync();
        }
        
        // Wait for tasks to complete
        allSongsStats = (await allSongsTask).ToList();
        allAlbumsStats = (await allAlbumsTask).ToList();
        
        // Set up pagination for songs
        paginatedSongsStats = songsPaginationHelper.GetPageData(allSongsStats);
        
        // Set up pagination for albums
        paginatedAlbumsStats = albumsPaginationHelper.GetPageData(allAlbumsStats);
        
        if (detailedStatsTask != null)
        {
            detailedStats = (await detailedStatsTask).ToList();
            
            // Group by user
            allUserStats = detailedStats
                .GroupBy(s => s.User.UserId)
                .Select(g => new UserStatsGroup
                {
                    UserId = g.First().User.UserId,
                    Nickname = g.First().User.Nickname,
                    FirstName = g.First().User.FirstName,
                    LastName = g.First().User.LastName,
                    ProfilePictureSrc = g.First().User.ProfilePictureSrc,
                    Songs = g.Select(s => new SongPlayInfo
                    {
                        SongTitle = s.Song.Title,
                        AlbumTitle = s.Album.Title,
                        PlayCount = s.PlayCount
                    })
                    .OrderByDescending(s => s.PlayCount)
                    .ToList()
                })
                .OrderByDescending(u => u.TotalPlays)
                .ToList();
            
            // Reset search and apply filtering/pagination for users
            userStatsSearchTerm = string.Empty;
            FilterUserStats();
            
            // Initialize all as collapsed (false = collapsed)
            userStatsExpanded.Clear();
            foreach (var user in allUserStats)
            {
                userStatsExpanded[user.UserId] = false;
            }
        }
    }
    
    private void UpdateSongsPagination()
    {
        paginatedSongsStats = songsPaginationHelper.GetPageData(allSongsStats);
    }
    
    private void UpdateAlbumsPagination()
    {
        paginatedAlbumsStats = albumsPaginationHelper.GetPageData(allAlbumsStats);
    }
    
    private void UpdateUsersPagination()
    {
        FilterUserStats();
    }
    
    private void FilterUserStats()
    {
        if (allUserStats == null)
        {
            filteredUserStats = new List<UserStatsGroup>();
            paginatedUserStats = new List<UserStatsGroup>();
            return;
        }

        // Apply search filter
        if (string.IsNullOrWhiteSpace(userStatsSearchTerm))
        {
            filteredUserStats = allUserStats.ToList();
        }
        else
        {
            var searchTerm = userStatsSearchTerm.ToLower();
            filteredUserStats = allUserStats
                .Where(u => u.Nickname.ToLower().Contains(searchTerm) ||
                            u.FirstName.ToLower().Contains(searchTerm) ||
                            u.LastName.ToLower().Contains(searchTerm))
                .ToList();
        }

        // Apply pagination to filtered list
        paginatedUserStats = usersPaginationHelper.GetPageData(filteredUserStats);
    }
    
    private async Task HandleUserStatsSearchChanged(string searchTerm)
    {
        userStatsSearchTerm = searchTerm;
        usersPaginationHelper.Reset(); // Reset to first page on search
        FilterUserStats();
        await Task.CompletedTask;
    }
    
