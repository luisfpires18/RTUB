    protected override async Task OnInitializedAsync()
    {
        // Get current user ID
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            currentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            
            // Load all members for exclusive album feature (for Owners)
            if (user.IsInRole("Owner"))
            {
                allMembersForExclusive = await UserManager.Users
                    .AsNoTracking()
                    .Select(u => new ApplicationUser
                    {
                        Id = u.Id,
                        FirstName = u.FirstName,
                        LastName = u.LastName,
                        Nickname = u.Nickname,
                        ImageUrl = u.ImageUrl
                    })
                    .ToListAsync();
            }
        }
        
        await LoadAlbums();
    }

    private async Task LoadAlbums()
    {
        // Check if user is authenticated
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        bool isAuthenticated = user.Identity?.IsAuthenticated ?? false;
        bool isOwner = user.IsInRole("Owner");

        if (isAuthenticated && !string.IsNullOrEmpty(currentUserId))
        {
            // Show albums the user has access to (non-exclusive + exclusive where user is authorized)
            // Owners can see all albums
            albums = (await AlbumService.GetAlbumsForUserAsync(currentUserId, isOwner))
                .OrderByDescending(a => a.Year.HasValue)  // Albums with year first
                .ThenBy(a => a.Year)                       // Then order by year ascending
                .ToList();
        }
        else
        {
            // Show only public albums for unauthenticated users
            albums = (await AlbumService.GetPublicAlbumsAsync())
                .OrderByDescending(a => a.Year.HasValue)  // Albums with year first
                .ThenBy(a => a.Year)                       // Then order by year ascending
                .ToList();
        }
        
        // Separate albums into public and private lists in a single pass
        publicAlbums = new List<Album>();
        privateAlbums = new List<Album>();
        foreach (var album in albums)
        {
            if (album.IsPrivate)
            {
                privateAlbums.Add(album);
            }
            else
            {
                publicAlbums.Add(album);
            }
        }
        
        allSongs = (await SongService.GetAllSongsAsync()).ToList();
        UpdatePublicPagination();
        UpdatePrivatePagination();
    }

    private void UpdatePublicPagination()
    {
        paginatedPublicAlbums = publicPaginationHelper.GetPageData(publicAlbums);
    }

    private void UpdatePrivatePagination()
    {
        paginatedPrivateAlbums = privatePaginationHelper.GetPageData(privateAlbums);
    }

