    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="CloseEditModal" disabled="@isEditing">Cancelar</button>
        <button type="button" class="btn btn-primary btn-primary-purple" @onclick="HandleEditClick" disabled="@isEditing">
            @if (isEditing)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
            }
            Guardar
        </button>
    </FooterContent>
</Modal>

<!-- Delete Confirmation Modal -->
<ConfirmDialog Show="@showDeleteModal"
               ShowChanged="@((bool show) => showDeleteModal = show)"
               Title="Confirmar Eliminação"
               Message="@($"Tem certeza que deseja eliminar \"{deletingMedia?.Title}\"?")"
               WarningMessage="Esta ação não pode ser desfeita."
               ConfirmText="Eliminar"
               CancelText="Cancelar"
               ConfirmButtonClass="btn-danger"
               OnConfirm="HandleDelete"
               OnCancel="CloseDeleteModal" />

<!-- Lightbox Modal -->
<DetailsModal Show="@showLightbox"
              ShowChanged="@((bool show) => showLightbox = show)"
              Title="@(lightboxMedia?.Title ?? "")"
              HeaderTitle="@(lightboxMedia?.Title ?? "")"
              UseRectangularImage="true"
              Size="Modal.ModalSize.ExtraLarge"
              OnClose="CloseLightbox">
    <ImageContent>
        @if (lightboxMedia != null)
        {
            @if (lightboxMedia.MediaType == MediaType.Image)
            {
                <img src="@lightboxMedia.MediaUrl" alt="@lightboxMedia.Title" class="mb-3 details-modal-image-rectangular" />
            }
            else
            {
                <video controls class="mb-3 details-modal-image-rectangular">
                    <source src="@lightboxMedia.MediaUrl" type="video/mp4" />
                    O seu browser não suporta a reprodução de vídeo.
                </video>
            }
        }
    </ImageContent>
    <Sections>
        @if (lightboxMedia != null)
        {
            <!-- Date Section -->
            <div class="row mb-3">
                <div class="col-12">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-calendar3 text-primary fs-5"></i>
                        <div>
                            <small class="text-muted d-block">Data</small>
                            <strong>@FormatMediaDate(lightboxMedia.Year, lightboxMedia.Month, lightboxMedia.Day)</strong>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Pessoas Section -->
            @if (lightboxMedia.PeopleInMedia.Any())
            {
                <div class="row mb-3">
                    <div class="col-12">
                        <div class="d-flex align-items-start gap-2">
                            <i class="bi bi-people text-primary fs-5"></i>
                            <div>
                                <small class="text-muted d-block">Pessoas</small>
                                <div class="d-flex flex-wrap gap-1 mt-1">
                                    @foreach (var tag in lightboxMedia.PeopleInMedia)
                                    {
                                        <PersonBadge Name="@(tag.User.Nickname ?? tag.User.FirstName)"
                                                    ShowCloseButton="false" />
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </Sections>
    <FooterContent>
        @if (lightboxMedia != null)
        {
            <button type="button" class="btn btn-primary" @onclick="() => DownloadMedia(lightboxMedia)" title="Download file">
                <i class="bi bi-download me-2"></i>Download
            </button>
        }
        <button type="button" class="btn btn-secondary" @onclick="CloseLightbox">Fechar</button>
    </FooterContent>
</DetailsModal>

@code {
    // Constants
    private const int VideoElementRenderDelayMs = 100; // Delay to ensure video element is rendered before attaching MediaSession
    
    // Data
    private List<GalleryMedia> allMedia = new();
    private Dictionary<int, List<GalleryMedia>> groupedMedia = new();
    private List<ApplicationUser> allMembers = new();
    private List<ApplicationUser> filteredMembers = new();
    private List<ApplicationUser> filteredEditMembers = new();
    private List<int> availableYears = new();
    private List<ApplicationUser> taggedPeople = new();
    
    // Components
    private MediaUploadManager? mediaUploadManager;

    // Filters
    private string selectedYear = "";
    private string selectedPersonId = "";
    private List<FilterDropdownOption> yearFilterOptions = new();
    private List<FilterDropdownOption> peopleFilterOptions = new();

    // Pagination
    private int currentPage = 1;
    private int pageSize = 15;
    private int[] pageSizeOptions = { 15, 30, 45, 60, 75 };
    private bool hasMore = false;

    // State
    private bool isLoading = true;
    private bool isLoadingMore = false;
    private bool isUploading = false;
    private bool isEditing = false;

    // Modals
    private bool showUploadModal = false;
    private bool showEditModal = false;
    private bool showDeleteModal = false;
    private bool showLightbox = false;

    // Upload
    private UploadModel uploadModel = new();
    private IBrowserFile? selectedFile = null;
    private string personSearchTerm = "";
    private string editPersonSearchTerm = "";

    // Edit
    private GalleryMedia? editingMedia = null;
    private EditModel editModel = new();

    // Delete
    private GalleryMedia? deletingMedia = null;

    // Lightbox
    private GalleryMedia? lightboxMedia = null;

    // User
    private string? currentUserId;
    private bool isAdmin = false;
    private bool isAuthenticated = false;

    // Timeline rendering
    private int timelineItemIndex = 0;
    private Dictionary<int, bool> mediaPositions = new(); // Track if each media is on the left (true) or right (false)

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrentUser();
        await LoadMembers();
        await LoadAvailableYears();
        await LoadTaggedPeople();
        await LoadMedia();
    }

    private async Task LoadCurrentUser()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        isAuthenticated = user.Identity?.IsAuthenticated ?? false;
        currentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        isAdmin = user.IsInRole("Admin");
    }

    private async Task LoadMembers()
    {
        allMembers = await UserManager.Users
            .OrderBy(u => u.Nickname ?? u.FirstName)
            .AsNoTracking()
            .ToListAsync();
    }

    private async Task LoadAvailableYears()
    {
        availableYears = (await GalleryMediaService.GetAvailableYearsAsync(isAuthenticated)).ToList();
        yearFilterOptions = availableYears
            .OrderByDescending(y => y)
            .Select(y => new FilterDropdownOption(y.ToString(), y.ToString()))
            .ToList();
    }

    private async Task LoadTaggedPeople()
    {
        // Get distinct users who are tagged in at least one gallery media
        // Note: This loads all media but only extracts user IDs - could be optimized with a dedicated query
        var allMediaWithTags = await GalleryMediaService.GetAllAsync(isAuthenticated: isAuthenticated);
        var taggedUserIds = allMediaWithTags
            .SelectMany(m => m.PeopleInMedia.Select(p => p.UserId))
            .Distinct()
            .ToHashSet();

        // If no one is tagged yet, return empty list
        if (!taggedUserIds.Any())
        {
            taggedPeople = new List<ApplicationUser>();
            peopleFilterOptions = new List<FilterDropdownOption>();
            return;
        }

        taggedPeople = allMembers
            .Where(m => taggedUserIds.Contains(m.Id))
            .OrderBy(m => m.Nickname ?? m.FirstName)
            .ToList();

        peopleFilterOptions = taggedPeople
            .Select(p => new FilterDropdownOption(
                p.Id,
                p.Nickname ?? $"{p.FirstName} {p.LastName}"))
            .ToList();
    }

    private async Task LoadMedia()
    {
        isLoading = true;
        try
        {
            var yearFilter = string.IsNullOrEmpty(selectedYear) ? (int?)null : int.Parse(selectedYear);
            var personFilter = string.IsNullOrEmpty(selectedPersonId) ? null : selectedPersonId;

            var result = await GalleryMediaService.GetPaginatedAsync(currentPage, pageSize, yearFilter, personFilter, isAuthenticated);
            
            if (currentPage == 1)
            {
                allMedia = result.Items.ToList();
            }
            else
            {
                allMedia.AddRange(result.Items);
            }

            hasMore = allMedia.Count < result.TotalCount;
            GroupMediaByYear();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading gallery media");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void GroupMediaByYear()
    {
        timelineItemIndex = 0; // Reset timeline index for rendering
        groupedMedia = allMedia
            .GroupBy(m => m.Year)
            .OrderByDescending(g => g.Key)
            .ToDictionary(g => g.Key, g => g.ToList()); // Don't sort here, we'll sort in the rendering
        
        // Assign stable positions to each media item
        int globalIndex = 0;
        foreach (var yearGroup in groupedMedia.OrderByDescending(g => g.Key))
        {
            var sortedMedia = yearGroup.Value
                .OrderByDescending(m => m.Month ?? 0)
                .ThenByDescending(m => m.Day ?? 0)
                .ThenByDescending(m => m.TakenAt ?? m.CreatedAt)
                .ToList();
            
            foreach (var media in sortedMedia)
            {
                if (!mediaPositions.ContainsKey(media.Id))
                {
                    mediaPositions[media.Id] = globalIndex % 2 == 0; // true = left, false = right
                }
                globalIndex++;
            }
        }
    }

    private async Task ApplyFilters()
    {
        currentPage = 1;
        allMedia.Clear();
        await LoadMedia();
    }

    private async Task LoadMore()
    {
        isLoadingMore = true;
        currentPage++;
        await LoadMedia();
        isLoadingMore = false;
    }

    // Upload Modal
    private void OpenUploadModal()
    {
        uploadModel = new UploadModel();
        selectedFile = null;
        showUploadModal = true;
    }

    private void CloseUploadModal()
    {
        showUploadModal = false;
        uploadModel = new UploadModel();
        selectedFile = null;
    }

    private async Task HandleFileSelected(IBrowserFile file)
    {
        selectedFile = file;

        // Generate preview for images
        if (selectedFile.ContentType.StartsWith("image/"))
        {
            try
            {
                var buffer = new byte[selectedFile.Size];
                using var stream = selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
                await stream.ReadAsync(buffer);
                var base64 = Convert.ToBase64String(buffer);
                uploadModel.PreviewUrl = $"data:{selectedFile.ContentType};base64,{base64}";
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error generating preview");
            }
        }

        // Try to extract EXIF date if available (simplified - could be enhanced with ExifLib)
        // For now, pre-fill with current date if not set
        if (uploadModel.SelectedDate == default)
        {
            uploadModel.SelectedDate = DateTime.Today;
        }
        
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleUploadClick()
    {
        if (selectedFile == null || string.IsNullOrEmpty(uploadModel.Title))
        {
            return;
        }

        isUploading = true;
        try
        {
            var mediaType = selectedFile.ContentType.StartsWith("image/") ? MediaType.Image : MediaType.Video;
            
            // Validate file size
            var maxSize = GalleryMediaStorageService.GetMaxFileSize(mediaType);
            if (selectedFile.Size > maxSize)
            {
                Logger.LogError("File size {Size} exceeds maximum allowed size {MaxSize}", selectedFile.Size, maxSize);
                // TODO: Show user-friendly error message
                return;
            }

            // Create media entity
            // Smart detection: if day is 1 and month is 1, save only year
            // if day is 1 (but not Jan), save year and month
            // otherwise save full date
            int year = uploadModel.SelectedDate.Year;
            byte? month = null;
            byte? day = null;
            
            if (uploadModel.SelectedDate.Month == 1 && uploadModel.SelectedDate.Day == 1)
            {
                // Jan 1st - save only year
            }
            else if (uploadModel.SelectedDate.Day == 1)
            {
                // 1st of some month (not Jan) - save year and month
                month = (byte)uploadModel.SelectedDate.Month;
            }
            else
            {
                // Any other day - save full date
                month = (byte)uploadModel.SelectedDate.Month;
                day = (byte)uploadModel.SelectedDate.Day;
            }

            // Upload file with metadata for proper naming
            using var stream = selectedFile.OpenReadStream(maxAllowedSize: maxSize);
            var mediaUrl = await GalleryMediaStorageService.UploadMediaAsync(
                stream, selectedFile.Name, selectedFile.ContentType, mediaType,
                uploadModel.Title, year, month, day);
            
            var media = GalleryMedia.Create(
                currentUserId!,
                uploadModel.Title,
                mediaType,
                mediaUrl,
                year,
                month,
                day,
                null,
                null,
                uploadModel.IsPrivate
            );

            await GalleryMediaService.CreateAsync(media);

            // Add person tags
            if (uploadModel.TaggedPeopleIds.Any())
            {
                await GalleryMediaService.AddPersonTagsAsync(media.Id, uploadModel.TaggedPeopleIds);
            }

            // Send notification
            await SendUploadNotification(media);

            // Reload
            await LoadAvailableYears();
            currentPage = 1;
            allMedia.Clear();
            await LoadMedia();

            CloseUploadModal();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error uploading media");
        }
        finally
        {
            isUploading = false;
        }
    }

    private void OnPersonSearch()
    {
        if (string.IsNullOrWhiteSpace(personSearchTerm))
        {
            filteredMembers.Clear();
            return;
        }

        var searchTerm = personSearchTerm.ToLower();
        filteredMembers = allMembers
            .Where(m => 
                !uploadModel.TaggedPeopleIds.Contains(m.Id) && // Exclude already selected
                ((m.Nickname != null && m.Nickname.ToLower().Contains(searchTerm)) ||
                (m.FirstName != null && m.FirstName.ToLower().Contains(searchTerm)) ||
                (m.LastName != null && m.LastName.ToLower().Contains(searchTerm))))
            .OrderBy(m => m.Nickname ?? m.FirstName)
            .ToList();
    }

    private void ClearPersonSearch()
    {
        personSearchTerm = "";
        filteredMembers.Clear();
    }

