@page "/gallery"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using RTUB.Application.Interfaces
@using RTUB.Application.DTOs
@using RTUB.Core.Entities
@using RTUB.Core.Enums
@using System.Globalization
@using RTUB.Shared
@inject IGalleryMediaService GalleryMediaService
@inject IGalleryMediaStorageService GalleryMediaStorageService
@inject UserManager<ApplicationUser> UserManager
@inject IConfiguration Configuration
@inject IPushNotificationService PushNotificationService
@inject IUserProfileRepository UserProfileRepository
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<Gallery> Logger
@inject RTUB.Web.Interop.MediaSessionInterop MediaSession

<div class="d-flex flex-column gap-3 mb-4">
    <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
        <div>
            <h1 class="mb-2"><i class="bi bi-images"></i> Galeria</h1>
            <p class="lead page-header-subtitle mb-0 text-light-theme">Memórias da RTUB através dos anos.</p>
        </div>

        <div class="page-header-actions justify-content-lg-end">
            <AuthorizeView Roles="Admin,Member">
                <Authorized>
                    <button class="btn btn-success" @onclick="OpenUploadModal" title="Carregar Media">
                        <i class="bi bi-cloud-upload"></i> Carregar
                    </button>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>

    <!-- Filters -->
    <div class="d-flex flex-column flex-lg-row align-items-lg-end gap-2 flex-wrap justify-content-between">
        <div class="d-flex flex-column flex-sm-row gap-2 flex-grow-1">
            <div class="flex-sm-shrink-0" style="min-width: 200px; max-width: 240px;">
                <label class="form-label fw-semibold">Ano</label>
                <FilterDropdown IconClass="bi-calendar3"
                               AllItemsLabel="Todos os anos"
                               Options="@yearFilterOptions"
                               @bind-SelectedValue="selectedYear"
                               OnChange="ApplyFilters" />
            </div>
            <div class="flex-grow-1" style="min-width: 300px; max-width: 400px;">
                <label class="form-label fw-semibold">Pessoas</label>
                <FilterDropdown IconClass="bi-people"
                               AllItemsLabel="Todas as pessoas"
                               Options="@peopleFilterOptions"
                               @bind-SelectedValue="selectedPersonId"
                               OnChange="ApplyFilters" />
            </div>
        </div>
        <div class="flex-sm-shrink-0" style="min-width: 150px; max-width: 180px;">
            <label class="form-label fw-semibold">Itens por página</label>
            <select class="form-select" @bind="pageSize" @bind:after="ApplyFilters">
                @foreach (var size in pageSizeOptions)
                {
                    <option value="@size">@size</option>
                }
            </select>
        </div>
    </div>
</div>

@if (isLoading)
{
    <div class="d-flex justify-content-center my-5">
        <LoadingSpinner />
    </div>
}
else if (!groupedMedia.Any())
{
    <EmptyState Title="Nenhuma media encontrada"
                Icon="bi-images"
                Message="@(string.IsNullOrEmpty(selectedYear) && string.IsNullOrEmpty(selectedPersonId) ? "Ainda não há conteúdo na galeria." : "A pesquisa não devolveu resultados.")" />
}
else
{
    <!-- Timeline Container -->
    <div class="gallery-timeline">
        <!-- Central vertical line -->
        <div class="gallery-timeline-line"></div>
        
        @foreach (var yearGroup in groupedMedia)
        {
            <!-- Year badge/pill -->
            <div class="timeline-year-node">
                <div class="timeline-year-marker">
                    <div class="timeline-year-dot"></div>
                    <h2 class="timeline-year-label">@yearGroup.Key</h2>
                </div>
            </div>

            @RenderMediaItems(yearGroup.Key, yearGroup.Value)
        }
    </div>

    <!-- Load More Button -->
    @if (hasMore)
    {
        <div class="text-center my-4">
            <button class="btn btn-primary btn-primary-purple" @onclick="LoadMore" disabled="@isLoadingMore">
                @if (isLoadingMore)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                }
                Carregar Mais
            </button>
        </div>
    }
}

<!-- Upload Modal -->
<Modal Show="@showUploadModal"
       ShowChanged="@((bool show) => showUploadModal = show)"
       Title="Carregar Media"
       Size="Modal.ModalSize.Large"
       Centered="true">
    <BodyContent>
        <EditForm Model="@uploadModel" OnValidSubmit="HandleUploadClick">
            <DataAnnotationsValidator />
            <ErrorDisplay />

            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <i class="bi bi-file-earmark-image text-primary me-2"></i>Ficheiro <span class="text-danger">*</span>
                </label>
                <MediaUploadManager @ref="mediaUploadManager"
                                   Label=""
                                   CurrentMediaUrl="@uploadModel.PreviewUrl"
                                   ShowCurrentMedia="true"
                                   PreviewCssClass="gallery-media-modal__preview"
                                   OnFileSelected="HandleFileSelected" />
                @if (selectedFile != null)
                {
                    <small class="form-text text-muted">
                        Ficheiro selecionado: @selectedFile.Name (@FormatFileSize(selectedFile.Size))
                    </small>
                }
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <i class="bi bi-type text-primary me-2"></i>Título <span class="text-danger">*</span>
                </label>
                <InputText class="form-control" @bind-Value="uploadModel.Title" placeholder="Título da media..." />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <i class="bi bi-calendar text-primary me-2"></i>Data <span class="text-danger">*</span>
                </label>
                <InputDate class="form-control" @bind-Value="uploadModel.SelectedDate" />
                <div class="form-text small text-muted">
                    Se não tiver a certeza da data exata, pode escolher o primeiro dia do mês ou do ano. O sistema guardará apenas a informação disponível.
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <i class="bi bi-people text-primary me-2"></i>Pessoas marcadas
                </label>
                <div class="member-search-container">
                    <SearchBar @bind-Value="personSearchTerm"
                               Placeholder="Pesquisar pessoa por nome ou alcunha..."
                               OnSearch="OnPersonSearch"
                               OnClear="ClearPersonSearch"
                               Compact="true" />
                </div>
                
                @if (!string.IsNullOrEmpty(personSearchTerm) && filteredMembers.Any())
                {
                    <div class="list-group mt-2" style="max-height: 200px; overflow-y: auto;">
                        @foreach (var member in filteredMembers.Take(10))
                        {
                            <button type="button" 
                                    class="list-group-item list-group-item-action"
                                    @onclick="() => TogglePersonTag(member.Id)">
                                <div class="d-flex align-items-center">
                                    <img src="@member.ProfilePictureSrc" alt="@(member.Nickname ?? member.FirstName)" class="rounded-circle me-2" style="width: 30px; height: 30px; object-fit: cover;" />
                                    <span>@(member.Nickname ?? $"{member.FirstName} {member.LastName}")</span>
                                </div>
                            </button>
                        }
                    </div>
                }
                else if (!string.IsNullOrEmpty(personSearchTerm) && !filteredMembers.Any())
                {
                    <div class="text-muted small mt-2">
                        <i class="bi bi-info-circle me-1"></i>Nenhuma pessoa encontrada
                    </div>
                }
                
                @if (uploadModel.TaggedPeopleIds.Any())
                {
                    <div class="mt-2">
                        <strong class="small">Selecionados:</strong>
                        <div class="d-flex flex-wrap gap-1 mt-1">
                            @foreach (var personId in uploadModel.TaggedPeopleIds)
                            {
                                var person = allMembers.FirstOrDefault(m => m.Id == personId);
                                if (person != null)
                                {
                                    <PersonBadge Name="@(person.Nickname ?? person.FirstName)"
                                                ShowCloseButton="true"
                                                OnClose="() => RemovePersonTag(personId)" />
                                }
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="mb-3">
                <div class="rtub-checkbox-wrapper">
                    <div class="form-check">
                        <InputCheckbox class="form-check-input rtub-checkbox-large" id="uploadIsPrivate" @bind-Value="uploadModel.IsPrivate" />
                        <label class="form-check-label" for="uploadIsPrivate">
                            <i class="bi bi-lock text-primary me-2"></i>Visível apenas para membros
                        </label>
                    </div>
                </div>
                <div class="form-text small text-muted mt-1">
                    Se marcado, apenas membros autenticados podem ver esta media. Desmarcado, qualquer visitante pode visualizar.
                </div>
            </div>
        </EditForm>
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="CloseUploadModal" disabled="@isUploading">Cancelar</button>
        <button type="button" class="btn btn-primary btn-primary-purple" @onclick="HandleUploadClick" disabled="@isUploading">
            @if (isUploading)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
            }
            Carregar
        </button>
    </FooterContent>
</Modal>

<!-- Edit Modal -->
