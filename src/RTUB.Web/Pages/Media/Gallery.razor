    // Delete Modal
    private void OpenDeleteModal(GalleryMedia media)
    {
        deletingMedia = media;
        showDeleteModal = true;
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
        deletingMedia = null;
    }

    private async Task HandleDelete()
    {
        if (deletingMedia == null) return;

        try
        {
            // Delete file from storage
            await GalleryMediaStorageService.DeleteMediaAsync(deletingMedia.MediaUrl);

            // Delete from database
            await GalleryMediaService.DeleteAsync(deletingMedia.Id);

            // Reload
            await LoadAvailableYears();
            currentPage = 1;
            allMedia.Clear();
            await LoadMedia();

            CloseDeleteModal();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting media");
        }
    }

    // Lightbox
    private async Task OpenLightbox(GalleryMedia media)
    {
        lightboxMedia = media;
        showLightbox = true;
        
        // Set media session metadata for videos
        if (media.MediaType == MediaType.Video)
        {
            try
            {
                // Use a small delay to ensure video element is rendered before attaching
                await Task.Delay(VideoElementRenderDelayMs);
                await MediaSession.AttachToVideoAsync(
                    ".details-modal-image-rectangular",
                    media.Title ?? "Vídeo RTUB",
                    FormatMediaDate(media.Year, media.Month, media.Day),
                    "" // Gallery videos don't have dedicated artwork, use default RTUB logo
                );
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to set video media session metadata");
            }
        }
    }

    private async Task CloseLightbox()
    {
        showLightbox = false;
        lightboxMedia = null;
        
        // Clear media session when modal closes
        try
        {
            await MediaSession.ClearMetadataAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to clear media session metadata on modal close");
        }
    }

    // Helpers
    private bool CanEditOrDelete(GalleryMedia media)
    {
        return isAdmin || media.UploaderId == currentUserId;
    }

    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }

    private async Task SendUploadNotification(GalleryMedia media)
    {
        try
        {
            // Reload media with all details including tags
            var reloadedMedia = await GalleryMediaService.GetByIdAsync(media.Id);
            if (reloadedMedia == null)
            {
                Logger.LogWarning("Cannot send upload notification: media ID {MediaId} not found", media.Id);
                return;
            }
            
            // Get distinct tagged user IDs
            var taggedUserIds = reloadedMedia.PeopleInMedia
                .Select(p => p.UserId)
                .Distinct()
                .ToList();
            
            // If no one is tagged, don't send notifications
            if (!taggedUserIds.Any())
            {
                Logger.LogDebug("No tagged users for media ID {MediaId}, skipping notification", media.Id);
                return;
            }
            
            // Send notification only to tagged users
            var notification = new SendPushNotificationDto
            {
                Title = "Nova media na Galeria",
                Body = $"Foste marcado em \"{reloadedMedia.Title}\"",
                Url = "/gallery"
            };
            
            await PushNotificationService.SendToSelectedUsersAsync(taggedUserIds, notification);
            Logger.LogInformation("Sent gallery notification to {Count} tagged users for media ID {MediaId}", taggedUserIds.Count, media.Id);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Error sending upload notification (non-critical)");
        }
    }

    private string GetDisplayName(ApplicationUser? user)
    {
        if (user == null)
        {
            Logger.LogWarning("GetDisplayName called with null user");
            return "Utilizador desconhecido";
        }
        
        return !string.IsNullOrEmpty(user.Nickname) 
            ? user.Nickname 
            : $"{user.FirstName} {user.LastName}";
    }

    private string GetDownloadFileName(GalleryMedia media)
    {
        // Extract the original filename from the URL
        var uri = new Uri(media.MediaUrl);
        var fileName = Path.GetFileName(uri.LocalPath);
        
        // If we can't get a filename, create one from title and date
        if (string.IsNullOrEmpty(fileName))
        {
            var extension = media.MediaType == MediaType.Image ? ".jpg" : ".mp4";
            var dateStr = FormatMediaDate(media.Year, media.Month, media.Day).Replace(" ", "-");
            fileName = $"{media.Title}_{dateStr}{extension}";
        }
        
        return fileName;
    }

    private async Task DownloadMedia(GalleryMedia media)
    {
        var fileName = GetDownloadFileName(media);
        
        // Use JavaScript to download the file
        await JSRuntime.InvokeVoidAsync("downloadFileFromUrl", media.MediaUrl, fileName);
    }

    private RenderFragment RenderMediaItems(int year, List<GalleryMedia> mediaList)
    {
        // Sort media by month (descending - newest first), day, and created date
        var sortedMedia = mediaList
            .OrderByDescending(m => m.Month ?? 0) // null months go to beginning, then 12->1
            .ThenByDescending(m => m.Day ?? 0)
            .ThenByDescending(m => m.TakenAt ?? m.CreatedAt)
            .ToList();
        
        int? currentMonth = null;
        
        return __builder =>
        {
            foreach (var media in sortedMedia)
            {
                // Check if we need to show a month label
                if (currentMonth != media.Month)
                {
                    currentMonth = media.Month;
                    <div class="gallery-timeline-month-label">
                        @if (media.Month.HasValue)
                        {
                            <text>@GetMonthName(media.Month.Value) @year</text>
                        }
                        else
                        {
                            <text>Sem mês definido</text>
                        }
                    </div>
                }

                var isLeft = mediaPositions.ContainsKey(media.Id) ? mediaPositions[media.Id] : (timelineItemIndex % 2 == 0);
                <div class="gallery-timeline-item @(isLeft ? "left" : "right")">
                    <!-- Dot on the line -->
                    <div class="gallery-timeline-dot"></div>
                    
                    <!-- Media card -->
                    <div class="gallery-card" @onclick="() => OpenLightbox(media)">
                        <div class="media-card-image">
                            @if (media.MediaType == MediaType.Image)
                            {
                                <img src="@media.MediaUrl" alt="@media.Title" loading="lazy" />
                            }
                            else
                            {
                                <div class="video-thumbnail">
                                    @if (!string.IsNullOrEmpty(media.ThumbnailUrl))
                                    {
                                        <img src="@media.ThumbnailUrl" alt="@media.Title" loading="lazy" />
                                    }
                                    <div class="video-overlay">
                                        <i class="bi bi-play-circle-fill"></i>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="media-card-body">
                            <h5 class="media-card-title">@media.Title</h5>
                            <div class="media-card-meta">
                                <div class="text-muted small mb-2">
                                    @FormatMediaDate(media.Year, media.Month, media.Day)
                                </div>
                                @if (media.PeopleInMedia.Any())
                                {
                                    <div class="tagged-people">
                                        <i class="bi bi-people-fill me-1"></i>
                                        <span class="small">@string.Join(", ", media.PeopleInMedia.Select(p => p.User.Nickname ?? p.User.FirstName).Take(3))</span>
                                        @if (media.PeopleInMedia.Count > 3)
                                        {
                                            <span class="small text-muted"> +@(media.PeopleInMedia.Count - 3)</span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                        
                        @if (CanEditOrDelete(media))
                        {
                            <div class="gallery-admin-overlay">
                                <button class="btn btn-sm music-btn-edit" @onclick:stopPropagation="true" @onclick="() => OpenEditModal(media)" title="Editar">
                                    <i class="bi bi-pencil music-icon-edit"></i>
                                </button>
                                <button class="btn btn-sm music-btn-delete" @onclick:stopPropagation="true" @onclick="() => OpenDeleteModal(media)" title="Eliminar">
                                    <i class="bi bi-trash music-icon-delete"></i>
                                </button>
                            </div>
                        }
                    </div>
                </div>
                timelineItemIndex++;
            }
        };
    }

    private string GetMonthName(int month)
    {
        try
        {
            var date = new DateTime(2000, month, 1);
            return date.ToString("MMMM", new CultureInfo("pt-PT"));
        }
        catch
        {
            return $"Mês {month}";
        }
    }

    private string FormatMediaDate(int year, byte? month, byte? day)
    {
        try
        {
            if (month.HasValue && day.HasValue)
            {
                // Validate that the date is valid (handles Feb 30, Apr 31, etc.)
                if (DateTime.DaysInMonth(year, month.Value) >= day.Value)
                {
                    var date = new DateTime(year, month.Value, day.Value);
                    return date.ToString("dd MMM yyyy", new CultureInfo("pt-PT"));
                }
                // If day is invalid for the month, just show month and year
                var monthDate = new DateTime(year, month.Value, 1);
                return monthDate.ToString("MMM yyyy", new CultureInfo("pt-PT"));
            }
            else if (month.HasValue)
            {
                var date = new DateTime(year, month.Value, 1);
                return date.ToString("MMM yyyy", new CultureInfo("pt-PT"));
            }
            else
            {
                return year.ToString();
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Error formatting media date: Year={Year}, Month={Month}, Day={Day}", year, month, day);
            return year.ToString(); // Fallback to just showing the year
        }
    }

