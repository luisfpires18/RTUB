                    <label class="form-label fw-semibold">
                        <i class="bi bi-type text-primary me-2"></i>Título <span class="text-danger">*</span>
                    </label>
                    <InputText class="form-control" @bind-Value="editModel.Title" placeholder="Título da media..." />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-calendar text-primary me-2"></i>Data <span class="text-danger">*</span>
