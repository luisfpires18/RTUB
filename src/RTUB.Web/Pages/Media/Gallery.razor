    }

    // Edit Modal
    private void OpenEditModal(GalleryMedia media)
    {
        editingMedia = media;
        
        // Reconstruct date from year/month/day
        // Use day 1 if not specified, and month 1 if not specified
        DateTime selectedDate;
        
        if (media.Day.HasValue && media.Month.HasValue)
        {
            selectedDate = new DateTime(media.Year, media.Month.Value, media.Day.Value);
        }
        else if (media.Month.HasValue)
        {
            selectedDate = new DateTime(media.Year, media.Month.Value, 1);
        }
        else
        {
            selectedDate = new DateTime(media.Year, 1, 1);
        }
        
        editModel = new EditModel
        {
            Title = media.Title,
            SelectedDate = selectedDate,
            TaggedPeopleIds = media.PeopleInMedia.Select(p => p.UserId).ToList(),
            IsPrivate = media.IsPrivate
        };
        showEditModal = true;
    }

    private void CloseEditModal()
    {
        showEditModal = false;
        editingMedia = null;
        editModel = new EditModel();
        filteredEditMembers.Clear();
        editPersonSearchTerm = "";
    }

    private async Task HandleEditClick()
    {
        if (editingMedia == null || string.IsNullOrEmpty(editModel.Title))
        {
            return;
        }

        isEditing = true;
        try
        {
            // Reload the entity to avoid EF tracking conflicts
            var mediaToUpdate = await GalleryMediaService.GetByIdAsync(editingMedia.Id);
            if (mediaToUpdate == null)
            {
                Logger.LogError("Media with ID {Id} not found", editingMedia.Id);
                return;
            }

            // Get current tags before update
            var currentTags = mediaToUpdate.PeopleInMedia.Select(p => p.UserId).ToList();
            var tagsToAdd = editModel.TaggedPeopleIds.Except(currentTags).ToList();
            var tagsToRemove = currentTags.Except(editModel.TaggedPeopleIds).ToList();

            // Update media details
            // Smart detection: if day is 1 and month is 1, save only year
            // if day is 1 (but not Jan), save year and month
            // otherwise save full date
            int year = editModel.SelectedDate.Year;
            byte? month = null;
            byte? day = null;
            
            if (editModel.SelectedDate.Month == 1 && editModel.SelectedDate.Day == 1)
            {
                // Jan 1st - save only year
            }
            else if (editModel.SelectedDate.Day == 1)
            {
                // 1st of some month (not Jan) - save year and month
                month = (byte)editModel.SelectedDate.Month;
            }
            else
            {
                // Any other day - save full date
                month = (byte)editModel.SelectedDate.Month;
                day = (byte)editModel.SelectedDate.Day;
            }
            
            mediaToUpdate.UpdateDetails(editModel.Title, year, month, day);
            mediaToUpdate.UpdatePrivacy(editModel.IsPrivate);
            await GalleryMediaService.UpdateAsync(mediaToUpdate);

            // Update tags
            if (tagsToAdd.Any())
            {
                await GalleryMediaService.AddPersonTagsAsync(mediaToUpdate.Id, tagsToAdd);
            }

            if (tagsToRemove.Any())
            {
                await GalleryMediaService.RemovePersonTagsAsync(mediaToUpdate.Id, tagsToRemove);
            }

            // Update the local item instead of reloading everything
            var localItem = allMedia.FirstOrDefault(m => m.Id == mediaToUpdate.Id);
            if (localItem != null)
            {
                localItem.Title = mediaToUpdate.Title;
                localItem.Year = mediaToUpdate.Year;
                localItem.Month = mediaToUpdate.Month;
                localItem.Day = mediaToUpdate.Day;
                localItem.IsPrivate = mediaToUpdate.IsPrivate;
                // Update people tags
                localItem.PeopleInMedia.Clear();
                foreach (var personId in editModel.TaggedPeopleIds)
                {
                    var user = allMembers.FirstOrDefault(m => m.Id == personId);
                    if (user != null)
                    {
                        var tag = GalleryMediaPersonTag.Create(localItem.Id, personId);
                        tag.User = user;
                        localItem.PeopleInMedia.Add(tag);
                    }
                }
                
                // Update the item in the grouped dictionary if year didn't change
                if (groupedMedia.ContainsKey(localItem.Year))
                {
                    var yearGroup = groupedMedia[localItem.Year];
                    var index = yearGroup.FindIndex(m => m.Id == localItem.Id);
                    if (index >= 0)
                    {
                        yearGroup[index] = localItem;
                    }
                }
            }

            CloseEditModal();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error editing media");
        }
        finally
        {
            isEditing = false;
        }
    }

