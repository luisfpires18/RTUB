</Modal>

<!-- Delete Song Confirmation Modal -->
<ConfirmDialog Show="@showDeleteModal"
               ShowChanged="@((value) => showDeleteModal = value)"
               Title="Confirmar Eliminação"
               Message="@($"Tem certeza que deseja eliminar a música {deletingSong?.Title}?")"
               WarningMessage="Esta ação não pode ser revertida."
               ConfirmText="Eliminar"
               CancelText="Cancelar"
               ConfirmButtonClass="btn-danger"
               OnConfirm="DeleteSong"
               OnCancel="CloseDeleteModal" />

<!-- Videos Modal (with Upload and View sections) -->
<Modal Show="@showVideosModal" 
       ShowChanged="@((value) => showVideosModal = value)"
       Title="@($"Vídeos - {viewingVideosForSong?.Title}")" 
       Size="Modal.ModalSize.Large"
       Centered="true"
       ShowCloseButton="true"
       OnClose="@CloseVideosModal">
    <BodyContent>
        @* Upload Section - Visible to all logged-in users *@
        @if (currentUserId != null)
        {
            <div class="mb-4">
                <h6 class="mb-3">
                    <i class="bi bi-upload text-primary me-2"></i>Adicionar Vídeo
                </h6>
                
                @if (isUploadingVideo)
                {
                    <div class="text-center py-3">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">A carregar...</span>
                        </div>
                        <p class="mt-2">A enviar vídeo...</p>
                    </div>
                }
                else
                {
                    <div class="mb-3">
                        <label class="form-label">Ficheiro de vídeo</label>
                        <div class="localized-file-picker">
                            <InputFile id="@videoInputId" 
                                       @key="videoUploadKey"
                                       class="d-none" 
                                       OnChange="@HandleVideoSelection" 
                                       accept="video/*" 
                                       aria-label="Escolher vídeo" />
                            <label class="btn btn-outline-secondary localized-file-button" for="@videoInputId">
                                <i class="bi bi-upload me-2"></i>Escolher vídeo
                            </label>
                            <span class="localized-file-name">
                                @if (!string.IsNullOrEmpty(selectedVideoName))
                                {
                                    <text>@selectedVideoName</text>
                                }
                                else
                                {
                                    <text>Nenhum vídeo selecionado</text>
                                }
                            </span>
                        </div>
                        <small class="text-muted d-block mt-1">
                            <i class="bi bi-info-circle me-1"></i>Tamanho máximo: 100MB
                        </small>
                    </div>
                    
                    @if (selectedVideoFile != null)
                    {
                        <div class="mb-3">
                            <label class="form-label">Título do vídeo <span class="text-danger">*</span></label>
                            <InputText @bind-Value="videoTitle" class="form-control" placeholder="Digite um título para o vídeo" />
                            <small class="text-muted">Este nome aparecerá na lista de vídeos</small>
                        </div>
                        
                        <div class="d-flex justify-content-end">
                            <button type="button" class="btn btn-secondary me-2" @onclick="CancelVideoSelection">
                                Cancelar
                            </button>
                            <button type="button" class="btn btn-primary" @onclick="UploadVideo" disabled="@(string.IsNullOrWhiteSpace(videoTitle))">
                                <i class="bi bi-upload me-2"></i>Enviar vídeo
                            </button>
                        </div>
                    }
                }
            </div>
            
            <hr class="my-4" />
        }
        
        @* View Section *@
        <div>
            <h6 class="mb-3">
                <i class="bi bi-list-ul text-primary me-2"></i>Vídeos Disponíveis
            </h6>
            
            @if (songVideos == null || !songVideos.Any())
            {
                <EmptyState Title="Ainda não existem vídeos para esta música"
                           Icon="bi-camera-video"
                           Message="Os vídeos aparecerão aqui quando forem adicionados." />
            }
            else
            {
                var videos = songVideos.OrderBy(v => v.SortOrder).ToList();
                
                <div class="video-selector mb-3">
                    <label class="form-label fw-semibold">Selecione um vídeo:</label>
                    <div class="list-group">
                        @for (int i = 0; i < videos.Count; i++)
                        {
                            var index = i;
                            var video = videos[i];
                            var isSelected = selectedVideoId == video.Id;
                            
                            // Generate clean display title
                            var displayTitle = GetCleanVideoTitle(video, i + 1);
                            
                            <div class="list-group-item list-group-item-action position-relative @(isSelected ? "active" : "")"
                                 role="button"
                                 @onclick="() => SelectVideoByIndex(video.Id)">
                                <span class="video-title-content">
                                    <i class="bi bi-play-circle me-2"></i>@displayTitle
                                </span>
                                @if (CanDeleteVideo(video))
                                {
                                    <button type="button" 
                                            class="btn btn-sm admin-btn-delete position-absolute top-50 end-0 translate-middle-y me-2" 
                                            @onclick:stopPropagation="true"
                                            @onclick="() => DeleteVideoFromModal(video)"
                                            title="Eliminar vídeo">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>
                
                @if (selectedVideoId.HasValue)
                {
                    var selectedVideo = videos.FirstOrDefault(v => v.Id == selectedVideoId.Value);
                    if (selectedVideo != null)
                    {
                        <div class="video-player-container">
                            <video @key="@selectedVideo.Id" controls class="modal-video" preload="metadata">
                                <source src="@selectedVideo.Url" type="@selectedVideo.MimeType">
                                O seu navegador não suporta o elemento de vídeo.
                            </video>
                        </div>
                    }
                }
            }
        </div>
    </BodyContent>
</Modal>

@code {
    [Parameter]
    public int AlbumId { get; set; }

    private Album? album;
    private List<Song>? songs;

    private bool showCreateModal = false;
    private bool showEditModal = false;
    private bool showViewLyricsModal = false;
    private bool showViewLyricsPdfModal = false;
    private bool showLinksModal = false;
    private bool showDeleteModal = false;
    private bool showVideosModal = false;
    private Song? editingSong;
    private Song? viewingSong;
    private Song? deletingSong;
    private Song? viewingVideosForSong = null;
    private List<string> editingYouTubeUrls = new();
    private bool canManageSongs = false;
    private string? currentUserId = null;
    private bool isAdmin = false;
    
    // Video modal state (view and upload)
    private List<SongVideo>? songVideos = null;
    private int? selectedVideoId = null; // Changed from index to ID for better tracking
    private bool isUploadingVideo = false;
    private Guid videoUploadKey = Guid.NewGuid(); // Force InputFile to recreate on modal open
    private string videoInputId = $"song-video-{Guid.NewGuid():N}";
    private string? selectedVideoName = null;
    private IBrowserFile? selectedVideoFile = null;
    private string videoTitle = string.Empty;
    
    // Audio player state
    private string? currentAudioUrl;
    private string? currentSongTitle;
    private Song? currentSong;
    
    // PWA Media Session state
    private List<MediaQueueService.QueueTrack> playbackQueue = new();
    private int currentQueueIndex = 0;
    private bool isPwaMode = false;
    private bool pwaMediaSessionInitialized = false;
    
    // PDF viewer state
    private bool isLoadingPdf = false;
    private string? currentPdfUrl;
    
    // URL cache for performance (session-based with size limit)
    private Dictionary<string, string> urlCache = new();
    private const int MaxCacheSize = 100; // Limit cache to 100 URLs per session
    
    // Video title detection constants
    private const int MaxCleanTitleLength = 50;
    private static readonly string[] VideoExtensions = { ".mp4", ".mov", ".avi", ".mkv", ".webm", ".flv" };
    
    // Media session constants
    private const int VideoElementRenderDelayMs = 100; // Delay to ensure video element is rendered before attaching MediaSession

    protected override async Task OnInitializedAsync()
    {
        album = await AlbumService.GetAlbumByIdAsync(AlbumId);
        
        // Check if album is private and user is not authenticated
        if (album != null && album.IsPrivate)
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            bool isAuthenticated = user.Identity?.IsAuthenticated ?? false;
            
            if (!isAuthenticated)
            {
                // Redirect to login page for private albums
                NavigationManager.NavigateTo($"/Identity/Account/Login?returnUrl={Uri.EscapeDataString($"/music/songs/{AlbumId}")}");
                return;
            }
        }
        
        await LoadSongs();
        
        // Check if user is Owner or Mod and get user info
        var authStateForOwner = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userForOwner = authStateForOwner.User;
        canManageSongs = userForOwner.IsInRole("Owner") || userForOwner.IsInRole("Mod");
        isAdmin = userForOwner.IsInRole("Admin") || userForOwner.IsInRole("Owner") || userForOwner.IsInRole("Mod");
        currentUserId = userForOwner.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        
        // Check if running in PWA mode
        try
        {
            isPwaMode = await MediaSession.IsPwaModeAsync();
