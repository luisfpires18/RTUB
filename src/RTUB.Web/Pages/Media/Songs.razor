            var userId = await GetCurrentUserId();
            await SongService.DeleteVideoAsync(video.Id, userId, isAdmin);
            
            // Clear selection if the deleted video was selected
            if (selectedVideoId == video.Id)
            {
                selectedVideoId = null;
            }
            
            // Reload videos for the modal
            songVideos = (await SongService.GetVideosBySongIdAsync(viewingVideosForSong.Id)).ToList();
            
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting video: {VideoId}", video.Id);
        }
    }
    
    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }
    
    /// <summary>
    /// Generate a clean display title for a video.
    /// If the title looks like a storage key (very long, contains .mp4, etc.), 
    /// generate a generic title based on song name and video index.
    /// </summary>
    private string GetCleanVideoTitle(SongVideo video, int videoNumber)
    {
        if (viewingVideosForSong == null) 
            return $"Vídeo {videoNumber}";
        
        // If no title exists, generate generic one
        if (string.IsNullOrWhiteSpace(video.Title))
        {
            return $"{viewingVideosForSong.Title} - Vídeo {videoNumber}";
        }
        
        // Check if title looks like a storage key (long, contains file extensions, or path separators)
        var title = video.Title.Trim();
        var looksLikeKey = title.Length > MaxCleanTitleLength || 
                          VideoExtensions.Any(ext => title.Contains(ext, StringComparison.OrdinalIgnoreCase)) ||
                          title.Contains("/") ||
                          title.Contains("\\");
        
        if (looksLikeKey)
        {
            return $"{viewingVideosForSong.Title} - Vídeo {videoNumber}";
        }
        
        // Title looks good, use as-is
        return title;
    }
    
    /// <summary>
    /// Check if the current user can delete a specific video.
    /// Returns true if user is the uploader OR an admin.
    /// </summary>
    private bool CanDeleteVideo(SongVideo video)
    {
        if (string.IsNullOrEmpty(currentUserId))
            return false;
            
        // User can delete if they are the uploader OR if they are admin
        return video.CreatedByUserId == currentUserId || isAdmin;
    }
