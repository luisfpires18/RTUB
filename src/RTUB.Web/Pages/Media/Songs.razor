    private async Task PlaySong(Song song)
    {
        try
        {
            // Get album information
            if (album == null)
            {
                Logger.LogWarning("Cannot play song - album information not available");
                return;
            }
            
            // Check cache first for performance
            string cacheKey = $"audio_{album.Title}_{song.TrackNumber}_{song.Title}";
            
            string? audioUrl = SongUrlCacheService.GetCachedUrl(cacheKey);
            
            if (audioUrl == null)
            {
                // Generate pre-signed URL for the audio file (lazy loading - only on play)
                audioUrl = await AudioStorageService.GetAudioUrlAsync(album.Title, song.TrackNumber, song.Title);
                
                // Cache the URL for session with size limit
                if (!string.IsNullOrEmpty(audioUrl))
                {
                    SongUrlCacheService.CacheUrl(cacheKey, audioUrl);
                }
            }
            
            if (!string.IsNullOrEmpty(audioUrl))
            {
                currentAudioUrl = audioUrl;
                currentSongTitle = song.Title;
                
                // Increment play count with cooldown check
                try
                {
                    // Check if enough time has passed since last play
                    bool shouldIncrement = true;
                    if (lastPlayTimes.TryGetValue(song.Id, out var lastPlayTime))
                    {
                        // Use song duration (in seconds) as cooldown, or default to 30 seconds if no duration
                        int cooldownSeconds = song.Duration ?? 30;
                        var timeSinceLastPlay = DateTime.UtcNow - lastPlayTime;
                        shouldIncrement = timeSinceLastPlay.TotalSeconds >= cooldownSeconds;
                    }
                    
                    if (shouldIncrement)
                    {
                        await SongService.IncrementPlayCountAsync(song.Id, currentUserId);
                        lastPlayTimes[song.Id] = DateTime.UtcNow;
                        
                        // Update the local count using TryGetValue pattern
                        songPlayCounts.TryGetValue(song.Id, out var currentCount);
                        songPlayCounts[song.Id] = currentCount + 1;
                        StateHasChanged(); // Trigger UI update to reflect new count
                        
                        // Log to audit log
                        await LogSongPlaybackAsync(song, album);
                    }
                }
                catch
                {
                    // Silently fail - play count is not critical
                }
                
                // Update media session metadata for lock screen / system media overlay
                try
                {
                    var albumCoverUrl = !string.IsNullOrEmpty(album.CoverImageSrc) 
                        ? GetAlbumImageUrl(album.CoverImageSrc) 
                        : string.Empty;
                    var rtubLogoUrl = "/icons/rtub-logo-512.png";
                    
                    await MediaSession.SetNowPlayingMetadataAsync(
                        song.Title,
                        album.Title,
                        albumCoverUrl,
                        rtubLogoUrl
                    );
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Failed to set media session metadata for song: {SongTitle}", song.Title);
                }
                
                StateHasChanged();
                
                // Wait for the audio element to render in the DOM before attempting playback
                // This ensures the audio element exists and is ready for JavaScript interop
                await Task.Delay(AudioElementRenderDelayMs);
                
                // Explicitly play the audio with proper loading and error handling
                try
                {
                    var playbackStarted = await AudioPlayer.PlayAudioAsync("rtub-audio-player");
                    if (!playbackStarted)
                    {
                        Logger.LogWarning("Audio playback failed to start for song: {SongTitle}", song.Title);
                    }
                }
                catch (Exception playEx)
                {
                    Logger.LogWarning(playEx, "Exception while starting audio playback for song: {SongTitle}", song.Title);
                }
                
                // Initialize PWA Media Session AFTER audio starts (non-blocking)
                if (isPwaMode && !pwaMediaSessionInitialized)
                {
                    _ = InitializePwaMediaSessionAsync(song);
                }
                else if (isPwaMode && pwaMediaSessionInitialized && songs != null)
                {
                    _ = BuildAndSetPwaQueue(song);
                }
            }
            else
            {
                // File not found or error
                Logger.LogWarning("Audio file not found for song: {SongTitle} in album: {AlbumTitle}", 
                    song.Title, album.Title);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error playing song: {SongTitle} in album: {AlbumTitle}", 
                song.Title, album?.Title ?? "Unknown");
        }
    }
    
    private async Task StopAudio()
    {
        // Stop audio playback using the AudioPlayerInterop for proper cleanup
        try
        {
            await AudioPlayer.StopAudioAsync("rtub-audio-player");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to stop audio playback");
        }
        
        currentAudioUrl = null;
        currentSongTitle = null;
        
        // Clear media session metadata when playback stops
        try
        {
            await MediaSession.ClearMetadataAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to clear media session metadata");
        }
        
        StateHasChanged();
    }
    
