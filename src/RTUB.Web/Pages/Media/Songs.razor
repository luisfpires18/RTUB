            // Reload videos for the modal
            songVideos = (await SongService.GetVideosBySongIdAsync(viewingVideosForSong.Id)).ToList();
            
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting video: {VideoId}", video.Id);
        }
    }
    
    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }
    
    /// <summary>
    /// Generate a clean display title for a video.
    /// If the title looks like a storage key (very long, contains .mp4, etc.), 
    /// generate a generic title based on song name and video index.
    /// </summary>
    private string GetCleanVideoTitle(SongVideo video, int videoNumber)
    {
        if (viewingVideosForSong == null) 
            return $"Vídeo {videoNumber}";
        
        return SongContentService.GetCleanVideoTitle(video, viewingVideosForSong, videoNumber);
    }
    
    /// <summary>
    /// Check if the current user can delete a specific video.
    /// Returns true if user is the uploader OR an admin.
    /// </summary>
    private bool CanDeleteVideo(SongVideo video)
    {
        if (string.IsNullOrEmpty(currentUserId))
            return false;
            
        // User can delete if they are the uploader OR if they are admin
        return video.CreatedByUserId == currentUserId || canDeleteSongs;
    }
    
    // PWA Media Session helper methods
    private async Task InitializePwaMediaSessionAsync(Song song)
    {
        try
        {
            // Give the audio element time to render in the DOM
            await Task.Delay(150);
            
            var initialized = await MediaSession.InitPwaMediaSessionAsync("rtub-audio-player");
            
            if (initialized)
            {
                pwaMediaSessionInitialized = true;
                
                // Build and set queue BEFORE binding handlers
                // iOS needs to know the queue exists to show next/prev buttons
                if (songs != null)
                {
                    await BuildAndSetPwaQueue(song);
                }
                
                // Bind handlers after queue is set
                await JSRuntime.InvokeVoidAsync("pwaMediaSession.bindHandlers");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to initialize PWA Media Session");
        }
    }
    
    private async Task BuildAndSetPwaQueue(Song selectedSong)
    {
        try
        {
            if (songs == null || album == null) return;
            
            // Build queue with all album songs, ordered by track number
            playbackQueue = MediaQueueService.BuildQueue(songs, album.Title);
            
            // Find index of selected song
            currentQueueIndex = MediaQueueService.FindSongIndex(playbackQueue, selectedSong.Id);
            
            if (currentQueueIndex == -1)
            {
                Logger.LogWarning("Selected song not found in queue");
                return;
            }
            
            // Pre-load audio URLs for all tracks in queue
            var queueWithUrls = new List<object>();
            foreach (var track in playbackQueue)
            {
                // Get or generate audio URL for each track
                string cacheKey = $"audio_{album.Title}_{track.TrackNumber}_{track.Title}";
                string? audioUrl = SongUrlCacheService.GetCachedUrl(cacheKey);
                
                if (audioUrl == null)
                {
                    audioUrl = await AudioStorageService.GetAudioUrlAsync(album.Title, track.TrackNumber, track.Title);
                    if (!string.IsNullOrEmpty(audioUrl))
                    {
                        SongUrlCacheService.CacheUrl(cacheKey, audioUrl);
                    }
                }
                
                var albumCoverUrl = !string.IsNullOrEmpty(album.CoverImageSrc) 
                    ? GetAlbumImageUrl(album.CoverImageSrc) 
                    : "/icons/rtub-logo-512.png";
                
                queueWithUrls.Add(new
                {
                    id = track.Id,
                    title = track.Title,
                    artist = track.Artist,
                    album = track.Album,
                    audioUrl = audioUrl ?? string.Empty,
                    artworkUrl = albumCoverUrl
                });
            }
            
            // Send queue to PWA Media Session (only if initialized)
            if (pwaMediaSessionInitialized)
            {
                await MediaSession.SetQueueAsync(queueWithUrls, currentQueueIndex);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to build PWA queue");
        }
    }
    
    private async Task SetPwaTrackMetadata(Song song, string artworkUrl)
    {
        try
        {
            if (album == null) return;
            
            var metadata = new
            {
                title = song.Title,
                artist = string.Empty,
                album = album.Title,
                artworkUrl = !string.IsNullOrEmpty(artworkUrl) ? artworkUrl : "/icons/rtub-logo-512.png"
            };
            
            await MediaSession.SetNowPlayingMetadataForPwaAsync(metadata);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to set PWA track metadata");
        }
    }
