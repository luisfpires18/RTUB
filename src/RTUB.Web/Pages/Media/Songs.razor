    private async Task SelectVideoByIndex(int videoId)
    {
        // Toggle: if clicking the same video, collapse it
        if (selectedVideoId == videoId)
        {
            selectedVideoId = null;
            // Clear media session when video is collapsed
            try
            {
                await MediaSession.ClearMetadataAsync();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to clear media session metadata");
            }
        }
        else
        {
            selectedVideoId = videoId;
            
            // Set media session metadata when video is selected
            if (viewingVideosForSong != null && songVideos != null)
            {
                var selectedVideo = songVideos.FirstOrDefault(v => v.Id == videoId);
                if (selectedVideo != null)
                {
                    try
                    {
                        var videoTitle = GetCleanVideoTitle(selectedVideo, songVideos.IndexOf(selectedVideo) + 1);
                        var albumCoverUrl = !string.IsNullOrEmpty(album?.CoverImageSrc) 
                            ? GetAlbumImageUrl(album.CoverImageSrc) 
                            : string.Empty;
                        
                        // Use a small delay to ensure video element is rendered before attaching
                        await Task.Delay(VideoElementRenderDelayMs);
                        await MediaSession.AttachToVideoAsync(
                            ".modal-video",
                            videoTitle,
                            viewingVideosForSong.Title,
                            albumCoverUrl
                        );
                    }
                    catch (Exception ex)
                    {
                        Logger.LogWarning(ex, "Failed to set video media session metadata");
                    }
                }
            }
        }
    }
    
    private void HandleVideoSelection(InputFileChangeEventArgs e)
    {
        if (viewingVideosForSong == null) return;
        
        var file = e.File;
        var maxFileSize = 100 * 1024 * 1024; // 100MB
        
        if (file.Size > maxFileSize)
        {
            Logger.LogWarning("Video file size exceeds maximum allowed size of 100MB");
            selectedVideoName = null;
            selectedVideoFile = null;
            return;
        }
        
        // Store file and show selected file name
        selectedVideoFile = file;
        selectedVideoName = file.Name;
        
        // Generate generic title based on song name and existing video count
        var existingCount = songVideos?.Count ?? 0;
        var videoNumber = existingCount + 1;
        videoTitle = $"{viewingVideosForSong.Title} - Vídeo {videoNumber}";
        
        StateHasChanged();
    }
    
    private void CancelVideoSelection()
    {
        selectedVideoFile = null;
        selectedVideoName = null;
        videoTitle = string.Empty;
        videoUploadKey = Guid.NewGuid();
    }
    
    private async Task UploadVideo()
    {
        if (viewingVideosForSong == null || selectedVideoFile == null) return;
        
        var maxFileSize = 100 * 1024 * 1024; // 100MB
        isUploadingVideo = true;
        StateHasChanged();
        
        try
        {
            // Read file immediately into MemoryStream BEFORE any state changes
            // This prevents JSException when Blazor re-renders
            using var browserStream = selectedVideoFile.OpenReadStream(maxFileSize);
            using var memoryStream = new MemoryStream();
            await browserStream.CopyToAsync(memoryStream);
            memoryStream.Position = 0;
            
            var currentUserId = await GetCurrentUserId();
            
            await SongService.AddVideoAsync(
                viewingVideosForSong.Id,
                memoryStream,
                selectedVideoFile.Name,
                selectedVideoFile.ContentType,
                currentUserId,
                videoTitle // Use the user-provided title
            );
            
            // Reload videos for the modal
            songVideos = (await SongService.GetVideosBySongIdAsync(viewingVideosForSong.Id)).ToList();
            
            // Don't auto-select video after upload - keep all collapsed
            selectedVideoId = null;
            
            // Clear selection and force InputFile to recreate for next upload
            CancelVideoSelection();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error uploading video for song: {SongId}", viewingVideosForSong.Id);
        }
        finally
        {
            isUploadingVideo = false;
            StateHasChanged();
        }
    }
    
