@page "/music/songs/{AlbumId:int}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Logging
@using RTUB.Application.Interfaces
@using RTUB.Core.Entities
@using RTUB.Shared
@using RTUB.Shared.Base
@using RTUB.Web.Services
@inject IAlbumService AlbumService
@inject ISongService SongService
@inject ISongContentService SongContentService
@inject ISongUrlCacheService SongUrlCacheService
@inject ISongPlayService SongPlayService
@inject ISongValidationService SongValidationService
@inject IAudioStorageService AudioStorageService
@inject ILyricStorageService LyricStorageService
@inject ILogger<Songs> Logger
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject RTUB.Web.Interop.MediaSessionInterop MediaSession
@inject RTUB.Web.Interop.AudioPlayerInterop AudioPlayer
@inject RTUB.Web.Services.MediaQueueService MediaQueueService
@inject IJSRuntime JSRuntime
@inject IAuditLogService AuditLogService

@if (album == null)
{
    <p>A carregar...</p>
}
else
{
    <div class="page-header-centered">
        <div class="page-header-left d-none d-xl-flex">
            <button class="btn btn-outline-light btn-sm" @onclick="GoBack" aria-label="Voltar">
                <i class="bi bi-arrow-left"></i>
            </button>
        </div>
        <div class="page-header-center">
            <h1 class="music-text-light album-detail-title">@album.Title</h1>
            @if (!string.IsNullOrEmpty(album.CoverImageSrc))
            {
                <img src="@GetAlbumImageUrl(album.CoverImageSrc)" class="img-fluid rounded shadow music-album-image" alt="@album.Title" >
            }
            else
            {
                <div class="album-cover-small mx-auto">
                    <i class="bi bi-disc music-icon-medium"></i>
                </div>
            }
            <p class="lead music-text-secondary album-detail-year">@album.Year</p>
            @if (!string.IsNullOrEmpty(album.Description))
            {
                <p class="music-text-secondary">@album.Description</p>
            }
        </div>
        <div class="page-header-right d-none d-xl-flex">
            <AuthorizeView Roles="Admin,Mod">
                <Authorized>
                    <button class="btn btn-success" @onclick="OpenCreateSongModal" title="Criar Nova Música" aria-label="Criar Nova Música">
                        <i class="bi bi-plus-lg"></i> Adicionar Música
                    </button>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>

    <h3 class="mb-3"><i class="bi bi-music-note-beamed"></i> Faixas</h3>

    <div class="mb-3">
        <SearchBar @bind-Value="searchTerm"
                   Placeholder="Pesquisar por título, autor da letra ou autor da música..." />
    </div>

    @if (songs == null)
    {
        <div class="song-grid">
            @for (int i = 0; i < 6; i++)
            {
                <SongCardSkeleton />
            }
        </div>
    }
    else if (!songs.Any())
    {
        <EmptyState Title="Nenhuma música neste álbum"
                        Icon="bi-music-note-list"
                        Message="Adicione músicas para começar." />
    }
    else
    {
        <div class="song-grid">
            @foreach (var song in filteredSongs.OrderBy(s => s.TrackNumber))
            {
                <SongCard @key="song.Id"
                         Song="@song"
                         PlayCount="@(songPlayCounts.ContainsKey(song.Id) ? songPlayCounts[song.Id] : 0)"
                         LinkCount="@(songLinkCounts.ContainsKey(song.Id) ? songLinkCounts[song.Id] : 0)"
                         VideoCount="@(songVideoCounts.ContainsKey(song.Id) ? songVideoCounts[song.Id] : 0)"
                         CanEdit="@canEditSongs"
                         CanDelete="@canDeleteSongs"
                         OnPlay="@(() => PlaySong(song))"
                         OnViewLyric="@(() => OpenViewLyricsModal(song))"
                         OnViewLinks="@(() => OpenLinksModal(song))"
                         OnViewVideos="@(() => OpenVideosModal(song))"
                         OnEdit="@(() => OpenEditModal(song))"
                         OnDelete="@(() => OpenDeleteSongModal(song))" />
            }
        </div>
    }
}

<!-- Mobile Bottom Nav -->
<MobileBottomNav Items="@mobileNavItems" ActiveKey="" OnSelect="HandleMobileNavSelect" />

<!-- Fixed Audio Player -->
@if (!string.IsNullOrEmpty(currentAudioUrl))
{
    <div class="fixed-audio-player">
        <div class="audio-player-content">
            <div class="audio-info">
                <i class="bi bi-music-note-beamed me-2"></i>
                <span class="audio-title">@currentSongTitle</span>
            </div>
            <audio id="rtub-audio-player" src="@currentAudioUrl" controls class="audio-element">
                Seu navegador não suporta o elemento de áudio.
            </audio>
            <button class="btn btn-sm btn-outline-light" @onclick="StopAudio" title="Fechar" aria-label="Fechar player de áudio">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    </div>
}

<!-- View Lyrics Modal -->
<Modal Show="@modals.IsOpen(ModalType.ViewLyrics)" 
       ShowChanged="@((value) => modals.Toggle(ModalType.ViewLyrics, value))"
       Title="@($"Letra - {viewingSong?.Title}")" 
       Size="Modal.ModalSize.Large" 
       Centered="true"
       OnClose="@CloseViewLyricsModal">
    <BodyContent>
        <div class="lyrics-display">
            @viewingSong?.Lyrics
        </div>
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="CloseViewLyricsModal">Voltar Atrás</button>
    </FooterContent>
</Modal>

<!-- View Lyrics PDF Modal -->
<Modal Show="@modals.IsOpen(ModalType.ViewLyricsPdf)" 
       ShowChanged="@((value) => modals.Toggle(ModalType.ViewLyricsPdf, value))"
       Title="@($"Letra - {viewingSong?.Title}")" 
       Size="Modal.ModalSize.ExtraLarge" 
       Centered="true"
       OnClose="@CloseViewLyricsPdfModal">
    <BodyContent>
        @if (isLoadingPdf)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">A carregar...</span>
                </div>
                <p class="mt-3">A carregar PDF...</p>
            </div>
        }
        else if (!string.IsNullOrEmpty(currentPdfUrl))
        {
            <div class="pdf-viewer-container">
                @* Enable PDF toolbar on mobile for zoom controls, hide on desktop for cleaner UX *@
                <iframe src="@GetPdfViewerUrl(currentPdfUrl)" 
                        class="pdf-viewer-iframe"
                        allow="fullscreen"
                        title="@($"Letra - {viewingSong?.Title}")">
                </iframe>
            </div>
        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="CloseViewLyricsPdfModal">Voltar Atrás</button>
    </FooterContent>
</Modal>


<!-- Links Modal -->
<Modal Show="@modals.IsOpen(ModalType.Links)" 
       ShowChanged="@((value) => modals.Toggle(ModalType.Links, value))"
       Title="@($"Links - {viewingSong?.Title}")" 
       Centered="true"
       OnClose="@CloseLinksModal">
    <BodyContent>
        <div class="d-grid gap-3">
            @if (viewingSong != null)
            {
                @if (!string.IsNullOrEmpty(viewingSong.SpotifyUrl))
                {
                    <a href="@viewingSong.SpotifyUrl" target="_blank" class="btn btn-success d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-spotify music-icon-social"></i>
                        <span>Abrir no Spotify</span>
                    </a>
                }
                @if (viewingSong.YouTubeUrls != null && viewingSong.YouTubeUrls.Any())
                {
                    foreach (var youtubeUrl in viewingSong.YouTubeUrls)
                    {
                        <a href="@youtubeUrl.Url" target="_blank" class="btn btn-danger d-flex align-items-center justify-content-center gap-2">
                            <i class="bi bi-youtube music-icon-social"></i>
                            <span>Abrir no YouTube</span>
                        </a>
                    }
                }
                @if (string.IsNullOrEmpty(viewingSong.SpotifyUrl) && (viewingSong.YouTubeUrls == null || !viewingSong.YouTubeUrls.Any()))
                {
                    <EmptyState Title="Nenhum link disponível para esta música"
                                    Icon="bi-link-45deg" />
                }
            }
        </div>
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="CloseLinksModal">Voltar Atrás</button>
    </FooterContent>
</Modal>

<!-- Create Song Modal -->
<Modal Show="@modals.IsOpen(ModalType.Create)" 
       ShowChanged="@((value) => modals.Toggle(ModalType.Create, value))"
       Title="Criar Nova Música" 
       Size="Modal.ModalSize.Large" 
       Centered="true"
       ShowCloseButton="false">
    <BodyContent>
        <EditForm Model="editingSong" OnValidSubmit="CreateSong" id="createSongForm">
            <DataAnnotationsValidator />
            <ErrorDisplay />

            <div class="row">
                <div class="col-md-8 mb-3">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-music-note text-primary me-2"></i>Título <span class="text-danger">*</span>
                    </label>
                    <InputText class="form-control" @bind-Value="editingSong!.Title" placeholder="Inserir título da música..." />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-hash text-primary me-2"></i>Número da Faixa
                    </label>
                    <InputNumber class="form-control" @bind-Value="editingSong!.TrackNumber" placeholder="Ex: 1" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-pen text-primary me-2"></i>Autor (Letra)
                    </label>
                    <InputText class="form-control" @bind-Value="editingSong!.LyricAuthor" placeholder="Inserir autor da letra..." />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-music-note-beamed text-primary me-2"></i>Autor (Música)
                    </label>
                    <InputText class="form-control" @bind-Value="editingSong!.MusicAuthor" placeholder="Inserir autor da música..." />
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <i class="bi bi-arrow-repeat text-primary me-2"></i>Adaptação
                </label>
                <InputText class="form-control" @bind-Value="editingSong!.Adaptation" placeholder="Inserir adaptação..." />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <i class="bi bi-spotify text-primary me-2"></i>Spotify URL
                </label>
                <InputText class="form-control" @bind-Value="editingSong!.SpotifyUrl" placeholder="Inserir URL do Spotify..." />
            </div>

            <div class="mb-3">
                <div class="rtub-checkbox-wrapper">
                    <div class="form-check">
                        <InputCheckbox class="form-check-input rtub-checkbox-large" id="createHasMusic" @bind-Value="editingSong!.HasMusic" />
                        <label class="form-check-label" for="createHasMusic">
                            <i class="bi bi-file-music text-primary me-2"></i>Tem ficheiro de música disponível
                        </label>
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <i class="bi bi-youtube text-primary me-2"></i>YouTube URLs
                </label>
                @if (editingYouTubeUrls != null)
                {
                    @for (int i = 0; i < editingYouTubeUrls.Count; i++)
                    {
                        var index = i;
                        <div class="input-group mb-2">
                            <input type="text" class="form-control" @bind="editingYouTubeUrls[index]" placeholder="Inserir URL do YouTube..." />
                            <button type="button" class="btn btn-danger" @onclick="() => RemoveYouTubeUrl(index)">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    }
                }
                <button type="button" class="btn btn-secondary btn-sm" @onclick="AddYouTubeUrl">
                    <i class="bi bi-plus-circle"></i> Adicionar YouTube URL
                </button>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <i class="bi bi-file-text text-primary me-2"></i>Letra
                </label>
                <InputTextArea class="form-control" rows="15" @bind-Value="editingSong!.Lyrics" placeholder="Adicionar letra apenas se a música não estiver no cancioneiro..." />
            </div>

        </EditForm>
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="CloseCreateModal">Cancelar</button>
        <button type="submit" form="createSongForm" class="btn btn-success">Criar</button>
    </FooterContent>
</Modal>

<!-- Edit Song Modal -->
