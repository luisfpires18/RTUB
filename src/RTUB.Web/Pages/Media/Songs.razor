    private async Task UploadVideo()
    {
        if (viewingVideosForSong == null || selectedVideoFile == null) return;
        
        var maxFileSize = 100 * 1024 * 1024; // 100MB
        isUploadingVideo = true;
        StateHasChanged();
        
        try
        {
            // Read file immediately into MemoryStream BEFORE any state changes
            // This prevents JSException when Blazor re-renders
            using var browserStream = selectedVideoFile.OpenReadStream(maxFileSize);
            using var memoryStream = new MemoryStream();
            await browserStream.CopyToAsync(memoryStream);
            memoryStream.Position = 0;
            
            var currentUserId = await GetCurrentUserId();
            
            await SongService.AddVideoAsync(
                viewingVideosForSong.Id,
                memoryStream,
                selectedVideoFile.Name,
                selectedVideoFile.ContentType,
                currentUserId,
                videoTitle // Use the user-provided title
            );
            
            // Reload videos for the modal
            songVideos = (await SongService.GetVideosBySongIdAsync(viewingVideosForSong.Id)).ToList();
            
            // Don't auto-select video after upload - keep all collapsed
            selectedVideoId = null;
            
            // Clear selection and force InputFile to recreate for next upload
            CancelVideoSelection();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error uploading video for song: {SongId}", viewingVideosForSong.Id);
        }
        finally
        {
            isUploadingVideo = false;
            StateHasChanged();
        }
    }
    
