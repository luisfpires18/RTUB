            var userName = await GetCurrentUserName();
            var displayName = $"{song.Title} ({album.Title})";

            await AuditLogService.AddAsync(new AuditLog
            {
                EntityType = "Song",
                EntityId = song.Id,
                Action = "Played",
                UserId = string.IsNullOrEmpty(userId) ? null : userId,
                UserName = userName,
                Timestamp = DateTime.UtcNow,
                Changes = $"Played \"{song.Title}\" from album \"{album.Title}\".",
                EntityDisplayName = displayName,
                IsCriticalAction = false
            });
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to add audit log for song playback: {SongTitle}", song.Title);
        }
    }

