    private async Task PlaySong(Song song)
    {
        try
        {
            // Get album information
            if (album == null)
            {
                Logger.LogWarning("Cannot play song - album information not available");
                return;
            }
            
            // Store current song
            currentSong = song;
            
            // Check cache first for performance
            string cacheKey = $"audio_{album.Title}_{song.TrackNumber}_{song.Title}";
            
            string? audioUrl = null;
            if (urlCache.TryGetValue(cacheKey, out var cachedUrl))
            {
                audioUrl = cachedUrl;
            }
            else
            {
                // Generate pre-signed URL for the audio file (lazy loading - only on play)
                audioUrl = await AudioStorageService.GetAudioUrlAsync(album.Title, song.TrackNumber, song.Title);
                
                // Cache the URL for session with size limit
                if (!string.IsNullOrEmpty(audioUrl))
                {
                    // If cache is at limit, remove oldest entry (first key)
                    if (urlCache.Count >= MaxCacheSize)
                    {
                        var firstKey = urlCache.Keys.First();
                        urlCache.Remove(firstKey);
                    }
                    urlCache[cacheKey] = audioUrl;
                }
            }
            
            if (!string.IsNullOrEmpty(audioUrl))
            {
                currentAudioUrl = audioUrl;
                currentSongTitle = song.Title;
                
                // Update media session metadata for lock screen / system media overlay
                try
                {
                    var albumCoverUrl = !string.IsNullOrEmpty(album.CoverImageSrc) 
                        ? GetAlbumImageUrl(album.CoverImageSrc) 
                        : string.Empty;
                    var rtubLogoUrl = "/icons/rtub-logo-512.png";
                    
                    await MediaSession.SetNowPlayingMetadataAsync(
                        song.Title,
                        album.Title,
                        albumCoverUrl,
                        rtubLogoUrl
                    );
                    
                    // Set PWA-specific metadata if in PWA mode
                    if (isPwaMode && pwaMediaSessionInitialized)
                    {
                        await SetPwaTrackMetadata(song, albumCoverUrl);
                    }
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Failed to set media session metadata for song: {SongTitle}", song.Title);
                }
                
                StateHasChanged();
                
                // Initialize PWA Media Session AFTER audio starts (non-blocking background task)
                if (isPwaMode && !pwaMediaSessionInitialized)
                {
                    // Fire and forget - run initialization in background
                    _ = InitializePwaMediaSessionAsync(song);
                }
                else if (isPwaMode && pwaMediaSessionInitialized && songs != null)
                {
                    // Queue already initialized, just update it (background)
                    _ = BuildAndSetPwaQueue(song);
                }
            }
            else
            {
                // File not found or error
                Logger.LogWarning("Audio file not found for song: {SongTitle} in album: {AlbumTitle}", 
                    song.Title, album.Title);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error playing song: {SongTitle} in album: {AlbumTitle}", 
                song.Title, album?.Title ?? "Unknown");
        }
    }
    
    private async Task InitializePwaMediaSessionAsync(Song song)
    {
        try
        {
            // Give the audio element time to render in the DOM
            await Task.Delay(150);
            
            var initialized = await MediaSession.InitPwaMediaSessionAsync("rtub-audio-player");
            
            if (initialized)
            {
                pwaMediaSessionInitialized = true;
                // Bind handlers after successful initialization
                await JSRuntime.InvokeVoidAsync("pwaMediaSession.bindHandlers");
                Logger.LogInformation("PWA Media Session initialized and handlers bound");
                
                // Build and set queue after initialization (in background)
                if (songs != null)
                {
                    await BuildAndSetPwaQueue(song);
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to initialize PWA Media Session");
        }
    }
    
    private async Task BuildAndSetPwaQueue(Song selectedSong)
    {
        try
        {
            if (songs == null || album == null) return;
            
            // Build queue with all album songs, ordered by track number
            playbackQueue = MediaQueueService.BuildQueue(songs, album.Title);
            
            // Find index of selected song
            currentQueueIndex = MediaQueueService.FindSongIndex(playbackQueue, selectedSong.Id);
            
            if (currentQueueIndex == -1)
            {
                Logger.LogWarning("Selected song not found in queue");
                return;
            }
            
            // Pre-load audio URLs for all tracks in queue
            var queueWithUrls = new List<object>();
            foreach (var track in playbackQueue)
            {
                // Get or generate audio URL for each track
                string cacheKey = $"audio_{album.Title}_{track.TrackNumber}_{track.Title}";
                string? audioUrl = null;
                
                if (urlCache.TryGetValue(cacheKey, out var cachedUrl))
                {
                    audioUrl = cachedUrl;
                }
                else
                {
                    audioUrl = await AudioStorageService.GetAudioUrlAsync(album.Title, track.TrackNumber, track.Title);
                    if (!string.IsNullOrEmpty(audioUrl) && urlCache.Count < MaxCacheSize)
                    {
                        urlCache[cacheKey] = audioUrl;
                    }
                }
                
                var albumCoverUrl = !string.IsNullOrEmpty(album.CoverImageSrc) 
                    ? GetAlbumImageUrl(album.CoverImageSrc) 
                    : "/icons/rtub-logo-512.png";
                
                queueWithUrls.Add(new
                {
                    id = track.Id,
                    title = track.Title,
                    artist = track.Artist,
                    album = track.Album,
                    audioUrl = audioUrl ?? string.Empty,
                    artworkUrl = albumCoverUrl
                });
            }
            
            // Send queue to PWA Media Session (only if initialized)
            if (pwaMediaSessionInitialized)
            {
                await MediaSession.SetQueueAsync(queueWithUrls, currentQueueIndex);
                
                Logger.LogInformation("PWA queue built with {Count} tracks, starting at index {Index}", 
                    playbackQueue.Count, currentQueueIndex);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to build PWA queue");
        }
    }
    
    private async Task SetPwaTrackMetadata(Song song, string artworkUrl)
    {
        try
        {
            if (album == null) return;
            
            var metadata = new
            {
                title = song.Title,
