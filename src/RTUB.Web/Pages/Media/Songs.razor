    protected override async Task OnInitializedAsync()
    {
        album = await AlbumService.GetAlbumByIdAsync(AlbumId);
        
        // Check if album is private and user is not authenticated
        if (album != null && album.IsPrivate)
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            bool isAuthenticated = user.Identity?.IsAuthenticated ?? false;
            
            if (!isAuthenticated)
            {
                // Redirect to login page for private albums
                NavigationManager.NavigateTo($"/Identity/Account/Login?returnUrl={Uri.EscapeDataString($"/music/songs/{AlbumId}")}");
                return;
            }
        }
        
        await LoadSongs();
        
        // Check if user is Admin, Owner, or Mod and get user info
        var authStateForOwner = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userForOwner = authStateForOwner.User;
        isAdminOrOwner = userForOwner.IsInRole("Admin") || userForOwner.IsInRole("Owner");
        isModerator = userForOwner.IsInRole("Mod");
        canEditSongs = isAdminOrOwner || isModerator;
        canDeleteSongs = isAdminOrOwner;
        currentUserId = userForOwner.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        BuildMobileNavItems();
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Check if running in PWA mode (must be done after render for JS interop)
            try
            {
                isPwaMode = await MediaSession.IsPwaModeAsync();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to check PWA mode");
            }
        }
        
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task LoadSongs()
    {
        songs = (await SongService.GetSongsByAlbumIdAsync(AlbumId))
            .OrderBy(s => s.TrackNumber)
            .ToList();
        
        // Load play counts, video counts, and link counts for all songs
        if (songs.Any())
        {
            var songIds = songs.Select(s => s.Id).ToList();
            songPlayCounts = await SongService.GetPlayCountsForSongsAsync(songIds);
            
            // Load video counts in parallel for better performance
            var videoCountTasks = songs.Select(async song =>
            {
                var videos = await SongService.GetVideosBySongIdAsync(song.Id);
                return (SongId: song.Id, Count: videos.Count());
            });
            
            var videoCountResults = await Task.WhenAll(videoCountTasks);
            foreach (var result in videoCountResults)
            {
                songVideoCounts[result.SongId] = result.Count;
            }
            
            // Calculate link counts (synchronous - no DB calls needed)
            foreach (var song in songs)
            {
                var linkCount = 0;
                if (!string.IsNullOrEmpty(song.SpotifyUrl)) linkCount++;
                linkCount += song.YouTubeUrls?.Count ?? 0;
                songLinkCounts[song.Id] = linkCount;
            }
        }
    }

