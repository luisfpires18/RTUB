@page "/documentation"
@rendermode InteractiveServer
@using RTUB.Application.DTOs
@using RTUB.Application.Interfaces
@using RTUB.Application.Services
@using RTUB.Application.Extensions
@using RTUB.Application.Helpers
@using RTUB.Core.Entities
@using RTUB.Core.Enums
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Hosting
@using RTUB.Shared.Base
@attribute [Authorize]
@inject IDocumentStorageService DocumentStorageService
@inject IFiscalYearService FiscalYearService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavigationManager
@inject IHostEnvironment HostEnvironment
@inject IJSRuntime JSRuntime
@inject AuditContext AuditContext

<div class="d-flex flex-column gap-3 mb-4">
    <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
        <div>
            <h1 class="mb-2"><i class="bi bi-file-earmark-text"></i> Documentação</h1>
            <p class="lead page-header-subtitle mb-0 text-light-theme">Documentos e recursos importantes da RTUB organizados por categoria.</p>
        </div>

        @if (canDoAction)
        {
            <div class="page-header-actions justify-content-lg-end">
                <button class="btn btn-success" @onclick="OpenCreateFolderModal" title="Criar Nova Pasta">
                    <i class="bi bi-folder-plus"></i>
                    <span class="ms-1">Criar Pasta</span>
                </button>
            </div>
        }
    </div>

    <!-- Filter Controls -->
    <div class="d-flex flex-column flex-lg-row align-items-lg-end gap-2 flex-wrap">
        <div class="flex-lg-shrink-0 ms-lg-auto filter-dropdown-container">
            <FilterDropdown SelectedValue="@selectedFiscalYear"
                            SelectedValueChanged="@(value => selectedFiscalYear = value)"
                            OnChange="@OnFiscalYearChanged"
                            AllItemsLabel="Todos os anos"
                            Options="@fiscalYearOptions" />
        </div>
    </div>
</div>

@if (isLoading)
{
    <LoadingSpinner Message="A carregar documentação..." />
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <ErrorDisplay Title="Erro ao carregar documentação" Errors="@(new[] { errorMessage })" />
}
else if (!folders.Any())
{
    <EmptyState Title="Nenhuma pasta encontrada"
                Message="Ainda não existem pastas de documentação. Pode criar uma pasta usando o botão acima."
                Icon="bi-folder-x" />
}
else
{
    @* Calculate paginated folders *@
    var skip = (currentFolderPage - 1) * folderPageSize;
    var paginatedFolders = folders.Skip(skip).Take(folderPageSize).ToList();
    
    @foreach (var folder in paginatedFolders)
    {
        var folderPath = $"docs/{HostEnvironment.EnvironmentName}/{selectedFiscalYear}/{folder}";
        var allDocuments = folderDocuments.ContainsKey(folder) ? folderDocuments[folder] : new List<DocumentMetadata>();
        var isFirstFolder = paginatedFolders.IndexOf(folder) == 0;
        
        // Get pagination state for this folder
        var paginationState = GetOrCreatePaginationState(folder);
        
        // Calculate paginated documents
        var docSkip = (paginationState.CurrentPage - 1) * paginationState.PageSize;
        var documents = allDocuments.Skip(docSkip).Take(paginationState.PageSize).ToList();
        
        // Extract display name for the folder (for Logistics, show just the board name)
        var displayFolderName = folder.StartsWith("Logistics/", StringComparison.OrdinalIgnoreCase) 
            ? folder.Substring("Logistics/".Length) 
            : folder;
        
        <FolderCard @key="folder"
                   FolderName="@displayFolderName"
                   FolderPath="@folderPath"
                   Documents="@documents"
                   DefaultExpanded="@isFirstFolder"
                   IsAdmin="@canDoAction"
                   OnUpload="@HandleUploadRequest"
                   OnDocumentDownload="@HandleDocumentDownload"
                   OnDocumentDelete="@HandleDocumentDeleteRequest"
                   OnFolderDelete="@HandleFolderDeleteRequest" />
        
        @* Pagination for this folder *@
        @if (allDocuments.Count > 0)
        {
            <div class="mb-4">
                <TablePagination CurrentPage="@paginationState.CurrentPage"
                                PageSize="@paginationState.PageSize"
                                TotalItems="@allDocuments.Count"
                                ItemLabel="documentos"
                                PageSizeOptions="@(new[] { 3, 6, 9, 12, 15 })"
                                OnPageChanged="@(page => HandlePageChanged(folder, page))"
                                OnPageSizeChanged="@(size => HandlePageSizeChanged(folder, size))" />
            </div>
        }
    }
    
    @* Pagination for folders *@
    @if (folders.Count > 0)
    {
        <div class="mb-4">
            <TablePagination CurrentPage="@currentFolderPage"
                            PageSize="@folderPageSize"
                            TotalItems="@folders.Count"
                            ItemLabel="pastas"
                            PageSizeOptions="@(new[] { 3, 6, 9, 12, 15 })"
                            OnPageChanged="@HandleFolderPageChanged"
                            OnPageSizeChanged="@HandleFolderPageSizeChanged" />
        </div>
    }
}

@* Create Folder Modal *@
<Modal Show="@modals.IsOpen(ModalType.CreateFolder)" 
       ShowChanged="@((bool show) => modals.Toggle(ModalType.CreateFolder, show))"
       Title="Criar Nova Pasta"
       Size="Modal.ModalSize.Default"
       Centered="true">
    <BodyContent>
        @if (!string.IsNullOrEmpty(createFolderError))
        {
            <div class="alert alert-danger">@createFolderError</div>
        }
        <div class="mb-3">
            <label class="form-label fw-semibold">
                <i class="bi bi-folder text-primary me-2"></i>Nome da Pasta
            </label>
            <input type="text" 
                   class="form-control" 
                   placeholder="Ex: Regulamentos, Atas, etc."
                   @bind="newFolderName"
                   @bind:event="oninput"
                   maxlength="50" />
            <div class="form-text">Apenas letras, números, espaços e hífens são permitidos.</div>
        </div>
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="CloseCreateFolderModal">Cancelar</button>
        <button type="button" 
                class="btn btn-primary" 
                @onclick="CreateFolder" 
                disabled="@string.IsNullOrWhiteSpace(newFolderName)">
            Criar
        </button>
    </FooterContent>
</Modal>

@* Upload Document Modal *@
<Modal Show="@modals.IsOpen(ModalType.Upload)" 
       ShowChanged="@((bool show) => modals.Toggle(ModalType.Upload, show))"
       Title="@($"Carregar Documento - {selectedFolderName}")"
       Size="Modal.ModalSize.Default"
       Centered="true">
    <BodyContent>
        @if (!string.IsNullOrEmpty(uploadError))
        {
            <div class="alert alert-danger">@uploadError</div>
        }
        @if (!string.IsNullOrEmpty(uploadSuccess))
        {
            <div class="alert alert-success">@uploadSuccess</div>
        }
        <div class="mb-3">
            <label class="form-label fw-semibold">
                <i class="bi bi-file-earmark-arrow-up text-primary me-2"></i>Selecionar Ficheiro
            </label>
            <div class="localized-file-picker">
                <InputFile id="@documentationFileInputId"
                           class="d-none"
                           OnChange="@HandleFileSelected"
                           accept=".pdf,.txt,.doc,.docx,.xls,.xlsx,.csv,.ppt,.pptx"
                           aria-label="Escolher ficheiro" />
                <label class="btn btn-outline-secondary localized-file-button" for="@documentationFileInputId">
                    <i class="bi bi-upload me-2"></i>Escolher ficheiro
                </label>
                <span class="localized-file-name">@(!string.IsNullOrEmpty(documentationFileName) ? documentationFileName : "Sem ficheiro escolhido")</span>
            </div>
            <div class="form-text">
                Tipos permitidos: PDF, TXT, DOC, DOCX, XLS, XLSX, CSV, PPT, PPTX (máx. 50 MB)
            </div>
        </div>
        @if (selectedFile != null)
        {
            <div class="alert alert-purple">
                <strong>Ficheiro selecionado:</strong> @selectedFile.Name (@FormatFileSize(selectedFile.Size))
            </div>
        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="CloseUploadModal">Cancelar</button>
        <button type="button" 
                class="btn btn-primary" 
                @onclick="UploadDocument" 
                disabled="@(selectedFile == null || isUploading)">
            @if (isUploading)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                <span>A carregar...</span>
            }
            else
            {
                <span>Carregar</span>
            }
        </button>
    </FooterContent>
</Modal>

@* Delete Document Confirmation Dialog *@
<ConfirmDialog Show="@showDeleteDialog"
               ShowChanged="@((bool show) => showDeleteDialog = show)"
               Title="Eliminar Documento"
               Message="@($"Tem a certeza que pretende eliminar o documento '{documentToDelete?.FileName}'?")"
               WarningMessage="Esta ação não pode ser revertida."
               ConfirmText="Eliminar"
               CancelText="Cancelar"
               ConfirmButtonClass="btn-danger"
               OnConfirm="@ConfirmDeleteDocument"
               OnCancel="@CancelDeleteDocument" />

@* Delete Folder Confirmation Dialog *@
<ConfirmDialog Show="@showDeleteFolderDialog"
               ShowChanged="@((bool show) => showDeleteFolderDialog = show)"
               Title="Eliminar Pasta"
               Message="@($"Tem a certeza que pretende eliminar a pasta '{folderToDelete}'?")"
               WarningMessage="Esta ação irá eliminar todos os documentos dentro desta pasta e não pode ser revertida."
               ConfirmText="Eliminar"
               CancelText="Cancelar"
               ConfirmButtonClass="btn-danger"
               OnConfirm="@ConfirmDeleteFolder"
               OnCancel="@CancelDeleteFolder" />

@code {
    private bool isLoading = true;
    private bool isMod = false;
    private bool isAdmin = false;
    private bool isOwner = false;
    private bool canDoAction = false;
    private string errorMessage = "";
    private ApplicationUser? currentUser;
    
    private List<string> folders = new();
    private List<string> allFolders = new(); // Store all folders before filtering
    private Dictionary<string, List<DocumentMetadata>> folderDocuments = new();
    
    // Fiscal year filtering
    private List<string> fiscalYears = new();
    private string currentFiscalYear = "";
    private string selectedFiscalYear = "";
    private IEnumerable<FilterDropdownOption> fiscalYearOptions => fiscalYears
        .Select(year => new FilterDropdownOption(year, $"{year}{(year == currentFiscalYear ? " (ATUAL)" : string.Empty)}"));
    
    // Per-folder pagination state (for documents within folders)
    private Dictionary<string, FolderPaginationState> folderPaginationStates = new();
    
    // Folder list pagination state
    private int currentFolderPage = 1;
    private int folderPageSize = 3;
    
    private class FolderPaginationState
    {
        public int CurrentPage { get; set; } = 1;
        public int PageSize { get; set; } = 3;
    }
    
    // Create folder modal
    private enum ModalType { CreateFolder, Upload }
    private readonly MultiModalState<ModalType> modals = new();
    private string newFolderName = "";
    private string createFolderError = "";
    
    // Upload modal
    private string selectedFolderPath = "";
    private string selectedFolderName = "";
    private IBrowserFile? selectedFile;
    private string documentationFileInputId = $"doc-upload-{Guid.NewGuid():N}";
    private string? documentationFileName;
    private bool isUploading = false;
    private string uploadError = "";
    private string uploadSuccess = "";
    
    // Delete document dialog
    private bool showDeleteDialog = false;
    private DocumentMetadata? documentToDelete;
    
    // Delete folder dialog
    private bool showDeleteFolderDialog = false;
    private string? folderToDelete;
    
    // Mapping from display name to actual folder path (for Logistics subfolders)
    private Dictionary<string, string> displayNameToFolderPath = new();
    
    // Allowed file extensions
    private readonly string[] allowedExtensions = { ".pdf", ".txt", ".doc", ".docx", ".xls", ".xlsx", ".csv", ".ppt", ".pptx" };
    private const long maxFileSize = 50 * 1024 * 1024; // 50 MB

    /// <summary>
    /// Filters folders based on visibility rules (same logic as meetings page)
    /// - Atas CV folders: Visible to Veterano, Tunossauro, and Magister
    /// - Atas AG folders: Visible to all except Leitão
    /// - Other folders: Visible to all (no filtering)
    /// </summary>
    private IEnumerable<string> FilterFoldersByVisibility(List<string> folderList)
    {
        // Only Owners see everything
        if (isOwner)
        {
            return folderList;
        }
        
        // If currentUser is null, show no restricted folders
        if (currentUser == null)
        {
            return folderList.Where(folder => 
                !folder.StartsWith("Atas CV", StringComparison.OrdinalIgnoreCase) &&
                !folder.StartsWith("Atas AG", StringComparison.OrdinalIgnoreCase));
        }

        return folderList.Where(folder =>
        {
            // Check if folder is an ATA folder
            if (folder.StartsWith("Atas CV", StringComparison.OrdinalIgnoreCase))
            {
                // CV folders: Veterano + Tunossauro + Magister (same logic as meetings page)
                var role = currentUser.CurrentRole;
                return role == "VETERANO" || 
                       role == "TUNOSSAURO" || 
                       (currentUser.Positions?.Contains(Position.Magister) ?? false);
            }
            else if (folder.StartsWith("Atas AG", StringComparison.OrdinalIgnoreCase))
            {
                // AG folders: All except Leitão (same logic as meetings page)
                return !currentUser.IsLeitao();
            }
            
            // Other folders: visible to all
            return true;
        });
    }

    /// <summary>
    /// Checks if the current user can access a specific document based on its file path
    /// </summary>
    private bool CanAccessDocument(string filePath)
    {
        if (currentUser == null)
        {
            return false;
        }
        
        // Only Owners can access everything
        if (isOwner)
        {
            return true;
        }
        
        // Extract folder name from file path
        // Path structure: docs/{environment}/{fiscalYear}/{folderName}/{fileName}
        // Example: "docs/Production/2024-2025/Atas CV 2024-2025/file.pdf"
        // We extract the folder name (4th segment): "Atas CV 2024-2025"
        var pathParts = filePath.Split('/', StringSplitOptions.RemoveEmptyEntries);
        if (pathParts.Length < 4)
        {
            // Invalid path structure, deny access
            return false;
        }
        
        // Get the folder name (4th part in the path)
        var folderName = pathParts[3];
        
        // Check if this is an ATA CV folder
        if (folderName.StartsWith("Atas CV", StringComparison.OrdinalIgnoreCase))
        {
            // CV folders: Veterano + Tunossauro + Magister
            var role = currentUser.CurrentRole;
            return role == "VETERANO" || 
                   role == "TUNOSSAURO" || 
                   (currentUser.Positions?.Contains(Position.Magister) ?? false);
        }
        else if (folderName.StartsWith("Atas AG", StringComparison.OrdinalIgnoreCase))
        {
            // AG folders: All except Leitão
            return !currentUser.IsLeitao();
        }
        
        // Other documents: accessible by all
        return true;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Check user roles
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            isMod = authState.User.IsInRole("Mod");
            isAdmin = authState.User.IsInRole("Admin");
            isOwner = authState.User.IsInRole("Owner");
            // Only Owner can perform administrative actions (create/upload/delete folders and documents)
            canDoAction = isOwner;
            
            // Get current user for visibility checks
            currentUser = await UserManager.GetUserAsync(authState.User);
            if (currentUser != null && !isOwner)
            {
                // Block Leitão members (unless they are Owner)
                if (currentUser.IsLeitao())
                {
                    NavigationManager.NavigateTo("/");
                    return;
                }
            }
            
            // Load fiscal years
            var allFiscalYears = await FiscalYearService.GetAllFiscalYearsAsync();
            fiscalYears = allFiscalYears
                .Where(fy => fy.StartYear >= FiscalYearHelper.AppYearCreated)
                .Select(fy => fy.GetFiscalYearString())
                .OrderByDescending(y => y)
                .ToList();
            currentFiscalYear = FiscalYearHelper.GetCurrentFiscalYearString();
            selectedFiscalYear = currentFiscalYear;
            
            await LoadDocumentation();
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro ao carregar documentação: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadDocumentation()
    {
        try
        {
            // Load folders for the selected fiscal year
            var fiscalYearPath = $"docs/{HostEnvironment.EnvironmentName}/{selectedFiscalYear}/";
            var baseFolders = await DocumentStorageService.ListSubfoldersAsync(fiscalYearPath);
            
            // Expand Logistics folder into individual board name folders
            var expandedFolders = new List<string>();
            var logisticsSubfolders = new List<string>();
            
            foreach (var folder in baseFolders)
            {
                if (folder.Equals("Logistics", StringComparison.OrdinalIgnoreCase))
                {
                    // Get board name subfolders within Logistics
                    var logisticsPath = $"docs/{HostEnvironment.EnvironmentName}/{selectedFiscalYear}/Logistics/";
                    logisticsSubfolders = await DocumentStorageService.ListSubfoldersAsync(logisticsPath);
                    
                    // Add each board name as its own folder entry
                    foreach (var subfolder in logisticsSubfolders)
                    {
                        expandedFolders.Add($"Logistics/{subfolder}");
                    }
                }
                else
                {
                    expandedFolders.Add(folder);
                }
            }
            
            allFolders = expandedFolders;
            
            // Filter folders based on visibility rules (same as meetings page)
            folders = FilterFoldersByVisibility(expandedFolders).ToList();
            
            // Load documents for all visible folders in parallel (eliminates N+1 Cloudflare API calls)
            folderDocuments.Clear();
            
            var documentTasks = folders.Select(async folder =>
            {
                var documents = new List<DocumentMetadata>();
                var folderPath = $"docs/{HostEnvironment.EnvironmentName}/{selectedFiscalYear}/{folder}";
                var folderDocs = await DocumentStorageService.ListDocumentsInFolderAsync(folderPath);
                documents.AddRange(folderDocs);
                
                return new { Folder = folder, Documents = documents };
            });
            
            var results = await Task.WhenAll(documentTasks);
            
            // Documents are now stored in fiscal year folders, so no date filtering needed
            foreach (var result in results)
            {
                folderDocuments[result.Folder] = result.Documents.ToList();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro ao carregar pastas e documentos: {ex.Message}";
        }
    }
    
    private async Task OnFiscalYearChanged()
    {
        // Reset pagination when fiscal year changes
        folderPaginationStates.Clear();
        currentFolderPage = 1;
        
        // Reload documentation with new filter
        await LoadDocumentation();
    }

    private void OpenCreateFolderModal()
    {
        newFolderName = "";
        createFolderError = "";
        modals.Open(ModalType.CreateFolder);
    }

    private void CloseCreateFolderModal()
    {
        modals.Close(ModalType.CreateFolder);
        newFolderName = "";
        createFolderError = "";
    }

    private async Task CreateFolder()
    {
        createFolderError = "";
        
        if (string.IsNullOrWhiteSpace(newFolderName))
        {
            createFolderError = "O nome da pasta não pode estar vazio.";
            return;
        }
        
        // Validate folder name (only alphanumeric, spaces, and hyphens)
        if (!System.Text.RegularExpressions.Regex.IsMatch(newFolderName, @"^[a-zA-Z0-9\s\-]+$"))
        {
            createFolderError = "O nome da pasta só pode conter letras, números, espaços e hífens.";
            return;
        }
        
        // Check if folder already exists
        if (folders.Contains(newFolderName))
        {
            createFolderError = "Uma pasta com este nome já existe.";
            return;
        }
        
        try
        {
            await SetAuditContextToCurrentUser();
            var fiscalYear = FiscalYearHelper.GetCurrentFiscalYearString();
            var folderPath = $"docs/{HostEnvironment.EnvironmentName}/{fiscalYear}/{newFolderName}";
            await DocumentStorageService.CreateFolderAsync(folderPath);
            
            // Reload folders
            await LoadDocumentation();
            
            CloseCreateFolderModal();
        }
        catch (Exception ex)
        {
            createFolderError = $"Erro ao criar pasta: {ex.Message}";
        }
    }

    private void HandleUploadRequest(string folderPath)
    {
        selectedFolderPath = folderPath;
        selectedFolderName = folderPath.Replace("docs/", "").TrimEnd('/');
        selectedFile = null;
        documentationFileName = null;
        uploadError = "";
        uploadSuccess = "";
        modals.Open(ModalType.Upload);
    }

    private void CloseUploadModal()
    {
        modals.Close(ModalType.Upload);
        selectedFolderPath = "";
        selectedFolderName = "";
        selectedFile = null;
        documentationFileName = null;
        uploadError = "";
        uploadSuccess = "";
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null)
        {
            selectedFile = null;
            documentationFileName = null;
            uploadError = "Ficheiro inválido.";
            uploadSuccess = "";
            return;
        }

        selectedFile = file;
        documentationFileName = selectedFile.Name;
        uploadError = "";
        uploadSuccess = "";

        // Validate file extension
        var extension = Path.GetExtension(selectedFile.Name).ToLowerInvariant();
        if (!allowedExtensions.Contains(extension))
        {
            uploadError = $"Tipo de ficheiro não permitido: {extension}. Tipos permitidos: {string.Join(", ", allowedExtensions)}";
            selectedFile = null;
            return;
        }
        
        // Validate file size
        if (selectedFile.Size > maxFileSize)
        {
            uploadError = $"O ficheiro é muito grande ({FormatFileSize(selectedFile.Size)}). Tamanho máximo: {FormatFileSize(maxFileSize)}";
            selectedFile = null;
            return;
        }
    }

    private async Task UploadDocument()
    {
        if (selectedFile == null || string.IsNullOrEmpty(selectedFolderPath))
            return;
        
        uploadError = "";
        uploadSuccess = "";
        isUploading = true;
        
        try
        {
            await SetAuditContextToCurrentUser();
            
            // Get content type
            var contentType = selectedFile.ContentType;
            
            // Upload the file
            using var stream = selectedFile.OpenReadStream(maxFileSize);
            await DocumentStorageService.UploadDocumentAsync(selectedFolderPath, selectedFile.Name, stream, contentType);
            
            uploadSuccess = $"Ficheiro '{selectedFile.Name}' carregado com sucesso!";
            
            // Reload all documentation to apply fiscal year filters consistently
            await LoadDocumentation();
            StateHasChanged();
            
            // Auto-close after 2 seconds
            await Task.Delay(2000);
            CloseUploadModal();
        }
        catch (Exception ex)
        {
            uploadError = $"Erro ao carregar ficheiro: {ex.Message}";
        }
        finally
        {
            isUploading = false;
        }
    }

    private async Task HandleDocumentDownload(DocumentMetadata document)
    {
        try
        {
            // Check if user has permission to access this document
            if (!CanAccessDocument(document.FilePath))
            {
                // User doesn't have permission to access this document
                return;
            }
            
            var url = await DocumentStorageService.GetDocumentUrlAsync(document.FilePath, forceDownload: true);
            if (!string.IsNullOrEmpty(url))
            {
                // Navigate in the same tab to avoid mobile popup blockers
                await JSRuntime.InvokeVoidAsync("open", url, "_self");
            }
        }
        catch (Exception)
        {
            // Silently fail
        }
    }
    
    private void HandleDocumentDeleteRequest(DocumentMetadata document)
    {
        documentToDelete = document;
        showDeleteDialog = true;
    }
    
    private async Task ConfirmDeleteDocument()
    {
        if (documentToDelete == null)
            return;
            
        try
        {
            await SetAuditContextToCurrentUser();
            await DocumentStorageService.DeleteDocumentAsync(documentToDelete.FilePath);
            
            // Reload all documentation to apply fiscal year filters consistently
            await LoadDocumentation();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro ao eliminar documento: {ex.Message}";
        }
        finally
        {
            documentToDelete = null;
            showDeleteDialog = false;
        }
    }
    
    private void CancelDeleteDocument()
    {
        documentToDelete = null;
        showDeleteDialog = false;
    }

    private string FormatFileSize(long bytes)
    {
        if (bytes < 1024)
            return $"{bytes} B";
        else if (bytes < 1024 * 1024)
            return $"{bytes / 1024.0:F1} KB";
        else if (bytes < 1024 * 1024 * 1024)
            return $"{bytes / (1024.0 * 1024.0):F1} MB";
        else
            return $"{bytes / (1024.0 * 1024.0 * 1024.0):F1} GB";
    }
    
    private FolderPaginationState GetOrCreatePaginationState(string folder)
    {
        if (!folderPaginationStates.ContainsKey(folder))
        {
            folderPaginationStates[folder] = new FolderPaginationState();
        }
        return folderPaginationStates[folder];
    }
    
    private Task HandlePageChanged(string folder, int page)
    {
        var state = GetOrCreatePaginationState(folder);
        state.CurrentPage = page;
        StateHasChanged();
        return Task.CompletedTask;
    }
    
    private Task HandlePageSizeChanged(string folder, int size)
    {
        var state = GetOrCreatePaginationState(folder);
        state.PageSize = size;
        state.CurrentPage = 1; // Reset to first page when changing page size
        StateHasChanged();
        return Task.CompletedTask;
    }
    
    private Task HandleFolderPageChanged(int page)
    {
        currentFolderPage = page;
        StateHasChanged();
        return Task.CompletedTask;
    }
    
    private Task HandleFolderPageSizeChanged(int size)
    {
        folderPageSize = size;
        currentFolderPage = 1; // Reset to first page when changing page size
        StateHasChanged();
        return Task.CompletedTask;
    }
    
    private void HandleFolderDeleteRequest(string displayFolderName)
    {
        // Look up the actual folder path from the display name
        // Display names for Logistics folders strip "Logistics/" prefix
        var actualFolder = folders.FirstOrDefault(f => 
            f == displayFolderName || 
            (f.StartsWith("Logistics/", StringComparison.OrdinalIgnoreCase) && 
             f.Substring("Logistics/".Length).Equals(displayFolderName, StringComparison.OrdinalIgnoreCase)));
        
        folderToDelete = actualFolder ?? displayFolderName;
        showDeleteFolderDialog = true;
    }
    
    private async Task ConfirmDeleteFolder()
    {
        if (string.IsNullOrEmpty(folderToDelete))
            return;
            
        try
        {
            await SetAuditContextToCurrentUser();
            var folderPath = $"docs/{HostEnvironment.EnvironmentName}/{selectedFiscalYear}/{folderToDelete}";
            await DocumentStorageService.DeleteFolderAsync(folderPath);
            
            // Reload folders
            await LoadDocumentation();
            
            // Reset folder pagination to page 1 if current page is now out of range
            if (folders.Count == 0)
            {
                currentFolderPage = 1;
            }
            else
            {
                var totalFolderPages = (int)Math.Ceiling((double)folders.Count / folderPageSize);
                if (currentFolderPage > totalFolderPages)
                {
                    currentFolderPage = totalFolderPages;
                }
            }
            
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro ao eliminar pasta: {ex.Message}";
        }
        finally
        {
            folderToDelete = null;
            showDeleteFolderDialog = false;
        }
    }
    
    private void CancelDeleteFolder()
    {
        folderToDelete = null;
        showDeleteFolderDialog = false;
    }

    private async Task SetAuditContextToCurrentUser()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userName = authState.User.Identity?.Name;
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        AuditContext.SetUser(userName, userId);
    }

}
