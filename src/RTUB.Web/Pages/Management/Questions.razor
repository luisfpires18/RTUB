@page "/questions"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using RTUB.Application.Interfaces
@using RTUB.Application.Helpers
@using RTUB.Application.Extensions
@using RTUB.Core.Entities
@using RTUB.Core.Enums
@using RTUB.Core.Helpers
@attribute [Authorize]
@inject IQuestionService QuestionService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Perguntas aos Órgãos Sociais</PageTitle>

<div class="discussion-page-wrapper">
    @if (isLoading)
    {
        <LoadingSpinner />
    }
    else
    {
        <!-- Page Header -->
        <div class="discussion-header mb-4">
            <div class="discussion-header-actions">
            </div>

            <div class="discussion-header-title">
                <h1 class="mb-2"><i class="bi bi-question-circle"></i> Perguntas</h1>
                <p class="mb-0 text-muted">Faça perguntas aos membros dos Órgãos Sociais</p>
            </div>

            @if (currentUser != null)
            {
                <div class="discussion-header-actions page-header-actions justify-content-end justify-content-lg-end">
                    <button class="btn btn-success" @onclick="OpenCreateQuestionModal" title="Criar Nova Pergunta">
                        <i class="bi bi-plus-lg"></i> Nova Pergunta
                    </button>
                </div>
            }
        </div>

        <!-- Search Bar and Filter -->
        <div class="d-flex flex-column flex-lg-row align-items-lg-end gap-2 flex-wrap">
            <div class="flex-grow-1 filter-search-container">
                <SearchBar @bind-Value="searchTerm"
                           Placeholder="Pesquisar perguntas..."
                           OnSearch="HandleSearch" />
            </div>
            <div class="flex-lg-shrink-0 ms-lg-auto filter-dropdown-container">
                <FilterDropdown SelectedValue="@selectedMemberFilter"
                                SelectedValueChanged="@(value => selectedMemberFilter = value)"
                                OnChange="@OnMemberFilterChanged"
                                AllItemsLabel="Todos os membros"
                                Options="@memberFilterOptions" />
            </div>
        </div>

        <!-- Open Questions (Not Closed) -->
        @if (openQuestions == null || !openQuestions.Any())
        {
            <EmptyState Title="Nenhuma pergunta aberta encontrada" 
                       Message="@(string.IsNullOrWhiteSpace(searchTerm) ? "Todas as perguntas estão fechadas ou não existem perguntas abertas." : "Nenhum resultado encontrado para a sua pesquisa.")" 
                       Icon="bi-question-circle" />
        }
        else
        {
            <div class="mb-4">
                <h3 class="mb-3"><i class="bi bi-chat-dots"></i> Perguntas Abertas</h3>
                <div class="question-grid">
                    @foreach (var question in openQuestions)
                    {
                        <QuestionCard Question="@question"
                                     ReplyCount="@GetReplyCount(question)"
                                     IsAuthor="@IsQuestionAuthor(question)"
                                     OnReply="@(() => OpenReplyModal(question))"
                                     OnNotify="@(() => ShowReminderConfirm(question))"
                                     OnClose="@(() => ShowCloseConfirm(question))"
                                     OnDelete="@(() => ShowDeleteConfirm(question))" />
                    }
                </div>

                @if (totalOpenQuestions > openPageSize)
                {
                    <div class="pagination-wrapper mt-4">
                        <TablePagination CurrentPage="@openCurrentPage"
                                        PageSize="@openPageSize"
                                        TotalItems="@totalOpenQuestions"
                                        ItemLabel="perguntas abertas"
                                        PageSizeOptions="@(new[] { 10, 20, 30, 40, 50 })"
                                        OnPageChanged="@HandleOpenPageChange"
                                        OnPageSizeChanged="@HandleOpenPageSizeChange" />
                    </div>
                }
            </div>
        }

        <!-- Closed Questions -->
        @if (closedQuestions != null && closedQuestions.Any())
        {
            <div class="mt-5">
                <h3 class="mb-3"><i class="bi bi-archive"></i> Perguntas Fechadas</h3>
                <div class="question-grid">
                    @foreach (var question in closedQuestions)
                    {
                        <QuestionCard Question="@question"
                                     ReplyCount="@GetReplyCount(question)"
                                     IsAuthor="@IsQuestionAuthor(question)"
                                     OnReply="@(() => OpenReplyModal(question))"
                                     OnNotify="@(() => ShowReminderConfirm(question))"
                                     OnClose="@(() => ShowCloseConfirm(question))"
                                     OnDelete="@(() => ShowDeleteConfirm(question))" />
                    }
                </div>

                @if (totalClosedQuestions > closedPageSize)
                {
                    <div class="pagination-wrapper mt-4">
                        <TablePagination CurrentPage="@closedCurrentPage"
                                        PageSize="@closedPageSize"
                                        TotalItems="@totalClosedQuestions"
                                        ItemLabel="perguntas fechadas"
                                        PageSizeOptions="@(new[] { 10, 20, 30, 40, 50 })"
                                        OnPageChanged="@HandleClosedPageChange"
                                        OnPageSizeChanged="@HandleClosedPageSizeChange" />
                    </div>
                }
            </div>
        }
    }
</div>

<!-- Create Question Modal -->
<Modal Show="@showCreateModal" 
       ShowChanged="@((show) => { showCreateModal = show; if (!show) ClearMemberSelection(); })"
       Title="Nova Pergunta"
       Size="Modal.ModalSize.Large"
       Centered="true">
    <BodyContent>
        <EditForm Model="@newQuestionModel" OnValidSubmit="CreateQuestion">
            <DataAnnotationsValidator />
            
            <div class="mb-3">
                <label class="form-label">Pesquisar Membro dos Órgãos Sociais</label>
                <SearchBar @bind-Value="memberSearchTerm"
                           Placeholder="Pesquisar por nome, alcunha ou cargo..."
                           OnSearch="OnMemberSearch"
                           OnClear="ClearMemberSelection"
                           Compact="true" />
                
                @if (filteredMembers.Any())
                {
                    <div class="member-list member-list-scrollable mt-2" style="max-height: 200px; overflow-y: auto;">
                        @foreach (var item in filteredMembers.Take(10))
                        {
                            <div class="member-item p-2 mb-2 border rounded clickable-row"
                                 @onclick="() => SelectMember(item)">
                                <div class="d-flex align-items-center">
                                    <img src="@item.Member.ProfilePictureSrc" alt="@item.Member.GetDisplayName()"
                                         class="rounded-circle me-2" style="width: 36px; height: 36px; object-fit: cover;" />
                                    <div>
                                        @if (!string.IsNullOrEmpty(item.Member.Nickname))
                                        {
                                            <div><strong>@item.Member.Nickname</strong></div>
                                            <div class="text-muted small">@item.Member.FirstName @item.Member.LastName</div>
                                        }
                                        else
                                        {
                                            <div><strong>@item.Member.FirstName @item.Member.LastName</strong></div>
                                        }
                                        <div class="small text-white-50">
                                            @GetRoleDisplayText(item.Group, item.Position)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else if (!string.IsNullOrEmpty(memberSearchTerm) && selectedMember == null)
                {
                    <div class="alert alert-purple mt-2">Nenhum membro encontrado.</div>
                }

                @if (selectedMember != null)
                {
                    <div class="alert alert-purple mt-2">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <strong>Membro Selecionado:</strong> @(selectedMember.Value.Member.Nickname ?? selectedMember.Value.Member.UserName)
                                <div class="small text-white-50">@GetRoleDisplayText(selectedMember.Value.Group, selectedMember.Value.Position)</div>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="ClearMemberSelection">
                                <i class="bi bi-x"></i>
                            </button>
                        </div>
                    </div>
                }
            </div>

            @if (!orgaoSocialMembers.Any())
            {
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    Não há membros dos Órgãos Sociais no momento.
                </div>
            }

            <div class="mb-3">
                <label class="form-label">Título</label>
                <InputText class="form-control" 
                           @bind-Value="newQuestionModel.Title"
                           placeholder="Resumo da sua pergunta..." 
                           maxlength="100" />
                <ValidationMessage For="@(() => newQuestionModel.Title)" />
            </div>

            <div class="mb-3">
                <label class="form-label">A sua pergunta</label>
                <InputTextArea class="form-control" 
                              rows="5" 
                              @bind-Value="newQuestionModel.Content"
                              placeholder="Escreva a sua pergunta aqui..." />
                <ValidationMessage For="@(() => newQuestionModel.Content)" />
            </div>

            <div class="d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-secondary" @onclick="() => showCreateModal = false">
                    Cancelar
                </button>
                <button type="submit" class="btn btn-primary" disabled="@(!CanSubmitQuestion())">
                    <i class="bi bi-send me-1"></i> Enviar Pergunta
                </button>
            </div>
        </EditForm>
    </BodyContent>
</Modal>

<!-- Delete Confirmation -->
<ConfirmDialog Show="@showDeleteConfirm"
               ShowChanged="@((value) => showDeleteConfirm = value)"
               Title="Confirmar Eliminação"
               Message="Tem a certeza que deseja eliminar esta pergunta? Esta ação não pode ser desfeita."
               ConfirmText="Eliminar"
               CancelText="Cancelar"
               ConfirmButtonClass="btn-danger"
               OnConfirm="ConfirmDelete" />

<!-- Close Confirmation -->
<ConfirmDialog Show="@showCloseConfirm"
               ShowChanged="@((value) => showCloseConfirm = value)"
               Title="Fechar Pergunta"
               Message="Tem a certeza que deseja fechar esta pergunta? Depois de fechada, não serão aceites mais respostas."
               ConfirmText="Fechar"
               CancelText="Cancelar"
               ConfirmButtonClass="btn-success"
               OnConfirm="ConfirmClose" />

<!-- Reminder Confirmation -->
<ConfirmDialog Show="@showReminderConfirm"
               ShowChanged="@((value) => showReminderConfirm = value)"
               Title="Enviar Lembrete"
               Message="Enviar notificação de lembrete para o membro designado?"
               ConfirmText="Enviar"
               CancelText="Cancelar"
               ConfirmButtonClass="btn-primary"
               OnConfirm="SendReminder" />

<!-- View Full Content Modal -->
<Modal Show="@showFullContentModal"
       ShowChanged="@((show) => showFullContentModal = show)"
       Title="Pergunta Completa"
       Size="Modal.ModalSize.Large"
       Centered="true">
    <BodyContent>
        @if (questionToView != null)
        {
            <div class="mb-3">
                <div class="d-flex align-items-center mb-2">
                    <img src="@(questionToView.Author.ProfilePictureSrc ?? "")"
                         class="rounded-circle me-2"
                         alt="@(questionToView.Author.Nickname ?? questionToView.Author.UserName ?? "Autor")"
                         style="width: 40px; height: 40px; object-fit: cover;" />
                    <div>
                        <strong>@(questionToView.Author.Nickname ?? questionToView.Author.UserName ?? "Autor")</strong>
                        <div class="text-muted small">@questionToView.CreatedAt.ToString("dd MMM yyyy, HH:mm")</div>
                    </div>
                </div>
                <div class="mb-2 text-muted small">
                    <i class="bi bi-arrow-right me-1"></i>
                    Para: <strong>@(questionToView.AssignedMember?.Nickname ?? questionToView.AssignedMember?.UserName)</strong>
                </div>
            </div>
            <h5 class="mb-3">@questionToView.Title</h5>
            <div class="p-3 bg-dark rounded" style="white-space: pre-wrap; word-break: break-word;">
                @questionToView.Content
            </div>
        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="() => showFullContentModal = false">Fechar</button>
    </FooterContent>
</Modal>

<!-- Reply Modal -->
<Modal Show="@showReplyModal"
       ShowChanged="@((show) => showReplyModal = show)"
       Title="Respostas"
       Size="Modal.ModalSize.Large"
       Centered="true">
    <BodyContent>
        @if (questionToReply != null)
        {
            var receiverGroup = OrgaoSocialHelper.GetGroupForPosition(questionToReply.AssignedPosition);
            var receiverRoleText = receiverGroup.HasValue ? GetRoleDisplayText(receiverGroup.Value, questionToReply.AssignedPosition) : PositionHelper.GetDisplayName(questionToReply.AssignedPosition);
            var replyCount = GetReplyCount(questionToReply);
            
            <!-- Question Header -->
            <div class="mb-4 p-3 bg-dark rounded">
                <div class="d-flex align-items-center mb-2">
                    <img src="@(questionToReply.Author.ProfilePictureSrc ?? "")"
                         class="rounded-circle me-2"
                         alt="@(questionToReply.Author.Nickname ?? questionToReply.Author.UserName ?? "Autor")"
                         style="width: 40px; height: 40px; object-fit: cover;" />
                    <div class="flex-grow-1">
                        <strong>@(questionToReply.Author.Nickname ?? questionToReply.Author.UserName ?? "Autor")</strong>
                        <div class="text-muted small">@questionToReply.CreatedAt.ToString("dd MMM yyyy, HH:mm")</div>
                    </div>
                    @if (questionToReply.Status == QuestionStatus.Closed)
                    {
                        <span class="badge bg-secondary">
                            <i class="bi bi-check-circle-fill"></i> Fechada
                        </span>
                    }
                    else if (questionToReply.Status == QuestionStatus.Unanswered)
                    {
                        <span class="badge bg-warning text-dark">
                            <i class="bi bi-hourglass-split"></i> Aguarda
                        </span>
                    }
                    else if (questionToReply.Status == QuestionStatus.Answered)
                    {
                        <span class="badge bg-success">
                            <i class="bi bi-check-circle"></i> Respondida
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-info">
                            <i class="bi bi-chat-dots"></i> Em Discussão
                        </span>
                    }
                </div>
                <div class="mb-2 text-muted small">
                    <i class="bi bi-arrow-right me-1"></i>
                    Para: <strong>@(questionToReply.AssignedMember?.Nickname ?? questionToReply.AssignedMember?.UserName)</strong>
                    <span class="ms-1">(@receiverRoleText)</span>
                </div>
                <h5 class="mb-2">@questionToReply.Title</h5>
                <div style="white-space: pre-wrap; word-break: break-word;">
                    @questionToReply.Content
                </div>
            </div>

            <!-- Replies Section -->
            <div class="replies-section">
                <h6 class="mb-3">
                    <i class="bi bi-chat-left-text me-2"></i>Respostas (@replyCount)
                </h6>
                
                @if (replyCount == 0)
                {
                    <p class="text-muted text-center py-3"><em>Nenhuma resposta ainda.</em></p>
                }
                else
                {
                    <div class="replies-list mb-3" style="max-height: 400px; overflow-y: auto;">
                        @foreach (var reply in questionToReply.Replies.Where(r => !r.IsDeleted).OrderBy(r => r.CreatedAt))
                        {
                            <div class="reply-item mb-3 p-3 bg-dark rounded">
                                <div class="d-flex align-items-start mb-2">
                                    <img src="@(reply.Author.ProfilePictureSrc)"
                                         class="rounded-circle me-2"
                                         alt="@(reply.Author.Nickname ?? reply.Author.UserName)"
                                         style="width: 36px; height: 36px; object-fit: cover;" />
                                    <div class="flex-grow-1">
                                        <div class="d-flex align-items-center gap-2 flex-wrap">
                                            <strong>@(reply.Author.Nickname ?? reply.Author.UserName)</strong>
                                            @if (reply.IsFromAssignedMember)
                                            {
                                                <span class="badge bg-primary">@receiverRoleText</span>
                                            }
                                        </div>
                                        <small class="text-muted">
                                            @reply.CreatedAt.ToString("dd MMM yyyy, HH:mm")
                                        </small>
                                    </div>
                                </div>
                                <div style="white-space: pre-line;">@reply.Content</div>
                            </div>
                        }
                    </div>
                }

                <!-- Add Reply -->
                @if (CanReplyToQuestion(questionToReply))
                {
                    <div class="mt-3">
                        <CommentComposer OnSubmit="@(async (body) => await AddReplyFromModal(questionToReply.Id, body))" />
                    </div>
                }
                else if (questionToReply.Status == QuestionStatus.Closed)
                {
                    <div class="alert alert-secondary">
                        <i class="bi bi-lock me-2"></i>
                        Esta pergunta foi fechada pelo autor. Não é possível adicionar novas respostas.
                    </div>
                }
                else if (currentUser != null)
                {
                    @if (questionToReply.IsAwaitingUserReply && !IsQuestionAuthor(questionToReply))
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-hourglass me-2"></i>
                            Aguardando resposta do autor da pergunta.
                        </div>
                    }
                    else if (!questionToReply.IsAwaitingUserReply && !IsAssignedMember(questionToReply))
                    {
                        <div class="alert alert-warning">
                            <i class="bi bi-person-lock me-2"></i>
                            Apenas o membro designado pode responder a esta pergunta.
                        </div>
                    }
                }
            </div>
        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="() => showReplyModal = false">Fechar</button>
    </FooterContent>
</Modal>

@code {
    private List<Question> openQuestions = new();
    private List<Question> closedQuestions = new();
    private ApplicationUser? currentUser;
    private bool isLoading = true;
    private string searchTerm = string.Empty;
    private string selectedMemberFilter = string.Empty;
    
    // Open questions pagination
    private int openCurrentPage = 1;
    private int openPageSize = 10;
    private int totalOpenQuestions = 0;
    
    // Closed questions pagination
    private int closedCurrentPage = 1;
    private int closedPageSize = 10;
    private int totalClosedQuestions = 0;

    // Filter options
    private List<FilterDropdownOption> memberFilterOptions = new();

    // Create question modal
    private bool showCreateModal = false;
    private NewQuestionModel newQuestionModel = new();
    private List<(ApplicationUser Member, OrgaoSocialGroup Group, Position Position)> orgaoSocialMembers = new();
    
    // Member search for question creation
    private string memberSearchTerm = string.Empty;
    private List<(ApplicationUser Member, OrgaoSocialGroup Group, Position Position)> filteredMembers = new();
    private (ApplicationUser Member, OrgaoSocialGroup Group, Position Position)? selectedMember;
    private SearchHelper<(ApplicationUser Member, OrgaoSocialGroup Group, Position Position)> memberSearchHelper = new();

    // Dialogs
    private bool showDeleteConfirm = false;
    private bool showCloseConfirm = false;
    private bool showReminderConfirm = false;
    private bool showFullContentModal = false;
    private bool showReplyModal = false;
    private Question? questionToDelete;
    private Question? questionToClose;
    private Question? questionForReminder;
    private Question? questionToView;
    private Question? questionToReply;

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrentUserAsync();
        await LoadOrgaoSocialMembersAsync();
        await LoadMemberFilterOptionsAsync();
        await LoadQuestionsAsync();
        isLoading = false;
    }

    private async Task LoadCurrentUserAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userName = authState.User.Identity?.Name;

        if (!string.IsNullOrEmpty(userName))
        {
            currentUser = await UserManager.FindByNameAsync(userName);
        }
    }

    private async Task LoadQuestionsAsync()
    {
        // Load open questions (not closed), sorted by latest reply or creation date
        var openQuestionsResult = await QuestionService.GetAllWithRepliesAsync(
            openCurrentPage, 
            openPageSize, 
            searchTerm,
            isClosedFilter: false,
            assignedMemberIdFilter: selectedMemberFilter
        );
        openQuestions = openQuestionsResult.ToList();
        totalOpenQuestions = await QuestionService.GetCountAsync(searchTerm, isClosedFilter: false, assignedMemberIdFilter: selectedMemberFilter);

        // Load closed questions
        var closedQuestionsResult = await QuestionService.GetAllWithRepliesAsync(
            closedCurrentPage, 
            closedPageSize, 
            searchTerm,
            isClosedFilter: true,
            assignedMemberIdFilter: selectedMemberFilter
        );
        closedQuestions = closedQuestionsResult.ToList();
        totalClosedQuestions = await QuestionService.GetCountAsync(searchTerm, isClosedFilter: true, assignedMemberIdFilter: selectedMemberFilter);
    }

    private async Task LoadOrgaoSocialMembersAsync()
    {
        var members = await QuestionService.GetAllOrgaoSocialMembersAsync();
        orgaoSocialMembers = members.ToList();
    }

    private async Task LoadMemberFilterOptionsAsync()
    {
        var members = await QuestionService.GetAllOrgaoSocialMembersAsync();
        memberFilterOptions = members
            .Select(m => new FilterDropdownOption(
                m.Member.Id,
                $"{m.Member.Nickname ?? m.Member.UserName} - {PositionHelper.GetDisplayName(m.Position)}"
            ))
            .ToList();
    }

    private int GetReplyCount(Question question)
    {
        return question.Replies?.Count(r => !r.IsDeleted) ?? 0;
    }

    private string GetAssignedMemberDisplayText(Question question)
    {
        var group = OrgaoSocialHelper.GetGroupForPosition(question.AssignedPosition);
        var groupName = group.HasValue ? OrgaoSocialHelper.GetDisplayName(group.Value) : "";
        var positionName = PositionHelper.GetDisplayName(question.AssignedPosition);
        var memberName = question.AssignedMember?.Nickname ?? question.AssignedMember?.UserName ?? "";
        
        return $"{groupName} - {positionName} - {memberName}";
    }

    private string GetRoleDisplayText(OrgaoSocialGroup group, Position position)
    {
        // Only show "Group - Position" for Direção members, otherwise just show position
        if (group == OrgaoSocialGroup.Direcao)
        {
            return $"{OrgaoSocialHelper.GetDisplayName(group)} - {PositionHelper.GetDisplayName(position)}";
        }
        return PositionHelper.GetDisplayName(position);
    }

    private void OpenCreateQuestionModal()
    {
        newQuestionModel = new NewQuestionModel();
        ClearMemberSelection();
        showCreateModal = true;
    }

    private void OnMemberSearch(string term)
    {
        memberSearchTerm = term;
        FilterMembers();
    }

    private void FilterMembers()
    {
        if (string.IsNullOrEmpty(memberSearchTerm))
        {
            filteredMembers.Clear();
            return;
        }

        memberSearchHelper.SearchTerm = memberSearchTerm;
        
        filteredMembers = memberSearchHelper.FilterMultiple(orgaoSocialMembers, new List<Func<(ApplicationUser Member, OrgaoSocialGroup Group, Position Position), string>>
        {
            item => item.Member.FirstName ?? string.Empty,
            item => item.Member.LastName ?? string.Empty,
            item => $"{item.Member.FirstName ?? ""} {item.Member.LastName ?? ""}",
            item => item.Member.Nickname ?? string.Empty,
            // Allow search by role/position
            item => PositionHelper.GetDisplayName(item.Position),
            item => OrgaoSocialHelper.GetDisplayName(item.Group),
            item => $"{OrgaoSocialHelper.GetDisplayName(item.Group)} {PositionHelper.GetDisplayName(item.Position)}"
        }, caseSensitive: false, accentSensitive: false);
    }

    private void SelectMember((ApplicationUser Member, OrgaoSocialGroup Group, Position Position) member)
    {
        selectedMember = member;
        memberSearchTerm = member.Member.Nickname ?? $"{member.Member.FirstName} {member.Member.LastName}";
        filteredMembers.Clear();
    }

    private void ClearMemberSelection()
    {
        selectedMember = null;
        memberSearchTerm = string.Empty;
        filteredMembers.Clear();
    }

    private async Task CreateQuestion()
    {
        if (!CanSubmitQuestion() || currentUser == null || selectedMember == null)
            return;

        await QuestionService.CreateAsync(
            newQuestionModel.Title,
            newQuestionModel.Content,
            currentUser.Id,
            selectedMember.Value.Position,
            selectedMember.Value.Member.Id);

        showCreateModal = false;
        ClearMemberSelection();
        await LoadQuestionsAsync();
        StateHasChanged();
    }

    private async Task AddReply(int questionId, string body)
    {
        if (currentUser == null)
            return;

        await QuestionService.AddReplyAsync(questionId, body, currentUser.Id);
        await LoadQuestionsAsync();
        StateHasChanged();
    }

    private async Task AddReplyFromModal(int questionId, string body)
    {
        if (currentUser == null)
            return;

        await QuestionService.AddReplyAsync(questionId, body, currentUser.Id);
        await LoadQuestionsAsync();
        
        // Reload the question in the modal
        var updatedQuestion = openQuestions.Concat(closedQuestions).FirstOrDefault(q => q.Id == questionId);
        if (updatedQuestion != null)
        {
            questionToReply = updatedQuestion;
        }
        
        StateHasChanged();
    }

    private bool IsQuestionAuthor(Question question)
    {
        return currentUser != null && question.AuthorId == currentUser.Id;
    }

    private bool IsAssignedMember(Question question)
    {
        return currentUser != null && question.AssignedMemberId == currentUser.Id;
    }

    private bool CanReplyToQuestion(Question question)
    {
        if (currentUser == null) return false;
        if (question.Status == QuestionStatus.Closed) return false;

        // If awaiting user reply, only author can reply
        if (question.IsAwaitingUserReply)
        {
            return IsQuestionAuthor(question);
        }

        // Otherwise, only assigned member can reply (or author if in discussion)
        return IsAssignedMember(question) || (question.Status == QuestionStatus.InDiscussion && IsQuestionAuthor(question));
    }

    private bool CanSubmitQuestion()
    {
        return selectedMember != null &&
               !string.IsNullOrWhiteSpace(newQuestionModel.Title) &&
               newQuestionModel.Title.Length <= 100 &&
               !string.IsNullOrWhiteSpace(newQuestionModel.Content) &&
               newQuestionModel.Content.Length >= 10;
    }

    private void OpenReplyModal(Question question)
    {
        questionToReply = question;
        showReplyModal = true;
    }

    private void ShowDeleteConfirm(Question question)
    {
        questionToDelete = question;
        showDeleteConfirm = true;
    }

    private async Task ConfirmDelete()
    {
        if (questionToDelete != null && currentUser != null)
        {
            await QuestionService.DeleteAsync(questionToDelete.Id, currentUser.Id);
            questionToDelete = null;
            await LoadQuestionsAsync();
            StateHasChanged();
        }
    }

    private void ShowCloseConfirm(Question question)
    {
        questionToClose = question;
        showCloseConfirm = true;
    }

    private async Task ConfirmClose()
    {
        if (questionToClose != null && currentUser != null)
        {
            await QuestionService.CloseAsync(questionToClose.Id, currentUser.Id);
            questionToClose = null;
            showReplyModal = false; // Close the modal if open
            await LoadQuestionsAsync();
            StateHasChanged();
        }
    }

    private void ShowReminderConfirm(Question question)
    {
        questionForReminder = question;
        showReminderConfirm = true;
    }

    private async Task SendReminder()
    {
        if (questionForReminder != null && currentUser != null)
        {
            await QuestionService.SendManualReminderAsync(questionForReminder.Id, currentUser.Id);
            questionForReminder = null;
        }
    }

    private void ShowFullContent(Question question)
    {
        questionToView = question;
        showFullContentModal = true;
    }

    private async Task HandleSearch(string term)
    {
        searchTerm = term;
        openCurrentPage = 1;
        closedCurrentPage = 1;
        await LoadQuestionsAsync();
    }

    private async Task OnMemberFilterChanged()
    {
        openCurrentPage = 1;
        closedCurrentPage = 1;
        await LoadQuestionsAsync();
    }

    private async Task HandleOpenPageChange(int newPage)
    {
        openCurrentPage = newPage;
        await LoadQuestionsAsync();
    }

    private async Task HandleOpenPageSizeChange(int newPageSize)
    {
        openPageSize = newPageSize;
        openCurrentPage = 1;
        await LoadQuestionsAsync();
    }

    private async Task HandleClosedPageChange(int newPage)
    {
        closedCurrentPage = newPage;
        await LoadQuestionsAsync();
    }

    private async Task HandleClosedPageSizeChange(int newPageSize)
    {
        closedPageSize = newPageSize;
        closedCurrentPage = 1;
        await LoadQuestionsAsync();
    }

    private class NewQuestionModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "O título é obrigatório")]
        [System.ComponentModel.DataAnnotations.MaxLength(100, ErrorMessage = "O título deve ter no máximo 100 caracteres")]
        public string Title { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "A pergunta é obrigatória")]
        [System.ComponentModel.DataAnnotations.MinLength(10, ErrorMessage = "A pergunta deve ter pelo menos 10 caracteres")]
        public string Content { get; set; } = string.Empty;
    }
}

