@page "/questions"
@page "/questions/{QuestionId:int}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using RTUB.Application.Interfaces
@using RTUB.Core.Entities
@using RTUB.Core.Enums
@using RTUB.Core.Helpers
@attribute [Authorize]
@inject IQuestionService QuestionService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation

<PageTitle>Perguntas aos Órgãos Sociais</PageTitle>

<div class="discussion-page-wrapper">
    @if (isLoading)
    {
        <LoadingSpinner />
    }
    else
    {
        <!-- Page Header -->
        <div class="discussion-header mb-4">
            <div class="discussion-header-actions">
                @if (selectedQuestion != null)
                {
                    <button class="btn btn-outline-secondary btn-sm" @onclick="NavigateToList">
                        <i class="bi bi-arrow-left"></i>
                    </button>
                }
            </div>

            <div class="discussion-header-title">
                <h1 class="mb-2"><i class="bi bi-question-circle"></i> Perguntas</h1>
                <p class="mb-0 text-muted">Faça perguntas aos membros dos Órgãos Sociais</p>
            </div>

            @if (currentUser != null && selectedQuestion == null)
            {
                <div class="discussion-header-actions page-header-actions justify-content-end justify-content-lg-end">
                    <button class="btn btn-success" @onclick="OpenCreateQuestionModal" title="Criar Nova Pergunta">
                        <i class="bi bi-plus-lg"></i> Nova Pergunta
                    </button>
                </div>
            }
        </div>

        @if (selectedQuestion != null)
        {
            <!-- Question Detail View -->
            <div class="question-detail">
                <div class="post-wrapper mb-3">
                    <div class="post-card" style="height: auto; cursor: default;">
                        <div class="post-card-avatar-section">
                            <img src="@(selectedQuestion.Author.ProfilePictureSrc ?? "")"
                                 class="post-card-avatar"
                                 alt="@(selectedQuestion.Author.Nickname ?? selectedQuestion.Author.UserName ?? "Autor")" />
                            <div class="post-card-author-info">
                                <div class="post-card-author-name">@(selectedQuestion.Author.Nickname ?? selectedQuestion.Author.UserName ?? "Autor")</div>
                                <small class="post-card-date">@selectedQuestion.CreatedAt.ToString("dd MMM yyyy, HH:mm")</small>
                            </div>
                        </div>

                        <div class="post-card-content">
                            <div class="post-card-header">
                                <h5 class="post-card-title">Pergunta para: @(selectedQuestion.AssignedMember?.Nickname ?? selectedQuestion.AssignedMember?.UserName)</h5>
                            </div>

                            <p class="post-card-body" style="-webkit-line-clamp: unset; display: block;">
                                @selectedQuestion.Content
                            </p>

                            <div class="post-card-footer">
                                <div class="post-card-meta">
                                    <span class="post-card-meta-item">
                                        <i class="bi bi-person-badge"></i>
                                        @PositionHelper.GetDisplayName(selectedQuestion.AssignedPosition)
                                    </span>
                                    <span class="post-card-meta-item">
                                        <i class="bi bi-chat-left-dots"></i>
                                        @(selectedQuestion.Replies?.Count ?? 0) respostas
                                    </span>
                                </div>
                                <div class="post-card-badges">
                                    @if (selectedQuestion.Status == QuestionStatus.Unanswered)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-hourglass-split"></i> Aguarda Resposta
                                        </span>
                                    }
                                    else if (selectedQuestion.Status == QuestionStatus.Answered)
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle"></i> Respondida
                                        </span>
                                    }
                                    else if (selectedQuestion.Status == QuestionStatus.InDiscussion)
                                    {
                                        <span class="badge bg-info">
                                            <i class="bi bi-chat-dots"></i> Em Discussão
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Author controls -->
                        @if (IsQuestionAuthor(selectedQuestion))
                        {
                            <div class="post-card-admin-actions">
                                <button class="btn btn-sm btn-outline-light"
                                        @onclick="ShowReminderConfirm"
                                        title="Enviar lembrete">
                                    <i class="bi bi-bell text-white"></i>
                                </button>
                                <button class="btn btn-sm btn-danger"
                                        @onclick="() => ShowDeleteConfirm(selectedQuestion)"
                                        title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        }
                    </div>
                </div>

                <!-- Replies Section -->
                <div class="comments-section mt-4">
                    <h6 class="mb-3">
                        <i class="bi bi-chat-left-text me-2"></i>Respostas (@(selectedQuestion.Replies?.Count ?? 0))
                    </h6>
                    
                    @if (selectedQuestion.Replies == null || !selectedQuestion.Replies.Any())
                    {
                        <p class="text-muted"><em>Nenhuma resposta ainda.</em></p>
                    }
                    else
                    {
                        <div class="comments-list mb-3">
                            @foreach (var reply in selectedQuestion.Replies.OrderBy(r => r.CreatedAt))
                            {
                                <div class="comment-item mb-2">
                                    <div class="comment-header">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <div class="d-flex align-items-center">
                                                <img src="@(reply.Author.ProfilePictureSrc)"
                                                     class="rounded-circle me-2"
                                                     alt="@(reply.Author.Nickname ?? reply.Author.UserName)"
                                                     style="width: 36px; height: 36px; object-fit: cover;" />
                                                <div>
                                                    <div class="fw-bold">
                                                        @(reply.Author.Nickname ?? reply.Author.UserName)
                                                        @if (reply.IsFromAssignedMember)
                                                        {
                                                            <span class="badge bg-primary ms-2">Órgão Social</span>
                                                        }
                                                    </div>
                                                    <small class="text-muted">
                                                        @reply.CreatedAt.ToString("dd MMM yyyy, HH:mm")
                                                    </small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="comment-body">
                                        <p class="mb-0" style="white-space: pre-line;">@reply.Content</p>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <!-- Add Reply -->
                    @if (CanReplyToQuestion(selectedQuestion))
                    {
                        <div class="mt-3">
                            <CommentComposer OnSubmit="@(async (body) => await AddReply(body))" />
                        </div>
                    }
                    else if (!CanReplyToQuestion(selectedQuestion) && currentUser != null)
                    {
                        <div class="alert alert-info mt-3 d-flex align-items-center">
                            <i class="bi bi-info-circle me-2"></i>
                            <span>
                                @if (selectedQuestion.IsAwaitingUserReply && !IsQuestionAuthor(selectedQuestion))
                                {
                                    <text>Aguardando resposta do autor da pergunta.</text>
                                }
                                else if (!selectedQuestion.IsAwaitingUserReply && !IsAssignedMember(selectedQuestion))
                                {
                                    <text>Apenas o membro designado pode responder a esta pergunta.</text>
                                }
                            </span>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <!-- Search Bar -->
            <SearchBar @bind-Value="searchTerm"
                       Placeholder="Pesquisar perguntas..."
                       OnSearch="HandleSearch" />

            <!-- Questions List -->
            @if (questions == null || !questions.Any())
            {
                <EmptyState Title="Nenhuma pergunta encontrada" 
                           Message="@(string.IsNullOrWhiteSpace(searchTerm) ? "Seja o primeiro a fazer uma pergunta aos Órgãos Sociais!" : "Nenhum resultado encontrado para a sua pesquisa.")" 
                           Icon="bi-question-circle" />
            }
            else
            {
                <div class="posts-list">
                    @foreach (var question in questions)
                    {
                        <div class="post-wrapper mb-3">
                            <div class="post-card" @onclick="() => SelectQuestion(question.Id)">
                                <div class="post-card-avatar-section">
                                    <img src="@(question.Author.ProfilePictureSrc ?? "")"
                                         class="post-card-avatar"
                                         alt="@(question.Author.Nickname ?? question.Author.UserName ?? "Autor")" />
                                    <div class="post-card-author-info">
                                        <div class="post-card-author-name">@(question.Author.Nickname ?? question.Author.UserName ?? "Autor")</div>
                                        <small class="post-card-date">@question.CreatedAt.ToString("dd MMM yyyy")</small>
                                    </div>
                                </div>

                                <div class="post-card-content">
                                    <div class="post-card-header">
                                        <h5 class="post-card-title">
                                            Para: @(question.AssignedMember?.Nickname ?? question.AssignedMember?.UserName) - @PositionHelper.GetDisplayName(question.AssignedPosition)
                                        </h5>
                                    </div>

                                    <p class="post-card-body">
                                        @question.Content
                                    </p>

                                    <div class="post-card-footer">
                                        <div class="post-card-meta">
                                            <span class="post-card-meta-item">
                                                <i class="bi bi-clock"></i>
                                                @question.CreatedAt.ToString("dd MMM, HH:mm")
                                            </span>
                                        </div>
                                        <div class="post-card-badges">
                                            @if (question.Status == QuestionStatus.Unanswered)
                                            {
                                                <span class="badge bg-warning text-dark">
                                                    <i class="bi bi-hourglass-split"></i> Aguarda
                                                </span>
                                            }
                                            else if (question.Status == QuestionStatus.Answered)
                                            {
                                                <span class="badge bg-success">
                                                    <i class="bi bi-check-circle"></i> Respondida
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-info">
                                                    <i class="bi bi-chat-dots"></i> Em Discussão
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <!-- Author controls -->
                                @if (IsQuestionAuthor(question))
                                {
                                    <div class="post-card-admin-actions" @onclick:stopPropagation="true">
                                        <button class="btn btn-sm btn-outline-light"
                                                @onclick="() => { selectedQuestion = question; ShowReminderConfirm(); }"
                                                title="Enviar lembrete">
                                            <i class="bi bi-bell text-white"></i>
                                        </button>
                                        <button class="btn btn-sm btn-danger"
                                                @onclick="() => ShowDeleteConfirm(question)"
                                                title="Eliminar">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                @if (totalQuestions > pageSize)
                {
                    <div class="pagination-wrapper mt-4">
                        <TablePagination CurrentPage="@currentPage"
                                        PageSize="@pageSize"
                                        TotalItems="@totalQuestions"
                                        ItemLabel="perguntas"
                                        PageSizeOptions="@(new[] { 20, 50, 100 })"
                                        OnPageChanged="@HandlePageChange"
                                        OnPageSizeChanged="@HandlePageSizeChange" />
                    </div>
                }
            }
        }
    }
</div>

<!-- Create Question Modal -->
<Modal Show="@showCreateModal" 
       ShowChanged="@((show) => showCreateModal = show)"
       Title="Nova Pergunta"
       Size="Modal.ModalSize.Large"
       Centered="true">
    <BodyContent>
        <EditForm Model="@newQuestionModel" OnValidSubmit="CreateQuestion">
            <DataAnnotationsValidator />
            
            <div class="mb-3">
                <label class="form-label">Selecione o Órgão Social</label>
                <select class="form-select" @bind="selectedGroup">
                    <option value="">-- Selecione um grupo --</option>
                    @foreach (var group in OrgaoSocialHelper.GetAllGroups())
                    {
                        <option value="@group">@OrgaoSocialHelper.GetDisplayName(group)</option>
                    }
                </select>
            </div>

            @if (selectedGroup.HasValue)
            {
                <div class="mb-3">
                    <label class="form-label">Selecione o Cargo</label>
                    <select class="form-select" @bind="selectedPosition">
                        <option value="">-- Selecione um cargo --</option>
                        @foreach (var position in OrgaoSocialHelper.GetPositionsForGroup(selectedGroup.Value))
                        {
                            <option value="@position">@PositionHelper.GetDisplayName(position)</option>
                        }
                    </select>
                </div>
            }

            @if (selectedPosition.HasValue && membersWithPosition.Any())
            {
                <div class="mb-3">
                    <label class="form-label">Selecione o Membro</label>
                    <select class="form-select" @bind="newQuestionModel.AssignedMemberId">
                        <option value="">-- Selecione um membro --</option>
                        @foreach (var member in membersWithPosition)
                        {
                            <option value="@member.Id">@(member.Nickname ?? member.UserName) - @PositionHelper.GetDisplayName(selectedPosition.Value)</option>
                        }
                    </select>
                </div>
            }
            else if (selectedPosition.HasValue && !membersWithPosition.Any())
            {
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    Não há membros com este cargo no momento.
                </div>
            }

            <div class="mb-3">
                <label class="form-label">A sua pergunta</label>
                <InputTextArea class="form-control" 
                              rows="5" 
                              @bind-Value="newQuestionModel.Content"
                              placeholder="Escreva a sua pergunta aqui..." />
                <ValidationMessage For="@(() => newQuestionModel.Content)" />
            </div>

            <div class="d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-secondary" @onclick="() => showCreateModal = false">
                    Cancelar
                </button>
                <button type="submit" class="btn btn-primary" disabled="@(!CanSubmitQuestion())">
                    <i class="bi bi-send me-1"></i> Enviar Pergunta
                </button>
            </div>
        </EditForm>
    </BodyContent>
</Modal>

<!-- Delete Confirmation -->
<ConfirmDialog Show="@showDeleteConfirm"
               ShowChanged="@((value) => showDeleteConfirm = value)"
               Title="Confirmar Eliminação"
               Message="Tem a certeza que deseja eliminar esta pergunta? Esta ação não pode ser desfeita."
               ConfirmText="Eliminar"
               CancelText="Cancelar"
               ConfirmButtonClass="btn-danger"
               OnConfirm="ConfirmDelete" />

<!-- Reminder Confirmation -->
<ConfirmDialog Show="@showReminderConfirm"
               ShowChanged="@((value) => showReminderConfirm = value)"
               Title="Enviar Lembrete"
               Message="Enviar notificação de lembrete para o membro designado?"
               ConfirmText="Enviar"
               CancelText="Cancelar"
               ConfirmButtonClass="btn-primary"
               OnConfirm="SendReminder" />

@code {
    [Parameter]
    public int? QuestionId { get; set; }

    private List<Question> questions = new();
    private Question? selectedQuestion;
    private ApplicationUser? currentUser;
    private bool isLoading = true;
    private string searchTerm = string.Empty;
    private int currentPage = 1;
    private int pageSize = 20;
    private int totalQuestions = 0;

    // Create question modal
    private bool showCreateModal = false;
    private NewQuestionModel newQuestionModel = new();
    private OrgaoSocialGroup? selectedGroup;
    private Position? selectedPosition;
    private List<ApplicationUser> membersWithPosition = new();

    // Dialogs
    private bool showDeleteConfirm = false;
    private bool showReminderConfirm = false;
    private Question? questionToDelete;

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrentUserAsync();
        await LoadQuestionsAsync();
        
        if (QuestionId.HasValue)
        {
            await LoadQuestionDetailAsync(QuestionId.Value);
        }
        
        isLoading = false;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (QuestionId.HasValue && (selectedQuestion == null || selectedQuestion.Id != QuestionId.Value))
        {
            await LoadQuestionDetailAsync(QuestionId.Value);
        }
        else if (!QuestionId.HasValue && selectedQuestion != null)
        {
            selectedQuestion = null;
        }
    }

    private async Task LoadCurrentUserAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userName = authState.User.Identity?.Name;

        if (!string.IsNullOrEmpty(userName))
        {
            currentUser = await UserManager.FindByNameAsync(userName);
        }
    }

    private async Task LoadQuestionsAsync()
    {
        totalQuestions = await QuestionService.GetCountAsync(searchTerm);
        var loadedQuestions = await QuestionService.GetAllAsync(currentPage, pageSize, searchTerm);
        questions = loadedQuestions.ToList();
    }

    private async Task LoadQuestionDetailAsync(int questionId)
    {
        selectedQuestion = await QuestionService.GetByIdWithRepliesAsync(questionId);
        if (selectedQuestion == null)
        {
            Navigation.NavigateTo("/questions");
        }
    }

    private async Task LoadMembersWithPositionAsync()
    {
        if (selectedPosition.HasValue)
        {
            var members = await QuestionService.GetMembersWithPositionAsync(selectedPosition.Value);
            membersWithPosition = members.ToList();
        }
        else
        {
            membersWithPosition.Clear();
        }
    }

    private void SelectQuestion(int questionId)
    {
        Navigation.NavigateTo($"/questions/{questionId}");
    }

    private void NavigateToList()
    {
        Navigation.NavigateTo("/questions");
    }

    private void OpenCreateQuestionModal()
    {
        newQuestionModel = new NewQuestionModel();
        selectedGroup = null;
        selectedPosition = null;
        membersWithPosition.Clear();
        showCreateModal = true;
    }

    private async Task CreateQuestion()
    {
        if (!CanSubmitQuestion() || currentUser == null || !selectedPosition.HasValue)
            return;

        await QuestionService.CreateAsync(
            newQuestionModel.Content,
            currentUser.Id,
            selectedPosition.Value,
            newQuestionModel.AssignedMemberId);

        showCreateModal = false;
        await LoadQuestionsAsync();
        StateHasChanged();
    }

    private async Task AddReply(string body)
    {
        if (selectedQuestion == null || currentUser == null)
            return;

        await QuestionService.AddReplyAsync(selectedQuestion.Id, body, currentUser.Id);
        await LoadQuestionDetailAsync(selectedQuestion.Id);
        StateHasChanged();
    }

    private bool IsQuestionAuthor(Question question)
    {
        return currentUser != null && question.AuthorId == currentUser.Id;
    }

    private bool IsAssignedMember(Question question)
    {
        return currentUser != null && question.AssignedMemberId == currentUser.Id;
    }

    private bool CanReplyToQuestion(Question question)
    {
        if (currentUser == null) return false;

        // If awaiting user reply, only author can reply
        if (question.IsAwaitingUserReply)
        {
            return IsQuestionAuthor(question);
        }

        // Otherwise, only assigned member can reply (or author if in discussion)
        return IsAssignedMember(question) || (question.Status == QuestionStatus.InDiscussion && IsQuestionAuthor(question));
    }

    private bool CanSubmitQuestion()
    {
        return selectedPosition.HasValue &&
               !string.IsNullOrWhiteSpace(newQuestionModel.AssignedMemberId) &&
               !string.IsNullOrWhiteSpace(newQuestionModel.Content) &&
               newQuestionModel.Content.Length >= 10;
    }

    private void ShowDeleteConfirm(Question question)
    {
        questionToDelete = question;
        showDeleteConfirm = true;
    }

    private async Task ConfirmDelete()
    {
        if (questionToDelete != null && currentUser != null)
        {
            await QuestionService.DeleteAsync(questionToDelete.Id, currentUser.Id);
            questionToDelete = null;
            
            if (selectedQuestion != null)
            {
                Navigation.NavigateTo("/questions");
            }
            else
            {
                await LoadQuestionsAsync();
            }
            StateHasChanged();
        }
    }

    private void ShowReminderConfirm()
    {
        showReminderConfirm = true;
    }

    private async Task SendReminder()
    {
        if (selectedQuestion != null && currentUser != null)
        {
            await QuestionService.SendManualReminderAsync(selectedQuestion.Id, currentUser.Id);
        }
    }

    private async Task HandleSearch(string term)
    {
        searchTerm = term;
        currentPage = 1;
        await LoadQuestionsAsync();
    }

    private async Task HandlePageChange(int newPage)
    {
        currentPage = newPage;
        await LoadQuestionsAsync();
    }

    private async Task HandlePageSizeChange(int newPageSize)
    {
        pageSize = newPageSize;
        currentPage = 1;
        await LoadQuestionsAsync();
    }

    // Watch for position selection changes
    private Position? _lastPosition;
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (selectedPosition != _lastPosition)
        {
            _lastPosition = selectedPosition;
            await LoadMembersWithPositionAsync();
            StateHasChanged();
        }
    }

    private class NewQuestionModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "A pergunta é obrigatória")]
        [System.ComponentModel.DataAnnotations.MinLength(10, ErrorMessage = "A pergunta deve ter pelo menos 10 caracteres")]
        public string Content { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Selecione um membro")]
        public string AssignedMemberId { get; set; } = string.Empty;
    }
}
