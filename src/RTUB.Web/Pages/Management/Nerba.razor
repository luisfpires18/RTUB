@page "/nerba"
@page "/nerba/{ReportId:int}"
@rendermode InteractiveServer
@using RTUB.Application.Interfaces
@using RTUB.Core.Entities
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using RTUB.Shared
@using RTUB.Shared.Base
@inject INerbaOrderService NerbaOrderService
@inject NavigationManager NavigationManager

<div class="page-header-centered mb-4">
    <div class="page-header-left d-none d-xl-flex">
        <button class="btn btn-outline-light btn-sm" @onclick="GoBack">
            <i class="bi bi-arrow-left"></i>
        </button>
    </div>
    <div class="page-header-center">
        <h1><i class="bi bi-basket"></i> Nerba</h1>
        <p class="page-header-subtitle">Encomendas de material.</p>
    </div>
    <div class="page-header-right d-none d-xl-flex">
        <AuthorizeView Roles="Mod,Admin">
            <Authorized>
                <button class="btn btn-success"
                        @onclick="OpenAddModal"
                        title="Adicionar Encomenda Nerba">
                    <i class="bi bi-plus-lg"></i> <span class="btn-text">Adicionar Encomenda</span>
                </button>
            </Authorized>
        </AuthorizeView>
    </div>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle"></i> @errorMessage
        <button type="button" class="btn-close" @onclick="@(() => errorMessage = "")"></button>
    </div>
}

@if (isLoading)
{
    <LoadingSpinner Message="A carregar encomendas..." />
}
else if (!orders.Any())
{
    <EmptyState Title="Nenhuma encomenda registada"
                Message="Não existem encomendas Nerba."
                Icon="bi-inbox" />
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th style="width: 12%;">Data</th>
                        <th style="width: 30%;">Item</th>
                        <th style="width: 10%;">Quantidade</th>
                        <th style="width: 12%;">Preço/Un.</th>
                        <th style="width: 12%;">Total</th>
                        <th style="width: 18%;">Notas</th>
                        <th style="width: 6%;">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in orders)
                    {
                        var totalPrice = order.Stock * order.PricePerUnit;
                        <tr>
                            <td>@order.Date.ToString("dd/MM/yyyy")</td>
                            <td>@order.Item</td>
                            <td class="text-end">@order.Stock</td>
                            <td class="text-end">€ @order.PricePerUnit.ToString("F2")</td>
                            <td class="text-end"><strong>€ @totalPrice.ToString("F2")</strong></td>
                            <td>@(string.IsNullOrEmpty(order.Notes) ? "-" : order.Notes)</td>
                            <td>
                                <AuthorizeView Roles="Mod,Admin">
                                    <Authorized>
                                        <button class="btn btn-sm btn-outline-primary"
                                                @onclick="@(() => OpenEditModal(order))"
                                                title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger"
                                                @onclick="@(() => ConfirmDelete(order))"
                                                title="Eliminar">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </Authorized>
                                </AuthorizeView>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="table-active">
                        <td colspan="4" class="text-end"><strong>Total:</strong></td>
                        <td class="text-end"><strong>€ @orders.Sum(o => o.Stock * o.PricePerUnit).ToString("F2")</strong></td>
                        <td colspan="2"></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
}

<!-- Add/Edit Modal -->
@if (showModal && editingOrder != null)
{
    <Modal Show="@showModal"
           ShowChanged="@((bool show) => { if (!show) showModal = false; })"
           Title="@(editingOrder.Id > 0 ? "Editar Encomenda Nerba" : "Adicionar Encomenda Nerba")"
           Size="Modal.ModalSize.Large">
        <BodyContent>
            <div class="form-group mb-3">
                <label for="orderDate" class="form-label">Data</label>
                <input type="date" class="form-control" id="orderDate"
                       @bind="editingOrder.Date" />
            </div>
            <div class="form-group mb-3">
                <label for="orderItem" class="form-label">Item</label>
                <input type="text" class="form-control" id="orderItem"
                       placeholder="Descrição do item..." @bind="editingOrder.Item" />
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label for="orderStock" class="form-label">Quantidade</label>
                        <input type="number" class="form-control" id="orderStock"
                               min="0" @bind="editingOrder.Stock" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label for="orderPrice" class="form-label">Preço/Unidade (€)</label>
                        <input type="number" class="form-control" id="orderPrice"
                               step="0.01" min="0" @bind="editingOrder.PricePerUnit" />
                    </div>
                </div>
            </div>
            <div class="form-group mb-3">
                <label for="orderNotes" class="form-label">Notas</label>
                <textarea class="form-control" id="orderNotes" rows="3"
                          placeholder="Observações opcionais..." @bind="editingOrder.Notes"></textarea>
            </div>
        </BodyContent>
        <FooterContent>
            <button type="button" class="btn btn-secondary" @onclick="@(() => showModal = false)">Cancelar</button>
            <button type="button" class="btn btn-primary" @onclick="SaveOrder" disabled="@isSaving">
                @if (isSaving)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                }
                Guardar
            </button>
        </FooterContent>
    </Modal>
}

<!-- Delete Confirmation -->
@if (showDeleteConfirm)
{
    <ConfirmDialog Show="@showDeleteConfirm"
                   ShowChanged="@((bool v) => showDeleteConfirm = v)"
                   Title="Eliminar Encomenda Nerba"
                   Message="Tem a certeza que deseja eliminar esta encomenda? Esta ação é irreversível."
                   ConfirmText="Eliminar"
                   CancelText="Cancelar"
                   ConfirmButtonClass="btn-danger"
                   OnConfirm="ConfirmDeleteOrder"
                   OnCancel="@(() => showDeleteConfirm = false)" />
}

@code {
    [Parameter]
    public int? ReportId { get; set; }

    private List<NerbaOrder> orders = new();
    private string errorMessage = string.Empty;
    private bool isLoading = false;
    private bool isSaving = false;
    private bool showModal = false;
    private bool showDeleteConfirm = false;
    private NerbaOrder? editingOrder;
    private NerbaOrder? deleteTarget;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrders();
    }

    private async Task LoadOrders()
    {
        isLoading = true;
        try
        {
            orders = ReportId.HasValue
                ? await NerbaOrderService.GetByReportIdAsync(ReportId.Value)
                : await NerbaOrderService.GetAllAsync();
            errorMessage = string.Empty;
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro ao carregar encomendas: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenAddModal()
    {
        editingOrder = new NerbaOrder
        {
            Date = DateTime.UtcNow,
            ReportId = ReportId ?? null
        };
        showModal = true;
    }

    private void OpenEditModal(NerbaOrder order)
    {
        editingOrder = new NerbaOrder
        {
            Id = order.Id,
            Date = order.Date,
            Item = order.Item,
            Stock = order.Stock,
            PricePerUnit = order.PricePerUnit,
            Notes = order.Notes,
            ReportId = order.ReportId
        };
        showModal = true;
    }

    private async Task SaveOrder()
    {
        if (editingOrder == null || string.IsNullOrWhiteSpace(editingOrder.Item) || editingOrder.Stock <= 0 || editingOrder.PricePerUnit < 0)
        {
            errorMessage = "Preencha todos os campos obrigatórios.";
            return;
        }

        isSaving = true;
        try
        {
            var result = editingOrder.Id > 0
                ? await NerbaOrderService.UpdateOrderAsync(editingOrder)
                : await NerbaOrderService.AddOrderAsync(editingOrder);

            if (result.Success)
            {
                showModal = false;
                await LoadOrders();
                errorMessage = string.Empty;
            }
            else
            {
                errorMessage = result.Message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro ao guardar: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ConfirmDelete(NerbaOrder order)
    {
        deleteTarget = order;
        showDeleteConfirm = true;
    }

    private async Task ConfirmDeleteOrder()
    {
        if (deleteTarget == null) return;

        showDeleteConfirm = false;
        try
        {
            var result = await NerbaOrderService.DeleteOrderAsync(deleteTarget.Id);
            if (result.Success)
            {
                await LoadOrders();
                errorMessage = string.Empty;
            }
            else
            {
                errorMessage = result.Message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro ao eliminar: {ex.Message}";
        }
    }

    private void GoBack()
    {
        if (ReportId.HasValue)
        {
            NavigationManager.NavigateTo($"/reports/{ReportId}");
        }
        else
        {
            NavigationManager.NavigateTo("/");
        }
    }
}
