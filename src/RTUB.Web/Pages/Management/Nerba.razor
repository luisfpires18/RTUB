@page "/nerba"
@page "/nerba/{ReportId:int}"
@rendermode InteractiveServer
@using RTUB.Application.Interfaces
@using RTUB.Core.Entities
@using RTUB.Core.Enums
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using RTUB.Shared
@using RTUB.Shared.Base
@using RTUB.Shared.Components.Cards
@inject INerbaOrderService NerbaOrderService
@inject IEventService EventService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<Nerba> Logger

<div class="page-header-centered mb-4">
    <div class="page-header-left d-none d-xl-flex">
        <button class="btn btn-outline-light btn-sm" @onclick="GoBack">
            <i class="bi bi-arrow-left"></i>
        </button>
    </div>
    <div class="page-header-center">
        <h1><i class="bi bi-basket"></i> Encomendas Nerba</h1>
        <p class="page-header-subtitle">Registo de encomendas de material por evento.</p>
    </div>
    <div class="page-header-right d-none d-xl-flex">
    </div>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle"></i> @errorMessage
        <button type="button" class="btn-close" @onclick="@(() => errorMessage = "")"></button>
    </div>
}

@if (isLoading)
{
    <LoadingSpinner Message="A carregar encomendas..." />
}
else if (hasError)
{
    @* Error already shown in the alert above â€” don't also show empty state *@
}
else if (!futureItems.Any() && !pastItems.Any())
{
    <EmptyState Title="Nenhuma encomenda registada"
                Message="Não existem eventos Nerba."
                Icon="bi-inbox" />
}
else
{
    @if (futureItems.Any())
    {
        <h5 class="text-muted mb-3"><i class="bi bi-calendar-event me-2"></i>Próximos Eventos</h5>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3 mb-4">
            @foreach (var item in futureItems)
            {
                <div class="col" @key="item.Event.Id">
                    <NerbaOrderCard Event="@item.Event"
                                    OrderCount="@item.Count"
                                    TotalAmount="@item.Total"
                                    CanEdit="@canEdit"
                                    OnDelete="@((Event e) => ConfirmDeleteEntry(e))"
                                    OnViewDetails="@((Event e) => NavigateToDetail(e))" />
                </div>
            }
        </div>
    }

    @if (pastItems.Any())
    {
        <h5 class="text-muted mb-3"><i class="bi bi-clock-history me-2"></i>Eventos Passados</h5>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3 mb-4">
            @foreach (var item in pastItems)
            {
                <div class="col" @key="item.Event.Id">
                    <NerbaOrderCard Event="@item.Event"
                                    OrderCount="@item.Count"
                                    TotalAmount="@item.Total"
                                    CanEdit="@canEdit"
                                    OnDelete="@((Event e) => ConfirmDeleteEntry(e))"
                                    OnViewDetails="@((Event e) => NavigateToDetail(e))" />
                </div>
            }
        </div>
    }
}

<!-- Delete Confirmation -->
@if (showDeleteConfirm)
{
    <ConfirmDialog Show="@showDeleteConfirm"
                   ShowChanged="@((bool v) => showDeleteConfirm = v)"
                   Title="Eliminar Encomendas"
                   Message="@deleteConfirmMessage"
                   ConfirmText="Eliminar"
                   CancelText="Cancelar"
                   ConfirmButtonClass="btn-danger"
                   OnConfirm="ConfirmDeleteOrder"
                   OnCancel="@(() => showDeleteConfirm = false)" />
}

<!-- Mobile Bottom Nav -->
<MobileBottomNav Items="@mobileNavItems" ActiveKey="" OnSelect="HandleMobileNavSelect" />

@code {
    [Parameter]
    public int? ReportId { get; set; }

    private List<DisplayItem> futureItems = new();
    private List<DisplayItem> pastItems = new();
    private string errorMessage = string.Empty;
    private string deleteConfirmMessage = string.Empty;
    private bool isLoading = false;
    private bool hasError = false;
    private bool showDeleteConfirm = false;
    private bool canEdit = false;
    private Event? deleteTarget;
    private IReadOnlyList<MobileBottomNav.MobileNavItem> mobileNavItems = Array.Empty<MobileBottomNav.MobileNavItem>();

    private record DisplayItem(Event Event, int Count, decimal Total);

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadData(), CheckAuthorization());
        BuildMobileNavItems();
    }

    private void BuildMobileNavItems()
    {
        var items = new List<MobileBottomNav.MobileNavItem>();
        items.Add(new("action-back", "Voltar", "bi-arrow-left"));
        mobileNavItems = items;
    }

    private void HandleMobileNavSelect(string key)
    {
        switch (key)
        {
            case "action-back": GoBack(); break;
        }
    }

    private void NavigateToDetail(Event ev) =>
        NavigationManager.NavigateTo($"/nerba/event/{ev.Id}");

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            var eventsTask = EventService.GetEventsByTypeAsync(EventType.Nerba);
            var ordersTask = NerbaOrderService.GetAllAsync();
            await Task.WhenAll(eventsTask, ordersTask);

            var events = eventsTask.Result.ToList();
            var orders = ordersTask.Result;

            var today = DateTime.Today;
            var allItems = events
                .Select(ev => new DisplayItem(
                    ev,
                    orders.Count(o => o.EventId == ev.Id),
                    orders.Where(o => o.EventId == ev.Id).Sum(o => o.Stock * o.PricePerUnit)))
                .ToList();

            // Future/today: nearest first; Past: most recent first
            futureItems = allItems
                .Where(d => (d.Event.EndDate?.Date ?? d.Event.Date.Date) >= today)
                .OrderBy(d => d.Event.Date)
                .ToList();

            pastItems = allItems
                .Where(d => (d.Event.EndDate?.Date ?? d.Event.Date.Date) < today)
                .OrderByDescending(d => d.Event.Date)
                .ToList();

            errorMessage = string.Empty;
            hasError = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadData failed");
            errorMessage = "Erro ao carregar dados. Tente novamente.";
            hasError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CheckAuthorization()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            canEdit = authState.User.IsInRole("Mod") || authState.User.IsInRole("Admin");
        }
        catch
        {
            canEdit = false;
        }
    }

    private void ConfirmDeleteEntry(Event ev)
    {
        deleteTarget = ev;
        deleteConfirmMessage = $"Tem a certeza que deseja eliminar todas as encomendas do evento \"{ev.Name}\"? Esta aÃ§Ã£o Ã© irreversÃ­vel.";
        showDeleteConfirm = true;
    }

    private async Task ConfirmDeleteOrder()
    {
        if (deleteTarget == null) return;

        showDeleteConfirm = false;
        try
        {
            var result = await NerbaOrderService.DeleteByEventIdAsync(deleteTarget.Id);
            if (result.Success)
            {
                await LoadData();
                errorMessage = string.Empty;
            }
            else
            {
                errorMessage = result.Message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro ao eliminar: {ex.Message}";
        }
    }

    private void GoBack()
    {
        if (ReportId.HasValue)
            NavigationManager.NavigateTo($"/finance/report/{ReportId}");
        else
            NavigationManager.NavigateTo("/");
    }
}
