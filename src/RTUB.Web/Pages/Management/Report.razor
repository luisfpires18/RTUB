@page "/finance/report/{ReportId:int}"
@namespace RTUB.Pages.Member
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Identity
@using RTUB.Application.Interfaces
@using RTUB.Application.Extensions
@using RTUB.Core.Enums
@using RTUB.Shared
@using ReportEntity = RTUB.Core.Entities.Report
@attribute [Authorize]
@inject IReportService ReportService
@inject IActivityService ActivityService
@inject ITransactionService TransactionService
@inject IMemberDebtService MemberDebtService
@inject IFiscalYearService FiscalYearService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager

@if (report == null)
{
    <p>A carregar...</p>
}
else
{
    
    <div class="d-flex flex-column gap-3 mb-4">
        <div class="page-header-centered">
            <div class="page-header-left">
                <button class="btn btn-outline-light btn-sm" @onclick="GoBack">
                    <i class="bi bi-arrow-left"></i>
                </button>
            </div>

            <div class="page-header-center">
                <h1 class="mb-1">@report.Title</h1>
                <p class="text-light-theme mb-0">Ano Letivo: @report.Year</p>
            </div>

            <div class="page-header-right">
                <button class="btn btn-success" @onclick="ViewCalotes" title="Ver Calotes">
                    <i class="bi bi-cash-coin"></i> Ver Calotes
                </button>
            </div>
        </div>

        @if (report.IsPublished)
        {
            <div class="alert alert-warning mb-0">
                <i class="bi bi-lock"></i> <strong>Relatório Publicado - Somente Leitura</strong>
                <p class="mb-0">Este relatório foi publicado e não pode ser modificado.</p>
            </div>
        }

        @if (!string.IsNullOrEmpty(report.Summary))
        {
            <div class="alert alert-info identity-alert-info mb-0">
                @report.Summary
            </div>
        }
    </div>

<!-- Summary Cards - 3x2 Grid -->
<div class="summary-cards-container mb-4">
    <div class="row g-2">
        <div class="col-6 col-md-4">
            <div class="card text-center summary-card">
                <div class="card-body py-2">
                    <small class="card-title d-block mb-1 text-light-theme">Receitas</small>
                    <h5 class="text-success mb-0">€@totalIncome.ToString("N2")</h5>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4">
            <div class="card text-center summary-card">
                <div class="card-body py-2">
                    <small class="card-title d-block mb-1 text-light-theme">Despesas</small>
                    <h5 class="text-danger mb-0">€@totalExpenses.ToString("N2")</h5>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4">
            <div class="card text-center summary-card">
                <div class="card-body py-2">
                    <small class="card-title d-block mb-1 text-light-theme">Saldo</small>
                    <h5 class="@(balance >= 0 ? "text-success" : "text-danger") mb-0">€@balance.ToString("N2")</h5>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4">
            <div class="card text-center summary-card position-relative">
                @if (CanCreateReports() && !report.IsPublished)
                {
                    <button class="btn btn-sm admin-btn-edit position-absolute" 
                            style="top: 4px; right: 4px; padding: 2px 6px; font-size: 0.7rem;"
                            @onclick="() => OpenBankCashEditModal(true)"
                            title="Editar">
                        <i class="bi bi-pencil"></i>
                    </button>
                }
                <div class="card-body py-2">
                    <small class="card-title d-block mb-1 text-light-theme"><i class="bi bi-bank"></i> Dinheiro no Banco</small>
                    <h5 class="text-success mb-0">€@bankMoney.ToString("N2")</h5>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4">
            <div class="card text-center summary-card position-relative">
                @if (CanCreateReports() && !report.IsPublished)
                {
                    <button class="btn btn-sm admin-btn-edit position-absolute" 
                            style="top: 4px; right: 4px; padding: 2px 6px; font-size: 0.7rem;"
                            @onclick="() => OpenBankCashEditModal(false)"
                            title="Editar">
                        <i class="bi bi-pencil"></i>
                    </button>
                }
                <div class="card-body py-2">
                    <small class="card-title d-block mb-1 text-light-theme"><i class="bi bi-cash-stack"></i> Dinheiro em Caixa</small>
                    <h5 class="text-success mb-0">€@cashMoney.ToString("N2")</h5>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4">
            <div class="card text-center summary-card">
                <div class="card-body py-2">
                    <small class="card-title d-block mb-1 text-light-theme"><i class="bi bi-cash-coin"></i> Calotes</small>
                    <h5 class="text-danger mb-0">€@totalCalotes.ToString("N2")</h5>
                </div>
            </div>
        </div>
    </div>
</div>

  <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-3">
      <h3 class="mb-0">Atividades (@displayedActivitiesCount)</h3>

      @if (!report.IsPublished && CanCreateReports())
      {
          <div class="d-flex gap-2 align-items-center mt-2 mt-md-0">
              <button class="btn btn-success" @onclick="OpenCreateActivityModal" title="Nova Atividade">
                  <i class="bi bi-plus-lg"></i> Nova Atividade
              </button>
          </div>
      }
  </div>

@if (activities == null || displayedActivities == null)
    {
  <p>A carregar atividades...</p>
    }
    else if (!displayedActivities.Any())
    {
        <EmptyState Title="Nenhuma atividade criada ainda."
                        Icon="bi-calendar-event" />
    }
    else
    {
        <style>
            .activity-accordion-button::after {
                display: none;
            }
        </style>

        <div class="accordion" id="activitiesAccordion">
          @foreach (var activity in displayedActivities)
       {
                <div class="accordion-item mb-2">
               <h2 class="accordion-header" id="heading@activity.Id">
                    <div class="accordion-button @(expandedActivityIds.Contains(activity.Id) ? "" : "collapsed") d-flex align-items-center activity-highlight justify-content-between activity-accordion-button"
                         role="button"
                         @onclick="@(() => ToggleAccordion(activity.Id))"
                         aria-expanded="@(expandedActivityIds.Contains(activity.Id) ? "true" : "false")"
                         aria-controls="collapse@activity.Id">
                        <div class="d-flex align-items-center gap-3 flex-grow-1 me-3">
                            <span class="badge @(activity.Balance >= 0 ? "bg-success" : "bg-danger")">
                                Saldo: €@activity.Balance.ToString("N2")
                            </span>
                            <span class="badge bg-secondary">
                                <i class="bi bi-calendar3 me-1"></i>@GetActivityDateDisplay(activity)
                            </span>
                            <span class="text-white-full fw-semibold">@activity.Name</span>
                        </div>
                        <div class="d-flex align-items-center gap-1 flex-shrink-0">
                            @if (!report.IsPublished && CanCreateReports())
                            {
                                <button type="button" class="btn btn-sm btn-light" title="Editar atividade" @onclick:stopPropagation="true" @onclick="() => OpenEditActivityModal(activity)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-danger" title="Eliminar atividade" @onclick:stopPropagation="true" @onclick="() => OpenDeleteActivityModal(activity)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            }
                            <span class="ms-1">
                                <i class="bi @(expandedActivityIds.Contains(activity.Id) ? "bi-chevron-up" : "bi-chevron-down")"></i>
                            </span>
                        </div>
                    </div>
                </h2>
           <div id="collapse@activity.Id" class="accordion-collapse collapse @(expandedActivityIds.Contains(activity.Id) ? "show" : "")" aria-labelledby="heading@activity.Id">
      <div class="accordion-body">
   @if (!string.IsNullOrEmpty(activity.Description))
        {
  <p class="text-light-theme">@activity.Description</p>
    }

<div class="row mb-3 g-3">
   <div class="col-md-6 col-lg-4">
               <small class="text-light-theme">Receitas:</small>
         <h5 class="text-success">€@activity.TotalIncome.ToString("N2")</h5>
         </div>
            <div class="col-md-6 col-lg-4">
   <small class="text-light-theme">Despesas:</small>
    <h5 class="text-danger">€@activity.TotalExpenses.ToString("N2")</h5>
     </div>
        </div>

   <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between mb-2">
       <h6 class="mb-0">Transações</h6>
       @if (!report.IsPublished && CanCreateReports())
       {
           <button class="btn btn-sm btn-success" @onclick="() => OpenCreateTransactionModal(activity.Id)">
               <i class="bi bi-plus"></i> Nova Transação
           </button>
       }
   </div>

         @{
               var activityTransactions = GetActivityTransactions(activity.Id);
  var filteredTransactions = GetFilteredSortedPaginatedTransactions(activity.Id);
     var tableState = GetTableState(activity.Id);
              var totalPages = GetTotalPages(activity.Id);
  var filteredCount = GetFilteredTransactionCount(activity.Id);
            }

        @if (!activityTransactions.Any())
            {
      <p class="text-white-full"><em>Sem transações</em></p>
   }
    else
        {
    <!-- Search Box -->
     <SearchBar Value="@tableState.SearchTerm"
                ValueChanged="@((string term) => tableState.SearchTerm = term)"
                Placeholder="Pesquisar transações..."
                OnSearch="@((string term) => HandleTransactionSearch(activity.Id, term))" />
     @if (!string.IsNullOrWhiteSpace(tableState.SearchTerm))
         {
           <small class="text-muted d-block mb-2">A mostrar @filteredCount de @activityTransactions.Count transações</small>
          }

   @if (filteredCount == 0)
    {
        <EmptyState Title="Nenhuma transação encontrada"
                        Icon="bi-search"
                        Message="Tente ajustar os filtros de pesquisa." />
       }
        else
            {
            <div class="transaction-grid">
                @foreach (var transaction in filteredTransactions)
                {
                    <TransactionCard Transaction="@transaction"
                                     CanEdit="@(!report.IsPublished && CanCreateReports())"
                                     OnViewReceipt="OpenReceiptModal"
                                     OnEdit="OpenEditTransactionModal"
                                     OnDelete="OpenDeleteTransactionModal" />
                }
            </div>

  <!-- Pagination -->
         @if (totalPages > 1)
        {
            <TablePagination CurrentPage="@tableState.CurrentPage"
                            PageSize="@tableState.PageSize"
                            TotalItems="@GetFilteredTransactionCount(activity.Id)"
                            ItemLabel="transações"
                            OnPageChanged="@(page => HandleTransactionPageChange(activity.Id, page))"
                            PageSizeOptions="@(new[] { 10, 20, 30, 40, 50 })"
                            OnPageSizeChanged="@(pageSize => HandleTransactionPageSizeChange(activity.Id, pageSize))" />
         }
 }
         }
   </div>
             </div>
        </div>
      }
        </div>
    }
}

<!-- Activity Create/Edit Modal -->
<Modal Show="@showActivityModal" 
       ShowChanged="@((bool show) => showActivityModal = show)"
       Title="@(isCreateActivityMode ? "Nova Atividade" : "Editar Atividade")" 
       Centered="true"
       ShowCloseButton="true">
    <BodyContent>
      <EditForm Model="editingActivity" OnValidSubmit="SaveActivity">
            <DataAnnotationsValidator />
<ErrorDisplay />

    <div class="mb-3">
                <label class="form-label fw-semibold">
                    <i class="bi bi-kanban text-primary me-2"></i>Nome
                </label>
       <InputText class="form-control" @bind-Value="editingActivity!.Name" placeholder="Inserir nome..." />
            </div>

            <div class="mb-3">
                <div class="form-check form-switch">
                    <input class="form-check-input clickable-row" type="checkbox" id="activityDateRangeToggle"
                           @bind="isActivityDateRange" @bind:after="OnActivityDateRangeToggled" />
                    <label class="form-check-label form-check-label-white-clickable" for="activityDateRangeToggle">
                        Intervalo de Datas (em vez de data única)
                    </label>
                </div>
            </div>

            <div class="row">
                @if (!isActivityDateRange)
                {
                    <div class="col-md-12 mb-3">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-calendar3 text-primary me-2"></i>Data
                        </label>
                        <InputDate class="form-control" @bind-Value="editingActivity!.StartDate" />
                    </div>
                }
                else
                {
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-calendar3 text-primary me-2"></i>Data Início
                        </label>
                        <InputDate class="form-control" @bind-Value="editingActivity!.StartDate" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-calendar-check text-primary me-2"></i>Data Fim (opcional)
                        </label>
                        <InputDate class="form-control" @bind-Value="editingActivity!.EndDate" />
                    </div>
                }
            </div>

<div class="mb-3">
    <label class="form-label fw-semibold">
                    <i class="bi bi-text-paragraph text-primary me-2"></i>Descrição (opcional)
                </label>
                <InputTextArea class="form-control" rows="3" @bind-Value="editingActivity!.Description" />
    </div>

            <div class="d-flex justify-content-end gap-2">
       <button type="button" class="btn btn-secondary" @onclick="CloseActivityModal">Cancelar</button>
     <button type="submit" class="btn btn-success">Guardar</button>
    </div>
        </EditForm>
    </BodyContent>
</Modal>

<!-- Transaction Create/Edit Modal -->
<Modal Show="@showTransactionModal" 
   ShowChanged="@((bool show) => showTransactionModal = show)"
       Title="@(isCreateTransactionMode ? "Nova Transação" : "Editar Transação")" 
       Centered="true"
    ShowCloseButton="true">
    <BodyContent>
        <EditForm Model="editingTransaction" OnValidSubmit="SaveTransaction">
            <DataAnnotationsValidator />
    <ErrorDisplay />

       <div class="mb-3">
           <label class="form-label fw-semibold">
                    <i class="bi bi-calendar3 text-primary me-2"></i>Data
                </label>
           <InputDate class="form-control" @bind-Value="editingTransaction!.Date" />
 </div>

       <div class="mb-3">
         <label class="form-label fw-semibold">
                    <i class="bi bi-text-paragraph text-primary me-2"></i>Descrição
                </label>
    <InputText class="form-control" @bind-Value="editingTransaction!.Description" />
     </div>

            <div class="mb-3">
       <label class="form-label fw-semibold">
                    <i class="bi bi-tag text-primary me-2"></i>Categoria
                </label>
      <InputText class="form-control" @bind-Value="editingTransaction!.Category" placeholder="Inserir categoria..." />
        </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <i class="bi bi-arrow-left-right text-primary me-2"></i>Tipo
                </label>
          <InputSelect class="form-select" @bind-Value="editingTransaction!.Type">
           <option value="Income">Receita</option>
        <option value="Expense">Despesa</option>
        </InputSelect>
  </div>

         <div class="mb-3">
  <label class="form-label fw-semibold">
                    <i class="bi bi-currency-euro text-primary me-2"></i>Valor (€)
                </label>
           <InputNumber class="form-control" @bind-Value="editingTransaction!.Amount" step="0.01" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <i class="bi bi-receipt text-primary me-2"></i>Recibo (opcional)
                </label>
                <div class="localized-file-picker">
                    <InputFile id="receiptFileInput"
                               class="d-none"
                               OnChange="HandleReceiptUpload"
                               accept="image/*,.pdf,application/pdf"
                               aria-label="Escolher recibo" />
                    <label class="btn btn-outline-secondary localized-file-button" for="receiptFileInput">
                        <i class="bi bi-upload me-2"></i>Escolher ficheiro
                    </label>
                    <span class="localized-file-name">@(!string.IsNullOrEmpty(selectedReceiptFileName) ? selectedReceiptFileName : "Nenhum ficheiro escolhido")</span>
                </div>
                <small class="text-muted d-block mt-1">Formatos suportados: imagens (JPG, PNG, etc.) ou PDF. Máx. 10MB.</small>
                
                @if (!string.IsNullOrEmpty(receiptUploadError))
                {
                    <div class="alert alert-danger mt-2 py-2">
                        <i class="bi bi-exclamation-triangle me-1"></i>@receiptUploadError
                    </div>
                }
                
                @if (!isCreateTransactionMode && !string.IsNullOrEmpty(editingTransactionReceiptUrl))
                {
                    <div class="mt-2">
                        <small class="text-muted">Recibo atual:</small>
                        <br />
                        @if (IsReceiptPdf(editingTransactionReceiptUrl))
                        {
                            <a href="@editingTransactionReceiptUrl" target="_blank" class="btn btn-sm btn-outline-primary mt-1">
                                <i class="bi bi-file-pdf me-1"></i>Ver PDF
                            </a>
                        }
                        else
                        {
                            <img src="@editingTransactionReceiptUrl" alt="Recibo atual" class="img-thumbnail mt-1" style="max-height: 150px;" />
                        }
                    </div>
                }
            </div>

            @if (!isCreateTransactionMode && !string.IsNullOrEmpty(editingTransactionReceiptUrl))
            {
                <div class="mb-3 form-check">
                    <input class="form-check-input" type="checkbox" id="deleteReceiptCheckbox" @bind="deleteExistingReceipt" />
                    <label class="form-check-label text-white-full" for="deleteReceiptCheckbox">
                        Remover recibo existente
                    </label>
                </div>
            }

       <div class="d-flex justify-content-end gap-2">
           <button type="button" class="btn btn-secondary" @onclick="CloseTransactionModal">Cancelar</button>
        <button type="submit" class="btn btn-success">Guardar</button>
         </div>
        </EditForm>
    </BodyContent>
</Modal>

<!-- Delete Activity Confirmation Modal -->
<ConfirmDialog Show="@showDeleteActivityModal"
               ShowChanged="@((bool show) => showDeleteActivityModal = show)"
               Title="Confirmar Eliminação"
               Message="@($"Tem certeza que deseja eliminar a atividade {deletingActivity?.Name}?")"
               WarningMessage="Todas as transações associadas serão também eliminadas! Esta ação não pode ser desfeita."
               ConfirmText="Eliminar"
               CancelText="Cancelar"
               ConfirmButtonClass="btn-danger"
               OnConfirm="DeleteActivity"
               OnCancel="CloseDeleteActivityModal" />

<!-- Delete Transaction Confirmation Modal -->
<ConfirmDialog Show="@showDeleteTransactionModal"
               ShowChanged="@((bool show) => showDeleteTransactionModal = show)"
               Title="Confirmar Eliminação"
               Message="Tem certeza que deseja eliminar esta transação?"
               WarningMessage="Esta ação não pode ser desfeita."
               ConfirmText="Eliminar"
               CancelText="Cancelar"
               ConfirmButtonClass="btn-danger"
               OnConfirm="DeleteTransaction"
               OnCancel="CloseDeleteTransactionModal" />

<!-- Receipt Viewer Modal -->
<Modal Show="@showReceiptModal"
       ShowChanged="@((bool show) => showReceiptModal = show)"
       Title="Recibo da Transação"
       Size="Modal.ModalSize.Large"
       Centered="true"
       ShowCloseButton="true">
    <BodyContent>
        @if (!string.IsNullOrEmpty(receiptToView))
        {
            @if (IsReceiptPdf(receiptToView))
            {
                <div class="text-center">
                    <p class="mb-3">O recibo é um ficheiro PDF.</p>
                    <a href="@receiptToView" target="_blank" class="btn btn-primary">
                        <i class="bi bi-file-pdf me-2"></i>Abrir PDF
                    </a>
                </div>
            }
            else
            {
                <div class="text-center">
                    <img src="@receiptToView" alt="Recibo" class="img-fluid" style="max-height: 70vh;" />
                </div>
            }
        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="CloseReceiptModal">Fechar</button>
    </FooterContent>
</Modal>

<!-- Bank/Cash Edit Modal -->
<Modal Show="@showBankCashModal" 
       ShowChanged="@((bool show) => showBankCashModal = show)"
       Title="@(isEditingBank ? "Editar Dinheiro no Banco" : "Editar Dinheiro em Caixa")" 
       Centered="true"
       ShowCloseButton="true">
    <BodyContent>
        <div class="mb-3">
            <label class="form-label fw-semibold">
                <i class="bi @(isEditingBank ? "bi-bank" : "bi-cash-stack") text-primary me-2"></i>Valor (€)
            </label>
            <input type="number" class="form-control" step="0.01" @bind="editingBankCashValue" placeholder="0.00" />
        </div>
        <div class="d-flex justify-content-end gap-2">
            <button type="button" class="btn btn-secondary" @onclick="CloseBankCashModal">Cancelar</button>
            <button type="button" class="btn btn-success" @onclick="SaveBankCashValue">Guardar</button>
        </div>
    </BodyContent>
</Modal>

@code {
    [Parameter]
    public int ReportId { get; set; }

    private ReportEntity? report;
    private List<Activity>? activities;
    private List<Transaction>? allTransactions;

    private bool showActivityModal = false;
    private bool showTransactionModal = false;
    private bool showDeleteActivityModal = false;
    private bool showDeleteTransactionModal = false;
    private bool showReceiptModal = false;

    private bool isCreateActivityMode = false;
    private bool isCreateTransactionMode = false;
    
    // Date range toggle for activity modal
    private bool isActivityDateRange = false;

    private Activity? editingActivity;
    private Transaction? editingTransaction;
    private Activity? deletingActivity;
    private Transaction? deletingTransaction;

    private int currentActivityId = 0;

    // Receipt state variables
    private IBrowserFile? selectedReceiptFile;
    private string? selectedReceiptFileName;
    private string? receiptUploadError;
    private string? receiptToView;
    private bool deleteExistingReceipt = false;
    private string? editingTransactionReceiptUrl;

    // Accordion state - allows multiple activities to be open
    private HashSet<int> expandedActivityIds = new HashSet<int>();

    // Transaction table state per activity
    private Dictionary<int, TransactionTableState> activityTableStates = new Dictionary<int, TransactionTableState>();

    private bool isAdmin = false;
    private bool isOwner = false;
    private bool isMod = false;
    private string currentUserId = "";
    private ApplicationUser? currentAppUser = null;

    private class TransactionTableState
    {
        public string SearchTerm { get; set; } = string.Empty;
        public string SortColumn { get; set; } = "Date";
        public bool SortDescending { get; set; } = true;
        public int CurrentPage { get; set; } = 1;
        public int PageSize { get; set; } = 10;
    }

    private decimal totalIncome => activities?.Sum(a => a.TotalIncome) ?? 0;
    private decimal totalExpenses => activities?.Sum(a => a.TotalExpenses) ?? 0;
    private decimal balance => totalIncome - totalExpenses;
    
    private decimal bankMoney = 0;
    private decimal cashMoney = 0;
    
    // Calotes total
    private decimal totalCalotes = 0;
    
    // Count of displayed activities (excluding hidden ones like BANCO, CAIXA, CALOTES)
    private int displayedActivitiesCount => displayedActivities?.Count ?? 0;
    private List<Activity>? displayedActivities;
    
    // Bank/Cash edit modal state
    private bool showBankCashModal = false;
    private bool isEditingBank = true;
    private decimal editingBankCashValue = 0;
    private Activity? bankActivity = null;
    private Activity? cashActivity = null;

    private void ToggleAccordion(int activityId)
    {
        if (expandedActivityIds.Contains(activityId))
    {
            expandedActivityIds.Remove(activityId); // Close if already open
        }
      else
        {
     expandedActivityIds.Add(activityId); // Open this one (keep others open)
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // Get current user and roles
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        
        if (user.Identity?.IsAuthenticated == true)
        {
            isAdmin = user.IsInRole("Admin");
            isOwner = user.IsInRole("Owner");
            isMod = user.IsInRole("Mod");
            
            var appUser = await UserManager.GetUserAsync(user);
            if (appUser != null)
            {
                currentUserId = appUser.Id;
                currentAppUser = appUser;
            }
        }
        
    report = await ReportService.GetReportByIdAsync(ReportId);
        await LoadTransactions(); // Load transactions FIRST
     await LoadActivities();    // Then load activities (which recalculates totals using transactions)
        await LoadBankAndCashMoney(); // Load bank and cash money values
        await LoadCalotesTotal(); // Load total calotes
  }

    /// <summary>
    /// Determines if the current user can create finance reports.
    /// Admin and Owner: always can create
    /// Mod: can create only if they are part of the Treasury Team (PrimeiroTesoureiro or SegundoTesoureiro position)
    /// </summary>
    private bool CanCreateReports()
    {
        // Admin and Owner always can create
        if (isAdmin || isOwner)
            return true;
        
        // Mod can create only if they are part of the Treasury Team
        if (isMod && currentAppUser != null)
        {
            return currentAppUser.IsTreasuryTeam();
        }
        
        return false;
    }
    
    /// <summary>
    /// Checks if an activity should be hidden from the activities list.
    /// Hidden activities: CALOTES, BANCO, CAIXA (these are displayed in summary boxes)
    /// </summary>
    private static bool IsHiddenActivity(Activity activity)
    {
        var name = activity.Name.ToUpperInvariant();
        return name.Contains("CALOTES") ||
               name.Contains("BANCO") ||
               name.Contains("CAIXA");
    }

    private async Task LoadActivities()
    {
        if (report == null) return;

        var allActivities = await ActivityService.GetActivitiesByReportIdAsync(ReportId);
        activities = allActivities
            .OrderBy(activity => activity.StartDate)
            .ThenBy(activity => activity.EndDate ?? activity.StartDate)
            .ToList();
        
        // Filter out hidden activities for display
        displayedActivities = activities
            .Where(a => !IsHiddenActivity(a))
            .ToList();
    }

    private async Task LoadBankAndCashMoney()
    {
        if (report == null) return;
        
        var allActivities = await ActivityService.GetActivitiesByReportIdAsync(ReportId);
        
        // Look for "DINHEIRO NO BANCO" or "DINHEIRO BANCO" activity
        bankActivity = allActivities.FirstOrDefault(a => 
            a.Name.Equals("DINHEIRO NO BANCO", StringComparison.OrdinalIgnoreCase) ||
            a.Name.Equals("DINHEIRO BANCO", StringComparison.OrdinalIgnoreCase) ||
            a.Name.Contains("BANCO", StringComparison.OrdinalIgnoreCase));
        
        // Look for "DINHEIRO EM CAIXA" or "DINHEIRO CAIXA" activity  
        cashActivity = allActivities.FirstOrDefault(a =>
            a.Name.Equals("DINHEIRO EM CAIXA", StringComparison.OrdinalIgnoreCase) ||
            a.Name.Equals("DINHEIRO CAIXA", StringComparison.OrdinalIgnoreCase) ||
            a.Name.Contains("CAIXA", StringComparison.OrdinalIgnoreCase));
        
        bankMoney = bankActivity?.Balance ?? 0;
        cashMoney = cashActivity?.Balance ?? 0;
    }

    private async Task LoadCalotesTotal()
    {
        if (report == null) return;
        
        // Get the fiscal year for this report
        var fiscalYear = await FiscalYearService.GetFiscalYearByStartYearAsync(report.Year);
        if (fiscalYear == null) return;
        
        // Get all debts for this fiscal year
        var debts = await MemberDebtService.GetDebtsForFiscalYearAsync(fiscalYear.Id);
        totalCalotes = debts.Sum(d => d.AmountOwed);
    }

    private async Task LoadTransactions()
    {
        // Load all transactions (ActivityService already filters by report)
var allActivityTransactions = new List<Transaction>();
        
    // Since we need all transactions for the report, we get them via activities
        var reportActivities = await ActivityService.GetActivitiesByReportIdAsync(ReportId);
        foreach (var activity in reportActivities)
      {
            var activityTransactions = await TransactionService.GetTransactionsByActivityIdAsync(activity.Id);
            allActivityTransactions.AddRange(activityTransactions);
      }
        
        allTransactions = allActivityTransactions.OrderByDescending(t => t.Date).ToList();
    }

    private List<Transaction> GetActivityTransactions(int activityId)
    {
  return allTransactions?.Where(t => t.ActivityId == activityId).ToList() ?? new List<Transaction>();
  }

    private TransactionTableState GetTableState(int activityId)
    {
        if (!activityTableStates.ContainsKey(activityId))
        {
      activityTableStates[activityId] = new TransactionTableState();
    }
 return activityTableStates[activityId];
    }

  private List<Transaction> GetFilteredSortedPaginatedTransactions(int activityId)
    {
    var state = GetTableState(activityId);
        var transactions = GetActivityTransactions(activityId);

        // Filter
        if (!string.IsNullOrWhiteSpace(state.SearchTerm))
  {
     var search = state.SearchTerm.ToLower();
            transactions = transactions
    .Where(t =>
       (t.Description?.ToLower().Contains(search) ?? false) ||
   (t.Category?.ToLower().Contains(search) ?? false))
      .ToList();
        }

        // Sort
        transactions = state.SortColumn switch
        {
            "Date" => state.SortDescending
            ? transactions.OrderByDescending(t => t.Date).ToList()
          : transactions.OrderBy(t => t.Date).ToList(),
            "Description" => state.SortDescending
    ? transactions.OrderByDescending(t => t.Description).ToList()
     : transactions.OrderBy(t => t.Description).ToList(),
            "Category" => state.SortDescending
          ? transactions.OrderByDescending(t => t.Category).ToList()
      : transactions.OrderBy(t => t.Category).ToList(),
    "Type" => state.SortDescending
    ? transactions.OrderByDescending(t => t.Type).ToList()
                : transactions.OrderBy(t => t.Type).ToList(),
          "Amount" => state.SortDescending
        ? transactions.OrderByDescending(t => t.Amount).ToList()
  : transactions.OrderBy(t => t.Amount).ToList(),
        _ => transactions.OrderByDescending(t => t.Date).ToList()
  };

        // Paginate
      return transactions
        .Skip((state.CurrentPage - 1) * state.PageSize)
        .Take(state.PageSize)
            .ToList();
    }

    private void SetSearch(int activityId, string value)
    {
 var state = GetTableState(activityId);
        state.SearchTerm = value;
        state.CurrentPage = 1; // Reset to first page when searching
    }

    private async Task HandleTransactionSearch(int activityId, string searchTerm)
    {
        SetSearch(activityId, searchTerm);
        await Task.CompletedTask;
    }

    private async Task HandleTransactionSort(int activityId, string column)
    {
        ToggleSort(activityId, column);
        await Task.CompletedTask;
    }

    private async Task HandleTransactionPageChange(int activityId, int newPage)
    {
        ChangePage(activityId, newPage);
        await Task.CompletedTask;
    }

    private async Task HandleTransactionPageSizeChange(int activityId, int pageSize)
    {
        ChangePageSize(activityId, pageSize);
        await Task.CompletedTask;
    }

    private void ToggleSort(int activityId, string column)
    {
 var state = GetTableState(activityId);
if (state.SortColumn == column)
        {
            state.SortDescending = !state.SortDescending;
        }
        else
        {
            state.SortColumn = column;
            state.SortDescending = true;
        }
    }

    private void ChangePage(int activityId, int newPage)
    {
        var state = GetTableState(activityId);
  var totalPages = GetTotalPages(activityId);
    if (newPage < 1 || newPage > totalPages) return;
state.CurrentPage = newPage;
    }

    private void ChangePageSize(int activityId, int pageSize)
    {
        var state = GetTableState(activityId);
        if (pageSize <= 0)
        {
            return;
        }

        state.PageSize = pageSize;
        state.CurrentPage = 1;
    }

    private int GetTotalPages(int activityId)
    {
        var state = GetTableState(activityId);
        var transactions = GetActivityTransactions(activityId);

     // Apply search filter to get accurate count
        if (!string.IsNullOrWhiteSpace(state.SearchTerm))
        {
    var search = state.SearchTerm.ToLower();
    transactions = transactions
   .Where(t =>
           (t.Description?.ToLower().Contains(search) ?? false) ||
    (t.Category?.ToLower().Contains(search) ?? false))
   .ToList();
        }

     return transactions.Count > 0
    ? (int)Math.Ceiling(transactions.Count / (double)state.PageSize)
        : 0;
    }

    private int GetFilteredTransactionCount(int activityId)
    {
        var state = GetTableState(activityId);
        var transactions = GetActivityTransactions(activityId);

   if (!string.IsNullOrWhiteSpace(state.SearchTerm))
        {
            var search = state.SearchTerm.ToLower();
 transactions = transactions
      .Where(t =>
          (t.Description?.ToLower().Contains(search) ?? false) ||
       (t.Category?.ToLower().Contains(search) ?? false))
        .ToList();
        }

        return transactions.Count;
    }

