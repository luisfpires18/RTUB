    private string GetActivityDateDisplay(Activity activity)
    {
        if (activity.EndDate.HasValue && activity.EndDate.Value.Date != activity.StartDate.Date)
        {
            // Date range
            return $"{activity.StartDate:dd MMM} - {activity.EndDate.Value:dd MMM yyyy}";
        }
        else
        {
            // Single date
            return activity.StartDate.ToString("dd MMM yyyy");
        }
    }

