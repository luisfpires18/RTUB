    protected override async Task OnInitializedAsync()
    {
        await CheckUserRole();
        environmentName = HostEnvironment.EnvironmentName;
        await LoadData();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && lists.Any())
        {
            await JSRuntime.InvokeVoidAsync("initializeKanbanDragDrop", DotNetObjectReference.Create(this));
        }
    }

    private async Task CheckUserRole()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        isMod = user.IsInRole("Mod");
        isAdmin = user.IsInRole("Admin");
    }

    private async Task LoadData()
    {
        board = await BoardService.GetBoardWithListsAndCardsAsync(BoardId);
        if (board != null)
        {
            lists = board.Lists.ToList();
            
            // Extract all unique labels for filtering
            availableLabels = lists
                .SelectMany(l => l.Cards)
                .SelectMany(c => GetCardLabels(c))
                .Select(l => l.Text)
                .Distinct()
                .OrderBy(l => l)
                .ToList();
            
            // Build card lookup for attachments
            allBoardCards = lists.ToDictionary(
                l => l.Name,
                l => l.Cards.OrderBy(c => c.Position).ToList()
            );
            
            // Load document attachment counts for all cards
            await LoadDocumentAttachmentCounts();
        }
        events = (await EventService.GetAllEventsAsync()).ToList();
        users = await UserManager.Users.AsNoTracking().ToListAsync();
    }
    
    // Load document attachment counts for all cards on the board
    private async Task LoadDocumentAttachmentCounts()
    {
        if (board == null) return;
        
        documentAttachmentCounts.Clear();
        
        try
        {
            // Get all cards from all lists
            var allCards = lists.SelectMany(l => l.Cards).ToList();
            
            // Load attachment counts in parallel
            var tasks = allCards.Select(async card =>
            {
                try
                {
                    var attachments = await CardService.GetCardAttachmentsAsync(card.Id, board.Name, environmentName);
                    return (cardId: card.Id, count: attachments.Count);
                }
                catch
                {
                    return (cardId: card.Id, count: 0);
                }
            });
            
            var results = await Task.WhenAll(tasks);
            
            foreach (var result in results)
            {
                documentAttachmentCounts[result.cardId] = result.count;
            }
        }
        catch
        {
            // Silently fail - attachment counts are not critical
        }
    }

    // Filter cards by label
    private IEnumerable<LogisticsCard> GetFilteredCards(IEnumerable<LogisticsCard> cards)
    {
        var orderedCards = cards.OrderBy(c => c.Position);
        
        if (string.IsNullOrEmpty(selectedLabelFilter))
            return orderedCards;
        
        return orderedCards.Where(c =>
        {
            var labels = GetCardLabels(c);
            return labels.Any(l => l.Text == selectedLabelFilter);
        });
    }

    // List operations
