    private async Task UploadFile()
    {
        if (selectedFile == null || selectedCard == null || board == null) return;

        uploadErrorMessage = null;
        uploadSuccessMessage = null;

        try
        {
            if (selectedFile.Size > MaxFileSize)
            {
                uploadErrorMessage = "O ficheiro é demasiado grande. Tamanho máximo: 10MB";
                return;
            }

            // Validate file type - only allow specific types
            var allowedContentTypes = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
            {
                "application/pdf",
                "application/msword",
                "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
                "application/vnd.ms-excel",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                "text/plain",
                "image/png",
                "image/jpeg",
                "image/jpg"
            };

            if (!allowedContentTypes.Contains(selectedFile.ContentType))
            {
                uploadErrorMessage = "Tipo de ficheiro não suportado. Formatos permitidos: PDF, Word, Excel, TXT, PNG, JPG";
                return;
            }

            var fileName = selectedFile.Name;
            var contentType = selectedFile.ContentType;
            
            // Buffer the file to a MemoryStream to avoid Blazor JSInterop issues with browser streams
            // The browser stream can become stale during async S3 upload operations
            using var memoryStream = new MemoryStream();
            await using (var browserStream = selectedFile.OpenReadStream(MaxFileSize))
            {
                await browserStream.CopyToAsync(memoryStream);
            }
            memoryStream.Position = 0;
            
            await CardService.UploadCardAttachmentAsync(
                selectedCard.Id, 
                board.Name, 
                fileName, 
                memoryStream, 
                contentType, 
                environmentName);

            uploadSuccessMessage = $"Ficheiro '{fileName}' carregado com sucesso!";
            selectedFile = null;
            logisticsFileName = null;
            
            // Reload attachments and board data to update card UI
            documentAttachments = await CardService.GetCardAttachmentsAsync(selectedCard.Id, board.Name, environmentName);
            await LoadData();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            uploadErrorMessage = $"Erro ao carregar ficheiro: {ex.Message}";
        }
    }

