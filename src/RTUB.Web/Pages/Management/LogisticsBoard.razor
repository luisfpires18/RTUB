    // Create Reminder Modal Methods
    private void OpenCreateReminderModal()
    {
        modals.Open(ModalType.CreateReminder);
        selectedReminderCardId = string.Empty;
        selectedReminderFrequency = (int)ReminderFrequency.OneTime;
        nextReminderDate = DateTime.Now.AddDays(1);
        reminderUserSearchTerm = string.Empty;
        selectedReminderUserIds = new List<string>();
        reminderErrorMessage = null;
    }

    private void CloseCreateReminderModal()
    {
        modals.Close(ModalType.CreateReminder);
        reminderErrorMessage = null;
    }

    private void AddReminderUser(string userId)
    {
        if (!selectedReminderUserIds.Contains(userId))
        {
            selectedReminderUserIds.Add(userId);
            reminderUserSearchTerm = string.Empty;
            StateHasChanged();
        }
    }

    private void RemoveReminderUser(string userId)
    {
        selectedReminderUserIds.Remove(userId);
        StateHasChanged();
    }

    private async Task SaveReminder()
    {
        reminderErrorMessage = null;
        
        if (string.IsNullOrEmpty(selectedReminderCardId) || !selectedReminderUserIds.Any())
            return;

        try
        {
            if (!int.TryParse(selectedReminderCardId, out var cardId))
            {
                reminderErrorMessage = "Selecção de cartão inválida. Por favor, selecione um cartão válido.";
                return;
            }
            
            var frequency = (ReminderFrequency)selectedReminderFrequency;
            var targetUserIds = string.Join(",", selectedReminderUserIds);

            await CardService.CreateCardReminderAsync(cardId, frequency, targetUserIds, nextReminderDate);
            
            CloseCreateReminderModal();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            reminderErrorMessage = $"Erro ao criar lembrete: {ex.Message}";
        }
    }
