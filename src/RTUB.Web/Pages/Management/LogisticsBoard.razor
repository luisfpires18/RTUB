@if (modals.IsOpen(ModalType.CreateReminder))
{
    <div class="modal fade show d-block logistics-modal logistics-modal-backdrop" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-bottom border-secondary logistics-modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-bell me-2"></i>Criar Lembrete
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseCreateReminderModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(reminderErrorMessage))
                    {
                        <div class="alert alert-danger mb-3">
                            <i class="bi bi-exclamation-triangle me-2"></i>@reminderErrorMessage
                        </div>
                    }
                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-card-checklist text-primary me-2"></i>Selecionar Cartão
                        </label>
                        <select class="form-select" @bind="selectedReminderCardId">
                            <option value="">-- Selecione um cartão --</option>
                            @if (lists != null)
                            {
                                @foreach (var list in lists.OrderBy(l => l.Position))
                                {
                                    @foreach (var card in list.Cards.OrderBy(c => c.Position))
                                    {
                                        <option value="@card.Id" @key="card.Id">@list.Name - @card.Title</option>
                                    }
                                }
                            }
                        </select>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-clock text-primary me-2"></i>Frequência
                        </label>
                        <select class="form-select" @bind="selectedReminderFrequency">
                            <option value="@((int)ReminderFrequency.OneTime)">Uma vez</option>
                            <option value="@((int)ReminderFrequency.Daily)">Diariamente</option>
                            <option value="@((int)ReminderFrequency.Weekly)">Semanalmente</option>
                        </select>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-calendar text-primary me-2"></i>Primeira Data do Lembrete
                        </label>
                        <input type="datetime-local" class="form-control" @bind="nextReminderDate" />
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-semibold d-flex align-items-center gap-2 mb-1">
                            <i class="bi bi-people text-primary"></i>
                            <span>Utilizadores</span>
                        </label>
                        
                        @* Selected members as chips *@
                        @if (selectedReminderUserIds.Any())
                        {
                            <div class="selected-members-chips mb-2">
                                @foreach (var userId in selectedReminderUserIds.ToList())
                                {
                                    var user = users?.FirstOrDefault(u => u.Id == userId);
                                    if (user != null)
                                    {
                                        <span class="member-chip" title="@($"{user.FirstName} {user.LastName}")">
                                            <img src="@user.ProfilePictureSrc" alt="@user.GetDisplayName()" class="member-chip-avatar" />
                                            <span class="member-chip-name">@user.GetDisplayName()</span>
                                            <button type="button" class="member-chip-remove" @onclick="() => RemoveReminderUser(userId)" title="Remover utilizador" aria-label="Remover @user.GetDisplayName()">
                                                <i class="bi bi-x"></i>
                                            </button>
                                        </span>
                                    }
                                }
                            </div>
                        }
                        
                        <div class="reminder-user-search-container">
                            <input type="text" class="form-control mb-2" placeholder="Pesquisar utilizador por nome ou alcunha..." 
                                   @bind="reminderUserSearchTerm" @bind:event="oninput" />
                        </div>
                        
                        @if (!string.IsNullOrWhiteSpace(reminderUserSearchTerm) && filteredAvailableReminderUsers != null && filteredAvailableReminderUsers.Any())
                        {
                            <div class="member-list member-list-scrollable mb-3 member-list-scrollable-override">
                                @foreach (var user in filteredAvailableReminderUsers.Take(10))
                                {
                                    <div class="member-item p-2 mb-2 border rounded clickable-row" @key="user.Id"
                                         @onclick="() => AddReminderUser(user.Id)">
                                        <div class="d-flex align-items-center">
                                            <img src="@user.ProfilePictureSrc" alt="@user.GetDisplayName()"
                                                 class="member-avatar-small me-2 member-avatar-small-override" />
                                            <div class="flex-grow-1">
                                                @if (!string.IsNullOrEmpty(user.Nickname))
                                                {
                                                    <div><strong>@user.Nickname</strong></div>
                                                    <div class="text-muted small">@user.FirstName @user.LastName</div>
                                                }
                                                else
                                                {
                                                    <div><strong>@user.FirstName @user.LastName</strong></div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else if (!string.IsNullOrWhiteSpace(reminderUserSearchTerm))
                        {
                            <p class="text-muted small">Nenhum utilizador encontrado.</p>
                        }
                    </div>
                </div>
                <div class="modal-footer border-top border-secondary">
                    <button type="button" class="btn btn-secondary" @onclick="CloseCreateReminderModal">
                        <i class="bi bi-x-circle me-2"></i>Cancelar
                    </button>
                    <button type="button" class="btn btn-purple" @onclick="SaveReminder" 
                            disabled="@(string.IsNullOrEmpty(selectedReminderCardId) || !selectedReminderUserIds.Any())">
                        <i class="bi bi-check-circle me-2"></i>Criar Lembrete
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    // Helper classes (private to avoid naming conflicts)
