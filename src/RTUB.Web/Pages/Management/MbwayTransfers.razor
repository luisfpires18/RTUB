@page "/mbway"
@page "/mbway/{ReportId:int}"
@rendermode InteractiveServer
@using RTUB.Application.Interfaces
@using RTUB.Application.Extensions
@using RTUB.Core.Entities
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using RTUB.Shared
@using RTUB.Shared.Base
@using RTUB.Shared.Components.Cards
@using Microsoft.AspNetCore.Components.Forms
@inject IMbwayTransferService MbwayTransferService
@inject NavigationManager NavigationManager
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="page-header-centered mb-4">
    <div class="page-header-left d-none d-xl-flex">
        <button class="btn btn-outline-light btn-sm" @onclick="GoBack">
            <i class="bi bi-arrow-left"></i>
        </button>
    </div>
    <div class="page-header-center">
        <h1><i class="bi bi-phone"></i> MBWAY</h1>
        <p class="page-header-subtitle">Registo de transferências MBWAY.</p>
    </div>
    <div class="page-header-right d-none d-xl-flex">
        <AuthorizeView Roles="Mod,Admin">
            <Authorized>
                <button class="btn btn-purple"
                        @onclick="OpenAddModal"
                        title="Adicionar Transferência MBWAY">
                    <i class="bi bi-plus-lg"></i> <span class="btn-text">Adicionar Transferência</span>
                </button>
            </Authorized>
        </AuthorizeView>
    </div>
</div>

<div class="mb-3 px-3 py-2 rounded" style="background-color: rgba(168, 142, 229, 0.12); border: 1px solid rgba(168, 142, 229, 0.35);">
    <i class="bi bi-info-circle text-purple me-1"></i>
    <span class="text-purple">As transferências MBWAY não são contabilizadas nos totais dos relatórios.</span>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle"></i> @errorMessage
        <button type="button" class="btn-close" @onclick="@(() => errorMessage = "")"></button>
    </div>
}

@if (isLoading)
{
    <LoadingSpinner Message="A carregar transferências..." />
}
else if (!transfers.Any())
{
    <EmptyState Title="Nenhuma transferência registada"
                Message="Não existem transferências MBWAY."
                Icon="bi-inbox" />
}
else
{
    <div class="mb-4">
        <div class="card summary-card">
            <div class="card-body py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted d-block mb-1">Total de Transferências</small>
                        <h4 class="text-success mb-0">€@transfers.Sum(t => t.Amount).ToString("F2")</h4>
                    </div>
                    <div class="text-muted">
                        <i class="bi bi-phone fs-1"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="mb-3">
        <SearchBar @bind-Value="transferSearchTerm"
                   Placeholder="Pesquisar por nome, telefone, descrição..."
                   OnSearch="OnTransferSearch"
                   OnClear="OnTransferSearchClear" />
    </div>

    @if (!filteredTransfers.Any())
    {
        <EmptyState Title="Nenhum resultado"
                    Message="Nenhuma transferência corresponde à pesquisa."
                    Icon="bi-search" />
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3 mb-4">
            @foreach (var transfer in pagedTransfers)
            {
                <div class="col" @key="transfer.Id">
                    <MbwayTransferCard Transfer="@transfer"
                                       CanEdit="@canEdit"
                                       OnEdit="@((MbwayTransfer t) => OpenEditModal(t))"
                                       OnDelete="@((MbwayTransfer t) => ConfirmDelete(t))" />
                </div>
            }
        </div>

        @if (filteredTransfers.Count > pageSize)
        {
            <TablePagination
                CurrentPage="@currentPage"
                PageSize="@pageSize"
                TotalItems="@filteredTransfers.Count"
                ItemLabel="transferências"
                PageSizeOptions="@(new[] { 6, 12, 18, 24 })"
                OnPageChanged="ChangePage"
                OnPageSizeChanged="ChangePageSize" />
        }
    }
}

<!-- Add/Edit Modal -->
@if (showModal && editingTransfer != null)
{
    <Modal Show="@showModal"
           ShowChanged="@((bool show) => { if (!show) showModal = false; })"
           Title="@(editingTransfer.Id > 0 ? "Editar Transferência MBWAY" : "Adicionar Transferência MBWAY")"
           Size="Modal.ModalSize.Large">
        <BodyContent>
            <EditForm @ref="editForm" Model="editingTransfer">
                <DataAnnotationsValidator />
                <ErrorDisplay />
                <div class="form-group mb-3">
                    <label for="transferDate" class="form-label">Data</label>
                    <InputDate class="form-control" id="transferDate" @bind-Value="editingTransfer!.Date" />
                    <ValidationMessage For="@(() => editingTransfer!.Date)" />
                </div>
                <div class="form-group mb-3">
                    <label for="transferAmount" class="form-label">Montante (€)</label>
                    <InputNumber class="form-control" id="transferAmount" @bind-Value="editingTransfer!.Amount" />
                    <ValidationMessage For="@(() => editingTransfer!.Amount)" />
                </div>
                <div class="form-group mb-3">
                    <label class="form-label">Transferir para <span class="text-danger">*</span></label>
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input clickable-row" type="checkbox" id="transferToMemberToggle"
                               @bind="isTransferToMember" @bind:after="OnTransferToModeToggled" />
                        <label class="form-check-label form-check-label-white-clickable" for="transferToMemberToggle">
                            Membro da Tuna
                        </label>
                    </div>
                    @if (!isTransferToMember)
                    {
                        <InputText class="form-control" id="transferTo"
                                   placeholder="Nome do destinatário..."
                                   @bind-Value="editingTransfer!.TransferTo" />
                        <ValidationMessage For="@(() => editingTransfer!.TransferTo)" />
                    }
                    else
                    {
                        <SearchBar @bind-Value="memberSearchTerm"
                                   Placeholder="Pesquisar membro por nome ou alcunha..."
                                   OnSearch="OnMemberSearch"
                                   OnClear="ClearMemberSearch"
                                   Compact="true" />
                        @if (filteredMembers.Any())
                        {
                            <div class="list-group mt-2" style="max-height: 250px; overflow-y: auto; background-color: #1e2030; border-color: rgba(var(--bs-primary-rgb), 0.3);">
                                @foreach (var member in filteredMembers.Take(10))
                                {
                                    <button type="button" class="list-group-item list-group-item-action"
                                            style="background-color: #1e2030; color: #fff; border-color: rgba(255,255,255,0.08);"
                                            @onclick="@(() => SelectMember(member))">
                                        <div class="d-flex align-items-center">
                                            <img src="@member.ProfilePictureSrc" alt="@member.GetDisplayName()"
                                                 class="rounded-circle me-2" style="width: 32px; height: 32px; object-fit: cover;" />
                                            <div>
                                                <strong>@(member.Nickname ?? member.UserName)</strong>
                                                @if (!string.IsNullOrEmpty(member.FirstName))
                                                {
                                                    <br />
                                                    <small class="text-muted">@member.FirstName @member.LastName</small>
                                                }
                                            </div>
                                        </div>
                                    </button>
                                }
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(editingTransfer?.MemberUserId))
                        {
                            <div class="mt-2 mb-0 px-3 py-2 rounded" style="background-color: rgba(168, 142, 229, 0.15); border: 1px solid rgba(168, 142, 229, 0.4);">
                                <i class="bi bi-person-check text-purple me-1"></i>
                                <strong class="text-purple">Membro selecionado:</strong>
                                <span>@GetMemberName(editingTransfer.MemberUserId)</span>
                            </div>
                        }
                    }
                </div>
                <div class="form-group mb-3">
                    <label for="transferFrom" class="form-label">Transferido por</label>
                    <InputText class="form-control" id="transferFrom"
                               placeholder="Remetente (opcional)..."
                               @bind-Value="editingTransfer!.TransferFrom" />
                </div>
                <div class="form-group mb-3">
                    <label for="transferPhone" class="form-label">Telefone</label>
                    <InputText class="form-control" id="transferPhone" @bind-Value="editingTransfer!.Phone" />
                </div>
                <div class="form-group mb-3">
                    <label for="transferDescription" class="form-label">Descrição</label>
                    <InputTextArea class="form-control" id="transferDescription" rows="3"
                                   placeholder="Notas opcionais..." @bind-Value="editingTransfer!.Description" />
                </div>
            </EditForm>
        </BodyContent>
        <FooterContent>
            <button type="button" class="btn btn-secondary" @onclick="@(() => showModal = false)">Cancelar</button>
            <button type="button" class="btn btn-primary" @onclick="SaveTransfer" disabled="@isSaving">
                @if (isSaving)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                }
                Guardar
            </button>
        </FooterContent>
    </Modal>
}

<!-- Delete Confirmation -->
@if (showDeleteConfirm)
{
    <ConfirmDialog Show="@showDeleteConfirm"
                   ShowChanged="@((bool v) => showDeleteConfirm = v)"
                   Title="Eliminar Transferência MBWAY"
                   Message="Tem a certeza que deseja eliminar esta transferência? Esta ação é irreversível."
                   ConfirmText="Eliminar"
                   CancelText="Cancelar"
                   ConfirmButtonClass="btn-danger"
                   OnConfirm="ConfirmDeleteTransfer"
                   OnCancel="@(() => showDeleteConfirm = false)" />
}

<!-- Mobile Bottom Nav -->
<MobileBottomNav Items="@mobileNavItems" ActiveKey="" OnSelect="HandleMobileNavSelect" />

@code {
    [Parameter]
    public int? ReportId { get; set; }

    private List<MbwayTransfer> transfers = new();
    private List<ApplicationUser> allMembers = new();
    private List<ApplicationUser> filteredMembers = new();
    private string memberSearchTerm = string.Empty;
    private string errorMessage = string.Empty;
    private bool isLoading = false;
    private bool isSaving = false;
    private bool showModal = false;
    private bool showDeleteConfirm = false;
    private bool isTransferToMember = false;
    private bool canAdd = false;
    private bool canEdit = false;
    private List<string> debugRoles = new();
    private MbwayTransfer? editingTransfer;
    private MbwayTransfer? deleteTarget;
    private EditForm? editForm;
    private int currentPage = 1;
    private int pageSize = 12;
    private IReadOnlyList<MobileBottomNav.MobileNavItem> mobileNavItems = Array.Empty<MobileBottomNav.MobileNavItem>();

    private string transferSearchTerm = string.Empty;

    private List<MbwayTransfer> filteredTransfers => string.IsNullOrWhiteSpace(transferSearchTerm)
        ? transfers
        : transfers.Where(t =>
            (t.TransferTo.Contains(transferSearchTerm, StringComparison.OrdinalIgnoreCase)) ||
            (t.TransferFrom?.Contains(transferSearchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (t.Member?.Nickname?.Contains(transferSearchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (t.Member?.UserName?.Contains(transferSearchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (t.Member?.FirstName?.Contains(transferSearchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (t.Member?.LastName?.Contains(transferSearchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (t.Phone?.Contains(transferSearchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (t.Description?.Contains(transferSearchTerm, StringComparison.OrdinalIgnoreCase) ?? false))
        .ToList();

    private List<MbwayTransfer> pagedTransfers => filteredTransfers
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadTransfers(), LoadMembers(), CheckAuthorization());
        BuildMobileNavItems();
    }

    private void BuildMobileNavItems()
    {
        var items = new List<MobileBottomNav.MobileNavItem>();
        if (canAdd)
            items.Add(new("action-add", "Adicionar", "bi-plus-lg"));
        items.Add(new("action-back", "Voltar", "bi-arrow-left"));
        mobileNavItems = items;
    }

    private void HandleMobileNavSelect(string key)
    {
        switch (key)
        {
            case "action-add":
                OpenAddModal();
                break;
            case "action-back":
                GoBack();
                break;
        }
    }

    private async Task LoadTransfers()
    {
        isLoading = true;
        try
        {
            transfers = await MbwayTransferService.GetAllAsync();
            errorMessage = string.Empty;
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro ao carregar transferências: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadMembers()
    {
        try
        {
            allMembers = (await UserManager.Users.ToListAsync()).ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro ao carregar membros: {ex.Message}";
        }
    }

    private async Task CheckAuthorization()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            debugRoles = new[] { "Owner", "Admin", "Mod", "Member" }.Where(user.IsInRole).ToList();
            canAdd = user.IsInRole("Mod") || user.IsInRole("Admin");
            canEdit = user.IsInRole("Owner");
        }
        catch
        {
            canEdit = false;
        }
    }

    private string GetMemberDisplayName(MbwayTransfer transfer)
    {
        if (transfer.Member is not null)
            return transfer.Member.Nickname ?? transfer.Member.UserName ?? "\u2014";
        return transfer.TransferTo;
    }

    private string GetMemberName(string? memberId)
    {
        if (string.IsNullOrEmpty(memberId)) return "\u2014";
        var member = allMembers.FirstOrDefault(m => m.Id == memberId);
        return member?.Nickname ?? member?.UserName ?? "\u2014";
    }

    private void OnMemberSearch(string searchTerm)
    {
        memberSearchTerm = searchTerm;
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            filteredMembers = new();
        }
        else
        {
            filteredMembers = allMembers
                .Where(m => (m.Nickname?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                            (m.UserName?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                            (m.FirstName?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                            (m.LastName?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false))
                .ToList();
        }
    }

    private void ClearMemberSearch()
    {
        memberSearchTerm = string.Empty;
        filteredMembers = new();
    }

    private void SelectMember(ApplicationUser member)
    {
        if (editingTransfer != null)
        {
            editingTransfer.MemberUserId = member.Id;
            editingTransfer.TransferTo = member.Nickname ?? member.UserName ?? string.Empty;
            memberSearchTerm = string.Empty;
            filteredMembers = new();
        }
    }

    private void OnTransferToModeToggled()
    {
        if (editingTransfer == null) return;
        if (!isTransferToMember)
        {
            editingTransfer.MemberUserId = null;
            editingTransfer.TransferTo = string.Empty;
            memberSearchTerm = string.Empty;
            filteredMembers = new();
        }
        else
        {
            editingTransfer.TransferTo = string.Empty;
        }
    }

    private void OpenAddModal()
    {
        editingTransfer = new MbwayTransfer
        {
            Date = DateTime.UtcNow
        };
        isTransferToMember = false;
        memberSearchTerm = string.Empty;
        filteredMembers = new();
        showModal = true;
    }

    private void OpenEditModal(MbwayTransfer transfer)
    {
        editingTransfer = new MbwayTransfer
        {
            Id = transfer.Id,
            Date = transfer.Date,
            Amount = transfer.Amount,
            Phone = transfer.Phone,
            Description = transfer.Description,
            TransferTo = transfer.TransferTo,
            TransferFrom = transfer.TransferFrom,
            MemberUserId = transfer.MemberUserId,
            FiscalYearId = transfer.FiscalYearId
        };
        isTransferToMember = !string.IsNullOrEmpty(transfer.MemberUserId);
        memberSearchTerm = string.Empty;
        filteredMembers = new();
        showModal = true;
    }

    private async Task SaveTransfer()
    {
        if (editingTransfer == null) return;
        if (editForm?.EditContext?.Validate() != true) return;

        isSaving = true;
        try
        {
            var result = editingTransfer.Id > 0
                ? await MbwayTransferService.UpdateTransferAsync(editingTransfer)
                : await MbwayTransferService.AddTransferAsync(editingTransfer);

            if (result.Success)
            {
                showModal = false;
                await LoadTransfers();
                errorMessage = string.Empty;
            }
            else
            {
                errorMessage = result.Message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro ao guardar: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ConfirmDelete(MbwayTransfer transfer)
    {
        deleteTarget = transfer;
        showDeleteConfirm = true;
    }

    private async Task ConfirmDeleteTransfer()
    {
        if (deleteTarget == null) return;

        showDeleteConfirm = false;
        try
        {
            var result = await MbwayTransferService.DeleteTransferAsync(deleteTarget.Id);
            if (result.Success)
            {
                await LoadTransfers();
                errorMessage = string.Empty;
            }
            else
            {
                errorMessage = result.Message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro ao eliminar: {ex.Message}";
        }
    }

    private void OnTransferSearch(string term)
    {
        transferSearchTerm = term;
        currentPage = 1;
    }

    private void OnTransferSearchClear()
    {
        transferSearchTerm = string.Empty;
        currentPage = 1;
    }

    private void ChangePage(int newPage)
    {
        currentPage = newPage;
    }

    private void ChangePageSize(int newPageSize)
    {
        pageSize = newPageSize;
        currentPage = 1;
    }

    private void GoBack()
    {
        if (ReportId.HasValue)
        {
            NavigationManager.NavigateTo($"/finance/report/{ReportId}");
        }
        else
        {
            NavigationManager.NavigateTo("/");
        }
    }
}
