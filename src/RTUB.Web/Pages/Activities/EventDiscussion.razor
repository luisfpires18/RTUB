@page "/events/{eventId:int}/discussion"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Identity
@using RTUB.Application.Extensions
@using RTUB.Application.Interfaces
@using RTUB.Core.Entities
@using RTUB.Shared.Base
@attribute [Authorize]
@inject IEventService EventService
@inject IDiscussionService DiscussionService
@inject IPostService PostService
@inject ICommentService CommentService
@inject IEventDiscussionService EventDiscussionService
@inject IEventAuthorizationService EventAuthorizationService
@inject ITransportationService TransportationService
@inject IMentionService MentionService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation

<PageTitle>Discussão - @(eventItem?.Name ?? "Evento")</PageTitle>

<div class="discussion-page-wrapper">
    @if (eventItem == null)
    {
        <LoadingSpinner />
    }
    else
    {
        <!-- Page Header -->
        <div class="page-header-centered">
            <div class="page-header-left d-none d-xl-flex">
                <button class="btn btn-outline-secondary btn-sm" @onclick="NavigateBack">
                    <i class="bi bi-arrow-left"></i>
                </button>
            </div>

            <div class="page-header-center">
                <h1><i class="bi bi-chat-dots"></i> Discussão</h1>
                <p class="page-header-subtitle">@eventItem.Name</p>
            </div>

            <div class="page-header-right d-none d-xl-flex gap-2">
                @if (canCreatePost)
                {
                    <button class="btn btn-outline-primary" @onclick="OpenCreateTransportModal" title="Oferecer Transporte">
                        <i class="bi bi-car-front"></i> Transporte
                    </button>
                    <button class="btn btn-success" @onclick="OpenCreatePostModal" title="Criar Novo Post">
                        <i class="bi bi-plus-lg"></i> Adicionar Post
                    </button>
                }
            </div>
        </div>

        <!-- Search Bar -->
        <SearchBar @bind-Value="searchTerm"
                   Placeholder="Pesquisar posts por título, conteúdo ou autor..."
                   OnSearch="HandleSearch" />

        <!-- Posts Section -->
        @if (posts == null)
        {
            <LoadingSpinner />
        }
        else if (posts.Count == 0)
        {
            <EmptyState Title="Nenhum post encontrado"
                       Message="@(string.IsNullOrWhiteSpace(searchTerm) ? "Seja o primeiro a iniciar uma discussão sobre este evento!" : "Nenhum resultado encontrado para a sua pesquisa.")"
                       Icon="bi-chat-dots" />
        }
        else
        {
            <div class="posts-list">
                @foreach (var post in posts)
                {
                    var postComments = GetPostComments(post.Id);
                    var commentCount = GetPostCommentCount(post.Id);
                    var isExpanded = expandedPostIds.Contains(post.Id);

                    <div class="post-wrapper mb-3" @key="post.Id">
                        <PostCard Post="@post"
                                 CommentCount="@commentCount"
                                 EventName="@eventItem.Name"
                                 OnClick="@(() => TogglePost(post.Id))"
                                 ShowAuthorControls="@IsAuthor(post)"
                                 ShowAdminControls="@isAdmin"
                                 ShowOwnerControls="@(isOwner && !IsAuthor(post))"
                                 OnEdit="@(() => OpenEditForPost(post))"
                                 OnDelete="@(() => ShowDeletePostConfirm(post))"
                                 OnTogglePin="@(() => TogglePin(post))"
                                 OnToggleLock="@(() => ToggleLock(post))" />

                        @if (isExpanded)
                        {
                            <div class="post-expanded-content">

                                <!-- ── Transport Section (only for transport posts) ── -->
                                @if (post.Transportation != null)
                                {
                                    var t = post.Transportation;
                                    var canManage = currentUser?.Id == post.AuthorId || isAdmin;

                                    <div class="mb-4">
                                        <div class="d-flex align-items-center justify-content-between mb-3">
                                            <h6 class="mb-0"><i class="bi bi-car-front me-2"></i>Transporte — @t.VehicleDescription</h6>
                                            <span class="badge @(t.AvailableSeats > 0 ? "bg-success" : "bg-secondary") small">
                                                @t.OccupiedSeats/@t.TotalSeats lugares
                                            </span>
                                        </div>

                                        <!-- Passengers -->
                                        @if (t.Passengers.Any())
                                        {
                                            @foreach (var p in t.Passengers)
                                            {
                                                <div class="d-flex align-items-center justify-content-between mb-2" @key="p.Id">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <img src="@p.Passenger.ProfilePictureSrc"
                                                             alt="@p.Passenger.GetDisplayName()"
                                                             class="u-w-32 u-h-32 u-of-cover rounded-circle" />
                                                        <span>
                                                            @if (!string.IsNullOrEmpty(p.Passenger.Nickname))
                                                            {
                                                                <strong>@p.Passenger.Nickname</strong>
                                                                <span class="text-muted small ms-1">@p.Passenger.FirstName @p.Passenger.LastName</span>
                                                            }
                                                            else
                                                            {
                                                                <strong>@p.Passenger.FirstName @p.Passenger.LastName</strong>
                                                            }
                                                        </span>
                                                    </div>
                                                    @if (canManage || currentUser?.Id == p.PassengerId)
                                                    {
                                                        <button class="btn btn-sm btn-outline-danger"
                                                                @onclick="() => RemovePassengerFromPost(post, p.PassengerId)"
                                                                title="Remover">
                                                            <i class="bi bi-x"></i>
                                                        </button>
                                                    }
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <p class="text-muted small"><em>Sem membros ainda.</em></p>
                                        }

                                        <!-- Organizer/Admin: assign members by search -->
                                        @if (canManage && t.AvailableSeats > 0)
                                        {
                                            <div class="mt-3">
                                                <SearchBar @bind-Value="passengerSearchTerms[post.Id]"
                                                           Placeholder="Adicionar membro por nome ou alcunha..."
                                                           OnSearch="@(_ => FilterPassengersForPost(post.Id, t))"
                                                           OnClear="@(() => ClearPassengerSearch(post.Id))"
                                                           Compact="true" />
                                                @if (filteredPassengerCandidates.TryGetValue(post.Id, out var candidates) && candidates.Any())
                                                {
                                                    <div class="member-list member-list-scrollable">
                                                        @foreach (var member in candidates.Take(10))
                                                        {
                                                            <div class="member-item p-2 mb-1 border rounded clickable-row" @key="member.Id"
                                                                 @onclick="() => AssignPassengerToPost(post, member.Id)">
                                                                <div class="d-flex align-items-center">
                                                                    <img src="@member.ProfilePictureSrc" alt="@member.GetDisplayName()"
                                                                         class="member-avatar-small me-2" />
                                                                    <div>
                                                                        @if (!string.IsNullOrEmpty(member.Nickname))
                                                                        {
                                                                            <div><strong>@member.Nickname</strong></div>
                                                                            <div class="text-muted small">@member.FirstName @member.LastName</div>
                                                                        }
                                                                        else
                                                                        {
                                                                            <div><strong>@member.FirstName @member.LastName</strong></div>
                                                                        }
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }

                                        @if (transportErrors.TryGetValue(post.Id, out var tErr) && !string.IsNullOrEmpty(tErr))
                                        {
                                            <div class="alert alert-warning mt-2 py-2">@tErr</div>
                                        }
                                    </div>
                                    <hr class="my-3" />
                                }

                                <!-- ── Comments Section ── -->
                                <div class="comments-section">
                                    <h6 class="mb-3">
                                        <i class="bi bi-chat-left-text me-2"></i>Comentários (@commentCount)
                                    </h6>

                                    @if (commentCount == 0)
                                    {
                                        <p class="text-muted"><em>Nenhum comentário ainda.</em></p>
                                    }
                                    else
                                    {
                                        <div class="comments-list mb-3">
                                            @foreach (var comment in postComments)
                                            {
                                                <CommentItem Comment="@comment"
                                                            CanEdit="@(IsCommentAuthor(comment))"
                                                            CanDelete="@(isOwner || IsCommentAuthor(comment))"
                                                            OnEdit="@(async (body) => await EditComment(comment, body))"
                                                            OnDelete="@(() => ShowDeleteCommentConfirm(comment, post.Id))" />
                                            }
                                        </div>
                                    }

                                    @if (!post.IsLocked && canCreatePost)
                                    {
                                        <div class="mt-3">
                                            <CommentComposer OnSubmit="@(async (body) => await CreateComment(post.Id, body))" />
                                        </div>
                                    }
                                    else if (post.IsLocked)
                                    {
                                        <div class="alert alert-warning mt-3 d-flex align-items-center">
                                            <i class="bi bi-lock-fill me-2"></i>
                                            <span>Este post está bloqueado. Não é possível adicionar novos comentários.</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            @if (totalPosts > pageSize)
            {
                <div class="pagination-wrapper mt-4">
                    <TablePagination CurrentPage="@currentPage"
                                    PageSize="@pageSize"
                                    TotalItems="@totalPosts"
                                    ItemLabel="posts"
                                    PageSizeOptions="@(new[] { 20, 50, 100 })"
                                    OnPageChanged="@HandlePageChange"
                                    OnPageSizeChanged="@HandlePageSizeChange" />
                </div>
            }
        }
    }
</div>

<!-- Mobile Bottom Nav -->
<MobileBottomNav Items="@mobileNavItems" ActiveKey="" OnSelect="HandleMobileNavSelect" />

<!-- Create Post Modal -->
<Modal Show="@modals.IsOpen(ModalType.CreatePost)"
       ShowChanged="@((show) => modals.Toggle(ModalType.CreatePost, show))"
       Title="Criar Novo Post"
       Size="Modal.ModalSize.Large"
       Centered="true">
    <BodyContent>
        <PostComposer OnSubmit="@(async (tuple) => await CreatePost(tuple.title, tuple.body, tuple.videos))" />
    </BodyContent>
</Modal>

<!-- Edit Post Modal -->
<Modal Show="@modals.IsOpen(ModalType.EditPost)"
       ShowChanged="@((show) => modals.Toggle(ModalType.EditPost, show))"
       Title="Editar Post"
       Size="Modal.ModalSize.Large"
       Centered="true">
    <BodyContent>
        @if (postToEdit != null)
        {
            <PostComposer Title="@postToEdit.Title"
                         Body="@postToEdit.Body"
                         OnSubmit="@(async (tuple) => await UpdatePost(tuple.Item1, tuple.Item2))" />
        }
    </BodyContent>
</Modal>

<!-- Create / Edit Transport Modal -->
<Modal Show="@modals.IsOpen(ModalType.CreateTransport)"
       ShowChanged="@((show) => { modals.Toggle(ModalType.CreateTransport, show); if (!show) ClearTransportModal(); })"
       Title="@(editingTransportPost == null ? "Oferecer Transporte" : "Editar Transporte")"
       Size="Modal.ModalSize.Large"
       Centered="true">
    <BodyContent>
        <div class="mb-3">
            <label class="form-label">Descrição da Viatura <span class="text-danger">*</span></label>
            <input type="text" class="form-control" maxlength="200"
                   @bind="tVehicleDescription" />
        </div>
        <div class="mb-3">
            <label class="form-label">Nº de Lugares <span class="text-danger">*</span></label>
            <input type="number" class="form-control" min="2" max="20" @bind="tTotalSeats" />
        </div>
        <div class="mb-3">
            <label class="form-label">Notas</label>
            <textarea class="form-control" rows="2" maxlength="500"
                      placeholder="Ex: Saída às 18h, ponto de encontro..."
                      @bind="tNotes"></textarea>
        </div>

        <hr />
        <label class="form-label"><i class="bi bi-people me-1"></i>Membros</label>
        @if (tSelectedPassengers.Count < tTotalSeats)
        {
            <SearchBar @bind-Value="tPassengerSearch"
                       Placeholder="Pesquisar membro por nome ou alcunha..."
                       OnSearch="FilterModalPassengers"
                       OnClear="@(() => { tPassengerSearch = string.Empty; tFilteredPassengers = new(); })"
                       Compact="true" />
        }
        @if (tFilteredPassengers.Any())
        {
            <div class="member-list member-list-scrollable">
                @foreach (var m in tFilteredPassengers.Take(20))
                {
                    <div class="member-item p-2 mb-2 border rounded clickable-row" @key="m.Id"
                         @onclick="() => AddPassengerToModal(m)">
                        <div class="d-flex align-items-center">
                            <img src="@m.ProfilePictureSrc" alt="@m.GetDisplayName()" class="member-avatar-small me-2" />
                            <div>
                                @if (!string.IsNullOrEmpty(m.Nickname))
                                {
                                    <div><strong>@m.Nickname</strong></div>
                                    <div class="text-muted small">@m.FirstName @m.LastName</div>
                                }
                                else
                                {
                                    <div><strong>@m.FirstName @m.LastName</strong></div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        @if (tSelectedPassengers.Any())
        {
            <div class="mt-2">
                @foreach (var p in tSelectedPassengers)
                {
                    <div class="d-flex align-items-center justify-content-between mb-1" @key="p.Id">
                        <div class="d-flex align-items-center gap-2">
                            <img src="@p.ProfilePictureSrc" alt="@p.GetDisplayName()"
                                 class="u-w-28 u-h-28 u-of-cover rounded-circle" />
                            <span>@p.GetDisplayName()</span>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                @onclick="() => tSelectedPassengers.RemoveAll(x => x.Id == p.Id)">
                            <i class="bi bi-x"></i>
                        </button>
                    </div>
                }
            </div>
        }

        @if (!string.IsNullOrEmpty(tModalError))
        {
            <div class="alert alert-danger mt-2">@tModalError</div>
        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary"
                @onclick="() => { modals.Close(ModalType.CreateTransport); ClearTransportModal(); }"
                disabled="@isSaving">
            Cancelar
        </button>
        <button type="button" class="btn btn-success" @onclick="SaveTransportModal" disabled="@isSaving">
            @if (isSaving)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
            }
            Guardar
        </button>
    </FooterContent>
</Modal>

<!-- Delete Post Confirmation -->
<ConfirmDialog Show="@showDeletePostConfirm"
               ShowChanged="@((value) => showDeletePostConfirm = value)"
               Title="Confirmar Eliminação"
               Message="Tem a certeza que deseja eliminar este post? Esta ação não pode ser desfeita."
               ConfirmText="Eliminar"
               CancelText="Cancelar"
               ConfirmButtonClass="btn-danger"
               OnConfirm="ConfirmDeletePost" />

<!-- Delete Comment Confirmation -->
<ConfirmDialog Show="@showDeleteCommentConfirm"
               ShowChanged="@((value) => showDeleteCommentConfirm = value)"
               Title="Confirmar Eliminação"
               Message="Tem a certeza que deseja eliminar este comentário?"
               ConfirmText="Eliminar"
               CancelText="Cancelar"
               ConfirmButtonClass="btn-danger"
               OnConfirm="ConfirmDeleteComment" />

@code {
    [Parameter]
    public int EventId { get; set; }

    private Event? eventItem;
    private Discussion? discussion;
    private List<Post> posts = new();
    private Dictionary<int, List<Comment>> postCommentsCache = new();
    private Dictionary<int, int> postCommentCounts = new();
    private ApplicationUser? currentUser;
    private bool isAdmin = false;
    private bool isOwner = false;
    private bool canCreatePost = false;
    private string searchTerm = string.Empty;
    private int currentPage = 1;
    private int pageSize = 20;
    private int totalPosts = 0;
    private enum ModalType { CreatePost, EditPost, CreateTransport }
    private readonly MultiModalState<ModalType> modals = new();
    private HashSet<int> expandedPostIds = new HashSet<int>();
    private bool showDeletePostConfirm = false;
    private bool showDeleteCommentConfirm = false;
    private Post? postToDelete = null;
    private Post? postToEdit = null;
    private Comment? commentToDelete = null;
    private int commentPostId = 0;

    // Transport modal state
    private Post? editingTransportPost;
    private string tVehicleDescription = string.Empty;
    private int tTotalSeats = 5;
    private string tNotes = string.Empty;
    private string? tModalError;
    private bool isSaving = false;
    private string tPassengerSearch = string.Empty;
    private List<ApplicationUser> tFilteredPassengers = new();
    private List<ApplicationUser> tSelectedPassengers = new();
    private List<ApplicationUser> allMembers = new();

    // Inline passenger search state (per post, for driver use)
    private Dictionary<int, string> passengerSearchTerms = new();
    private Dictionary<int, List<ApplicationUser>> filteredPassengerCandidates = new();
    private Dictionary<int, string?> transportErrors = new();

    // Mobile bottom nav
    private IReadOnlyList<MobileBottomNav.MobileNavItem> mobileNavItems = Array.Empty<MobileBottomNav.MobileNavItem>();

    protected override async Task OnInitializedAsync()
    {
        await LoadEventAsync();
        await LoadCurrentUserAsync();
        await LoadDiscussionAsync();
        await LoadPostsAsync();
        allMembers = (await TransportationService.GetAllMembersAsync()).ToList();
        BuildMobileNavItems();
    }

    private void BuildMobileNavItems()
    {
        var items = new List<MobileBottomNav.MobileNavItem>
        {
            new("action-back", "Voltar", "bi-arrow-left")
        };

        if (canCreatePost)
        {
            items.Add(new("action-transport", "Transporte", "bi-car-front"));
            items.Add(new("action-add", "Adicionar", "bi-plus-lg"));
        }

        mobileNavItems = items;
    }

    private void HandleMobileNavSelect(string key)
    {
        if (key == "action-back") NavigateBack();
        else if (key == "action-transport") OpenCreateTransportModal();
        else if (key == "action-add") OpenCreatePostModal();
    }

    private async Task LoadEventAsync()
    {
        eventItem = await EventService.GetEventByIdAsync(EventId);
    }

    private async Task LoadCurrentUserAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userName = authState.User.Identity?.Name;

        if (!string.IsNullOrEmpty(userName))
        {
            currentUser = await UserManager.FindByNameAsync(userName);
        }

        (isAdmin, isOwner, canCreatePost) = EventAuthorizationService.GetEventDiscussionAuthorization(authState, currentUser);
        canCreatePost = canCreatePost || authState.User.Identity?.IsAuthenticated == true;
    }

    private async Task LoadDiscussionAsync()
    {
        if (eventItem == null) return;
        discussion = await DiscussionService.GetByEventIdAsync(EventId);
    }

    private async Task LoadPostsAsync()
    {
        if (discussion == null) return;

        totalPosts = await PostService.GetCountByDiscussionIdAsync(discussion.Id, searchTerm);
        var loadedPosts = await PostService.GetByDiscussionIdAsync(
            discussion.Id,
            currentPage,
            pageSize,
            searchTerm
        );
        posts = loadedPosts.ToList();

        await LoadCommentCountsForPosts();
    }

    private async Task LoadCommentCountsForPosts()
    {
        if (!posts.Any()) return;

        var postIds = posts.Select(p => p.Id);
        var counts = await EventDiscussionService.GetCommentCountsByPostIdsAsync(postIds) ?? new Dictionary<int, int>();

        foreach (var post in posts)
        {
            postCommentCounts[post.Id] = counts.GetValueOrDefault(post.Id, 0);
        }
    }

    private async Task TogglePost(int postId)
    {
        if (expandedPostIds.Contains(postId))
        {
            expandedPostIds.Remove(postId);
        }
        else
        {
            expandedPostIds.Add(postId);
            passengerSearchTerms.TryAdd(postId, string.Empty);
            filteredPassengerCandidates.TryAdd(postId, new());
            transportErrors.TryAdd(postId, null);
            if (!postCommentsCache.ContainsKey(postId))
            {
                await LoadCommentsForPost(postId);
            }
        }
    }

    private async Task LoadCommentsForPost(int postId)
    {
        var comments = await CommentService.GetByPostIdAsync(postId, 1, 50);
        postCommentsCache[postId] = comments.ToList();
    }

    private List<Comment> GetPostComments(int postId)
        => postCommentsCache.TryGetValue(postId, out var c) ? c : new List<Comment>();

    private int GetPostCommentCount(int postId)
        => postCommentCounts.TryGetValue(postId, out var c) ? c : 0;

    private async Task CreatePost(string title, string body, IReadOnlyList<IBrowserFile> videos)
    {
        if (currentUser == null) return;

        if (discussion == null)
        {
            discussion = await DiscussionService.CreateForEventAsync(EventId);
        }

        var postMentionsJson = await MentionService.ParseAndResolveAsync(body);
        await PostService.CreateAsync(discussion.Id, currentUser.Id, title, body, postMentionsJson, null, videos);
        await LoadPostsAsync();
        modals.Close(ModalType.CreatePost);
        StateHasChanged();
    }

    private async Task CreateComment(int postId, string body)
    {
        if (currentUser == null) return;

        var commentMentionsJson = await MentionService.ParseAndResolveAsync(body);
        await CommentService.CreateAsync(postId, currentUser.Id, body, commentMentionsJson, null);
        await LoadCommentsForPost(postId);

        var count = await CommentService.GetCountByPostIdAsync(postId);
        postCommentCounts[postId] = count;

        var postIndex = posts.FindIndex(p => p.Id == postId);
        if (postIndex >= 0)
        {
            var updatedPost = await PostService.GetByIdAsync(postId);
            if (updatedPost != null) posts[postIndex] = updatedPost;
        }

        StateHasChanged();
    }

    private void OpenCreatePostModal()
        => modals.Open(ModalType.CreatePost);

    private void OpenEditPostModal(Post post)
    {
        postToEdit = post;
        modals.Open(ModalType.EditPost);
    }

    // Opens edit modal depending on whether it's a transport post or regular post
    private void OpenEditForPost(Post post)
    {
        if (post.Transportation != null)
        {
            editingTransportPost = post;
            tVehicleDescription = post.Transportation.VehicleDescription;
            tTotalSeats = post.Transportation.TotalSeats;
            tNotes = post.Transportation.Notes ?? string.Empty;
            tModalError = null;
            tPassengerSearch = string.Empty;
            tFilteredPassengers = new();
            // Pre-populate selected passengers from existing data
            tSelectedPassengers = post.Transportation.Passengers
                .Where(p => p.Passenger != null)
                .Select(p => p.Passenger)
                .ToList();
            modals.Open(ModalType.CreateTransport);
        }
        else
        {
            OpenEditPostModal(post);
        }
    }

    private async Task UpdatePost(string title, string body)
    {
        if (postToEdit == null) return;

        await PostService.UpdateAsync(postToEdit.Id, title, body);
        await LoadPostsAsync();
        modals.Close(ModalType.EditPost);
        postToEdit = null;
        StateHasChanged();
    }

    // ── Transport Modal ──────────────────────────────────────────────────────

    private void OpenCreateTransportModal()
    {
        editingTransportPost = null;
        tVehicleDescription = string.Empty;
        tTotalSeats = 5;
        tNotes = string.Empty;
        tModalError = null;
        tPassengerSearch = string.Empty;
        tFilteredPassengers = new();
        tSelectedPassengers = new();
        modals.Open(ModalType.CreateTransport);
    }

    private void ClearTransportModal()
    {
        editingTransportPost = null;
        tVehicleDescription = string.Empty;
        tTotalSeats = 5;
        tNotes = string.Empty;
        tModalError = null;
        tPassengerSearch = string.Empty;
        tFilteredPassengers = new();
        tSelectedPassengers = new();
    }

    private async Task SaveTransportModal()
    {
        if (string.IsNullOrWhiteSpace(tVehicleDescription))
        {
            tModalError = "A descrição da viatura é obrigatória.";
            return;
        }
        if (tTotalSeats < 2 || tTotalSeats > 20)
        {
            tModalError = "O número de lugares deve estar entre 2 e 20.";
            return;
        }

        isSaving = true;
        tModalError = null;
        try
        {
            if (editingTransportPost != null)
            {
                var transportId = editingTransportPost.Transportation!.Id;

                await TransportationService.UpdateAsync(
                    transportId,
                    tVehicleDescription,
                    tTotalSeats,
                    string.IsNullOrWhiteSpace(tNotes) ? null : tNotes);

                await PostService.UpdateAsync(editingTransportPost.Id, tVehicleDescription,
                    string.IsNullOrWhiteSpace(tNotes) ? "Transporte" : tNotes);

                // Sync passengers: remove those no longer selected, add newly selected
                var currentIds = editingTransportPost.Transportation.Passengers
                    .Select(p => p.PassengerId).ToHashSet();
                var selectedIds = tSelectedPassengers.Select(p => p.Id).ToHashSet();

                foreach (var removed in currentIds.Where(id => !selectedIds.Contains(id)))
                    await TransportationService.RemovePassengerAsync(transportId, removed);

                foreach (var added in tSelectedPassengers.Where(p => !currentIds.Contains(p.Id)))
                {
                    try { await TransportationService.AddPassengerAsync(transportId, added.Id); }
                    catch { }
                }
            }
            else
            {
                // Create post + transportation
                if (discussion == null)
                    discussion = await DiscussionService.CreateForEventAsync(EventId);

                var postBody = string.IsNullOrWhiteSpace(tNotes) ? "Transporte" : tNotes;
                var post = await PostService.CreateAsync(
                    discussion.Id, currentUser!.Id, tVehicleDescription, postBody, null, null, null);

                var transport = await TransportationService.CreateForPostAsync(
                    post.Id, tVehicleDescription, tTotalSeats,
                    string.IsNullOrWhiteSpace(tNotes) ? null : tNotes);

                // Add pre-selected passengers
                foreach (var p in tSelectedPassengers)
                {
                    try { await TransportationService.AddPassengerAsync(transport.Id, p.Id); }
                    catch { /* skip silently if seat limit hit */ }
                }
            }

            modals.Close(ModalType.CreateTransport);
            ClearTransportModal();
            await LoadPostsAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            tModalError = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private void FilterModalPassengers()
    {
        if (string.IsNullOrWhiteSpace(tPassengerSearch))
        {
            tFilteredPassengers = new();
            return;
        }
        var term = tPassengerSearch.Trim().ToLower();
        var selected = tSelectedPassengers.Select(p => p.Id).ToHashSet();
        tFilteredPassengers = allMembers
            .Where(m => !selected.Contains(m.Id))
            .Where(m =>
                (m.FirstName + " " + m.LastName).ToLower().Contains(term) ||
                (!string.IsNullOrEmpty(m.Nickname) && m.Nickname.ToLower().Contains(term)) ||
                (m.UserName != null && m.UserName.ToLower().Contains(term)))
            .ToList();
    }

    private void AddPassengerToModal(ApplicationUser member)
    {
        var available = tTotalSeats - tSelectedPassengers.Count;
        if (available <= 0) return;
        if (!tSelectedPassengers.Any(p => p.Id == member.Id))
            tSelectedPassengers.Add(member);
        tPassengerSearch = string.Empty;
        tFilteredPassengers = new();
    }

    // ── Inline transport passenger management ────────────────────────────────

    private void FilterPassengersForPost(int postId, Transportation transport)
    {
        transportErrors[postId] = null;
        var term = passengerSearchTerms.GetValueOrDefault(postId, string.Empty).Trim().ToLower();
        if (string.IsNullOrWhiteSpace(term))
        {
            filteredPassengerCandidates[postId] = new();
            return;
        }
        var alreadyIn = transport.Passengers.Select(p => p.PassengerId).ToHashSet();
        filteredPassengerCandidates[postId] = allMembers
            .Where(m => !alreadyIn.Contains(m.Id))
            .Where(m =>
                (m.FirstName + " " + m.LastName).ToLower().Contains(term) ||
                (!string.IsNullOrEmpty(m.Nickname) && m.Nickname.ToLower().Contains(term)) ||
                (m.UserName != null && m.UserName.ToLower().Contains(term)))
            .ToList();
    }

    private void ClearPassengerSearch(int postId)
    {
        passengerSearchTerms[postId] = string.Empty;
        filteredPassengerCandidates[postId] = new();
    }

    private async Task AssignPassengerToPost(Post post, string memberId)
    {
        transportErrors[post.Id] = null;
        try
        {
            await TransportationService.AddPassengerAsync(post.Transportation!.Id, memberId);
            ClearPassengerSearch(post.Id);
            var idx = posts.FindIndex(p => p.Id == post.Id);
            if (idx >= 0)
            {
                var fresh = await PostService.GetByIdAsync(post.Id);
                if (fresh != null) posts[idx] = fresh;
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            transportErrors[post.Id] = ex.Message;
        }
    }

    private async Task RemovePassengerFromPost(Post post, string passengerId)
    {
        transportErrors[post.Id] = null;
        try
        {
            await TransportationService.RemovePassengerAsync(post.Transportation!.Id, passengerId);
            var idx = posts.FindIndex(p => p.Id == post.Id);
            if (idx >= 0)
            {
                var fresh = await PostService.GetByIdAsync(post.Id);
                if (fresh != null) posts[idx] = fresh;
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            transportErrors[post.Id] = ex.Message;
        }
    }

    // ── Helpers ──────────────────────────────────────────────────────────────

    private bool IsAuthor(Post post)
        => currentUser != null && post.AuthorId == currentUser.Id;

    private bool IsCommentAuthor(Comment comment)
        => currentUser != null && comment.AuthorId == currentUser.Id;

    private void NavigateBack()
        => Navigation.NavigateTo("/events");

    private async Task HandleSearch(string term)
    {
        searchTerm = term;
        currentPage = 1;
        await LoadPostsAsync();
    }

    private async Task HandlePageChange(int newPage)
    {
        currentPage = newPage;
        await LoadPostsAsync();
    }

    private async Task HandlePageSizeChange(int newPageSize)
    {
        pageSize = newPageSize;
        currentPage = 1;
        await LoadPostsAsync();
    }

    private async Task TogglePin(Post post)
    {
        if (post.IsPinned) await PostService.UnpinAsync(post.Id);
        else await PostService.PinAsync(post.Id);
        await LoadPostsAsync();
    }

    private async Task ToggleLock(Post post)
    {
        if (post.IsLocked) await PostService.UnlockAsync(post.Id);
        else await PostService.LockAsync(post.Id);
        await LoadPostsAsync();
    }

    private void ShowDeletePostConfirm(Post post)
    {
        postToDelete = post;
        showDeletePostConfirm = true;
    }

    private async Task ConfirmDeletePost()
    {
        if (postToDelete != null)
        {
            await PostService.SoftDeleteAsync(postToDelete.Id);
            expandedPostIds.Remove(postToDelete.Id);
            postToDelete = null;
            await LoadPostsAsync();
        }
    }

    private async Task EditComment(Comment comment, string newBody)
    {
        await CommentService.UpdateAsync(comment.Id, newBody);
        await LoadCommentsForPost(comment.PostId);
        StateHasChanged();
    }

    private void ShowDeleteCommentConfirm(Comment comment, int postId)
    {
        commentToDelete = comment;
        commentPostId = postId;
        showDeleteCommentConfirm = true;
    }

    private async Task ConfirmDeleteComment()
    {
        if (commentToDelete != null)
        {
            await CommentService.SoftDeleteAsync(commentToDelete.Id);
            await LoadCommentsForPost(commentPostId);

            var count = await CommentService.GetCountByPostIdAsync(commentPostId);
            postCommentCounts[commentPostId] = count;

            var postIndex = posts.FindIndex(p => p.Id == commentPostId);
            if (postIndex >= 0)
            {
                var updatedPost = await PostService.GetByIdAsync(commentPostId);
                if (updatedPost != null) posts[postIndex] = updatedPost;
            }

            commentToDelete = null;
            commentPostId = 0;
            StateHasChanged();
        }
    }
}
