                {
                    <Alert Message="@emailErrorMessage" 
                           Type="Alert.AlertType.Error" 
                           Dismissible="true"
                           OnDismiss="@(() => emailErrorMessage = null)" />
                }
                else
                {
                    <!-- Notification Type Selection -->
                    <div class="mb-3">
                        <label class="form-label text-white-full">Tipo de Notificação <span class="text-danger">*</span></label>
                        <select class="form-select" @bind="selectedNotificationType">
                            <option value="@NotificationTypeNew">Nova Atuação</option>
                            <option value="@NotificationTypeReminder">Lembrete de Atuação</option>
                        </select>
                        <small class="text-muted">
                            @if (selectedNotificationType == NotificationTypeNew)
                            {
                                <text>Notifica os membros sobre uma nova atuação criada.</text>
                            }
                            else
                            {
                                var daysText = GetDaysUntilEventText(selectedEventForEmail.Date);
                                if (daysText != null)
                                {
                                    var reminderText = daysText == "hoje" ? "a atuação é hoje" : $"a atuação é em {daysText}";
                                    <text>Lembra os membros que @reminderText e de confirmarem a presença.</text>
                                }
                                else
                                {
                                    <text>Não é possível enviar lembretes para eventos passados.</text>
                                }
                            }
                        </small>
                    </div>
                    
                    <EmailRecipientsPreview 
                        SubscribedUsers="@(subscribedUsers ?? new List<ApplicationUser>())"
                        NonSubscribedUsers="@(nonSubscribedUsers ?? new List<ApplicationUser>())"
                        SubscribedUsersTitle="Membros que irão receber:"
                        NonSubscribedUsersTitle="Quem não irá receber:"
                        ShowNonSubscribedUsers="true"
                        MaxHeight="300px"
                        InfoBadgeText="@($"{subscribedUsersCount} / {totalUsersCount} membros têm 'Notificações por email' ativas e irão receber esta mensagem.")"
                        ShowEmptySubscribedMessage="true"
                        EmptySubscribedMessage="Nenhum membro subscrito às notificações por email." />
                }
            }
        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="CloseEmailNotificationModal" disabled="@IsSendingEmails">Cancelar</button>
        <button type="button" class="btn btn-primary btn-primary-purple" @onclick="SendEventNotification" disabled="@(IsSendingEmails || subscribedUsers == null || !subscribedUsers.Any())">
            Enviar Notificação
        </button>
    </FooterContent>
</Modal>

<!-- Push Notification Confirmation Modal -->
<Modal Show="@modals.IsOpen(ModalType.PushNotification)"
       ShowChanged="@((bool show) => modals.Toggle(ModalType.PushNotification, show))"
       Title="Enviar notificação push desta atuação"
       Size="Modal.ModalSize.Large"
       Centered="true"
       ShowCloseButton="true">
    <BodyContent>
        @if (selectedEventForPush != null)
        {
            <!-- Loading Overlay for Sending Push Notifications -->
            @if (IsSendingPushNotifications)
            {
                <div class="position-relative loading-overlay-container">
                    <div class="position-absolute top-0 start-0 w-100 h-100 d-flex flex-column align-items-center justify-content-center loading-overlay-backdrop">
                        <LoadingSpinner Size="@SpinnerSize.Large" Color="@SpinnerColor.Light" Centered="false" AdditionalContainerClass="mb-3" />
                        <h5 class="text-white mb-2">Enviando notificações push...</h5>
                    </div>
                </div>
            }
            else
            {
                <div class="mb-3">
                    <h6 class="text-white-full">Detalhes do Evento:</h6>
                    <div class="event-summary p-3 rounded bg-dark">
                        <div><strong>Título:</strong> @selectedEventForPush.Name</div>
                        <div><strong>Data:</strong> @selectedEventForPush.Date.ToString("dddd, dd 'de' MMMM 'de' yyyy • HH:mm", new System.Globalization.CultureInfo("pt-PT"))</div>
                        <div><strong>Local:</strong> @selectedEventForPush.Location</div>
                    </div>
                </div>

                @if (pushLoadingSubscribers)
                {
                    <div class="text-center py-3">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">A carregar...</span>
                        </div>
                    </div>
                }
                else if (!string.IsNullOrEmpty(pushErrorMessage))
                {
                    <Alert Message="@pushErrorMessage" 
                           Type="Alert.AlertType.Error" 
                           Dismissible="true"
                           OnDismiss="@(() => pushErrorMessage = null)" />
                }
                else
                {
                    <!-- Custom Notification Message -->
                    <div class="mb-3">
                        <label class="form-label text-white-full">Mensagem da Notificação <span class="text-danger">*</span></label>
                        <textarea class="form-control" 
                                  rows="4" 
                                  @bind="customNotificationBody" 
                                  placeholder="Ex: Atuação importante, confirma a tua presença!"
                                  maxlength="500"></textarea>
                        <small class="text-muted">
                            A notificação usará automaticamente o nome do evento como título. Máximo 500 caracteres.
                        </small>
                    </div>

                    <!-- Filter Option -->
                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" 
                                   type="checkbox" 
                                   id="eventFilterLeitaoCaloiro"
                                   @bind="filterOnlyLeitaoAndCaloiro"
                                   @bind:after="OnEventFilterChanged" />
                            <label class="form-check-label text-white-full" for="eventFilterLeitaoCaloiro">
                                Enviar apenas para <strong>Leitões</strong> e <strong>Caloiros</strong>
                            </label>
                        </div>
                        @if (filterOnlyLeitaoAndCaloiro)
                        {
                            <small class="text-warning d-block mt-1">
                                <i class="bi bi-info-circle me-1"></i>
                                As notificações serão enviadas apenas para membros com as categorias "Leitão" ou "Caloiro".
                            </small>
                        }
                    </div>
                    
                    <EmailRecipientsPreview 
                        SubscribedUsers="@(pushFilteredSubscribedUsers ?? new List<ApplicationUser>())"
                        NonSubscribedUsers="@(pushFilteredNonSubscribedUsers ?? new List<ApplicationUser>())"
                        SubscribedUsersTitle="Membros que irão receber:"
                        NonSubscribedUsersTitle="Quem não irá receber:"
                        ShowNonSubscribedUsers="true"
                        MaxHeight="300px"
                        InfoBadgeText="@($"{pushSubscribedUsersCount} / {pushTotalUsersCount} membros têm notificações push ativas e irão receber esta mensagem.")"
                        ShowEmptySubscribedMessage="true"
                        EmptySubscribedMessage="Nenhum membro subscrito às notificações push." />
                }
            }
        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="ClosePushNotificationModal" disabled="@IsSendingPushNotifications">Cancelar</button>
        <button type="button" class="btn btn-primary btn-primary-purple" @onclick="SendPushNotification" disabled="@(IsSendingPushNotifications || pushSubscribedUsers == null || !pushSubscribedUsers.Any())">
            Enviar Notificação Push
        </button>
    </FooterContent>
</Modal>

<!-- Cancel Event Confirmation Modal -->
<Modal Show="@modals.IsOpen(ModalType.CancelEvent)"
       ShowChanged="@((bool show) => modals.Toggle(ModalType.CancelEvent, show))"
       Title="Cancelar Evento"
       Size="Modal.ModalSize.Large"
       Centered="true"
       ShowCloseButton="true">
    <BodyContent>
        @if (selectedEventForCancellation != null)
        {
            <!-- Loading Overlay for Sending Cancellation Emails -->
            @if (IsSendingEmails)
            {
                <div class="position-relative loading-overlay-container">
                    <div class="position-absolute top-0 start-0 w-100 h-100 d-flex flex-column align-items-center justify-content-center loading-overlay-backdrop">
                        <div class="spinner-border text-primary mb-3 spinner-large" role="status">
                            <span class="visually-hidden">A enviar...</span>
                        </div>
                        <h5 class="text-white mb-2">Enviando emails de cancelamento...</h5>
                        <p class="text-white-full mb-0">
                            @EmailsSent / @EmailsTotal
                            @if (!string.IsNullOrEmpty(LastRecipient))
                            {
                                <span> (último: @LastRecipient)</span>
                            }
                        </p>
                    </div>
                </div>
            }
            
            <div class="mb-3">
                <h6 class="text-white-full">Evento:</h6>
                <div class="event-summary p-3 rounded bg-dark">
                    <div><strong>Título:</strong> @selectedEventForCancellation.Name</div>
                    <div><strong>Data:</strong> @FormatEventDateRange(selectedEventForCancellation)</div>
                    <div><strong>Local:</strong> @selectedEventForCancellation.Location</div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(cancelEventErrorMessage))
            {
                <ErrorDisplay Errors="@(new[] { cancelEventErrorMessage })" />
            }

            @if (cancelEventLoadingSubscribers)
            {
                <div class="text-center py-3">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">A carregar...</span>
                    </div>
                </div>
            }
            
            <div class="mb-3 form-check">
                <input class="form-check-input" type="checkbox" id="notifySubscribersCheckbox"
                       @bind="notifySubscribersOnCancel">
                <label class="form-check-label text-white-full" for="notifySubscribersCheckbox">
                    Notificar todos os inscritos por email
                </label>
            </div>
            
            @if (notifySubscribersOnCancel)
            {
                <EmailRecipientsPreview 
                    SubscribedUsers="@(cancelEventSubscribedUsers ?? new List<ApplicationUser>())"
                    NonSubscribedUsers="@(cancelEventNonSubscribedUsers ?? new List<ApplicationUser>())"
                    SubscribedUsersTitle="Membros que irão receber:"
                    NonSubscribedUsersTitle="Quem não irá receber:"
                    ShowNonSubscribedUsers="true"
                    MaxHeight="200px"
                    InfoBadgeText="@($"{cancelEventSubscribedCount} / {cancelEventTotalCount} membros têm 'Notificações por email' ativas e irão receber esta mensagem.")" />
            }

            <div class="mb-3">
                <label class="form-label text-white-full">Motivo do Cancelamento <span class="text-danger">*</span></label>
                <textarea class="form-control" rows="4" 
                          @bind="cancelEventReason" 
                          placeholder="Descreva o motivo do cancelamento do evento..."
                          maxlength="1000"></textarea>
                <small class="text-muted">Máximo 1000 caracteres</small>
            </div>
        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="CloseCancelEventModal" disabled="@IsSendingEmails">Não Cancelar</button>
        <button type="button" class="btn btn-danger" @onclick="ConfirmCancelEvent" disabled="@IsSendingEmails">Cancelar Evento</button>
    </FooterContent>
</Modal>


</div>

