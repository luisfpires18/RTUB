@page "/events"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using RTUB.Application.Helpers
@using RTUB.Application.DTOs
@using RTUB.Application.Extensions
@using RTUB.Application.Interfaces
@using RTUB.Application.Utilities
@using RTUB.Core.Entities
@using RTUB.Shared
@using RTUB.Shared.Base
@using System.Web
@using System.Text.Json
@using Microsoft.AspNetCore.WebUtilities
@inject IEventService EventService
@inject IEventFilterService EventFilterService
@inject IEventUrlService EventUrlService
@inject IEventStatisticsService EventStatisticsService
@inject IEnrollmentFilterService EnrollmentFilterService
@inject IEnrollmentStatisticsService EnrollmentStatisticsService
@inject IFiscalYearService FiscalYearService
@inject IEnrollmentService EnrollmentService
@inject IMemberInstrumentService MemberInstrumentService
@inject ITrophyService TrophyService
@inject IEmailNotificationService EmailNotificationService
@inject IPushNotificationService PushNotificationService
@inject IPushNotificationFactory PushNotificationFactory
@inject IImageStorageService ImageStorageService
@inject IEventRepertoireService EventRepertoireService
@inject IDiscussionService DiscussionService
@inject IPostService PostService
@inject IAuditLogService AuditLogService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject IWebHostEnvironment Environment
@inject NavigationManager Navigation
@inject RTUB.Web.Interop.MediaSessionInterop MediaSession
@inject RTUB.Web.Interop.PwaHelperInterop PwaHelper
@inject IJSRuntime JSRuntime
@inject ILogger<Events> Logger

<div class="events-page container-fluid">
    <div class="page-header-centered">
        <div class="page-header-left"></div>
        <div class="page-header-center">
            <h1><i class="bi bi-calendar-event"></i> Atuações</h1>
            <p class="lead page-header-subtitle text-light-theme">Próximas atuações e atividades.</p>
        </div>
        <div class="page-header-right d-none d-xl-flex gap-2">
            <AuthorizeView Roles="Admin">
                <Authorized>
                    <button class="btn btn-success" @onclick="OpenCreateModal" title="Adicionar Novo Evento">
                        <i class="bi bi-plus-lg"></i> Adicionar Atuação
                    </button>
                </Authorized>
            </AuthorizeView>
            <button class="btn btn-purple btn-purple-light" @onclick="OpenTrophiesStatsModal" title="Ver Prémios">
                <i class="bi bi-trophy-fill"></i> Prémios
            </button>
            <AuthorizeView>
                <Authorized>
                    <button class="btn btn-outline-primary" @onclick="() => _enrollmentStatsRef?.Open()" title="Ver Estatísticas">
                        <i class="bi bi-bar-chart"></i> Estatísticas
                    </button>
                    <button class="btn btn-outline-secondary btn-my-enrollments" @onclick="OpenMyEnrollmentsViaRef" title="Minhas Inscrições" aria-label="Ver minhas inscrições">
                        <i class="bi bi-calendar-check"></i> Minhas Inscrições
                    </button>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>

    @* Component instances outside hidden container so their modals work on all viewports *@
    <EnrollmentStatisticsButton @ref="_enrollmentStatsRef" HideButton="true"/>
    <MyEnrollmentsButton @ref="_myEnrollmentsRef" HideButton="true"/>

    <!-- Filter Controls -->
    <div class="d-flex flex-column flex-lg-row align-items-lg-end gap-2 flex-wrap mb-4">
        <div class="flex-lg-shrink-0 filter-dropdown-container">
            <FilterDropdown SelectedValue="@selectedFiscalYear"
                            SelectedValueChanged="@(value => selectedFiscalYear = value)"
                            OnChange="@OnFiscalYearChanged"
                            AllItemsLabel="Todos os anos"
                            Options="@fiscalYearOptions" />
        </div>
        <div class="flex-lg-shrink-0 filter-dropdown-container">
            <FilterDropdown SelectedValue="@selectedEventType"
                            SelectedValueChanged="@(value => selectedEventType = value)"
                            OnChange="@OnEventTypeChanged"
                            AllItemsLabel="Todos os tipos"
                            Options="@eventTypeOptions" />
        </div>
        <div class="form-check form-switch d-flex align-items-center videos-only-toggle">
            <input class="form-check-input form-check-input-clickable" type="checkbox" role="switch" id="showVideosOnlySwitch"
                   @bind="showVideosOnly" @bind:after="OnVideosOnlyToggled">
            <label class="form-check-label ms-2 form-check-label-clickable" for="showVideosOnlySwitch">
                Atuação com videos
            </label>
        </div>
    </div>


@if (allEvents == null)
{
    <p>A carregar atuações...</p>
}
else if ((!filteredFutureEvents.Any() || showVideosOnly) && !filteredPreviousEvents.Any())
{
    <EmptyState Title="Nenhum evento encontrado"
               Message="@GetEmptyStateMessage()"
               Icon="bi-info-circle" />
}
else
{
    @if (filteredFutureEvents.Any() && !showVideosOnly)
    {
        <div class="row g-3" @key="@($"future-events-{eventListRefreshTrigger}")">
            @foreach (var eventItem in paginatedFutureEvents)
            {
                <div class="col-12 col-sm-6 col-md-4 mb-3" @key="eventItem.Id">
                    <AuthorizeView>
                        <Authorized>
                            @{
                                var userEnrollment = GetUserEnrollment(eventItem.Id);
                            }
                            <EventCard Event="@eventItem"
                                       ImageUrl="@GetEventImageUrl(eventItem.ImageSrc)"
                                       UserEnrollment="@userEnrollment"
                                       EnrollmentCount="@GetEnrollmentCount(eventItem.Id)"
                                       RepertoireCount="@GetRepertoireCount(eventItem.Id)"
                                       DiscussionCount="@GetDiscussionCount(eventItem.Id)"
                                       IsAdmin="@isUserAdmin"
                                       IsPastEvent="false"
                                       ShowDeleteButton="@CanDeleteEvent()"
                                       ShowCancelButton="@CanCancelEvent()"
                                       OnEdit="@(() => OpenEditModal(eventItem))"
                                       OnDelete="@(() => OpenDeleteModal(eventItem))"
                                       OnSendEmail="@(() => OpenEmailNotificationModal(eventItem))"
                                       OnSendPushNotification="@(() => OpenPushNotificationModal(eventItem))"
                                       OnCancelEvent="@(() => OpenCancelEventModal(eventItem))"
                                       OnUncancelEvent="@(() => UncancelEvent(eventItem))"
                                       OnEnrollGoing="@(() => OpenEnrollModalWithParticipation(eventItem, true))"
                                       OnEnrollNotGoing="@(() => OpenEnrollModalWithParticipation(eventItem, false))"
                                       OnEditEnrollment="@(() => { if (userEnrollment != null) OpenEditEnrollmentModal(userEnrollment); })"
                                       OnRemoveEnrollment="@(() => { if (userEnrollment != null) OpenRemoveEnrollmentModal(userEnrollment); })"
                                       OnViewDetails="@(() => OpenEventDetailsModal(eventItem))"
                                       OnViewEnrollments="@(() => HandleViewEnrollments(eventItem))"
                                       OnWatchRepertoire="@(() => OpenRepertoireModal(eventItem))"
                                       OnViewDiscussion="@(() => NavigateToDiscussion(eventItem))" />
                        </Authorized>
                        <NotAuthorized Context="unauthorizedContext">
                            <EventCard Event="@eventItem"
                                       ImageUrl="@GetEventImageUrl(eventItem.ImageSrc)"
                                       EnrollmentCount="@GetEnrollmentCount(eventItem.Id)"
                                       RepertoireCount="@GetRepertoireCount(eventItem.Id)"
                                       DiscussionCount="@GetDiscussionCount(eventItem.Id)"
                                       IsAdmin="false"
                                       IsPastEvent="false"
                                       ShowButtons="false" />
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            }
        </div>

        @if (filteredFutureEvents.Count > futureEventsPaginationHelper.PageSize)
        {
            <TablePagination CurrentPage="@futureEventsPaginationHelper.CurrentPage"
                            PageSize="@futureEventsPaginationHelper.PageSize"
                            TotalItems="@filteredFutureEvents.Count"
                            ItemLabel="eventos"
                            PageSizeOptions="@(new[] { 9, 18, 27, 36, 45 })"
                            OnPageChanged="@HandleFutureEventsPageChange"
                            OnPageSizeChanged="@HandleFutureEventsPageSizeChange" />
        }
    }
}

<!-- Previous Events Section -->
@if (!showVideosOnly)
{
    <hr class="my-5" />
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>@(showVideosOnly ? "Atuações com Videos" : "Atuações Anteriores")</h2>
</div>

<SearchBar @bind-Value="previousEventsSearch"
           Placeholder="Pesquisar atuações anteriores..."
           OnSearch="@HandlePreviousEventsSearch" />

@if (filteredPreviousEvents == null)
{
    <LoadingSpinner Message="A carregar atuações anteriores..." />
}
else if (!filteredPreviousEvents.Any())
{
    <EmptyState Title="Nenhum evento anterior encontrado"
                     Message="Não existem atuações passados para mostrar."
                   Icon="bi-calendar-x" />
}
else
{
    <div class="row g-3" @key="@($"previous-events-{eventListRefreshTrigger}")">
        @foreach (var eventItem in paginatedPreviousEvents)
        {
            <div class="col-12 col-sm-6 col-md-4 mb-3" @key="eventItem.Id">
                <AuthorizeView>
                    <Authorized>
                        @{
                            var userEnrollment = GetUserEnrollment(eventItem.Id);
                        }
                        <AuthorizeView Roles="Admin">
                            <Authorized Context="editContext">
                                <EventCard Event="@eventItem"
                                           ImageUrl="@GetEventImageUrl(eventItem.ImageSrc)"
                                           UserEnrollment="@userEnrollment"
                                           EnrollmentCount="@GetEnrollmentCount(eventItem.Id)"
                                           RepertoireCount="@GetRepertoireCount(eventItem.Id)"
                                           DiscussionCount="@GetDiscussionCount(eventItem.Id)"
                                           VideoCount="@GetVideoCount(eventItem.Id)"
                                           TrophyCount="@GetTrophyCount(eventItem.Id)"
                                           IsAdmin="true"
                                           IsPastEvent="true"
                                           ShowTrophy="true"
                                           OnEdit="@(() => OpenEditModal(eventItem))"
                                           OnDelete="@(() => OpenDeleteModal(eventItem))"
                                           OnViewDetails="@(() => OpenEventDetailsModal(eventItem))"
                                           OnViewEnrollments="@(() => HandleViewEnrollments(eventItem))"
                                           OnWatchRepertoire="@(() => OpenRepertoireModal(eventItem))"
                                           OnViewDiscussion="@(() => NavigateToDiscussion(eventItem))"
                                           OnRemoveEnrollment="@(() => { if (userEnrollment != null) OpenRemoveEnrollmentModal(userEnrollment); })"
                                           OnViewTrophies="@(() => OpenTrophyModal(eventItem))"
                                           OnViewVideos="@(() => OpenVideosModal(eventItem))" />
                            </Authorized>
                            <NotAuthorized Context="adminOnlyContext">
                                <EventCard Event="@eventItem"
                                           ImageUrl="@GetEventImageUrl(eventItem.ImageSrc)"
                                           UserEnrollment="@userEnrollment"
                                           EnrollmentCount="@GetEnrollmentCount(eventItem.Id)"
                                           RepertoireCount="@GetRepertoireCount(eventItem.Id)"
                                           DiscussionCount="@GetDiscussionCount(eventItem.Id)"
                                           VideoCount="@GetVideoCount(eventItem.Id)"
                                           TrophyCount="@GetTrophyCount(eventItem.Id)"
                                           IsAdmin="false"
                                           IsPastEvent="true"
                                           ShowTrophy="true"
                                           OnViewDetails="@(() => OpenEventDetailsModal(eventItem))"
                                           OnViewEnrollments="@(() => HandleViewEnrollments(eventItem))"
                                           OnWatchRepertoire="@(() => OpenRepertoireModal(eventItem))"
                                           OnViewDiscussion="@(() => NavigateToDiscussion(eventItem))"
                                           OnRemoveEnrollment="@(() => { if (userEnrollment != null) OpenRemoveEnrollmentModal(userEnrollment); })"
                                           OnViewTrophies="@(() => OpenTrophyModal(eventItem))"
                                           OnViewVideos="@(() => OpenVideosModal(eventItem))" />
                            </NotAuthorized>
                        </AuthorizeView>
                    </Authorized>
                    <NotAuthorized>
                        <EventCard Event="@eventItem"
                                   ImageUrl="@GetEventImageUrl(eventItem.ImageSrc)"
                                   EnrollmentCount="@GetEnrollmentCount(eventItem.Id)"
                                   RepertoireCount="@GetRepertoireCount(eventItem.Id)"
                                   DiscussionCount="@GetDiscussionCount(eventItem.Id)"
                                   VideoCount="@GetVideoCount(eventItem.Id)"
                                   TrophyCount="@GetTrophyCount(eventItem.Id)"
                                   IsAdmin="false"
                                   IsPastEvent="true"
                                   ShowButtons="false"
                                   ShowOnlyTrophy="true"
                                   OnViewTrophies="@(() => OpenTrophyModal(eventItem))"
                                   OnViewVideos="@(() => OpenVideosModal(eventItem))" />
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        }
    </div>

    <TablePagination CurrentPage="@paginationHelper.CurrentPage"
                    PageSize="@paginationHelper.PageSize"
                    TotalItems="@(filteredPreviousEvents?.Count ?? 0)"
                    ItemLabel="eventos"
                    PageSizeOptions="@(new[] { 9, 18, 27, 36, 45 })"
                    OnPageChanged="@HandlePreviousEventsPageChange"
                    OnPageSizeChanged="@HandlePreviousEventsPageSizeChange" />
}

<!-- Edit/Create Modal -->
<Modal Show="@modals.IsOpen(ModalType.Edit)" 
       ShowChanged="@((bool show) => modals.Toggle(ModalType.Edit, show))"
       Title="@(isCreateMode ? "Criar Novo Evento" : "Editar Evento")" 
       Size="Modal.ModalSize.Default"
       Centered="true">
    <BodyContent>
        <EditForm Model="editingEvent" OnValidSubmit="SaveEvent" id="editEventForm">
            <DataAnnotationsValidator />
            <ErrorDisplay />

            @if (showPastDateWarning && editingEvent != null && editingEvent.Date.Date < DateTime.Today)
            {
                <Alert Type="Alert.AlertType.Purple"
                       Icon="bi-info-circle"
                       Dismissible="false"
                       AdditionalClasses="mb-3">
                    <strong>Nota:</strong> Esta data é anterior à data atual. O evento será disponibilizado nas atuações anteriores.
                </Alert>
            }

            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <i class="bi bi-kanban text-primary me-2"></i>Nome da Atuação
                </label>
                <InputText class="form-control" @bind-Value="editingEvent!.Name" />
            </div>

            <div class="mb-3">
                <div class="form-check form-switch">
                    <input class="form-check-input clickable-row" type="checkbox" id="dateRangeToggle"
                           @bind="isDateRange" @bind:after="OnDateRangeToggled" />
                    <label class="form-check-label form-check-label-white-clickable" for="dateRangeToggle">
                        Intervalo de Datas (em vez de data única)
                    </label>
                </div>
            </div>

            <div class="row">
                @if (!isDateRange)
                {
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-calendar3 text-primary me-2"></i>Data
                        </label>
                        <InputDate class="form-control" @bind-Value="editingEvent!.Date" @bind-Value:after="OnDateChanged" />
                        @if (!string.IsNullOrEmpty(dateValidationError))
                        {
                            <div class="text-danger small mt-1">@dateValidationError</div>
                        }
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-clock text-primary me-2"></i>Hora
                        </label>
                        <input type="time" class="form-control" value="@eventTimeString" @onchange="@((ChangeEventArgs e) => { eventTimeString = e.Value?.ToString() ?? "19:00"; OnTimeChanged(); })" />
                    </div>
                }
                else
                {
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-calendar3 text-primary me-2"></i>Data Início
                        </label>
                        <InputDate class="form-control" @bind-Value="editingEvent!.Date" @bind-Value:after="OnDateChanged" />
                        @if (!string.IsNullOrEmpty(dateValidationError))
                        {
                            <div class="text-danger small mt-1">@dateValidationError</div>
                        }
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-calendar-check text-primary me-2"></i>Data Fim (opcional)
                        </label>
                        <InputDate class="form-control" @bind-Value="editingEvent!.EndDate" />
                    </div>
                }
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <i class="bi bi-geo-alt text-primary me-2"></i>Localização
                </label>
                <InputText class="form-control" @bind-Value="editingEvent!.Location" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <i class="bi bi-tag text-primary me-2"></i>Tipo de Atuação
                </label>
                <InputSelect class="form-select" @bind-Value="editingEvent!.Type">
                    @foreach (var type in Enum.GetValues<EventType>())
                    {
                        <option value="@type">@GetEventTypeDisplay(type)</option>
                    }
                </InputSelect>
            </div>

            <ImageUploadManager @ref="imageUploadManager"
                               Label="Imagem do Evento"
                               CurrentImageUrl="@(uploadedImagePath == null && !string.IsNullOrEmpty(editingEvent!.ImageSrc) ? GetEventImageUrl(editingEvent.ImageSrc) : null)"
                               ShowCurrentImage="@(uploadedImagePath == null)"
                               PreviewCssClass="slideshow-preview"
                               OnFileSelected="HandleImageUpload" />

            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <i class="bi bi-text-paragraph text-primary me-2"></i>Descrição
                </label>
                <InputTextArea class="form-control" rows="4" @bind-Value="editingEvent!.Description" />
            </div>

        </EditForm>
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="CloseEditModal">Cancelar</button>
        <button type="submit" form="editEventForm" class="btn btn-primary btn-primary-purple">Guardar</button>
    </FooterContent>
</Modal>

<!-- Delete Confirmation Modal -->
<ConfirmDialog Show="@modals.IsOpen(ModalType.Delete)"
               ShowChanged="@((bool show) => modals.Toggle(ModalType.Delete, show))"
               Title="Confirmar Eliminação"
               Message="@($"Tem a certeza de que pretende eliminar a atuação {deletingEvent?.Name}?")"
               WarningMessage="Esta ação não pode ser anulada."
               ConfirmText="Eliminar"
               CancelText="Cancelar"
               ConfirmButtonClass="btn-danger"
               OnConfirm="DeleteEvent"
               OnCancel="CloseDeleteModal" />

<!-- Enrollment Modal (using unified ParticipationModal) -->
@if (enrollmentForm != null)
{
    <ParticipationModal Show="@modals.IsOpen(ModalType.Enroll)"
                       ShowChanged="@((bool show) => modals.Toggle(ModalType.Enroll, show))"
                       Title="@GetEnrollmentModalTitle()"
                       ShowWillAttend="@(!isParticipationPreSelected)"
                       WillAttend="@enrollmentForm.WillAttend"
                       WillAttendChanged="@((bool value) => enrollmentForm.WillAttend = value)"
                       IsLeitao="@(currentUser != null && currentUser.Categories.Contains(MemberCategory.Leitao))"
                       Instrument="@enrollmentForm.Instrument"
                       InstrumentChanged="@((InstrumentType? value) => enrollmentForm.Instrument = value)"
                       AvailableInstruments="@availableInstruments"
                       Notes="@enrollmentForm.Notes"
                       NotesChanged="@((string value) => enrollmentForm.Notes = value)"
                       NotesRows="4"
                       NotesPlaceholder="@(enrollmentForm.WillAttend ? "Informações adicionais..." : "Motivo da impossibilidade...")"
                       SubmitButtonText="@(isEditingEnrollment ? "Atualizar" : "Confirmar")"
                       WantToPlay="@wantToPlay"
                       WantToPlayChanged="@((bool value) => wantToPlay = value)"
                       OnSubmit="@SaveEnrollment"
                       OnCancel="@CloseEnrollModal" />
}

<!-- Remove Enrollment Confirmation Modal -->
<ConfirmDialog Show="@modals.IsOpen(ModalType.RemoveEnrollment)"
               ShowChanged="@((bool show) => modals.Toggle(ModalType.RemoveEnrollment, show))"
               Title="Confirmar Cancelamento de Inscrição"
               Message="Tem certeza que deseja cancelar sua inscrição neste evento?"
               ConfirmText="Sim, Cancelar"
               CancelText="Não"
               ConfirmButtonClass="btn-danger"
               OnConfirm="RemoveEnrollment"
               OnCancel="CloseRemoveEnrollmentModal" />

<!-- View Enrollments Modal -->
@if (selectedEvent != null)
{
    <Modal Show="@modals.IsOpen(ModalType.EnrollmentList)" 
           ShowChanged="@((bool show) => { if (!show) CloseEnrollmentListModal(); })"
           Size="Modal.ModalSize.Large"
           Centered="true">
        <HeaderActions>
            <button type="button" class="btn btn-sm btn-outline-primary me-2" @onclick="@(async () => await NavigateToEnrollmentsPage(selectedEvent.Id))" title="Abrir em página completa">
                <i class="bi bi-box-arrow-up-right"></i>
            </button>
            <h5 class="modal-title mb-0">@($"Inscrições em {selectedEvent.Name}")</h5>
        </HeaderActions>
        <BodyContent>
            @if (eventEnrollments != null && eventEnrollments.Any())
            {
                var performingMembers = eventEnrollments.Where(e => e.User != null && e.WillAttend && !e.User.Categories.Contains(MemberCategory.Leitao)).ToList();
                var leitaoMembers = eventEnrollments.Where(e => e.User != null && e.WillAttend && e.User.Categories.Contains(MemberCategory.Leitao)).ToList();
                var notAttendingMembers = eventEnrollments.Where(e => e.User != null && !e.WillAttend).ToList();

                @if (performingMembers.Any())
                {
                    <h6 class="mb-3 heading-purple">Membros (@performingMembers.Count)</h6>

                    <!-- Search Control -->
                    <SearchBar @bind-Value="enrollmentSearchTerm"
                               Placeholder="Pesquisar por nome..."
                               OnSearch="HandleEnrollmentSearch" />
                    
                    <div class="enrollment-card-grid mb-4">
                        @foreach (var enrollment in paginatedPerformingMembers)
                        {
                            <EnrollmentCard 
                                AvatarUrl="@enrollment.User?.ProfilePictureSrc"
                                TunaName="@enrollment.User?.Nickname"
                                FullName="@($"{enrollment.User?.FirstName} {enrollment.User?.LastName}".Trim())"
                                InstrumentText="@(enrollment.Instrument.HasValue ? StatusHelper.GetInstrumentDisplay(enrollment.Instrument.Value) : "")"
                                OtherInstruments="@enrollment.OtherInstruments"
                                Notes="@enrollment.Notes"
                                AltText="@enrollment.User?.GetDisplayName()"
                                ShowEditButton="false"
                                ShowDeleteButton="@CanDeleteEnrollment(enrollment)"
                                OnDelete="@(() => OpenDeleteEnrollmentModal(enrollment))"
                                DeleteTooltip="Eliminar Inscrição">
                                <BadgeContent>
                                    @if (enrollment.User != null)
                                    {
                                        <div class="enrollment-card-badges-row">
                                            @if (enrollment.User.Positions.Contains(Position.Magister))
                                            {
                                                <PositionBadge Position="Position.Magister" />
                                            }
                                            else if (enrollment.User.Categories.Contains(MemberCategory.Tuno))
                                            {
                                                <CategoryBadge Category="MemberCategory.Tuno" />
                                            }
                                            else if (enrollment.User.Categories.Contains(MemberCategory.Caloiro))
                                            {
                                                <CategoryBadge Category="MemberCategory.Caloiro" />
                                            }
                                        </div>
                                    }
                                </BadgeContent>
                            </EnrollmentCard>
                        }
                    </div>

                    <!-- Pagination for Performing Members -->
                    @if (filteredPerformingMembers.Count > 0)
                    {
                        <div class="mb-3">
                            <TablePagination 
                                TotalItems="@filteredPerformingMembers.Count"
                                CurrentPage="@performingMembersPagination.CurrentPage"
                                PageSize="@performingMembersPagination.PageSize"
                                PageSizeOptions="@(new[] { 4, 8, 12, 16 })"
                                OnPageChanged="@HandlePerformingMembersPageChange"
                                OnPageSizeChanged="@HandlePerformingMembersPageSizeChange" />
                        </div>
                    }

                    @* Instrument Counts - Horizontal Counter Section *@
                    <InstrumentCounter InstrumentCounts="@primaryInstrumentCounts" Title="Instrumentos" />
                    <InstrumentCounter InstrumentCounts="@otherInstrumentCounts" Title="Outros Instrumentos" Collapsible="true" DefaultCollapsed="true" />
                }

                @if (leitaoMembers.Any())
                {
                    <h6 class="mb-3 heading-warning">Leitões (@leitaoMembers.Count)</h6>
                    <div class="enrollment-card-grid">
                        @foreach (var enrollment in paginatedLeitoes)
                        {
                            <EnrollmentCard 
                                AvatarUrl="@enrollment.User?.ProfilePictureSrc"
                                TunaName="@enrollment.User?.Nickname"
                                FullName="@($"{enrollment.User?.FirstName} {enrollment.User?.LastName}".Trim())"
                                InstrumentText=""
                                OtherInstruments=""
                                Notes="@enrollment.Notes"
                                AltText="@enrollment.User?.GetDisplayName()"
                                ShowEditButton="false"
                                ShowDeleteButton="@CanDeleteEnrollment(enrollment)"
                                OnDelete="@(() => OpenDeleteEnrollmentModal(enrollment))"
                                DeleteTooltip="Eliminar Inscrição">
                                <BadgeContent>
                                    <div class="enrollment-card-badges-row">
                                        <CategoryBadge Category="MemberCategory.Leitao" />
                                    </div>
                                </BadgeContent>
                            </EnrollmentCard>
                        }
                    </div>
                    
                    <!-- Pagination for Leitões -->
                    @if (filteredLeitoes.Count > 0)
                    {
                        <div class="mt-3">
                            <TablePagination 
                                TotalItems="@filteredLeitoes.Count"
                                CurrentPage="@leitoesPagination.CurrentPage"
                                PageSize="@leitoesPagination.PageSize"
                                PageSizeOptions="@(new[] { 4, 8, 12, 16 })"
                                OnPageChanged="@HandleLeitoesPageChange"
                                OnPageSizeChanged="@HandleLeitoesPageSizeChange" />
                        </div>
                    }
                }

                @if (notAttendingMembers.Any())
                {
                    <h6 class="mb-3 mt-4 heading-danger">Não vão participar (@filteredNotAttending.Count)</h6>
                    <div class="enrollment-card-grid">
                        @foreach (var enrollment in paginatedNotAttending)
                        {
                            <EnrollmentCard 
                                AvatarUrl="@enrollment.User?.ProfilePictureSrc"
                                TunaName="@enrollment.User?.Nickname"
                                FullName="@($"{enrollment.User?.FirstName} {enrollment.User?.LastName}".Trim())"
                                InstrumentText=""
                                OtherInstruments=""
                                Notes="@enrollment.Notes"
                                AltText="@enrollment.User?.GetDisplayName()"
                                ShowEditButton="false"
                                ShowDeleteButton="@CanDeleteEnrollment(enrollment)"
                                OnDelete="@(() => OpenDeleteEnrollmentModal(enrollment))"
                                DeleteTooltip="Eliminar Inscrição">
                                <BadgeContent>
                                    @if (enrollment.User != null)
                                    {
                                        <div class="enrollment-card-badges-row">
                                            @if (enrollment.User.Positions.Contains(Position.Magister))
                                            {
                                                <PositionBadge Position="Position.Magister" />
                                            }
                                            else if (enrollment.User.Categories.Contains(MemberCategory.Tuno))
                                            {
                                                <CategoryBadge Category="MemberCategory.Tuno" />
                                            }
                                            else if (enrollment.User.Categories.Contains(MemberCategory.Caloiro))
                                            {
                                                <CategoryBadge Category="MemberCategory.Caloiro" />
                                            }
                                            else if (enrollment.User.Categories.Contains(MemberCategory.Leitao))
                                            {
                                                <CategoryBadge Category="MemberCategory.Leitao" />
                                            }
                                        </div>
                                    }
                                </BadgeContent>
                            </EnrollmentCard>
                        }
                    </div>
                    
                    <!-- Pagination for Not Attending Members -->
                    @if (filteredNotAttending.Count > 0)
                    {
                        <div class="mt-3">
                            <TablePagination 
                                TotalItems="@filteredNotAttending.Count"
                                CurrentPage="@notAttendingPagination.CurrentPage"
                                PageSize="@notAttendingPagination.PageSize"
                                PageSizeOptions="@(new[] { 4, 8, 12, 16 })"
                                OnPageChanged="@HandleNotAttendingPageChange"
                                OnPageSizeChanged="@HandleNotAttendingPageSizeChange" />
                        </div>
                    }
                }
            }
            else
            {
                <EmptyState Title="Nenhuma inscrição ainda para este evento"
                           Icon="bi-people" />
            }
            
            <AuthorizeView Roles="Admin">
                <Authorized>
                    <div class="mt-3">
                        <!-- Success Alert (auto-dismiss) -->
                        @if (!string.IsNullOrEmpty(addMemberToEnrollmentFeedbackMessage) && !addMemberToEnrollmentFeedbackIsError)
                        {
                            <Alert Type="Alert.AlertType.Purple"
                                   Title="@addMemberToEnrollmentFeedbackMessage"
                                   Dismissible="true"
                                   OnDismiss="ClearAddMemberToEnrollmentFeedback"
                                   AdditionalClasses="mb-2" />
                        }

                        <!-- Error Alert (manual dismiss) -->
                        @if (!string.IsNullOrEmpty(addMemberToEnrollmentFeedbackMessage) && addMemberToEnrollmentFeedbackIsError)
                        {
                            <Alert Type="Alert.AlertType.Error"
                                   Title="@addMemberToEnrollmentFeedbackMessage"
                                   Dismissible="true"
                                   OnDismiss="ClearAddMemberToEnrollmentFeedback"
                                   AdditionalClasses="mb-2" />
                        }

                        @if (!showAddMemberToEnrollmentSearch)
                        {
                            <button class="btn btn-sm btn-outline-primary" @onclick="ShowAddMemberToEnrollmentSearch">
                                <i class="bi bi-plus-circle"></i>
                                Adicionar Membro
                            </button>
                        }
                        else
                        {
                            <div class="mb-2">
                                <SearchBar @bind-Value="addMemberToEnrollmentSearchTerm"
                                           Placeholder="Pesquisar membro por nome..."
                                           OnSearch="@HandleAddMemberToEnrollmentSearchChanged" />

                                @if (!string.IsNullOrWhiteSpace(addMemberToEnrollmentSearchTerm) && filteredAvailableMembersForEnrollment.Any())
                                {
                                    <div class="member-list member-list-scrollable mt-2">
                                        @foreach (var member in filteredAvailableMembersForEnrollment)
                                        {
                                            <div class="member-item p-2 mb-2 border rounded clickable-row"
                                                 @onclick="() => AddMemberToEvent(member)"
                                                 tabindex="0"
                                                 @onkeydown="@(async (e) => await HandleMemberItemKeyDownForEnrollment(e, member))">
                                                <div class="d-flex align-items-center">
                                                    <img src="@member.ProfilePictureSrc" alt="@member.GetDisplayName()"
                                                         class="member-avatar-small me-2" />
                                                    <div>
                                                        <strong>@member.GetDisplayName()</strong>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else if (!string.IsNullOrWhiteSpace(addMemberToEnrollmentSearchTerm))
                                {
                                    <p class="text-muted mt-2">Nenhum membro encontrado.</p>
                                }
                            </div>

                            <button class="btn btn-sm btn-outline-secondary" @onclick="HideAddMemberToEnrollmentSearch">
                                <i class="bi bi-x-circle"></i>
                                Cancelar
                            </button>
                        }
                    </div>
                </Authorized>
            </AuthorizeView>
        </BodyContent>
        <FooterContent>
            <button type="button" class="btn btn-secondary" @onclick="CloseEnrollmentListModal">Voltar Atrás</button>
        </FooterContent>
    </Modal>
}

<!-- Image Cropper Component -->
<ImageCropper @ref="imageCropper"
              ShowModal="@modals.IsOpen(ModalType.Cropper)"
              ShowModalChanged="OnCropperModalChanged"
              OnImageCropped="OnImageCropped"
              AspectRatio="1.5"
              AspectRatioHelp="Event images are displayed in 3:2 aspect ratio for better presentation"
              ImageFormat="image/webp"
              ImageQuality="0.85" />

<!-- Repertoire Modal -->
<RepertoireModal Show="@modals.IsOpen(ModalType.Repertoire)"
                ShowChanged="@((bool show) => modals.Toggle(ModalType.Repertoire, show))"
                EventId="@(selectedEventForRepertoire?.Id ?? 0)"
                EventName="@(selectedEventForRepertoire?.Name ?? "")"
                EventDate="@(selectedEventForRepertoire?.Date ?? DateTime.Now)"
                EventEndDate="@selectedEventForRepertoire?.EndDate"
                IsAdmin="@isUserAdmin"
                OnRepertoireChanged="@HandleRepertoireChanged" />

<!-- Event Details Modal -->
@if (selectedEvent != null)
{
    <DetailsModal Show="@modals.IsOpen(ModalType.EventDetails)"
                  ShowChanged="@((bool show) => modals.Toggle(ModalType.EventDetails, show))"
                  Title="Detalhes da Atuação"
                  HeaderTitle="@(selectedEvent?.Name ?? "")"
                  ImageUrl="@(selectedEvent != null && !string.IsNullOrEmpty(selectedEvent.ImageSrc) ? selectedEvent.ImageSrc : null)"
                  IconClass="@(selectedEvent != null && string.IsNullOrEmpty(selectedEvent.ImageSrc) ? "bi-calendar-event" : null)"
                  OnClose="@(() => modals.Close(ModalType.EventDetails))">
        <BadgesContent>
            @if (selectedEvent != null)
            {
                <span class="badge bg-primary">@GetEventTypeDisplay(selectedEvent.Type)</span>
            }
        </BadgesContent>
        <Sections>
            @if (selectedEvent != null)
            {
                <!-- Event Information Section -->
                <InfoSection SectionTitle="Informação da Atuação"
                            IconClass="bi-info-circle-fill"
                            CssClass="mb-4">
                    <ProfileField Label="Nome"
                                  Value="@selectedEvent.Name"
                                  Icon="bi-card-text" />
                    <ProfileField Label="Tipo"
                                  Value="@GetEventTypeDisplay(selectedEvent.Type)"
                                  Icon="bi-tag-fill" />
                    <ProfileField Label="Data"
                                  Value="@GetEventDateDisplay(selectedEvent)"
                                  Icon="bi-calendar-event" />
                    <ProfileField Label="Localização"
                                  Value="@selectedEvent.Location"
                                  Icon="bi-geo-alt-fill" />
                </InfoSection>

                <!-- Description Section -->
                @if (!string.IsNullOrEmpty(selectedEvent.Description))
                {
                    <InfoSection SectionTitle="Descrição" 
                                IconClass="bi-file-text" 
                                CssClass="mb-3">
                        <p class="text-white-full mb-0 content-pre-line">@selectedEvent.Description</p>
                    </InfoSection>
                }

                <!-- Cancellation Reason Section -->
                @if (selectedEvent.IsCancelled && !string.IsNullOrEmpty(selectedEvent.CancellationReason))
                {
                    <InfoSection SectionTitle="Motivo de Cancelamento" 
                                IconClass="bi-exclamation-triangle-fill" 
                                CssClass="mb-3"
                                Style="background-color: rgba(220, 38, 38, 0.1); border-left: 4px solid #DC2626;">
                        <p class="mb-0 cancellation-reason-text">@selectedEvent.CancellationReason</p>
                    </InfoSection>
                }
            }
        </Sections>
    </DetailsModal>
}

<!-- Trophy Modal -->
<Modal Show="@modals.IsOpen(ModalType.Trophy)"
       ShowChanged="@((bool show) => modals.Toggle(ModalType.Trophy, show))"
       Title="@($"Prémios  de {selectedEventForTrophies?.Name ?? ""}")"
       Size="Modal.ModalSize.Large"
       Centered="true">
    <BodyContent>
        <AuthorizeView Roles="Admin">
            <Authorized>
                <div class="mb-3">
                    <button class="btn btn-success btn-sm" @onclick="OpenCreateTrophyModal">
                        <i class="bi bi-plus-lg"></i> Adicionar Prémio
                    </button>
                </div>
            </Authorized>
        </AuthorizeView>

        @if (eventTrophies == null || !eventTrophies.Any())
        {
            <EmptyState Title="Nenhum prémio conquistado neste evento."
                            Icon="bi-trophy" />
        }
        else
        {
            <div class="row g-3">
                @foreach (var trophy in eventTrophies)
                {
                    <div class="col-md-4 col-sm-6">
                        <div class="card h-100 text-center p-3 position-relative trophy-card">
                            <AuthorizeView Roles="Admin">
                                <Authorized>
                                    <div class="position-absolute top-0 end-0 p-2">
                                        <button class="btn btn-sm admin-btn-edit me-1" @onclick="() => OpenEditTrophyModal(trophy)" title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm admin-btn-delete" @onclick="() => OpenDeleteTrophyModal(trophy)" title="Eliminar">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </Authorized>
                            </AuthorizeView>
                            <div class="card-body d-flex flex-column align-items-center justify-content-center">
                                <i class="bi bi-trophy-fill text-warning mb-3 trophy-icon-large"></i>
                                <h5 class="card-title mb-0">@trophy.Name</h5>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="CloseTrophyModal">Voltar Atrás</button>
    </FooterContent>
</Modal>

<!-- Trophy Edit Modal -->
<Modal Show="@modals.IsOpen(ModalType.TrophyEdit)"
       ShowChanged="@((bool show) => modals.Toggle(ModalType.TrophyEdit, show))"
       Title="@(isTrophyCreateMode ? "Adicionar Prémio" : "Editar Prémio")"
       Size="Modal.ModalSize.Default"
       Centered="true">
    <BodyContent>
        @if (editingTrophy != null)
        {
            <EditForm Model="editingTrophy" OnValidSubmit="SaveTrophy" id="editTrophyForm">
                <DataAnnotationsValidator />
                <ErrorDisplay />

                <div class="mb-3">
                    <label class="form-label">Nome do Prémio</label>
                    <InputText class="form-control" @bind-Value="editingTrophy.Name" placeholder="Inserir nome do prémio..." />
                </div>

            </EditForm>
        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="CloseTrophyEditModal">Cancelar</button>
        <button type="submit" form="editTrophyForm" class="btn btn-primary btn-primary-purple">Guardar</button>
    </FooterContent>
</Modal>

<!-- Trophy Delete Modal -->
<ConfirmDialog Show="@modals.IsOpen(ModalType.TrophyDelete)"
               ShowChanged="@((bool show) => modals.Toggle(ModalType.TrophyDelete, show))"
               Title="Confirmar Eliminação"
               Message="@($"Tem a certeza que deseja eliminar o prémio {deletingTrophy?.Name}?")"
               WarningMessage="Esta ação não pode ser revertida."
               ConfirmText="Eliminar"
               CancelText="Cancelar"
               ConfirmButtonClass="btn-danger"
               OnConfirm="DeleteTrophy"
               OnCancel="CloseTrophyDeleteModal" />

<!-- Trophies Statistics Modal -->
<Modal Show="@modals.IsOpen(ModalType.TrophiesStats)"
       ShowChanged="@((value) => modals.Toggle(ModalType.TrophiesStats, value))"
       Title="Prémios Conquistados"
       Size="Modal.ModalSize.Large"
       ShowCloseButton="true">
    <BodyContent>
        @if (isLoadingTrophiesStats)
        {
            <LoadingSpinner Message="A carregar estatísticas de troféus..." />
        }
        else if (trophiesStatsByEvent == null || !trophiesStatsByEvent.Any())
        {
            <EmptyState Title="Nenhum prémio conquistado ainda"
                       Icon="bi-trophy" />
        }
        else
        {
            <div class="statistics-container">
                <!-- Trophies by Event Section (with expandable trophies) -->
                <div class="mb-4">
                    <h4 class="mb-3"><i class="bi bi-trophy-fill text-warning"></i> Prémios por Evento</h4>
                    @foreach (var eventGroup in paginatedTrophiesStats)
                    {
                        var isExpanded = trophiesStatsExpanded.GetValueOrDefault(eventGroup.EventId, false);
                        var startIndex = (trophiesStatsPaginationHelper.CurrentPage - 1) * trophiesStatsPaginationHelper.PageSize;
                        var position = paginatedTrophiesStats.IndexOf(eventGroup) + startIndex + 1;
                        <div class="user-stats-group mb-3">
                            <div class="user-stats-header @(eventGroup.TrophyCount > 0 ? "user-stats-header-clickable" : "not-expandable")" 
                                 @onclick="() => { if (eventGroup.TrophyCount > 0) ToggleTrophiesStats(eventGroup.EventId); }">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="stats-card-position me-2">
                                        @if (position == 1)
                                        {
                                            <span class="stats-medal gold">🥇</span>
                                        }
                                        else if (position == 2)
                                        {
                                            <span class="stats-medal silver">🥈</span>
                                        }
                                        else if (position == 3)
                                        {
                                            <span class="stats-medal bronze">🥉</span>
                                        }
                                        else
                                        {
                                            <span class="stats-position">@position</span>
                                        }
                                    </div>
                                    <div class="user-stats-info">
                                        <div class="user-stats-nickname">@eventGroup.EventName</div>
                                        <div class="user-stats-fullname">@eventGroup.EventDate.ToString("dd MMM yyyy")</div>
                                    </div>
                                </div>
                                <div class="user-stats-total">@eventGroup.TrophyCount prémio(s)</div>
                                @if (eventGroup.TrophyCount > 0)
                                {
                                    <i class="bi @(isExpanded ? "bi-chevron-up" : "bi-chevron-down") ms-auto"></i>
                                }
                            </div>
                            @if (isExpanded)
                            {
                                <div class="stats-card-grid mt-2">
                                    @foreach (var trophy in eventGroup.Trophies)
                                    {
                                        <div class="stats-card stats-card-detailed">
                                            <div class="stats-card-content">
                                                <div class="stats-card-title">
                                                    <i class="bi bi-trophy-fill text-warning me-2"></i>@trophy.Name
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    <TablePagination 
                        CurrentPage="@trophiesStatsPaginationHelper.CurrentPage"
                        PageSize="@trophiesStatsPaginationHelper.PageSize"
                        TotalItems="@trophiesStatsByEvent.Count"
                        ItemLabel="eventos"
                        PageSizeOptions="@(new[] { 5, 10, 15, 20 })"
                        OnPageChanged="@HandleTrophiesStatsPageChanged"
                        OnPageSizeChanged="@HandleTrophiesStatsPageSizeChanged" />
                </div>
            </div>
        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="CloseTrophiesStatsModal">Voltar Atrás</button>
    </FooterContent>
</Modal>

<!-- Videos Modal (with Upload and View sections) -->
<Modal Show="@modals.IsOpen(ModalType.Videos)" 
       ShowChanged="@((value) => modals.Toggle(ModalType.Videos, value))"
       Title="@($"Vídeos - {selectedEventForVideos?.Name}")" 
       Size="Modal.ModalSize.Large"
       Centered="true"
       ShowCloseButton="true"
       OnClose="@CloseVideosModal">
    <BodyContent>
        @* Upload Section - Visible to all logged-in users (members only) *@
        <AuthorizeView>
            <Authorized>
                <div class="mb-4">
                    <h6 class="mb-3">
                        <i class="bi bi-upload text-primary me-2"></i>Adicionar Vídeo
                    </h6>
                    
                    @if (isUploadingVideo)
                    {
                        <LoadingSpinner Message="A enviar vídeo..." />
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label">Ficheiro de vídeo</label>
                            <div class="localized-file-picker">
                                <InputFile id="@videoInputId" 
                                           @key="videoUploadKey"
                                           class="d-none" 
                                           OnChange="@HandleVideoSelection" 
                                           accept="video/*" 
                                           aria-label="Escolher vídeo" />
                                <label class="btn btn-outline-secondary localized-file-button" for="@videoInputId">
                                    <i class="bi bi-upload me-2"></i>Escolher vídeo
                                </label>
                                <span class="localized-file-name">
                                    @if (!string.IsNullOrEmpty(selectedVideoName))
                                    {
                                        <text>@selectedVideoName</text>
                                    }
                                    else
                                    {
                                        <text>Nenhum vídeo selecionado</text>
                                    }
                                </span>
                            </div>
                            <small class="text-muted d-block mt-1">
                                <i class="bi bi-info-circle me-1"></i>Tamanho máximo: 100MB
                            </small>
                        </div>
                        
                        @if (selectedVideoFile != null)
                        {
                            <div class="mb-3">
                                <label class="form-label">Título do vídeo <span class="text-danger">*</span></label>
                                <InputText @bind-Value="videoTitle" class="form-control" placeholder="Digite um título para o vídeo" />
                                <small class="text-muted">Este nome aparecerá na lista de vídeos</small>
                            </div>
                            
                            <div class="d-flex justify-content-end">
                                <button type="button" class="btn btn-secondary me-2" @onclick="CancelVideoSelection">
                                    Cancelar
                                </button>
                                <button type="button" class="btn btn-primary" @onclick="UploadVideo" disabled="@(string.IsNullOrWhiteSpace(videoTitle))">
                                    <i class="bi bi-upload me-2"></i>Enviar vídeo
                                </button>
                            </div>
                        }
                    }
                </div>
                
                <hr class="my-4" />
            </Authorized>
        </AuthorizeView>
        
        @* View Section - Visible to everyone *@
        <div>
            <h6 class="mb-3">
                <i class="bi bi-list-ul text-primary me-2"></i>Vídeos Disponíveis
            </h6>
            
            @if (eventVideos == null || !eventVideos.Any())
            {
                <EmptyState Title="Ainda não existem vídeos para este evento"
                           Icon="bi-camera-video"
                           Message="Os vídeos aparecerão aqui quando forem adicionados." />
            }
            else
            {
                var videos = eventVideos.OrderBy(v => v.SortOrder).ToList();
                
                <div class="video-selector mb-3">
                    <label class="form-label fw-semibold">Selecione um vídeo:</label>
                    <div class="list-group">
                        @for (int i = 0; i < videos.Count; i++)
                        {
                            var index = i;
                            var video = videos[i];
                            var isSelected = selectedVideoId == video.Id;
                            
                            // Generate clean display title
                            var displayTitle = GetCleanVideoTitle(video, i + 1);
                            
                            <div class="list-group-item list-group-item-action position-relative @(isSelected ? "active" : "") @(draggingVideoId == video.Id ? "dragging" : "") @(dragOverVideoId == video.Id ? "drag-over" : "")"
                                 role="button"
                                 draggable="@(isUserAdmin ? "true" : "false")"
                                 @ondragstart="@(() => HandleVideoDragStart(video.Id))"
                                 @ondragover="HandleVideoDragOver"
                                 @ondragover:preventDefault
                                 @ondragenter="@(() => HandleVideoDragEnter(video.Id))"
                                 @ondragleave="@(() => HandleVideoDragLeave())"
                                 @ondrop="@(async () => await HandleVideoDrop(video.Id))"
                                 @ondragend="@(() => HandleVideoDragEnd())"
                                 @onclick="() => SelectVideoByIndex(video.Id)">
                                @if (isUserAdmin)
                                {
                                    <div class="drag-handle-video" title="Arrastar para reordenar">
                                        <i class="bi bi-grip-vertical"></i>
                                    </div>
                                }
                                <span class="video-title-content">
                                    <i class="bi bi-play-circle me-2"></i>@displayTitle
                                </span>
                                @if (CanDeleteVideo(video))
                                {
                                    <div class="position-absolute top-50 end-0 translate-middle-y me-2 d-flex gap-1">
                                        <button type="button" 
                                                class="btn btn-sm admin-btn-edit" 
                                                @onclick:stopPropagation="true"
                                                @onclick="() => OpenEditVideoModal(video)"
                                                title="Renomear vídeo">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button type="button" 
                                                class="btn btn-sm admin-btn-delete" 
                                                @onclick:stopPropagation="true"
                                                @onclick="() => DeleteVideoFromModal(video)"
                                                title="Eliminar vídeo">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
                
                @if (selectedVideoId.HasValue)
                {
                    var selectedVideo = videos.FirstOrDefault(v => v.Id == selectedVideoId.Value);
                    if (selectedVideo != null)
                    {
                        <div class="video-player-container">
                            <video @key="@selectedVideo.Id" controls playsinline class="modal-video" preload="metadata" @onplay="() => LogVideoPlaybackAsync(selectedVideo, selectedEventForVideos!)">
                                <source src="@selectedVideo.Url" type="@selectedVideo.MimeType">
                                @if (selectedVideo.MimeType == "video/quicktime")
                                {
                                    <source src="@selectedVideo.Url" type="video/mp4">
                                }
                                <p class="text-warning p-3">
                                    O seu navegador não suporta este formato de vídeo.
                                    Se o vídeo foi gravado num telemóvel, pode ter um codec (HEVC/H.265) não suportado neste navegador.
                                    Experimente usar o Safari ou um navegador móvel.
                                </p>
                            </video>
                        </div>
                    }
                }
            }
        </div>
    </BodyContent>
</Modal>

<!-- Edit Video Title Modal -->
<Modal Show="@modals.IsOpen(ModalType.EditVideo)" 
       ShowChanged="@((value) => modals.Toggle(ModalType.EditVideo, value))"
       Title="Renomear Vídeo" 
       Size="Modal.ModalSize.Default"
       Centered="true"
       ShowCloseButton="false">
    <BodyContent>
        @if (editingVideo != null)
        {
            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <i class="bi bi-camera-video text-primary me-2"></i>Título do Vídeo
                </label>
                <input type="text" class="form-control" @bind="editingVideoTitle" placeholder="Digite o título do vídeo" maxlength="200" />
                <small class="text-muted">Máximo 200 caracteres</small>
            </div>
            
        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="CloseEditVideoModal">Cancelar</button>
        <button type="button" class="btn btn-primary btn-primary-purple" @onclick="SaveVideoTitle">Guardar</button>
    </FooterContent>
</Modal>

<!-- Delete Enrollment Confirmation Modal -->
<ConfirmDialog Show="@modals.IsOpen(ModalType.DeleteEnrollment)"
               ShowChanged="@((bool show) => modals.Toggle(ModalType.DeleteEnrollment, show))"
               Title="Confirmar Eliminação de Inscrição"
               Message="@($"Tem a certeza que deseja eliminar a inscrição de {deletingEnrollment?.User?.GetDisplayName()} neste evento?")"
               WarningMessage="Esta ação não pode ser revertida."
               ConfirmText="Eliminar"
               CancelText="Cancelar"
               ConfirmButtonClass="btn-danger"
               OnConfirm="DeleteEnrollment"
               OnCancel="CloseDeleteEnrollmentModal" />

<!-- Email Notification Confirmation Modal -->
<Modal Show="@modals.IsOpen(ModalType.EmailNotification)"
       ShowChanged="@((bool show) => modals.Toggle(ModalType.EmailNotification, show))"
       Title="Enviar notificação desta atuação"
       Size="Modal.ModalSize.Large"
       Centered="true"
       ShowCloseButton="true">
    <BodyContent>
        @if (selectedEventForEmail != null)
        {
            <!-- Loading Overlay for Sending Emails -->
            @if (IsSendingEmails)
            {
                <div class="position-relative loading-overlay-container">
                    <div class="position-absolute top-0 start-0 w-100 h-100 d-flex flex-column align-items-center justify-content-center loading-overlay-backdrop">
                        <div class="spinner-border text-primary mb-3 spinner-large" role="status">
