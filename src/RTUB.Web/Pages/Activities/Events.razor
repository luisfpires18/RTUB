    private void OpenEnrollModalWithParticipation(Event eventItem, bool willParticipate)
    {
        if (currentUser == null) return;

        isParticipationPreSelected = true; // Hide WillAttend selection in modal
        selectedEvent = eventItem;
        
        // Check if user already has an enrollment for this event
        var existingEnrollment = GetUserEnrollment(eventItem.Id);
        
        if (existingEnrollment != null)
        {
            // Update existing enrollment
            isEditingEnrollment = true;
            wantToPlay = existingEnrollment.Instrument.HasValue;
            
            // Clear notes if changing participation status (different reasons)
            var shouldClearNotes = existingEnrollment.WillAttend != willParticipate;
            
            enrollmentForm = new Enrollment
            {
                Id = existingEnrollment.Id,
                UserId = existingEnrollment.UserId,
                EventId = existingEnrollment.EventId,
                Instrument = existingEnrollment.Instrument,
                Notes = shouldClearNotes ? string.Empty : existingEnrollment.Notes,
                WillAttend = willParticipate // Set the new participation value
            };
        }
        else
        {
            // Create new enrollment
            isEditingEnrollment = false;
            var (defaultInstrument, shouldWantToPlay) = GetDefaultInstrumentSettings();
            wantToPlay = shouldWantToPlay;
            
            enrollmentForm = new Enrollment
            {
                UserId = currentUser.Id,
                EventId = eventItem.Id,
                Instrument = defaultInstrument,
                Notes = string.Empty,
                WillAttend = willParticipate
            };
        }
        modals.Open(ModalType.Enroll);
    }

