    private async Task LoadEventRepertoires()
    {
        // Load all event repertoires for all events (both upcoming and past)
        // This follows the same pattern as loading all enrollments
        var repertoiresList = new List<EventRepertoire>();
        
        if (allEvents != null)
        {
            foreach (var evt in allEvents)
            {
                var repertoires = await EventRepertoireService.GetRepertoireByEventIdAsync(evt.Id);
                repertoiresList.AddRange(repertoires);
            }
        }
        
        eventRepertoires = repertoiresList;
    }

    private async Task LoadDiscussionPosts()
    {
        // Load discussion post counts for all events (both upcoming and past)
        // Store as dictionary mapping eventId to count for efficient lookup
        var counts = new Dictionary<int, int>();
        
        if (allEvents != null)
        {
            foreach (var evt in allEvents)
            {
                var discussion = await DiscussionService.GetByEventIdAsync(evt.Id);
                if (discussion != null)
                {
                    var count = await PostService.GetCountByDiscussionIdAsync(discussion.Id);
                    counts[evt.Id] = count;
                }
                else
                {
                    counts[evt.Id] = 0;
                }
            }
        }
        
        discussionPostCounts = counts;
    }

    private async Task LoadEventVideoCounts()
    {
        // Load video counts for all past events using parallel loading
        var counts = new Dictionary<int, int>();
        
        if (allEvents != null)
        {
            var pastEvents = allEvents.Where(e => (e.EndDate.HasValue ? e.EndDate.Value.Date : e.Date.Date) < DateTime.Today).ToList();
            var tasks = pastEvents.Select(async evt =>
            {
                var videos = await EventService.GetVideosByEventIdAsync(evt.Id);
                return (EventId: evt.Id, Count: videos.Count());
            });
            
            var results = await Task.WhenAll(tasks);
            foreach (var result in results)
            {
                counts[result.EventId] = result.Count;
            }
        }
        
        eventVideoCounts = counts;
    }

    private async Task LoadEventTrophyCounts()
    {
        // Load trophy counts for all past festival events using parallel loading
        var counts = new Dictionary<int, int>();
        
        if (allEvents != null)
        {
            var pastFestivalEvents = allEvents.Where(e => (e.EndDate.HasValue ? e.EndDate.Value.Date : e.Date.Date) < DateTime.Today && e.Type == EventType.Festival).ToList();
            var tasks = pastFestivalEvents.Select(async evt =>
            {
                var trophies = await TrophyService.GetByEventIdAsync(evt.Id);
                return (EventId: evt.Id, Count: trophies.Count());
            });
            
            var results = await Task.WhenAll(tasks);
            foreach (var result in results)
            {
                counts[result.EventId] = result.Count;
            }
        }
        
        eventTrophyCounts = counts;
    }

