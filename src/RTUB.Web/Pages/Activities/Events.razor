        trophiesStatsByEvent = await EventStatisticsService.GetTrophyStatisticsByEventAsync(100);
        
        // Set up pagination
        paginatedTrophiesStats = trophiesStatsPaginationHelper.GetPageData(trophiesStatsByEvent);
        
