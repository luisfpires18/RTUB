    // Video drag-and-drop handlers
    private void HandleVideoDragStart(int videoId)
    {
        if (!isUserAdmin) return;
        draggingVideoId = videoId;
        dragOverVideoId = null;
    }

    private void HandleVideoDragEnter(int videoId)
    {
        if (!isUserAdmin || draggingVideoId == null || draggingVideoId == videoId) return;
        dragOverVideoId = videoId;
    }

    private void HandleVideoDragLeave()
    {
        if (!isUserAdmin) return;
        dragOverVideoId = null;
    }

    private void HandleVideoDragOver()
    {
        // Combined with @ondragover:preventDefault directive to allow drops
        if (!isUserAdmin) return;
    }

    private void HandleVideoDragEnd()
    {
        if (!isUserAdmin) return;
        // Always clean up drag state when drag ends
        draggingVideoId = null;
        dragOverVideoId = null;
    }

    private async Task HandleVideoDrop(int targetVideoId)
    {
        if (!isUserAdmin || draggingVideoId == null || draggingVideoId == targetVideoId) 
        {
            // Clean up even if we don't process the drop
            draggingVideoId = null;
            dragOverVideoId = null;
            return;
        }

        var draggingVideo = eventVideos?.FirstOrDefault(v => v.Id == draggingVideoId);
        var targetVideo = eventVideos?.FirstOrDefault(v => v.Id == targetVideoId);

        if (draggingVideo != null && targetVideo != null && selectedEventForVideos != null)
        {
            // Get the current ordered list
            var orderedList = eventVideos!.OrderBy(v => v.SortOrder).ToList();
            
            // Find current indices
            var draggedIndex = orderedList.IndexOf(draggingVideo);
            var targetIndex = orderedList.IndexOf(targetVideo);
            
            // Reorder logic matching EventRepertoire pattern
            // 1. Remove the dragged item
            orderedList.RemoveAt(draggedIndex);
            
            // 2. Calculate insertion index
            var insertIndex = (draggedIndex < targetIndex) ? targetIndex : targetIndex;
            
            // 3. Insert at calculated position
            orderedList.Insert(insertIndex, draggingVideo);

            // Update sort orders based on new list order
            var videoIds = orderedList.Select(v => v.Id).ToList();
            
            await EventService.UpdateVideoOrderAsync(selectedEventForVideos.Id, videoIds);
            
            // Force reload to get updated order from database
            eventVideos = (await EventService.GetVideosByEventIdAsync(selectedEventForVideos.Id)).ToList();
            
            // Force UI refresh
            StateHasChanged();
        }

        // Clean up drag state
        draggingVideoId = null;
        dragOverVideoId = null;
    }

    private async Task LogVideoPlaybackAsync(EventVideo video, Event eventItem)
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            var userId = user?.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            var userName = user?.Identity?.Name;
            var displayName = $"{video.Title ?? "Video"} ({eventItem.Name})";

            await AuditLogService.AddAsync(new AuditLog
            {
                EntityType = "EventVideo",
                EntityId = video.Id,
                Action = "Played",
                UserId = string.IsNullOrEmpty(userId) ? null : userId,
                UserName = userName,
                Timestamp = DateTime.UtcNow,
                EntityDisplayName = displayName
            });
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error logging video playback for video {VideoId}", video.Id);
        }
    }
    
