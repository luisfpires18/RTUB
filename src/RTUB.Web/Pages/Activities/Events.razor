    private async Task SaveEnrollment()
    {
        if (enrollmentForm == null || currentUser == null) return;

        InstrumentType? instrumentToSave = null;
        string? otherInstrumentsText = null;

        // Only process instrument info if wanting to play
        if (wantToPlay)
        {
            instrumentToSave = enrollmentForm.Instrument;
            
            // Get all member instruments and calculate other instruments
            var memberInstruments = await MemberInstrumentService.GetMemberInstrumentsAsync(currentUser.Id);
            
            if (enrollmentForm.Instrument.HasValue)
            {
                // Get all instruments except the selected one
                var otherInstruments = memberInstruments
                    .Where(mi => mi.InstrumentType != enrollmentForm.Instrument.Value)
                    .Select(mi => StatusHelper.GetInstrumentDisplay(mi.InstrumentType))
                    .ToList();
                
                if (otherInstruments.Any())
                {
                    otherInstrumentsText = string.Join(", ", otherInstruments);
                }
            }
        }

        if (isEditingEnrollment)
        {
            var existingEnrollment = await EnrollmentService.GetEnrollmentByIdAsync(enrollmentForm.Id);
            if (existingEnrollment != null && existingEnrollment.UserId == currentUser.Id)
            {
                // Update enrollment using the new UpdateEnrollmentAsync method
                await EnrollmentService.UpdateEnrollmentAsync(
                    enrollmentForm.Id,
                    enrollmentForm.WillAttend,
                    instrumentToSave,
                    enrollmentForm.Notes,
                    otherInstrumentsText
                );
            }
        }
        else
        {
            // Check if enrollment already exists to prevent duplicate constraint violations
            var existingEnrollment = await EnrollmentService.GetEnrollmentByEventAndUserAsync(
                enrollmentForm.EventId,
                enrollmentForm.UserId
            );
            
            if (existingEnrollment != null)
            {
                // Update existing enrollment instead of creating duplicate
                await EnrollmentService.UpdateEnrollmentAsync(
                    existingEnrollment.Id,
                    enrollmentForm.WillAttend,
                    instrumentToSave,
                    enrollmentForm.Notes,
                    otherInstrumentsText
                );
            }
            else
            {
                // Create new enrollment
                await EnrollmentService.CreateEnrollmentAsync(
                    enrollmentForm.UserId,
                    enrollmentForm.EventId,
                    instrumentToSave,
                    enrollmentForm.Notes,
                    enrollmentForm.WillAttend,
                    otherInstrumentsText
                );
            }
        }

        await LoadEnrollments();
        CloseEnrollModal();
        StateHasChanged();
    }

