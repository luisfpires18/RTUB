    private async Task SelectVideoByIndex(int videoId)
    {
        if (selectedVideoId == videoId)
        {
            selectedVideoId = null;
            // Clear media session when video is collapsed
            try
            {
                await MediaSession.ClearMetadataAsync();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to clear media session metadata");
            }
        }
        else
        {
            selectedVideoId = videoId;
            
            // Set media session metadata when video is selected
            if (selectedEventForVideos != null && eventVideos != null)
            {
                var selectedVideo = eventVideos.FirstOrDefault(v => v.Id == videoId);
                if (selectedVideo != null)
                {
                    try
                    {
                        var videoTitle = GetCleanVideoTitle(selectedVideo, eventVideos.IndexOf(selectedVideo) + 1);
                        var eventImageUrl = !string.IsNullOrEmpty(selectedEventForVideos.ImageSrc) 
                            ? selectedEventForVideos.ImageSrc 
                            : string.Empty;
                        
                        // Use a small delay to ensure video element is rendered before attaching
                        await Task.Delay(VideoElementRenderDelayMs);
                        await MediaSession.AttachToVideoAsync(
                            ".modal-video",
                            videoTitle,
                            selectedEventForVideos.Name,
                            eventImageUrl
                        );
                    }
                    catch (Exception ex)
                    {
                        Logger.LogWarning(ex, "Failed to set video media session metadata");
                    }
                }
            }
        }
    }
    
    private void HandleVideoSelection(InputFileChangeEventArgs e)
    {
        if (selectedEventForVideos == null) return;
        
        var file = e.File;
        var maxFileSize = 100 * 1024 * 1024; // 100MB
        
        if (file.Size > maxFileSize)
        {
            selectedVideoName = null;
            selectedVideoFile = null;
            return;
        }
        
        selectedVideoFile = file;
        selectedVideoName = file.Name;
        
        var existingCount = eventVideos?.Count ?? 0;
        var videoNumber = existingCount + 1;
        videoTitle = $"{selectedEventForVideos.Name} - Vídeo {videoNumber}";
        
        StateHasChanged();
    }
    
    private void CancelVideoSelection()
    {
        selectedVideoFile = null;
        selectedVideoName = null;
        videoTitle = string.Empty;
        videoUploadKey = Guid.NewGuid();
    }
    
    private async Task UploadVideo()
    {
        if (selectedEventForVideos == null || selectedVideoFile == null) return;
        
        var maxFileSize = 100 * 1024 * 1024; // 100MB
        isUploadingVideo = true;
        StateHasChanged();
        
        try
        {
            using var browserStream = selectedVideoFile.OpenReadStream(maxFileSize);
            using var memoryStream = new MemoryStream();
            await browserStream.CopyToAsync(memoryStream);
            memoryStream.Position = 0;
            
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            var currentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
            
            await EventService.AddVideoAsync(
                selectedEventForVideos.Id,
                memoryStream,
                selectedVideoFile.Name,
                selectedVideoFile.ContentType,
                currentUserId,
                videoTitle
            );
            
            eventVideos = (await EventService.GetVideosByEventIdAsync(selectedEventForVideos.Id)).ToList();
            selectedVideoId = null;
            CancelVideoSelection();
        }
        catch
        {
            // Log error but keep UI responsive - error will be visible to user via state
        }
        finally
        {
            isUploadingVideo = false;
            StateHasChanged();
        }
    }
    
    private async Task DeleteVideoFromModal(EventVideo video)
    {
        if (selectedEventForVideos == null) return;
        
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            var currentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
            
            await EventService.DeleteVideoAsync(video.Id, currentUserId, isUserAdmin);
            
            if (selectedVideoId == video.Id)
            {
                selectedVideoId = null;
            }
            
            eventVideos = (await EventService.GetVideosByEventIdAsync(selectedEventForVideos.Id)).ToList();
            StateHasChanged();
        }
        catch
        {
            // Log error silently - deletion failure won't block UI updates
        }
    }
    
    private string GetCleanVideoTitle(EventVideo video, int videoNumber)
    {
        if (selectedEventForVideos == null) 
            return $"Vídeo {videoNumber}";
        
        if (string.IsNullOrWhiteSpace(video.Title))
        {
            return $"{selectedEventForVideos.Name} - Vídeo {videoNumber}";
        }
        
        var title = video.Title.Trim();
        var MaxCleanTitleLength = 50;
        var VideoExtensions = new[] { ".mp4", ".mov", ".avi", ".mkv", ".webm", ".flv" };
        var looksLikeKey = title.Length > MaxCleanTitleLength || 
                          VideoExtensions.Any(ext => title.Contains(ext, StringComparison.OrdinalIgnoreCase)) ||
                          title.Contains("/") ||
                          title.Contains("\\");
        
        if (looksLikeKey)
        {
            return $"{selectedEventForVideos.Name} - Vídeo {videoNumber}";
        }
        
        return title;
    }
    
