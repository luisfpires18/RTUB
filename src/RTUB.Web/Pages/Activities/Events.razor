    /// <summary>
    /// Gets the days until event formatted as text in Portuguese.
    /// Returns null if the event is in the past.
    /// </summary>
    private string? GetDaysUntilEventText(DateTime eventDate)
    {
        var daysUntil = (int)Math.Ceiling((eventDate.Date - DateTime.UtcNow.Date).TotalDays);
        if (daysUntil < 0)
        {
            return null; // Event is in the past
        }
        if (daysUntil == 0)
        {
            return "hoje";
        }

        return daysUntil == 1 ? "1 dia" : $"{daysUntil} dias";
    }
    
