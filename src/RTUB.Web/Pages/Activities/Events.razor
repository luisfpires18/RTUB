    private async Task SendEventNotification()
    {
        if (selectedEventForEmail == null || subscribedUsers == null || !subscribedUsers.Any())
        {
            CloseEmailNotificationModal();
            return;
        }

        // Initialize progress tracking
        IsSendingEmails = true;
        EmailsTotal = subscribedUsers.Count;
        EmailsSent = 0;
        LastRecipient = null;
        emailErrorMessage = null;
        
        StateHasChanged();

        try
        {
            // Get the event link (absolute URL)
            var baseUri = Navigation.BaseUri.TrimEnd('/');
            var eventLink = $"{baseUri}/events";

            // Get recipient emails
            var recipientEmails = subscribedUsers
                .Where(u => !string.IsNullOrWhiteSpace(u.Email))
                .Select(u => u.Email!)
                .ToList();

            // Build recipient data dictionary with nickname and full name
            var recipientData = subscribedUsers
                .Where(u => !string.IsNullOrWhiteSpace(u.Email))
                .ToDictionary(
                    u => u.Email!,
                    u => (
                        nickname: u.Nickname ?? "",
                        fullName: $"{u.FirstName ?? ""} {u.LastName ?? ""}".Trim()
                    )
                );

            // Create progress reporter
            var progress = new Progress<EmailSendProgress>(update =>
            {
                EmailsTotal = update.Total;
                EmailsSent = update.Sent;
                LastRecipient = update.LastRecipient;
                StateHasChanged();
            });

            // Send the appropriate notification based on selected type
            (bool success, int count, string? errorMessage) result;
            
            if (selectedNotificationType == NotificationTypeReminder)
            {
                // Send reminder notification
                result = await EmailNotificationService.SendEventReminderNotificationAsync(
                    selectedEventForEmail.Id,
                    selectedEventForEmail.Name,
                    selectedEventForEmail.Date,
                    selectedEventForEmail.Location,
                    eventLink,
                    recipientEmails,
                    recipientData,
                    selectedEventForEmail.Description ?? "",
                    selectedEventForEmail.EndDate,
                    progress
                );
            }
            else
            {
                // Send new event notification
                result = await EmailNotificationService.SendEventNotificationAsync(
                    selectedEventForEmail.Id,
                    selectedEventForEmail.Name,
                    selectedEventForEmail.Date,
                    selectedEventForEmail.Location,
                    eventLink,
                    recipientEmails,
                    recipientData,
                    selectedEventForEmail.Description ?? "",
                    selectedEventForEmail.EndDate,
                    progress
                );
            }

            if (result.success)
            {
                // Success - close modal
                emailErrorMessage = null;
                CloseEmailNotificationModal();
            }
            else
            {
                emailErrorMessage = result.errorMessage ?? "Erro ao enviar notificação.";
            }
        }
        catch (Exception ex)
        {
            emailErrorMessage = $"Erro ao enviar notificação: {ex.Message}";
        }
        finally
        {
            IsSendingEmails = false;
            StateHasChanged();
        }
    }

    // Push notification methods
    private async Task OpenPushNotificationModal(Event eventItem)
    {
        selectedEventForPush = eventItem;
        pushLoadingSubscribers = true;
        pushErrorMessage = null;
        customNotificationBody = string.Empty;
        filterOnlyLeitaoAndCaloiro = false;
        modals.Open(ModalType.PushNotification);
        StateHasChanged();

        try
        {
            // Get all user IDs with active push subscriptions via service
            var userIdsWithPushSubscriptions = (await PushNotificationService.GetSubscribedUserIdsAsync()).ToHashSet();

            // Get all users
            var allUsers = await UserManager.Users.AsNoTracking().ToListAsync();
            
            // Split users into subscribed (has push subscriptions) and non-subscribed
            pushSubscribedUsers = allUsers
                .Where(u => userIdsWithPushSubscriptions.Contains(u.Id))
                .OrderBy(u => u.Nickname ?? u.FirstName)
                .ToList();
            
            pushNonSubscribedUsers = allUsers
                .Where(u => !userIdsWithPushSubscriptions.Contains(u.Id))
                .OrderBy(u => u.Nickname ?? u.FirstName)
                .ToList();
            
            ApplyPushNotificationFilter();
        }
        catch (Exception ex)
        {
            pushErrorMessage = $"Erro ao carregar membros: {ex.Message}";
        }
        finally
        {
            pushLoadingSubscribers = false;
            StateHasChanged();
        }
    }

    private void ClosePushNotificationModal()
    {
        modals.Close(ModalType.PushNotification);
        selectedEventForPush = null;
        pushSubscribedUsers = null;
        pushNonSubscribedUsers = null;
        pushFilteredSubscribedUsers = null;
        pushFilteredNonSubscribedUsers = null;
        pushSubscribedUsersCount = 0;
        pushTotalUsersCount = 0;
        pushErrorMessage = null;
        customNotificationBody = string.Empty;
        filterOnlyLeitaoAndCaloiro = false;
    }

    private async Task SendPushNotification()
    {
        if (selectedEventForPush == null || pushFilteredSubscribedUsers == null || !pushFilteredSubscribedUsers.Any())
        {
            ClosePushNotificationModal();
            return;
        }

        if (string.IsNullOrWhiteSpace(customNotificationBody))
        {
            pushErrorMessage = "A mensagem da notificação é obrigatória.";
            return;
        }

        IsSendingPushNotifications = true;
        pushErrorMessage = null;
        StateHasChanged();

        try
        {
            // Get the base URL
            var baseUri = Navigation.BaseUri.TrimEnd('/');

            // Create the push notification using the factory
            SendPushNotificationDto notification;
            try
            {
                notification = PushNotificationFactory.CreateEventCustomNotification(
                    selectedEventForPush,
                    customNotificationBody!,
                    baseUri);
            }
            catch (ArgumentException ex)
            {
                pushErrorMessage = ex.Message;
                IsSendingPushNotifications = false;
                StateHasChanged();
                return;
            }

            // Send to filtered subscribed users only
            var recipientIds = pushFilteredSubscribedUsers.Select(u => u.Id).ToList();
            await PushNotificationService.SendToSelectedUsersAsync(recipientIds, notification);

            // Audit logging for push notification
            try
            {
                var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
                var user = authState.User;
                var userId = user?.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                var userName = user?.Identity?.Name;

                if (!string.IsNullOrEmpty(userId) && !string.IsNullOrEmpty(userName))
                {
                    var changes = JsonSerializer.Serialize(new
                    {
                        RecipientCount = recipientIds.Count,
                        NotificationBody = customNotificationBody
                    });

                    var auditLog = new AuditLog
                    {
                        EntityType = "Event",
                        EntityId = selectedEventForPush.Id,
                        Action = "PushNotificationSent",
                        UserId = userId,
                        UserName = userName,
                        Timestamp = DateTime.UtcNow,
                        Changes = changes,
                        EntityDisplayName = selectedEventForPush.Name,
                        IsCriticalAction = false
                    };

                    await AuditLogService.AddAsync(auditLog);
                }
            }
            catch (Exception auditEx)
            {
                // Log error but don't fail the operation
                Logger.LogError(auditEx, "Failed to create audit log for push notification sent to event {EventId}", selectedEventForPush.Id);
            }

            // Success - close modal
            ClosePushNotificationModal();
        }
        catch (Exception ex)
        {
            pushErrorMessage = $"Erro ao enviar notificação push: {ex.Message}";
        }
        finally
        {
            IsSendingPushNotifications = false;
            StateHasChanged();
        }
    }

    private void ApplyPushNotificationFilter()
    {
        if (filterOnlyLeitaoAndCaloiro)
        {
            // Filter to include ONLY users with Leitao OR Caloiro category
            pushFilteredSubscribedUsers = pushSubscribedUsers?
                .Where(u => u.IsLeitao() || u.IsCaloiro())
                .ToList();

            pushFilteredNonSubscribedUsers = pushNonSubscribedUsers?
                .Where(u => u.IsLeitao() || u.IsCaloiro())
                .ToList();
        }
        else
        {
            // No filter - use original lists directly
            pushFilteredSubscribedUsers = pushSubscribedUsers;
            pushFilteredNonSubscribedUsers = pushNonSubscribedUsers;
        }

        // Update counts based on filtered lists
        pushSubscribedUsersCount = pushFilteredSubscribedUsers?.Count ?? 0;
        pushTotalUsersCount = (pushFilteredSubscribedUsers?.Count ?? 0) + (pushFilteredNonSubscribedUsers?.Count ?? 0);
    }

    private void OnEventFilterChanged()
    {
