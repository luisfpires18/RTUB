    private async Task SaveEvent()
    {
        if (editingEvent == null) return;

        // Clear any validation errors
        dateValidationError = string.Empty;

        if (isCreateMode)
        {
            // Upload image BEFORE creating entity to include in single Create audit log
            string? imageUrl = null;
            if (croppedImageBytes != null && croppedImageBytes.Length > 0)
            {
                using var stream = new MemoryStream(croppedImageBytes);
                var normalizedName = S3KeyNormalizer.NormalizeForS3Key(editingEvent.Name);
                imageUrl = await ImageStorageService.UploadImageAsync(stream, croppedImageFileName!, "image/webp", "events", normalizedName);
            }

            var createdEvent = await EventService.CreateEventAsync(
                editingEvent.Name,
                editingEvent.Date,
                editingEvent.Location,
                editingEvent.Type,
                editingEvent.Description ?? string.Empty,
                editingEvent.EndDate,
                imageUrl
            );

            // Broadcast push notification for new event
            try
            {
                var baseUri = Navigation.BaseUri.TrimEnd('/');
                var notification = PushNotificationFactory.CreateEventNotification(createdEvent, isReminder: false, baseUri);
                await PushNotificationService.BroadcastAsync(notification);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to broadcast push notification for new event {EventId}", createdEvent.Id);
            }
        }
        else
        {
            // Check if we're updating both details and image - combine into single transaction to avoid duplicate audit logs
            if (croppedImageBytes != null && croppedImageBytes.Length > 0 && uploadedImagePath != null)
            {
                using var stream = new MemoryStream(croppedImageBytes);
                await EventService.UpdateEventWithImageAsync(
                    editingEvent.Id,
                    editingEvent.Name,
                    editingEvent.Date,
                    editingEvent.Location,
                    editingEvent.Description ?? string.Empty,
                    editingEvent.Type,
                    editingEvent.EndDate,
                    stream,
                    croppedImageFileName!,
                    "image/webp");
                imageRefreshTrigger++;
            }
            else
            {
                // Only updating event details (no new image)
                await EventService.UpdateEventAsync(
                    editingEvent.Id,
                    editingEvent.Name,
                    editingEvent.Date,
                    editingEvent.Location,
                    editingEvent.Description ?? string.Empty,
                    editingEvent.Type,
                    editingEvent.EndDate
                );
            }
        }

        // Reload all event-related data to ensure UI is fully updated
        await LoadAllEvents();
        await LoadEnrollments();
        await LoadEventRepertoires();
        await LoadDiscussionPosts();
        
        eventListRefreshTrigger++; // Increment to force component re-render
        StateHasChanged(); // Force UI refresh before closing modal
        CloseEditModal();
    }

