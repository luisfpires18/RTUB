    private async Task CopyLinkToClipboard()
    {
        try
        {
            var absoluteUrl = Navigation.ToAbsoluteUri(Navigation.Uri).ToString();
            await JSRuntime.InvokeVoidAsync("clipboardCopy.copyText", absoluteUrl);
            copyLinkFeedbackMessage = "Link copiado!";
            copyLinkFeedbackIsError = false;
            
            // Auto-dismiss success message after 2 seconds
            _copyLinkFeedbackTimer?.Dispose();
            _copyLinkFeedbackTimer = new System.Threading.Timer(_ =>
            {
                _ = InvokeAsync(() =>
                {
                    ClearCopyLinkFeedback();
                    StateHasChanged();
                });
            }, null, 2000, Timeout.Infinite);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to copy link: {ex.Message}");
            copyLinkFeedbackMessage = "Não foi possível copiar o link";
            copyLinkFeedbackIsError = true;
        }
        
        StateHasChanged();
    }
    
    private void ClearCopyLinkFeedback()
    {
        copyLinkFeedbackMessage = string.Empty;
        copyLinkFeedbackIsError = false;
        _copyLinkFeedbackTimer?.Dispose();
        _copyLinkFeedbackTimer = null;
    }
    
    public void Dispose()
    {
        _copyLinkFeedbackTimer?.Dispose();
    }
