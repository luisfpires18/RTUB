@page "/events/{eventId:int}/enrollments"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using RTUB.Application.Helpers
@using RTUB.Application.Interfaces
@using RTUB.Application.Extensions
@using RTUB.Shared
@using RTUB.Shared.Base
@using RTUB.Shared.Components.UI
@using RTUB.Shared.Components.Cards
@implements IDisposable
@attribute [Authorize]
@inject IEventService EventService
@inject IEnrollmentService EnrollmentService
@inject IEnrollmentFilterService EnrollmentFilterService
@inject IEnrollmentStatisticsService EnrollmentStatisticsService
@inject IMemberInstrumentService MemberInstrumentService
@inject IUserProfileService UserProfileService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Inscrições - @(selectedEvent?.Name ?? "Evento")</PageTitle>

<div class="enrollments-page-wrapper">
    @if (selectedEvent == null)
    {
        <LoadingSpinner />
    }
    else
    {
        <div class="enrollments-inner">
            <!-- Page Header -->
            <div class="page-header-centered">
                <div class="page-header-left d-none d-xl-flex">
                    <button class="btn btn-outline-secondary btn-sm" @onclick="NavigateBack">
                        <i class="bi bi-arrow-left"></i>
                    </button>
                </div>
                <div class="page-header-center">
                    <h1><i class="bi bi-people"></i> Inscrições</h1>
                    <p class="lead page-header-subtitle text-light-theme">@selectedEvent.Name</p>
                </div>
                <div class="page-header-right d-none d-xl-flex">
                    <button class="btn btn-outline-primary btn-sm me-2" @onclick="NavigateToContacts" title="Contactos">
                        <i class="bi bi-telephone"></i>
                    </button>
                    @if (isUserAdmin)
                    {
                        <button class="btn btn-outline-secondary btn-sm" @onclick="CopyLinkToClipboard" title="Copiar link">
                            <i class="bi bi-link-45deg"></i>
                        </button>
                    }
                </div>
            </div>
                
                @* Copy Link Feedback Alert *@
                @if (!string.IsNullOrEmpty(copyLinkFeedbackMessage))
                {
                    <Alert Type="@(copyLinkFeedbackIsError ? Alert.AlertType.Error : Alert.AlertType.Success)"
                           Message="@copyLinkFeedbackMessage"
                           Dismissible="true"
                           OnDismiss="ClearCopyLinkFeedback"
                           AdditionalClasses="mb-0" />
                }

        <!-- My Enrollment Section (for non-past, non-cancelled events) -->
        @if (!selectedEvent.IsCancelled && selectedEvent.Date.Date >= DateTime.Today)
        {
            <div class="card participation-card mb-4">
                <div class="card-body">
                    <h6 class="mb-3">
                        <i class="bi bi-person-check text-primary me-2"></i>A tua participação
                    </h6>

                    @if (userEnrollment != null)
                    {
                        <div class="participation-details mb-3">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="status-pill @(userEnrollment.WillAttend ? "going" : "not-going")">
                                    <i class="@(userEnrollment.WillAttend ? "bi bi-check-circle" : "bi bi-x-circle") me-2"></i>
                                    @(userEnrollment.WillAttend ? "VOU" : "NÃO VOU")
                                </span>
                                @if (userEnrollment.WillAttend && userEnrollment.Instrument.HasValue)
                                {
                                    <span class="instrument-chip">
                                        <i class="bi bi-music-note-beamed me-2"></i>
                                        @StatusHelper.GetInstrumentDisplay(userEnrollment.Instrument.Value)
                                    </span>
                                }
                            </div>

                            @if (!string.IsNullOrEmpty(userEnrollment.Notes))
                            {
                                <div class="note-line">
                                    <i class="bi bi-file-text me-2"></i>
                                    <span>@userEnrollment.Notes</span>
                                </div>
                            }
                        </div>
                    }

                    <div class="participation-toggle-row">
                        <button class="@GetParticipationButtonClasses(true)" @onclick="@(() => OpenEnrollModalWithParticipation(true))" aria-label="Vou">
                            <span class="toggle-inner"><i class="bi bi-check-lg"></i></span>
                        </button>
                        <button class="@GetParticipationButtonClasses(false)" @onclick="@(() => OpenEnrollModalWithParticipation(false))" aria-label="Não vou">
                            <span class="toggle-inner"><i class="bi bi-x-lg"></i></span>
                        </button>
                    </div>
                </div>
            </div>
        }

        <!-- Enrollment Content -->
        @if (eventEnrollments != null && eventEnrollments.Any())
        {
            var performingMembers = eventEnrollments.Where(e => e.User != null && e.WillAttend && e.EffectiveCategory() != MemberCategory.Leitao).ToList();
            var leitaoMembers = eventEnrollments.Where(e => e.User != null && e.WillAttend && e.EffectiveCategory() == MemberCategory.Leitao).ToList();
            var notAttendingMembers = eventEnrollments.Where(e => e.User != null && !e.WillAttend).ToList();

            @if (performingMembers.Any())
            {
                <h6 class="mb-3 heading-purple">Membros (@performingMembers.Count)</h6>

                <!-- Search Control -->
                <SearchBar @bind-Value="enrollmentSearchTerm"
                           Placeholder="Pesquisar por nome..."
                           OnSearch="HandleEnrollmentSearch" />
                
                <div class="enrollment-card-grid-compact mb-4">
                    @foreach (var enrollment in paginatedPerformingMembers)
                    {
                        <EnrollmentCard @key="enrollment.Id" 
                            AvatarUrl="@enrollment.User?.ProfilePictureSrc"
                            TunaName="@enrollment.User?.Nickname"
                            FullName="@($"{enrollment.User?.FirstName} {enrollment.User?.LastName}".Trim())"
                            InstrumentText="@(enrollment.Instrument.HasValue ? StatusHelper.GetInstrumentDisplay(enrollment.Instrument.Value) : "")"
                            OtherInstruments="@enrollment.OtherInstruments"
                            Notes="@enrollment.Notes"
                            AltText="@enrollment.User?.GetDisplayName()"
                            ShowEditButton="false"
                            ShowDeleteButton="@CanDeleteEnrollment(enrollment)"
                            OnDelete="@(() => OpenDeleteEnrollmentModal(enrollment))"
                            DeleteTooltip="Eliminar Inscrição">
                            <BadgeContent>
                                @if (enrollment.User != null)
                                {
                                    <div class="enrollment-card-badges-row">
                                        @{
                                            var __pmCat = enrollment.EffectiveCategory();
                                        }
                                        @if (enrollment.User.Positions.Contains(Position.Magister))
                                        {
                                            <PositionBadge Position="Position.Magister" />
                                        }
                                        else if (__pmCat == MemberCategory.Tuno)
                                        {
                                            <CategoryBadge Category="MemberCategory.Tuno" />
                                        }
                                        else if (__pmCat == MemberCategory.Caloiro)
                                        {
                                            <CategoryBadge Category="MemberCategory.Caloiro" />
                                        }
                                    </div>
                                }
                            </BadgeContent>
                        </EnrollmentCard>
                    }
                </div>

                <!-- Pagination for Performing Members -->
                @if (filteredPerformingMembers.Count > 0)
                {
                    <div class="mb-3">
                        <TablePagination 
                            TotalItems="@filteredPerformingMembers.Count"
                            CurrentPage="@performingMembersPagination.CurrentPage"
                            PageSize="@performingMembersPagination.PageSize"
                            PageSizeOptions="@(new[] { 12, 18, 24, 30 })"
                            OnPageChanged="@HandlePerformingMembersPageChange"
                            OnPageSizeChanged="@HandlePerformingMembersPageSizeChange" />
                    </div>
                }

                @* Instrument Counts - Horizontal Counter Section *@
                <InstrumentCounter InstrumentCounts="@primaryInstrumentCounts" Title="Instrumentos" />
                <InstrumentCounter InstrumentCounts="@otherInstrumentCounts" Title="Outros Instrumentos" Collapsible="true" DefaultCollapsed="true" />
            }

            @if (leitaoMembers.Any())
            {
                <h6 class="mb-3 heading-warning">Leitões (@leitaoMembers.Count)</h6>
                <div class="enrollment-card-grid-compact">
                    @foreach (var enrollment in paginatedLeitoes)
                    {
                        <EnrollmentCard @key="enrollment.Id" 
                            AvatarUrl="@enrollment.User?.ProfilePictureSrc"
                            TunaName="@enrollment.User?.Nickname"
                            FullName="@($"{enrollment.User?.FirstName} {enrollment.User?.LastName}".Trim())"
                            InstrumentText=""
                            OtherInstruments=""
                            Notes="@enrollment.Notes"
                            AltText="@enrollment.User?.GetDisplayName()"
                            ShowEditButton="false"
                            ShowDeleteButton="@CanDeleteEnrollment(enrollment)"
                            OnDelete="@(() => OpenDeleteEnrollmentModal(enrollment))"
                            DeleteTooltip="Eliminar Inscrição">
                            <BadgeContent>
                                <div class="enrollment-card-badges-row">
                                    <CategoryBadge Category="MemberCategory.Leitao" />
                                </div>
                            </BadgeContent>
                        </EnrollmentCard>
                    }
                </div>
                
                <!-- Pagination for Leitões -->
                @if (filteredLeitoes.Count > 0)
                {
                    <div class="mt-3">
                        <TablePagination 
                            TotalItems="@filteredLeitoes.Count"
                            CurrentPage="@leitoesPagination.CurrentPage"
                            PageSize="@leitoesPagination.PageSize"
                            PageSizeOptions="@(new[] { 12, 18, 24, 30 })"
                            OnPageChanged="@HandleLeitoesPageChange"
                            OnPageSizeChanged="@HandleLeitoesPageSizeChange" />
                    </div>
                }
            }

            @if (notAttendingMembers.Any())
            {
                <h6 class="mb-3 mt-4 heading-danger">Não vão participar (@filteredNotAttending.Count)</h6>
                <div class="enrollment-card-grid-compact">
                    @foreach (var enrollment in paginatedNotAttending)
                    {
                        <EnrollmentCard @key="enrollment.Id" 
                            AvatarUrl="@enrollment.User?.ProfilePictureSrc"
                            TunaName="@enrollment.User?.Nickname"
                            FullName="@($"{enrollment.User?.FirstName} {enrollment.User?.LastName}".Trim())"
                            InstrumentText=""
                            OtherInstruments=""
                            Notes="@enrollment.Notes"
                            AltText="@enrollment.User?.GetDisplayName()"
                            ShowEditButton="false"
                            ShowDeleteButton="@CanDeleteEnrollment(enrollment)"
                            OnDelete="@(() => OpenDeleteEnrollmentModal(enrollment))"
                            DeleteTooltip="Eliminar Inscrição">
                            <BadgeContent>
                                @if (enrollment.User != null)
                                {
                                    <div class="enrollment-card-badges-row">
                                        @{
                                            var __naCat = enrollment.EffectiveCategory();
                                        }
                                        @if (enrollment.User.Positions.Contains(Position.Magister))
                                        {
                                            <PositionBadge Position="Position.Magister" />
                                        }
                                        else if (__naCat == MemberCategory.Tuno)
                                        {
                                            <CategoryBadge Category="MemberCategory.Tuno" />
                                        }
                                        else if (__naCat == MemberCategory.Caloiro)
                                        {
                                            <CategoryBadge Category="MemberCategory.Caloiro" />
                                        }
                                        else if (__naCat == MemberCategory.Leitao)
                                        {
                                            <CategoryBadge Category="MemberCategory.Leitao" />
                                        }
                                    </div>
                                }
                            </BadgeContent>
                        </EnrollmentCard>
                    }
                </div>
                
                <!-- Pagination for Not Attending Members -->
                @if (filteredNotAttending.Count > 0)
                {
                    <div class="mt-3">
                        <TablePagination 
                            TotalItems="@filteredNotAttending.Count"
                            CurrentPage="@notAttendingPagination.CurrentPage"
                            PageSize="@notAttendingPagination.PageSize"
                            PageSizeOptions="@(new[] { 12, 18, 24, 30 })"
                            OnPageChanged="@HandleNotAttendingPageChange"
                            OnPageSizeChanged="@HandleNotAttendingPageSizeChange" />
                    </div>
                }
            }
        }
        else
        {
            <EmptyState Title="Nenhuma inscrição ainda para este evento"
                       Icon="bi-people" />
        }
        
        <AuthorizeView Roles="Admin">
            <Authorized>
                <div class="mt-3">
                    <!-- Success Alert (auto-dismiss) -->
                    @if (!string.IsNullOrEmpty(addMemberToEnrollmentFeedbackMessage) && !addMemberToEnrollmentFeedbackIsError)
                    {
                        <Alert Type="Alert.AlertType.Purple"
                               Title="@addMemberToEnrollmentFeedbackMessage"
                               Dismissible="true"
                               OnDismiss="ClearAddMemberToEnrollmentFeedback"
                               AdditionalClasses="mb-2" />
                    }

                    <!-- Error Alert (manual dismiss) -->
                    @if (!string.IsNullOrEmpty(addMemberToEnrollmentFeedbackMessage) && addMemberToEnrollmentFeedbackIsError)
                    {
                        <Alert Type="Alert.AlertType.Error"
                               Title="@addMemberToEnrollmentFeedbackMessage"
                               Dismissible="true"
                               OnDismiss="ClearAddMemberToEnrollmentFeedback"
                               AdditionalClasses="mb-2" />
                    }

                    @if (!showAddMemberToEnrollmentSearch)
                    {
                        <button class="btn btn-sm btn-outline-primary" @onclick="ShowAddMemberToEnrollmentSearch">
                            <i class="bi bi-plus-circle"></i>
                            Adicionar Membro
                        </button>
                    }
                    else
                    {
                        <div class="mb-2">
                            <SearchBar @bind-Value="addMemberToEnrollmentSearchTerm"
                                       Placeholder="Pesquisar membro por nome..."
                                       OnSearch="@HandleAddMemberToEnrollmentSearchChanged" />

                            @if (!string.IsNullOrWhiteSpace(addMemberToEnrollmentSearchTerm) && filteredAvailableMembersForEnrollment.Any())
                            {
                                <div class="member-list member-list-scrollable mt-2">
                                    @foreach (var member in filteredAvailableMembersForEnrollment)
                                    {
                                        <div class="member-item p-2 mb-2 border rounded clickable-row"
                                             @onclick="() => AddMemberToEvent(member)"
                                             tabindex="0"
                                             @onkeydown="@(async (e) => await HandleMemberItemKeyDownForEnrollment(e, member))">
                                            <div class="d-flex align-items-center">
                                                <img src="@member.ProfilePictureSrc" alt="@member.GetDisplayName()"
                                                     class="member-avatar-small me-2" />
                                                <div>
                                                    <strong>@member.GetDisplayName()</strong>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else if (!string.IsNullOrWhiteSpace(addMemberToEnrollmentSearchTerm))
                            {
                                <p class="text-muted mt-2">Nenhum membro encontrado.</p>
                            }
                        </div>

                        <button class="btn btn-sm btn-outline-secondary" @onclick="HideAddMemberToEnrollmentSearch">
                            <i class="bi bi-x-circle"></i>
                            Cancelar
                        </button>
                    }
                </div>
            </Authorized>
        </AuthorizeView>
        </div>
    }
</div>

<!-- Mobile Bottom Nav -->
<MobileBottomNav Items="@mobileNavItems" ActiveKey="" OnSelect="HandleMobileNavSelect" />

<!-- Participation Modal (Enrollment Modal) -->
@if (enrollmentForm != null)
{
    <ParticipationModal Show="@modals.IsOpen(ModalType.Enroll)"
                       ShowChanged="@((bool show) => modals.Toggle(ModalType.Enroll, show))"
                       Title="@GetEnrollmentModalTitle()"
                       ShowWillAttend="@(!isParticipationPreSelected)"
                       WillAttend="@enrollmentForm.WillAttend"
                       WillAttendChanged="@((bool value) => enrollmentForm.WillAttend = value)"
                       IsLeitao="@isCurrentUserLeitao"
                       Instrument="@enrollmentForm.Instrument"
                       InstrumentChanged="@((InstrumentType? value) => enrollmentForm.Instrument = value)"
                       AvailableInstruments="@availableInstruments"
                       Notes="@enrollmentForm.Notes"
                       NotesChanged="@((string value) => enrollmentForm.Notes = value)"
                       NotesRows="4"
                       NotesPlaceholder="@(enrollmentForm.WillAttend ? "Informações adicionais..." : "Motivo da impossibilidade...")"
                       SubmitButtonText="@(isEditingEnrollment ? "Atualizar" : "Confirmar")"
                       WantToPlay="@wantToPlay"
                       WantToPlayChanged="@((bool value) => wantToPlay = value)"
                       OnSubmit="@SaveEnrollment"
                       OnCancel="@CloseEnrollModal" />
}

<!-- Delete Enrollment Confirmation Modal -->
<ConfirmDialog Show="@modals.IsOpen(ModalType.DeleteEnrollment)"
               ShowChanged="@((bool show) => modals.Toggle(ModalType.DeleteEnrollment, show))"
               Title="Confirmar Eliminação de Inscrição"
               Message="@($"Tem a certeza que deseja eliminar a inscrição de {deletingEnrollment?.User?.GetDisplayName()} neste evento?")"
               WarningMessage="Esta ação não pode ser revertida."
               ConfirmText="Eliminar"
               CancelText="Cancelar"
               ConfirmButtonClass="btn-danger"
               OnConfirm="DeleteEnrollment"
               OnCancel="CloseDeleteEnrollmentModal" />

@code {
    [Parameter]
    public int EventId { get; set; }

    private Event? selectedEvent;
    private List<Enrollment>? eventEnrollments;
    private string? currentUserId;
    private bool isCurrentUserLeitao = false;
    private bool isUserAdmin = false;
    private enum ModalType { DeleteEnrollment, Enroll }
    private readonly MultiModalState<ModalType> modals = new();
    private Enrollment? deletingEnrollment;
    
    // Mobile bottom nav
    private IReadOnlyList<MobileBottomNav.MobileNavItem> mobileNavItems = Array.Empty<MobileBottomNav.MobileNavItem>();
    
    // User's own enrollment state
    private Enrollment? userEnrollment;
    private bool isEditingEnrollment = false;
    private bool isParticipationPreSelected = false;
    private bool wantToPlay = false;
    private Enrollment? enrollmentForm;
    private List<MemberInstrument>? currentUserInstruments;
    private List<InstrumentType>? availableInstruments;
    
    // Enrollment modal filter variables
    private string enrollmentSearchTerm = string.Empty;
    private List<Enrollment> filteredPerformingMembers = new();
    private List<Enrollment> filteredLeitoes = new();
    private List<Enrollment> filteredNotAttending = new();
    
    // Instrument count tracking
    private Dictionary<InstrumentType, int> primaryInstrumentCounts = new();
    private Dictionary<InstrumentType, int> otherInstrumentCounts = new();
    
    // Pagination for enrollment sections
    private PaginationHelper<Enrollment> performingMembersPagination = new() { PageSize = 18 };
    private PaginationHelper<Enrollment> leitoesPagination = new() { PageSize = 18 };
    private PaginationHelper<Enrollment> notAttendingPagination = new() { PageSize = 18 };
    private List<Enrollment> paginatedPerformingMembers => performingMembersPagination.GetPageData(filteredPerformingMembers ?? new List<Enrollment>());
    private List<Enrollment> paginatedLeitoes => leitoesPagination.GetPageData(filteredLeitoes ?? new List<Enrollment>());
    private List<Enrollment> paginatedNotAttending => notAttendingPagination.GetPageData(filteredNotAttending ?? new List<Enrollment>());
    
    // Copy link feedback variables
    private string copyLinkFeedbackMessage = string.Empty;
    private bool copyLinkFeedbackIsError = false;
    private System.Threading.Timer? _copyLinkFeedbackTimer;
    
    // Add member to enrollment variables
    private List<ApplicationUser> allMembersForEnrollment = new();
    private List<ApplicationUser> filteredAvailableMembersForEnrollment = new();
    private string addMemberToEnrollmentSearchTerm = string.Empty;
    private string addMemberToEnrollmentFeedbackMessage = string.Empty;
    private bool addMemberToEnrollmentFeedbackIsError = false;
    private bool showAddMemberToEnrollmentSearch = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        
        if (user.Identity?.IsAuthenticated == true)
        {
            currentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            
            isUserAdmin = user.IsInRole("Admin");
            
            // Load user's category to determine if Leitão (needed for modal)
            // and instruments for the enrollment modal (once during initialization)
            if (!string.IsNullOrEmpty(currentUserId))
            {
                // Get user categories without tracking (service handles DbContext)
                var userCategories = await UserProfileService.GetUserCategoriesAsync(currentUserId);
                isCurrentUserLeitao = userCategories.Contains(MemberCategory.Leitao);
                
                currentUserInstruments = (await MemberInstrumentService.GetMemberInstrumentsAsync(currentUserId)).ToList();
                availableInstruments = currentUserInstruments.Select(mi => mi.InstrumentType).ToList();
            }
        }
        
        await LoadEventAndEnrollments();
        BuildMobileNavItems();
    }

    private void BuildMobileNavItems()
    {
        var items = new List<MobileBottomNav.MobileNavItem>
        {
            new("action-back", "Voltar", "bi-arrow-left")
        };

        items.Add(new("action-contacts", "Contactos", "bi-telephone"));
        if (isUserAdmin)
        {
            items.Add(new("action-copy", "Copiar Link", "bi-link-45deg"));
        }

        mobileNavItems = items;
    }

    private async Task HandleMobileNavSelect(string key)
    {
        if (key == "action-back")
        {
            NavigateBack();
        }
        else if (key == "action-contacts")
        {
            NavigateToContacts();
        }
        else if (key == "action-copy")
        {
            await CopyLinkToClipboard();
        }
    }

    private async Task LoadEventAndEnrollments()
    {
        selectedEvent = await EventService.GetEventByIdAsync(EventId);
        if (selectedEvent == null)
        {
            Navigation.NavigateTo("/events");
            return;
        }
        
        eventEnrollments = (await EnrollmentService.GetEnrollmentsByEventIdAsync(EventId)).ToList();
        
        // Load current user's enrollment
        if (!string.IsNullOrEmpty(currentUserId))
        {
            userEnrollment = eventEnrollments.FirstOrDefault(e => e.UserId == currentUserId);
        }
        
        enrollmentSearchTerm = string.Empty;
        FilterEnrollments();
        
        // Calculate primary and other instrument counts
        await CalculateInstrumentCountsAsync();
        
        // Load all members for adding if admin
        if (isUserAdmin)
        {
            // Project to new objects to avoid tracking issues
            allMembersForEnrollment = await UserManager.Users
                .Select(u => new ApplicationUser
                {
                    Id = u.Id,
                    FirstName = u.FirstName,
                    LastName = u.LastName,
                    Nickname = u.Nickname,
                    ImageUrl = u.ImageUrl
                })
                .ToListAsync();
            addMemberToEnrollmentSearchTerm = string.Empty;
            addMemberToEnrollmentFeedbackMessage = string.Empty;
            FilterAvailableMembersForEnrollment();
        }
    }

    // Enrollment Modal Methods (reused from Events.razor)
    
    private string GetParticipationButtonClasses(bool willAttend)
    {
        var isSelected = userEnrollment?.WillAttend == willAttend;
        var baseClass = willAttend ? "participation-toggle going" : "participation-toggle not-going";
        var stateClass = isSelected ? "is-selected" : "is-unselected";

        return $"{baseClass} {stateClass}";
    }

    private void OpenEnrollModalWithParticipation(bool willParticipate)
    {
        if (string.IsNullOrEmpty(currentUserId) || selectedEvent == null) return;

        isParticipationPreSelected = true; // Hide WillAttend selection when pre-selected from buttons

        if (userEnrollment != null)
        {
            isEditingEnrollment = true;
            wantToPlay = userEnrollment.Instrument.HasValue;

            enrollmentForm = new Enrollment
            {
                Id = userEnrollment.Id,
                UserId = userEnrollment.UserId,
                EventId = userEnrollment.EventId,
                Instrument = userEnrollment.Instrument,
                Notes = userEnrollment.Notes,
                OtherInstruments = userEnrollment.OtherInstruments,
                WillAttend = willParticipate
            };
        }
        else
        {
            isEditingEnrollment = false;

            var (defaultInstrument, shouldWantToPlay) = GetDefaultInstrumentSettings();
            wantToPlay = shouldWantToPlay;

            enrollmentForm = new Enrollment
            {
                UserId = currentUserId,
                EventId = selectedEvent.Id,
                Instrument = defaultInstrument,
                Notes = string.Empty,
                WillAttend = willParticipate
            };
        }

        modals.Open(ModalType.Enroll);
    }
    
    private (InstrumentType? defaultInstrument, bool wantToPlay) GetDefaultInstrumentSettings()
    {
        if (currentUserInstruments != null && currentUserInstruments.Any())
        {
            var primaryInstrument = currentUserInstruments.FirstOrDefault(mi => mi.IsPrimary);
            var defaultInstrument = primaryInstrument?.InstrumentType ?? currentUserInstruments.First().InstrumentType;
            return (defaultInstrument, true); // Enable "Quero tocar" if instruments are available
        }
        return (null, false); // Disable "Quero tocar" if no instruments configured
    }
    
    private string GetEnrollmentModalTitle()
    {
        if (selectedEvent == null) return "Participação";
        
        if (isEditingEnrollment)
        {
            return enrollmentForm?.WillAttend == true 
                ? "Editar Inscrição" 
                : $"Editar Impossibilidade em {selectedEvent.Name}";
        }
        
        return enrollmentForm?.WillAttend == true 
            ? $"Inscrever em {selectedEvent.Name}" 
            : $"Impossibilidade de inscrição em {selectedEvent.Name}";
    }
    
    private void CloseEnrollModal()
    {
        modals.Close(ModalType.Enroll);
        enrollmentForm = null;
        isEditingEnrollment = false;
        isParticipationPreSelected = false;
        wantToPlay = false;
    }
    
    private async Task SaveEnrollment()
    {
        if (enrollmentForm == null || string.IsNullOrEmpty(currentUserId)) return;

        InstrumentType? instrumentToSave = null;
        string? otherInstrumentsText = null;

        // Only process instrument info if wanting to play
        if (wantToPlay)
        {
            instrumentToSave = enrollmentForm.Instrument;
            
            // Get all member instruments and calculate other instruments
            var memberInstruments = await MemberInstrumentService.GetMemberInstrumentsAsync(currentUserId);
            
            if (enrollmentForm.Instrument.HasValue)
            {
                // Get all instruments except the selected one
                var otherInstruments = memberInstruments
                    .Where(mi => mi.InstrumentType != enrollmentForm.Instrument.Value)
                    .Select(mi => StatusHelper.GetInstrumentDisplay(mi.InstrumentType))
                    .ToList();
                
                if (otherInstruments.Any())
                {
                    otherInstrumentsText = string.Join(", ", otherInstruments);
                }
            }
        }

        if (isEditingEnrollment)
        {
            var existingEnrollment = await EnrollmentService.GetEnrollmentByIdAsync(enrollmentForm.Id);
            if (existingEnrollment != null && existingEnrollment.UserId == currentUserId)
            {
                // Update enrollment using the UpdateEnrollmentAsync method
                await EnrollmentService.UpdateEnrollmentAsync(
                    enrollmentForm.Id,
                    enrollmentForm.WillAttend,
                    instrumentToSave,
                    enrollmentForm.Notes,
                    otherInstrumentsText
                );
            }
        }
        else
        {
            // Check if enrollment already exists to prevent duplicate constraint violations
            var existingEnrollment = await EnrollmentService.GetEnrollmentByEventAndUserAsync(
                enrollmentForm.EventId,
                enrollmentForm.UserId
            );
            
            if (existingEnrollment != null)
            {
                // Update existing enrollment instead of creating duplicate
                await EnrollmentService.UpdateEnrollmentAsync(
                    existingEnrollment.Id,
                    enrollmentForm.WillAttend,
                    instrumentToSave,
                    enrollmentForm.Notes,
                    otherInstrumentsText
                );
            }
            else
            {
                // Create new enrollment
                await EnrollmentService.CreateEnrollmentAsync(
                    enrollmentForm.UserId,
                    enrollmentForm.EventId,
                    instrumentToSave,
                    enrollmentForm.Notes,
                    enrollmentForm.WillAttend,
                    otherInstrumentsText
                );
            }
        }

        // Reload enrollments to update UI
        await LoadEventAndEnrollments();
        CloseEnrollModal();
        StateHasChanged();
    }

