@page "/naipes/config"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using RTUB.Application.Interfaces
@using RTUB.Application.DTOs
@using RTUB.Core.Enums
@using RTUB.Shared
@attribute [Authorize(Roles = "Owner")]
@inject INaipeService NaipeService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JSRuntime

<div class="d-flex flex-column gap-3 mb-4">
    <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
        <div>
            <h1 class="mb-2"><i class="bi bi-sliders"></i> Configuração de Naipes</h1>
            <p class="lead page-header-subtitle mb-0 text-light-theme">Gerir tipos de instrumento para a página Naipes.</p>
        </div>

        <div class="page-header-actions justify-content-lg-end">
            <a href="/naipes" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Voltar aos Naipes
            </a>
        </div>
    </div>
</div>

@if (loading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">A carregar...</span>
        </div>
        <p class="mt-3">A carregar configurações...</p>
    </div>
}
else
{
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-music-note-list text-primary me-2"></i>Tipos de Instrumento</h5>
        </div>
        <div class="card-body">
            <p class="text-muted mb-4">Configure a visibilidade, ordem e imagem de cada tipo de instrumento. As alterações são guardadas automaticamente.</p>
            
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th style="width: 80px;">Imagem</th>
                            <th>Tipo de Instrumento</th>
                            <th style="width: 120px;">Ordem</th>
                            <th style="width: 120px;">Visível</th>
                            <th style="width: 150px;">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var config in typeConfigs)
                        {
                            <tr class="@(!config.IsVisible ? "table-secondary" : "")">
                                <td>
                                    @if (!string.IsNullOrEmpty(config.PictureUrl))
                                    {
                                        <img src="@config.PictureUrl" alt="@config.InstrumentTypeName" 
                                             class="rounded-circle border border-2 border-primary" 
                                             style="width: 50px; height: 50px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="rounded-circle bg-purple d-flex align-items-center justify-content-center" 
                                             style="width: 50px; height: 50px;">
                                            <i class="bi bi-music-note text-white fs-5"></i>
                                        </div>
                                    }
                                </td>
                                <td>
                                    <strong class="fs-5">@config.InstrumentTypeName</strong>
                                    @if (!config.IsVisible)
                                    {
                                        <span class="badge bg-secondary ms-2">Oculto</span>
                                    }
                                </td>
                                <td>
                                    <input type="number" class="form-control" 
                                           value="@config.SortOrder" 
                                           @onchange="@(e => UpdateSortOrder(config, int.TryParse(e.Value?.ToString(), out var v) ? v : 0))"
                                           min="0" max="999" />
                                </td>
                                <td>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" role="switch"
                                               id="visible-@config.Id"
                                               checked="@config.IsVisible"
                                               @onchange="@(e => UpdateVisibility(config, (bool)(e.Value ?? false)))" />
                                        <label class="form-check-label" for="visible-@config.Id">
                                            @(config.IsVisible ? "Sim" : "Não")
                                        </label>
                                    </div>
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-purple" @onclick="() => OpenImageUploadModal(config)" title="Alterar imagem">
                                        <i class="bi bi-camera"></i> Imagem
                                    </button>
                                    @if (!string.IsNullOrEmpty(config.PictureUrl))
                                    {
                                        <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => RemoveImage(config)" title="Remover imagem">
                                            <i class="bi bi-x"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            
            <div class="alert alert-info mt-4">
                <i class="bi bi-info-circle-fill me-2"></i>
                <strong>Dica:</strong> Números de ordem menores aparecem primeiro. Tipos ocultos não são mostrados na página Naipes.
            </div>
        </div>
    </div>
}

<!-- Image Upload Modal -->
<Modal @bind-Show="showImageModal" Title="@($"Imagem para {editingConfig?.InstrumentTypeName}")">
    <BodyContent>
        <div class="mb-3">
            <label class="form-label">Selecione uma imagem para este tipo de instrumento</label>
            <div class="localized-file-picker">
                <InputFile id="@imageInputId" 
                           @key="imageUploadKey"
                           class="d-none" 
                           OnChange="HandleImageSelected" 
                           accept="image/*" />
                <label class="btn btn-outline-secondary localized-file-button" for="@imageInputId">
                    <i class="bi bi-upload me-2"></i>Escolher imagem
                </label>
                <span class="localized-file-name">@(selectedFileName ?? "Nenhuma imagem selecionada")</span>
            </div>
            <small class="text-muted d-block mt-1">
                <i class="bi bi-info-circle me-1"></i>Formatos suportados: JPG, PNG, WebP. Tamanho máximo: 5MB
            </small>
        </div>
        @if (editingConfig?.PictureUrl != null)
        {
            <div class="mt-3 text-center">
                <small class="text-muted d-block mb-2">Imagem atual:</small>
                <img src="@editingConfig.PictureUrl" alt="Current" 
                     class="img-thumbnail rounded-circle" 
                     style="width: 120px; height: 120px; object-fit: cover;" />
            </div>
        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="CloseImageModal">Cancelar</button>
        <button type="button" class="btn btn-purple" @onclick="UploadImage" disabled="@(selectedFile == null || uploading)">
            @if (uploading)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                <span>A guardar...</span>
            }
            else
            {
                <i class="bi bi-upload me-1"></i>
                <span>Guardar Imagem</span>
            }
        </button>
    </FooterContent>
</Modal>

@code {
    private bool loading = true;
    private List<NaipeTypeConfigDto> typeConfigs = new();
    
    // Image upload state
    private bool showImageModal = false;
    private NaipeTypeConfigDto? editingConfig;
    private IBrowserFile? selectedFile;
    private string? selectedFileName;
    private bool uploading = false;
    private Guid imageUploadKey = Guid.NewGuid();
    private string imageInputId = $"naipe-type-image-{Guid.NewGuid():N}";

    protected override async Task OnInitializedAsync()
    {
        await LoadConfigs();
    }

    private async Task LoadConfigs()
    {
        loading = true;
        try
        {
            // Initialize configs if needed
            await NaipeService.InitializeTypeConfigsAsync();
            typeConfigs = await NaipeService.GetAllTypeConfigsAsync();
        }
        finally
        {
            loading = false;
        }
    }

    private async Task UpdateSortOrder(NaipeTypeConfigDto config, int newOrder)
    {
        try
        {
            await NaipeService.UpdateTypeConfigAsync(config.Id, config.PictureUrl, config.IsVisible, newOrder);
            config.SortOrder = newOrder;
            
            // Re-sort the list
            typeConfigs = typeConfigs.OrderBy(c => c.SortOrder).ThenBy(c => c.InstrumentTypeName).ToList();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Erro ao atualizar ordem: {ex.Message}");
        }
    }

    private async Task UpdateVisibility(NaipeTypeConfigDto config, bool isVisible)
    {
        try
        {
            await NaipeService.UpdateTypeConfigAsync(config.Id, config.PictureUrl, isVisible, config.SortOrder);
            config.IsVisible = isVisible;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Erro ao atualizar visibilidade: {ex.Message}");
        }
    }

    private void OpenImageUploadModal(NaipeTypeConfigDto config)
    {
        editingConfig = config;
        selectedFile = null;
        selectedFileName = null;
        imageUploadKey = Guid.NewGuid();
        showImageModal = true;
    }

    private void CloseImageModal()
    {
        showImageModal = false;
        editingConfig = null;
        selectedFile = null;
        selectedFileName = null;
    }

    private void HandleImageSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        var maxFileSize = 5 * 1024 * 1024; // 5MB
        
        if (file.Size > maxFileSize)
        {
            selectedFile = null;
            selectedFileName = null;
            return;
        }
        
        selectedFile = file;
        selectedFileName = file.Name;
        StateHasChanged();
    }

    private async Task UploadImage()
    {
        if (editingConfig == null || selectedFile == null)
            return;

        uploading = true;
        try
        {
            var maxFileSize = 5 * 1024 * 1024L;
            using var browserStream = selectedFile.OpenReadStream(maxFileSize);
            using var memoryStream = new MemoryStream();
            await browserStream.CopyToAsync(memoryStream);
            memoryStream.Position = 0;

            var newUrl = await NaipeService.UploadTypeConfigPictureAsync(
                editingConfig.Id,
                memoryStream,
                selectedFile.Name,
                selectedFile.ContentType
            );

            editingConfig.PictureUrl = newUrl;
            CloseImageModal();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Erro ao carregar imagem: {ex.Message}");
        }
        finally
        {
            uploading = false;
        }
    }

    private async Task RemoveImage(NaipeTypeConfigDto config)
    {
        try
        {
            await NaipeService.UpdateTypeConfigAsync(config.Id, null, config.IsVisible, config.SortOrder);
            config.PictureUrl = null;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Erro ao remover imagem: {ex.Message}");
        }
    }
}
