@page "/naipes/config"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using RTUB.Application.Interfaces
@using RTUB.Application.DTOs
@using RTUB.Core.Enums
@using RTUB.Shared
@attribute [Authorize(Roles = "Admin")]
@inject INaipeService NaipeService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JSRuntime

<div class="d-flex flex-column gap-3 mb-4">
    <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
        <div>
            <h1 class="mb-2"><i class="bi bi-sliders"></i> Configuração de Naipes</h1>
            <p class="lead page-header-subtitle mb-0 text-light-theme">Gerir tipos de instrumento para a página Naipes.</p>
        </div>

        <div class="page-header-actions justify-content-lg-end">
            <a href="/naipes" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Voltar aos Naipes
            </a>
        </div>
    </div>
</div>

@if (loading)
{
    <div class="text-center py-5">
        <div class="spinner-border" style="color: var(--bs-primary);" role="status">
            <span class="visually-hidden">A carregar...</span>
        </div>
        <p class="mt-3 text-muted">A carregar configurações...</p>
    </div>
}
else
{
    <div class="alert alert-info identity-alert-info mb-4">
        <i class="bi bi-info-circle-fill me-2"></i>
        <strong>Dica:</strong> Números de ordem menores aparecem primeiro. Tipos ocultos não são mostrados na página Naipes.
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-6 g-3">
        @foreach (var config in typeConfigs)
        {
            <div class="col">
                <div class="naipe-type-card @(!config.IsVisible ? "is-hidden" : "")">
                    <!-- Edit button -->
                    <button class="btn btn-sm admin-btn-edit naipe-type-edit-btn" 
                            @onclick="() => OpenEditModal(config)" 
                            title="Editar">
                        <i class="bi bi-pencil"></i>
                    </button>

                    <!-- Image/Icon -->
                    <div class="naipe-type-image-wrapper">
                        @if (!string.IsNullOrEmpty(config.PictureUrl))
                        {
                            <img src="@config.PictureUrl" alt="@config.InstrumentTypeName" class="naipe-type-image" />
                        }
                        else
                        {
                            <div class="naipe-type-placeholder">
                                <i class="bi bi-music-note"></i>
                            </div>
                        }
                    </div>

                    <!-- Name -->
                    <div class="naipe-type-name">@config.InstrumentTypeName</div>

                    <!-- Badges -->
                    <div class="naipe-type-badges">
                        <span class="badge bg-primary">Ordem: @config.SortOrder</span>
                        @if (!config.IsVisible)
                        {
                            <span class="badge bg-secondary">Oculto</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Visível</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- Edit Modal -->
<Modal @bind-Show="showEditModal" Title="@($"Editar {editingConfig?.InstrumentTypeName}")">
    <BodyContent>
        @if (editingConfig != null)
        {
            <!-- Current Image Preview -->
            <div class="mb-4 text-center">
                @if (!string.IsNullOrEmpty(editingConfig.PictureUrl))
                {
                    <img src="@editingConfig.PictureUrl" alt="@editingConfig.InstrumentTypeName" 
                         class="rounded-circle mb-2" 
                         style="width: 100px; height: 100px; object-fit: cover; border: 3px solid var(--bs-primary);" />
                    <div>
                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="RemoveCurrentImage">
                            <i class="bi bi-trash me-1"></i>Remover Imagem
                        </button>
                    </div>
                }
                else
                {
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-2" 
                         style="width: 100px; height: 100px; background-color: var(--bs-primary);">
                        <i class="bi bi-music-note text-white" style="font-size: 2.5rem;"></i>
                    </div>
                }
            </div>

            <!-- Image Upload -->
            <div class="mb-3">
                <label class="form-label">Imagem</label>
                <div class="localized-file-picker">
                    <InputFile id="@imageInputId" 
                               @key="imageUploadKey"
                               class="d-none" 
                               OnChange="HandleImageSelected" 
                               accept="image/*" />
                    <label class="btn btn-outline-secondary localized-file-button" for="@imageInputId">
                        <i class="bi bi-upload me-2"></i>Escolher imagem
                    </label>
                    <span class="localized-file-name">@(selectedFileName ?? "Nenhuma imagem selecionada")</span>
                </div>
                <small class="text-muted d-block mt-1">
                    <i class="bi bi-info-circle me-1"></i>Formatos suportados: JPG, PNG, WebP. Tamanho máximo: 5MB
                </small>
            </div>

            <!-- Sort Order -->
            <div class="mb-3">
                <label class="form-label">Ordem de Exibição</label>
                <input type="number" class="form-control" 
                       @bind="editFormSortOrder" 
                       min="0" max="999" />
                <small class="text-muted d-block mt-1">Números menores aparecem primeiro.</small>
            </div>

            <!-- Visibility -->
            <div class="mb-3">
                <label class="form-label">Visibilidade</label>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch"
                           id="edit-visibility"
                           @bind="editFormIsVisible" />
                    <label class="form-check-label" for="edit-visibility">
                        @(editFormIsVisible ? "Visível na página Naipes" : "Oculto na página Naipes")
                    </label>
                </div>
            </div>
        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="CloseEditModal">Cancelar</button>
        <button type="button" class="btn btn-purple" @onclick="SaveEdit" disabled="@saving">
            @if (saving)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                <span>A guardar...</span>
            }
            else
            {
                <i class="bi bi-check-lg me-1"></i>
                <span>Guardar</span>
            }
        </button>
    </FooterContent>
</Modal>

<style>
    .naipe-type-card {
        background-color: #151516;
        border: 1px solid var(--bs-border-color);
        border-radius: 0.5rem;
        padding: 1rem;
        text-align: center;
        position: relative;
        transition: transform 0.2s ease, border-color 0.2s ease;
    }

    .naipe-type-card:hover {
        transform: translateY(-3px);
        border-color: var(--bs-primary);
    }

    .naipe-type-card.is-hidden {
        opacity: 0.5;
    }

    .naipe-type-edit-btn {
        position: absolute;
        top: 0.5rem;
        right: 0.5rem;
        z-index: 10;
    }

    .naipe-type-image-wrapper {
        width: 80px;
        height: 80px;
        margin: 0 auto 0.75rem;
    }

    .naipe-type-image {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid var(--bs-primary);
    }

    .naipe-type-placeholder {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        background-color: var(--bs-primary);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .naipe-type-placeholder i {
        font-size: 2rem;
        color: white;
    }

    .naipe-type-name {
        font-weight: 600;
        font-size: 1rem;
        margin-bottom: 0.5rem;
        color: #e2e2e2;
    }

    .naipe-type-badges {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.25rem;
    }

    .naipe-type-badges .badge {
        font-size: 0.7rem;
    }
</style>

@code {
    private bool loading = true;
    private List<NaipeTypeConfigDto> typeConfigs = new();
    
    // Edit modal state
    private bool showEditModal = false;
    private NaipeTypeConfigDto? editingConfig;
    private int editFormSortOrder;
    private bool editFormIsVisible;
    private bool saving = false;
    
    // Image upload state
    private IBrowserFile? selectedFile;
    private string? selectedFileName;
    private Guid imageUploadKey = Guid.NewGuid();
    private string imageInputId = $"naipe-type-image-{Guid.NewGuid():N}";

    protected override async Task OnInitializedAsync()
    {
        await LoadConfigs();
    }

    private async Task LoadConfigs()
    {
        loading = true;
        try
        {
            // Initialize configs if needed
            await NaipeService.InitializeTypeConfigsAsync();
            typeConfigs = await NaipeService.GetAllTypeConfigsAsync();
        }
        finally
        {
            loading = false;
        }
    }

    private void OpenEditModal(NaipeTypeConfigDto config)
    {
        editingConfig = config;
        editFormSortOrder = config.SortOrder;
        editFormIsVisible = config.IsVisible;
        selectedFile = null;
        selectedFileName = null;
        imageUploadKey = Guid.NewGuid();
        showEditModal = true;
    }

    private void CloseEditModal()
    {
        showEditModal = false;
        editingConfig = null;
        selectedFile = null;
        selectedFileName = null;
    }

    private void HandleImageSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        var maxFileSize = 5 * 1024 * 1024; // 5MB
        
        if (file.Size > maxFileSize)
        {
            selectedFile = null;
            selectedFileName = null;
            return;
        }
        
        selectedFile = file;
        selectedFileName = file.Name;
        StateHasChanged();
    }

    private async Task SaveEdit()
    {
        if (editingConfig == null)
            return;

        saving = true;
        try
        {
            string? newPictureUrl = editingConfig.PictureUrl;

            // Upload new image if selected
            if (selectedFile != null)
            {
                var maxFileSize = 5 * 1024 * 1024L;
                using var browserStream = selectedFile.OpenReadStream(maxFileSize);
                using var memoryStream = new MemoryStream();
                await browserStream.CopyToAsync(memoryStream);
                memoryStream.Position = 0;

                newPictureUrl = await NaipeService.UploadTypeConfigPictureAsync(
                    editingConfig.Id,
                    memoryStream,
                    selectedFile.Name,
                    selectedFile.ContentType
                );
            }

            // Update the config
            await NaipeService.UpdateTypeConfigAsync(editingConfig.Id, newPictureUrl, editFormIsVisible, editFormSortOrder);
            
            // Update local state
            editingConfig.PictureUrl = newPictureUrl;
            editingConfig.IsVisible = editFormIsVisible;
            editingConfig.SortOrder = editFormSortOrder;
            
            // Re-sort the list
            typeConfigs = typeConfigs.OrderBy(c => c.SortOrder).ThenBy(c => c.InstrumentTypeName).ToList();
            
            CloseEditModal();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Erro ao guardar: {ex.Message}");
        }
        finally
        {
            saving = false;
        }
    }

    private async Task RemoveCurrentImage()
    {
        if (editingConfig == null)
            return;

        try
        {
            await NaipeService.UpdateTypeConfigAsync(editingConfig.Id, null, editingConfig.IsVisible, editingConfig.SortOrder);
            editingConfig.PictureUrl = null;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Erro ao remover imagem: {ex.Message}");
        }
    }
}
