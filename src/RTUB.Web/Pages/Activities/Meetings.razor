    private string FormatUserNameForView(ApplicationUser? user)
    {
        if (user == null) return "—";
        
        var firstName = user.FirstName ?? "";
        var lastName = user.LastName ?? "";
        var nickname = user.Nickname;
        
        if (!string.IsNullOrEmpty(nickname))
        {
            return $"{firstName} \"{nickname}\" {lastName}".Trim();
        }
        
        return $"{firstName} {lastName}".Trim();
    }
    
    private async Task OpenAtaModal(Meeting meeting)
    {
        ataMeeting = meeting;
        isAtaLoading = true;
        ataErrorMessage = null;
        modals.Open(ModalType.Ata);
        ataParticipants = null;
        ataPresident = null;
        ataFirstSecretaryAG = null;
        ataSecondSecretaryAG = null;
        
        try
        {
            // Load meeting participants who will attend (for secretary selection in CV and attendance)
            var participations = await MeetingParticipationService.GetParticipationsByMeetingIdAsync(meeting.Id);
            ataParticipants = participations.Where(p => p.WillAttend && p.User != null).ToList();
            
            // Find the correct president and secretaries based on meeting type
            var allUsers = await UserManager.Users.AsNoTracking().ToListAsync();
            var isAG = meeting.Type == MeetingType.AssembleiaGeralOrdinaria || meeting.Type == MeetingType.AssembleiaGeralExtraordinaria;
            
            if (meeting.Type == MeetingType.ConselhoVeteranos)
            {
                // CV: Find user with PresidenteConselhoVeteranos position
                ataPresident = allUsers.FirstOrDefault(u => u.Positions != null && u.Positions.Contains(Position.PresidenteConselhoVeteranos));
            }
            else if (isAG)
            {
                // AG: Find user with PresidenteMesaAssembleia position and secretaries
                ataPresident = allUsers.FirstOrDefault(u => u.Positions != null && u.Positions.Contains(Position.PresidenteMesaAssembleia));
                ataFirstSecretaryAG = allUsers.FirstOrDefault(u => u.Positions != null && u.Positions.Contains(Position.PrimeiroSecretarioMesaAssembleia));
                ataSecondSecretaryAG = allUsers.FirstOrDefault(u => u.Positions != null && u.Positions.Contains(Position.SegundoSecretarioMesaAssembleia));
            }
            
            // Check if an ata already exists for this meeting
            var existingAta = await MeetingAtaService.GetByMeetingIdAsync(meeting.Id);
            
            if (existingAta != null)
            {
                // Load existing ata with details - preserve the saved secretary values
                editingAta = await MeetingAtaService.GetByIdWithDetailsAsync(existingAta.Id);
                
                // Update president to match current position holder (president is always required)
                if (editingAta != null && ataPresident != null)
                {
                    editingAta.PresidentUserId = ataPresident.Id;
                }
                
                // NOTE: Do NOT overwrite secretary values for existing ATAs - preserve what was saved
            }
            else
            {
                // Create new ata with default values from meeting
                // IMPORTANT: Only set foreign key IDs, not navigation properties, to avoid EF tracking issues
                var presidentId = ataPresident?.Id ?? currentUserId;
                
                // For AG, get secretaries from roles; for CV, user will select from dropdown
                var firstSecretaryId = isAG && ataFirstSecretaryAG != null ? ataFirstSecretaryAG.Id : string.Empty;
                var secondSecretaryId = isAG && ataSecondSecretaryAG != null ? ataSecondSecretaryAG.Id : null;
                
                editingAta = new MeetingAta
                {
                    MeetingId = meeting.Id,
                    ActualStartTime = meeting.Date,
                    Location = meeting.Location ?? string.Empty,
                    PresidentUserId = presidentId,
                    FirstSecretaryUserId = firstSecretaryId,
                    SecondSecretaryUserId = secondSecretaryId,
                    QuorumBasis = "HoraAgendada",
                    AttendeesPresent = "[]",
                    AttendeesAbsent = "[]",
                    Status = MeetingAtaStatus.Draft,
                    AgendaPoints = new List<MeetingAtaAgendaPoint>(),
                    Attachments = new List<MeetingAtaAttachment>()
                };
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading ata for meeting {MeetingId}", meeting.Id);
            ataErrorMessage = "Erro ao carregar a ata. Por favor, tente novamente.";
        }
        finally
        {
            isAtaLoading = false;
            StateHasChanged();
        }
    }
    
