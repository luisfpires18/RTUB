    private async Task AcceptMeetingRequest(MeetingRequest request)
    {
        if (!CanApproveRejectRequests(request)) return;
        
        try
        {
            // Update request status to Accepted
            await MeetingRequestService.UpdateStatusAsync(request.Id, RequestStatus.Confirmed);
            
            // Open create meeting modal with pre-filled data from the request
            isCreateMode = true;
            editingMeeting = new Meeting
            {
                Type = request.RequestedMeetingType, // Use the type from the request
                Title = request.Title,
                Date = request.ProposedDateTime,
                Location = request.Location,
                Statement = request.Description,
                OrganizerUserId = currentUserId
            };
            modals.Open(ModalType.Edit);
            
            // Reload requests to show updated status
            await LoadMeetingRequestsAsync();
        }
        catch (Exception)
        {
            // Error handling could be improved with user feedback
        }
    }
    
    private async Task RejectMeetingRequest(MeetingRequest request)
    {
        if (!CanApproveRejectRequests(request)) return;
        
        try
        {
            await MeetingRequestService.UpdateStatusAsync(request.Id, RequestStatus.Rejected);
            await LoadMeetingRequestsAsync();
        }
        catch (Exception)
        {
            // Error handling could be improved with user feedback
        }
    }
    
    private async Task SendMeetingRequestReminder(MeetingRequest request)
    {
        reminderRequest = request;
        modals.Open(ModalType.ReminderConfirm);
        await Task.CompletedTask;
    }
    
    private void CloseReminderConfirmModal()
    {
        modals.Close(ModalType.ReminderConfirm);
        reminderRequest = null;
    }
    
    private async Task ConfirmSendReminder()
    {
        if (reminderRequest == null) return;
        
        try
        {
            var baseUrl = Navigation.BaseUri.TrimEnd('/');
            var success = await MeetingRequestService.SendReminderNotificationAsync(reminderRequest.Id, baseUrl);
            if (success)
            {
                reminderSuccessMessage = "Notificação Enviada!";
                StateHasChanged();
                
                // Auto-dismiss after 3 seconds
                _ = Task.Delay(3000).ContinueWith(_ =>
                {
                    InvokeAsync(() =>
                    {
                        reminderSuccessMessage = null;
                        StateHasChanged();
                    });
                });
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error sending reminder: {ex.Message}");
        }
        finally
        {
            CloseReminderConfirmModal();
        }
    }
    
    // ========== Participation Methods ==========
    
    private void OpenParticipationModalWithResponse(Meeting meeting, bool willAttend)
    {
        selectedMeetingForParticipation = meeting;
        isParticipationPreSelected = true;
        
        var existingParticipation = GetUserParticipation(meeting.Id);
        if (existingParticipation != null)
        {
            // Editing existing participation
            isEditingParticipation = true;
            participationForm = new MeetingParticipation
            {
                Id = existingParticipation.Id,
                MeetingId = meeting.Id,
                UserId = currentUserId,
                WillAttend = willAttend,
                Notes = existingParticipation.Notes
            };
        }
        else
        {
            // Creating new participation
            isEditingParticipation = false;
            participationForm = new MeetingParticipation
            {
                MeetingId = meeting.Id,
                UserId = currentUserId,
                WillAttend = willAttend,
                Notes = null
            };
        }
        
        modals.Open(ModalType.Participation);
    }
    
    private void CloseParticipationModal()
    {
        modals.Close(ModalType.Participation);
        selectedMeetingForParticipation = null;
        participationForm = null;
        isEditingParticipation = false;
        isParticipationPreSelected = false;
    }
    
    private string GetParticipationModalTitle()
    {
        if (participationForm == null)
            return "Participação";
            
        if (isEditingParticipation)
            return participationForm.WillAttend ? "Editar Confirmação" : "Editar Impossibilidade";
            
        return participationForm.WillAttend ? "Confirmar Participação" : "Registar Impossibilidade";
    }
    
    private async Task SaveParticipation()
    {
        if (participationForm == null || selectedMeetingForParticipation == null)
        {
            CloseParticipationModal();
            return;
        }
        
        try
        {
            if (isEditingParticipation && participationForm.Id > 0)
            {
                // Update existing participation
                await MeetingParticipationService.UpdateParticipationAsync(
                    participationForm.Id,
                    participationForm.WillAttend,
                    participationForm.Notes);
            }
            else
            {
                // Create new participation
                await MeetingParticipationService.CreateParticipationAsync(
                    currentUserId,
                    participationForm.MeetingId,
                    participationForm.Notes,
                    participationForm.WillAttend);
            }
            
            // Reload participations and refresh UI
            await LoadParticipationsAsync();
            CloseParticipationModal();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving meeting participation for meeting {MeetingId}", participationForm?.MeetingId);
        }
    }
    
    private async Task OpenParticipantsModal(Meeting meeting)
    {
        selectedMeetingForParticipants = meeting;
        modals.Open(ModalType.Participants);
        
        try
        {
            meetingParticipations = (await MeetingParticipationService.GetParticipationsByMeetingIdAsync(meeting.Id)).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading participants for meeting {MeetingId}", meeting.Id);
            meetingParticipations = new List<MeetingParticipation>();
        }
    }
    
    private void CloseParticipantsModal()
    {
        modals.Close(ModalType.Participants);
        selectedMeetingForParticipants = null;
        meetingParticipations = null;
        showAddMemberToParticipationSearch = false;
        addMemberToParticipationSearchTerm = string.Empty;
        addMemberToParticipationFeedbackMessage = string.Empty;
        addMemberToParticipationFeedbackIsError = false;
    }
    
    private bool CanDeleteParticipation(MeetingParticipation participation)
    {
        // Users can only delete their own participation or admins can delete any
        if (isOwner) return true;
        return participation.UserId == currentUserId;
    }
    
    private void OpenDeleteParticipationModal(MeetingParticipation participation)
    {
        deletingParticipation = participation;
        modals.Open(ModalType.DeleteParticipation);
    }
    
    private void CloseDeleteParticipationModal()
    {
        modals.Close(ModalType.DeleteParticipation);
        deletingParticipation = null;
    }
    
    private async Task ConfirmDeleteParticipation()
    {
        if (deletingParticipation == null) return;
        
        try
        {
            await MeetingParticipationService.DeleteParticipationAsync(deletingParticipation.Id);
            
            // Refresh the participation list
            if (selectedMeetingForParticipants != null)
            {
                await OpenParticipantsModal(selectedMeetingForParticipants);
            }
            
            // Also refresh participation counts
            await LoadParticipationsAsync();
            
            addMemberToParticipationFeedbackMessage = "Participação removida com sucesso.";
            addMemberToParticipationFeedbackIsError = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting participation {ParticipationId}", deletingParticipation.Id);
            addMemberToParticipationFeedbackMessage = "Erro ao remover participação. Tente novamente.";
            addMemberToParticipationFeedbackIsError = true;
        }
        finally
        {
            CloseDeleteParticipationModal();
        }
    }
    
