        }
        else if (CanCreateMeetingType(MeetingType.ConselhoVeteranos))
        {
            defaultType = MeetingType.ConselhoVeteranos;
        }
        else if (CanCreateMeetingType(MeetingType.AssembleiaGeralExtraordinaria))
        {
            defaultType = MeetingType.AssembleiaGeralExtraordinaria;
        }
        else
        {
            defaultType = MeetingType.AssembleiaGeralOrdinaria; // Fallback
        }
        
        editingMeeting = new Meeting
        {
            Type = defaultType,
            Title = string.Empty,
            Date = DateTime.Now.Date.AddDays(1).AddHours(20), // Default to tomorrow at 8 PM
            Statement = string.Empty,
            OrganizerUserId = currentUserId // Set current user as organizer
        };
        
        // Load Tuno users for representative selection
        await LoadTunoUsersForMeetingForm();
        
        modals.Open(ModalType.Edit);
    }

