    private async Task AcceptMeetingRequest(MeetingRequest request)
    {
        if (!CanApproveRejectRequests(request)) return;
        
        try
        {
            // Update request status to Accepted
            await MeetingRequestService.UpdateStatusAsync(request.Id, RequestStatus.Confirmed);
            
            // Open create meeting modal with pre-filled data from the request
            isCreateMode = true;
            editingMeeting = new Meeting
            {
                Type = request.RequestedMeetingType, // Use the type from the request
                Title = request.Title,
                Date = request.ProposedDateTime,
                Location = request.Location,
                Statement = request.Description,
                OrganizerUserId = currentUserId
            };
            showEditModal = true;
            
            // Reload requests to show updated status
            await LoadMeetingRequestsAsync();
        }
        catch (Exception)
        {
            // Error handling could be improved with user feedback
        }
    }
    
    private async Task RejectMeetingRequest(MeetingRequest request)
    {
        if (!CanApproveRejectRequests(request)) return;
        
        try
        {
            await MeetingRequestService.UpdateStatusAsync(request.Id, RequestStatus.Rejected);
            await LoadMeetingRequestsAsync();
        }
        catch (Exception)
        {
            // Error handling could be improved with user feedback
        }
    }
    
