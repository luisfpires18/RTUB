            </div>

            <div class="mb-3">
                <label class="form-label text-white-full fw-semibold">
                    <i class="bi bi-calendar3 text-primary me-2"></i>Data e Hora Proposta
                </label>
                <p class="text-light-theme">@viewingRequest.ProposedDateTime.ToString("dd/MM/yyyy HH:mm")</p>
            </div>

            @if (!string.IsNullOrEmpty(viewingRequest.Location))
            {
                <div class="mb-3">
                    <label class="form-label text-white-full fw-semibold">
                        <i class="bi bi-geo-alt text-primary me-2"></i>Localização
                    </label>
                    <p class="text-light-theme">@viewingRequest.Location</p>
                </div>
            }

            <div class="mb-3">
                <label class="form-label text-white-full fw-semibold">
                    <i class="bi bi-file-text text-primary me-2"></i>Descrição/Motivo
                </label>
                <p class="text-light-theme" style="white-space: pre-line;">@viewingRequest.Description</p>
