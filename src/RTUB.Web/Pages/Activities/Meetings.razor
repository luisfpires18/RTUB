                    .OrderBy(u => u.Nickname ?? u.FirstName)
                    .ToList();
                
                cancelMeetingTotalCount = cancelMeetingSubscribedUsers.Count + cancelMeetingNonSubscribedUsers.Count;
            }
            else
            {
                // AGO/AGE meetings: All members EXCEPT Leitão
                cancelMeetingSubscribedUsers = allUsers
                    .Where(u => u.Subscribed && u.EmailConfirmed && !u.IsLeitao())
                    .OrderBy(u => u.Nickname ?? u.FirstName)
                    .ToList();
                
                // Non-subscribers for Assembleia: not subscribed
                cancelMeetingNonSubscribedUsers = allUsers
                    .Where(u => u.EmailConfirmed && !u.Subscribed && !u.IsLeitao())
                    .OrderBy(u => u.Nickname ?? u.FirstName)
                    .ToList();
                
                cancelMeetingTotalCount = cancelMeetingSubscribedUsers.Count + cancelMeetingNonSubscribedUsers.Count;
            }
            
            cancelMeetingSubscribedCount = cancelMeetingSubscribedUsers.Count;
        }
        catch (Exception ex)
        {
            cancelMeetingErrorMessage = $"Erro ao carregar membros: {ex.Message}";
        }
        finally
        {
            cancelMeetingLoadingSubscribers = false;
            StateHasChanged();
        }
    }

    private void CloseCancelMeetingModal()
    {
        showCancelMeetingModal = false;
        selectedMeetingForCancellation = null;
        notifySubscribersOnMeetingCancel = false;
        cancelMeetingReason = string.Empty;
        cancelMeetingSubscribedUsers = null;
        cancelMeetingNonSubscribedUsers = null;
        cancelMeetingSubscribedCount = 0;
        cancelMeetingTotalCount = 0;
        cancelMeetingErrorMessage = null;
    }

    private async Task ConfirmCancelMeeting()
    {
        if (selectedMeetingForCancellation == null || string.IsNullOrWhiteSpace(cancelMeetingReason))
        {
            cancelMeetingErrorMessage = "O motivo do cancelamento é obrigatório.";
            StateHasChanged();
            return;
        }

        // Initialize progress tracking if sending emails
        if (notifySubscribersOnMeetingCancel && cancelMeetingSubscribedUsers != null && cancelMeetingSubscribedUsers.Any())
        {
            IsSendingEmails = true;
            EmailsTotal = cancelMeetingSubscribedUsers.Count;
            EmailsSent = 0;
            LastRecipient = null;
            StateHasChanged();
        }

        try
        {
            // Cancel the meeting by setting the properties
            selectedMeetingForCancellation.IsCancelled = true;
            selectedMeetingForCancellation.CancellationReason = cancelMeetingReason;
            await MeetingService.UpdateMeetingAsync(selectedMeetingForCancellation);

            // Send notification emails if checkbox is selected
            if (notifySubscribersOnMeetingCancel && cancelMeetingSubscribedUsers != null && cancelMeetingSubscribedUsers.Any())
            {
                // Get recipient emails
                var recipientEmails = cancelMeetingSubscribedUsers
                    .Where(u => !string.IsNullOrWhiteSpace(u.Email))
                    .Select(u => u.Email!)
                    .ToList();

                // Build recipient data dictionary
                var recipientData = cancelMeetingSubscribedUsers
                    .Where(u => !string.IsNullOrWhiteSpace(u.Email))
                    .ToDictionary(
                        u => u.Email!,
                        u => (
                            nickname: u.Nickname ?? "",
                            fullName: $"{u.FirstName ?? ""} {u.LastName ?? ""}".Trim()
                        )
                    );

                // Generate the cancellation email body
                var dateStr = selectedMeetingForCancellation.Date.ToString("dddd, dd 'de' MMMM 'de' yyyy • HH:mm", new System.Globalization.CultureInfo("pt-PT"));
                var currentDate = DateTime.Now.ToString("dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("pt-PT"));
                var senderCity = $"Bragança, {currentDate}";
                var senderNickname = currentUser != null 
                    ? $"{currentUser.FirstName} \"{currentUser.Nickname}\" {currentUser.LastName}"
                    : "Admin";
                
                var emailBody = await EmailTemplateRenderer.RenderMeetingCancellationAsync(
                    meetingType: GetMeetingTypeFullName(selectedMeetingForCancellation.Type),
                    meetingTitle: selectedMeetingForCancellation.Title,
                    dateFormatted: dateStr,
                    location: selectedMeetingForCancellation.Location ?? string.Empty,
                    cancellationReason: cancelMeetingReason,
                    senderNickname: senderNickname,
                    senderCity: senderCity,
                    senderPosition: GetSenderPosition(),
                    nickname: "",
                    fullName: "");

                // Create progress reporter
                var progress = new Progress<EmailSendProgress>(update =>
                {
                    EmailsTotal = update.Total;
                    EmailsSent = update.Sent;
                    LastRecipient = update.LastRecipient;
                    StateHasChanged();
                });

                // Send the cancellation notification
                var subject = $"[RTUB] Cancelamento: {GetMeetingTypeFullName(selectedMeetingForCancellation.Type)} - {selectedMeetingForCancellation.Title}";
                await EmailNotificationService.SendMeetingNotificationAsync(
                    selectedMeetingForCancellation.Id,
                    subject,
                    emailBody,
                    recipientEmails,
                    recipientData,
                    progress);
            }

            // Reload meetings
            await LoadMeetingsAsync();

            CloseCancelMeetingModal();
        }
        catch (Exception ex)
        {
            cancelMeetingErrorMessage = $"Erro ao cancelar reunião: {ex.Message}";
        }
        finally
        {
            IsSendingEmails = false;
            StateHasChanged();
        }
    }

