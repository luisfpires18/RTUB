    private void AddAgendaPoint()
    {
        if (editingAta == null || string.IsNullOrWhiteSpace(newAgendaPointTitle)) return;
        
        editingAta.AgendaPoints ??= new List<MeetingAtaAgendaPoint>();
        
        var nextNumber = editingAta.AgendaPoints.Any() 
            ? editingAta.AgendaPoints.Max(p => p.PointNumber) + 1 
            : 1;
        
        editingAta.AgendaPoints.Add(new MeetingAtaAgendaPoint
        {
            MeetingAtaId = editingAta.Id,
            PointNumber = nextNumber,
            Title = newAgendaPointTitle.Trim()
        });
        
        newAgendaPointTitle = string.Empty;
        StateHasChanged();
    }
    
    private void RemoveAgendaPoint(MeetingAtaAgendaPoint point)
    {
        if (editingAta?.AgendaPoints == null) return;
        
        editingAta.AgendaPoints.Remove(point);
        
        // Renumber remaining points
        var pointNumber = 1;
        foreach (var p in editingAta.AgendaPoints.OrderBy(x => x.PointNumber))
        {
            p.PointNumber = pointNumber++;
        }
        
        StateHasChanged();
    }
    
