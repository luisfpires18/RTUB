    private async Task RemoveParticipation()
    {
        if (removingParticipation == null || currentUser == null) return;
        
        try
        {
            // Verify that the user is removing their own participation
            if (removingParticipation.UserId == currentUser.Id)
            {
                await MeetingParticipationService.DeleteParticipationAsync(removingParticipation.Id);
                await LoadParticipationsAsync();
                await LoadMeetingsAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error removing participation {ParticipationId}", removingParticipation.Id);
        }
        finally
        {
            CloseRemoveParticipationModal();
            StateHasChanged();
        }
    }
    
    // Add member to participation methods (Admin only)
    private async Task HandleAddMemberToParticipationSearchChanged(string searchTerm)
    {
        addMemberToParticipationSearchTerm = searchTerm;
        await FilterAvailableMembersForParticipation();
    }
    
    private async Task FilterAvailableMembersForParticipation()
    {
        if (string.IsNullOrWhiteSpace(addMemberToParticipationSearchTerm) || selectedMeetingForParticipants == null)
        {
            filteredAvailableMembersForParticipation = new List<ApplicationUser>();
            return;
        }

        // Get users who are not already in the participation list
        var existingParticipantIds = meetingParticipations?.Select(p => p.UserId).ToHashSet() ?? new HashSet<string>();
        
        // Load all members if not already loaded
        if (!allMembersForParticipation.Any())
        {
            allMembersForParticipation = await UserManager.Users.AsNoTracking().ToListAsync();
        }
        
        var search = addMemberToParticipationSearchTerm.ToLower();
        filteredAvailableMembersForParticipation = allMembersForParticipation
            .Where(u => !existingParticipantIds.Contains(u.Id))
            // Filter out Leitoes and Caloiros - they should not be added to meeting participations
            .Where(u => u.Categories != null && !u.Categories.Contains(MemberCategory.Leitao) && !u.Categories.Contains(MemberCategory.Caloiro))
            .Where(u => (u.FirstName?.ToLower().Contains(search) ?? false) ||
                       (u.LastName?.ToLower().Contains(search) ?? false) ||
                       (u.Nickname?.ToLower().Contains(search) ?? false))
            .OrderBy(u => u.FirstName)
            .ToList();
    }
    
    private async Task AddMemberToMeeting(ApplicationUser user)
    {
        if (selectedMeetingForParticipants == null) return;

        try
        {
            // Check if participation already exists to prevent duplicate constraint violations
            var existingParticipation = await MeetingParticipationService.GetParticipationByMeetingAndUserAsync(selectedMeetingForParticipants.Id, user.Id);
            
            if (existingParticipation != null)
            {
                // Update existing participation instead of creating duplicate
                await MeetingParticipationService.UpdateParticipationAsync(
                    existingParticipation.Id,
                    true, // willAttend = true (approved)
                    null // notes
                );
                addMemberToParticipationFeedbackMessage = $"Participação de {user.FirstName} \"{user.Nickname}\" atualizada com sucesso.";
            }
            else
            {
                // Add the participation, marking it as approved (willAttend = true)
                await MeetingParticipationService.CreateParticipationAsync(user.Id, selectedMeetingForParticipants.Id, null, true);
                addMemberToParticipationFeedbackMessage = $"Participação de {user.FirstName} \"{user.Nickname}\" adicionada com sucesso.";
            }
            
            addMemberToParticipationFeedbackIsError = false;
            
            // Hide the search after successful addition
            showAddMemberToParticipationSearch = false;
            addMemberToParticipationSearchTerm = string.Empty;
            
            // Refresh participation list
            await OpenParticipantsModal(selectedMeetingForParticipants);
            
            // Also refresh participation counts
            await LoadParticipationsAsync();
            
            StateHasChanged();
        }
        catch (Exception ex)
        {
            addMemberToParticipationFeedbackMessage = $"Erro ao adicionar membro: {ex.Message}";
            addMemberToParticipationFeedbackIsError = true;
            Console.WriteLine($"Error adding member to meeting: {ex.Message}");
        }
    }
    
    private void ClearAddMemberToParticipationFeedback()
    {
        addMemberToParticipationFeedbackMessage = "";
        addMemberToParticipationFeedbackIsError = false;
    }
    
    private void ShowAddMemberToParticipationSearch()
    {
        showAddMemberToParticipationSearch = true;
        addMemberToParticipationSearchTerm = string.Empty;
        addMemberToParticipationFeedbackMessage = string.Empty;
        addMemberToParticipationFeedbackIsError = false;
        allMembersForParticipation = new List<ApplicationUser>(); // Reset to force reload
    }
    
    private void HideAddMemberToParticipationSearch()
    {
        showAddMemberToParticipationSearch = false;
        addMemberToParticipationSearchTerm = string.Empty;
        addMemberToParticipationFeedbackMessage = string.Empty;
        addMemberToParticipationFeedbackIsError = false;
    }
    
    private async Task HandleMemberItemKeyDownForParticipation(KeyboardEventArgs e, ApplicationUser member)
    {
        if (e.Key == "Enter" || e.Key == " ")
        {
            await AddMemberToMeeting(member);
        }
    }
