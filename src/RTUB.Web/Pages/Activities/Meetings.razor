<!-- Request View Details Modal -->
<Modal Show="@showRequestDetailsModal" 
       ShowChanged="@((bool show) => showRequestDetailsModal = show)"
       Size="Modal.ModalSize.Large"
       Title="Detalhes do Pedido de Reunião">
