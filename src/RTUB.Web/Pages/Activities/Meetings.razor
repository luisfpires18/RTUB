    private string GetYearsAsTunoDisplay(ApplicationUser user)
    {
        if (user.YearTuno == null) return "< 1 ano de Tuno";
        
        var now = DateTime.Now;
        var tunoStartYear = user.YearTuno.Value;
        var tunoStartMonth = user.MonthTuno ?? 1;
        
        var tunoStart = new DateTime(tunoStartYear, tunoStartMonth, 1);
        var totalMonths = ((now.Year - tunoStart.Year) * 12) + (now.Month - tunoStart.Month);
        
        if (totalMonths < 1)
            return "< 1 mês de Tuno";
        
        var years = totalMonths / 12;
        var months = totalMonths % 12;
        
        if (years == 0)
            return months == 1 ? "1 mês de Tuno" : $"{months} meses de Tuno";
        
        if (months == 0)
            return years == 1 ? "1 ano de Tuno" : $"{years} anos de Tuno";
        
        var yearText = years == 1 ? "ano" : "anos";
        var monthText = months == 1 ? "mês" : "meses";
        return $"{years} {yearText} {months} {monthText} de Tuno";
    }
    
    private bool CanManageMeetings()
    {
        if (currentUser == null) return false;
        
        // Check if user is Owner role (use cached value)
        if (isOwner) return true;
        
        // Check if user has one of the authorized positions
        if (currentUser.Positions == null) return false;
        
        return currentUser.Positions.Contains(Position.PresidenteMesaAssembleia) ||
               currentUser.Positions.Contains(Position.PresidenteConselhoVeteranos);
    }
    
    private bool CanManageMeeting(Meeting meeting)
    {
        if (currentUser == null) return false;
        
        // Owner can manage all meetings (use cached value)
        if (isOwner) return true;
        
        if (currentUser.Positions == null) return false;
        
        // PresidenteMesaAssembleia can only manage Assembleia meetings
        if (currentUser.Positions.Contains(Position.PresidenteMesaAssembleia))
        {
            return meeting.Type == MeetingType.AssembleiaGeralOrdinaria || 
                   meeting.Type == MeetingType.AssembleiaGeralExtraordinaria;
        }
        
        // PresidenteConselhoVeteranos can only manage CV meetings
        if (currentUser.Positions.Contains(Position.PresidenteConselhoVeteranos))
        {
            return meeting.Type == MeetingType.ConselhoVeteranos;
        }
        
        return false;
    }
    
    private bool CanCreateMeetingType(MeetingType type)
    {
        if (currentUser == null) return false;
        
        // Owner can create all types (use cached value)
        if (isOwner) return true;
        
        if (currentUser.Positions == null) return false;
        
        // PresidenteMesaAssembleia can only create Assembleia meetings
        if (currentUser.Positions.Contains(Position.PresidenteMesaAssembleia))
        {
            return type == MeetingType.AssembleiaGeralOrdinaria || 
                   type == MeetingType.AssembleiaGeralExtraordinaria;
        }
        
        // PresidenteConselhoVeteranos can only create CV meetings
        if (currentUser.Positions.Contains(Position.PresidenteConselhoVeteranos))
        {
            return type == MeetingType.ConselhoVeteranos;
        }
        
        return false;
    }
    
    // ========== Meeting Request Methods ==========
    
    private async Task LoadMeetingRequestsAsync()
    {
        if (!CanViewCVRequests())
        {
            isLoadingRequests = false;
            return;
        }
        
        isLoadingRequests = true;
        try
        {
            RequestStatus? statusFilter = null;
            if (!string.IsNullOrEmpty(selectedRequestStatusFilter))
            {
                // Map display name to enum
                statusFilter = selectedRequestStatusFilter switch
                {
                    "Pendente" => RequestStatus.Pending,
                    "Aceite" => RequestStatus.Confirmed,
                    "Rejeitado" => RequestStatus.Rejected,
                    _ => null
                };
            }
            
            var allRequests = (await MeetingRequestService.GetPagedAsync(1, int.MaxValue, statusFilter)).ToList();
            
            // Apply fiscal year filter if selected
            var dateRange = GetFiscalYearDateRange();
            if (dateRange.HasValue)
            {
                allRequests = allRequests
                    .Where(r => r.ProposedDateTime >= dateRange.Value.start && r.ProposedDateTime <= dateRange.Value.end)
                    .ToList();
            }
            
            requestTotalCount = allRequests.Count;
            
            // Apply pagination
            meetingRequests = allRequests
                .OrderByDescending(r => r.ProposedDateTime)
                .Skip((requestCurrentPage - 1) * requestPageSize)
                .Take(requestPageSize)
                .ToList();
        }
        finally
        {
            isLoadingRequests = false;
        }
    }
    
    private async Task ChangeRequestPage(int newPage)
    {
        requestCurrentPage = newPage;
        await LoadMeetingRequestsAsync();
    }

    private async Task ChangeRequestPageSize(int newPageSize)
    {
        requestPageSize = newPageSize;
        requestCurrentPage = 1; // Reset to first page
        await LoadMeetingRequestsAsync();
    }
    
    private bool CanProposeCVMeeting()
    {
        if (currentUser == null) return false;
        
        // Presidente de Conselho de Veteranos doesn't need to see this button (they can create directly)
        if (IsPresidenteConselhoVeteranos()) return false;
        
        var role = currentUser.CurrentRole;
        return role == "VETERANO" || role == "TUNOSSAURO" || currentUser.Positions.Contains(Position.Magister);
    }
    
    private bool CanProposeAGMeeting()
    {
        if (currentUser == null) return false;
        
        // Use cached isOwner value
        if (isOwner) return true;
        
        return currentUser.Positions.Contains(Position.Magister) ||
               currentUser.Positions.Contains(Position.PresidenteConselhoVeteranos) ||
               currentUser.Positions.Contains(Position.PresidenteConselhoFiscal);
    }
    
    private bool IsDirecaoMember()
    {
        if (currentUser == null) return false;
        
        // Owner can also access Direção functions
        if (isOwner) return true;
        
        if (currentUser.Positions == null) return false;
        
        // Direção members: Magister, ViceMagister, Secretario, PrimeiroTesoureiro, SegundoTesoureiro
        return currentUser.Positions.Contains(Position.Magister) ||
               currentUser.Positions.Contains(Position.ViceMagister) ||
               currentUser.Positions.Contains(Position.Secretario) ||
               currentUser.Positions.Contains(Position.PrimeiroTesoureiro) ||
               currentUser.Positions.Contains(Position.SegundoTesoureiro);
    }
    
    private bool CanViewCVRequests()
    {
        if (currentUser == null) return false;
        
        var role = currentUser.CurrentRole;
        return role == "VETERANO" || role == "TUNOSSAURO" || currentUser.Positions.Contains(Position.Magister);
    }
    
    private bool IsPresidenteConselhoVeteranos()
    {
        return currentUser?.Positions.Contains(Position.PresidenteConselhoVeteranos) ?? false;
    }
    
    private bool IsPresidenteMesaAssembleia()
    {
        return currentUser?.Positions.Contains(Position.PresidenteMesaAssembleia) ?? false;
    }
    
    private bool CanApproveRejectRequests(MeetingRequest request)
    {
        // Use cached isOwner value
        if (isOwner) return true;
        
        // For CV requests: Presidente do Conselho de Veteranos
        if (request.RequestedMeetingType == MeetingType.ConselhoVeteranos)
        {
            return IsPresidenteConselhoVeteranos();
        }
        
        // For AG requests: Presidente da Mesa da Assembleia
        if (request.RequestedMeetingType == MeetingType.AssembleiaGeralOrdinaria || 
            request.RequestedMeetingType == MeetingType.AssembleiaGeralExtraordinaria)
        {
            return IsPresidenteMesaAssembleia();
        }
        
        return false;
    }
    
