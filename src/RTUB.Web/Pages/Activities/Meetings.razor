        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        // Cache authentication state to avoid synchronous I/O in rendering methods
        isOwner = user.IsInRole("Owner");
        isAdmin = user.IsInRole("Admin");

        if (user.Identity?.IsAuthenticated == true)
        {
            var userName = user.Identity.Name;
            if (userName != null)
            {
                // Load user directly - Categories property will deserialize from CategoriesJson
                currentUser = await UserManager.FindByNameAsync(userName);
                currentUserId = currentUser?.Id ?? string.Empty;
            }
        }

        // Load fiscal years (show only fiscal years from 2025 and beyond)
        var allFiscalYears = await FiscalYearService.GetAllFiscalYearsAsync();
        fiscalYears = allFiscalYears
            .Where(fy => fy.StartYear >= FiscalYearHelper.AppYearCreated)
            .Select(fy => fy.GetFiscalYearString())
            .OrderByDescending(y => y)
            .ToList();
        currentFiscalYear = FiscalYearHelper.GetCurrentFiscalYearString();
        selectedFiscalYear = currentFiscalYear;

        await LoadMeetingsAsync();
        await LoadMeetingRequestsAsync();
        await LoadParticipationsAsync();
        BuildMobileNavItems();
    }

