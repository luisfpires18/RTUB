    // Email notification methods
    private async Task OpenEmailNotificationModal(Meeting meeting)
    {
        selectedMeetingForEmail = meeting;
        emailLoadingSubscribers = true;
        emailErrorMessage = null;
        selectedTunoId = string.Empty;
        modals.Open(ModalType.EmailNotification);
        StateHasChanged();

        try
        {
            var allUsers = await UserManager.Users.AsNoTracking().ToListAsync();
            
            // Build recipient list based on meeting type
            if (meeting.Type == MeetingType.ConselhoVeteranos)
            {
                // CV meetings: Veterano + Tunossauro + Magister (using CurrentRole for accurate role detection)
                subscribedUsers = allUsers
                    .Where(u => u.Subscribed && u.EmailConfirmed && 
                           (u.CurrentRole == "VETERANO" || u.CurrentRole == "TUNOSSAURO" || u.Positions.Contains(Position.Magister)))
                    .OrderBy(u => u.Nickname ?? u.FirstName)
                    .ToList();

                // Get list of Tuno users for selection (only Tunos who haven't reached Veterano yet)
                emailTunoUsers = allUsers
                    .Where(u => u.EmailConfirmed && u.CurrentRole == "TUNO")
                    .OrderBy(u => u.Nickname ?? u.FirstName)
                    .ToList();
                
                // Non-subscribers for CV: Only TUNO category members who aren't veteran/tunossauro and don't have Magister position
                // Excludes CALOIRO and other categories
                nonSubscribedUsers = allUsers
                    .Where(u => u.EmailConfirmed && 
                           u.IsTuno() && 
                           u.CurrentRole == "TUNO" && 
                           !u.Positions.Contains(Position.Magister))
                    .OrderBy(u => u.Nickname ?? u.FirstName)
                    .ToList();
            }
            else if (meeting.Type == MeetingType.ReuniaoDirecao)
            {
                // Direção meetings: Direção position holders + Admin with Tuno category
                var adminUsers = (await UserManager.GetUsersInRoleAsync("Admin")).Select(u => u.Id).ToHashSet();
                subscribedUsers = allUsers
                    .Where(u => u.Subscribed && u.EmailConfirmed && 
                        ((u.Positions != null && 
                            (u.Positions.Contains(Position.Magister) ||
                             u.Positions.Contains(Position.ViceMagister) ||
                             u.Positions.Contains(Position.Secretario) ||
                             u.Positions.Contains(Position.PrimeiroTesoureiro) ||
                             u.Positions.Contains(Position.SegundoTesoureiro))) ||
                        (adminUsers.Contains(u.Id) && u.IsTuno())))
                    .OrderBy(u => u.Nickname ?? u.FirstName)
                    .ToList();
                
                emailTunoUsers = null;
                
                // Non-subscribers: Direção-eligible users who are not subscribed
                nonSubscribedUsers = allUsers
                    .Where(u => u.EmailConfirmed && !u.Subscribed &&
                        ((u.Positions != null && 
                            (u.Positions.Contains(Position.Magister) ||
                             u.Positions.Contains(Position.ViceMagister) ||
                             u.Positions.Contains(Position.Secretario) ||
                             u.Positions.Contains(Position.PrimeiroTesoureiro) ||
                             u.Positions.Contains(Position.SegundoTesoureiro))) ||
                        (adminUsers.Contains(u.Id) && u.IsTuno())))
                    .OrderBy(u => u.Nickname ?? u.FirstName)
                    .ToList();
            }
            else
            {
                // AGO/AGE meetings: All members EXCEPT Leitão
                subscribedUsers = allUsers
                    .Where(u => u.Subscribed && u.EmailConfirmed && !u.IsLeitao())
                    .OrderBy(u => u.Nickname ?? u.FirstName)
                    .ToList();
                
                emailTunoUsers = null;
                
                // Non-subscribers for Assembleia: not subscribed
                nonSubscribedUsers = allUsers
                    .Where(u => u.EmailConfirmed && !u.Subscribed)
                    .OrderBy(u => u.Nickname ?? u.FirstName)
                    .ToList();
            }
            
            subscribedUsersCount = subscribedUsers.Count;

            // Pre-fill email subject and plain text body
            emailSubject = $"[RTUB] Reunião: {GetMeetingTypeFullName(meeting.Type)} - {meeting.Title}";
            
            // Set plain text body to the meeting statement (HTML will be generated when sending)
            emailPlainTextBody = meeting.Statement ?? string.Empty;
            emailBody = string.Empty; // Will be generated when sending
        }
        catch (Exception ex)
        {
            emailErrorMessage = $"Erro ao carregar destinatários: {ex.Message}";
        }
        finally
        {
            emailLoadingSubscribers = false;
            StateHasChanged();
        }
    }

