    private async Task PublishAta()
    {
        if (editingAta == null || editingAta.Id <= 0 || ataMeeting == null) return;
        
        isAtaLoading = true;
        ataErrorMessage = null;
        
        try
        {
            // First save any pending changes
            await MeetingAtaService.UpdateAtaAsync(editingAta);
            
            // Load ata with all details for PDF generation
            var ataWithDetails = await MeetingAtaService.GetByIdWithDetailsAsync(editingAta.Id);
            if (ataWithDetails == null)
            {
                ataErrorMessage = "Erro ao carregar dados da ata para gerar PDF.";
                return;
            }
            
            // Set meeting if not loaded
            if (ataWithDetails.Meeting == null)
            {
                ataWithDetails.Meeting = ataMeeting;
            }
            
            // Generate PDF
            var pdfBytes = AtaPdfService.GenerateAtaPdf(ataWithDetails);
            
            // Create folder in Documentation for the current fiscal year
            var fiscalYear = FiscalYearHelper.GetCurrentFiscalYearString();
            string folderName;
            
            if (ataMeeting.Type == MeetingType.ConselhoVeteranos)
            {
                folderName = $"Atas CV {fiscalYear}";
            }
            else if (ataMeeting.Type == MeetingType.AssembleiaGeralOrdinaria || 
                     ataMeeting.Type == MeetingType.AssembleiaGeralExtraordinaria)
            {
                folderName = $"Atas AG {fiscalYear}";
            }
            else
            {
                folderName = $"Atas {fiscalYear}";
            }
            
            var folderPath = $"docs/{HostEnvironment.EnvironmentName}/{fiscalYear}/{folderName}/";
            
            try
            {
                // Create folder if it doesn't exist (CreateFolderAsync checks for existence)
                await DocumentStorageService.CreateFolderAsync(folderPath);
                
                // Generate PDF filename
                var fileName = $"Ata_{ataMeeting.Type}_{ataMeeting.Date:yyyyMMdd}.pdf";
                
                // Upload PDF to documentation
                using var pdfStream = new MemoryStream(pdfBytes);
                await DocumentStorageService.UploadDocumentAsync(folderPath, fileName, pdfStream, "application/pdf");
            }
            catch (Exception ex)
            {
                // Log but don't fail the publish operation if folder/file creation fails
                Logger.LogWarning(ex, "Failed to create ATA folder or upload PDF to {FolderPath}, but ATA was published", folderPath);
            }
            
            // Publish the ata (after PDF generation and upload)
            await MeetingAtaService.PublishAtaAsync(editingAta.Id);
            
            // Update local state
            editingAta.Status = MeetingAtaStatus.Published;
            
            // Update the cache to reflect the published status
            meetingAtaPublished[ataMeeting.Id] = true;
            
            // Close confirmation modal
            ClosePublishAtaConfirmModal();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error publishing ata for meeting {MeetingId}", ataMeeting.Id);
            ataErrorMessage = $"Erro ao publicar a ata: {ex.Message}";
        }
        finally
        {
            isAtaLoading = false;
            StateHasChanged();
        }
    }
    
