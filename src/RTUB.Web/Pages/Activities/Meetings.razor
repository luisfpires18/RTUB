<!-- Push Notification Modal -->
<Modal Show="@modals.IsOpen(ModalType.PushNotification)"
       ShowChanged="@((bool show) => modals.Toggle(ModalType.PushNotification, show))"
       Title="Enviar notificação push da reunião"
       Size="Modal.ModalSize.Large"
       Centered="true"
       ShowCloseButton="true">
    <BodyContent>
        @if (selectedMeetingForPush != null)
        {
            <div class="mb-3">
                <h6 class="text-white-full">Detalhes da Reunião:</h6>
                <div class="event-summary p-3 rounded bg-dark">
                    <div><strong>Tipo:</strong> @GetMeetingTypeFullName(selectedMeetingForPush.Type)</div>
                    <div><strong>Título:</strong> @selectedMeetingForPush.Title</div>
                    <div><strong>Data:</strong> @selectedMeetingForPush.Date.ToString("dddd, dd 'de' MMMM 'de' yyyy • HH:mm", new System.Globalization.CultureInfo("pt-PT"))</div>
                    @if (!string.IsNullOrEmpty(selectedMeetingForPush.Location))
                    {
                        <div><strong>Local:</strong> @selectedMeetingForPush.Location</div>
                    }
                </div>
            </div>

            @if (pushLoadingRecipients)
            {
                <LoadingSpinner Message="A carregar destinatários..." />
            }
            else if (!string.IsNullOrEmpty(pushErrorMessage))
            {
                <Alert Message="@pushErrorMessage" 
                       Type="Alert.AlertType.Error" 
                       Dismissible="true"
                       OnDismiss="@(() => pushErrorMessage = null)" />
            }
            else
            {
                @if (selectedMeetingForPush?.Type == MeetingType.ConselhoVeteranos && pushTunoUsers != null)
                {
                    <div class="mb-3">
                        <label class="form-label text-white-full">Adicionar um Representante de Tunos</label>
                        <select class="form-select" @bind="selectedPushTunoId">
                            <option value="">Nenhum representante selecionado</option>
                            @foreach (var tuno in pushTunoUsers)
                            {
                                <option value="@tuno.Id" @key="tuno.Id">@(tuno.Nickname ?? $"{tuno.FirstName} {tuno.LastName}") - @GetYearsAsTunoDisplay(tuno)</option>
                            }
                        </select>
                        <small class="text-muted">Opcionalmente adicione um representante de Tunos à lista de destinatários para reuniões CV.</small>
                    </div>
                }
                
                <!-- Custom Notification Message -->
                <div class="mb-3">
                    <label class="form-label text-white-full">Mensagem da Notificação <span class="text-danger">*</span></label>
                    <textarea class="form-control" 
                              rows="4" 
                              @bind="customNotificationBody" 
                              placeholder="Ex: Reunião importante, confirma a tua presença!"
                              maxlength="500"></textarea>
                    <small class="text-muted">
                        A notificação terá um título automático com a data da reunião. Máximo 500 caracteres.
                    </small>
                </div>

                <EmailRecipientsPreview 
                    SubscribedUsers="@(pushFilteredRecipients ?? new List<ApplicationUser>())"
                    NonSubscribedUsers="@(pushFilteredNonSubscribedUsers ?? new List<ApplicationUser>())"
                    SubscribedUsersTitle="Destinatários com subscrições push ativas:"
                    NonSubscribedUsersTitle="Membros sem subscrição push:"
                    ShowNonSubscribedUsers="true"
                    MaxHeight="200px"
                    InfoBadgeText="@($"{pushRecipientCount} / {pushTotalUsersCount} membros têm notificações push ativas e irão receber esta mensagem.")"
                    AdditionalUserInfoFunc="@(selectedMeetingForPush?.Type == MeetingType.ConselhoVeteranos ? new Func<ApplicationUser, string>(GetYearsAsTunoDisplay) : null)"
                    ShowEmptySubscribedMessage="true"
                    EmptySubscribedMessage="Nenhum membro com subscrição push ativa encontrado." />
            }
        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="ClosePushNotificationModal">Cancelar</button>
        <button type="button" class="btn btn-primary btn-primary-purple" @onclick="SendMeetingPushNotification" disabled="@(pushRecipients == null || !pushRecipients.Any())">
            <i class="bi bi-bell-fill"></i> Enviar Notificação Push
        </button>
    </FooterContent>
</Modal>
}

<!-- Meeting Participation Modal -->
@if (participationForm != null)
{
    <MeetingParticipationModal Show="@modals.IsOpen(ModalType.Participation)"
                               ShowChanged="@((bool show) => modals.Toggle(ModalType.Participation, show))"
                               Title="@GetParticipationModalTitle()"
                               ShowWillAttend="@(!isParticipationPreSelected)"
                               WillAttend="@participationForm.WillAttend"
                               WillAttendChanged="@((bool value) => participationForm.WillAttend = value)"
                               Notes="@(participationForm.Notes ?? string.Empty)"
                               NotesChanged="@((string value) => participationForm.Notes = value)"
                               NotesRows="4"
                               NotesPlaceholder="@(participationForm.WillAttend ? "Informações adicionais..." : "Motivo da impossibilidade...")"
                               SubmitButtonText="@(isEditingParticipation ? "Atualizar" : "Confirmar")"
                               OnSubmit="@SaveParticipation"
                               OnCancel="@CloseParticipationModal" />
}

<!-- View Participants Modal -->
@if (selectedMeetingForParticipants != null)
{
    <Modal Show="@modals.IsOpen(ModalType.Participants)" 
           ShowChanged="@((bool show) => { modals.Toggle(ModalType.Participants, show); if (!show) CloseParticipantsModal(); })"
           Size="Modal.ModalSize.Large"
           Centered="true"
           Title="@($"Participantes - {selectedMeetingForParticipants.Title}")">
        <BodyContent>
            @if (meetingParticipations != null && meetingParticipations.Any())
            {
                var goingParticipants = meetingParticipations.Where(p => p.WillAttend).ToList();
                var notGoingParticipants = meetingParticipations.Where(p => !p.WillAttend).ToList();

                @if (goingParticipants.Any())
                {
                    <h6 class="mb-3 heading-purple">Vão participar (@goingParticipants.Count)</h6>
                    <div class="enrollment-card-grid enrollment-card-grid-mobile-two mb-4">
                        @foreach (var participation in goingParticipants)
                        {
                            <EnrollmentCard 
                                AvatarUrl="@participation.User?.ProfilePictureSrc"
                                TunaName="@participation.User?.Nickname"
                                FullName="@($"{participation.User?.FirstName} {participation.User?.LastName}".Trim())"
                                InstrumentText=""
                                Notes="@participation.Notes"
                                AltText="@participation.User?.GetDisplayName()"
                                ShowEditButton="false"
                                ShowDeleteButton="@CanDeleteParticipation(participation)"
                                OnDelete="@(() => OpenDeleteParticipationModal(participation))">
                                <BadgeContent>
                                    @if (participation.User != null)
                                    {
                                        <div class="enrollment-card-badges-row">
                                            @if (participation.User.Positions.Contains(Position.Magister))
                                            {
                                                <PositionBadge Position="Position.Magister" />
                                            }
                                            else if (participation.User.Categories.Contains(MemberCategory.Tuno))
                                            {
                                                <CategoryBadge Category="MemberCategory.Tuno" />
                                            }
                                            else if (participation.User.Categories.Contains(MemberCategory.Caloiro))
                                            {
                                                <CategoryBadge Category="MemberCategory.Caloiro" />
                                            }
                                        </div>
                                    }
                                </BadgeContent>
                            </EnrollmentCard>
                        }
                    </div>
                }

                @if (notGoingParticipants.Any())
                {
                    <h6 class="mb-3 heading-danger">Não vão participar (@notGoingParticipants.Count)</h6>
                    <div class="enrollment-card-grid enrollment-card-grid-mobile-two">
                        @foreach (var participation in notGoingParticipants)
                        {
                            <EnrollmentCard @key="participation.Id" 
                                AvatarUrl="@participation.User?.ProfilePictureSrc"
                                TunaName="@participation.User?.Nickname"
                                FullName="@($"{participation.User?.FirstName} {participation.User?.LastName}".Trim())"
                                InstrumentText=""
                                Notes="@participation.Notes"
                                AltText="@participation.User?.GetDisplayName()"
                                ShowEditButton="false"
                                ShowDeleteButton="@CanDeleteParticipation(participation)"
                                OnDelete="@(() => OpenDeleteParticipationModal(participation))">
                                <BadgeContent>
                                    @if (participation.User != null)
                                    {
                                        <div class="enrollment-card-badges-row">
                                            @if (participation.User.Positions.Contains(Position.Magister))
                                            {
                                                <PositionBadge Position="Position.Magister" />
                                            }
                                            else if (participation.User.Categories.Contains(MemberCategory.Tuno))
                                            {
                                                <CategoryBadge Category="MemberCategory.Tuno" />
                                            }
                                            else if (participation.User.Categories.Contains(MemberCategory.Caloiro))
                                            {
                                                <CategoryBadge Category="MemberCategory.Caloiro" />
                                            }
                                        </div>
                                    }
                                </BadgeContent>
                            </EnrollmentCard>
                        }
                    </div>
                }
            }
            else
            {
                <EmptyState Title="Nenhuma participação ainda para esta reunião"
                           Icon="bi-people" />
            }
            
            @* Add member section (Admin only) *@
            <AuthorizeView Roles="Admin,Owner">
                <Authorized>
                    <div class="mt-4 pt-3 border-top">
                        @* Success Alert (auto-dismiss) *@
                        @if (!string.IsNullOrEmpty(addMemberToParticipationFeedbackMessage) && !addMemberToParticipationFeedbackIsError)
                        {
                            <Alert Type="Alert.AlertType.Success"
                                   Message="@addMemberToParticipationFeedbackMessage"
                                   Dismissible="true"
                                   OnDismiss="ClearAddMemberToParticipationFeedback"
                                   AdditionalClasses="mb-2" />
                        }

                        @* Error Alert (manual dismiss) *@
                        @if (!string.IsNullOrEmpty(addMemberToParticipationFeedbackMessage) && addMemberToParticipationFeedbackIsError)
                        {
                            <Alert Type="Alert.AlertType.Error"
                                   Message="@addMemberToParticipationFeedbackMessage"
                                   Dismissible="true"
                                   OnDismiss="ClearAddMemberToParticipationFeedback"
                                   AdditionalClasses="mb-2" />
                        }

                        @if (!showAddMemberToParticipationSearch)
                        {
                            <button class="btn btn-sm btn-outline-primary" @onclick="ShowAddMemberToParticipationSearch">
                                <i class="bi bi-plus-circle"></i>
                                Adicionar Membro
                            </button>
                        }
                        else
                        {
                            <div class="mb-2">
                                <SearchBar @bind-Value="addMemberToParticipationSearchTerm"
                                           Placeholder="Pesquisar membro por nome..."
                                           OnSearch="@HandleAddMemberToParticipationSearchChanged" />

                                @if (!string.IsNullOrWhiteSpace(addMemberToParticipationSearchTerm) && filteredAvailableMembersForParticipation.Any())
                                {
                                    <div class="member-list member-list-scrollable mt-2">
                                        @foreach (var member in filteredAvailableMembersForParticipation)
                                        {
                                            <div class="member-item p-2 mb-2 border rounded clickable-row" @key="member.Id"
                                                 @onclick="() => AddMemberToMeeting(member)"
                                                 tabindex="0"
                                                 @onkeydown="@(async (e) => await HandleMemberItemKeyDownForParticipation(e, member))">
                                                <div class="d-flex align-items-center">
                                                    <img src="@member.ProfilePictureSrc" alt="@member.GetDisplayName()"
                                                         class="member-avatar-small me-2" />
                                                    <div>
                                                        <strong>@member.GetDisplayName()</strong>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else if (!string.IsNullOrWhiteSpace(addMemberToParticipationSearchTerm))
                                {
                                    <p class="text-muted mt-2">Nenhum membro encontrado.</p>
                                }
                            </div>

                            <button class="btn btn-sm btn-outline-secondary" @onclick="HideAddMemberToParticipationSearch">
                                <i class="bi bi-x-circle"></i>
                                Cancelar
                            </button>
                        }
                    </div>
                </Authorized>
            </AuthorizeView>
        </BodyContent>
        <FooterContent>
            <button type="button" class="btn btn-secondary" @onclick="CloseParticipantsModal">Voltar Atrás</button>
        </FooterContent>
    </Modal>
}

