            <div class="mb-3">
                <label class="form-label text-white-full fw-semibold">
                    <i class="bi bi-info-circle text-primary me-2"></i>Estado
                </label>
                <div>
                    <StatusBadge Status="@viewingRequest.Status" />
                </div>
            </div>
        }
    </BodyContent>
    <FooterContent>
        <button class="btn btn-secondary" @onclick="CloseRequestDetailsModal">Fechar</button>
    </FooterContent>
</Modal>

<!-- Delete Request Confirmation Modal -->
<Modal Show="@showDeleteRequestModal" 
       ShowChanged="@((bool show) => showDeleteRequestModal = show)"
       Title="Confirmar Eliminação">
    <BodyContent>
        @if (deletingRequest != null)
        {
            <p>Tem a certeza que quer eliminar o pedido <strong>@deletingRequest.Title</strong>?</p>
            <p class="text-muted">Esta ação não pode ser revertida.</p>
