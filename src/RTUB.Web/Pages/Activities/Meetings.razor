    /// <summary>
    /// Gets the fiscal year date range from the selected fiscal year string
    /// </summary>
    /// <returns>A tuple with start and end dates, or null if no valid fiscal year is selected</returns>
    private (DateTime start, DateTime end)? GetFiscalYearDateRange()
    {
        if (string.IsNullOrEmpty(selectedFiscalYear))
            return null;
            
        var parts = selectedFiscalYear.Split('-');
        if (parts.Length == 2 && int.TryParse(parts[0], out int startYear))
        {
            var fiscalYearStart = new DateTime(startYear, 9, 1); // September 1st
            var fiscalYearEnd = new DateTime(startYear + 1, 8, 31); // August 31st next year
            return (fiscalYearStart, fiscalYearEnd);
        }
        return null;
    }
    
