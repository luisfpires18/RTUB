    // Push notification methods
    private async Task OpenPushNotificationModal(Meeting meeting)
    {
        selectedMeetingForPush = meeting;
        pushLoadingRecipients = true;
        pushErrorMessage = null;
        selectedPushTunoId = string.Empty;
        customNotificationBody = string.Empty;
        modals.Open(ModalType.PushNotification);
        StateHasChanged();

        try
        {
            // Get all user IDs with active push subscriptions via service
            var userIdsWithPushSubscriptions = (await PushNotificationService.GetSubscribedUserIdsAsync()).ToHashSet();
            
            var allUsers = await UserManager.Users.AsNoTracking().ToListAsync();
            
            // Build recipient list based on meeting type, filtered by active push subscriptions
            List<ApplicationUser> eligibleUsers;
            
            if (meeting.Type == MeetingType.ConselhoVeteranos)
            {
                // CV meetings: Veterano + Tunossauro + Magister
                eligibleUsers = allUsers
                    .Where(u => u.CurrentRole == "VETERANO" || u.CurrentRole == "TUNOSSAURO" || u.Positions.Contains(Position.Magister))
                    .OrderBy(u => u.Nickname ?? u.FirstName)
                    .ToList();

                // Get list of Tuno users for selection (only Tunos who haven't reached Veterano yet)
                pushTunoUsers = allUsers
                    .Where(u => u.CurrentRole == "TUNO")
                    .OrderBy(u => u.Nickname ?? u.FirstName)
                    .ToList();
            }
            else if (meeting.Type == MeetingType.AssembleiaGeralOrdinaria || meeting.Type == MeetingType.AssembleiaGeralExtraordinaria)
            {
                // AGO/AGE meetings: All members EXCEPT Leitão
                eligibleUsers = allUsers
                    .Where(u => !u.IsLeitao())
                    .OrderBy(u => u.Nickname ?? u.FirstName)
                    .ToList();
                
                pushTunoUsers = null;
            }
            else if (meeting.Type == MeetingType.ReuniaoDirecao)
            {
                // Direção meetings: Direção position holders + Admin with Tuno category
                var adminUsers = (await UserManager.GetUsersInRoleAsync("Admin")).Select(u => u.Id).ToHashSet();
                eligibleUsers = allUsers
                    .Where(u => 
                        (u.Positions != null && 
                            (u.Positions.Contains(Position.Magister) ||
                             u.Positions.Contains(Position.ViceMagister) ||
                             u.Positions.Contains(Position.Secretario) ||
                             u.Positions.Contains(Position.PrimeiroTesoureiro) ||
                             u.Positions.Contains(Position.SegundoTesoureiro))) ||
                        (adminUsers.Contains(u.Id) && u.IsTuno()))
                    .OrderBy(u => u.Nickname ?? u.FirstName)
                    .ToList();
                
                pushTunoUsers = null;
            }
            else
            {
                // Default: all users
                eligibleUsers = allUsers
                    .OrderBy(u => u.Nickname ?? u.FirstName)
                    .ToList();
                
                pushTunoUsers = null;
            }
            
            // Split eligible users into subscribed (has push subscriptions) and non-subscribed
            pushRecipients = eligibleUsers
                .Where(u => userIdsWithPushSubscriptions.Contains(u.Id))
                .ToList();
            
            pushNonSubscribedUsers = eligibleUsers
                .Where(u => !userIdsWithPushSubscriptions.Contains(u.Id))
                .ToList();

            // Set filtered recipients (no filtering applied - same as unfiltered)
            pushFilteredRecipients = pushRecipients;
            pushFilteredNonSubscribedUsers = pushNonSubscribedUsers;
            pushRecipientCount = pushFilteredRecipients?.Count ?? 0;
            pushTotalUsersCount = (pushFilteredRecipients?.Count ?? 0) + (pushFilteredNonSubscribedUsers?.Count ?? 0);
        }
        catch (Exception ex)
        {
            pushErrorMessage = $"Erro ao carregar destinatários: {ex.Message}";
            Logger.LogError(ex, "Error loading push notification recipients for meeting {MeetingId}", meeting.Id);
        }
        finally
        {
            pushLoadingRecipients = false;
            StateHasChanged();
        }
    }

    private void ClosePushNotificationModal()
    {
        modals.Close(ModalType.PushNotification);
        selectedMeetingForPush = null;
        pushRecipients = null;
        pushNonSubscribedUsers = null;
        pushFilteredRecipients = null;
        pushFilteredNonSubscribedUsers = null;
        pushTunoUsers = null;
        pushRecipientCount = 0;
        pushTotalUsersCount = 0;
        pushErrorMessage = null;
        selectedPushTunoId = string.Empty;
        customNotificationBody = string.Empty;
    }

    private async Task SendMeetingPushNotification()
    {
        if (selectedMeetingForPush == null || pushFilteredRecipients == null || !pushFilteredRecipients.Any())
        {
            ClosePushNotificationModal();
            return;
        }

        if (string.IsNullOrWhiteSpace(customNotificationBody))
        {
            pushErrorMessage = "A mensagem da notificação é obrigatória.";
            return;
        }

        pushLoadingRecipients = true;
        pushErrorMessage = null;
        StateHasChanged();

        try
        {
            // Use the base URL from Navigation
            var baseUrl = Navigation.BaseUri.TrimEnd('/');
            
            // Create the notification
            var notification = PushNotificationFactory.CreateMeetingCustomNotification(
                selectedMeetingForPush,
                customNotificationBody!,
                baseUrl);

            // Build final recipient list
            var finalRecipients = pushFilteredRecipients.ToList();
            
            // Add selected Tuno if applicable for CV meetings
            if (selectedMeetingForPush.Type == MeetingType.ConselhoVeteranos && 
                !string.IsNullOrEmpty(selectedPushTunoId) && 
                pushTunoUsers != null)
            {
                var selectedTuno = pushTunoUsers.FirstOrDefault(t => t.Id == selectedPushTunoId);
                if (selectedTuno != null && !finalRecipients.Any(r => r.Id == selectedTuno.Id))
                {
                    finalRecipients.Add(selectedTuno);
                }
            }

            // Send to each recipient
            var sentCount = 0;
            foreach (var recipient in finalRecipients)
            {
                try
                {
                    await PushNotificationService.SendToUserAsync(recipient.Id, notification);
                    sentCount++;
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Failed to send push notification to user {UserId} for meeting {MeetingId}", 
                        recipient.Id, selectedMeetingForPush.Id);
                }
            }

            Logger.LogInformation("Sent push notification for meeting {MeetingId} to {SentCount}/{TotalCount} recipients",
                selectedMeetingForPush.Id, sentCount, finalRecipients.Count);

            // Audit logging for push notification
            try
            {
                var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
                var user = authState.User;
                var userId = user?.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                var userName = user?.Identity?.Name;

                if (!string.IsNullOrEmpty(userId) && !string.IsNullOrEmpty(userName))
                {
                    var changes = JsonSerializer.Serialize(new
                    {
                        RecipientCount = sentCount,
                        NotificationBody = customNotificationBody
                    });

                    var auditLog = new AuditLog
                    {
                        EntityType = "Meeting",
                        EntityId = selectedMeetingForPush.Id,
                        Action = "PushNotificationSent",
                        UserId = userId,
                        UserName = userName,
                        Timestamp = DateTime.UtcNow,
                        Changes = changes,
                        EntityDisplayName = selectedMeetingForPush.Title,
                        IsCriticalAction = false
                    };

                    await AuditLogService.AddAsync(auditLog);
                }
            }
            catch (Exception auditEx)
            {
                // Log error but don't fail the operation
                Logger.LogError(auditEx, "Failed to create audit log for push notification sent to meeting {MeetingId}", selectedMeetingForPush.Id);
            }

            // Success - close modal and reload
            pushErrorMessage = null;
            ClosePushNotificationModal();
            await LoadMeetingsAsync();
        }
        catch (Exception ex)
        {
            pushErrorMessage = $"Erro ao enviar notificações push: {ex.Message}";
            Logger.LogError(ex, "Error sending push notifications for meeting {MeetingId}", selectedMeetingForPush?.Id);
        }
        finally
        {
            pushLoadingRecipients = false;
            StateHasChanged();
        }
    }

    private string GetYearsAsTunoDisplay(ApplicationUser user)
    {
        if (user.YearTuno == null) return "< 1 ano de Tuno";
        
        var now = DateTime.Now;
        var tunoStartYear = user.YearTuno.Value;
        var tunoStartMonth = user.MonthTuno ?? 1;
        
        var tunoStart = new DateTime(tunoStartYear, tunoStartMonth, 1);
        var totalMonths = ((now.Year - tunoStart.Year) * 12) + (now.Month - tunoStart.Month);
        
        if (totalMonths < 1)
            return "< 1 mês de Tuno";
        
        var years = totalMonths / 12;
        var months = totalMonths % 12;
        
        if (years == 0)
            return months == 1 ? "1 mês de Tuno" : $"{months} meses de Tuno";
        
        if (months == 0)
            return years == 1 ? "1 ano de Tuno" : $"{years} anos de Tuno";
        
        var yearText = years == 1 ? "ano" : "anos";
        var monthText = months == 1 ? "mês" : "meses";
        return $"{years} {yearText} {months} {monthText} de Tuno";
    }
    
    /// <summary>
    /// Gets the text for days until meeting.
    /// Returns null if the meeting is in the past.
    /// </summary>
    private static string? GetDaysUntilMeetingText(DateTime meetingDate)
    {
        var today = DateTime.Today;
        var daysUntil = (meetingDate.Date - today).Days;

        if (daysUntil < 0)
            return null; // Past meeting
        if (daysUntil == 0)
            return "hoje";
        if (daysUntil == 1)
            return "1 dia";
        return $"{daysUntil} dias";
    }
    
    private bool CanManageMeetings()
    {
        if (currentUser == null) return false;
        
        // Check if user is Owner role (use cached value)
        if (isOwner) return true;
        
        // Check if user has one of the authorized positions
        if (currentUser.Positions == null) return false;
        
        return currentUser.Positions.Contains(Position.PresidenteMesaAssembleia) ||
               currentUser.Positions.Contains(Position.PresidenteConselhoVeteranos);
    }
    
    private bool CanManageMeeting(Meeting meeting)
    {
        if (currentUser == null) return false;
        
        // Owner can manage all meetings (use cached value)
        if (isOwner) return true;
        
        if (currentUser.Positions == null) return false;
        
        // PresidenteMesaAssembleia can only manage Assembleia meetings
        if (currentUser.Positions.Contains(Position.PresidenteMesaAssembleia))
        {
            return meeting.Type == MeetingType.AssembleiaGeralOrdinaria || 
                   meeting.Type == MeetingType.AssembleiaGeralExtraordinaria;
        }
        
        // PresidenteConselhoVeteranos can only manage CV meetings
        if (currentUser.Positions.Contains(Position.PresidenteConselhoVeteranos))
        {
            return meeting.Type == MeetingType.ConselhoVeteranos;
        }
        
        return false;
    }
    
    private bool CanCreateMeetingType(MeetingType type)
    {
        if (currentUser == null) return false;

        // Owner can create all types (use cached value)
        if (isOwner) return true;

        // Admin with Tuno category can create ReuniaoDirecao meetings
        if (isAdmin && currentUser.IsTuno() && type == MeetingType.ReuniaoDirecao) return true;

        if (currentUser.Positions == null) return false;

        // PresidenteMesaAssembleia can only create Assembleia meetings
        if (currentUser.Positions.Contains(Position.PresidenteMesaAssembleia))
        {
            return type == MeetingType.AssembleiaGeralOrdinaria ||
                   type == MeetingType.AssembleiaGeralExtraordinaria;
        }

        // PresidenteConselhoVeteranos can only create CV meetings
        if (currentUser.Positions.Contains(Position.PresidenteConselhoVeteranos))
        {
            return type == MeetingType.ConselhoVeteranos;
        }

        // Direcao members can create Reunião de Direção meetings
        if (currentUser.Positions.Any(p =>
            p == Position.Magister || p == Position.ViceMagister ||
            p == Position.Secretario || p == Position.PrimeiroTesoureiro ||
            p == Position.SegundoTesoureiro))
        {
            return type == MeetingType.ReuniaoDirecao;
        }

        return false;
    }
    
    private bool CanCreateAtaForMeeting(Meeting meeting)
    {
        if (currentUser == null) return false;

        var userRoles = new List<string>();
        if (isOwner) userRoles.Add("Owner");
        
        var userPositions = currentUser.Positions ?? new List<Position>();
        
        // Check if ATA exists to allow secretaries to edit
        MeetingAta? existingAta = null;
        if (meetingHasAta.TryGetValue(meeting.Id, out var hasAta) && hasAta)
        {
            meetingAtas.TryGetValue(meeting.Id, out existingAta);
        }
        
        return MeetingAtaService.CanCreateOrEditAta(currentUserId, meeting, userRoles, userPositions, existingAta);
    }
    
