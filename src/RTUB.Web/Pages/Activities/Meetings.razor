<!-- Meeting Ata Modal -->
<Modal Show="@modals.IsOpen(ModalType.Ata)" 
       ShowChanged="@((bool show) => modals.Toggle(ModalType.Ata, show))"
       Size="Modal.ModalSize.ExtraLarge"
       Title="@(editingAta?.Id > 0 ? "Editar Ata" : "Criar Ata")">
    <BodyContent>
        @if (isAtaLoading)
        {
            <div class="text-center p-4">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">A carregar...</span>
                </div>
                <p class="mt-2 text-light-theme">A carregar dados da ata...</p>
            </div>
        }
        else if (editingAta != null && ataMeeting != null)
        {
            @if (!string.IsNullOrEmpty(ataErrorMessage))
            {
                <div class="alert alert-danger mb-3">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@ataErrorMessage
                </div>
            }
            
            <!-- Informações da Reunião -->
            <div class="card mb-3">
                <div class="card-header bg-primary text-white">
                    <i class="bi bi-info-circle me-2"></i>Informações da Reunião
                </div>
                <div class="card-body">
                    <p class="mb-1"><strong>Tipo:</strong> @GetMeetingTypeFullName(ataMeeting.Type)</p>
                    <p class="mb-1"><strong>Título:</strong> @ataMeeting.Title</p>
                    <p class="mb-1"><strong>Data Agendada:</strong> @ataMeeting.Date.ToString("dd/MM/yyyy HH:mm")</p>
                </div>
            </div>
            
            <!-- Dados da Ata -->
            <div class="card mb-3">
                <div class="card-header bg-primary text-white">
                    <i class="bi bi-file-earmark-text me-2"></i>Dados da Ata
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Número da Ata</label>
                        <input type="text" class="form-control" @bind="editingAta.AtaNumber" placeholder="Ex: ATA CV 01/2025" />
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Hora de Início Efetiva <span class="text-danger">*</span></label>
                            <input type="datetime-local" class="form-control" @bind="editingAta.ActualStartTime" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Hora de Término</label>
                            <input type="datetime-local" class="form-control" @bind="editingAta.ActualEndTime" />
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Local <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" @bind="editingAta.Location" />
                    </div>
                    
                    @if (ataMeeting.Type == MeetingType.AssembleiaGeralOrdinaria || ataMeeting.Type == MeetingType.AssembleiaGeralExtraordinaria)
                    {
                        <div class="mb-3">
                            <label class="form-label">Base do Quórum</label>
                            <select class="form-select" @bind="editingAta.QuorumBasis">
                                <option value="HoraAgendada">Iniciada à hora agendada</option>
                                <option value="HoraAgendadaMais30Minutos">Iniciada 30 minutos após hora agendada</option>
                            </select>
                        </div>
                    }
                </div>
            </div>
            
            <!-- Constituição e Secretariado -->
            <div class="card mb-3">
                @if (ataMeeting.Type == MeetingType.ConselhoVeteranos)
                {
                    <div class="card-header bg-primary text-white">
                        <i class="bi bi-people me-2"></i>Constituição e Secretariado (CV)
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">Presidente do CV <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" value="@(ataPresident?.Nickname ?? ataPresident?.FirstName ?? "Não encontrado")" disabled />
                            <small class="text-muted">Membro com o cargo de Presidente do Conselho de Veteranos</small>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label">Secretário <span class="text-muted">(Opcional)</span></label>
                            @if (ataParticipants != null && ataParticipants.Any())
                            {
                                <select class="form-select" @bind="editingAta!.FirstSecretaryUserId">
                                    <option value="">-- Nenhum secretário selecionado --</option>
                                    @foreach (var participant in ataParticipants.Where(p => p.User != null))
                                    {
                                        <option value="@participant.UserId">@(participant.User!.Nickname ?? participant.User.FirstName)</option>
                                    }
                                </select>
                                <small class="text-muted">Membro inscrito escolhido pelo Presidente do CV (opcional)</small>
                            }
                            else
                            {
                                <input type="text" class="form-control" placeholder="Nenhum membro inscrito na reunião" disabled />
                                <small class="text-muted">Não existem membros inscritos para selecionar</small>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="card-header bg-primary text-white">
                        <i class="bi bi-people me-2"></i>Mesa da Assembleia Geral
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">Presidente da Mesa <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" value="@(ataPresident?.Nickname ?? ataPresident?.FirstName ?? "Não encontrado")" disabled />
                            <small class="text-muted">Membro com o cargo de Presidente da Mesa da Assembleia Geral</small>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label">1.º Secretário <span class="text-muted">(Opcional)</span></label>
                            <select class="form-select" @bind="editingAta!.FirstSecretaryUserId">
                                <option value="">-- Nenhum secretário selecionado --</option>
                                @if (ataFirstSecretaryAG != null)
                                {
                                    <option value="@ataFirstSecretaryAG.Id">@(ataFirstSecretaryAG.Nickname ?? ataFirstSecretaryAG.FirstName) (Cargo atual)</option>
                                }
                            </select>
                            <small class="text-muted">Usa o membro com cargo de 1.º Secretário da Mesa (opcional)</small>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label">2.º Secretário <span class="text-muted">(Opcional)</span></label>
                            <select class="form-select" @bind="editingAta!.SecondSecretaryUserId">
                                <option value="">-- Nenhum secretário selecionado --</option>
                                @if (ataSecondSecretaryAG != null)
                                {
                                    <option value="@ataSecondSecretaryAG.Id">@(ataSecondSecretaryAG.Nickname ?? ataSecondSecretaryAG.FirstName) (Cargo atual)</option>
                                }
                            </select>
                            <small class="text-muted">Usa o membro com cargo de 2.º Secretário da Mesa (opcional)</small>
                        </div>
                    </div>
                }
            </div>
            
            <!-- Presenças Section -->
            <div class="card mb-3">
                <div class="card-header bg-primary text-white">
                    <i class="bi bi-person-check me-2"></i>Presenças
                </div>
                <div class="card-body">
                    @if (ataParticipants != null && ataParticipants.Any())
                    {
                        <p class="mb-2"><strong>Membros presentes (@ataParticipants.Count):</strong></p>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var participant in ataParticipants.Where(p => p.User != null))
                            {
                                var user = participant.User!;
                                var displayName = !string.IsNullOrEmpty(user.Nickname)
                                    ? $"{user.FirstName} \"{user.Nickname}\" {user.LastName}"
                                    : $"{user.FirstName} {user.LastName}";
                                <span class="badge bg-success" @key="participant.UserId">@displayName</span>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Nenhum membro inscrito para esta reunião.</p>
                    }
                </div>
            </div>
            
            <!-- Ordem de trabalhos Section -->
            <div class="card mb-3">
                <div class="card-header bg-primary text-white">
                    <i class="bi bi-list-ol me-2"></i>Ordem de Trabalhos
                </div>
                <div class="card-body">
                    @if (editingAta?.AgendaPoints != null && editingAta.AgendaPoints.Any())
                    {
                        @foreach (var point in editingAta.AgendaPoints.OrderBy(p => p.PointNumber))
                        {
                            <div class="card mb-2" @key="point.Id">
                                <div class="card-body p-2">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <strong>@point.PointNumber. @point.Title</strong>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveAgendaPoint(point)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                    <div class="mt-2">
                                        <label class="form-label small">Discussão/Desenvolvimento:</label>
                                        <textarea class="form-control form-control-sm" rows="2" @bind="point.DiscussionSummary" 
                                                  placeholder="Resumo da discussão sobre este ponto..."></textarea>
                                    </div>
                                    <div class="mt-2">
                                        <label class="form-label small">Deliberação/Decisão:</label>
                                        <textarea class="form-control form-control-sm" rows="2" @bind="point.DecisionText" 
                                                  placeholder="Decisão tomada ou proposta submetida..."></textarea>
                                    </div>
                                    <div class="row mt-2">
                                        <div class="col-3">
                                            <label class="form-label small">A favor:</label>
                                            <input type="number" class="form-control form-control-sm" @bind="point.VotesFor" min="0" />
                                        </div>
                                        <div class="col-3">
                                            <label class="form-label small">Contra:</label>
                                            <input type="number" class="form-control form-control-sm" @bind="point.VotesAgainst" min="0" />
                                        </div>
                                        <div class="col-3">
                                            <label class="form-label small">Abstenções:</label>
                                            <input type="number" class="form-control form-control-sm" @bind="point.VotesAbstain" min="0" />
                                        </div>
                                        <div class="col-3">
                                            <label class="form-label small">Resultado:</label>
                                            <select class="form-select form-select-sm" @bind="point.VoteResult">
                                                <option value="">--</option>
                                                <option value="Aprovado">Aprovado</option>
                                                <option value="Rejeitado">Rejeitado</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted mb-2">Nenhum ponto adicionado ainda.</p>
                    }
                    <div class="input-group mt-2">
                        <input type="text" class="form-control" @bind="newAgendaPointTitle" 
                               placeholder="Título do novo ponto de ordem de trabalhos..." />
                        <button class="btn btn-outline-primary" type="button" @onclick="AddAgendaPoint">
                            <i class="bi bi-plus-lg me-1"></i>Adicionar
                        </button>
                    </div>
                </div>
            </div>
            
            <!-- Encerramento -->
            <div class="card mb-3">
                <div class="card-header bg-primary text-white">
                    <i class="bi bi-door-closed me-2"></i>Encerramento
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Texto de Encerramento</label>
                        <textarea class="form-control" rows="4" @bind="editingAta!.ClosingText" 
                                  placeholder="Ex: A reunião foi encerrada às XX horas, tendo sido lavrada a presente ata..."></textarea>
                    </div>
                </div>
            </div>
            
            <!-- Estado -->
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <i class="bi bi-file-earmark-text me-2"></i>Estado
                </div>
                <div class="card-body">
                    <span class="badge @(editingAta.Status == MeetingAtaStatus.Published ? "bg-success" : "bg-warning")">
                        @(editingAta.Status == MeetingAtaStatus.Published ? "Publicada" : "Rascunho")
                    </span>
                    @if (editingAta.GeneratedAt.HasValue)
                    {
                        <p class="mt-2 mb-0 small text-muted">
                            <i class="bi bi-clock me-1"></i>
                            Último PDF gerado: @editingAta.GeneratedAt.Value.ToString("dd/MM/yyyy HH:mm")
                        </p>
                    }
                </div>
            </div>
        }
    </BodyContent>
    <FooterContent>
        <div class="d-flex gap-2 w-100 justify-content-between">
            <div class="d-flex gap-2">
                @if (editingAta?.Status == MeetingAtaStatus.Draft)
                {
                    <button class="btn btn-primary" @onclick="SaveAta" disabled="@isAtaLoading">
                        <i class="bi bi-save me-1"></i>Guardar Ata
                    </button>
                    <button class="btn btn-success" @onclick="GenerateAtaPdf" disabled="@isAtaLoading">
                        <i class="bi bi-file-earmark-pdf me-1"></i>Gerar PDF
                    </button>
                    @if (editingAta?.Id > 0)
                    {
                        <button class="btn btn-warning" @onclick="OpenPublishAtaConfirmModal" disabled="@isAtaLoading" title="Publicar Ata">
                            <i class="bi bi-send me-1"></i>Publicar
                        </button>
                    }
                }
                else if (editingAta?.Status == MeetingAtaStatus.Published)
                {
                    <button class="btn btn-success" @onclick="GenerateAtaPdf" disabled="@isAtaLoading">
                        <i class="bi bi-file-earmark-pdf me-1"></i>Download PDF
                    </button>
                    <span class="badge bg-success align-self-center">
                        <i class="bi bi-check-circle me-1"></i>Ata Publicada
                    </span>
                }
            </div>
            <button class="btn btn-secondary" @onclick="CloseAtaModal" disabled="@isAtaLoading">
                <i class="bi bi-arrow-left me-1"></i>Fechar
            </button>
        </div>
    </FooterContent>
</Modal>

<!-- View Ata Modal (Read-only for non-admin users) -->
<Modal Show="@modals.IsOpen(ModalType.ViewAta)" 
       ShowChanged="@((bool show) => modals.Toggle(ModalType.ViewAta, show))"
       Size="Modal.ModalSize.ExtraLarge"
       Title="Ver Ata">
    <BodyContent>
        @if (isViewingAtaLoading)
        {
            <div class="text-center p-4">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">A carregar...</span>
                </div>
                <p class="mt-2 text-light-theme">A carregar dados da ata...</p>
            </div>
        }
        else if (viewingAta == null)
        {
            <div class="text-center p-4">
                <i class="bi bi-file-earmark-x text-muted icon-large"></i>
                <p class="mt-2 text-light-theme">Ata não encontrada.</p>
            </div>
        }
        else
        {
            <!-- Header with Meeting Info -->
            <div class="modal-info-section mb-4">
                <div class="modal-section-header">
                    <h6 class="modal-section-title">
                        <i class="bi bi-calendar3 me-2 text-primary"></i>
                        Informação da Reunião
                    </h6>
                </div>
                <div class="modal-section-body">
                    <div class="row">
                        <div class="col-md-6">
                            <p class="mb-1"><strong>Tipo:</strong> @GetMeetingTypeFullName(viewingAta.Meeting?.Type ?? MeetingType.AssembleiaGeralOrdinaria)</p>
                            <p class="mb-1"><strong>Número da Ata:</strong> @(viewingAta.AtaNumber ?? "—")</p>
                        </div>
                        <div class="col-md-6">
                            <p class="mb-1"><strong>Data:</strong> @viewingAta.Meeting?.Date.ToString("dd/MM/yyyy HH:mm")</p>
                            <p class="mb-1"><strong>Local:</strong> @viewingAta.Location</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Constituição e Secretariado -->
            <div class="modal-info-section mb-4">
                <div class="modal-section-header">
                    <h6 class="modal-section-title">
                        <i class="bi bi-people me-2 text-primary"></i>
                        @(viewingAta.Meeting?.Type == MeetingType.ConselhoVeteranos ? "Constituição e Secretariado" : "Mesa da Assembleia Geral")
                    </h6>
                </div>
                <div class="modal-section-body">
                    @if (viewingAta.Meeting?.Type == MeetingType.ConselhoVeteranos)
                    {
                        <p class="mb-1"><strong>Presidente do CV:</strong> @FormatUserNameForView(viewingAta.PresidentUser)</p>
                        @if (viewingAta.FirstSecretaryUser != null)
                        {
                            <p class="mb-1"><strong>Secretário:</strong> @FormatUserNameForView(viewingAta.FirstSecretaryUser)</p>
                        }
                        else
                        {
                            <p class="mb-1 text-muted"><strong>Secretário:</strong> (Não definido)</p>
                        }
                    }
                    else
                    {
                        <p class="mb-1"><strong>Presidente da Mesa:</strong> @FormatUserNameForView(viewingAta.PresidentUser)</p>
                        @if (viewingAta.FirstSecretaryUser != null)
                        {
                            <p class="mb-1"><strong>1.º Secretário:</strong> @FormatUserNameForView(viewingAta.FirstSecretaryUser)</p>
                        }
                        else
                        {
                            <p class="mb-1 text-muted"><strong>1.º Secretário:</strong> (Não definido)</p>
                        }
                        @if (viewingAta.SecondSecretaryUser != null)
                        {
                            <p class="mb-1"><strong>2.º Secretário:</strong> @FormatUserNameForView(viewingAta.SecondSecretaryUser)</p>
                        }
                        else
                        {
                            <p class="mb-1 text-muted"><strong>2.º Secretário:</strong> (Não definido)</p>
                        }
                    }
                </div>
            </div>

            <!-- Presenças -->
            <div class="modal-info-section mb-4">
                <div class="modal-section-header">
                    <h6 class="modal-section-title">
                        <i class="bi bi-person-check me-2 text-primary"></i>
                        Presenças
                    </h6>
                </div>
                <div class="modal-section-body">
                    @{
                        var presentParticipants = viewingAta.Meeting?.Participations?
                            .Where(p => p.WillAttend && p.User != null)
                            .ToList() ?? new List<MeetingParticipation>();
                    }
                    @if (presentParticipants.Any())
                    {
                        <p class="mb-2"><strong>Presentes (@presentParticipants.Count):</strong></p>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var participant in presentParticipants)
                            {
                                <span class="badge bg-success" @key="participant.UserId">@FormatUserNameForView(participant.User)</span>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Nenhum participante registado.</p>
                    }
                    
                    @* ATA Confirmations Section - Show who confirmed the ATA *@
                    @if (viewingAta.Status == MeetingAtaStatus.Published && ataConfirmations != null && ataConfirmations.Any(c => c.IsConfirmed == true))
                    {
                        <hr class="my-3" />
                        <p class="mb-2"><strong>Confirmaram a ata (@ataConfirmations.Count(c => c.IsConfirmed == true)):</strong></p>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var confirmation in ataConfirmations.Where(c => c.IsConfirmed == true && c.User != null))
                            {
                                <span class="badge bg-primary">@FormatUserNameForView(confirmation.User)</span>
                            }
                        </div>
                    }
                    
                    @* ATA Confirmation/Refusal Section - Only for published ATAs and users who participated *@
                    @if (viewingAta.Status == MeetingAtaStatus.Published && 
                         currentUser != null && 
                         presentParticipants.Any(p => p.UserId == currentUserId))
                    {
                        <hr class="my-3" />
                        <div class="mt-3">
                            <p class="mb-2 fw-semibold">Confirmação da Ata:</p>
                            @if (userAtaConfirmation == null || userAtaConfirmation.IsConfirmed == null)
                            {
                                <div class="d-flex gap-2">
                                    <button class="btn btn-success btn-sm" @onclick="() => ConfirmAta(viewingAta.Id)" disabled="@isAtaConfirmationLoading">
                                        <i class="bi bi-check-circle-fill me-1"></i>Confirmar
                                    </button>
                                    <button class="btn btn-danger btn-sm" @onclick="() => RefuseAta(viewingAta.Id)" disabled="@isAtaConfirmationLoading">
                                        <i class="bi bi-x-circle-fill me-1"></i>Recusar
                                    </button>
                                </div>
                            }
                            else if (userAtaConfirmation.IsConfirmed == true)
                            {
                                <div class="alert alert-success mb-0">
                                    <i class="bi bi-check-circle-fill me-2"></i>
                                    <strong>Confirmaste esta ata</strong>
                                    @if (!string.IsNullOrEmpty(userAtaConfirmation.Notes))
                                    {
                                        <p class="mb-0 mt-1"><small>@userAtaConfirmation.Notes</small></p>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-danger mb-0">
                                    <i class="bi bi-x-circle-fill me-2"></i>
                                    <strong>Recusaste esta ata</strong>
                                    @if (!string.IsNullOrEmpty(userAtaConfirmation.Notes))
                                    {
                                        <p class="mb-0 mt-1"><small>@userAtaConfirmation.Notes</small></p>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Ordem de Trabalhos -->
            @if (viewingAta.AgendaPoints != null && viewingAta.AgendaPoints.Any())
            {
                <div class="modal-info-section mb-4">
                    <div class="modal-section-header">
                        <h6 class="modal-section-title">
                            <i class="bi bi-list-ol me-2 text-primary"></i>
                            Ordem de Trabalhos
                        </h6>
                    </div>
                    <div class="modal-section-body">
                        @foreach (var point in viewingAta.AgendaPoints.OrderBy(p => p.PointNumber))
                        {
                            <div class="card mb-2" @key="point.Id">
                                <div class="card-body p-3">
                                    <h6 class="mb-2">@point.PointNumber. @point.Title</h6>
                                    @if (!string.IsNullOrEmpty(point.DiscussionSummary))
                                    {
                                        <p class="mb-1 text-light-theme"><strong>Discussão:</strong> @point.DiscussionSummary</p>
                                    }
                                    @if (!string.IsNullOrEmpty(point.DecisionText))
                                    {
                                        <p class="mb-1 text-light-theme"><strong>Deliberação:</strong> @point.DecisionText</p>
                                    }
                                    @if (point.VotesFor.HasValue || point.VotesAgainst.HasValue || point.VotesAbstain.HasValue)
                                    {
                                        <div class="d-flex gap-3 mt-2">
                                            <span class="badge bg-success">A favor: @(point.VotesFor ?? 0)</span>
                                            <span class="badge bg-danger">Contra: @(point.VotesAgainst ?? 0)</span>
                                            <span class="badge bg-secondary">Abstenções: @(point.VotesAbstain ?? 0)</span>
                                            @if (!string.IsNullOrEmpty(point.VoteResult))
                                            {
                                                <span class="badge @(point.VoteResult == "Aprovado" ? "bg-success" : "bg-danger")">@point.VoteResult</span>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Encerramento -->
            @if (!string.IsNullOrEmpty(viewingAta.ClosingText))
            {
                <div class="modal-info-section mb-4">
                    <div class="modal-section-header">
                        <h6 class="modal-section-title">
                            <i class="bi bi-door-closed me-2 text-primary"></i>
                            Encerramento
                        </h6>
                    </div>
                    <div class="modal-section-body">
                        <p class="mb-0 text-light-theme">@viewingAta.ClosingText</p>
                    </div>
                </div>
            }
        }
    </BodyContent>
    <FooterContent>
        @if (viewingAta != null)
        {
            <button class="btn btn-success" @onclick="DownloadViewingAtaPdf" disabled="@isViewingAtaLoading">
                <i class="bi bi-file-earmark-pdf me-1"></i>Download PDF
            </button>
        }
        <button class="btn btn-secondary" @onclick="CloseViewAtaModal">
            <i class="bi bi-arrow-left me-1"></i>Fechar
        </button>
    </FooterContent>
</Modal>

<!-- Publish ATA Confirmation Dialog -->
<ConfirmDialog Show="@modals.IsOpen(ModalType.PublishAtaConfirm)"
               ShowChanged="@((bool show) => modals.Toggle(ModalType.PublishAtaConfirm, show))"
               Title="Publicar Ata"
               Message="Tem a certeza que deseja publicar esta ata? Após publicação, a ata ficará visível para os utilizadores autorizados e será criada uma pasta na Documentação."
               ConfirmText="Sim, Publicar"
               CancelText="Cancelar"
               ConfirmButtonClass="btn-warning"
               OnConfirm="PublishAta"
               OnCancel="ClosePublishAtaConfirmModal"
               Disabled="@isAtaLoading" />

<!-- Mobile Bottom Nav -->
<MobileBottomNav Items="@mobileNavItems" ActiveKey="" OnSelect="HandleMobileNavSelect" />

@code {
    private List<Meeting> meetings = new();
    private List<Meeting> upcomingMeetings = new();
    private List<Meeting> pastMeetings = new();
    private bool isLoading = true;
    private string searchTerm = string.Empty;
    private int currentPage = 1;
    private int pageSize = 12;
    private int totalCount = 0;
    
    // Pagination for past meetings
    private int pastMeetingsCurrentPage = 1;
    private int pastMeetingsPageSize = 12;
    private int pastMeetingsTotalCount = 0;

    private bool isCreateMode = false;
    private Meeting? editingMeeting;
    private Meeting? deletingMeeting;
    private Meeting? viewingMeeting;
    private Meeting? selectedMeetingForEmail;
    private Meeting? selectedMeetingForCancellation;
    private List<ApplicationUser>? tunoUsersForMeetingForm;
    
    private ApplicationUser? currentUser;
    private string currentUserId = string.Empty;
    
    // Cache authentication state to avoid synchronous I/O
    private bool isOwner = false;
    private bool isAdmin = false;
    private IReadOnlyList<MobileBottomNav.MobileNavItem> mobileNavItems = Array.Empty<MobileBottomNav.MobileNavItem>();
    
    // Ata modal variables
    private Meeting? ataMeeting;
    private MeetingAta? editingAta;
