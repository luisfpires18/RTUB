    {
        return meetingHasAta.TryGetValue(meetingId, out var hasAta) && hasAta;
    }
    
    private bool IsAtaPublishedForMeeting(int meetingId)
    {
        return meetingAtaPublished.TryGetValue(meetingId, out var isPublished) && isPublished;
    }
    
    private async Task OpenViewAtaModal(Meeting meeting)
    {
        // Check if user has permission to view this meeting's ata
        if (!CanViewMeetingAta(meeting))
        {
            // User doesn't have permission to view this ata
            return;
        }
        
        isViewingAtaLoading = true;
        modals.Open(ModalType.ViewAta);
        viewingAta = null;
        userAtaConfirmation = null;
        ataConfirmations = null;
        
        try
        {
            // Check if ata exists for this meeting
            var existingAta = await MeetingAtaService.GetByMeetingIdAsync(meeting.Id);
            if (existingAta != null)
            {
                // Load with full details
                viewingAta = await MeetingAtaService.GetByIdWithDetailsAsync(existingAta.Id);
                
                // Load user's confirmation and all confirmations if ATA is published
                if (viewingAta != null && viewingAta.Status == MeetingAtaStatus.Published)
                {
                    if (!string.IsNullOrEmpty(currentUserId))
                    {
                        userAtaConfirmation = await MeetingAtaConfirmationService.GetUserConfirmationAsync(viewingAta.Id, currentUserId);
                    }
                    
                    // Load all confirmations for this ATA
                    ataConfirmations = (await MeetingAtaConfirmationService.GetConfirmationsByAtaIdAsync(viewingAta.Id)).ToList();
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading ata for viewing for meeting {MeetingId}", meeting.Id);
        }
        finally
        {
            isViewingAtaLoading = false;
            StateHasChanged();
        }
    }
    
