            emailBody = string.Empty; // Will be generated when sending
        }
        catch (Exception ex)
        {
            emailErrorMessage = $"Erro ao carregar destinatários: {ex.Message}";
        }
        finally
        {
            emailLoadingSubscribers = false;
            StateHasChanged();
        }
