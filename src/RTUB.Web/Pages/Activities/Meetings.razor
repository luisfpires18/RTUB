    private async Task LoadParticipationsAsync()
    {
        if (string.IsNullOrEmpty(currentUserId))
            return;
            
        try
        {
            // Load all participations for the current user
            allParticipations = (await MeetingParticipationService.GetParticipationsByUserIdAsync(currentUserId)).ToList();
            
            // Group participations by meeting for quick lookup
            participationsByMeeting = allParticipations
                .GroupBy(p => p.MeetingId)
                .ToDictionary(g => g.Key, g => g.ToList());
            
            // Load participation counts for all displayed meetings in a single query
            var meetingIds = meetings.Select(m => m.Id).ToList();
            participationCountsByMeeting = await MeetingParticipationService.GetParticipationCountsByMeetingIdsAsync(meetingIds);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Error loading meeting participations");
        }
    }

    private MeetingParticipation? GetUserParticipation(int meetingId)
    {
        if (participationsByMeeting.TryGetValue(meetingId, out var participations))
        {
            return participations.FirstOrDefault(p => p.UserId == currentUserId);
        }
        return null;
    }

    private int GetParticipationCount(int meetingId)
    {
        if (participationCountsByMeeting.TryGetValue(meetingId, out var count))
        {
            return count;
        }
        return 0;
    }

    private async Task LoadMeetingsAsync()
    {
        isLoading = true;
        try
        {
            var allMeetings = (await MeetingService.GetAllMeetingsAsync(searchTerm, 1, int.MaxValue, currentUserId)).ToList();
            
            // Apply fiscal year filter if selected
            var dateRange = GetFiscalYearDateRange();
            if (dateRange.HasValue)
            {
                allMeetings = allMeetings
                    .Where(m => m.Date >= dateRange.Value.start && m.Date <= dateRange.Value.end)
                    .ToList();
            }
            
            var today = DateTime.Today;
            
            // Split into upcoming and past meetings
            var allUpcoming = allMeetings
                .Where(m => m.Date.Date >= today)
                .OrderBy(m => m.Date)
                .ToList();
                
            var allPast = allMeetings
                .Where(m => m.Date.Date < today)
                .OrderByDescending(m => m.Date)
                .ToList();
            
            // Update counts
            totalCount = allUpcoming.Count;
            pastMeetingsTotalCount = allPast.Count;
            
            // Apply pagination for upcoming meetings
            upcomingMeetings = allUpcoming
                .Skip((currentPage - 1) * pageSize)
                .Take(pageSize)
                .ToList();
                
            // Apply pagination for past meetings
            pastMeetings = allPast
                .Skip((pastMeetingsCurrentPage - 1) * pastMeetingsPageSize)
                .Take(pastMeetingsPageSize)
                .ToList();
            
            // Keep the combined list for backward compatibility
            meetings = upcomingMeetings.Concat(pastMeetings).ToList();
            
            // Load ATA existence and published status for past meetings in a single query (avoiding N+1)
            meetingHasAta.Clear();
            meetingAtaPublished.Clear();
            meetingAtas.Clear();
            if (pastMeetings.Any())
            {
                var meetingIds = pastMeetings.Select(m => m.Id);
                var ataStatuses = await MeetingAtaService.GetAtaStatusForMeetingsAsync(meetingIds);
                
                // Batch load all ATAs for meetings that have them to avoid N+1 queries
                var meetingIdsWithAta = ataStatuses
                    .Where(kvp => kvp.Value.HasValue)
                    .Select(kvp => kvp.Key)
                    .ToList();
                
                if (meetingIdsWithAta.Any())
                {
                    var atasDict = await MeetingAtaService.GetByMeetingIdsAsync(meetingIdsWithAta);
                    foreach (var kvp in atasDict)
                    {
                        meetingAtas[kvp.Key] = kvp.Value;
                    }
                }
                
                // Set status flags
                foreach (var (meetingId, status) in ataStatuses)
                {
                    meetingHasAta[meetingId] = status.HasValue;
                    meetingAtaPublished[meetingId] = status == MeetingAtaStatus.Published;
                }
            }
        }
        finally
        {
            isLoading = false;
        }
    }

