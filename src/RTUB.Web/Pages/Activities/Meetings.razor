@page "/meetings"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using RTUB.Application.DTOs
@using RTUB.Application.Interfaces
@using RTUB.Application.Extensions
@using RTUB.Application.Helpers
@using RTUB.Core.Entities
@using RTUB.Core.Enums
@using RTUB.Shared
@attribute [Authorize]
@inject IMeetingService MeetingService
@inject IMeetingRequestService MeetingRequestService
@inject IEmailNotificationService EmailNotificationService
@inject IEmailTemplateRenderer EmailTemplateRenderer
@inject IFiscalYearService FiscalYearService
@inject ILabelService LabelService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider

@if (currentUser != null && currentUser.IsLeitao())
{
    <div class="text-center p-5">
        <i class="bi bi-lock-fill" style="font-size: 3rem; color: var(--bs-primary);"></i>
        <h2 class="mt-3">Acesso Restrito</h2>
        <p class="text-light-theme">Esta página não está disponível para utilizadores Leitão.</p>
    </div>
}
else
{
<div class="d-flex flex-column gap-3 mb-4">
    <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
        <div>
            <h1 class="mb-2"><i class="bi bi-calendar3"></i> Reuniões</h1>
            <p class="lead page-header-subtitle mb-0 text-light-theme">Gerir reuniões e assembleias da organização.</p>
        </div>

        <div class="page-header-actions justify-content-lg-end">
            @if (CanManageMeetings())
            {
                <button class="btn btn-success" @onclick="OpenCreateModal" title="Adicionar Nova Reunião">
                    <i class="bi bi-plus-lg"></i> Criar Reunião
                </button>
            }
            @if (CanProposeCVMeeting())
            {
                <button class="btn btn-primary" @onclick="OpenProposalModal" title="Propor Reunião de CV">
                    <i class="bi bi-megaphone"></i> Propor Reunião de CV
                </button>
            }
            @if (IsDirecaoMember())
            {
                <button class="btn btn-primary" @onclick="OpenDirecaoProposalModal" title="Propor Reunião Direção">
                    <i class="bi bi-briefcase"></i> Propor Reunião Direção
                </button>
            }
            <button class="btn btn-primary" 
                    @onclick="OpenAGProposalModal" 
                    title="Propor Assembleia Geral"
                    disabled="@(!CanProposeAGMeeting())">
                <i class="bi bi-people"></i> Propor Assembleia Geral
            </button>
        </div>
    </div>

    <!-- Purple Alert with Edit Button for Admins -->
    @if (assemblyInfoLabel != null)
    {
        <div class="position-relative">
            @if (CanManageMeetings())
            {
                <div class="position-absolute top-0 end-0 p-2">
                    <button class="btn btn-sm btn-outline-light" 
                            @onclick="OpenEditLabelModal" 
                            title="Editar informação">
                        <i class="bi bi-pencil"></i>
                    </button>
                </div>
            }
            <Alert Type="Alert.AlertType.Purple" 
                   Icon="bi-info-circle"
                   Message="@assemblyInfoLabel.Content" />
        </div>
    }

    <!-- Search Box and Fiscal Year Filter -->
    <div class="d-flex flex-column flex-lg-row align-items-lg-end gap-2 flex-wrap">
        <div class="flex-grow-1 filter-search-container">
            <SearchBar
                @bind-Value="searchTerm"
                OnSearch="HandleSearchChanged"
                Placeholder="Pesquisar por título ou declaração..." />
        </div>
        <div class="flex-lg-shrink-0 ms-lg-auto filter-dropdown-container">
            <FilterDropdown SelectedValue="@selectedFiscalYear"
                            SelectedValueChanged="@(value => selectedFiscalYear = value)"
                            OnChange="@OnFiscalYearChanged"
                            AllItemsLabel="Todos os anos"
                            Options="@fiscalYearOptions" />
        </div>
    </div>
</div>

@if (isLoading)
{
    <div class="text-center p-5">
        <LoadingSpinner />
    </div>
}
else if (!meetings.Any())
{
    <EmptyState 
        Title="Nenhuma reunião encontrada." 
        Icon="bi-info-circle" />
}
else
{
    <div class="meeting-grid">
        @foreach (var meeting in meetings)
        {
            <MeetingCard Meeting="@meeting"
                        Organizer="@meeting.Organizer"
                        IsAdmin="@CanManageMeeting(meeting)"
                        OnEdit="@(() => OpenEditModal(meeting))"
                        OnDelete="@(() => OpenDeleteModal(meeting))"
                        OnViewDetails="@(() => OpenViewDetailsModal(meeting))"
                        OnSendEmail="@(() => OpenEmailNotificationModal(meeting))"
                        OnCancel="@(() => OpenCancelMeetingModal(meeting))"
                        OnUncancel="@(() => UncancelMeeting(meeting))" />
        }
    </div>

    <!-- Pagination -->
    <TablePagination 
        CurrentPage="@currentPage"
        PageSize="@pageSize"
        TotalItems="@totalCount"
        ItemLabel="reuniões"
        PageSizeOptions="@(new[] { 6, 12, 18, 24 })"
        OnPageChanged="ChangePage"
        OnPageSizeChanged="ChangePageSize" />
}

<!-- Meeting Requests Section (CV and AG) -->
@if (CanViewCVRequests())
{
    <div class="mt-5">
        <h2 class="mb-3"><i class="bi bi-inbox"></i> Pedidos de Reuniões</h2>
        
        <!-- Filter Controls -->
        <div class="row mb-3">
            <div class="col-md-3">
                <FilterDropdown 
                    Items="@requestStatusFilterOptions"
                    SelectedValue="@selectedRequestStatusFilter"
                    SelectedValueChanged="@(async (value) => { selectedRequestStatusFilter = value; requestCurrentPage = 1; await LoadMeetingRequestsAsync(); })"
                    AllItemsLabel="Todos os Estados"
                    IconClass="bi-funnel" />
            </div>
        </div>
        
        @if (isLoadingRequests)
        {
            <div class="text-center p-5">
                <LoadingSpinner />
            </div>
        }
        else if (!meetingRequests.Any())
        {
            <EmptyState 
                Title="Nenhum pedido de reunião encontrado." 
                Icon="bi-info-circle" />
        }
        else
        {
            <div class="request-grid">
                @foreach (var request in meetingRequests)
                {
                    <AuthorizeView Roles="Owner">
                        <Authorized Context="ownerContext">
                            <MeetingRequestCard MeetingRequest="@request"
                                               IsAuthor="true"
                                               CanApproveReject="@CanApproveRejectRequests(request)"
                                               OnViewDetails="@(() => OpenRequestDetailsModal(request))"
                                               OnDelete="@(() => OpenDeleteRequestModal(request))"
                                               OnAccept="@(() => AcceptMeetingRequest(request))"
                                               OnReject="@(() => RejectMeetingRequest(request))" />
                        </Authorized>
                        <NotAuthorized>
                            <MeetingRequestCard MeetingRequest="@request"
                                               IsAuthor="@(request.AuthorUserId == currentUserId)"
                                               CanApproveReject="@CanApproveRejectRequests(request)"
                                               OnViewDetails="@(() => OpenRequestDetailsModal(request))"
                                               OnDelete="@(() => OpenDeleteRequestModal(request))"
                                               OnAccept="@(() => AcceptMeetingRequest(request))"
                                               OnReject="@(() => RejectMeetingRequest(request))" />
                        </NotAuthorized>
                    </AuthorizeView>
                }
            </div>
            
            <!-- Pagination -->
            <TablePagination 
                CurrentPage="@requestCurrentPage"
                PageSize="@requestPageSize"
                TotalItems="@requestTotalCount"
                ItemLabel="pedidos"
                PageSizeOptions="@(new[] { 4, 8, 12, 16, 20 })"
                OnPageChanged="ChangeRequestPage"
                OnPageSizeChanged="ChangeRequestPageSize" />
        }
    </div>
}


<!-- View Details Modal -->
<Modal Show="@showViewDetailsModal" 
       ShowChanged="@((bool show) => showViewDetailsModal = show)"
       Size="Modal.ModalSize.Large"
       Title="Detalhes da Reunião">
    <BodyContent>
        @if (viewingMeeting != null)
        {
            <div class="mb-3">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="badge @GetMeetingTypeBadgeClass(viewingMeeting.Type)">
                        @GetMeetingTypeFullName(viewingMeeting.Type)
                    </span>
                </div>
                <h4 class="text-white-full">@viewingMeeting.Title</h4>
            </div>

            <div class="mb-3">
                <label class="form-label text-white-full fw-semibold">
                    <i class="bi bi-calendar3 text-primary me-2"></i>Data e Hora
                </label>
                <p class="text-light-theme">@viewingMeeting.Date.ToString("dd/MM/yyyy HH:mm")</p>
            </div>

            @if (!string.IsNullOrEmpty(viewingMeeting.Location))
            {
                <div class="mb-3">
                    <label class="form-label text-white-full fw-semibold">
                        <i class="bi bi-geo-alt text-primary me-2"></i>Localização
                    </label>
                    <p class="text-light-theme">@viewingMeeting.Location</p>
                </div>
            }

            <div class="mb-3">
                <label class="form-label text-white-full fw-semibold">
                    <i class="bi bi-file-text text-primary me-2"></i>Declaração
                </label>
                <p class="text-light-theme" style="white-space: pre-line;">@viewingMeeting.Statement</p>
            </div>
        }
    </BodyContent>
    <FooterContent>
        <button class="btn btn-secondary" @onclick="CloseViewDetailsModal">Fechar</button>
    </FooterContent>
</Modal>

<!-- Create/Edit Modal -->
<Modal Show="@showEditModal" 
       ShowChanged="@((bool show) => showEditModal = show)"
       Size="Modal.ModalSize.Large"
       Title="@(isCreateMode ? "Nova Reunião" : "Editar Reunião")">
    <BodyContent>
        @if (editingMeeting != null)
        {
            <EditForm Model="editingMeeting" OnValidSubmit="SaveMeeting">
                <DataAnnotationsValidator />
                <ErrorDisplay />

                <div class="mb-3">
                    <label class="form-label text-white-full fw-semibold">
                        <i class="bi bi-tag text-primary me-2"></i>Tipo de Reunião
                    </label>
                    <InputSelect class="form-select" @bind-Value="editingMeeting.Type">
                        <option value="" disabled>-- Selecionar Tipo --</option>
                        @if (CanCreateMeetingType(MeetingType.AssembleiaGeralOrdinaria))
                        {
                            <option value="@MeetingType.AssembleiaGeralOrdinaria">Assembleia Geral Ordinária (AGO)</option>
                        }
                        @if (CanCreateMeetingType(MeetingType.AssembleiaGeralExtraordinaria))
                        {
                            <option value="@MeetingType.AssembleiaGeralExtraordinaria">Assembleia Geral Extraordinária (AGE)</option>
                        }
                        @if (CanCreateMeetingType(MeetingType.ConselhoVeteranos))
                        {
                            <option value="@MeetingType.ConselhoVeteranos">Conselho de Veteranos (CV)</option>
                        }
                        @if (CanCreateMeetingType(MeetingType.ReuniaoDirecao))
                        {
                            <option value="@MeetingType.ReuniaoDirecao">Reunião de Direção</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => editingMeeting.Type)" />
                </div>

                <div class="mb-3">
                    <label class="form-label text-white-full fw-semibold">
                        <i class="bi bi-card-text text-primary me-2"></i>Título
                    </label>
                    <InputText class="form-control" @bind-Value="editingMeeting.Title" placeholder="Inserir título..." />
                    <ValidationMessage For="@(() => editingMeeting.Title)" />
                </div>

                <div class="mb-3">
                    <label class="form-label text-white-full fw-semibold">
                        <i class="bi bi-calendar3 text-primary me-2"></i>Data e Hora
                    </label>
                    <InputDate Type="InputDateType.DateTimeLocal" class="form-control" @bind-Value="editingMeeting.Date" />
                    <ValidationMessage For="@(() => editingMeeting.Date)" />
                </div>

                <div class="mb-3">
                    <label class="form-label text-white-full fw-semibold">
                        <i class="bi bi-geo-alt text-primary me-2"></i>Localização (Opcional)
                    </label>
                    <InputText class="form-control" @bind-Value="editingMeeting.Location" placeholder="Inserir localização..." />
                    <ValidationMessage For="@(() => editingMeeting.Location)" />
                </div>

                <div class="mb-3">
                    <label class="form-label text-white-full fw-semibold">
                        <i class="bi bi-file-text text-primary me-2"></i>Declaração
                    </label>
                    <InputTextArea class="form-control" rows="10" @bind-Value="editingMeeting.Statement" placeholder="Inserir declaração..." />
                    <ValidationMessage For="@(() => editingMeeting.Statement)" />
                    <small class="text-light-theme">Máximo 5000 caracteres</small>
                </div>
            </EditForm>
        }
    </BodyContent>
    <FooterContent>
        <button class="btn btn-secondary" @onclick="CloseEditModal">Cancelar</button>
        <button class="btn btn-primary" @onclick="SaveMeeting">
            <i class="bi bi-save"></i> Guardar
        </button>
    </FooterContent>
</Modal>

<!-- Delete Confirmation Modal -->
<Modal Show="@showDeleteModal" 
       ShowChanged="@((bool show) => showDeleteModal = show)"
       Title="Confirmar Eliminação">
    <BodyContent>
        @if (deletingMeeting != null)
        {
            <p>Tem a certeza que quer eliminar a reunião <strong>@deletingMeeting.Title</strong>?</p>
            <p class="text-muted">Esta ação não pode ser revertida.</p>
        }
    </BodyContent>
    <FooterContent>
        <button class="btn btn-secondary" @onclick="CloseDeleteModal">Cancelar</button>
        <button class="btn btn-danger" @onclick="DeleteMeeting">
            <i class="bi bi-trash"></i> Eliminar
        </button>
    </FooterContent>
</Modal>

<!-- Email Notification Modal -->
<Modal Show="@showEmailNotificationModal"
       ShowChanged="@((bool show) => showEmailNotificationModal = show)"
       Title="Enviar notificação da reunião"
       Size="Modal.ModalSize.Large"
       Centered="true"
       ShowCloseButton="true">
    <BodyContent>
        @if (selectedMeetingForEmail != null)
        {
            <!-- Loading Overlay for Sending Emails -->
            @if (IsSendingEmails)
            {
                <div class="position-relative" style="min-height: 200px;">
                    <div class="position-absolute top-0 start-0 w-100 h-100 d-flex flex-column align-items-center justify-content-center" style="background-color: rgba(0,0,0,0.7); z-index: 1000; border-radius: 8px;">
                        <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
                            <span class="visually-hidden">A enviar...</span>
                        </div>
                        <h5 class="text-white mb-2">Enviando emails...</h5>
                        <p class="text-white-full mb-0">
                            @EmailsSent / @EmailsTotal
                            @if (!string.IsNullOrEmpty(LastRecipient))
                            {
                                <span> (último: @LastRecipient)</span>
                            }
                        </p>
                    </div>
                </div>
            }
            
            <div class="mb-3">
                <h6 class="text-white-full">Detalhes da Reunião:</h6>
                <div class="event-summary p-3 rounded bg-dark">
                    <div><strong>Tipo:</strong> @GetMeetingTypeFullName(selectedMeetingForEmail.Type)</div>
                    <div><strong>Título:</strong> @selectedMeetingForEmail.Title</div>
                    <div><strong>Data:</strong> @selectedMeetingForEmail.Date.ToString("dddd, dd 'de' MMMM 'de' yyyy • HH:mm", new System.Globalization.CultureInfo("pt-PT"))</div>
                    @if (!string.IsNullOrEmpty(selectedMeetingForEmail.Location))
                    {
                        <div><strong>Local:</strong> @selectedMeetingForEmail.Location</div>
                    }
                </div>
            </div>

            @if (emailLoadingSubscribers)
            {
                <div class="text-center py-3">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">A carregar...</span>
                    </div>
                </div>
            }
            else if (!string.IsNullOrEmpty(emailErrorMessage))
            {
                <Alert Message="@emailErrorMessage" 
                       Type="Alert.AlertType.Error" 
                       Dismissible="true"
                       OnDismiss="@(() => emailErrorMessage = null)" />
            }
            else
            {
                <div class="mb-3">
                    <label class="form-label text-white-full">Assunto <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" @bind="emailSubject" />
                </div>

                <div class="mb-3">
                    <label class="form-label text-white-full">Corpo do Email <span class="text-danger">*</span></label>
                    <textarea class="form-control" rows="12" @bind="emailPlainTextBody"></textarea>
                    <small class="text-muted">Escreva a mensagem da reunião em texto simples. Será formatada automaticamente no email.</small>
                </div>
                
                <div class="mb-3">
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ToggleEmailPreview">
                        <i class="bi bi-eye"></i> @(showEmailPreview ? "Ocultar" : "Ver") Pré-visualização
                    </button>
                    
                    @if (showEmailPreview)
                    {
                        <div class="mt-2 p-3 border rounded" style="max-height: 400px; overflow-y: auto; background-color: transparent;">
                            <h6 class="text-muted mb-2">Pré-visualização do Email:</h6>
                            <div>
                                @((MarkupString)emailPreviewHtml)
                            </div>
                        </div>
                    }
                </div>

                @if (selectedMeetingForEmail.Type == MeetingType.ConselhoVeteranos && emailTunoUsers != null)
                {
                    <div class="mb-3">
                        <label class="form-label text-white-full">Adicionar um Representante de Tunos</label>
                        <select class="form-select" @bind="selectedTunoId">
                            <option value="">-- Selecionar Tuno --</option>
                            @foreach (var tuno in emailTunoUsers)
                            {
                                <option value="@tuno.Id">@(tuno.Nickname ?? $"{tuno.FirstName} {tuno.LastName}") - @GetYearsAsTunoDisplay(tuno)</option>
                            }
                        </select>
                        <small class="text-muted">Opcionalmente adicione um representante de Tunos à lista de destinatários para reuniões CV.</small>
                    </div>
                }
                
                <EmailRecipientsPreview 
                    SubscribedUsers="@(subscribedUsers ?? new List<ApplicationUser>())"
                    NonSubscribedUsers="@(nonSubscribedUsers ?? new List<ApplicationUser>())"
                    SubscribedUsersTitle="Destinatários:"
                    NonSubscribedUsersTitle="Quem não irá receber:"
                    ShowNonSubscribedUsers="true"
                    MaxHeight="200px"
                    InfoBadgeText="@($"{subscribedUsersCount} membros irão receber esta mensagem.")"
                    AdditionalUserInfoFunc="@(selectedMeetingForEmail?.Type == MeetingType.ConselhoVeteranos ? new Func<ApplicationUser, string>(GetYearsAsTunoDisplay) : null)"
                    ShowEmptySubscribedMessage="true"
                    EmptySubscribedMessage="Nenhum destinatário encontrado." />
            }
        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="CloseEmailNotificationModal" disabled="@IsSendingEmails">Cancelar</button>
        <button type="button" class="btn btn-primary btn-primary-purple" @onclick="SendMeetingNotification" disabled="@(IsSendingEmails || subscribedUsers == null || !subscribedUsers.Any() || string.IsNullOrWhiteSpace(emailSubject) || string.IsNullOrWhiteSpace(emailPlainTextBody))">
            Enviar Notificação
        </button>
    </FooterContent>
</Modal>

<!-- Cancel Meeting Modal -->
<Modal Show="@showCancelMeetingModal"
       ShowChanged="@((bool show) => showCancelMeetingModal = show)"
       Title="Cancelar Reunião"
       Size="Modal.ModalSize.Large"
       Centered="true"
       ShowCloseButton="true">
    <BodyContent>
        @if (selectedMeetingForCancellation != null)
        {
            <!-- Loading Overlay for Sending Cancellation Emails -->
            @if (IsSendingEmails)
            {
                <div class="position-relative" style="min-height: 200px;">
                    <div class="position-absolute top-0 start-0 w-100 h-100 d-flex flex-column align-items-center justify-content-center" style="background-color: rgba(0,0,0,0.7); z-index: 1000; border-radius: 8px;">
                        <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
                            <span class="visually-hidden">A enviar...</span>
                        </div>
                        <h5 class="text-white mb-2">Enviando emails de cancelamento...</h5>
                        <p class="text-white-full mb-0">
                            @EmailsSent / @EmailsTotal
                            @if (!string.IsNullOrEmpty(LastRecipient))
                            {
                                <span> (último: @LastRecipient)</span>
                            }
                        </p>
                    </div>
                </div>
            }
            
            <div class="mb-3">
                <h6 class="text-white-full">Reunião:</h6>
                <div class="event-summary p-3 rounded bg-dark">
                    <div><strong>Tipo:</strong> @GetMeetingTypeFullName(selectedMeetingForCancellation.Type)</div>
                    <div><strong>Título:</strong> @selectedMeetingForCancellation.Title</div>
                    <div><strong>Data:</strong> @selectedMeetingForCancellation.Date.ToString("dddd, dd 'de' MMMM 'de' yyyy • HH:mm", new System.Globalization.CultureInfo("pt-PT"))</div>
                    @if (!string.IsNullOrEmpty(selectedMeetingForCancellation.Location))
                    {
                        <div><strong>Local:</strong> @selectedMeetingForCancellation.Location</div>
                    }
                </div>
            </div>

            @if (!string.IsNullOrEmpty(cancelMeetingErrorMessage))
            {
                <ErrorDisplay Errors="@(new[] { cancelMeetingErrorMessage })" />
            }

            @if (cancelMeetingLoadingSubscribers)
            {
                <div class="text-center py-3">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">A carregar...</span>
                    </div>
                </div>
            }
            
            <div class="mb-3 form-check">
                <input class="form-check-input" type="checkbox" id="notifySubscribersOnMeetingCancelCheckbox"
                       @bind="notifySubscribersOnMeetingCancel">
                <label class="form-check-label text-white-full" for="notifySubscribersOnMeetingCancelCheckbox">
                    Notificar todos os membros por email
                </label>
            </div>
            
            @if (notifySubscribersOnMeetingCancel)
            {
                <EmailRecipientsPreview 
                    SubscribedUsers="@(cancelMeetingSubscribedUsers ?? new List<ApplicationUser>())"
                    NonSubscribedUsers="@(cancelMeetingNonSubscribedUsers ?? new List<ApplicationUser>())"
                    SubscribedUsersTitle="Membros que irão receber:"
                    NonSubscribedUsersTitle="Quem não irá receber:"
                    ShowNonSubscribedUsers="true"
                    MaxHeight="200px"
                    InfoBadgeText="@($"{cancelMeetingSubscribedCount} / {cancelMeetingTotalCount} membros têm 'Notificações por email' ativas e irão receber esta mensagem.")"
                    AdditionalUserInfoFunc="@(selectedMeetingForCancellation?.Type == MeetingType.ConselhoVeteranos ? new Func<ApplicationUser, string>(GetYearsAsTunoDisplay) : null)" />
            }

            <div class="mb-3">
                <label class="form-label text-white-full">Motivo do Cancelamento <span class="text-danger">*</span></label>
                <textarea class="form-control" rows="4" 
                          @bind="cancelMeetingReason" 
                          placeholder="Descreva o motivo do cancelamento da reunião..."
                          maxlength="1000"></textarea>
                <small class="text-muted">Máximo 1000 caracteres</small>
            </div>
        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="CloseCancelMeetingModal" disabled="@IsSendingEmails">Não Cancelar</button>
        <button type="button" class="btn btn-danger" @onclick="ConfirmCancelMeeting" disabled="@IsSendingEmails">Cancelar Reunião</button>
    </FooterContent>
</Modal>

<!-- CV Meeting Proposal Modal -->
<Modal Show="@showProposalModal" 
       ShowChanged="@((bool show) => showProposalModal = show)"
       Size="Modal.ModalSize.Large"
       Title="@GetProposalModalTitle()">
    <BodyContent>
        @if (proposalRequest != null)
        {
            <EditForm Model="proposalRequest" OnValidSubmit="SaveMeetingProposal">
                <DataAnnotationsValidator />
                <ErrorDisplay />

                <div class="mb-3">
                    <label class="form-label text-white-full fw-semibold">
                        <i class="bi bi-card-text text-primary me-2"></i>Título
                    </label>
                    <InputText class="form-control" @bind-Value="proposalRequest.Title" placeholder="Inserir título..." />
                    <ValidationMessage For="@(() => proposalRequest.Title)" />
                </div>

                <div class="mb-3">
                    <label class="form-label text-white-full fw-semibold">
                        <i class="bi bi-calendar3 text-primary me-2"></i>Data e Hora Proposta
                    </label>
                    <InputDate Type="InputDateType.DateTimeLocal" class="form-control" @bind-Value="proposalRequest.ProposedDateTime" />
                    <ValidationMessage For="@(() => proposalRequest.ProposedDateTime)" />
                </div>

                <div class="mb-3">
                    <label class="form-label text-white-full fw-semibold">
                        <i class="bi bi-geo-alt text-primary me-2"></i>Localização (Opcional)
                    </label>
                    <InputText class="form-control" @bind-Value="proposalRequest.Location" placeholder="Ex: Discord, Centro Académico..." />
                    <ValidationMessage For="@(() => proposalRequest.Location)" />
                </div>

                <div class="mb-3">
                    <label class="form-label text-white-full fw-semibold">
