    private async Task GenerateAtaPdf()
    {
        if (editingAta == null || ataMeeting == null) return;
        
        isAtaLoading = true;
        ataErrorMessage = null;
        
        try
        {
            // First save any changes
            if (editingAta.Id == 0)
            {
                editingAta = await MeetingAtaService.CreateAtaAsync(editingAta);
                
                // Update cache to reflect the ata was created
                meetingHasAta[ataMeeting.Id] = true;
                meetingAtaPublished[ataMeeting.Id] = false;
            }
            else
            {
                await MeetingAtaService.UpdateAtaAsync(editingAta);
            }
            
            // Load ata with all details for PDF
            var ataWithDetails = await MeetingAtaService.GetByIdWithDetailsAsync(editingAta.Id);
            if (ataWithDetails == null)
            {
                ataErrorMessage = "Erro ao carregar dados da ata para gerar PDF.";
                return;
            }
            
            // Meeting is already loaded via GetByIdWithDetailsAsync with Participations
            // Only set properties if Meeting wasn't loaded for some reason
            if (ataWithDetails.Meeting == null)
            {
                ataWithDetails.Meeting = ataMeeting;
            }
            
            // Generate PDF
            var pdfBytes = AtaPdfService.GenerateAtaPdf(ataWithDetails);
            
            // Download file via JS
            var fileName = $"Ata_{ataMeeting.Type}_{ataMeeting.Date:yyyyMMdd}.pdf";
            var base64 = Convert.ToBase64String(pdfBytes);
            await JSRuntime.InvokeVoidAsync("downloadFile", fileName, base64, "application/pdf");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error generating PDF for meeting {MeetingId}", ataMeeting.Id);
            ataErrorMessage = "Erro ao gerar PDF. Por favor, tente novamente.";
        }
        finally
        {
            isAtaLoading = false;
            StateHasChanged();
        }
    }
    
