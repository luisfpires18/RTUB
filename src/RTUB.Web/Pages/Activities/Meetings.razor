    <FooterContent>
        <button class="btn btn-secondary" @onclick="CloseDeleteRequestModal">Cancelar</button>
        <button class="btn btn-danger" @onclick="DeleteMeetingRequest">
            <i class="bi bi-trash"></i> Eliminar
        </button>
