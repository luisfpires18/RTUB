    // Push Notification Modal methods
    private async Task OpenPushNotificationModal(Rehearsal rehearsal)
    {
        selectedRehearsalForPush = rehearsal;
        customNotificationBody = string.Empty;
        pushLoadingSubscribers = true;
        pushErrorMessage = null;
        filterOnlyLeitaoAndCaloiro = false;
        modals.Open(ModalType.PushNotification);
        StateHasChanged();

        try
        {
            // Get all user IDs with active push subscriptions via service
            var userIdsWithPushSubscriptions = (await PushNotificationService.GetSubscribedUserIdsAsync()).ToHashSet();

            // Get all users
            var allUsers = await UserManager.Users.AsNoTracking().ToListAsync();
            
            // Split users into subscribed (has push subscriptions) and non-subscribed
            pushSubscribedUsers = allUsers
                .Where(u => userIdsWithPushSubscriptions.Contains(u.Id))
                .OrderBy(u => u.Nickname ?? u.FirstName)
                .ToList();
            
            pushNonSubscribedUsers = allUsers
                .Where(u => !userIdsWithPushSubscriptions.Contains(u.Id))
                .OrderBy(u => u.Nickname ?? u.FirstName)
                .ToList();
            
            // Initialize filtered lists (no filter applied initially)
            ApplyPushNotificationFilter();
        }
        catch (Exception ex)
        {
            pushErrorMessage = $"Erro ao carregar membros: {ex.Message}";
        }
        finally
        {
            pushLoadingSubscribers = false;
            StateHasChanged();
        }
    }

    private void ClosePushNotificationModal()
    {
        modals.Close(ModalType.PushNotification);
        selectedRehearsalForPush = null;
        customNotificationBody = string.Empty;
        pushSubscribedUsers = null;
        pushNonSubscribedUsers = null;
        pushFilteredSubscribedUsers = null;
        pushFilteredNonSubscribedUsers = null;
        pushSubscribedUsersCount = 0;
        pushTotalUsersCount = 0;
        pushErrorMessage = null;
        filterOnlyLeitaoAndCaloiro = false;
    }
    
    private void ApplyPushNotificationFilter()
    {
        if (filterOnlyLeitaoAndCaloiro)
        {
            // Filter to include ONLY users with Leitao OR Caloiro category
            pushFilteredSubscribedUsers = pushSubscribedUsers?
                .Where(u => u.IsLeitao() || u.IsCaloiro())
                .ToList();
            
            pushFilteredNonSubscribedUsers = pushNonSubscribedUsers?
                .Where(u => u.IsLeitao() || u.IsCaloiro())
                .ToList();
        }
        else
        {
            // No filter - use original lists directly
            pushFilteredSubscribedUsers = pushSubscribedUsers;
            pushFilteredNonSubscribedUsers = pushNonSubscribedUsers;
        }
        
        // Update counts based on filtered lists
        pushSubscribedUsersCount = pushFilteredSubscribedUsers?.Count ?? 0;
        pushTotalUsersCount = (pushFilteredSubscribedUsers?.Count ?? 0) + (pushFilteredNonSubscribedUsers?.Count ?? 0);
    }
    
    private void OnFilterChanged()
    {
        ApplyPushNotificationFilter();
    }

    private async Task SendRehearsalPushNotification()
    {
        if (selectedRehearsalForPush == null || pushFilteredSubscribedUsers == null || !pushFilteredSubscribedUsers.Any())
        {
            ClosePushNotificationModal();
            return;
        }

        if (string.IsNullOrWhiteSpace(customNotificationBody))
        {
            pushErrorMessage = "A mensagem da notificação é obrigatória.";
            return;
        }

        IsSendingPushNotifications = true;
        pushErrorMessage = null;
        StateHasChanged();

        try
        {
            // Get the base URL
            var baseUri = Navigation.BaseUri.TrimEnd('/');

            // Create the push notification using the factory
            SendPushNotificationDto notification;
            try
            {
                notification = PushNotificationFactory.CreateRehearsalNotification(
                    selectedRehearsalForPush, 
                    customNotificationBody, 
                    baseUri
                );
            }
            catch (ArgumentException ex)
            {
                pushErrorMessage = ex.Message;
                IsSendingPushNotifications = false;
                StateHasChanged();
                return;
            }

            // Send to filtered subscribed users only
            var userIds = pushFilteredSubscribedUsers.Select(u => u.Id).ToList();
            await PushNotificationService.SendToSelectedUsersAsync(userIds, notification);

            // Audit logging for push notification
            try
            {
                var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
                var user = authState.User;
                var userId = user?.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                var userName = user?.Identity?.Name;

                if (!string.IsNullOrEmpty(userId) && !string.IsNullOrEmpty(userName))
                {
                    var changes = JsonSerializer.Serialize(new
                    {
                        RecipientCount = userIds.Count,
                        NotificationBody = customNotificationBody
                    });

                    // Format display name as "Ensaio - {Date} {Theme or Location}"
                    var dateStr = selectedRehearsalForPush.Date.ToString("dd/MM/yyyy");
                    var themeOrLocation = !string.IsNullOrEmpty(selectedRehearsalForPush.Theme) 
                        ? selectedRehearsalForPush.Theme 
                        : selectedRehearsalForPush.Location;
                    var displayName = $"Ensaio - {dateStr} {themeOrLocation}";

                    var auditLog = new AuditLog
                    {
                        EntityType = "Rehearsal",
                        EntityId = selectedRehearsalForPush.Id,
                        Action = "PushNotificationSent",
                        UserId = userId,
                        UserName = userName,
                        Timestamp = DateTime.UtcNow,
                        Changes = changes,
                        EntityDisplayName = displayName,
                        IsCriticalAction = false
                    };

                    await AuditLogService.AddAsync(auditLog);
                }
            }
            catch (Exception auditEx)
            {
                // Log error but don't fail the operation
                Logger.LogError(auditEx, "Failed to create audit log for push notification sent to rehearsal {RehearsalId}", selectedRehearsalForPush.Id);
            }

            // Success - close modal
            ClosePushNotificationModal();
        }
        catch (Exception ex)
        {
            pushErrorMessage = $"Erro ao enviar notificação push: {ex.Message}";
        }
        finally
        {
            IsSendingPushNotifications = false;
            StateHasChanged();
        }
    }

    private class UserAttendanceStats
    {
        public string UserId { get; set; } = string.Empty;
        public string UserName { get; set; } = string.Empty;
        public string Nickname { get; set; } = string.Empty;
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string AvatarUrl { get; set; } = string.Empty;
        public List<MemberCategory> Categories { get; set; } = new();
        public int PendingCount { get; set; }
        public int ApprovedCount { get; set; }
        public int TotalPastRehearsals { get; set; }

        public string DisplayNickname => !string.IsNullOrWhiteSpace(Nickname) ? Nickname : UserName;

        public string DisplayFullName
        {
            get
            {
                var fullName = $"{FirstName} {LastName}".Trim();
                return string.IsNullOrWhiteSpace(fullName) ? UserName : fullName;
            }
        }

        public string DisplayName => !string.IsNullOrWhiteSpace(UserName) ? UserName : DisplayFullName;

        public string SearchText => $"{DisplayNickname} {DisplayFullName}".ToLower();

        public double AttendancePercentage => TotalPastRehearsals > 0 ? (double)ApprovedCount / TotalPastRehearsals * 100 : 0;
    }

