<!-- Minhas Presenças Modal -->
@if (modals.IsOpen(ModalType.MyAttendances))
{
    <Modal Show="@modals.IsOpen(ModalType.MyAttendances)"
           ShowChanged="@((bool show) => modals.Toggle(ModalType.MyAttendances, show))"
           Title="Minhas Presenças Recentes"
           Size="Modal.ModalSize.Large"
           Centered="true">
        <BodyContent>
            @if (rehearsalAttendances == null || !rehearsalAttendances.Any())
            {
                <EmptyState 
                    Title="Sem presenças registadas." 
                    Icon="bi-info-circle" />
            }
            else
            {
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <strong>Taxa de Presença @(showAllRehearsals ? "(todos os ensaios)" : "(últimos 10 ensaios)"):</strong>
                        <span class="badge bg-primary">@attendanceCount / @totalRecentRehearsals ensaios</span>
                        @if (totalRecentRehearsals > 0)
                        {
                            <span class="ms-2">(@(Math.Round((double)attendanceCount / totalRecentRehearsals * 100, 1))%)</span>
                        }
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="showAllRehearsalsToggle" 
                               @bind="showAllRehearsals" @bind:after="OnRehearsalToggleChanged" />
                        <label class="form-check-label" for="showAllRehearsalsToggle">
                            Mostrar todos
                        </label>
                    </div>
                </div>
                <div class="activity-card-lite-grid">
                    @foreach (var item in paginatedRehearsalAttendances)
                    {
                        <ActivityCardLite @key="item.Rehearsal.Id">
                            <div class="activity-card-lite-row">
                                <span class="activity-card-lite-value w-100 text-center">@FormatRehearsalDateWithDayOfWeek(item.Rehearsal)</span>
                            </div>
                            <div class="activity-card-lite-row">
                                <span class="activity-card-lite-value w-100 text-center">
                                    @if (item.WillAttend)
                                    {
                                        if (item.Attended)
                                        {
                                            <span class="badge bg-success">Foi</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Foi</span>
                                            <span class="badge bg-warning ms-1">Pendente</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Não foi</span>
                                    }
                                </span>
