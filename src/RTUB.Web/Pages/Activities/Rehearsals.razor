    private async Task CancelAttendance(RehearsalAttendance attendance)
    {
        try
        {
            // Update the attendance to set WillAttend to false (cancel attendance)
            await AttendanceService.CancelAttendanceAsync(attendance.Id, currentUserId);
            
            // Refresh the attendance list
            if (selectedRehearsal != null)
            {
                selectedRehearsalAttendances = (await AttendanceService.GetAttendancesByRehearsalIdAsync(selectedRehearsal.Id)).ToList();
                FilterAttendances();
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            // Handle error silently or show error message
            Console.WriteLine($"Error canceling attendance: {ex.Message}");
        }
    }

    private async Task ApproveAttendance(RehearsalAttendance attendance)
    {
        try
        {
            // Save current page before refreshing
            var currentPage = attendancesPagination.CurrentPage;
            
            await AttendanceService.UpdateAttendanceAsync(attendance.Id, true, attendance.Instrument, currentUserId);
            
            // Refresh the attendance list in modal
            if (selectedRehearsal != null)
            {
                await ViewAttendances(selectedRehearsal);
                
                // Restore the page number after refresh
                attendancesPagination.CurrentPage = currentPage;
                UpdatePaginatedAttendances();
            }
            
            // Refresh the main rehearsal list to update counts and pending status
            await LoadData();
            
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error approving attendance: {ex.Message}");
        }
    }

    private async Task CalculateRehearsalInstrumentCountsAsync()
    {
        primaryInstrumentCounts = new Dictionary<InstrumentType, int>();
        otherInstrumentCounts = new Dictionary<InstrumentType, int>();
        
        if (selectedRehearsal == null || selectedRehearsalAttendances == null)
            return;
        
        // Get all user IDs from attendances
        var userIds = selectedRehearsalAttendances
            .Where(a => a.WillAttend && !string.IsNullOrEmpty(a.UserId))
            .Select(a => a.UserId)
            .Distinct()
            .ToList();
        
        if (!userIds.Any())
            return;
        
        // Fetch all member instruments in one query
        var memberInstruments = await MemberInstrumentService.GetMemberInstrumentsByUserIdsAsync(userIds);
        
        // Use service to calculate counts
        (primaryInstrumentCounts, otherInstrumentCounts) = 
            RehearsalStatisticsService.CalculateInstrumentCounts(selectedRehearsal, memberInstruments);
    }

