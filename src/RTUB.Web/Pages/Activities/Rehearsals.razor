    private void UpdateUrlState()
    {
        // Don't update URL during initialization to avoid redirect loop
        if (isInitializing)
        {
            return;
        }

        // Use service to build query string
        var queryString = RehearsalUrlService.BuildQueryString(selectedFiscalYear, currentFiscalYear, searchTerm, previousRehearsalsSearch);
        var newUrl = Navigation.ToAbsoluteUri("/rehearsals" + (string.IsNullOrEmpty(queryString) ? "" : "?" + queryString)).ToString();
        Navigation.NavigateTo(newUrl, false); // false = don't force reload
    }

    private async Task ViewAttendances(Rehearsal rehearsal)
    {
        selectedRehearsal = rehearsal;
        isSelectedRehearsalPast = rehearsal.Date.Date < DateTime.Today;
        
        // Allow approval for past rehearsals OR today's rehearsals with start time >= 21:00
        isSelectedRehearsalApprovable = isSelectedRehearsalPast || 
            (rehearsal.Date.Date == DateTime.Today && rehearsal.StartTime.Hours >= 21);
        
        selectedRehearsalAttendances = (await AttendanceService.GetAttendancesByRehearsalIdAsync(rehearsal.Id)).ToList();

        // User details are now loaded via Include in the repository method to avoid N+1 queries

        // Initialize filtered attendances and reset pagination
        attendanceSearchTerm = "";
        attendanceApprovalFilter = "Todos";
        attendancesPagination = new PaginationHelper<RehearsalAttendance>() { PageSize = 8 };
        mainParticipantsPagination = new PaginationHelper<RehearsalAttendance>() { PageSize = 8 };
        leitoesPagination = new PaginationHelper<RehearsalAttendance>() { PageSize = 8 };
        FilterAttendances();
        
        // Calculate primary and other instrument counts
        await CalculateRehearsalInstrumentCountsAsync();

        // Load all members for adding if admin AND it's an approvable rehearsal
        // Use projection to load only needed fields for better performance
        if (isAdmin && isSelectedRehearsalApprovable)
        {
            allMembers = await UserManager.Users
                .AsNoTracking()
                .Select(u => new ApplicationUser
                {
                    Id = u.Id,
                    FirstName = u.FirstName,
                    LastName = u.LastName,
                    Nickname = u.Nickname,
                    ImageUrl = u.ImageUrl
                })
                .ToListAsync();
            addMemberSearchTerm = "";
            addMemberFeedbackMessage = "";
            FilterAvailableMembers();
        }

        modals.Open(ModalType.Attendances);
        StateHasChanged();
    }

