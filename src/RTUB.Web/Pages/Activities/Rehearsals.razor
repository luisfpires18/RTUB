    private async Task LoadStats()
    {
        try
        {
            // Get all rehearsals in the date range
            var rehearsals = await RehearsalService.GetRehearsalsAsync(statsStartDate, statsEndDate);
            var rehearsalIds = rehearsals.Select(r => r.Id).ToHashSet();

            // Count total past rehearsals in range for percentage calculation (excluding cancelled)
            totalPastRehearsalsInRange = rehearsals
                .Count(r => r.Date.Date < DateTime.Today && !r.IsCanceled);
            
            // Batch load all attendances for all rehearsals to avoid N+1 queries
            var allAttendances = (await AttendanceService.GetAttendancesByRehearsalIdsAsync(rehearsalIds)).ToList();
            
            // Filter to only WillAttend entries
            var filteredAttendances = allAttendances
                .Where(a => a.Rehearsal != null && a.WillAttend)
                .ToList();

            // Group by user and count pending/approved participations
            var today = DateTime.Today;
            var stats = filteredAttendances
                .GroupBy(a => a.UserId)
                .Select(g => new {
                    UserId = g.Key,
                    PendingCount = g.Count(a => a.Rehearsal!.Date < today && !a.Rehearsal!.IsCanceled && !a.Attended),
                    ApprovedCount = g.Count(a => a.Rehearsal!.Date < today && !a.Rehearsal!.IsCanceled && a.Attended)
                })
                .ToList();

            // Batch load all users to avoid N+1 queries
            var userIds = stats.Select(s => s.UserId).Distinct().ToList();
            var users = await UserManager.Users
                .AsNoTracking()
                .Where(u => userIds.Contains(u.Id))
                .ToDictionaryAsync(u => u.Id);

            attendanceStatsUsers = new List<UserAttendanceStats>();
            
            foreach (var stat in stats)
            {
                if (users.TryGetValue(stat.UserId, out var user))
                {
                    attendanceStatsUsers.Add(new UserAttendanceStats
                    {
                        UserId = stat.UserId,
                        UserName = user.GetDisplayName(),
                        Nickname = user.Nickname ?? string.Empty,
                        FirstName = user.FirstName ?? string.Empty,
                        LastName = user.LastName ?? string.Empty,
                        AvatarUrl = user.ProfilePictureSrc,
                        Categories = user.Categories,
                        PendingCount = stat.PendingCount,
                        ApprovedCount = stat.ApprovedCount,
                        TotalPastRehearsals = totalPastRehearsalsInRange
                    });
                }
            }
            
            FilterStats();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading stats: {ex.Message}");
            attendanceStatsUsers = new List<UserAttendanceStats>();
        }
    }

    private void FilterStats()
    {
        if (attendanceStatsUsers == null)
        {
            filteredStatsUsers = new List<UserAttendanceStats>();
            paginatedStatsUsers = new List<UserAttendanceStats>();
            return;
        }

        var filtered = attendanceStatsUsers.AsEnumerable();

        // Apply category filter
        if (!string.IsNullOrEmpty(selectedStatsCategoryFilter))
        {
            filtered = selectedStatsCategoryFilter switch
            {
                "Tuno" => filtered.Where(s => s.Categories.Contains(MemberCategory.Tuno) || 
                                             s.Categories.Contains(MemberCategory.Veterano) || 
                                             s.Categories.Contains(MemberCategory.Tunossauro)),
                "Caloiro" => filtered.Where(s => s.Categories.Contains(MemberCategory.Caloiro)),
                "Leitao" => filtered.Where(s => s.Categories.Contains(MemberCategory.Leitao)),
                _ => filtered
            };
        }

        // Apply search
        if (!string.IsNullOrWhiteSpace(statsSearchTerm))
        {
            var search = statsSearchTerm.ToLower();
            filtered = filtered.Where(s => s.SearchText.Contains(search));
        }

        filteredStatsUsers = filtered.ToList();

        // Apply sorting
        var columnSelectors = new Dictionary<string, Func<UserAttendanceStats, IComparable>>
        {
            { nameof(UserAttendanceStats.UserName), s => s.UserName },
            { nameof(UserAttendanceStats.ApprovedCount), s => s.ApprovedCount }
        };
        filteredStatsUsers = statsSortHelper.ApplySort(filteredStatsUsers, columnSelectors);

        // Reset pagination when filter changes
        statsPaginationHelper.Reset();

        // Apply pagination
        paginatedStatsUsers = statsPaginationHelper.GetPageData(filteredStatsUsers);
    }

    private async Task HandleStatsSearchChanged(string searchTerm)
    {
        statsSearchTerm = searchTerm;
        FilterStats();
        await Task.CompletedTask;
    }

    private void SortStatsBy(string columnName)
    {
        statsSortHelper.ChangeSortColumn(columnName);
        FilterStats();
    }

    private async Task HandleStatsPageChange(int newPage)
    {
        statsPaginationHelper.GoToPage(newPage);
        paginatedStatsUsers = statsPaginationHelper.GetPageData(filteredStatsUsers);
        await Task.CompletedTask;
    }

    private async Task HandleStatsPageSizeChange(int newPageSize)
    {
        statsPaginationHelper.PageSize = newPageSize;
        statsPaginationHelper.Reset();
        paginatedStatsUsers = statsPaginationHelper.GetPageData(filteredStatsUsers);
        await Task.CompletedTask;
    }

