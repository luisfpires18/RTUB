    private async Task LoadUserAttendances()
    {
        if (currentUserId == null) return;

        try
        {
            // Get user's attendances for ALL rehearsals (both past and upcoming)
            var userAttendances = (await AttendanceService.GetAttendancesByUserIdAsync(currentUserId))
                .ToDictionary(a => a.RehearsalId, a => a);

            // Get past rehearsals based on toggle state for the "Minhas Presenças" modal
            var startDate = showAllRehearsals ? DateTime.Today.AddYears(-10) : DateTime.Today.AddMonths(-6);
            var recentRehearsals = await RehearsalService.GetRehearsalsAsync(startDate, DateTime.Today);
            
            var pastRehearsals = recentRehearsals
                .Where(r => !r.IsCanceled && r.Date < DateTime.Today)
                .OrderByDescending(r => r.Date)
                .Take(showAllRehearsals ? int.MaxValue : 10)
                .ToList();

            // Get upcoming rehearsals to include in the attendance tracking (exclude cancelled)
            var upcomingRehearsalsWithAttendance = upcomingRehearsals
                .Where(r => !r.IsCanceled && userAttendances.ContainsKey(r.Id))
                .ToList();

            // Combine past rehearsals (for modal display) with upcoming rehearsals (for button state)
            var allRehearsalsForTracking = pastRehearsals.Concat(upcomingRehearsalsWithAttendance).ToList();

            // Create display list combining rehearsals with attendance status
            rehearsalAttendances = allRehearsalsForTracking.Select(r => new RehearsalAttendanceDisplay
            {
                Rehearsal = r,
                Attendance = userAttendances.ContainsKey(r.Id) ? userAttendances[r.Id] : null
            }).ToList();

            totalRecentRehearsals = pastRehearsals.Count;
            attendanceCount = pastRehearsals.Count(r => userAttendances.ContainsKey(r.Id) && userAttendances[r.Id].Attended);
            
            // Apply pagination
            UpdatePaginatedRehearsalAttendances();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading user attendances: {ex.Message}");
            rehearsalAttendances = new List<RehearsalAttendanceDisplay>();
            paginatedRehearsalAttendances = new List<RehearsalAttendanceDisplay>();
        }
    }

    private async Task OnRehearsalToggleChanged()
    {
        rehearsalsPaginationHelper.Reset(); // Reset to page 1 when toggling
        await LoadUserAttendances();
    }
    
    private void UpdatePaginatedRehearsalAttendances()
    {
        // Only paginate past rehearsals for the "Minhas Presenças" modal
        var pastAttendances = rehearsalAttendances
            .Where(a => a.Rehearsal.Date < DateTime.Today)
            .ToList();
        paginatedRehearsalAttendances = rehearsalsPaginationHelper.GetPageData(pastAttendances);
    }
    
    private async Task HandleRehearsalsAttendancePageChange(int newPage)
    {
        rehearsalsPaginationHelper.GoToPage(newPage);
        UpdatePaginatedRehearsalAttendances();
        await Task.CompletedTask;
    }
    
    private async Task HandleRehearsalsAttendancePageSizeChange(int newPageSize)
    {
        rehearsalsPaginationHelper.PageSize = newPageSize;
        rehearsalsPaginationHelper.Reset();
        UpdatePaginatedRehearsalAttendances();
        await Task.CompletedTask;
    }

