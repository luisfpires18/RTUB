<!-- Statistics Modal (Members) -->
@if (modals.IsOpen(ModalType.Stats))
{
    <Modal Show="@modals.IsOpen(ModalType.Stats)"
           ShowChanged="@((bool show) => modals.Toggle(ModalType.Stats, show))"
           Title="Estatísticas de Presenças"
           Size="Modal.ModalSize.Large"
           Centered="true">
        <BodyContent>
            <div class="mb-3">
                <div class="row g-2">
                    <div class="col-md-3">
                        <label class="form-label">Data Início</label>
                        <input type="date" class="form-control" @bind="statsStartDate" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Data Fim</label>
                        <input type="date" class="form-control" @bind="statsEndDate" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Categoria</label>
                        <FilterDropdown SelectedValue="@selectedStatsCategoryFilter"
                                        SelectedValueChanged="@(value => selectedStatsCategoryFilter = value)"
                                        OnChange="@FilterStats"
                                        AllItemsLabel="Todos"
                                        Options="@statsCategoryFilterOptions" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">&nbsp;</label>
                        <button class="btn btn-primary w-100 d-block" @onclick="LoadStats">Carregar Estatísticas</button>
                    </div>
                </div>
            </div>

            @if (attendanceStatsUsers != null && attendanceStatsUsers.Any())
            {
                <!-- Search Bar -->
                <div class="mb-3">
                    <SearchBar @bind-Value="statsSearchTerm"
                               Placeholder="Pesquisar por nome..."
                               OnSearch="@HandleStatsSearchChanged" />
                </div>

                @if (!filteredStatsUsers.Any())
                {
                    <EmptyState 
                        Title="Nenhum membro encontrado com os critérios de pesquisa." 
                        Icon="bi-search" />
                }
                else
                {
                    <div class="member-card-lite-grid">
                        @foreach (var stat in paginatedStatsUsers)
                        {
                            <MemberCardLite @key="stat.UserId"
                                            AvatarUrl="@stat.AvatarUrl"
                                            AltText="@stat.DisplayName"
                                            Nickname="@stat.DisplayNickname"
                                            FullName="@stat.DisplayFullName">
                                <CategoryContent>
                                    @foreach (var category in stat.Categories)
                                    {
                                        <CategoryBadge @key="@($"category-{stat.UserId}-{category}")" Category="@category" />
                                    }
                                </CategoryContent>
                                <PrimaryRowContent>
                                    <div class="d-flex flex-column align-items-center gap-1">
                                        <div class="d-flex flex-wrap align-items-center gap-2 justify-content-center">
                                            @if (stat.ApprovedCount > 0)
                                            {
                                                <span class="badge bg-success">@stat.ApprovedCount aprovado(s)</span>
                                            }
                                            @if (stat.PendingCount > 0)
                                            {
                                                <span class="badge bg-warning text-dark">@stat.PendingCount pendente(s)</span>
                                            }
                                            @if (stat.PendingCount == 0 && stat.ApprovedCount == 0)
                                            {
                                                <span class="text-muted">Sem participações</span>
                                            }
                                        </div>
                                        @if (totalPastRehearsalsInRange > 0 && stat.ApprovedCount > 0)
                                        {
                                            <div class="text-muted small">
                                                @stat.AttendancePercentage.ToString("0.0")% de @totalPastRehearsalsInRange ensaios
                                            </div>
                                        }
                                    </div>
                                </PrimaryRowContent>
                            </MemberCardLite>
                        }
                    </div>

                    <!-- Pagination -->
                    <TablePagination CurrentPage="@statsPaginationHelper.CurrentPage"
                                    PageSize="@statsPaginationHelper.PageSize"
                                    TotalItems="@filteredStatsUsers.Count"
                                    ItemLabel="membros"
                                    PageSizeOptions="@(new[] { 15, 30, 45, 60 })"
                                    OnPageChanged="@HandleStatsPageChange"
                                    OnPageSizeChanged="@HandleStatsPageSizeChange" />
                }
            }
            else if (attendanceStatsUsers != null)
            {
                <EmptyState 
                    Title="Sem dados para o período selecionado." 
                    Icon="bi-info-circle" />
            }
        </BodyContent>
        <FooterContent>
            <button type="button" class="btn btn-secondary" @onclick="CloseStatsModal">Voltar Atrás</button>
        </FooterContent>
    </Modal>
}

