    private void FilterAvailableMembers()
    {
        if (selectedRehearsalAttendances == null)
        {
            filteredAvailableMembers = new List<ApplicationUser>();
            return;
        }

        if (string.IsNullOrWhiteSpace(addMemberSearchTerm))
        {
            filteredAvailableMembers = new List<ApplicationUser>();
            return;
        }

        // Get list of user IDs already in attendance
        var attendingUserIds = selectedRehearsalAttendances.Select(a => a.UserId).ToHashSet();

        // Filter members who are not already attending
        var available = allMembers.Where(u => !attendingUserIds.Contains(u.Id));

        var search = addMemberSearchTerm.ToLower();
        filteredAvailableMembers = available
            .Where(u => (u.FirstName?.ToLower().Contains(search) ?? false) ||
                       (u.LastName?.ToLower().Contains(search) ?? false) ||
                       (u.Nickname?.ToLower().Contains(search) ?? false))
            .OrderBy(u => u.FirstName)
            .ToList();
    }

    private async Task AddMemberToRehearsal(ApplicationUser user)
    {
        if (selectedRehearsal == null) return;

        try
        {
            // Get the member's primary instrument
            var primaryInstrument = await MemberInstrumentService.GetPrimaryInstrumentAsync(user.Id);
            var instrumentToUse = primaryInstrument?.InstrumentType;
            
            // For approvable rehearsals (past or today after 21:00), create attendance with immediate approval
            // This avoids creating "Created + Modified" audit entries
            if (isSelectedRehearsalApprovable)
            {
                await AttendanceService.CreateAttendanceWithApprovalAsync(selectedRehearsal.Id, user.Id, instrumentToUse, null, null);
            }
            else
            {
                // For future rehearsals, create pending attendance (Attended = false)
                // Skip notification since this is an admin adding a user manually
                await AttendanceService.MarkAttendanceAsync(selectedRehearsal.Id, user.Id, true, instrumentToUse, null, null, skipNotification: true);
            }
            
            addMemberFeedbackMessage = $"Presença de {user.FirstName} \"{user.Nickname}\" adicionada com sucesso.";
            addMemberFeedbackIsError = false;
            
            // Hide the search after successful addition
            showAddMemberSearch = false;
            addMemberSearchTerm = string.Empty;
            
            // Refresh attendance list in modal
            await ViewAttendances(selectedRehearsal);
            
            // Refresh the main rehearsal list to update counts
            await LoadData();
            
            StateHasChanged();
        }
        catch (Exception ex)
        {
            addMemberFeedbackMessage = $"Erro ao adicionar membro: {ex.Message}";
            addMemberFeedbackIsError = true;
            Console.WriteLine($"Error adding member: {ex.Message}");
        }
    }

