    private void FilterAttendances()
    {
        if (selectedRehearsalAttendances == null)
        {
            filteredAttendances = new();
            filteredMainParticipants = new();
            filteredLeitoes = new();
            filteredNotAttending = new();
            UpdatePaginatedAttendances();
            return;
        }

        var filtered = selectedRehearsalAttendances.AsEnumerable();

        // Apply approval status filter
        if (attendanceApprovalFilter == "Pendente")
        {
            filtered = filtered.Where(a => a.WillAttend && !a.Attended);
        }
        else if (attendanceApprovalFilter == "Aprovado")
        {
            filtered = filtered.Where(a => a.WillAttend && a.Attended);
        }

        // Apply search filter
        if (!string.IsNullOrWhiteSpace(attendanceSearchTerm))
        {
            var search = attendanceSearchTerm.ToLower();
            filtered = filtered.Where(a => 
                (a.User?.FirstName?.ToLower().Contains(search) ?? false) ||
                (a.User?.LastName?.ToLower().Contains(search) ?? false) ||
                (a.User?.Nickname?.ToLower().Contains(search) ?? false) ||
                (a.User?.Email?.ToLower().Contains(search) ?? false));
        }

        filteredAttendances = filtered
            .OrderByDescending(a => a.Attended)
            .ThenBy(a => a.User?.FirstName)
            .ToList();

        // Split into main participants and leitões
        var mainParticipants = filtered
            .Where(a => a.User != null && a.WillAttend && !a.User.Categories.Contains(MemberCategory.Leitao))
            .OrderByDescending(a => a.Attended)
            .ThenBy(a => a.User?.FirstName)
            .ToList();
        
        var leitoes = filtered
            .Where(a => a.User != null && a.WillAttend && a.User.Categories.Contains(MemberCategory.Leitao))
            .OrderByDescending(a => a.Attended)
            .ThenBy(a => a.User?.FirstName)
            .ToList();
        
        // Filter not attending members with search
        var notAttending = selectedRehearsalAttendances
            .Where(a => a.User != null && !a.WillAttend)
            .AsEnumerable();
        
        if (!string.IsNullOrWhiteSpace(attendanceSearchTerm))
        {
            var search = attendanceSearchTerm.ToLower();
            notAttending = notAttending.Where(a => 
                (a.User?.FirstName?.ToLower().Contains(search) ?? false) ||
                (a.User?.LastName?.ToLower().Contains(search) ?? false) ||
                (a.User?.Nickname?.ToLower().Contains(search) ?? false) ||
                (a.User?.Email?.ToLower().Contains(search) ?? false));
        }
        
        filteredMainParticipants = mainParticipants;
        filteredLeitoes = leitoes;
        filteredNotAttending = notAttending.OrderBy(a => a.User?.FirstName).ToList();

        // Reset to page 1 when filters change
        attendancesPagination.GoToPage(1);
        mainParticipantsPagination.CurrentPage = 1;
        leitoesPagination.CurrentPage = 1;
        notAttendingPagination.CurrentPage = 1;
        UpdatePaginatedAttendances();
    }
    
