    /// <summary>
    /// Determines if the delete action should be available for rehearsals.
    /// </summary>
    private bool CanDeleteRehearsal()
    {
        return isAdmin;
    }
    
    private bool CanCancelRehearsal()
    {
        return isAdmin;
    }
    
    /// <summary>
    /// Determines if the delete action should be available for attendances.
    /// Admins can delete any attendance from approvable rehearsals.
    /// Users can delete their own attendance from any rehearsal.
    /// </summary>
    private bool CanDeleteAttendance(RehearsalAttendance? attendance = null)
    {
        if (isAdmin && isSelectedRehearsalApprovable)
        {
            return true;
        }

        return attendance != null && currentUser != null && attendance.UserId == currentUser.Id;
    }
