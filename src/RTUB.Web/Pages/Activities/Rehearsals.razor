        <FooterContent>
            <button type="button" class="btn btn-secondary" @onclick="CloseMyAttendancesModal">Voltar Atrás</button>
        </FooterContent>
    </Modal>
}

<!-- Push Notification Modal -->
<Modal Show="@modals.IsOpen(ModalType.PushNotification)"
       ShowChanged="@((bool show) => modals.Toggle(ModalType.PushNotification, show))"
       Title="Enviar notificação push de ensaio"
       Size="Modal.ModalSize.Large"
       Centered="true"
       ShowCloseButton="true">
    <BodyContent>
        @if (selectedRehearsalForPush != null)
        {
            <!-- Loading Overlay for Sending Push Notifications -->
            @if (IsSendingPushNotifications)
            {
                <div class="position-relative loading-overlay-container">
                    <div class="position-absolute top-0 start-0 w-100 h-100 d-flex flex-column align-items-center justify-content-center loading-overlay-backdrop">
                        <LoadingSpinner Size="@SpinnerSize.Large" Color="@SpinnerColor.Light" Centered="false" AdditionalContainerClass="mb-3" />
                        <h5 class="text-white mb-2">Enviando notificações push...</h5>
                    </div>
                </div>
            }
            else
            {
                <div class="mb-3">
                    <h6 class="text-white-full">Detalhes do Ensaio:</h6>
                    <div class="event-summary p-3 rounded bg-dark">
                        <div><strong>Data:</strong> @FormatRehearsalDateWithDayOfWeek(selectedRehearsalForPush)</div>
                        <div><strong>Horário:</strong> @selectedRehearsalForPush.StartTime.ToString(@"hh\:mm") - @selectedRehearsalForPush.EndTime.ToString(@"hh\:mm")</div>
                        <div><strong>Local:</strong> @selectedRehearsalForPush.Location</div>
                        @if (!string.IsNullOrEmpty(selectedRehearsalForPush.Theme))
                        {
                            <div><strong>Tema:</strong> @selectedRehearsalForPush.Theme</div>
                        }
                    </div>
                </div>

                @if (pushLoadingSubscribers)
                {
                    <LoadingSpinner Message="A carregar subscritores..." />
                }
                else if (!string.IsNullOrEmpty(pushErrorMessage))
                {
                    <Alert Message="@pushErrorMessage" 
                           Type="Alert.AlertType.Error" 
                           Dismissible="true"
                           OnDismiss="@(() => pushErrorMessage = null)" />
                }
                else
                {
                    <!-- Custom Notification Message -->
                    <div class="mb-3">
                        <label class="form-label text-white-full">Mensagem da Notificação <span class="text-danger">*</span></label>
                        <textarea class="form-control" 
                                  rows="4" 
                                  @bind="customNotificationBody" 
                                  placeholder="Ex: Ensaio importante!"
                                  maxlength="500"></textarea>
                        <small class="text-muted">
                            A notificação terá o título automático no formato "Ensaio - DD/MMM DayOfWeek". Máximo 500 caracteres.
                        </small>
                    </div>
                    
                    <!-- Filter Option -->
                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" 
                                   type="checkbox" 
                                   id="filterLeitaoCaloiro"
                                   @bind="filterOnlyLeitaoAndCaloiro"
                                   @bind:after="OnFilterChanged" />
                            <label class="form-check-label text-white-full" for="filterLeitaoCaloiro">
                                Enviar apenas para <strong>Leitões</strong> e <strong>Caloiros</strong>
                            </label>
                        </div>
                        @if (filterOnlyLeitaoAndCaloiro)
                        {
                            <small class="text-warning d-block mt-1">
                                <i class="bi bi-info-circle me-1"></i>
                                As notificações serão enviadas apenas para membros com as categorias "Leitão" ou "Caloiro".
                            </small>
                        }
                    </div>
                    
                    <EmailRecipientsPreview 
                        SubscribedUsers="@(pushFilteredSubscribedUsers ?? new List<ApplicationUser>())"
                        NonSubscribedUsers="@(pushFilteredNonSubscribedUsers ?? new List<ApplicationUser>())"
                        SubscribedUsersTitle="Membros que irão receber:"
                        NonSubscribedUsersTitle="Quem não irá receber:"
                        ShowNonSubscribedUsers="true"
                        MaxHeight="300px"
                        InfoBadgeText="@($"{pushSubscribedUsersCount} / {pushTotalUsersCount} membros têm notificações push ativas e irão receber esta mensagem.")"
                        ShowEmptySubscribedMessage="true"
                        EmptySubscribedMessage="Nenhum membro subscrito às notificações push." />
                }
            }
        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="ClosePushNotificationModal" disabled="@IsSendingPushNotifications">Cancelar</button>
        <button type="button" class="btn btn-primary btn-primary-purple" @onclick="SendRehearsalPushNotification" disabled="@(IsSendingPushNotifications || pushFilteredSubscribedUsers == null || !pushFilteredSubscribedUsers.Any() || string.IsNullOrWhiteSpace(customNotificationBody))">
            Enviar Notificação Push
        </button>
    </FooterContent>
</Modal>

<!-- Mobile Bottom Nav -->
<MobileBottomNav Items="@mobileNavItems" ActiveKey="" OnSelect="HandleMobileNavSelect" />

@code {
    private bool loading = true;
    private bool isInitializing = true;
    private bool isAdmin = false;
    private bool isOwner = false;
    private IReadOnlyList<MobileBottomNav.MobileNavItem> mobileNavItems = Array.Empty<MobileBottomNav.MobileNavItem>();
    private string? currentUserId;
    private ApplicationUser? currentUser;
    private List<InstrumentType> currentUserInstruments = new();

    private List<Rehearsal> upcomingRehearsals = new();
    private List<Rehearsal> filteredUpcomingRehearsals = new();
    private List<Rehearsal> paginatedUpcomingRehearsals = new();
    private PaginationHelper<Rehearsal> upcomingRehearsalsPagination = new() { PageSize = 12 };
    private List<RehearsalAttendanceDisplay> rehearsalAttendances = new();
    private List<RehearsalAttendanceDisplay> paginatedRehearsalAttendances = new();
    private int attendanceCount = 0;
    private int totalRecentRehearsals = 0;
    private bool showAllRehearsals = false;
    private PaginationHelper<RehearsalAttendanceDisplay> rehearsalsPaginationHelper = new() { PageSize = 9 };


    private string FormatRehearsalDateWithDayOfWeek(Rehearsal rehearsal)
    {
        var dayName = rehearsal.Date.ToPortugueseWeekdayName();
        return $"{rehearsal.Date:dd MMM yyyy} ({dayName})";
    }

    // Previous rehearsals
    private List<Rehearsal> previousRehearsals = new();
    private List<Rehearsal> filteredPreviousRehearsals = new();
    private List<Rehearsal> paginatedPreviousRehearsals = new();
    private string previousRehearsalsSearch = "";
    private PaginationHelper<Rehearsal> previousRehearsalsPagination = new() { PageSize = 12 };

    // Fiscal year filtering
    private List<string> fiscalYears = new();
    private string currentFiscalYear = "";
    private string selectedFiscalYear = "";
    private IEnumerable<FilterDropdownOption> fiscalYearOptions => fiscalYears
        .Select(year => new FilterDropdownOption(year, $"{year}{(year == currentFiscalYear ? " (ATUAL)" : string.Empty)}"));
    private string searchTerm = "";

    // Modals
    private enum ModalType
    {
        Attendance,
        Attendances,
        Edit,
        Delete,
        DeleteAttendance,
        CancelMyAttendance,
        CancelRehearsal,
        Create,
        Stats,
        DateRange,
        MyAttendances,
        RehearsalDetails,
        PushNotification
    }

    private readonly MultiModalState<ModalType> modals = new();
    
    private Rehearsal? selectedRehearsal;
    private bool isSelectedRehearsalPast = false;
    private bool isSelectedRehearsalApprovable = false;
    private Rehearsal? editingRehearsal;
