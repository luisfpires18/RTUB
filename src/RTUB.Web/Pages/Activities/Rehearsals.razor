@page "/rehearsals"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.EntityFrameworkCore
@using System.ComponentModel.DataAnnotations
@using RTUB.Application.Interfaces
@using RTUB.Application.Helpers
@using RTUB.Application.Extensions
@using RTUB.Application.DTOs
@using RTUB.Shared
@using RTUB.Shared.Base
@using RTUB.Core.Enums
@using RTUB.Core.Entities
@using System.Text.Json
@attribute [Authorize]
@inject IRehearsalService RehearsalService
@inject IRehearsalAttendanceService AttendanceService
@inject IRehearsalAttendanceFilterService AttendanceFilterService
@inject IRehearsalFilterService RehearsalFilterService
@inject IRehearsalStatisticsService RehearsalStatisticsService
@inject IRehearsalUrlService RehearsalUrlService
@inject IFiscalYearService FiscalYearService
@inject IMemberInstrumentService MemberInstrumentService
@inject IPushNotificationService PushNotificationService
@inject IPushNotificationFactory PushNotificationFactory
@inject IAuditLogService AuditLogService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject ILogger<Rehearsals> Logger

<div class="page-header-centered">
    <div class="page-header-left"></div>
    <div class="page-header-center">
        <h1><i class="bi bi-music-note-list"></i> Ensaios</h1>
        <p class="lead page-header-subtitle text-light-theme">Ensaios regulares da tuna (Terças e Quintas, 21:30-00:00).</p>
    </div>
    <div class="page-header-right d-none d-xl-flex gap-2">
        @if (isAdmin)
        {
            <button class="btn btn-success" @onclick="OpenCreateSingleModal" title="Criar Ensaio (Data Específica)">
                <i class="bi bi-plus-lg"></i> Adicionar Ensaio
            </button>
            <button class="btn btn-success" @onclick="OpenDateRangeModal" title="Criar Ensaios (Intervalo)">
                <i class="bi bi-calendar-range"></i> Adicionar Vários
            </button>
        }
        <button class="btn btn-outline-primary" @onclick="OpenStatsModal" title="Ver Estatísticas">
            <i class="bi bi-bar-chart"></i> Estatísticas
        </button>
        <button class="btn btn-outline-secondary" @onclick="OpenMyAttendancesModal" title="Minhas Presenças">
            <i class="bi bi-calendar-check"></i> Minhas Presenças
        </button>
    </div>
</div>

<!-- Filter Controls -->
<div class="d-flex flex-column flex-lg-row align-items-lg-end gap-2 flex-wrap mb-4">
    <div class="flex-grow-1 filter-search-container">
        <SearchBar @bind-Value="searchTerm"
                   Placeholder="Pesquisar por tema ou localização..."
                   OnSearch="@HandleSearchChanged" />
    </div>
    <div class="flex-lg-shrink-0 ms-lg-auto filter-dropdown-container">
        <FilterDropdown SelectedValue="@selectedFiscalYear"
                        SelectedValueChanged="@(value => selectedFiscalYear = value)"
                        OnChange="@OnFiscalYearChanged"
                        AllItemsLabel="Todos os anos"
                        Options="@fiscalYearOptions" />
    </div>
</div>

@if (loading)
{
    <LoadingSpinner Message="A carregar ensaios..." />
}
else
{
    <!-- Upcoming Rehearsals Section -->
    <h3 class="mt-4 mb-3">Próximos Ensaios</h3>

    @if (filteredUpcomingRehearsals == null || !filteredUpcomingRehearsals.Any())
    {
        <EmptyState Title="Nenhum ensaio agendado"
                   Icon="bi-info-circle" />
    }
    else
    {
        <div class="rehearsal-grid">
            @foreach (var rehearsal in paginatedUpcomingRehearsals)
            {
                var userAttendance = GetUserAttendance(rehearsal.Id);
                var attendanceCount = rehearsal.Attendances.Count(a => a.WillAttend);

                <RehearsalCard @key="rehearsal.Id"
                               Rehearsal="@rehearsal"
                               UserAttendance="@userAttendance"
                               AttendanceCount="@attendanceCount"
                               IsAdmin="@isAdmin"
                               IsPastRehearsal="false"
                               ShowDeleteButton="@CanDeleteRehearsal()"
                               ShowCancelButton="@CanCancelRehearsal()"
                               OnEdit="@(() => OpenEditModal(rehearsal))"
                               OnDelete="@(() => OpenDeleteModal(rehearsal))"
                               OnSendPushNotification="@(() => OpenPushNotificationModal(rehearsal))"
                               OnCancel="@(() => OpenCancelRehearsalModal(rehearsal))"
                               OnUncancel="@(() => UncancelRehearsal(rehearsal))"
                               OnMarkAttendance="@(() => MarkAttendance(rehearsal))"
                               OnAttendPending="@(() => MarkAttendanceWithStatus(rehearsal, true))"
                               OnAttendNotGoing="@(() => MarkAttendanceWithStatus(rehearsal, false))"
                               OnViewAttendances="@(() => ViewAttendances(rehearsal))"
                               OnEditAttendance="@(() => EditAttendance(rehearsal))"
                               OnRemoveAttendance="@(() => RemoveAttendance(rehearsal))"
                               OnViewDetails="@(() => OpenRehearsalDetailsModal(rehearsal))" />
            }
        </div>
        
        <!-- Pagination for upcoming rehearsals -->
        <TablePagination CurrentPage="@upcomingRehearsalsPagination.CurrentPage"
                        PageSize="@upcomingRehearsalsPagination.PageSize"
                        TotalItems="@filteredUpcomingRehearsals.Count"
                        ItemLabel="ensaios"
                        PageSizeOptions="@(new[] { 6, 12, 24, 36, 48 })"
                        OnPageChanged="@HandleUpcomingRehearsalsPageChange"
                        OnPageSizeChanged="@HandleUpcomingRehearsalsPageSizeChange" />
    }
    
    <!-- Previous Rehearsals Section -->
    <h3 class="mt-5 mb-3">Ensaios Anteriores</h3>

    <!-- Search for previous rehearsals -->
    <div class="mb-3">
        <SearchBar @bind-Value="previousRehearsalsSearch"
                   Placeholder="Pesquisar ensaio anterior..."
                   OnSearch="@HandlePreviousRehearsalsSearchChanged" />
    </div>

    @if (filteredPreviousRehearsals == null || !filteredPreviousRehearsals.Any())
    {
        <EmptyState Title="Nenhum ensaio anterior encontrado"
                   Icon="bi-info-circle" />
    }
    else
    {
        <div class="rehearsal-grid">
            @foreach (var rehearsal in paginatedPreviousRehearsals)
            {
                var userAttendance = GetUserAttendance(rehearsal.Id);
                var attendanceCount = rehearsal.Attendances.Count(a => a.WillAttend);
                var hasPendingApprovals = isAdmin && rehearsal.Attendances.Any(a => a.WillAttend && !a.Attended);

                <RehearsalCard @key="rehearsal.Id"
                               Rehearsal="@rehearsal"
                               UserAttendance="@userAttendance"
                               AttendanceCount="@attendanceCount"
                               IsAdmin="@isAdmin"
                               IsPastRehearsal="true"
                               HasPendingApprovals="@hasPendingApprovals"
                               ShowDeleteButton="@CanDeleteRehearsal()"
                               ShowCancelButton="@CanCancelRehearsal()"
                               OnEdit="@(() => OpenEditModal(rehearsal))"
                               OnDelete="@(() => OpenDeleteModal(rehearsal))"
                               OnCancel="@(() => OpenCancelRehearsalModal(rehearsal))"
                               OnUncancel="@(() => UncancelRehearsal(rehearsal))"
                               OnMarkAttendance="@(() => {})"
                               OnAttendPending="@(() => {})"
                               OnAttendNotGoing="@(() => {})"
                               OnViewAttendances="@(() => ViewAttendances(rehearsal))"
                               OnEditAttendance="@(() => {})"
                               OnRemoveAttendance="@(() => RemoveAttendance(rehearsal))"
                               OnViewDetails="@(() => OpenRehearsalDetailsModal(rehearsal))" />
            }
        </div>

        <!-- Pagination for previous rehearsals -->
        <TablePagination CurrentPage="@previousRehearsalsPagination.CurrentPage"
                        PageSize="@previousRehearsalsPagination.PageSize"
                        TotalItems="@filteredPreviousRehearsals.Count"
                        ItemLabel="ensaios"
                         PageSizeOptions="@(new[] { 6, 12, 24, 36, 48 })"
                        OnPageChanged="@HandlePreviousRehearsalsPageChange"
                        OnPageSizeChanged="@HandlePreviousRehearsalsPageSizeChange" />
    }
}

<!-- Mark Attendance Modal (using unified ParticipationModal) -->
@if (modals.IsOpen(ModalType.Attendance) && selectedRehearsal != null && attendanceForm != null)
{
    <ParticipationModal Show="@modals.IsOpen(ModalType.Attendance)"
                       ShowChanged="@((bool show) => modals.Toggle(ModalType.Attendance, show))"
                       Title="@GetAttendanceModalTitle()"
                       ShowWillAttend="@(!isParticipationPreSelected)"
                       WillAttend="@attendanceForm.WillAttend"
                       WillAttendChanged="@((bool value) => attendanceForm.WillAttend = value)"
                       IsLeitao="@(currentUser != null && currentUser.Categories.Contains(MemberCategory.Leitao))"
                       Instrument="@attendanceForm.Instrument"
                       InstrumentChanged="@((InstrumentType? value) => attendanceForm.Instrument = value)"
                       AvailableInstruments="@currentUserInstruments"
                       Notes="@attendanceForm.Notes"
                       NotesChanged="@((string value) => attendanceForm.Notes = value)"
                       NotesRows="3"
                       NotesPlaceholder="@(attendanceForm.WillAttend ? "Adicione alguma nota..." : "Motivo da impossibilidade...")"
                       SubmitButtonText="Confirmar"
                       WantToPlay="@wantToPlayRehearsal"
                       WantToPlayChanged="@((bool value) => wantToPlayRehearsal = value)"
                       OnSubmit="@ConfirmMarkAttendance"
                       OnCancel="@CloseAttendanceModal" />
}

<!-- View Attendances Modal -->
<Modal Show="@(modals.IsOpen(ModalType.Attendances) && selectedRehearsal != null)"
       ShowChanged="@((bool show) => { if (!show) CloseAttendancesModal(); })"
       Title="@($"Presenças - {selectedRehearsal?.Date.ToString("dd MMM yyyy")}")"
       Size="Modal.ModalSize.Large"
       OnClose="CloseAttendancesModal">
    <BodyContent>
        @if (selectedRehearsalAttendances != null && selectedRehearsalAttendances.Any())
        {
            <!-- Filter and Search Row -->
            <div class="row g-2 mb-3">
                @if (isAdmin && isSelectedRehearsalApprovable)
                {
                    <div class="col-12 col-md-4">
                        <FilterDropdown
                            SelectedValue="@attendanceApprovalFilter"
                            SelectedValueChanged="@(value => attendanceApprovalFilter = value)"
                            OnChange="@FilterAttendances"
                            UseDefaultOption="false"
                            Items="@(new[] { "Todos", "Pendente", "Aprovado" })" />
                    </div>
                }
                <div class="@(isAdmin && isSelectedRehearsalApprovable ? "col-12 col-md-8" : "col-12")">
                    <SearchBar @bind-Value="attendanceSearchTerm"
                               Placeholder="Pesquisar por nome..."
                               OnSearch="@HandleAttendanceSearchChanged" />
                </div>
            </div>
            
            var notAttendingMembers = selectedRehearsalAttendances.Where(a => a.User != null && !a.WillAttend).ToList();
            
            @if (filteredMainParticipants.Any())
            {
                <h6 class="mb-3 heading-purple">Membros (@filteredMainParticipants.Count)</h6>
                
                <div class="enrollment-card-grid enrollment-card-grid-mobile-two mb-4">
                    @foreach (var attendance in paginatedMainParticipants)
                    {
                        var instrumentDisplay = attendance.Instrument.HasValue ? StatusHelper.GetInstrumentDisplay(attendance.Instrument.Value) : "";
                         <EnrollmentCard @key="attendance.Id" 
                            AvatarUrl="@attendance.User?.ProfilePictureSrc"
                            TunaName="@attendance.User?.Nickname"
                            FullName="@($"{attendance.User?.FirstName} {attendance.User?.LastName}".Trim())"
                            InstrumentText="@instrumentDisplay"
                            OtherInstruments="@attendance.OtherInstruments"
                            Notes="@attendance.Notes"
                            AltText="@attendance.User?.GetDisplayName()"
                            ShowEditButton="false"
                            ShowDeleteButton="@CanDeleteAttendance(attendance)"
                            ShowApproveButton="@(isAdmin && isSelectedRehearsalApprovable && !attendance.Attended)"
                            ShowCancelButton="@(isAdmin && isSelectedRehearsalApprovable && !attendance.Attended)"
                            OnDelete="@(() => OpenDeleteAttendanceModal(attendance))"
                            OnApprove="@(() => ApproveAttendance(attendance))"
                            OnCancel="@(() => OpenDeleteAttendanceModal(attendance))"
                            DeleteTooltip="Eliminar"
                            ApproveTooltip="Aprovar"
                            CancelTooltip="Cancelar">
                            <BadgeContent>
                                @if (attendance.User != null)
                                {
                                    <div class="enrollment-card-badges-row">
                                        @* Status badge first *@
                                        @if (attendance.Attended)
                                        {
                                            <span class="badge bg-success">Aprovado</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning">Pendente</span>
                                        }
                                    </div>
                                    <div class="enrollment-card-badges-row">
                                        @* Category badge below status — snapshot if present, else current *@
                                        @{
                                            var __mainCat = attendance.EffectiveCategory();
                                        }
                                        @if (attendance.User.Positions.Contains(Position.Magister))
                                        {
                                            <PositionBadge Position="Position.Magister" />
                                        }
                                        else if (__mainCat == MemberCategory.Tuno)
                                        {
                                            <CategoryBadge Category="MemberCategory.Tuno" />
                                        }
                                        else if (__mainCat == MemberCategory.Caloiro)
                                        {
                                            <CategoryBadge Category="MemberCategory.Caloiro" />
                                        }
                                    </div>
                                }
                            </BadgeContent>
                        </EnrollmentCard>
                    }
                </div>

                <!-- Pagination for Main Participants -->
                @if (filteredMainParticipants.Count > 0)
                {
                    <div class="mb-3">
                        <TablePagination 
                            TotalItems="@filteredMainParticipants.Count"
                            CurrentPage="@mainParticipantsPagination.CurrentPage"
                            PageSize="@mainParticipantsPagination.PageSize"
                            PageSizeOptions="@(new[] { 4, 8, 12, 16 })"
                            OnPageChanged="@HandleMainParticipantsPageChange"
                            OnPageSizeChanged="@HandleMainParticipantsPageSizeChange" />
                    </div>
                }

                @* Instrument Counts - Horizontal Counter Section *@
                <InstrumentCounter InstrumentCounts="@primaryInstrumentCounts" Title="Instrumentos" />
                <InstrumentCounter InstrumentCounts="@otherInstrumentCounts" Title="Outros Instrumentos" Collapsible="true" DefaultCollapsed="true" />
            }

            @if (filteredLeitoes.Any())
            {
                <h6 class="mb-3 heading-warning">Leitões (@filteredLeitoes.Count)</h6>
                <div class="enrollment-card-grid enrollment-card-grid-mobile-two">
                    @foreach (var attendance in paginatedLeitoes)
                    {
                        var instrumentDisplay = attendance.Instrument.HasValue ? StatusHelper.GetInstrumentDisplay(attendance.Instrument.Value) : "";
                        <EnrollmentCard @key="attendance.Id" 
                            AvatarUrl="@attendance.User?.ProfilePictureSrc"
                            TunaName="@attendance.User?.Nickname"
                            FullName="@($"{attendance.User?.FirstName} {attendance.User?.LastName}".Trim())"
                            InstrumentText="@instrumentDisplay"
                            OtherInstruments="@attendance.OtherInstruments"
                            Notes="@attendance.Notes"
                            AltText="@attendance.User?.GetDisplayName()"
                            ShowEditButton="false"
                            ShowDeleteButton="@CanDeleteAttendance(attendance)"
                            ShowApproveButton="@(isAdmin && isSelectedRehearsalApprovable && !attendance.Attended)"
                            ShowCancelButton="@(isAdmin && isSelectedRehearsalApprovable && !attendance.Attended)"
                            OnDelete="@(() => OpenDeleteAttendanceModal(attendance))"
                            OnApprove="@(() => ApproveAttendance(attendance))"
                            OnCancel="@(() => OpenDeleteAttendanceModal(attendance))"
                            DeleteTooltip="Eliminar"
                            ApproveTooltip="Aprovar"
                            CancelTooltip="Cancelar">
                            <BadgeContent>
                                <div class="enrollment-card-badges-row">
                                    @* Status badge first *@
                                    @if (attendance.Attended)
                                    {
                                        <span class="badge bg-success">Aprovado</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning">Pendente</span>
                                    }
                                </div>
                                <div class="enrollment-card-badges-row">
                                    @* Category badge below status *@
                                    <CategoryBadge Category="MemberCategory.Leitao" />
                                </div>
                            </BadgeContent>
                        </EnrollmentCard>
                    }
                </div>
                
                <!-- Pagination for Leitões -->
                @if (filteredLeitoes.Count > 0)
                {
                    <div class="mt-3">
                        <TablePagination 
                            TotalItems="@filteredLeitoes.Count"
                            CurrentPage="@leitoesPagination.CurrentPage"
                            PageSize="@leitoesPagination.PageSize"
                            PageSizeOptions="@(new[] { 4, 8, 12, 16 })"
                            OnPageChanged="@HandleLeitoesPageChange"
                            OnPageSizeChanged="@HandleLeitoesPageSizeChange" />
                    </div>
                }
            }
            
            @if (filteredNotAttending.Any())
            {
                <h6 class="mb-3 mt-4 heading-danger">Não vão participar (@filteredNotAttending.Count)</h6>
                <div class="enrollment-card-grid enrollment-card-grid-mobile-two">
                    @foreach (var attendance in paginatedNotAttending)
                    {
                    <EnrollmentCard
                        AvatarUrl="@attendance.User?.ProfilePictureSrc"
                        TunaName="@attendance.User?.Nickname"
                        FullName="@($"{attendance.User?.FirstName} {attendance.User?.LastName}".Trim())"
                        InstrumentText=""
                        Notes="@attendance.Notes"
                        AltText="@attendance.User?.GetDisplayName()"
                        ShowEditButton="false"
                        ShowDeleteButton="@CanDeleteAttendance(attendance)"
                        OnDelete="@(() => OpenDeleteAttendanceModal(attendance))"
                        DeleteTooltip="Eliminar">
                            <BadgeContent>
                                @if (attendance.User != null)
                                {
                                    <div class="enrollment-card-badges-row">
                                        @* Category badge for not attending members — snapshot first *@
                                        @{
                                            var __naCat = attendance.EffectiveCategory();
                                        }
                                        @if (attendance.User.Positions.Contains(Position.Magister))
                                        {
                                            <PositionBadge Position="Position.Magister" />
                                        }
                                        else if (__naCat == MemberCategory.Tuno)
                                        {
                                            <CategoryBadge Category="MemberCategory.Tuno" />
                                        }
                                        else if (__naCat == MemberCategory.Caloiro)
                                        {
                                            <CategoryBadge Category="MemberCategory.Caloiro" />
                                        }
                                        else if (__naCat == MemberCategory.Leitao)
                                        {
                                            <CategoryBadge Category="MemberCategory.Leitao" />
                                        }
                                    </div>
                                }
                            </BadgeContent>
                        </EnrollmentCard>
                    }
                </div>
                
                <!-- Pagination for Not Attending Members -->
                @if (filteredNotAttending.Count > 0)
                {
                    <div class="mt-3">
                        <TablePagination 
                            TotalItems="@filteredNotAttending.Count"
                            CurrentPage="@notAttendingPagination.CurrentPage"
                            PageSize="@notAttendingPagination.PageSize"
                            PageSizeOptions="@(new[] { 4, 8, 12, 16 })"
                            OnPageChanged="@HandleNotAttendingPageChange"
                            OnPageSizeChanged="@HandleNotAttendingPageSizeChange" />
                    </div>
                }
            }
        }
        else
        {
            <EmptyState Title="Nenhuma presença registada ainda"
                       Icon="bi-calendar-check" />
        }
        
        <AuthorizeView Roles="Admin">
            <Authorized>
                @if (isSelectedRehearsalApprovable)
                {
                    <div class="mt-3">
                        <!-- Success Alert (auto-dismiss) -->
                        @if (!string.IsNullOrEmpty(addMemberFeedbackMessage) && !addMemberFeedbackIsError)
                        {
                            <Alert Type="Alert.AlertType.Purple"
                                   Title="@addMemberFeedbackMessage"
                                   Dismissible="true"
                                   OnDismiss="ClearAddMemberFeedback"
                                   AdditionalClasses="mb-2" />
                        }

                        <!-- Error Alert (manual dismiss) -->
                        @if (!string.IsNullOrEmpty(addMemberFeedbackMessage) && addMemberFeedbackIsError)
                        {
                            <Alert Type="Alert.AlertType.Error"
                                   Title="@addMemberFeedbackMessage"
                                   Dismissible="true"
                                   OnDismiss="ClearAddMemberFeedback"
                                   AdditionalClasses="mb-2" />
                        }

                        @if (!showAddMemberSearch)
                        {
                            <button class="btn btn-sm btn-outline-primary" @onclick="ShowAddMemberSearch">
                                <i class="bi bi-plus-circle"></i>
                                Adicionar Membro
                            </button>
                        }
                        else
                        {
                            <div class="mb-2">
                                <SearchBar @bind-Value="addMemberSearchTerm"
                                           Placeholder="Pesquisar membro por nome..."
                                           OnSearch="@HandleAddMemberSearchChanged" />

                                @if (!string.IsNullOrWhiteSpace(addMemberSearchTerm) && filteredAvailableMembers.Any())
                                {
                                    <div class="member-list member-list-scrollable mt-2">
                                        @foreach (var member in filteredAvailableMembers)
                                        {
                                            <div class="member-item p-2 mb-2 border rounded clickable-row" @key="member.Id"
                                                 @onclick="() => AddMemberToRehearsal(member)"
                                                 tabindex="0"
                                                 @onkeydown="@(async (e) => await HandleMemberItemKeyDown(e, member))">
                                                <div class="d-flex align-items-center">
                                                    <img src="@member.ProfilePictureSrc" alt="@member.GetDisplayName()"
                                                         class="member-avatar-small me-2" />
                                                    <div>
                                                        <strong>@member.GetDisplayName()</strong>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else if (!string.IsNullOrWhiteSpace(addMemberSearchTerm))
                                {
                                    <p class="text-muted mt-2">Nenhum membro encontrado.</p>
                                }
                            </div>

                            <button class="btn btn-sm btn-outline-secondary" @onclick="HideAddMemberSearch">
                                <i class="bi bi-x-circle"></i>
                                Cancelar
                            </button>
                        }
                    </div>
                }
            </Authorized>
        </AuthorizeView>
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="CloseAttendancesModal">Voltar Atrás</button>
    </FooterContent>
</Modal>

<!-- Edit/Delete Modals -->
<Modal Show="@(modals.IsOpen(ModalType.Edit) && editingRehearsal != null)"
       ShowChanged="@((bool show) => { if (!show) CloseEditModal(); })"
       Title="Editar Ensaio"
       OnClose="CloseEditModal">
    <BodyContent>
        <div class="mb-3">
            <label class="form-label fw-semibold">
                <i class="bi bi-geo-alt text-primary me-2"></i>Localização
            </label>
            <input type="text" class="form-control" @bind="editLocation" />
        </div>
        <div class="mb-3">
            <label class="form-label fw-semibold">
                <i class="bi bi-music-note-list text-primary me-2"></i>Tema (opcional)
            </label>
            <input type="text" class="form-control" @bind="editTheme" />
        </div>
        <div class="mb-3">
            <label class="form-label fw-semibold">
                <i class="bi bi-card-text text-primary me-2"></i>Descrição (opcional)
            </label>
            <textarea class="form-control" rows="2" @bind="editDescription"></textarea>
        </div>
        <div class="mb-3">
            <label class="form-label fw-semibold">
                <i class="bi bi-file-text text-primary me-2"></i>Notas (opcional)
            </label>
            <textarea class="form-control" rows="3" @bind="editNotes"></textarea>
        </div>
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="CloseEditModal">Cancelar</button>
        <button type="button" class="btn btn-primary" @onclick="SaveEdit">Guardar</button>
    </FooterContent>
</Modal>

<!-- Delete Rehearsal Confirmation Modal -->
<ConfirmDialog Show="@modals.IsOpen(ModalType.Delete)"
               ShowChanged="@((bool show) => modals.Toggle(ModalType.Delete, show))"
               Title="Eliminar Ensaio"
               Message="@($"Tem a certeza que deseja eliminar o ensaio de {deletingRehearsal?.Date.ToString("dd MMM yyyy")}?")"
               WarningMessage="Esta ação não pode ser revertida."
               ConfirmText="Eliminar"
               CancelText="Cancelar"
               ConfirmButtonClass="btn-danger"
               OnConfirm="ConfirmDelete"
               OnCancel="CloseDeleteModal" />

<!-- Delete Attendance Confirmation Modal (Owner Only) -->
<ConfirmDialog Show="@modals.IsOpen(ModalType.DeleteAttendance)"
               ShowChanged="@((bool show) => modals.Toggle(ModalType.DeleteAttendance, show))"
               Title="Confirmar Eliminação de Presença"
               Message="@($"Tem a certeza que deseja eliminar a presença de {deletingAttendance?.User?.GetDisplayName() ?? deletingAttendance?.UserId} neste ensaio?")"
               WarningMessage="Esta ação não pode ser revertida."
               ConfirmText="Eliminar"
               CancelText="Cancelar"
               ConfirmButtonClass="btn-danger"
               OnConfirm="ConfirmDeleteAttendance"
               OnCancel="CloseDeleteAttendanceModal" />

<!-- Cancel My Attendance Confirmation Modal -->
<ConfirmDialog Show="@modals.IsOpen(ModalType.CancelMyAttendance)"
               ShowChanged="@((bool show) => modals.Toggle(ModalType.CancelMyAttendance, show))"
               Title="Cancelar Presença"
               Message="Tem a certeza que deseja cancelar a sua presença neste ensaio?"
               WarningMessage="Esta ação irá remover a sua inscrição."
               ConfirmText="Cancelar Presença"
               CancelText="Não Cancelar"
               ConfirmButtonClass="btn-danger"
               OnConfirm="ConfirmCancelMyAttendance"
               OnCancel="CloseCancelMyAttendanceModal" />

