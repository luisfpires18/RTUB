    private async Task MarkAttendance(Rehearsal rehearsal)
    {
        selectedRehearsal = rehearsal;
        
        // Load current user's instruments
        InstrumentType? defaultInstrument = null;
        if (currentUserId != null)
        {
            var memberInstruments = await MemberInstrumentService.GetMemberInstrumentsAsync(currentUserId);
            currentUserInstruments = memberInstruments.Select(mi => mi.InstrumentType).ToList();
            
            // Default to primary instrument
            var primaryInstrument = memberInstruments.FirstOrDefault(mi => mi.IsPrimary);
            defaultInstrument = primaryInstrument?.InstrumentType;
            
            // Only enable "Quero tocar" if instruments are available
            wantToPlayRehearsal = currentUserInstruments.Any();
        }
        else
        {
            wantToPlayRehearsal = false; // Disable if no instruments configured
        }
        
        attendanceForm = new AttendanceFormModel
        {
            WillAttend = true,
            Instrument = defaultInstrument,
            Notes = null
        };
        
        modals.Open(ModalType.Attendance);
        StateHasChanged();
    }

    /// <summary>
    /// Mark attendance with a pre-selected status (for toggle buttons)
    /// </summary>
    private async Task MarkAttendanceWithStatus(Rehearsal rehearsal, bool willAttend)
    {
        selectedRehearsal = rehearsal;
        
        // Check if user has existing attendance
        var existingAttendance = GetUserAttendance(rehearsal.Id);
        
        // Load current user's instruments
        InstrumentType? defaultInstrument = null;
        if (currentUserId != null)
        {
            var memberInstruments = await MemberInstrumentService.GetMemberInstrumentsAsync(currentUserId);
            currentUserInstruments = memberInstruments.Select(mi => mi.InstrumentType).ToList();
            
            // When not attending, always clear instrument selection
            if (!willAttend)
            {
                defaultInstrument = null;
                wantToPlayRehearsal = false;
            }
            else if (existingAttendance != null)
            {
                // Use existing instrument
                defaultInstrument = existingAttendance.Instrument;
                wantToPlayRehearsal = existingAttendance.Instrument.HasValue;
            }
            else
            {
                // Default to primary instrument
                var primaryInstrument = memberInstruments.FirstOrDefault(mi => mi.IsPrimary);
                defaultInstrument = primaryInstrument?.InstrumentType;
                // Only enable "Quero tocar" if attending and instruments are available
                wantToPlayRehearsal = currentUserInstruments.Any();
            }
        }
        else
        {
            wantToPlayRehearsal = false;
        }
        
        // Clear notes if changing participation status (different reasons)
        var shouldClearNotes = existingAttendance != null && existingAttendance.WillAttend != willAttend;
        
        attendanceForm = new AttendanceFormModel
        {
            WillAttend = willAttend,
            Instrument = defaultInstrument,
            Notes = shouldClearNotes ? string.Empty : existingAttendance?.Notes
        };
        
        // If updating existing attendance, we need to handle it as an update
        if (existingAttendance != null)
        {
            isEditingAttendance = true;
            editingAttendanceId = existingAttendance.Id;
        }
        else
        {
            isEditingAttendance = false;
            editingAttendanceId = null;
        }
        
        isParticipationPreSelected = true; // Hide "Vais participar?" section in modal
        modals.Open(ModalType.Attendance);
        StateHasChanged();
    }

    private async Task ConfirmMarkAttendance()
    {
        if (selectedRehearsal != null && currentUserId != null && attendanceForm != null)
        {
            try
            {
                string? otherInstrumentsText = null;
                InstrumentType? instrumentToSave = null;
                
                // Only save instrument info if wanting to play
                if (wantToPlayRehearsal)
                {
                    instrumentToSave = attendanceForm.Instrument;
                    
                    if (instrumentToSave.HasValue)
                    {
                        // Get all member instruments and calculate other instruments
                        var memberInstruments = await MemberInstrumentService.GetMemberInstrumentsAsync(currentUserId);
                        
                        // Get all instruments except the selected one
                        var otherInstruments = memberInstruments
                            .Where(mi => mi.InstrumentType != instrumentToSave.Value)
                            .Select(mi => StatusHelper.GetInstrumentDisplay(mi.InstrumentType))
                            .ToList();
                        
                        if (otherInstruments.Any())
                        {
                            otherInstrumentsText = string.Join(", ", otherInstruments);
                        }
                    }
                }

                await AttendanceService.MarkAttendanceAsync(
                    selectedRehearsal.Id, 
                    currentUserId, 
                    attendanceForm.WillAttend, 
                    instrumentToSave, 
                    attendanceForm.Notes, 
                    otherInstrumentsText
                );

                await LoadData();
                CloseAttendanceModal();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error marking attendance: {ex.Message}");
            }
        }
    }

