@inject RTUB.Application.Services.AuditContext AuditContext

<div class="page-header-centered mb-4">
    <div class="page-header-left"></div>
    <div class="page-header-center">
        <h1><i class="bi bi-shield-check"></i> Órgãos Sociais</h1>
        <p class="page-header-subtitle">Estrutura organizacional e órgãos sociais da RTUB por ano letivo.</p>
    </div>
    <div class="page-header-right d-none d-xl-flex">
        <AuthorizeView Roles="Mod,Admin">
            <Authorized>
                <button class="btn btn-success" @onclick="OpenCreateFiscalYearModal" title="Adicionar Ano Letivo">
                    <i class="bi bi-plus-lg"></i> <span class="btn-text">Adicionar Ano Letivo</span>
                </button>
            </Authorized>
        </AuthorizeView>
    </div>
</div>

@if (fiscalYears.Any())
{
    <div class="d-flex justify-content-end mb-4">
        <div class="filter-dropdown-container">
            <FilterDropdown SelectedValue="@selectedFiscalYear"
                            SelectedValueChanged="@(value => selectedFiscalYear = value)"
                            OnChange="@OnFiscalYearChanged"
                            AllItemsLabel="Selecionar Ano Letivo"
                            Items="@fiscalYears"
                            IconClass="bi-calendar-event" />
        </div>
    </div>
}

@if (!fiscalYears.Any())
{
    <EmptyState Title="Nenhum ano letivo ainda"
                Message="Não existem anos fiscais para mostrar."
                Icon="bi-calendar-x" />
}
