{
    @* RGI Section - Visible only to MEMBER and ADMIN *@
    <AuthorizeView Roles="Member,Mod,Admin">
        <section class="mb-4">
            <div class="rgi-section">
                <div class="rgi-section-icon">
                    <i class="bi bi-journal-bookmark-fill"></i>
                </div>
                <h5 class="rgi-section-title">Regulamentos Gerais Internos</h5>
                <p class="rgi-section-subtitle">Consulta os regulamentos e normas internas da RTUB</p>
                <button class="btn btn-outline-primary" @onclick="OpenRgiModal">
                    <i class="bi bi-file-earmark-pdf me-2"></i>Abrir RGI
                </button>
            </div>
        </section>
    </AuthorizeView>

