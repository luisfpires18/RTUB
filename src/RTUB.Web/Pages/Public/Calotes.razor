@page "/calotes"
@rendermode InteractiveServer
@using RTUB.Application.Interfaces
@using RTUB.Application.Helpers
@using RTUB.Application.Extensions
@using RTUB.Application.Services
@using RTUB.Core.Entities
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.EntityFrameworkCore
@using RTUB.Shared
@inject IMemberDebtService MemberDebtService
@inject IFiscalYearService FiscalYearService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject RTUB.Application.Services.AuditContext AuditContext

<main>
<div class="d-flex flex-column gap-3 mb-4">
    <div class="page-header-centered">
        <div class="page-header-left">
            <button class="btn btn-outline-light btn-sm" @onclick="GoBack">
                <i class="bi bi-arrow-left"></i>
            </button>
        </div>

        <div class="page-header-center">
            <h1 class="mb-1"><i class="bi bi-cash-coin"></i> Calotes</h1>
            <p class="lead page-header-subtitle mb-0 text-light-theme">
                Registo de dívidas de membros à Tuna.
            </p>
        </div>

        <div class="page-header-right">
            <AuthorizeView Roles="Mod,Admin">
                <Authorized>
                    <button class="btn btn-success" 
                            @onclick="OpenAddCaloteModal" 
                            title="Adicionar Calote">
                        <i class="bi bi-plus-lg"></i> Adicionar Calote
                    </button>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>

    <!-- Search Box and Fiscal Year Filter -->
    <div class="d-flex flex-column flex-lg-row align-items-lg-end gap-2 flex-wrap">
        <div class="flex-grow-1 filter-search-container">
            <SearchBar Placeholder="Pesquisar membros..."
                       @bind-Value="searchTerm"
                       OnSearch="FilterMembers" />
        </div>
        @if (fiscalYears.Any())
        {
            <div class="flex-lg-shrink-0 ms-lg-auto filter-dropdown-container">
                <FilterDropdown SelectedValue="@selectedFiscalYear"
                                SelectedValueChanged="@(value => selectedFiscalYear = value)"
                                OnChange="@OnFiscalYearChanged"
                                AllItemsLabel="Selecionar Ano Letivo"
                                Items="@fiscalYears"
                                IconClass="bi-calendar-event" />
            </div>
        }
    </div>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle"></i> @errorMessage
        <button type="button" class="btn-close" @onclick="@(() => errorMessage = "")"></button>
    </div>
}

@if (!fiscalYears.Any())
{
    <EmptyState Title="Nenhum ano letivo ainda"
                Message="Não existem anos fiscais para mostrar."
                Icon="bi-calendar-x" />
}
else if (isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">A carregar...</span>
        </div>
        <p class="mt-3">A carregar calotes...</p>
    </div>
}
else if (!filteredGroupedDebts.Any())
{
    @if (!string.IsNullOrEmpty(searchTerm))
    {
        <EmptyState Title="Nenhum resultado"
                    Message="Não foram encontrados membros com o termo de pesquisa."
                    Icon="bi-search" />
    }
    else
    {
        <EmptyState Title="Nenhum calote registado"
                    Message="Não existem dívidas registadas para este ano letivo."
                    Icon="bi-emoji-smile" />
    }
}
else
{
    <!-- Total Debt Summary -->
    <div class="mb-4">
        <div class="card summary-card">
            <div class="card-body py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-light-theme d-block mb-1">Total de Calotes</small>
                        <h4 class="text-danger mb-0">€@totalDebt.ToString("N2")</h4>
                    </div>
                    <div class="text-light-theme">
                        <i class="bi bi-cash-coin fs-1"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="avatar-card-grid">
        @foreach (var group in filteredGroupedDebts)
        {
            <div class="avatar-card">
                <!-- Avatar -->
                <div class="avatar-card-image-wrapper">
                    <img src="@group.User.ProfilePictureSrc" 
                         alt="@group.User.GetDisplayName()" 
                         class="avatar-card-image" />
                </div>

                <!-- Member Info -->
                <div class="avatar-card-content">
                    <!-- Nome de Tuna (primary) -->
                    @if (!string.IsNullOrEmpty(group.User.Nickname))
                    {
                        <div class="avatar-card-tuna-name">@group.User.Nickname</div>
                    }
                    
                    <!-- Nome (secondary) -->
                    <div class="avatar-card-full-name">@group.User.FirstName @group.User.LastName</div>

                    <!-- Debt amount (total of all debts) -->
                    <div class="calote-debt-badge">
                        <span class="calote-debt-value">€@group.TotalAmount.ToString("F2")</span>
                    </div>
                </div>
                
                <!-- View button below the card -->
                <div class="avatar-card-actions">
                    <button class="btn btn-sm btn-purple" 
                            @onclick="() => OpenDetailsModal(group)" 
                            @onclick:stopPropagation="true"
                            title="Ver Detalhes"
                            aria-label="Ver detalhes da dívida de @group.User.GetDisplayName()">
                        <i class="bi bi-eye"></i> Ver Detalhes
                    </button>
                </div>
            </div>
        }
    </div>
}

<!-- Add/Edit Calote Modal (Admin only) -->
<Modal Show="@showCaloteModal" 
       ShowChanged="@((bool show) => showCaloteModal = show)"
       Title="@(isEditMode ? "Editar Calote" : "Adicionar Calote")"
       Size="Modal.ModalSize.Large"
       Centered="true">
    <BodyContent>
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }
        
        @if (!isEditMode)
        {
            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <i class="bi bi-person text-primary me-2"></i>Selecionar Membro
                </label>
                <input type="text" 
                       class="form-control" 
                       placeholder="Pesquisar por nome, email ou alcunha..."
                       @bind="memberSearchTerm" 
                       @bind:event="oninput" 
                       @onkeyup="FilterMembersForModal" />
            </div>
            
            @if (filteredMembersForModal.Any())
            {
                <div class="member-list member-list-scrollable mb-3">
                    @foreach (var member in filteredMembersForModal.Take(20))
                    {
                        <div class="member-item p-2 mb-2 border rounded clickable-row @(selectedMember?.Id == member.Id ? "selected" : "")"
                             @onclick="() => SelectMember(member)">
                            <div class="d-flex align-items-center">
                                <img src="@member.ProfilePictureSrc" 
                                     alt="@member.GetDisplayName()"
                                     class="member-avatar-small me-2" />
                                <div>
                                    @if (!string.IsNullOrEmpty(member.Nickname))
                                    {
                                        <div><strong>@member.Nickname</strong></div>
                                        <div class="text-muted small">@member.FirstName @member.LastName</div>
                                    }
                                    else
                                    {
                                        <div><strong>@member.FirstName @member.LastName</strong></div>
                                    }
                                    <div class="text-muted small">@member.Email</div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else if (!string.IsNullOrEmpty(memberSearchTerm))
            {
                <Alert Type="Alert.AlertType.Purple" Message="Nenhum membro encontrado." />
            }

            @if (selectedMember != null)
            {
                <Alert Type="Alert.AlertType.Purple" 
                       Message="@($"Membro Selecionado: {selectedMember.GetDisplayName()}")" 
                       AdditionalClasses="mt-3" />
            }
        }
        else
        {
            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <i class="bi bi-person text-primary me-2"></i>Membro
                </label>
                <div class="d-flex align-items-center p-2 border rounded">
                    <img src="@selectedMember!.ProfilePictureSrc" 
                         alt="@selectedMember.GetDisplayName()"
                         class="member-avatar-small me-2" />
                    <div>
                        <strong>@selectedMember.GetDisplayName()</strong>
                    </div>
                </div>
            </div>
        }
        
        <div class="mb-3">
            <label class="form-label fw-semibold">
                <i class="bi bi-cash text-primary me-2"></i>Montante (€)
            </label>
            <input type="number" 
                   class="form-control" 
                   step="0.01"
                   min="0.01"
                   placeholder="0.00"
                   @bind="editAmount" />
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">
                <i class="bi bi-file-text text-primary me-2"></i>Descrição (opcional)
            </label>
            <input type="text" 
                   class="form-control" 
                   placeholder="Descrição do calote..."
                   @bind="editDescription" />
        </div>
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="CloseCaloteModal">Cancelar</button>
        <button type="button" 
                class="btn btn-primary" 
                @onclick="SaveCalote"
                disabled="@(selectedMember == null || editAmount <= 0 || isSavingDebt)">
            @if (isSavingDebt)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
            }
            @(isEditMode ? "Guardar Alterações" : "Adicionar")
        </button>
    </FooterContent>
</Modal>

<!-- Delete Confirmation Modal (Admin only) -->
<ConfirmDialog Show="@showDeleteConfirmation"
               ShowChanged="@((bool show) => showDeleteConfirmation = show)"
               Title="Confirmar Remoção"
               Message="@($"Tem a certeza que deseja remover o calote de {deletingDebt?.User?.GetDisplayName() ?? "este membro"}?")"
               WarningMessage="Esta ação irá remover o registo de dívida."
               ConfirmText="Remover"
               CancelText="Cancelar"
               ConfirmButtonClass="btn-danger"
               OnConfirm="ConfirmDeleteCalote"
               OnCancel="CloseDeleteConfirmation" />

<!-- Details Modal - Shows all debts for a user -->
@if (viewingDebtGroup != null)
{
    <DetailsModal Show="@showDetailsModal" 
                  ShowChanged="@((bool show) => showDetailsModal = show)"
                  Title="Dívidas"
                  HeaderTitle="@viewingDebtGroup.User.GetDisplayName()"
                  ImageUrl="@viewingDebtGroup.User.ProfilePictureSrc"
                  Size="Modal.ModalSize.Large"
                  OnClose="CloseDetailsModal">
        <Sections>
            <InfoSection SectionTitle="Total em Dívida" IconClass="bi-cash-coin">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="fw-bold">Montante Total:</span>
                    <span class="badge bg-danger fs-6">€@viewingDebtGroup.TotalAmount.ToString("F2")</span>
                </div>
            </InfoSection>
            
            <InfoSection SectionTitle="@($"Lista de Dívidas ({viewingDebtGroup.Debts.Count})")" IconClass="bi-list-ul">
                @foreach (var debt in viewingDebtGroup.Debts.OrderByDescending(d => d.AmountOwed))
                {
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                        <div class="flex-grow-1">
                            <div class="d-flex align-items-center">
                                <span class="badge bg-danger me-2">€@debt.AmountOwed.ToString("F2")</span>
                                @if (!string.IsNullOrEmpty(debt.Description))
                                {
                                    <span>@debt.Description</span>
                                }
                                else
                                {
                                    <span class="text-light-theme fst-italic">Sem descrição</span>
                                }
                            </div>
                        </div>
                        <AuthorizeView Roles="Mod,Admin">
                            <Authorized>
                                <div class="d-flex gap-1 ms-2">
                                    <button class="btn btn-sm admin-btn-edit" 
                                            @onclick="async () => await OpenEditCaloteFromDetails(debt)" 
                                            title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-sm admin-btn-delete" 
                                            @onclick="() => OpenDeleteConfirmation(debt)" 
                                            title="Remover">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </Authorized>
                        </AuthorizeView>
                    </div>
                }
            </InfoSection>
        </Sections>
    </DetailsModal>
}
</main>

@code {
    // URL query parameters
    [SupplyParameterFromQuery(Name = "reportId")]
    public int? ReportId { get; set; }
    
    private List<string> fiscalYears = new();
    private string selectedFiscalYear = "";
    private bool isLoading = true;
    
    private List<MemberDebt> memberDebts = new();
    private List<MemberDebtGroup> groupedDebts = new();
    private List<MemberDebtGroup> filteredGroupedDebts = new();
    private string searchTerm = "";
    
    // Total debt of all users
    private decimal totalDebt => memberDebts.Sum(d => d.AmountOwed);
    
    // Modal state
    private bool showCaloteModal = false;
    private bool showDeleteConfirmation = false;
    private bool isEditMode = false;
    private string errorMessage = "";
    
    // Details Modal state
    private bool showDetailsModal = false;
    private MemberDebtGroup? viewingDebtGroup;
    
    // Edit/Create state
    private bool isSavingDebt = false;
    private ApplicationUser? selectedMember;
    private decimal editAmount = 0;
    private string editDescription = "";
    private MemberDebt? editingDebt;
    private MemberDebt? deletingDebt;
    
    // Member selection
    private List<ApplicationUser> allMembers = new();
    private List<ApplicationUser> filteredMembersForModal = new();
    private string memberSearchTerm = "";
    
    // Helper for multi-word search
    private SearchHelper<ApplicationUser> searchHelper = new();
    private SearchHelper<MemberDebtGroup> groupSearchHelper = new();
    
    // Helper class to group debts by user
    private class MemberDebtGroup
    {
        public ApplicationUser User { get; set; } = null!;
        public List<MemberDebt> Debts { get; set; } = new();
        public decimal TotalAmount => Debts.Sum(d => d.AmountOwed);
    }

    protected override async Task OnInitializedAsync()
    {
        // Load fiscal years
        await LoadFiscalYears();
        
        // Load all members for admin
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var isAdmin = authState.User.IsInRole("Admin");
        var isMod = authState.User.IsInRole("Mod");
        
        if (isAdmin || isMod)
        {
            await LoadAllMembers();
        }
        
        // Handle URL query parameter ?fy=
        var uri = new Uri(NavigationManager.Uri);
        var queryParams = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var fyParam = queryParams["fy"];
        
        var currentFiscalYearString = FiscalYearHelper.GetCurrentFiscalYearString();
        
        if (!string.IsNullOrEmpty(fyParam) && fiscalYears.Contains(fyParam))
        {
            selectedFiscalYear = fyParam;
        }
        else if (fiscalYears.Contains(currentFiscalYearString))
        {
            selectedFiscalYear = currentFiscalYearString;
        }
        else if (fiscalYears.Any())
        {
            selectedFiscalYear = fiscalYears.First();
        }
        
        await LoadCalotes();
    }
    
    private async Task LoadFiscalYears()
    {
        var years = (await FiscalYearService.GetAllFiscalYearsAsync())
            .OrderByDescending(y => y.StartYear)
            .ToList();

        fiscalYears = years.Select(y => y.FiscalYearString).ToList();
    }
    
    private async Task LoadAllMembers()
    {
        // Load all users and filter in memory (Categories is JSON column, can't filter on server)
        allMembers = (await UserManager.Users
            .OrderBy(u => u.FirstName)
            .ThenBy(u => u.LastName)
            .AsNoTracking()
            .ToListAsync())
            .Where(u => !u.IsLeitao())  // Filter in memory after load
            .ToList();
    }
    
    private async Task LoadCalotes()
    {
        if (string.IsNullOrEmpty(selectedFiscalYear))
        {
            memberDebts.Clear();
            groupedDebts.Clear();
            filteredGroupedDebts.Clear();
            isLoading = false;
            return;
        }
        
        isLoading = true;
        StateHasChanged();
        
        var parts = selectedFiscalYear.Split('-');
        if (parts.Length != 2 || !int.TryParse(parts[0], out var startYear))
        {
            memberDebts.Clear();
            groupedDebts.Clear();
            filteredGroupedDebts.Clear();
            isLoading = false;
            return;
        }
        
        // Get fiscal year by start year
        var fiscalYear = await FiscalYearService.GetFiscalYearByStartYearAsync(startYear);
        
        if (fiscalYear == null)
        {
            memberDebts.Clear();
            groupedDebts.Clear();
            filteredGroupedDebts.Clear();
            isLoading = false;
            return;
        }
        
        // Get all member debts for this fiscal year
        var debts = await MemberDebtService.GetDebtsForFiscalYearAsync(fiscalYear.Id);
        
        // Store all debts for total calculation
        memberDebts = debts.ToList();
        
        // Group debts by user
        groupedDebts = debts
            .GroupBy(d => d.UserId)
            .Select(g => new MemberDebtGroup
            {
                User = g.First().User,
                Debts = g.OrderByDescending(d => d.AmountOwed).ToList()
            })
            .OrderByDescending(g => g.TotalAmount)
            .ToList();
        
        filteredGroupedDebts = groupedDebts;
        isLoading = false;
    }
    
    private async Task OnFiscalYearChanged()
    {
        // Update URL with query parameter, preserve reportId if present
        var reportIdParam = ReportId.HasValue ? $"&reportId={ReportId}" : "";
        NavigationManager.NavigateTo($"/calotes?fy={selectedFiscalYear}{reportIdParam}", forceLoad: false);
        searchTerm = "";
        await LoadCalotes();
    }
    
    private void GoBack()
    {
        // Navigate back to the report page if we came from there, otherwise go to finance
        if (ReportId.HasValue)
        {
            NavigationManager.NavigateTo($"/finance/report/{ReportId}");
        }
        else
        {
            NavigationManager.NavigateTo("/finance");
        }
    }
    
    private void FilterMembers()
    {
        if (string.IsNullOrEmpty(searchTerm))
        {
            filteredGroupedDebts = groupedDebts;
            return;
        }
        
        // Use SearchHelper for multi-word search support on grouped data
        groupSearchHelper.SearchTerm = searchTerm;
        filteredGroupedDebts = groupSearchHelper.FilterMultiple(groupedDebts, new List<Func<MemberDebtGroup, string>>
        {
            g => g.User.FirstName ?? "",
            g => g.User.LastName ?? "",
            g => g.User.Nickname ?? "",
            g => g.User.Email ?? ""
        });
    }
    
    private void OpenAddCaloteModal()
    {
        isEditMode = false;
        selectedMember = null;
        editAmount = 0;
        editDescription = "";
        memberSearchTerm = "";
        filteredMembersForModal.Clear();
        errorMessage = "";
        editingDebt = null;
        showCaloteModal = true;
    }
    
    private void OpenAddCaloteForUser(ApplicationUser user)
    {
        // Close details modal and open add modal for specific user
        showDetailsModal = false;
        isEditMode = false;
        selectedMember = user;
        editAmount = 0;
        editDescription = "";
        memberSearchTerm = "";
        filteredMembersForModal.Clear();
        errorMessage = "";
        editingDebt = null;
        showCaloteModal = true;
    }
    
    private async Task OpenEditCaloteFromDetails(MemberDebt debt)
    {
        // Close details modal and open edit modal
        showDetailsModal = false;
        await OpenEditCaloteModal(debt);
    }
    
    private async Task OpenEditCaloteModal(MemberDebt debt)
    {
        isEditMode = true;
        selectedMember = debt.User;
        editAmount = debt.AmountOwed;
        editDescription = debt.Description ?? "";
        memberSearchTerm = "";
        filteredMembersForModal.Clear();
        errorMessage = "";
        editingDebt = debt;
        
        showCaloteModal = true;
    }
    
    private void CloseCaloteModal()
    {
        showCaloteModal = false;
        isEditMode = false;
        selectedMember = null;
        editAmount = 0;
        editDescription = "";
        memberSearchTerm = "";
        filteredMembersForModal.Clear();
        errorMessage = "";
        editingDebt = null;
        isSavingDebt = false;
    }
    
    private void FilterMembersForModal()
    {
        if (string.IsNullOrEmpty(memberSearchTerm))
        {
            filteredMembersForModal.Clear();
            return;
        }

        // Use SearchHelper for multi-word search support
        searchHelper.SearchTerm = memberSearchTerm;
        filteredMembersForModal = searchHelper.FilterMultiple(allMembers, new List<Func<ApplicationUser, string>>
        {
            u => u.FirstName ?? "",
            u => u.LastName ?? "",
            u => u.Nickname ?? "",
            u => u.Email ?? ""
        });
    }
    
    private void SelectMember(ApplicationUser member)
    {
        selectedMember = member;
    }
    
    private async Task SaveCalote()
    {
        if (selectedMember == null || editAmount <= 0)
        {
            if (selectedMember == null)
                errorMessage = "Por favor, selecione um membro.";
            else if (editAmount <= 0)
                errorMessage = "O montante deve ser maior que zero.";
            
            return;
        }

        errorMessage = "";
        isSavingDebt = true;
        StateHasChanged();

        try
        {
            // Get fiscal year
            var parts = selectedFiscalYear.Split('-');
            if (parts.Length != 2 || !int.TryParse(parts[0], out var startYear))
            {
                errorMessage = "Ano fiscal inválido.";
                return;
            }
            
            var fiscalYear = await FiscalYearService.GetFiscalYearByStartYearAsync(startYear);
            if (fiscalYear == null)
            {
                errorMessage = "Ano fiscal não encontrado.";
                return;
            }
            
            if (isEditMode && editingDebt != null)
            {
                // Update existing debt
                await MemberDebtService.UpdateDebtAsync(
                    editingDebt.Id,
                    editAmount,
                    string.IsNullOrWhiteSpace(editDescription) ? null : editDescription
                );
            }
            else
            {
                // Create new debt - multiple debts per user are now allowed
                await MemberDebtService.AddDebtAsync(
                    selectedMember.Id,
                    editAmount,
                    string.IsNullOrWhiteSpace(editDescription) ? null : editDescription,
                    fiscalYear.Id
                );
            }

            await LoadCalotes();
            CloseCaloteModal();
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro ao guardar: {ex.Message}";
        }
        finally
        {
            isSavingDebt = false;
            StateHasChanged();
        }
    }
    
    private void OpenDeleteConfirmation(MemberDebt debt)
    {
        deletingDebt = debt;
        showDeleteConfirmation = true;
    }
    
    private void CloseDeleteConfirmation()
    {
        showDeleteConfirmation = false;
        deletingDebt = null;
    }
    
    private async Task ConfirmDeleteCalote()
    {
        if (deletingDebt == null) return;
        
        try
        {
            // Delete the debt
            await MemberDebtService.DeleteDebtAsync(deletingDebt.Id);
            
            await LoadCalotes();
            CloseDeleteConfirmation();
            
            // If we were viewing details and deleted the last debt, close the details modal
            if (viewingDebtGroup != null)
            {
                // Update the viewing group after deletion
                var updatedGroup = groupedDebts.FirstOrDefault(g => g.User.Id == viewingDebtGroup.User.Id);
                if (updatedGroup == null || !updatedGroup.Debts.Any())
                {
                    CloseDetailsModal();
                }
                else
                {
                    viewingDebtGroup = updatedGroup;
                }
            }
        }
        catch (Exception ex)
        {
            // Show error message to user
            errorMessage = $"Erro ao remover calote: {ex.Message}";
            showDeleteConfirmation = false;
            deletingDebt = null;
        }
    }
    
    private void OpenDetailsModal(MemberDebtGroup group)
    {
        viewingDebtGroup = group;
        showDetailsModal = true;
    }

    private void CloseDetailsModal()
    {
        showDetailsModal = false;
        viewingDebtGroup = null;
    }
}
