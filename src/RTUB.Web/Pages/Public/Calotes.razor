@page "/calotes"
@rendermode InteractiveServer
@using RTUB.Application.Interfaces
@using RTUB.Application.Helpers
@using RTUB.Application.Extensions
@using RTUB.Application.Services
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.EntityFrameworkCore
@using RTUB.Shared
@inject IReportService ReportService
@inject IActivityService ActivityService
@inject ITransactionService TransactionService
@inject IFiscalYearService FiscalYearService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject RTUB.Application.Services.AuditContext AuditContext

<main>
<div class="d-flex flex-column gap-3 mb-4">
    <div class="page-header-centered">
        <div class="page-header-left">
            <button class="btn btn-outline-light btn-sm" @onclick="GoBack">
                <i class="bi bi-arrow-left"></i>
            </button>
        </div>

        <div class="page-header-center">
            <h1 class="mb-1"><i class="bi bi-cash-coin"></i> Calotes</h1>
            <p class="lead page-header-subtitle mb-0 text-light-theme">
                Registo de dívidas de membros à Tuna.
            </p>
        </div>

        <div class="page-header-right">
            <AuthorizeView Roles="Mod,Admin">
                <Authorized>
                    <button class="btn btn-success" 
                            @onclick="OpenAddCaloteModal" 
                            title="Adicionar Calote"
                            disabled="@(!canAddCalote)">
                        <i class="bi bi-plus-lg"></i> Adicionar Calote
                    </button>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>

    <!-- Search Box and Fiscal Year Filter -->
    <div class="d-flex flex-column flex-lg-row align-items-lg-end gap-2 flex-wrap">
        <div class="flex-grow-1 filter-search-container">
            <SearchBar Placeholder="Pesquisar membros..."
                       @bind-Value="searchTerm"
                       OnSearch="FilterMembers" />
        </div>
        @if (fiscalYears.Any())
        {
            <div class="flex-lg-shrink-0 ms-lg-auto filter-dropdown-container">
                <FilterDropdown SelectedValue="@selectedFiscalYear"
                                SelectedValueChanged="@(value => selectedFiscalYear = value)"
                                OnChange="@OnFiscalYearChanged"
                                AllItemsLabel="Selecionar Ano Letivo"
                                Items="@fiscalYears"
                                IconClass="bi-calendar-event" />
            </div>
        }
    </div>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle"></i> @errorMessage
        <button type="button" class="btn-close" @onclick="@(() => errorMessage = "")"></button>
    </div>
}

@if (!fiscalYears.Any())
{
    <EmptyState Title="Nenhum ano letivo ainda"
                Message="Não existem anos fiscais para mostrar."
                Icon="bi-calendar-x" />
}
else if (isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">A carregar...</span>
        </div>
        <p class="mt-3">A carregar calotes...</p>
    </div>
}
else if (!canAddCalote)
{
    <Alert Type="Alert.AlertType.Purple" 
           Message="Não existe atividade 'CALOTES' para o ano letivo selecionado. Por favor, crie a atividade primeiro." 
           Icon="bi-exclamation-triangle" />
}
else if (!filteredMemberDebts.Any())
{
    @if (!string.IsNullOrEmpty(searchTerm))
    {
        <EmptyState Title="Nenhum resultado"
                    Message="Não foram encontrados membros com o termo de pesquisa."
                    Icon="bi-search" />
    }
    else
    {
        <EmptyState Title="Nenhum calote registado"
                    Message="Não existem dívidas registadas para este ano letivo."
                    Icon="bi-emoji-smile" />
    }
}
else
{
    <div class="avatar-card-grid">
        @foreach (var debt in filteredMemberDebts)
        {
            <div class="avatar-card">
                <!-- Edit & Delete buttons in top-right -->
                <AuthorizeView Roles="Mod,Admin">
                    <Authorized>
                        <button class="avatar-card-edit-btn" 
                                @onclick="async () => await OpenEditCaloteModal(debt)" 
                                @onclick:stopPropagation="true"
                                title="Editar">
                            <i class="bi bi-pencil"></i>
                        </button>
                        <button class="avatar-card-delete-btn" 
                                @onclick="() => OpenDeleteConfirmation(debt)" 
                                @onclick:stopPropagation="true"
                                title="Remover">
                            <i class="bi bi-trash"></i>
                        </button>
                    </Authorized>
                </AuthorizeView>

                <!-- Avatar -->
                <div class="avatar-card-image-wrapper">
                    <img src="@debt.Member.ProfilePictureSrc" 
                         alt="@debt.Member.GetDisplayName()" 
                         class="avatar-card-image" />
                </div>

                <!-- Member Info -->
                <div class="avatar-card-content">
                    <!-- Nome de Tuna (primary) -->
                    @if (!string.IsNullOrEmpty(debt.Member.Nickname))
                    {
                        <div class="avatar-card-tuna-name">@debt.Member.Nickname</div>
                    }
                    
                    <!-- Nome (secondary) -->
                    <div class="avatar-card-full-name">@debt.Member.FirstName @debt.Member.LastName</div>

                    <!-- Debt amount -->
                    <div class="calote-debt-badge">
                        <span class="calote-debt-value">€@debt.AmountOwed.ToString("F2")</span>
                    </div>
                </div>
                
                <!-- View button below the card -->
                <div class="avatar-card-actions">
                    <button class="btn btn-sm btn-purple" 
                            @onclick="() => OpenDetailsModal(debt)" 
                            @onclick:stopPropagation="true"
                            title="Ver Detalhes"
                            aria-label="Ver detalhes da dívida de @debt.Member.GetDisplayName()">
                        <i class="bi bi-eye"></i> Ver Detalhes
                    </button>
                </div>
            </div>
        }
    </div>
}

<!-- Add/Edit Calote Modal (Admin only) -->
<Modal Show="@showCaloteModal" 
       ShowChanged="@((bool show) => showCaloteModal = show)"
       Title="@(isEditMode ? "Editar Calote" : "Adicionar Calote")"
       Size="Modal.ModalSize.Large"
       Centered="true">
    <BodyContent>
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }
        
        @if (!isEditMode)
        {
            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <i class="bi bi-person text-primary me-2"></i>Selecionar Membro
                </label>
                <input type="text" 
                       class="form-control" 
                       placeholder="Pesquisar por nome, email ou alcunha..."
                       @bind="memberSearchTerm" 
                       @bind:event="oninput" 
                       @onkeyup="FilterMembersForModal" />
            </div>
            
            @if (filteredMembersForModal.Any())
            {
                <div class="member-list member-list-scrollable mb-3">
                    @foreach (var member in filteredMembersForModal.Take(20))
                    {
                        <div class="member-item p-2 mb-2 border rounded clickable-row @(selectedMember?.Id == member.Id ? "selected" : "")"
                             @onclick="() => SelectMember(member)">
                            <div class="d-flex align-items-center">
                                <img src="@member.ProfilePictureSrc" 
                                     alt="@member.GetDisplayName()"
                                     class="member-avatar-small me-2" />
                                <div>
                                    @if (!string.IsNullOrEmpty(member.Nickname))
                                    {
                                        <div><strong>@member.Nickname</strong></div>
                                        <div class="text-muted small">@member.FirstName @member.LastName</div>
                                    }
                                    else
                                    {
                                        <div><strong>@member.FirstName @member.LastName</strong></div>
                                    }
                                    <div class="text-muted small">@member.Email</div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else if (!string.IsNullOrEmpty(memberSearchTerm))
            {
                <Alert Type="Alert.AlertType.Purple" Message="Nenhum membro encontrado." />
            }

            @if (selectedMember != null)
            {
                <Alert Type="Alert.AlertType.Purple" 
                       Message="@($"Membro Selecionado: {selectedMember.GetDisplayName()}")" 
                       AdditionalClasses="mt-3" />
            }
            
            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <i class="bi bi-cash text-primary me-2"></i>Montante (€)
                </label>
                <input type="number" 
                       class="form-control" 
                       step="0.01"
                       min="0"
                       placeholder="0.00"
                       @bind="editAmount" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <i class="bi bi-file-text text-primary me-2"></i>Descrição
                </label>
                <input type="text" 
                       class="form-control" 
                       placeholder="Descrição do calote..."
                       @bind="editDescription" />
            </div>
        }
        else
        {
            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <i class="bi bi-person text-primary me-2"></i>Membro
                </label>
                <div class="d-flex align-items-center p-2 border rounded">
                    <img src="@selectedMember!.ProfilePictureSrc" 
                         alt="@selectedMember.GetDisplayName()"
                         class="member-avatar-small me-2" />
                    <div>
                        <strong>@selectedMember.GetDisplayName()</strong>
                    </div>
                </div>
            </div>
            
            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <i class="bi bi-list-ul text-primary me-2"></i>Transações
                </label>
                @if (editableTransactions.Any(t => !t.IsDeleted))
                {
                    <div class="d-flex flex-column gap-2">
                        @foreach (var transaction in editableTransactions.Where(t => !t.IsDeleted))
                        {
                            <div class="d-flex gap-2 align-items-center p-2 border rounded">
                                <div class="flex-grow-1">
                                    <input type="text" 
                                           class="form-control form-control-sm mb-1" 
                                           placeholder="Descrição..."
                                           value="@transaction.Description"
                                           @onchange="@(e => { transaction.Description = e.Value?.ToString() ?? ""; transaction.IsModified = true; })" />
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text">€</span>
                                        <input type="number" 
                                               class="form-control" 
                                               step="0.01"
                                               min="0.01"
                                               value="@transaction.Amount"
                                               @onchange="@(e => { if (decimal.TryParse(e.Value?.ToString(), out var val) && val > 0) { transaction.Amount = val; transaction.IsModified = true; } })" />
                                    </div>
                                </div>
                                <button type="button" 
                                        class="btn btn-outline-danger btn-sm"
                                        @onclick="() => { transaction.IsDeleted = true; }"
                                        title="Remover transação">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        }
                    </div>
                    
                    <div class="mt-3 p-2 rounded d-flex justify-content-between align-items-center" style="background: rgba(var(--bs-primary-rgb), 0.1); border: 1px solid rgba(var(--bs-primary-rgb), 0.2);">
                        <span class="fw-bold">Total:</span>
                        <span class="badge bg-danger fs-6">€@editableTransactions.Where(t => !t.IsDeleted).Sum(t => t.Amount).ToString("F2")</span>
                    </div>
                }
                else
                {
                    <p class="text-muted">Nenhuma transação encontrada.</p>
                }
            </div>
        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="CloseCaloteModal">Cancelar</button>
        @if (isEditMode)
        {
            <button type="button" 
                    class="btn btn-primary" 
                    @onclick="SaveEditedTransactions"
                    disabled="@(isSavingTransactions || !editableTransactions.Any(t => !t.IsDeleted))">
                @if (isSavingTransactions)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                }
                Guardar Alterações
            </button>
        }
        else
        {
            <button type="button" 
                    class="btn btn-primary" 
                    @onclick="SaveCalote"
                    disabled="@(selectedMember == null || editAmount <= 0 || string.IsNullOrWhiteSpace(editDescription))">
                Adicionar
            </button>
        }
    </FooterContent>
</Modal>

<!-- Delete Confirmation Modal (Admin only) -->
<ConfirmDialog Show="@showDeleteConfirmation"
               ShowChanged="@((bool show) => showDeleteConfirmation = show)"
               Title="Confirmar Remoção"
               Message="@($"Tem a certeza que deseja remover o calote de {deletingDebt?.Member?.GetDisplayName() ?? "este membro"}?")"
               WarningMessage="Esta ação irá remover todas as transações associadas a este membro na atividade CALOTES."
               ConfirmText="Remover"
               CancelText="Cancelar"
               ConfirmButtonClass="btn-danger"
               OnConfirm="ConfirmDeleteCalote"
               OnCancel="CloseDeleteConfirmation" />

<!-- Details Modal -->
@if (viewingDebt != null)
{
    <DetailsModal Show="@showDetailsModal" 
                  ShowChanged="@((bool show) => showDetailsModal = show)"
                  Title="Detalhes de Dívida"
                  HeaderTitle="@viewingDebt.Member.GetDisplayName()"
                  ImageUrl="@viewingDebt.Member.ProfilePictureSrc"
                  Size="Modal.ModalSize.Default"
                  OnClose="CloseDetailsModal">
        <Sections>
            <InfoSection SectionTitle="Transações" IconClass="bi-list-ul">
                @if (viewingMemberTransactions.Any())
                {
                    <div class="d-flex flex-column gap-2">
                        @foreach (var transaction in viewingMemberTransactions.OrderByDescending(t => t.Date))
                        {
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-muted">@transaction.Description</span>
                                <span class="badge bg-danger">€@transaction.Amount.ToString("F2")</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">Nenhuma transação encontrada.</p>
                }
            </InfoSection>
            <InfoSection SectionTitle="Total em Dívida" IconClass="bi-cash-coin">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="fw-bold">Montante Total:</span>
                    <span class="badge bg-danger fs-6">€@viewingDebt.AmountOwed.ToString("F2")</span>
                </div>
            </InfoSection>
        </Sections>
    </DetailsModal>
}
</main>

@code {
    // Constants for CALOTES activity and transaction category
    private const string CalotesActivityName = "CALOTES";
    private const string CaloteCategory = "CALOTE";
    
    // URL query parameters
    [SupplyParameterFromQuery(Name = "reportId")]
    public int? ReportId { get; set; }
    
    private List<string> fiscalYears = new();
    private string selectedFiscalYear = "";
    private bool isLoading = true;
    private bool canAddCalote = false;
    private Activity? calotesActivity;
    
    private List<MemberDebt> memberDebts = new();
    private List<MemberDebt> filteredMemberDebts = new();
    private string searchTerm = "";
    
    // Modal state
    private bool showCaloteModal = false;
    private bool showDeleteConfirmation = false;
    private bool isEditMode = false;
    private string errorMessage = "";
    
    // Details Modal state
    private bool showDetailsModal = false;
    private MemberDebt? viewingDebt;
    private List<Transaction> viewingMemberTransactions = new();
    
    // Edit transactions state
    private List<EditableTransaction> editableTransactions = new();
    private bool isSavingTransactions = false;

    // Helper class for editable transactions
    private class EditableTransaction
    {
        public int Id { get; set; }
        public decimal Amount { get; set; }
        public string Description { get; set; } = "";
        public DateTime Date { get; set; }
        public bool IsDeleted { get; set; } = false;
        public bool IsModified { get; set; } = false;
    }
    
    // Edit/Create state
    private ApplicationUser? selectedMember;
    private decimal editAmount = 0;
    private string editDescription = "";
    private MemberDebt? editingDebt;
    private MemberDebt? deletingDebt;
    
    // Member selection
    private List<ApplicationUser> allMembers = new();
    private List<ApplicationUser> filteredMembersForModal = new();
    private string memberSearchTerm = "";
    
    // Helper for multi-word search
    private SearchHelper<ApplicationUser> searchHelper = new();
    private SearchHelper<MemberDebt> debtSearchHelper = new();

    protected override async Task OnInitializedAsync()
    {
        // Load fiscal years
        await LoadFiscalYears();
        
        // Load all members for admin
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var isAdmin = authState.User.IsInRole("Admin");
        var isMod = authState.User.IsInRole("Mod");
        
        if (isAdmin || isMod)
        {
            await LoadAllMembers();
        }
        
        // Handle URL query parameter ?fy=
        var uri = new Uri(NavigationManager.Uri);
        var queryParams = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var fyParam = queryParams["fy"];
        
        var currentFiscalYearString = FiscalYearHelper.GetCurrentFiscalYearString();
        
        if (!string.IsNullOrEmpty(fyParam) && fiscalYears.Contains(fyParam))
        {
            selectedFiscalYear = fyParam;
        }
        else if (fiscalYears.Contains(currentFiscalYearString))
        {
            selectedFiscalYear = currentFiscalYearString;
        }
        else if (fiscalYears.Any())
        {
            selectedFiscalYear = fiscalYears.First();
        }
        
        await LoadCalotes();
    }
    
    private async Task LoadFiscalYears()
    {
        var years = (await FiscalYearService.GetAllFiscalYearsAsync())
            .OrderByDescending(y => y.StartYear)
            .ToList();

        fiscalYears = years.Select(y => y.FiscalYearString).ToList();
    }
    
    private async Task LoadAllMembers()
    {
        // Load all users and filter in memory (Categories is JSON column, can't filter on server)
        allMembers = (await UserManager.Users
            .OrderBy(u => u.FirstName)
            .ThenBy(u => u.LastName)
            .AsNoTracking()
            .ToListAsync())
            .Where(u => !u.IsLeitao())  // Filter in memory after load
            .ToList();
    }
    
    private async Task LoadCalotes()
    {
        if (string.IsNullOrEmpty(selectedFiscalYear))
        {
            memberDebts.Clear();
            filteredMemberDebts.Clear();
            isLoading = false;
            canAddCalote = false;
            return;
        }
        
        isLoading = true;
        canAddCalote = false;
        calotesActivity = null;
        StateHasChanged();
        
        var parts = selectedFiscalYear.Split('-');
        if (parts.Length != 2 || !int.TryParse(parts[0], out var startYear))
        {
            memberDebts.Clear();
            filteredMemberDebts.Clear();
            isLoading = false;
            return;
        }
        
        // Get report for the selected fiscal year
        var reports = await ReportService.GetAllReportsAsync();
        var report = reports.FirstOrDefault(r => r.Year == startYear);
        
        if (report == null)
        {
            memberDebts.Clear();
            filteredMemberDebts.Clear();
            isLoading = false;
            return;
        }
        
        // Get CALOTES activity
        var activities = await ActivityService.GetActivitiesByReportIdAsync(report.Id);
        calotesActivity = activities.FirstOrDefault(a => a.Name.Equals(CalotesActivityName, StringComparison.OrdinalIgnoreCase));
        
        if (calotesActivity == null)
        {
            memberDebts.Clear();
            filteredMemberDebts.Clear();
            isLoading = false;
            return;
        }
        
        canAddCalote = true;
        
        // Get all transactions for this activity
        var transactions = (await TransactionService.GetTransactionsByActivityIdAsync(calotesActivity.Id))
            .Where(t => !string.IsNullOrEmpty(t.UserId))
            .ToList();
        
        // Group by user and calculate balance
        var userBalances = transactions
            .GroupBy(t => t.UserId)
            .Select(g => new
            {
                UserId = g.Key!,
                // Expense = member owes money to Tuna (positive balance)
                // Income = member paid money to Tuna (negative balance)
                Balance = g.Where(t => t.Type == "Expense").Sum(t => t.Amount) - 
                         g.Where(t => t.Type == "Income").Sum(t => t.Amount)
            })
            .Where(b => b.Balance > 0) // Only show members who owe money
            .ToList();
        
        // Load user information
        var userIds = userBalances.Select(b => b.UserId).ToList();
        var users = await UserManager.Users
            .Where(u => userIds.Contains(u.Id))
            .AsNoTracking()
            .ToDictionaryAsync(u => u.Id);
        
        // Create member debt list
        memberDebts = userBalances
            .Where(b => users.ContainsKey(b.UserId))
            .Select(b => new MemberDebt
            {
                Member = users[b.UserId],
                AmountOwed = b.Balance
            })
            .OrderByDescending(d => d.AmountOwed)
            .ToList();
        
        filteredMemberDebts = memberDebts;
        isLoading = false;
    }
    
    private async Task OnFiscalYearChanged()
    {
        // Update URL with query parameter, preserve reportId if present
        var reportIdParam = ReportId.HasValue ? $"&reportId={ReportId}" : "";
        NavigationManager.NavigateTo($"/calotes?fy={selectedFiscalYear}{reportIdParam}", forceLoad: false);
        searchTerm = "";
        await LoadCalotes();
    }
    
    private void GoBack()
    {
        // Navigate back to the report page if we came from there, otherwise go to finance
        if (ReportId.HasValue)
        {
            NavigationManager.NavigateTo($"/finance/report/{ReportId}");
        }
        else
        {
            NavigationManager.NavigateTo("/finance");
        }
    }
    
    private void FilterMembers()
    {
        if (string.IsNullOrEmpty(searchTerm))
        {
            filteredMemberDebts = memberDebts;
            return;
        }
        
        // Use SearchHelper for multi-word search support
        debtSearchHelper.SearchTerm = searchTerm;
        filteredMemberDebts = debtSearchHelper.FilterMultiple(memberDebts, new List<Func<MemberDebt, string>>
        {
            d => d.Member.FirstName ?? "",
            d => d.Member.LastName ?? "",
            d => d.Member.Nickname ?? "",
            d => d.Member.Email ?? ""
        });
    }
    
    private void OpenAddCaloteModal()
    {
        if (!canAddCalote) return;
        
        isEditMode = false;
        selectedMember = null;
        editAmount = 0;
        editDescription = "";
        memberSearchTerm = "";
        filteredMembersForModal.Clear();
        errorMessage = "";
        editingDebt = null;
        showCaloteModal = true;
    }
    
    private async Task OpenEditCaloteModal(MemberDebt debt)
    {
        if (!canAddCalote) return;
        
        isEditMode = true;
        selectedMember = debt.Member;
        editAmount = 0; // Clear - not used in edit mode (uses individual transaction amounts)
        editDescription = "";
        memberSearchTerm = "";
        filteredMembersForModal.Clear();
        errorMessage = "";
        editingDebt = debt;
        
        // Load transactions for editing
        if (calotesActivity != null)
        {
            var transactions = await TransactionService.GetTransactionsByActivityIdAsync(calotesActivity.Id);
            editableTransactions = transactions
                .Where(t => t.UserId == debt.Member.Id && t.Type == "Expense")
                .OrderByDescending(t => t.Date)
                .Select(t => new EditableTransaction
                {
                    Id = t.Id,
                    Amount = t.Amount,
                    Description = t.Description,
                    Date = t.Date,
                    IsDeleted = false,
                    IsModified = false
                })
                .ToList();
        }
        
        showCaloteModal = true;
    }
    
    private void CloseCaloteModal()
    {
        showCaloteModal = false;
        isEditMode = false;
        selectedMember = null;
        editAmount = 0;
        editDescription = "";
        memberSearchTerm = "";
        filteredMembersForModal.Clear();
        errorMessage = "";
        editingDebt = null;
        editableTransactions.Clear();
        isSavingTransactions = false;
    }
    
    private void FilterMembersForModal()
    {
        if (string.IsNullOrEmpty(memberSearchTerm))
        {
            filteredMembersForModal.Clear();
            return;
        }

        // Use SearchHelper for multi-word search support
        searchHelper.SearchTerm = memberSearchTerm;
        filteredMembersForModal = searchHelper.FilterMultiple(allMembers, new List<Func<ApplicationUser, string>>
        {
            u => u.FirstName ?? "",
            u => u.LastName ?? "",
            u => u.Nickname ?? "",
            u => u.Email ?? ""
        });
    }
    
    private void SelectMember(ApplicationUser member)
    {
        selectedMember = member;
    }
    
    private async Task SaveCalote()
    {
        if (selectedMember == null || editAmount <= 0 || string.IsNullOrWhiteSpace(editDescription) || calotesActivity == null)
        {
            if (selectedMember == null)
                errorMessage = "Por favor, selecione um membro.";
            else if (editAmount <= 0)
                errorMessage = "O montante deve ser maior que zero.";
            else if (string.IsNullOrWhiteSpace(editDescription))
                errorMessage = "Por favor, forneça uma descrição.";
            else
                errorMessage = "Não foi possível encontrar a atividade CALOTES.";
            
            return;
        }

        errorMessage = "";

        try
        {
            // Create new calote transaction
            await TransactionService.CreateTransactionAsync(
                DateTime.UtcNow,
                editDescription,
                CaloteCategory,
                editAmount,
                "Expense", // Member owes money to Tuna
                calotesActivity.Id,
                null,
                null,
                null,
                selectedMember.Id
            );

            await LoadCalotes();
            CloseCaloteModal();
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro ao guardar: {ex.Message}";
        }
    }
    
    private async Task SaveEditedTransactions()
    {
        if (calotesActivity == null || selectedMember == null) return;
        
        isSavingTransactions = true;
        errorMessage = "";
        StateHasChanged();
        
        try
        {
            foreach (var transaction in editableTransactions)
            {
                if (transaction.IsDeleted)
                {
                    // Delete the transaction
                    await TransactionService.DeleteTransactionAsync(transaction.Id);
                }
                else if (transaction.IsModified)
                {
                    // Validate amount is greater than 0
                    if (transaction.Amount <= 0)
                    {
                        errorMessage = "O montante deve ser maior que zero.";
                        isSavingTransactions = false;
                        StateHasChanged();
                        return;
                    }
                    
                    // Update the transaction
                    await TransactionService.UpdateTransactionAsync(
                        transaction.Id,
                        transaction.Date,
                        transaction.Description,
                        CaloteCategory,
                        transaction.Amount,
                        "Expense",
                        null,
                        null,
                        null,
                        false,
                        selectedMember.Id
                    );
                }
            }
            
            await LoadCalotes();
            CloseCaloteModal();
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro ao guardar alterações: {ex.Message}";
        }
        finally
        {
            isSavingTransactions = false;
            StateHasChanged();
        }
    }
    
    private void OpenDeleteConfirmation(MemberDebt debt)
    {
        deletingDebt = debt;
        showDeleteConfirmation = true;
    }
    
    private void CloseDeleteConfirmation()
    {
        showDeleteConfirmation = false;
        deletingDebt = null;
    }
    
    private async Task ConfirmDeleteCalote()
    {
        if (deletingDebt == null || calotesActivity == null) return;
        
        try
        {
            // Get all transactions for this user in the CALOTES activity
            var userTransactions = (await TransactionService.GetTransactionsByActivityIdAsync(calotesActivity.Id))
                .Where(t => t.UserId == deletingDebt.Member.Id)
                .ToList();
            
            // Delete all transactions
            foreach (var transaction in userTransactions)
            {
                await TransactionService.DeleteTransactionAsync(transaction.Id);
            }
            
            await LoadCalotes();
            CloseDeleteConfirmation();
        }
        catch (Exception ex)
        {
            // Show error message to user
            errorMessage = $"Erro ao remover calote: {ex.Message}";
            showDeleteConfirmation = false;
            deletingDebt = null;
        }
    }
    
    private async Task OpenDetailsModal(MemberDebt debt)
    {
        viewingDebt = debt;
        viewingMemberTransactions.Clear();
        
        // Load transactions for this member
        if (calotesActivity != null)
        {
            var transactions = await TransactionService.GetTransactionsByActivityIdAsync(calotesActivity.Id);
            viewingMemberTransactions = transactions
                .Where(t => t.UserId == debt.Member.Id && t.Type == "Expense")
                .ToList();
        }
        
        showDetailsModal = true;
    }

    private void CloseDetailsModal()
    {
        showDetailsModal = false;
        viewingDebt = null;
        viewingMemberTransactions.Clear();
    }
    
    // Helper class to track member debts
    private class MemberDebt
    {
        public ApplicationUser Member { get; set; } = null!;
        public decimal AmountOwed { get; set; }
    }
}
