@page "/"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using RTUB.Application.Interfaces
@implements IDisposable
@inject ISlideshowService SlideshowService
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<!-- Push Notification Prompt for PWA mode -->
<PushNotificationPrompt />

<!-- Login Popup for custom messages -->
<LoginPopup />

<div class="homepage-content">

<!-- #1 Hero: Carousel (desktop only) + Logo -->
@if (slides != null && slides.Any())
{
    <div id="homeCarousel"
         class="carousel slide shadow rounded-4 overflow-hidden homepage-carousel"
         data-bs-ride="carousel"
         data-bs-pause="hover"
         data-bs-wrap="true"
         data-bs-touch="true"
         data-bs-keyboard="true"
         aria-label="Destaques">

        <!-- Carousel fade overlay -->
        <div class="carousel-fade-bottom"></div>

        <!-- Dots -->
        <div class="carousel-indicators">
            @for (int i = 0; i < slides.Count; i++)
            {
                var index = i;
                <button type="button"
                        data-bs-target="#homeCarousel"
                        data-bs-slide-to="@index"
                        class="@(index == 0 ? "active" : "")"
                        aria-current="@(index == 0 ? "true" : "false")"
                        aria-label="Slide @(index + 1)"></button>
            }
        </div>

        <!-- Slides -->
        <div class="carousel-inner">
            @for (int i = 0; i < slides.Count; i++)
            {
                var slide = slides[i];
                var index = i;
                <div class="carousel-item @(index == 0 ? "active" : "")" data-bs-interval="@slide.IntervalMs">
                    <img src="@slide.ImageSrc" class="d-block w-100 carousel-image" alt="@slide.Title">
                    <div class="carousel-caption">
                        <h2 class="h3 text-light">@slide.Title</h2>
                        <p class="text-light-50">@slide.Description</p>
                    </div>
                </div>
            }
        </div>

        <!-- Arrows -->
        <button class="carousel-control-prev" type="button" data-bs-target="#homeCarousel" data-bs-slide="prev" aria-label="Anterior">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Anterior</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#homeCarousel" data-bs-slide="next" aria-label="Seguinte">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Seguinte</span>
        </button>
    </div>
}

<!-- #2 Logo Hero (always visible) -->
<div class="text-center homepage-hero">
    <img src="/images/rtub_logo.webp" alt="RTUB Logo" class="logo-main" />
</div>

<!-- #3 Sticky Desktop Section Nav (hidden until scrolled past hero; mobile uses bottom nav) -->
<PortalSectionNav Items="@desktopNavItems" ActiveKey="@activeSection" OnSelect="ScrollToSection" />

<!-- #4 All Portal Sections rendered sequentially -->

<section id="section-aboutus" class="portal-section in-view">
    <AboutUsContent />
</section>

<section id="section-joinus" class="portal-section">
    <JoinUsContent />
</section>

<section id="section-history" class="portal-section">
    <HistoryContent />
</section>

<section id="section-hierarchy" class="portal-section">
    <HierarchyContent />
</section>

<section id="section-fitab" class="portal-section">
    <FitabContent />
</section>

<!-- #5 Social Media -->
<section class="portal-section homepage-social" id="section-social">
    <div class="portal-section__header">
        <i class="bi bi-share portal-section__icon" aria-hidden="true"></i>
        <h2 class="portal-section__title">Redes Sociais</h2>
    </div>
    <div class="portal-section__divider"></div>
    <!-- Mobile/Tablet: 2×2 grid (visible ≤991px) -->
    <div class="d-lg-none">
        <SocialMediaGrid />
    </div>
    <!-- Desktop: styled row (visible ≥992px) -->
    <div class="d-none d-lg-flex gap-2 gap-md-3 flex-wrap">
