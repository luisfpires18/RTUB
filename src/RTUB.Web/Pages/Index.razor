            </svg>
            <span>Spotify</span>
        </a>
    </div>
</section>

</div>

<!-- #6 Mobile Bottom Nav -->
@if (isAuthenticated)
{
    <MobileBottomNav Items="@appNavItems" OnSelect="HandleAppNavSelect"
                     Badges="@appNavBadges" />
}
else
{
    <MobileBottomNav Items="@mobileNavItems" ActiveKey="@activeSection" OnSelect="ScrollToSection" />
}

@code {
    private List<Slideshow>? slides;
    private string activeSection = "section-aboutus";
    private DotNetObjectReference<Index>? dotNetRef;
    private bool isAuthenticated;

    // Desktop sticky nav items
    private static readonly IReadOnlyList<PortalSectionNav.PortalNavItem> desktopNavItems = new[]
    {
        new PortalSectionNav.PortalNavItem("section-aboutus",   "Sobre Nós"),
        new PortalSectionNav.PortalNavItem("section-joinus",    "Junta-te a nós"),
        new PortalSectionNav.PortalNavItem("section-history",   "História"),
        new PortalSectionNav.PortalNavItem("section-hierarchy", "Hierarquia"),
        new PortalSectionNav.PortalNavItem("section-fitab",     "FITAB"),
    };

    // Mobile bottom nav items (portal section scroll — public only)
    private static readonly IReadOnlyList<MobileBottomNav.MobileNavItem> mobileNavItems = new[]
    {
        new MobileBottomNav.MobileNavItem("section-aboutus",   "Sobre Nós",  "bi-info-circle"),
        new MobileBottomNav.MobileNavItem("section-joinus",    "Junta-te",   "bi-person-plus"),
        new MobileBottomNav.MobileNavItem("section-history",   "História",   "bi-clock-history"),
        new MobileBottomNav.MobileNavItem("section-hierarchy", "Hierarquia", "bi-diagram-3"),
        new MobileBottomNav.MobileNavItem("section-fitab",     "FITAB",      "bi-lightning-fill"),
    };

    // App navigation items (for authenticated users bottom nav)
    private static readonly IReadOnlyList<MobileBottomNav.MobileNavItem> appNavItems = new[]
    {
        new MobileBottomNav.MobileNavItem("/music",        "Música",    "bi-music-note-beamed"),
        new MobileBottomNav.MobileNavItem("/events",       "Atuações",  "bi-calendar-event"),
        new MobileBottomNav.MobileNavItem("/rehearsals",   "Ensaios",   "bi-music-note-list"),
        new MobileBottomNav.MobileNavItem("/messages",     "Mensagens", "bi-chat-dots"),
        new MobileBottomNav.MobileNavItem("/profile",      "Perfil",    "bi-person-circle"),
    };

    // Badge for unread messages on the /messages nav item
    private Dictionary<string, RenderFragment> appNavBadges = new()
    {
        ["/messages"] = @<UnreadMessagesBadge CssClass="" />
    };

    // Section IDs for scroll-spy
    private static readonly string[] sectionIds = new[]
    {
        "section-aboutus", "section-joinus", "section-history", "section-hierarchy", "section-fitab"
    };

    private Task HandleAppNavSelect(string route)
    {
        Navigation.NavigateTo(route);
        return Task.CompletedTask;
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        isAuthenticated = authState.User?.Identity?.IsAuthenticated ?? false;

        if (isAuthenticated)
        {
            slides = (await SlideshowService.GetActiveSlideshowsAsync()).ToList();
        }
        else
        {
            slides = (await SlideshowService.GetActivePublicSlideshowsAsync()).ToList();
        }
    }

    /// <summary>
    /// Called from JS scroll-spy when active section changes.
    /// </summary>
    [JSInvokable]
    public void OnActiveSectionChanged(string sectionId)
    {
        if (activeSection != sectionId)
        {
            activeSection = sectionId;
            InvokeAsync(StateHasChanged);
        }
    }

    private async Task ScrollToSection(string sectionId)
    {
        activeSection = sectionId;
        try
        {
            await JSRuntime.InvokeVoidAsync("rtubScrollSpy.scrollToSection", sectionId);
        }
        catch (TaskCanceledException) { }
        catch (Microsoft.JSInterop.JSDisconnectedException) { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // Initialize carousel if slides exist
                if (slides != null && slides.Any())
                {
                    await JSRuntime.InvokeVoidAsync("eval", @"
                        (function() {
                            const carouselElement = document.getElementById('homeCarousel');
                            if (carouselElement && window.bootstrap) {
                                const carousel = new bootstrap.Carousel(carouselElement, {
                                    ride: 'carousel',
                                    interval: 5000,
                                    pause: 'hover',
                                    wrap: true,
                                    touch: true,
                                    keyboard: true
                                });
                                carousel.cycle();
                            }
                        })();
                    ");
                }

                // Initialize scroll-spy
                dotNetRef = DotNetObjectReference.Create(this);
                await JSRuntime.InvokeVoidAsync("rtubScrollSpy.init", dotNetRef, sectionIds);

                // Trigger scroll-reveal: mark visible sections as in-view, observe the rest
                await JSRuntime.InvokeVoidAsync("eval", @"
                    (function() {
                        var sections = document.querySelectorAll('.portal-section');
                        var revealObserver = new IntersectionObserver(function(entries) {
                            entries.forEach(function(entry) {
                                if (entry.isIntersecting) {
                                    entry.target.classList.add('in-view');
                                    revealObserver.unobserve(entry.target);
                                }
                            });
                        }, { threshold: 0.05, rootMargin: '0px 0px 80px 0px' });
                        sections.forEach(function(section) {
                            var rect = section.getBoundingClientRect();
                            if (rect.top < window.innerHeight + 80 && rect.bottom > 0) {
                                section.classList.add('in-view');
                            } else {
                                revealObserver.observe(section);
                            }
                        });
                    })();
                ");
            }
            catch (TaskCanceledException) { }
            catch (Microsoft.JSInterop.JSDisconnectedException) { }
        }
    }

    public void Dispose()
    {
        try
        {
            dotNetRef?.Dispose();
        }
        catch { }
    }
}

