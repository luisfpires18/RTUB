@page "/owner/query"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using RTUB.Application.Data
@using RTUB.Shared
@attribute [Authorize(Roles = "Owner")]
@inject ApplicationDbContext DbContext

<PageTitle>Query Executor</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-md-12">
            <h1 class="page-title"><i class="bi bi-terminal"></i> Query Executor</h1>
            <p class="lead mb-4 text-light-theme">Execute SQL queries directly on the SQLite database</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <Alert Type="Alert.AlertType.Success" 
               Message="@successMessage" 
               Dismissible="true"
               OnDismiss="@(() => successMessage = string.Empty)" />
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <Alert Type="Alert.AlertType.Error" 
               Message="@errorMessage" 
               Dismissible="true"
               OnDismiss="@(() => errorMessage = string.Empty)" />
    }

    <div class="card">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-code-square"></i> SQL Query</h5>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <label for="sqlQuery" class="form-label text-white-full fw-semibold">
                    <i class="bi bi-terminal text-primary me-2"></i>SQL Query
                </label>
                <textarea class="form-control" 
                          id="sqlQuery" 
                          @bind="sqlQuery" 
                          rows="10"
                          placeholder="Enter your SQL query here"
                          style="font-family: 'Courier New', monospace;"></textarea>
                <small class="text-light-theme">
                    <i class="bi bi-exclamation-triangle text-warning me-1"></i>
                    <strong>Warning:</strong> Be extremely careful when executing queries. There is no undo functionality.
                </small>
            </div>

            <div class="d-flex gap-2">
                <button type="button" 
                        class="btn btn-purple" 
                        @onclick="ExecuteQuery"
                        disabled="@(isExecuting || string.IsNullOrWhiteSpace(sqlQuery))">
                    @if (isExecuting)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                        <span>Executing...</span>
                    }
                    else
                    {
                        <i class="bi bi-play-fill"></i>
                        <span> Execute</span>
                    }
                </button>
                <button type="button" 
                        class="btn btn-light" 
                        @onclick="ClearQuery"
                        disabled="@isExecuting">
                    <i class="bi bi-x-circle"></i> Clear
                </button>
            </div>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-info-circle"></i> Usage Guidelines</h5>
        </div>
        <div class="card-body">
            <ul class="text-white-full mb-0">
                <li>Only SQL commands that modify data are supported (UPDATE, DELETE, INSERT)</li>
                <li>SELECT queries are not supported through this interface</li>
                <li>Always test your queries in a development environment first</li>
                <li>Make sure to backup your database before running destructive queries</li>
                <li>Use transactions when executing multiple related queries</li>
            </ul>
        </div>
    </div>
</div>

@code {
    private string sqlQuery = string.Empty;
    private string successMessage = string.Empty;
    private string errorMessage = string.Empty;
    private bool isExecuting = false;

    private async Task ExecuteQuery()
    {
        if (string.IsNullOrWhiteSpace(sqlQuery))
        {
            return;
        }

        // Clear previous messages
        successMessage = string.Empty;
        errorMessage = string.Empty;
        isExecuting = true;
        StateHasChanged();

        try
        {
            // Execute the raw SQL query
            var rowsAffected = await DbContext.Database.ExecuteSqlRawAsync(sqlQuery);

            successMessage = $"Query executed successfully. {rowsAffected} row(s) affected.";
            
            // Clear the query after successful execution
            sqlQuery = string.Empty;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error executing query: {ex.Message}";
        }
        finally
        {
            isExecuting = false;
            StateHasChanged();
        }
    }

    private void ClearQuery()
    {
        sqlQuery = string.Empty;
        successMessage = string.Empty;
        errorMessage = string.Empty;
    }
}
