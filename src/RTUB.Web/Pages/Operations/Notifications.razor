@page "/notifications"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using RTUB.Application.DTOs
@using RTUB.Application.Interfaces
@using RTUB.Core.Entities
@using RTUB.Shared
@using RTUB.Shared.Base
@using System.Text.Json
@attribute [Authorize(Roles = "Admin")]
@inject UserManager<ApplicationUser> UserManager
@inject IPushNotificationService PushNotificationService
@inject IAuditLogService AuditLogService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject ILogger<Notifications> Logger

<PageTitle>Enviar Notificação Push</PageTitle>

<div class="mb-4">
    <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 mb-3">
        <div>
            <h1 class="page-title mb-2"><i class="bi bi-bell"></i> Enviar Notificação Push</h1>
            <p class="lead page-header-subtitle mb-0 text-light-theme">Enviar notificações push para todos os utilizadores subscritos</p>
        </div>
    </div>
</div>

    @if (!string.IsNullOrEmpty(message))
    {
        <Alert Type="@(isError ? Alert.AlertType.Error : Alert.AlertType.Success)" 
               Message="@message" 
               Dismissible="true"
               OnDismiss="@(() => message = string.Empty)" />
    }

    @if (isLoadingSubscribers)
    {
        <LoadingSpinner Message="A carregar destinatários..." />
    }
    else
    {
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-pencil-square"></i> Compor Notificação</h5>
            </div>
            <div class="card-body">
                <form>
                    <div class="mb-3">
                        <label for="notificationTitle" class="form-label">
                            Título <span class="text-danger">*</span>
                        </label>
                        <input type="text" 
                               class="form-control @(titleError ? "is-invalid" : "")" 
                               id="notificationTitle" 
                               @bind="title" 
                               placeholder="Ex: Nova Atuação Agendada"
                               maxlength="100"
                               required />
                        @if (titleError)
                        {
                            <div class="invalid-feedback">O título é obrigatório</div>
                        }
                        <small class="form-text text-muted">
                            Título da notificação push (máximo 100 caracteres)
                        </small>
                    </div>

                    <div class="mb-3">
                        <label for="notificationContent" class="form-label">
                            Mensagem <span class="text-danger">*</span>
                        </label>
                        <textarea class="form-control @(contentError ? "is-invalid" : "")" 
                                  id="notificationContent" 
                                  @bind="content" 
                                  rows="6"
                                  placeholder="Escreva a mensagem da notificação aqui..."
                                  maxlength="500"
                                  required></textarea>
                        @if (contentError)
                        {
                            <div class="invalid-feedback">A mensagem é obrigatória</div>
                        }
                        <small class="form-text text-muted">
                            Esta notificação será enviada para os utilizadores selecionados (máximo 500 caracteres)
                        </small>
                    </div>

                    <div class="alert alert-purple">
                        <i class="bi bi-info-circle"></i>
                        <strong>Informação:</strong> Esta notificação push será enviada para os utilizadores selecionados. Use a lista abaixo para escolher os destinatários.
                    </div>

                    <!-- Progress Display -->
                    @if (isSending)
                    {
                        <div class="alert alert-purple">
                            <div class="d-flex align-items-center">
                                <div class="spinner-border spinner-border-sm me-2" role="status">
                                    <span class="visually-hidden">A enviar...</span>
                                </div>
                                <strong>Enviando notificações...</strong>
                            </div>
                        </div>
                    }

                    <div class="d-flex gap-2">
                        <button type="button" 
                                class="btn btn-purple" 
                                @onclick="ShowPreview"
                                disabled="@(isSending || string.IsNullOrWhiteSpace(title) || string.IsNullOrWhiteSpace(content))">
                            <i class="bi bi-eye"></i> Pré-visualizar
                        </button>
                        <button type="button" 
                                class="btn btn-purple" 
                                @onclick="SendNotifications"
                                disabled="@(isSending || string.IsNullOrWhiteSpace(title) || string.IsNullOrWhiteSpace(content))">
                            @if (isSending)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                                <span>A enviar...</span>
                            }
                            else
                            {
                                <i class="bi bi-send"></i>
                                <span> Enviar</span>
                            }
                        </button>
                        <button type="button" 
                                class="btn btn-light" 
                                @onclick="ClearForm"
                                disabled="@isSending">
                            <i class="bi bi-x-circle"></i> Limpar
                        </button>
                    </div>
                </form>
            </div>
        </div>


        @if (subscribedUsers.Any())
        {
            <div class="card mt-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-people"></i> Selecionar Destinatários</h5>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(recipientsMessage))
                    {
                        <Alert Type="@(isRecipientsError ? Alert.AlertType.Error : Alert.AlertType.Success)" 
                               Message="@recipientsMessage" 
                               Dismissible="true"
                               OnDismiss="@(() => recipientsMessage = string.Empty)" />
                    }
                    
                    <div class="mb-3">
                        <SearchBar @bind-Value="searchQuery"
                                   Placeholder="Pesquisar utilizadores..."
                                   OnSearch="@HandleSearchChanged"
                                   DebounceDelay="300" />
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="text-white-full mb-0">
                            Utilizadores Subscritos (@selectedUsers.Count/@subscribedUsersCount selecionados)
                        </h6>
                        <div class="form-check">
                            <input class="form-check-input" 
                                   type="checkbox" 
                                   id="selectAll"
                                   @onchange="ToggleSelectAll"
                                   checked="@isAllSelected" />
                            <label class="form-check-label text-white-full" for="selectAll">
                                Selecionar todos
                            </label>
                        </div>
                    </div>

                    <div class="subscriber-list subscriber-list-scrollable">
                        @{
                            var filteredUsers = GetFilteredUsers();
                            var usersToShow = GetPagedUsers(filteredUsers);
                        }
                        @foreach (var user in usersToShow)
                        {
                            <div class="subscriber-item p-2 mb-1 rounded bg-dark text-white-full" @key="user.Id">
                                <input class="form-check-input me-2" 
                                       type="checkbox" 
                                       @onchange="(e) => ToggleUserSelection(user, (bool)(e.Value ?? false))"
                                       checked="@IsUserSelected(user)" />
                                <img src="@user.ProfilePictureSrc" 
                                     alt="@(user.Nickname ?? user.FirstName)"
                                     class="member-avatar-small me-2" />
                                <span class="flex-grow-1">@(user.Nickname ?? $"{user.FirstName} {user.LastName}")</span>
                            </div>
                        }
                    </div>

                    @if (filteredUsers.Count > pageSize)
                    {
                        <div class="mt-2">
                            <TablePagination CurrentPage="@currentPage"
                                           PageSize="@pageSize"
                                           TotalItems="@filteredUsers.Count"
                                           ItemLabel="utilizadores"
                                           OnPageChanged="@OnPageChanged"
                                           OnPageSizeChanged="@OnPageSizeChanged"
                                           PageSizeOptions="@(new[] { 10, 25, 50, 100 })" />
                        </div>
                    }
                </div>
            </div>
        }
    }

<!-- Preview Modal -->
<Modal Show="@modals.IsOpen(ModalType.Preview)" 
       ShowChanged="@((show) => modals.Toggle(ModalType.Preview, show))"
       Title="Pré-visualização da Notificação"
       Size="Modal.ModalSize.Large">
    <BodyContent>
        <div class="notification-preview">
            <div class="notification-preview-card">
                <div class="notification-preview-header">
                    <img src="/icons/rtub-logo-192.png" alt="RTUB Logo" class="notification-preview-logo" />
                    <div class="notification-preview-content">
                        <h4 class="notification-preview-title">
                            @title
                        </h4>
                        <p class="notification-preview-body">@content</p>
                    </div>
                </div>
                <div class="notification-preview-footer">
                    <small class="notification-preview-footer-text">Notificação Push RTUB</small>
                </div>
            </div>
        </div>
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="() => modals.Close(ModalType.Preview)">Fechar</button>
    </FooterContent>
</Modal>

@code {
    private string title = "";
    private string content = "";
    private string message = "";
    private string recipientsMessage = "";
    private bool isError = false;
    private bool isRecipientsError = false;
    private bool isSending = false;
    private bool isLoadingSubscribers = true;
    private enum ModalType { Preview }
    private readonly MultiModalState<ModalType> modals = new();
    private bool titleError = false;
    private bool contentError = false;

    private List<ApplicationUser> subscribedUsers = new();
    private List<ApplicationUser> selectedUsers = new();
    private HashSet<string> selectedUserIds = new();
    private int subscribedUsersCount = 0;
    private bool isAllSelected = false;

    // Search and pagination state
    private string searchQuery = string.Empty;
    private int currentPage = 1;
    private int pageSize = 25;

    protected override async Task OnInitializedAsync()
    {
        await LoadSubscribedUsers();
    }

    private async Task LoadSubscribedUsers()
    {
        isLoadingSubscribers = true;
        try
        {
            // Get all user IDs with active push subscriptions
            var userIdsWithPushSubscriptions = (await PushNotificationService.GetSubscribedUserIdsAsync()).ToHashSet();

            // Load all users with push subscriptions
            subscribedUsers = await UserManager.Users
                .Where(u => userIdsWithPushSubscriptions.Contains(u.Id))
                .OrderBy(u => u.Nickname ?? u.FirstName)
                .AsNoTracking()
                .ToListAsync();
            
            subscribedUsersCount = subscribedUsers.Count;
            
            // Initially, all subscribed users are selected
            selectedUserIds = subscribedUsers.Select(u => u.Id).ToHashSet();
            selectedUsers = new List<ApplicationUser>(subscribedUsers);
            isAllSelected = subscribedUsers.Count > 0;
        }
        catch (Exception ex)
        {
            message = $"Erro ao carregar utilizadores subscritos: {ex.Message}";
            isError = true;
        }
        finally
        {
            isLoadingSubscribers = false;
        }
    }

    private List<ApplicationUser> GetFilteredUsers()
    {
        if (string.IsNullOrWhiteSpace(searchQuery))
        {
            return subscribedUsers;
        }

        var query = searchQuery.ToLower();
        return subscribedUsers.Where(u =>
            (!string.IsNullOrEmpty(u.Nickname) && u.Nickname.ToLower().Contains(query)) ||
            (!string.IsNullOrEmpty(u.FirstName) && u.FirstName.ToLower().Contains(query)) ||
            (!string.IsNullOrEmpty(u.LastName) && u.LastName.ToLower().Contains(query)) ||
            (!string.IsNullOrEmpty(u.Email) && u.Email.ToLower().Contains(query))
        ).ToList();
    }

    private List<ApplicationUser> GetPagedUsers(List<ApplicationUser> users)
    {
        var skip = (currentPage - 1) * pageSize;
        return users.Skip(skip).Take(pageSize).ToList();
    }

    private Task HandleSearchChanged(string newSearchQuery)
    {
        searchQuery = newSearchQuery;
        currentPage = 1;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task OnPageChanged(int newPage)
    {
        currentPage = newPage;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task OnPageSizeChanged(int newPageSize)
    {
        pageSize = newPageSize;
        currentPage = 1;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void ToggleUserSelection(ApplicationUser user, bool isSelected)
    {
        if (isSelected)
        {
            if (!selectedUserIds.Contains(user.Id))
            {
                selectedUserIds.Add(user.Id);
                selectedUsers.Add(user);
            }
        }
        else
        {
            selectedUserIds.Remove(user.Id);
            selectedUsers.RemoveAll(u => u.Id == user.Id);
        }

        // Update "select all" state based on filtered users
        var filteredUsers = GetFilteredUsers();
        isAllSelected = filteredUsers.Count > 0 && 
                       filteredUsers.All(u => selectedUserIds.Contains(u.Id));
    }

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        var isChecked = (bool)(e.Value ?? false);
        var filteredUsers = GetFilteredUsers();
        
        if (isChecked)
        {
            // Select all filtered users
            foreach (var user in filteredUsers)
            {
                if (!selectedUserIds.Contains(user.Id))
                {
                    selectedUserIds.Add(user.Id);
                    selectedUsers.Add(user);
                }
            }
        }
        else
        {
            // Deselect all filtered users
            foreach (var user in filteredUsers)
            {
                selectedUserIds.Remove(user.Id);
                selectedUsers.RemoveAll(u => u.Id == user.Id);
            }
        }

        isAllSelected = isChecked && filteredUsers.Count > 0;
    }

    private bool IsUserSelected(ApplicationUser user)
    {
        return selectedUserIds.Contains(user.Id);
    }

    private void ShowPreview()
    {
        if (string.IsNullOrWhiteSpace(title) || string.IsNullOrWhiteSpace(content))
        {
            return;
        }
        modals.Open(ModalType.Preview);
    }

    private async Task SendNotifications()
    {
        // Reset validation errors
        titleError = false;
        contentError = false;

        // Validate inputs
        if (string.IsNullOrWhiteSpace(title))
        {
            titleError = true;
            return;
        }

        if (string.IsNullOrWhiteSpace(content))
        {
            contentError = true;
            return;
        }

        if (!selectedUsers.Any())
        {
            message = "Selecione pelo menos um utilizador para receber a notificação push.";
            isError = true;
            return;
        }

        isSending = true;
        message = "";
        isError = false;

        try
        {
            // Create the notification DTO
            var notification = new SendPushNotificationDto
            {
                Title = title,
                Body = content,
                Icon = "/icons/rtub-logo-192.png",
                Url = Navigation.BaseUri.TrimEnd('/'),
                Tag = $"announcement-{DateTime.UtcNow.Ticks}"
            };

            // Send to selected users only
            var userIdsToSend = selectedUsers.Select(u => u.Id).ToList();
            var (sent, failed) = await PushNotificationService.SendToSelectedUsersAsync(userIdsToSend, notification);

            // Audit log for push notification sent
            try
            {
                var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
                var user = authState.User;
                var userId = user?.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                var userName = user?.Identity?.Name;

                if (!string.IsNullOrEmpty(userId) && !string.IsNullOrEmpty(userName))
                {
                    var changes = JsonSerializer.Serialize(new
                    {
                        RecipientCount = userIdsToSend.Count,
                        NotificationBody = notification.Body
                    });

                    var auditLog = new RTUB.Core.Entities.AuditLog
                    {
                        EntityType = "Notification",
                        EntityId = null,
                        Action = "PushNotificationSent",
                        UserId = userId,
                        UserName = userName,
                        Timestamp = DateTime.UtcNow,
                        Changes = changes,
                        EntityDisplayName = notification.Title,
                        IsCriticalAction = false
                    };

                    await AuditLogService.AddAsync(auditLog);
                }
            }
            catch (Exception auditEx)
            {
                // Log error but don't fail the operation
                Logger.LogError(auditEx, "Failed to create audit log for push notification sent");
            }

            message = failed > 0
                ? $"Notificação enviada para {selectedUsers.Count} utilizadores ({sent} push enviados, {failed} falhados). Mensagens de inbox foram entregues como backup."
                : $"Notificação enviada com sucesso para {selectedUsers.Count} utilizadores! ({sent} push enviados)";
            isError = sent == 0 && failed > 0;

            // Clear form
            ClearForm();
        }
        catch (Exception ex)
        {
            message = $"Erro ao enviar notificações: {ex.Message}";
            isError = true;
        }
        finally
        {
            isSending = false;
        }
    }

    private void ClearForm()
    {
        title = "";
        content = "";
        titleError = false;
        contentError = false;
        
        // Reset selection to all users
        selectedUserIds = subscribedUsers.Select(u => u.Id).ToHashSet();
        selectedUsers = new List<ApplicationUser>(subscribedUsers);
        isAllSelected = subscribedUsers.Count > 0;
    }
}
