@page "/owner/tracing"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using RTUB.Application.Interfaces
@using RTUB.Core.Entities
@using RTUB.Shared
@using RTUB.Shared.Base
@using System.Text.Json
@attribute [Authorize(Roles = "Owner")]
@inject IAuditLogService AuditLogService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject RTUB.Web.Services.AnnouncementService AnnouncementService

<PageTitle>Audit Logs</PageTitle>

<div class="container-fluid audit-log-page">
    <div class="page-header-centered">
        <div class="page-header-left"></div>
        <div class="page-header-center">
            <h1><i class="bi bi-shield-check"></i> Histórico de atividades</h1>
            <p class="lead page-header-subtitle text-light-theme">Rastreio de atividades em todo o sistema para fins de responsabilização e resolução de problemas</p>
        </div>
        <div class="page-header-right d-none d-xl-flex gap-2">
            <LoginStatisticsButton />
            <button class="btn btn-success" @onclick="ExportToJson" disabled="@isExporting">
                <i class="bi bi-download"></i> <span class="btn-text">@(isExporting ? "Exporting..." : "Export JSON")</span>
            </button>
            <button class="btn btn-danger" @onclick="ShowTruncateConfirmation" disabled="@(totalRecords == 0)">
                <i class="bi bi-trash"></i> <span class="btn-text">Truncate All</span>
            </button>
        </div>
    </div>

    @* Ref-only instance for mobile nav — button hidden, modal renders at page level *@
    <LoginStatisticsButton @ref="loginStatsButton" HideButton="true" />

    @* System Announcement Broadcast *@
    <div class="card mb-4">
        <div class="card-header">
            <i class="bi bi-megaphone-fill me-2"></i>Anúncio de Sistema
        </div>
        <div class="card-body">
            <div class="d-flex gap-2 align-items-start flex-column">
                <textarea class="form-control" rows="2" maxlength="500"
                          placeholder="Ex: O servidor vai ser reiniciado para atualização. Por favor, aguarda."
                          @bind="announcementMessage"></textarea>
                <div class="w-100 d-flex justify-content-center">
                    <button class="btn btn-primary"
                            @onclick="BroadcastAnnouncement"
                            disabled="@(string.IsNullOrWhiteSpace(announcementMessage) || isBroadcasting)">
                        <i class="bi bi-megaphone-fill me-1"></i>
                        @(isBroadcasting ? "A enviar..." : "Transmitir a todos")
                    </button>
                </div>
            </div>
            @if (broadcastConfirmed)
            {
                <Alert Type="Alert.AlertType.Success"
                       Icon="bi-check-circle-fill"
                       Message="Anúncio transmitido com sucesso a todos os utilizadores ligados."
                       AdditionalClasses="mt-2 mb-0" />
            }
        </div>
    </div>

    @if (isLoading)
    {
        <LoadingSpinner />
    }
    else
    {
        <!-- Filters Section - Collapsible -->
        <div class="card filters-card">
            <div class="card-header filters-header" @onclick="ToggleFilters">
                <div class="filters-header-content">
                    <h5 class="mb-0"><i class="bi bi-funnel"></i> Filtros</h5>
                    <i class="bi bi-chevron-@(filtersExpanded ? "up" : "down")"></i>
                </div>
            </div>
            <div class="card-body filters-body @(filtersExpanded ? "expanded" : "collapsed")">
                <div class="filters-grid row g-3">
                    <div class="filter-group col-12 col-md-6">
                        <label class="form-label">User</label>
                        <FilterDropdown ShowIcon="false"
                                        SelectedValue="@selectedUser"
                                        SelectedValueChanged="@(value => selectedUser = value)"
                                        OnChange="@ApplyFilters"
                                        AllItemsLabel="All Users"
                                        Items="@availableUsers" />
                    </div>
                    <div class="filter-group col-12 col-md-6">
                        <label class="form-label">Exclude User</label>
                        <FilterDropdown ShowIcon="false"
                                        SelectedValue="@excludedUser"
                                        SelectedValueChanged="@(value => excludedUser = value)"
                                        OnChange="@ApplyFilters"
                                        AllItemsLabel="No Exclusion"
                                        Items="@availableUsers" />
                    </div>
                    <div class="filter-group col-12 col-md-6">
                        <label class="form-label">Entity Type</label>
                        <FilterDropdown SelectedValue="@selectedEntityType"
                                        SelectedValueChanged="@(value => selectedEntityType = value)"
                                        OnChange="@ApplyFilters"
                                        AllItemsLabel="All Entities"
                                        Items="@availableEntityTypes" />
                    </div>
                    <div class="filter-group col-12 col-md-6">
                        <label class="form-label">Action</label>
                        <FilterDropdown SelectedValue="@selectedAction"
                                        SelectedValueChanged="@(value => selectedAction = value)"
                                        OnChange="@ApplyFilters"
                                        AllItemsLabel="All Actions"
                                        Items="@availableActions" />
                    </div>
                </div>
                <div class="filters-bottom d-flex flex-column gap-3 w-100">
                    <div class="filter-search w-100">
                        <SearchBar
                            @bind-Value="searchTerm"
                            OnSearch="UpdateSearch"
                            Placeholder="Search in changes..." />
                    </div>
                    <div class="filters-actions-row d-flex flex-row flex-wrap align-items-center justify-content-between gap-2 w-100">
                        <div class="filter-group filter-checkbox mb-0">
                            <div class="rtub-checkbox-wrapper d-flex align-items-center">
                                <input class="form-check-input rtub-checkbox-large" type="checkbox" id="criticalOnly" @bind="criticalOnly" @bind:after="ApplyFilters" />
                                <label class="form-check-label ms-2" for="criticalOnly">
                                    <i class="bi bi-exclamation-triangle-fill text-danger"></i> Critical Actions Only
                                </label>
                            </div>
                        </div>
                        <div class="filter-group filter-clear mb-0 ms-sm-auto">
                            <button class="btn btn-secondary btn-sm" @onclick="ClearFilters">
                                <i class="bi bi-x-circle"></i> Clear Filters
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Stats Section - Responsive Cards -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-card-content">
                    <div class="stat-icon">
                        <i class="bi bi-database"></i>
                    </div>
                    <div class="stat-info">
                        <div class="stat-value">@totalRecords</div>
                        <div class="stat-label">Total Registos</div>
                    </div>
                </div>
            </div>
            <div class="stat-card stat-critical">
                <div class="stat-card-content">
                    <div class="stat-icon">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                    </div>
                    <div class="stat-info">
                        <div class="stat-value">@criticalCount</div>
                        <div class="stat-label">Critical Actions</div>
                    </div>
                </div>
            </div>
            <div class="stat-card stat-entities">
                <div class="stat-card-content">
                    <div class="stat-icon">
                        <i class="bi bi-box"></i>
                    </div>
                    <div class="stat-info">
                        <div class="stat-value">@availableEntityTypes.Count()</div>
                        <div class="stat-label">Entity Types</div>
                    </div>
                </div>
            </div>
            <div class="stat-card stat-users">
                <div class="stat-card-content">
                    <div class="stat-icon">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <div class="stat-info">
                        <div class="stat-value">@availableUsers.Count()</div>
                        <div class="stat-label">Active Users</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Audit Log Cards -->
        @if (!auditLogs.Any())
        {
            <EmptyState 
                Title="No audit logs found matching the filters." 
                Icon="bi-inbox" />
        }
        else
        {
            <div class="card activity-log-card">
                <div class="card-header d-flex flex-column flex-lg-row gap-2 align-items-lg-center justify-content-between">
                    <h5 class="mb-0"><i class="bi bi-list-ul"></i> Activity Log</h5>
                </div>
                <div class="card-body">
                    <div class="tracing-card-grid">
                        @foreach (var log in auditLogs)
                        {
                            <TracingCard Log="@log"
                                         ActionBadgeClass="@GetActionBadgeClass(log.Action)"
                                         OnViewChanges="@(() => ShowChangesModal(log))"
                                         OnDelete="@(() => ShowDeleteConfirmation(log))" />
                        }
                    </div>
                </div>

                <!-- Pagination -->
                <div class="card-footer">
                    <TablePagination 
                        CurrentPage="@currentPage"
                        TotalItems="@totalRecords"
                        PageSize="@pageSize"
                        ItemLabel="logs"
                        PageSizeOptions="@(new[] { 20, 40, 60, 80, 100 })"
                        OnPageChanged="ChangePage"
                        OnPageSizeChanged="ChangePageSize" />
                </div>
            </div>
        }
    }
</div>

<!-- Changes Detail Modal -->
<Modal Show="@modals.IsOpen(ModalType.Changes)" 
       ShowChanged="@((show) => modals.Toggle(ModalType.Changes, show))"
       Title="@($"Change Details - {selectedLog?.EntityType}")"
       Size="Modal.ModalSize.Large">
    <BodyContent>
        @if (selectedLog != null)
        {
            <dl class="row">
                <dt class="col-sm-3">Timestamp</dt>
                <dd class="col-sm-9">@selectedLog.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</dd>

                <dt class="col-sm-3">User</dt>
                <dd class="col-sm-9">@(selectedLog.UserName ?? "System")</dd>

                <dt class="col-sm-3">Entity Type</dt>
                <dd class="col-sm-9">@selectedLog.EntityType</dd>

                @if (!string.IsNullOrEmpty(selectedLog.EntityDisplayName))
                {
                    <dt class="col-sm-3">Entity</dt>
                    <dd class="col-sm-9">@selectedLog.EntityDisplayName</dd>
                }

                <dt class="col-sm-3">Entity ID</dt>
                <dd class="col-sm-9">@(selectedLog.EntityId?.ToString() ?? "N/A")</dd>

                <dt class="col-sm-3">Action</dt>
                <dd class="col-sm-9">
                    <span class="badge @GetActionBadgeClass(selectedLog.Action)">
                        @selectedLog.Action
                    </span>
                </dd>

                @if (selectedLog.IsCriticalAction)
                {
                    <dt class="col-sm-3">Critical</dt>
                    <dd class="col-sm-9">
                        <span class="badge bg-danger">
                            <i class="bi bi-exclamation-triangle-fill"></i> Critical Action
                        </span>
                    </dd>
                }
            </dl>

            <hr />

            <h6>Changes:</h6>
            <pre class="bg-dark text-light p-3 border rounded changes-display">@FormatChanges(selectedLog.Changes)</pre>
        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="() => modals.Close(ModalType.Changes)">Close</button>
    </FooterContent>
</Modal>

<!-- Delete Single Log Confirmation Modal -->
<Modal Show="@modals.IsOpen(ModalType.Delete)" 
       ShowChanged="@((show) => modals.Toggle(ModalType.Delete, show))"
       Title="Confirm Delete">
    <BodyContent>
        @if (logToDelete != null)
        {
            <p class="fw-bold">Are you sure you want to delete this audit log entry?</p>
            <dl class="row">
                <dt class="col-sm-3">Entity:</dt>
                <dd class="col-sm-9">
                    @logToDelete.EntityType
                    @if (!string.IsNullOrEmpty(logToDelete.EntityDisplayName))
                    {
                        <span> - @logToDelete.EntityDisplayName</span>
                    }
                    else if (logToDelete.EntityId.HasValue)
                    {
                        <span> (ID: @logToDelete.EntityId)</span>
                    }
                </dd>
                
                <dt class="col-sm-3">Action:</dt>
                <dd class="col-sm-9">@logToDelete.Action</dd>
                
                <dt class="col-sm-3">User:</dt>
                <dd class="col-sm-9">@(logToDelete.UserName ?? "System")</dd>
                
                <dt class="col-sm-3">Timestamp:</dt>
                <dd class="col-sm-9">@logToDelete.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</dd>
            </dl>
            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle"></i>
                This action cannot be undone.
            </div>
        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="() => modals.Close(ModalType.Delete)">Cancel</button>
        <button type="button" class="btn btn-danger" @onclick="ConfirmDelete" disabled="@isDeleting">
            @if (isDeleting)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
                <span>Deleting...</span>
            }
            else
            {
                <i class="bi bi-trash"></i>
                <span> Delete</span>
            }
        </button>
    </FooterContent>
</Modal>

<!-- Truncate All Confirmation Modal -->
<Modal Show="@modals.IsOpen(ModalType.Truncate)" 
       ShowChanged="@((show) => modals.Toggle(ModalType.Truncate, show))"
       Title="@(string.IsNullOrWhiteSpace(truncateSelectedUser) ? "Confirm Truncate All" : $"Confirm Truncate by User")">
    <BodyContent>
        <div class="mb-3">
            <label class="form-label">User (Optional)</label>
            <select class="form-select" @bind="truncateSelectedUser">
                <option value="">All Users</option>
                @foreach (var user in availableUsers)
                {
                    <option value="@user" @key="user">@user</option>
                }
            </select>
            <small class="form-text text-muted">
                Select a user to delete only their logs, or leave as "All Users" to delete all logs.
            </small>
        </div>
        
        @if (string.IsNullOrWhiteSpace(truncateSelectedUser))
        {
            <p class="fw-bold">Are you sure you want to delete ALL audit logs?</p>
            <p>This action will permanently delete <strong>@totalRecords</strong> audit log records and cannot be undone.</p>
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <strong>Warning:</strong> This will remove all historical tracking data from the system.
            </div>
        }
        else
        {
            <p class="fw-bold">Are you sure you want to delete all audit logs for user <strong>@truncateSelectedUser</strong>?</p>
            <p>This action will permanently delete all audit log records from this user and cannot be undone.</p>
            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <strong>Warning:</strong> This will remove all historical tracking data for this user.
            </div>
        }
        
        <p>Type <code>DELETE ALL</code> to confirm:</p>
        <input type="text" class="form-control" @bind="truncateConfirmationText" placeholder="DELETE ALL" />
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="() => modals.Close(ModalType.Truncate)">Cancel</button>
        <button type="button" class="btn btn-danger" @onclick="ConfirmTruncate" disabled="@(truncateConfirmationText != "DELETE ALL" || isTruncating)">
            @if (isTruncating)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
                <span>Deleting...</span>
            }
            else
            {
                <i class="bi bi-trash"></i>
                <span> Delete @(string.IsNullOrWhiteSpace(truncateSelectedUser) ? "All" : "User Logs")</span>
            }
        </button>
    </FooterContent>
</Modal>

<!-- Mobile Bottom Nav -->
<MobileBottomNav Items="@mobileNavItems" ActiveKey="" OnSelect="HandleMobileNavSelect" />

@code {
    private bool isLoading = true;
    private List<RTUB.Core.Entities.AuditLog> auditLogs = new();
    private RTUB.Core.Entities.AuditLog? selectedLog;
    private RTUB.Core.Entities.AuditLog? logToDelete;

    // Announcement broadcast
    private string? announcementMessage;
    private bool isBroadcasting;
    private bool broadcastConfirmed;

    // Filter variables
    private string selectedUser = "";
    private string excludedUser = "";
    private string selectedEntityType = "";
    private string selectedAction = "";
    private string searchTerm = "";
    private bool criticalOnly = false;
    private bool filtersExpanded = true; // Desktop expanded by default

    // Pagination
    private int currentPage = 1;
    private int pageSize = 20;
    private int totalRecords = 0;

    // Stats
    private int criticalCount = 0;

    // Modals
    private enum ModalType { Changes, Delete, Truncate }
    private readonly MultiModalState<ModalType> modals = new();
    private string truncateConfirmationText = "";
    private string truncateSelectedUser = "";
    private bool isTruncating = false;
    private bool isDeleting = false;

    // Export
    private bool isExporting = false;
    private LoginStatisticsButton? loginStatsButton;
    private IReadOnlyList<MobileBottomNav.MobileNavItem> mobileNavItems = new List<MobileBottomNav.MobileNavItem>
    {
        new("action-back", "Voltar", "bi-arrow-left"),
        new("action-logins", "Logins", "bi-box-arrow-in-right"),
        new("action-export", "Export", "bi-download"),
        new("action-truncate", "Truncate", "bi-trash")
    };

    // Available options for dropdowns
    private List<string> availableUsers = new();
    private List<string> availableEntityTypes = new();
    private List<string> availableActions = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDropdownData();
        await LoadAuditLogs();
        isLoading = false;
    }

    private async Task HandleMobileNavSelect(string key)
    {
        switch (key)
        {
            case "action-back": Navigation.NavigateTo("/"); break;
            case "action-logins": if (loginStatsButton != null) await loginStatsButton.OpenAsync(); break;
            case "action-export": await ExportToJson(); break;
            case "action-truncate": ShowTruncateConfirmation(); break;
        }
    }

    private async Task LoadDropdownData()
    {
        availableUsers = (await AuditLogService.GetUserNamesAsync()).ToList();
        availableEntityTypes = (await AuditLogService.GetEntityTypesAsync()).ToList();
        availableActions = (await AuditLogService.GetActionTypesAsync()).ToList();
    }

    private async Task LoadAuditLogs()
    {
        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            auditLogs = (await AuditLogService.SearchChangesAsync(searchTerm, currentPage, pageSize)).ToList();
            totalRecords = auditLogs.Count;
            if (auditLogs.Count == pageSize)
            {
                totalRecords = currentPage * pageSize + 1;
            }
        }
        else
        {
            // Use single call to get both paged data and total count
            var (logs, count) = await AuditLogService.GetPagedWithCountAsync(
                selectedUser,
                excludedUser,
                selectedEntityType,
                selectedAction,
                null, // fromDate removed
                null, // toDate removed
                criticalOnly ? true : null,
                currentPage,
                pageSize);
            
            auditLogs = logs.ToList();
            totalRecords = count;
        }

        auditLogs = auditLogs
            .OrderByDescending(log => log.Timestamp)
            .ToList();

        // Calculate critical count
        criticalCount = auditLogs.Count(log => log.IsCriticalAction);
    }

    private async Task ApplyFilters()
    {
        currentPage = 1;
        await LoadAuditLogs();
    }

    private async Task UpdateSearch(string search)
    {
        searchTerm = search;
        currentPage = 1;
        await LoadAuditLogs();
    }

    private async Task ClearFilters()
    {
        selectedUser = "";
        excludedUser = "";
        selectedEntityType = "";
        selectedAction = "";
        searchTerm = "";
        criticalOnly = false;
        currentPage = 1;
        await LoadAuditLogs();
    }

    private async Task ChangePage(int page)
    {
        currentPage = page;
        await LoadAuditLogs();
    }

    private async Task ChangePageSize(int newPageSize)
    {
        pageSize = newPageSize;
        currentPage = 1;
        await LoadAuditLogs();
    }

    private void ToggleFilters()
    {
        filtersExpanded = !filtersExpanded;
    }

    private void ShowChangesModal(RTUB.Core.Entities.AuditLog log)
    {
        selectedLog = log;
        modals.Open(ModalType.Changes);
    }

    private void ShowDeleteConfirmation(RTUB.Core.Entities.AuditLog log)
    {
        logToDelete = log;
        modals.Open(ModalType.Delete);
    }

    private async Task ConfirmDelete()
    {
        if (logToDelete == null) return;

        isDeleting = true;
        try
        {
            await AuditLogService.DeleteAsync(logToDelete.Id);
            modals.Close(ModalType.Delete);
            logToDelete = null;
            await LoadAuditLogs();
        }
        finally
        {
            isDeleting = false;
        }
    }

    private void ShowTruncateConfirmation()
    {
        modals.Open(ModalType.Truncate);
        truncateConfirmationText = "";
        truncateSelectedUser = "";
    }

    private async Task ConfirmTruncate()
    {
        if (truncateConfirmationText != "DELETE ALL")
            return;

        isTruncating = true;
        try
        {
            if (string.IsNullOrWhiteSpace(truncateSelectedUser))
            {
                // Truncate all logs
                await AuditLogService.TruncateAsync();
            }
            else
            {
                // Truncate logs for specific user
                await AuditLogService.TruncateByUserAsync(truncateSelectedUser);
            }
            
            modals.Close(ModalType.Truncate);
            truncateConfirmationText = "";
            truncateSelectedUser = "";
            currentPage = 1;
            await LoadAuditLogs();
            await LoadDropdownData();
        }
        finally
        {
            isTruncating = false;
        }
    }

    private async Task ExportToJson()
    {
        isExporting = true;
        try
        {
            var logsToExport = await AuditLogService.GetAllForExportAsync(
                selectedUser,
                excludedUser,
                selectedEntityType,
                selectedAction,
                null, // fromDate removed
                null, // toDate removed
                criticalOnly ? true : null);

            var json = JsonSerializer.Serialize(logsToExport, new JsonSerializerOptions 
            { 
                WriteIndented = true 
            });

            var fileName = $"tracing-export-{DateTime.UtcNow:yyyy-MM-dd-HHmmss}.json";
            var bytes = System.Text.Encoding.UTF8.GetBytes(json);
            var base64 = Convert.ToBase64String(bytes);

            try
            {
                await JSRuntime.InvokeVoidAsync("downloadFile", fileName, base64, "application/json");
            }
            catch (TaskCanceledException) { /* User navigated away - benign */ }
            catch (Microsoft.JSInterop.JSDisconnectedException) { /* Circuit disconnected - benign */ }
        }
        finally
        {
            isExporting = false;
        }
    }

    private string GetActionBadgeClass(string action)
    {
        return action switch
        {
            "Created" => "bg-success",
            "Modified" => "bg-warning text-dark",
            "Deleted" => "bg-danger",
            "Role Added" => "bg-primary",
            "Role Removed" => "bg-danger",
            _ => "bg-info"
        };
    }
    
    private string FormatChanges(string? changes)
    {
        if (string.IsNullOrEmpty(changes))
            return "No changes recorded";

        try
        {
            var formatted = JsonSerializer.Serialize(
                JsonSerializer.Deserialize<object>(changes),
                new JsonSerializerOptions { WriteIndented = true }
            );
            return formatted;
        }
        catch (JsonException ex)
        {
            System.Diagnostics.Debug.WriteLine($"Failed to format JSON changes: {ex.Message}");
            return changes;
        }
    }

    private async Task BroadcastAnnouncement()
    {
        if (string.IsNullOrWhiteSpace(announcementMessage)) return;
        isBroadcasting = true;
        broadcastConfirmed = false;
        try
        {
            await AnnouncementService.BroadcastAsync(announcementMessage.Trim());
            broadcastConfirmed = true;
            announcementMessage = null;
        }
        finally
        {
            isBroadcasting = false;
        }
    }
}
