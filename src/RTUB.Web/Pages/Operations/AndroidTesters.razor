@page "/owner/testers"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using RTUB.Application.Data
@using RTUB.Application.Helpers
@using RTUB.Application.Interfaces
@using RTUB.Application.DTOs
@using RTUB.Application.Extensions
@using RTUB.Application.Configuration
@using RTUB.Core.Helpers
@using RTUB.Shared
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext DbContext
@inject IPushNotificationService PushNotificationService
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@attribute [Authorize(Roles = "Owner")]

<PageTitle>Android Testers</PageTitle>

<div class="container-fluid android-testers-page">
    <div class="page-header">
        <div class="page-header-content">
            <div class="page-header-title">
                <h1 class="page-title"><i class="bi bi-phone"></i> Android Testers</h1>
                <p class="lead page-header-subtitle text-light-theme">Manage Android app testers and track login activity</p>
            </div>
            <div class="page-header-actions">
                <button class="btn btn-success" @onclick="RefreshData" disabled="@isLoading">
                    <i class="bi bi-arrow-clockwise"></i> <span class="btn-text">Refresh</span>
                </button>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <Alert Type="Alert.AlertType.Error" 
               Message="@errorMessage" 
               Dismissible="true"
               OnDismiss="@(() => errorMessage = string.Empty)" />
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <Alert Type="Alert.AlertType.Success" 
               Message="@successMessage" 
               Dismissible="true"
               OnDismiss="@(() => successMessage = string.Empty)" />
    }

    @if (isLoading)
    {
        <LoadingSpinner />
    }
    else
    {
        <!-- Android Testers Management Section -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-people"></i> Manage Android Testers</h5>
            </div>
            <div class="card-body">
                <!-- Selected testers as chips -->
                @if (selectedAndroidTesters.Any())
                {
                    <div class="selected-members-chips mb-3">
                        @foreach (var user in selectedAndroidTesters.OrderBy(u => u.GetDisplayName()))
                        {
                            <span class="member-chip" title="@($"{user.FirstName} {user.LastName}")">
                                <img src="@user.ProfilePictureSrc" alt="@user.GetDisplayName()" class="member-chip-avatar" />
                                <span class="member-chip-name">@user.GetDisplayName()</span>
                                <button type="button" class="member-chip-remove" @onclick="() => RemoveAndroidTester(user)" title="Remove tester access" aria-label="Remove @user.GetDisplayName()">
                                    <i class="bi bi-x"></i>
                                </button>
                            </span>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted mb-3">No Android testers configured. Search and click to add users.</p>
                }

                <!-- Search for users to add -->
                <SearchBar @bind-Value="testerSearchTerm"
                           Placeholder="Search by name or username to add as tester..."
                           OnSearch="@HandleTesterSearchChanged"
                           Compact="true" />

                @if (!string.IsNullOrWhiteSpace(testerSearchTerm) && filteredAvailableUsers.Any())
                {
                    <div class="member-list member-list-scrollable mt-2">
                        @foreach (var user in filteredAvailableUsers)
                        {
                            <div class="member-item p-2 mb-2 border rounded clickable-row"
                                 @onclick="() => AddAndroidTester(user)"
                                 tabindex="0"
                                 @onkeydown="@((e) => HandleMemberItemKeyDown(e, user))">
                                <div class="d-flex align-items-center">
                                    <img src="@user.ProfilePictureSrc" alt="@user.GetDisplayName()"
                                         class="member-avatar-small me-2" />
                                    <div>
                                        <strong>@user.GetDisplayName()</strong>
                                        <div class="text-muted small">@user.UserName</div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(testerSearchTerm))
                {
                    <p class="text-muted mt-2 small">No users found.</p>
                }
            </div>
        </div>

        <!-- Custom Notification Section -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-bell"></i> Send Custom Notification</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Custom Message</label>
                    <textarea class="form-control" 
                              rows="3" 
                              @bind="customMessage" 
                              placeholder="Enter the message to send to Android testers..."
                              maxlength="@MaxMessageLength"></textarea>
                    <div class="form-text">Maximum @MaxMessageLength characters</div>
                </div>
                <button class="btn btn-primary" 
                        @onclick="SendNotification" 
                        disabled="@(isSending || string.IsNullOrWhiteSpace(customMessage) || !androidTesters.Any())"
                        aria-label="Send push notification">
                    @if (isSending)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>Sending...</span>
                    }
                    else
                    {
                        <i class="bi bi-bell"></i>
                        <span>Send Notification</span>
                    }
                </button>
            </div>
        </div>

        <!-- Login Activity Card -->
        <div class="card">
            <div class="card-header d-flex flex-column flex-lg-row gap-2 align-items-lg-center justify-content-between">
                <h5 class="mb-0"><i class="bi bi-clock-history"></i> Android Testers - Login Activity (@campaignStartDate.ToString("dd/MM") to @campaignEndDate.ToString("dd/MM"))</h5>
            </div>
            <div class="card-body">
                @if (androidTesters.Any())
                {
                    <!-- Filter controls -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <SearchBar @bind-Value="searchTerm"
                                       Placeholder="Search by name or username..."
                                       OnSearch="@HandleSearchChanged" />
                        </div>
                    </div>

                    @if (!filteredTesters.Any())
                    {
                        <EmptyState
                            Title="No testers found."
                            Icon="bi-search" />
                    }
                    else
                    {
                        <!-- Stats Row -->
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <div class="card bg-primary text-white">
                                    <div class="card-body">
                                        <h6 class="card-title">Total Android Testers</h6>
                                        <h3 class="mb-0">@androidTesters.Count</h3>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card bg-success text-white">
                                    <div class="card-body">
                                        <h6 class="card-title">Active Today (Android)</h6>
                                        <h3 class="mb-0">@GetActiveAndroidTodayCount()</h3>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Tester Cards Grid -->
                        <div class="avatar-card-grid">
                            @foreach (var tester in paginatedTesters)
                            {
                                <AndroidTesterCard AvatarUrl="@tester.AvatarUrl"
                                                   AltText="@tester.DisplayNickname"
                                                   TunaName="@tester.DisplayNickname"
                                                   FullName="@tester.DisplayFullName"
                                                   LoginCount="@tester.LoginDays.Count"
                                                   TotalDays="@totalCampaignDays"
                                                   LastLoginDate="@tester.LastLoginDate"
                                                   LoginDays="@tester.LoginDays"
                                                   LastUserAgent="@tester.LastUserAgent"
                                                   AndroidLoginCount="@tester.AndroidLoginCount"
                                                   AndroidLoginToday="@tester.AndroidLoginToday"
                                                   OnViewDetails="@(() => OpenDetailsModal(tester))" />
                            }
                        </div>

                        <!-- Pagination -->
                        <TablePagination CurrentPage="@paginationHelper.CurrentPage"
                                         PageSize="@paginationHelper.PageSize"
                                         TotalItems="@filteredTesters.Count"
                                         ItemLabel="testers"
                                         PageSizeOptions="@(new[] { 12, 24, 36, 48, 60 })"
                                         OnPageChanged="@HandlePageChange"
                                         OnPageSizeChanged="@HandlePageSizeChange" />
                    }
                }
                else
                {
                    <EmptyState
                        Title="No Android testers found."
                        Icon="bi-info-circle" />
                }
            </div>
        </div>
    }
</div>

<!-- View Details Modal -->
<Modal Show="@showDetailsModal"
       ShowChanged="@((bool show) => { if (!show) showDetailsModal = false; })"
       Title="@($"Login Activity - {selectedTesterForDetails?.DisplayNickname}")" 
       Size="Modal.ModalSize.Large"
       Centered="true">
    <BodyContent>
        @if (selectedTesterForDetails != null)
        {
            <div class="d-flex align-items-center gap-3 mb-3">
                <img src="@selectedTesterForDetails.AvatarUrl" alt="@selectedTesterForDetails.DisplayNickname" 
                     class="rounded-circle" style="width: 48px; height: 48px; object-fit: cover;" />
                <div>
                    <strong>@selectedTesterForDetails.DisplayNickname</strong>
                    <div class="text-muted small">@selectedTesterForDetails.DisplayFullName</div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-sm table-bordered mb-0">
                    <thead>
                        <tr>
                            <th style="width: 60px;">Day</th>
                            <th style="width: 120px;">Date</th>
                            <th>User-Agent</th>
                            <th style="width: 80px; text-align: center;">Login</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < totalCampaignDays; i++)
                        {
                            var dayDate = detailsWindowStart.AddDays(i);
                            var today = DateTime.UtcNow.Date;
                            var isCurrentDay = dayDate == today;
                            var isFutureDay = dayDate > today;
                            var loginRecords = selectedTesterLoginRecords?.Where(l => l.LoginDate == dayDate).ToList() ?? new();
                            var dayNumber = i + 1;

                            <tr class="@(isCurrentDay ? "table-active fw-semibold" : "")">
                                <td>Day @dayNumber.ToString("00")</td>
                                <td>
                                    @dayDate.ToString("dd/MM/yyyy")
                                    @if (isCurrentDay)
                                    {
                                        <span class="badge bg-purple ms-1">TODAY</span>
                                    }
                                </td>
                                <td class="text-truncate" style="max-width: 300px;" title="@(string.Join(", ", loginRecords.Where(l => !string.IsNullOrWhiteSpace(l.UserAgent)).Select(l => l.UserAgent!).Distinct()))">
                                    @if (isFutureDay)
                                    {
                                        <span class="text-muted fst-italic">—</span>
                                    }
                                    else if (loginRecords.Any(l => !string.IsNullOrWhiteSpace(l.UserAgent)))
                                    {
                                        var distinctAgents = loginRecords
                                            .Where(l => !string.IsNullOrWhiteSpace(l.UserAgent))
                                            .Select(l => new { Label = GetShortUserAgent(l.UserAgent), IsAndroid = UserAgentHelper.IsAndroid(l.UserAgent) })
                                            .DistinctBy(a => a.Label)
                                            .ToList();
                                        @foreach (var agent in distinctAgents)
                                        {
                                            if (agent.IsAndroid)
                                            {
                                                <span class="badge bg-success me-1">@agent.Label</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger me-1"><i class="bi bi-x"></i> @agent.Label</span>
                                            }
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (isFutureDay)
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                    else if (loginRecords.Any())
                                    {
                                        <i class="bi bi-check-circle-fill text-success"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-x-circle-fill text-danger"></i>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </BodyContent>
    <FooterContent>
        <button class="btn btn-secondary" @onclick="() => showDetailsModal = false">Close</button>
    </FooterContent>
</Modal>

@code {
    // Constants
    private const string NotificationTitle = "RTUB - Android Testers";
    private const string NotificationTag = "android-testers-notification";
    private const int MaxMessageLength = 500;
    
    // Campaign dates from appsettings
    private DateTime campaignStartDate;
    private DateTime campaignEndDate;
    private int totalCampaignDays;
    
    private bool isLoading = true;
    private List<TesterLoginInfo> androidTesters = new();
    private List<TesterLoginInfo> filteredTesters = new();
    private List<TesterLoginInfo> paginatedTesters = new();
    private Dictionary<string, List<DateTime>> loginsByUser = new();
    private Dictionary<string, List<AndroidTesterLogin>> loginRecordsByUser = new();
    private string searchTerm = string.Empty;
    private PaginationHelper<TesterLoginInfo> paginationHelper = new() { PageSize = 24 };
    
    // Details modal state
    private bool showDetailsModal = false;
    private TesterLoginInfo? selectedTesterForDetails;
    private List<AndroidTesterLogin>? selectedTesterLoginRecords;
    private DateTime detailsWindowStart;
    
    // Tester management fields
    private List<ApplicationUser> selectedAndroidTesters = new();
    private List<ApplicationUser> allUsers = new();
    private List<ApplicationUser> filteredAvailableUsers = new();
    private string testerSearchTerm = string.Empty;
    
    // Notification fields
    private string customMessage = string.Empty;
    private bool isSending = false;
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            // Load campaign dates from appsettings
            var options = new AndroidTesterNotificationOptions();
            Configuration.GetSection(AndroidTesterNotificationOptions.SectionName).Bind(options);
            campaignStartDate = options.StartDate?.Date ?? DateTime.UtcNow.Date.AddDays(-13);
            campaignEndDate = options.EndDate?.Date ?? DateTime.UtcNow.Date;
            totalCampaignDays = (int)(campaignEndDate - campaignStartDate).TotalDays + 1;
            
            var cutoffDate = campaignStartDate;
            
            // Load all users for management section
            allUsers = await UserManager.Users
                .AsNoTracking()
                .OrderBy(u => u.FirstName)
                .ThenBy(u => u.LastName)
                .ToListAsync();
            
            // Load Android testers
            var testers = await UserManager.Users
                .AsNoTracking()
                .Where(u => u.IsAndroidTester)
                .ToListAsync();
            
            selectedAndroidTesters = testers.ToList();

            // Load login records for the campaign period
            var logins = await DbContext.AndroidTesterLogins
                .AsNoTracking()
                .Where(l => l.LoginDate >= cutoffDate && l.LoginDate <= campaignEndDate)
                .OrderByDescending(l => l.LoginDate)
                .ToListAsync();

            // Group logins by user (distinct dates only — one login per day regardless of user agent)
            loginsByUser = logins
                .GroupBy(l => l.UserId)
                .ToDictionary(g => g.Key, g => g.Select(l => l.LoginDate.Date).Distinct().ToList());

            // Keep full login records grouped by user (for details modal)
            loginRecordsByUser = logins
                .GroupBy(l => l.UserId)
                .ToDictionary(g => g.Key, g => g.ToList());

            // Get the latest user-agent per user (most recent login with a user-agent)
            var latestUserAgentByUser = logins
                .Where(l => !string.IsNullOrWhiteSpace(l.UserAgent))
                .GroupBy(l => l.UserId)
                .ToDictionary(g => g.Key, g => g.First().UserAgent);

            // Count distinct days with Android user-agent per user
            var androidLoginCountByUser = logins
                .Where(l => UserAgentHelper.IsAndroid(l.UserAgent))
                .GroupBy(l => l.UserId)
                .ToDictionary(g => g.Key, g => g.Select(l => l.LoginDate.Date).Distinct().Count());

            androidTesters = testers
                .Select(u => new TesterLoginInfo
                {
                    UserId = u.Id,
                    UserName = u.UserName ?? string.Empty,
                    Nickname = u.Nickname ?? string.Empty,
                    FirstName = u.FirstName ?? string.Empty,
                    LastName = u.LastName ?? string.Empty,
                    AvatarUrl = u.ProfilePictureSrc,
                    LoginDays = loginsByUser.ContainsKey(u.Id) ? loginsByUser[u.Id] : new List<DateTime>(),
                    LastLoginDate = u.LastLoginDate,
                    LastUserAgent = latestUserAgentByUser.TryGetValue(u.Id, out var ua) ? ua : null,
                    AndroidLoginCount = androidLoginCountByUser.TryGetValue(u.Id, out var count) ? count : 0,
                    AndroidLoginToday = loginRecordsByUser.TryGetValue(u.Id, out var todayRecords) 
                        && todayRecords.Any(r => r.LoginDate.Date == DateTime.UtcNow.Date && UserAgentHelper.IsAndroid(r.UserAgent))
                })
                .OrderByDescending(t => t.LoginDays.Count)
                .ThenBy(t => t.DisplayNickname)
                .ToList();

            FilterAndPaginate();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading data: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RefreshData()
    {
        await LoadData();
        successMessage = "Data refreshed successfully.";
    }

    private void FilterAndPaginate()
    {
        var baseList = androidTesters.ToList();
        
        // Apply search filter
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            filteredTesters = baseList;
        }
        else
        {
            var search = searchTerm.ToLower();
            filteredTesters = baseList
                .Where(t => t.SearchText.Contains(search))
                .ToList();
        }
        
        paginationHelper.Reset();
        paginatedTesters = paginationHelper.GetPageData(filteredTesters);
    }

    private Task HandleSearchChanged(string value)
    {
        searchTerm = value;
        FilterAndPaginate();
        return Task.CompletedTask;
    }

    private Task HandlePageChange(int newPage)
    {
        paginationHelper.GoToPage(newPage);
        paginatedTesters = paginationHelper.GetPageData(filteredTesters);
        return Task.CompletedTask;
    }

    private Task HandlePageSizeChange(int newPageSize)
    {
        paginationHelper.PageSize = newPageSize;
        paginationHelper.Reset();
        paginatedTesters = paginationHelper.GetPageData(filteredTesters);
        return Task.CompletedTask;
    }

    private async Task SendNotification()
    {
        if (string.IsNullOrWhiteSpace(customMessage))
        {
            errorMessage = "Please enter a message.";
            return;
        }

        if (!androidTesters.Any())
        {
            errorMessage = "No Android testers to notify.";
            return;
        }

        isSending = true;
        errorMessage = null;
        successMessage = null;
        StateHasChanged();

        try
        {
            // Get base URL for notification
            var baseUri = Navigation.BaseUri.TrimEnd('/');

            // Create notification DTO
            var notification = new SendPushNotificationDto
            {
                Title = NotificationTitle,
                Body = customMessage.Trim(),
                Icon = "/images/logo-512x512.png",
                Url = $"{baseUri}/",
                Tag = NotificationTag
            };

            // Get all Android tester user IDs
            var testerIds = androidTesters.Select(t => t.UserId).ToList();

            // Send notification to all Android testers
            await PushNotificationService.SendToSelectedUsersAsync(testerIds, notification);

            successMessage = $"Notification sent successfully to {testerIds.Count} Android tester(s)!";
            customMessage = string.Empty;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error sending notification: {ex.Message}";
        }
        finally
        {
            isSending = false;
            StateHasChanged();
        }
    }

    private string GetLoginText(TesterLoginInfo tester)
    {
        var loginCount = tester.LoginDays.Count;
        
        if (loginCount == 0)
            return $"0/{totalCampaignDays} logins";
        
        var lastLogin = tester.LoginDays.First(); // Already ordered by date descending
        var daysAgo = (DateTime.UtcNow.Date - lastLogin).Days;
        
        string daysText;
        if (daysAgo == 0)
            daysText = "Today";
        else if (daysAgo == 1)
            daysText = "Yesterday";
        else
            daysText = $"{daysAgo} days ago";
        
        return $"{loginCount}/{totalCampaignDays} logins - Last: {daysText}";
    }

    // Tester management methods
    private Task HandleTesterSearchChanged(string value)
    {
        testerSearchTerm = value;
        FilterAvailableUsers();
        return Task.CompletedTask;
    }

    private void FilterAvailableUsers()
    {
        if (string.IsNullOrWhiteSpace(testerSearchTerm))
        {
            filteredAvailableUsers = new List<ApplicationUser>();
            return;
        }

        var search = testerSearchTerm.ToLower();
        var selectedIds = selectedAndroidTesters.Select(u => u.Id).ToHashSet();

        filteredAvailableUsers = allUsers
            .Where(u => !selectedIds.Contains(u.Id))
            .Where(u =>
                (u.FirstName != null && u.FirstName.ToLower().Contains(search)) ||
                (u.LastName != null && u.LastName.ToLower().Contains(search)) ||
                (u.Nickname != null && u.Nickname.ToLower().Contains(search)) ||
                (u.UserName != null && u.UserName.ToLower().Contains(search)))
            .Take(10)
            .ToList();
    }

    private async Task AddAndroidTester(ApplicationUser user)
    {
        try
        {
            var userToUpdate = await UserManager.FindByIdAsync(user.Id);
            if (userToUpdate != null)
            {
                userToUpdate.IsAndroidTester = true;
                var result = await UserManager.UpdateAsync(userToUpdate);
                
                if (result.Succeeded)
                {
                    selectedAndroidTesters.Add(user);
                    selectedAndroidTesters = selectedAndroidTesters.OrderBy(u => u.GetDisplayName()).ToList();
                    testerSearchTerm = string.Empty;
                    filteredAvailableUsers.Clear();
                    successMessage = $"{user.GetDisplayName()} added as Android tester.";
                    await LoadData(); // Reload to update stats
                }
                else
                {
                    errorMessage = $"Failed to add {user.GetDisplayName()}: {string.Join(", ", result.Errors.Select(e => e.Description))}";
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error adding tester: {ex.Message}";
        }
    }

    private async Task RemoveAndroidTester(ApplicationUser user)
    {
        try
        {
            var userToUpdate = await UserManager.FindByIdAsync(user.Id);
            if (userToUpdate != null)
            {
                userToUpdate.IsAndroidTester = false;
                var result = await UserManager.UpdateAsync(userToUpdate);
                
                if (result.Succeeded)
                {
                    selectedAndroidTesters.Remove(user);
                    successMessage = $"{user.GetDisplayName()} removed from Android testers.";
                    await LoadData(); // Reload to update stats
                }
                else
                {
                    errorMessage = $"Failed to remove {user.GetDisplayName()}: {string.Join(", ", result.Errors.Select(e => e.Description))}";
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error removing tester: {ex.Message}";
        }
    }

    private async Task HandleMemberItemKeyDown(KeyboardEventArgs e, ApplicationUser user)
    {
        if (e.Key == "Enter" || e.Key == " ")
        {
            await AddAndroidTester(user);
        }
    }

    private void OpenDetailsModal(TesterLoginInfo tester)
    {
        selectedTesterForDetails = tester;
        detailsWindowStart = campaignStartDate;
        selectedTesterLoginRecords = loginRecordsByUser.TryGetValue(tester.UserId, out var records) 
            ? records 
            : new List<AndroidTesterLogin>();
        showDetailsModal = true;
    }

    private static string GetShortUserAgent(string? userAgent)
        => UserAgentHelper.GetShortUserAgent(userAgent);

    /// <summary>
    /// Counts testers who logged in today with an Android user agent.
    /// </summary>
    private int GetActiveAndroidTodayCount()
    {
        var today = DateTime.UtcNow.Date;
        return androidTesters.Count(t =>
            loginRecordsByUser.TryGetValue(t.UserId, out var records) &&
            records.Any(r => r.LoginDate.Date == today && UserAgentHelper.IsAndroid(r.UserAgent)));
    }

    private class TesterLoginInfo
    {
        public string UserId { get; set; } = string.Empty;
        public string UserName { get; set; } = string.Empty;
        public string Nickname { get; set; } = string.Empty;
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string AvatarUrl { get; set; } = string.Empty;
        public List<DateTime> LoginDays { get; set; } = new();
        public DateTime? LastLoginDate { get; set; }
        public string? LastUserAgent { get; set; }
        public int AndroidLoginCount { get; set; }
        public bool AndroidLoginToday { get; set; }

        public string DisplayNickname => !string.IsNullOrWhiteSpace(Nickname) ? Nickname : UserName;

        public string DisplayFullName
        {
            get
            {
                var fullName = $"{FirstName} {LastName}".Trim();
                return string.IsNullOrWhiteSpace(fullName) ? DisplayNickname : fullName;
            }
        }

        public string SearchText => $"{DisplayNickname} {DisplayFullName} {UserName}".ToLower();
    }
}
