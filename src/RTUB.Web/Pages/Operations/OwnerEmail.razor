@page "/emails"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using RTUB.Application.DTOs
@using RTUB.Application.Interfaces
@using RTUB.Core.Entities
@using RTUB.Shared
@attribute [Authorize(Roles = "Admin,Owner")]
@inject UserManager<ApplicationUser> UserManager
@inject IEmailNotificationService EmailNotificationService

<PageTitle>Enviar Email de Anúncio</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-md-12">
            <h1 class="page-title"><i class="bi bi-envelope"></i> Enviar Email de Anúncio</h1>
            <p class="lead page-header-subtitle mb-4 text-light-theme">Enviar anúncios por email para todos os utilizadores subscritos</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <Alert Type="@(isError ? Alert.AlertType.Error : Alert.AlertType.Success)" 
               Message="@message" 
               Dismissible="true"
               OnDismiss="@(() => message = string.Empty)" />
    }

    @if (isLoadingSubscribers)
    {
        <LoadingSpinner Message="A carregar destinatários..." />
    }
    else
    {
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-pencil-square"></i> Compor Mensagem</h5>
            </div>
            <div class="card-body">
                <form>
                    <div class="mb-3">
                        <label for="emailTitle" class="form-label">
                            Título <span class="text-danger">*</span>
                        </label>
                        <input type="text" 
                               class="form-control @(titleError ? "is-invalid" : "")" 
                               id="emailTitle" 
                               @bind="title" 
                               placeholder="Ex: Nova Atuação Agendada"
                               maxlength="200"
                               required />
                        @if (titleError)
                        {
                            <div class="invalid-feedback">O título é obrigatório</div>
                        }
                        <small class="form-text text-muted">
                            Será usado como assunto do email: [RTUB] {título}
                        </small>
                    </div>

                    <div class="mb-3">
                        <label for="emailContent" class="form-label">
                            Conteúdo <span class="text-danger">*</span>
                        </label>
                        <textarea class="form-control @(contentError ? "is-invalid" : "")" 
                                  id="emailContent" 
                                  @bind="content" 
                                  rows="8"
                                  placeholder="Escreva a mensagem do anúncio aqui..."
                                  maxlength="5000"
                                  required></textarea>
                        @if (contentError)
                        {
                            <div class="invalid-feedback">O conteúdo é obrigatório</div>
                        }
                        <small class="form-text text-muted">
                            Esta mensagem será enviada para @subscribedUsersCount utilizadores subscritos
                        </small>
                    </div>

                    <div class="alert alert-purple">
                        <i class="bi bi-info-circle"></i>
                        <strong>Informação:</strong> Este email será enviado para todos os utilizadores com notificações ativas.
                    </div>

                    <!-- Progress Display -->
                    @if (isSending)
                    {
                        <div class="alert alert-purple">
                            <div class="d-flex align-items-center">
                                <div class="spinner-border spinner-border-sm me-2" role="status">
                                    <span class="visually-hidden">A enviar...</span>
                                </div>
                                <strong>Enviando emails: @EmailsSent/@EmailsTotal</strong>
                                @if (!string.IsNullOrEmpty(LastRecipient))
                                {
                                    <span class="ms-2">(último: @LastRecipient)</span>
                                }
                            </div>
                        </div>
                    }

                    <div class="d-flex gap-2">
                        <button type="button" 
                                class="btn btn-purple" 
                                @onclick="ShowPreview"
                                disabled="@(isSending || string.IsNullOrWhiteSpace(title) || string.IsNullOrWhiteSpace(content))">
                            <i class="bi bi-eye"></i> Pré-visualizar
                        </button>
                        <button type="button" 
                                class="btn btn-purple" 
                                @onclick="SendEmails"
                                disabled="@(isSending || string.IsNullOrWhiteSpace(title) || string.IsNullOrWhiteSpace(content))">
                            @if (isSending)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                                <span>A enviar...</span>
                            }
                            else
                            {
                                <i class="bi bi-send"></i>
                                <span> Enviar</span>
                            }
                        </button>
                        <button type="button" 
                                class="btn btn-light" 
                                @onclick="ClearForm"
                                disabled="@isSending">
                            <i class="bi bi-x-circle"></i> Limpar
                        </button>
                    </div>
                </form>
            </div>
        </div>


        @if (subscribedUsers.Any() || nonSubscribedUsers.Any())
        {
            <div class="card mt-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-people"></i> Lista de Destinatários</h5>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(recipientsMessage))
                    {
                        <Alert Type="@(isRecipientsError || isRecipientsRemoval ? Alert.AlertType.Error : Alert.AlertType.Success)" 
                               Message="@recipientsMessage" 
                               Dismissible="true"
                               OnDismiss="@(() => recipientsMessage = string.Empty)" />
                    }
                    <EmailRecipientsPreview 
                        SubscribedUsers="@subscribedUsers"
                        NonSubscribedUsers="@nonSubscribedUsers"
                        SubscribedUsersTitle="@($"Destinatários ({subscribedUsersCount})")"
                        NonSubscribedUsersTitle="@($"Quem não irá receber ({nonSubscribedUsersCount})")"
                        ShowNonSubscribedUsers="true"
                        ShowProfilePicture="true"
                        ShowEmail="false"
                        MaxHeight="400px"
                        UsePagination="true"
                        PageSize="25"
                        PageSizeOptions="@(new[] { 10, 25, 50, 100 })"
                        OnRemoveUser="@RemoveUser"
                        OnAddUser="@AddUser"
                        OnRemoveMultipleUsers="@RemoveMultipleUsers"
                        OnAddMultipleUsers="@AddMultipleUsers"
                        IsProcessingBulkRemove="@isProcessingBulkRemove"
                        IsProcessingBulkAdd="@isProcessingBulkAdd" />
                </div>
            </div>
        }
    }
</div>

<!-- Preview Modal -->
<Modal Show="@showPreviewModal" 
       ShowChanged="@((show) => showPreviewModal = show)"
       Title="Pré-visualização do Email"
       Size="Modal.ModalSize.Large">
    <BodyContent>
        <div class="email-preview" style="background-color: #F7F7FB; padding: 20px; border-radius: 8px;">
            <div style="background-color: white; max-width: 600px; margin: 0 auto; padding: 32px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                <h2 style="margin: 0 0 16px 0; font-size: 28px; font-weight: 600; color: #0B0B0F;">
                    @title
                </h2>
                
                <p style="margin: 0 0 16px 0; font-size: 16px; color: #333333;">
                    Olá [Nome do Utilizador]
                </p>
                
                <div style="margin: 24px 0; padding: 20px; background-color: #F7F7FB; border-left: 4px solid #6E56CF; border-radius: 8px;">
                    <p style="margin: 0; font-size: 16px; color: #333333; white-space: pre-wrap;">@content</p>
                </div>
                
                <p style="margin: 16px 0 0 0; font-size: 16px; color: #333333;">
                    Saudações RTUBianas.
                </p>
            </div>
        </div>
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="() => showPreviewModal = false">Fechar</button>
    </FooterContent>
</Modal>

@code {
    private string title = "";
    private string content = "";
    private string message = ""; // For email form messages
    private string recipientsMessage = ""; // For recipients list messages
    private bool isError = false;
    private bool isRecipientsError = false;
    private bool isRecipientsRemoval = false; // Track if message is for removal (show as red)
    private bool isSending = false;
    private bool isLoadingSubscribers = true;
    private bool showPreviewModal = false;
    private bool titleError = false;
    private bool contentError = false;
    private bool isProcessingBulkRemove = false;
    private bool isProcessingBulkAdd = false;

    // Email sending progress variables
    private int EmailsTotal = 0;
    private int EmailsSent = 0;
    private string? LastRecipient = null;

    private List<ApplicationUser> subscribedUsers = new();
    private List<ApplicationUser> nonSubscribedUsers = new();
    private int subscribedUsersCount = 0;
    private int nonSubscribedUsersCount = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadSubscribedUsers();
    }

    private async Task LoadSubscribedUsers()
    {
        isLoadingSubscribers = true;
        try
        {
            // Load all subscribed users with confirmed emails
            subscribedUsers = await UserManager.Users
                .Where(u => u.Subscribed && u.EmailConfirmed && !string.IsNullOrEmpty(u.Email))
                .OrderBy(u => u.Nickname ?? u.FirstName)
                .AsNoTracking()
                .ToListAsync();
            
            // Load all non-subscribed users with confirmed emails
            nonSubscribedUsers = await UserManager.Users
                .Where(u => !u.Subscribed && u.EmailConfirmed && !string.IsNullOrEmpty(u.Email))
                .OrderBy(u => u.Nickname ?? u.FirstName)
                .AsNoTracking()
                .ToListAsync();
            
            subscribedUsersCount = subscribedUsers.Count;
            nonSubscribedUsersCount = nonSubscribedUsers.Count;
        }
        catch (Exception ex)
        {
            message = $"Erro ao carregar utilizadores subscritos: {ex.Message}";
            isError = true;
        }
        finally
        {
            isLoadingSubscribers = false;
        }
    }

    private void ShowPreview()
    {
        if (string.IsNullOrWhiteSpace(title) || string.IsNullOrWhiteSpace(content))
        {
            return;
        }
        showPreviewModal = true;
    }

    private async Task SendEmails()
    {
        // Reset validation errors
        titleError = false;
        contentError = false;

        // Validate inputs
        if (string.IsNullOrWhiteSpace(title))
        {
            titleError = true;
            return;
        }

        if (string.IsNullOrWhiteSpace(content))
        {
            contentError = true;
            return;
        }

        if (!subscribedUsers.Any())
        {
            message = "Não há utilizadores subscritos para enviar o email.";
            isError = true;
            return;
        }

        isSending = true;
        EmailsTotal = subscribedUsers.Count;
        EmailsSent = 0;
        LastRecipient = null;
        message = "";
        StateHasChanged();

        try
        {
            // Prepare recipient emails and data
            var recipientEmails = subscribedUsers
                .Where(u => !string.IsNullOrWhiteSpace(u.Email))
                .Select(u => u.Email!)
                .ToList();

            var recipientData = subscribedUsers
                .Where(u => !string.IsNullOrWhiteSpace(u.Email))
                .ToDictionary(
                    u => u.Email!,
                    u => (u.Nickname ?? u.FirstName ?? "", $"{u.FirstName} {u.LastName}")
                );

            // Create progress reporter
            var progress = new Progress<EmailSendProgress>(update =>
            {
                EmailsTotal = update.Total;
                EmailsSent = update.Sent;
                LastRecipient = update.LastRecipient;
                StateHasChanged();
            });

            // Send emails
            var (success, count, errorMessage) = await EmailNotificationService.SendAnnouncementEmailAsync(
                title,
                content,
                recipientEmails,
                recipientData,
                progress);

            if (success)
            {
                message = $"Foram enviados {count} de {EmailsTotal} emails com sucesso.";
                isError = false;
                ClearForm();
            }
            else
            {
                message = errorMessage ?? "Erro ao enviar emails.";
                isError = true;
            }
        }
        catch (Exception ex)
        {
            message = $"Erro inesperado: {ex.Message}";
            isError = true;
        }
        finally
        {
            isSending = false;
            StateHasChanged();
        }
    }

    private void ClearForm()
    {
        title = "";
        content = "";
        titleError = false;
        contentError = false;
    }

    private async Task RemoveUser(ApplicationUser user)
    {
        try
        {
            // Toggle the Subscribed property to false
            user.Subscribed = false;
            var result = await UserManager.UpdateAsync(user);

            if (result.Succeeded)
            {
                // Move user from subscribed to non-subscribed list
                subscribedUsers.Remove(user);
                nonSubscribedUsers.Add(user);
                
                // Sort non-subscribed list
                nonSubscribedUsers = nonSubscribedUsers.OrderBy(u => u.Nickname ?? u.FirstName).ToList();

                // Update counts
                subscribedUsersCount = subscribedUsers.Count;
                nonSubscribedUsersCount = nonSubscribedUsers.Count;

                recipientsMessage = $"{GetUserDisplayName(user)} removido das notificações.";
                isRecipientsError = false;
                isRecipientsRemoval = true; // Show as red
            }
            else
            {
                recipientsMessage = $"Erro ao remover utilizador: {string.Join(", ", result.Errors.Select(e => e.Description))}";
                isRecipientsError = true;
                isRecipientsRemoval = false;
            }
        }
        catch (Exception ex)
        {
            recipientsMessage = $"Erro inesperado ao remover utilizador: {ex.Message}";
            isRecipientsError = true;
            isRecipientsRemoval = false;
        }
        
        StateHasChanged();
    }

    private async Task AddUser(ApplicationUser user)
    {
        try
        {
            // Toggle the Subscribed property to true
            user.Subscribed = true;
            var result = await UserManager.UpdateAsync(user);

            if (result.Succeeded)
            {
                // Move user from non-subscribed to subscribed list
                nonSubscribedUsers.Remove(user);
                subscribedUsers.Add(user);
                
                // Sort subscribed list
                subscribedUsers = subscribedUsers.OrderBy(u => u.Nickname ?? u.FirstName).ToList();

                // Update counts
                subscribedUsersCount = subscribedUsers.Count;
                nonSubscribedUsersCount = nonSubscribedUsers.Count;

                recipientsMessage = $"{GetUserDisplayName(user)} adicionado às notificações.";
                isRecipientsError = false;
                isRecipientsRemoval = false; // Show as green
            }
            else
            {
                recipientsMessage = $"Erro ao adicionar utilizador: {string.Join(", ", result.Errors.Select(e => e.Description))}";
                isRecipientsError = true;
                isRecipientsRemoval = false;
            }
        }
        catch (Exception ex)
        {
            recipientsMessage = $"Erro inesperado ao adicionar utilizador: {ex.Message}";
            isRecipientsError = true;
            isRecipientsRemoval = false;
        }
        
        StateHasChanged();
    }

    private async Task RemoveMultipleUsers(List<ApplicationUser> users)
    {
        if (users == null || !users.Any())
        {
            return;
        }

        isProcessingBulkRemove = true;
        StateHasChanged();
        await Task.Yield(); // Allow UI to update

        try
        {
            var successCount = 0;
            var errorMessages = new List<string>();

            foreach (var user in users)
            {
                // Toggle the Subscribed property to false
                user.Subscribed = false;
                var result = await UserManager.UpdateAsync(user);

                if (result.Succeeded)
                {
                    // Move user from subscribed to non-subscribed list
                    subscribedUsers.Remove(user);
                    nonSubscribedUsers.Add(user);
                    successCount++;
                }
                else
                {
                    errorMessages.Add($"{GetUserDisplayName(user)}: {string.Join(", ", result.Errors.Select(e => e.Description))}");
                }
            }

            // Sort non-subscribed list
            nonSubscribedUsers = nonSubscribedUsers.OrderBy(u => u.Nickname ?? u.FirstName).ToList();

            // Update counts
            subscribedUsersCount = subscribedUsers.Count;
            nonSubscribedUsersCount = nonSubscribedUsers.Count;

            if (successCount > 0)
            {
                recipientsMessage = $"{successCount} utilizador(es) removido(s) das notificações.";
                isRecipientsError = false;
                isRecipientsRemoval = true; // Show as red
            }

            if (errorMessages.Any())
            {
                var errorMsg = $"Erros ao remover utilizadores: {string.Join("; ", errorMessages)}";
                if (successCount > 0)
                {
                    recipientsMessage += $" {errorMsg}";
                    isRecipientsError = true;
                    isRecipientsRemoval = false;
                }
                else
                {
                    recipientsMessage = errorMsg;
                    isRecipientsError = true;
                    isRecipientsRemoval = false;
                }
            }
        }
        catch (Exception ex)
        {
            recipientsMessage = $"Erro inesperado ao remover utilizadores: {ex.Message}";
            isRecipientsError = true;
            isRecipientsRemoval = false;
        }
        finally
        {
            isProcessingBulkRemove = false;
        }
        
        StateHasChanged();
    }

    private async Task AddMultipleUsers(List<ApplicationUser> users)
    {
        if (users == null || !users.Any())
        {
            return;
        }

        isProcessingBulkAdd = true;
        StateHasChanged();
        await Task.Yield(); // Allow UI to update

        try
        {
            var successCount = 0;
            var errorMessages = new List<string>();

            foreach (var user in users)
            {
                // Toggle the Subscribed property to true
                user.Subscribed = true;
                var result = await UserManager.UpdateAsync(user);

                if (result.Succeeded)
                {
                    // Move user from non-subscribed to subscribed list
                    nonSubscribedUsers.Remove(user);
                    subscribedUsers.Add(user);
                    successCount++;
                }
                else
                {
                    errorMessages.Add($"{GetUserDisplayName(user)}: {string.Join(", ", result.Errors.Select(e => e.Description))}");
                }
            }

            // Sort subscribed list
            subscribedUsers = subscribedUsers.OrderBy(u => u.Nickname ?? u.FirstName).ToList();

            // Update counts
            subscribedUsersCount = subscribedUsers.Count;
            nonSubscribedUsersCount = nonSubscribedUsers.Count;

            if (successCount > 0)
            {
                recipientsMessage = $"{successCount} utilizador(es) adicionado(s) às notificações.";
                isRecipientsError = false;
                isRecipientsRemoval = false; // Show as green
            }

            if (errorMessages.Any())
            {
                var errorMsg = $"Erros ao adicionar utilizadores: {string.Join("; ", errorMessages)}";
                if (successCount > 0)
                {
                    recipientsMessage += $" {errorMsg}";
                    isRecipientsError = true;
                    isRecipientsRemoval = false;
                }
                else
                {
                    recipientsMessage = errorMsg;
                    isRecipientsError = true;
                    isRecipientsRemoval = false;
                }
            }
        }
        catch (Exception ex)
        {
            recipientsMessage = $"Erro inesperado ao adicionar utilizadores: {ex.Message}";
            isRecipientsError = true;
            isRecipientsRemoval = false;
        }
        finally
        {
            isProcessingBulkAdd = false;
        }
        
        StateHasChanged();
    }

    private string GetUserDisplayName(ApplicationUser user)
    {
        return user.Nickname ?? $"{user.FirstName} {user.LastName}";
    }
}
