                    leitoesStatusData[leitaoId] = freshStatus;
                }
                catch (Exception ex)
                {
                    _logger.LogWarning(ex, "Failed to update status for Leitão {UserId}", leitaoId);
                }
            }
        }
        else
        {
            leitoesStatusData.Clear();
        }

        FilterMembers();
    }

