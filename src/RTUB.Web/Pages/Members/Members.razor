    /// Opens the confirmation dialog to make a member active
    /// </summary>
    private void OpenMakeActiveConfirmModal(ApplicationUser member)
    {
        memberToMakeActive = member;
        modals.Open(ModalType.MakeActiveConfirm);
    }
    
    /// <summary>
    /// Closes the make active confirmation dialog
    /// </summary>
    private void CloseMakeActiveConfirmModal()
    {
        modals.Close(ModalType.MakeActiveConfirm);
        memberToMakeActive = null;
    }
    
    /// <summary>
    /// Makes a retired member active by calling the service to set IsRetired=false,
    /// remove MemberStatus records, recalculate status, and set OverrideRetired=true
    /// </summary>
    private async Task MakeActiveAsync()
    {
        if (memberToMakeActive == null || isMakingActive)
        {
            return;
        }
        
        isMakingActive = true;
        StateHasChanged();
        
        try
        {
            var userId = memberToMakeActive.Id;
            
            // Set audit context once for all operations
            await SetAuditContextToCurrentUser();
            
            // Call service to handle all the activation logic (removes DbContext dependency)
            var updatedStatus = await MemberStatusService.ActivateMemberWithOverrideAsync(userId);
            
            // Update local state to reflect the changes immediately
            memberToMakeActive.IsRetired = false;
            
            // Update in the main users list
            var userInList = users?.FirstOrDefault(u => u.Id == userId);
            if (userInList != null)
            {
                userInList.IsRetired = false;
            }
            
            // Update the specific member in the active members list
            // Find the index and replace the entire object to trigger Blazor change detection
            var memberIndex = allActiveMembers.FindIndex(m => m.Member.Id == userId);
            if (memberIndex >= 0)
            {
                // Get the member and update its IsRetired property
                var member = allActiveMembers[memberIndex].Member;
                member.IsRetired = false;
                
                // Replace with new ActiveMemberData object to ensure Blazor change detection
                allActiveMembers[memberIndex] = new ActiveMemberData
                {
                    Member = member,
                    StatusData = updatedStatus
                };
            }
            
            // Reapply filters and pagination to update the display
            ApplyActiveMembersSearch(activeMembersSearchTerm);
            
            // Force a complete UI refresh
            await InvokeAsync(StateHasChanged);
            
            _logger.LogInformation("Member {UserId} ({MemberName}) was manually made active by admin", 
                userId, memberToMakeActive.GetDisplayName());
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error making member {UserId} active", memberToMakeActive?.Id);
        }
        finally
        {
            isMakingActive = false;
            CloseMakeActiveConfirmModal();
            StateHasChanged();
        }
    }
    
