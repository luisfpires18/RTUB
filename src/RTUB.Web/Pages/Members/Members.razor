@page "/members"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using RTUB.Application.Data
@using RTUB.Application.Helpers
@using RTUB.Application.Extensions
@using RTUB.Application.Interfaces
@using RTUB.Application.Configuration
@using RTUB.Application.DTOs
@using RTUB.Shared
@using System.ComponentModel.DataAnnotations
@using Microsoft.Extensions.Options
@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<IdentityRole> RoleManager
@inject IRoleAssignmentService RoleAssignmentService
@inject IEnrollmentService EnrollmentService
@inject IMemberInstrumentService MemberInstrumentService
@inject IEmailNotificationService EmailNotificationService
@inject IUserRoleQueryService UserRoleQueryService
@inject IRetirementStatusService RetirementStatusService
@inject IMemberStatusService MemberStatusService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject RTUB.Application.Services.AuditContext AuditContext
@inject NavigationManager NavigationManager
@inject ILogger<Members> _logger
@inject IOptions<Toggles> Toggles
@attribute [Authorize]

<h1 class="mb-2"><i class="bi bi-people"></i> Membros</h1>
<p class="lead mb-4 text-light-theme">Lista de todos os membros da RTUB.</p>

<!-- Page Header Actions -->
<div class="page-header-actions">
    <AuthorizeView Roles="Admin">
        <Authorized>
            <button class="btn btn-success" @onclick="OpenCreateModal" title="Adicionar Novo Membro">
                <i class="bi bi-plus-lg"></i> Adicionar Membro
            </button>
        </Authorized>
    </AuthorizeView>
    
    <!-- Anniversaries button visible to all members -->
    @if (Toggles.Value.MapEnabled)
    {
        <button class="btn btn-primary btn-primary-purple" @onclick="NavigateToMap" title="Ver Mapa de Membros">
            <i class="bi bi-geo-alt"></i> Ver Mapa de Membros
        </button>
    }

    <button class="btn btn-primary btn-primary-purple" @onclick="OpenAnniversariesModal" title="Ver Aniversários dos Membros">
        <i class="bi bi-cake2"></i> Aniversários
    </button>
</div>

<!-- Search and Controls -->
<div class="d-flex gap-2 mb-3 align-items-center">
    <div style="flex: 2;">
        <SearchBar @bind-Value="searchTerm"
                   Placeholder="Pesquisar membros..."
                   OnSearch="@HandleSearchChanged" />
    </div>
    <div style="flex: 1;">
        <FilterDropdown SelectedValue="@selectedCategoryFilter"
                        SelectedValueChanged="@(value => selectedCategoryFilter = value)"
                        OnChange="@ApplyFilters"
                        AllItemsLabel="Categoria"
                        Items="@(new[] { "Leitao", "Caloiro", "Tuno" })" />
    </div>
    <div style="flex: 1;">
        <FilterDropdown SelectedValue="@selectedInstrumentFilter"
                        SelectedValueChanged="@(value => selectedInstrumentFilter = value)"
                        OnChange="@ApplyFilters"
                        AllItemsLabel="Instrumento"
                        Options="@instrumentFilterOptions" />
    </div>
</div>

@if (users == null)
{
    <!-- Loading skeleton cards -->
    <div class="avatar-card-grid">
        @for (int i = 0; i < 8; i++)
        {
            <div class="avatar-card-skeleton-card">
                <div class="avatar-card-image-wrapper">
                    <div class="avatar-card-skeleton"></div>
                </div>
            </div>
        }
    </div>
}
else if (!filteredUsers.Any())
{
    <EmptyState Title="Nenhum membro criado ainda"
                    Icon="bi-people"
                    Message="Adicione membros para começar." />
}
else
{
    <!-- Regular Members Grid -->
    @if (filteredRegularMembers.Any())
    {
        <h3 class="mb-3">Membros</h3>
        <div class="avatar-card-grid">
            @foreach (var user in paginatedRegularMembers)
            {
                <AvatarCard AvatarUrl="@user.ProfilePictureSrc"
                           TunaName="@user.Nickname"
                           FullName="@($"{user.FirstName} {user.LastName}")"
                           InstrumentText="@(userPrimaryInstruments.ContainsKey(user.Id) ? userPrimaryInstruments[user.Id] : "")"
                           AltText="@user.GetDisplayName()"
                           LastLoginDate="@user.LastLoginDate"
                           OnView="@(async () => await OpenViewDetailsModal(user))"
                           OnEdit="@(() => OpenEditModal(user))"
                           OnDelete="@(() => OpenDeleteModal(user))"
                           ShowEditButton="@isAdmin"
                           ShowDeleteButton="@isOwner"
                           ViewTooltip="Ver Detalhes"
                           EditTooltip="Editar"
                           DeleteTooltip="Eliminar"
                           LazyLoad="true">
                    <BadgeContent>
                        @{
                            // Get current fiscal year position for this user
                            var currentPosition = GetCurrentFiscalYearPosition(user.Id);
                        }
                        <!-- Category badges row -->
                        <div class="avatar-card-badges-row">
                            @foreach (var category in user.Categories.Where(c =>
                                c == MemberCategory.Caloiro || c == MemberCategory.Tuno))
                            {
                                <CategoryBadge Category="category" />
                            }
                        </div>
                        <!-- Role/Position badges row -->
                        @if (currentPosition != null)
                        {
                            <div class="avatar-card-badges-row">
                                <PositionBadge Position="currentPosition.Value" />
                            </div>
                        }
                        @if (!user.Positions.Any() && !user.Categories.Any())
                        {
                            <div class="avatar-card-badges-row">
                                <span class="badge bg-secondary avatar-card-role-badge" 
                                      title="Sem Cargos"
                                      aria-label="Sem Cargos">Sem Cargos</span>
                            </div>
                        }
                    </BadgeContent>
                </AvatarCard>
            }
        </div>

        <TablePagination CurrentPage="@paginationHelper.CurrentPage"
                        PageSize="@paginationHelper.PageSize"
                        TotalItems="@filteredRegularMembers.Count"
                        ItemLabel="membros"
                        PageSizeOptions="@(new[] { 30, 60, 90, 120, 150 })"
                        OnPageChanged="@HandleRegularMembersPageChange"
                        OnPageSizeChanged="@HandleRegularMembersPageSizeChange" />
    }

    <!-- Leitões Grid -->
    @if (filteredLeitoes.Any())
    {
        <hr class="my-5 hr-divider" />
        <h3 class="mb-3">Leitões</h3>
        <div class="avatar-card-grid">
            @foreach (var user in paginatedLeitoes)
            {
                <AvatarCard AvatarUrl="@user.ProfilePictureSrc"
                           TunaName="@user.Nickname"
                           FullName="@($"{user.FirstName} {user.LastName}")"
                           InstrumentText="@(userPrimaryInstruments.ContainsKey(user.Id) ? userPrimaryInstruments[user.Id] : "")"
                           AltText="@user.GetDisplayName()"
                           LastLoginDate="@user.LastLoginDate"
                           OnView="@(async () => await OpenViewDetailsModal(user))"
                           OnEdit="@(() => OpenEditModal(user))"
                           OnDelete="@(() => OpenDeleteModal(user))"
                           OnSetNickname="@(() => OpenSetNicknameModal(user))"
                           ShowEditButton="@(isAdmin)"
                           ShowDeleteButton="@(isAdmin)"
                           ShowSetNicknameButton="@isAdmin"
                           ViewTooltip="Ver Detalhes"
                           EditTooltip="Editar"
                           DeleteTooltip="Eliminar"
                           SetNicknameTooltip="Definir Alcunha"
                           LazyLoad="true">
                    <BadgeContent>
                        <div class="avatar-card-badges-row">
                            <CategoryBadge Category="@MemberCategory.Leitao" />
                        </div>
                    </BadgeContent>
                </AvatarCard>
            }
        </div>

        <TablePagination CurrentPage="@paginationHelperLeitoes.CurrentPage"
                        PageSize="@paginationHelperLeitoes.PageSize"
                        TotalItems="@filteredLeitoes.Count"
                        ItemLabel="leitões"
                        PageSizeOptions="@(new[] { 18, 36, 54, 72, 90 })"
                        OnPageChanged="@HandleLeitoesPageChange"
                        OnPageSizeChanged="@HandleLeitoesPageSizeChange" />
    }
}

<!-- Create/Edit Modal -->
<Modal Show="@showEditModal" 
       ShowChanged="@((bool show) => showEditModal = show)"
       Title="@(isCreateMode ? "Adicionar Novo Membro" : "Editar Membro")" 
       Size="Modal.ModalSize.Large"
       Centered="true">
    <BodyContent>
        <EditForm Model="@editingUser" OnValidSubmit="SaveMember" @ref="memberEditForm">
            <DataAnnotationsValidator />
            <ErrorDisplay />

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-person text-primary me-2"></i>Primeiro Nome <span class="text-danger">*</span>
                    </label>
                    <InputText class="form-control" @bind-Value="editingUser.FirstName" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-person text-primary me-2"></i>Último Nome <span class="text-danger">*</span>
                    </label>
                    <InputText class="form-control" @bind-Value="editingUser.LastName" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-star text-primary me-2"></i>Nome de Tuna<span class="text-danger">*</span>
                    </label>
                    <InputText class="form-control" @bind-Value="editingUser.Nickname" @bind-Value:after="OnNicknameChanged" disabled="@semAlcunha" />
                    @if (semAlcunha)
                    {
                        <small class="form-text text-muted">Campo desativado - reflete automaticamente o email</small>
                    }
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-telephone text-primary me-2"></i>Contacto <span class="text-danger">*</span>
                    </label>
                    <InputText class="form-control" @bind-Value="editingUser.PhoneNumber" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-envelope text-primary me-2"></i>Email <span class="text-danger">*</span>
                    </label>
                    <InputText type="email" class="form-control" @bind-Value="editingUser.Email" @bind-Value:after="OnEmailChanged" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-calendar3 text-primary me-2"></i>Data de Nascimento
                    </label>
                    <InputDate class="form-control" @bind-Value="editingUser.DateOfBirth" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-book text-primary me-2"></i>Curso
                    </label>
                    <InputText class="form-control" @bind-Value="editingUser.Degree" placeholder="Inserir curso..." />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-geo-alt text-primary me-2"></i>Cidade
                    </label>
                    <InputText class="form-control" @bind-Value="editingUser.City" placeholder="Inserir cidade..." />
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <i class="bi bi-tag text-primary me-2"></i>Categoria <span class="text-danger">*</span>
                </label>
                <InputSelect class="form-select" @bind-Value="editingUser.SelectedCategory" @bind-Value:after="OnCategoryChanged">
                    <option value="">Selecionar Categoria</option>
                    <option value="Leitão">Leitão</option>
                    <option value="Caloiro">Caloiro</option>
                    <option value="Tuno">Tuno</option>
                </InputSelect>
            </div>
            @* Sem alcunha checkbox - only show for Leitão category in create mode *@
            @if (editingUser.SelectedCategory == "Leitão" && isCreateMode)
            {
                <div class="mb-3">
                    <div class="rtub-checkbox-wrapper">
                        <div class="form-check">
                            <InputCheckbox class="form-check-input rtub-checkbox-large" id="semAlcunhaCheckbox" @bind-Value="semAlcunha" @bind-Value:after="OnSemAlcunhaChanged" />
                            <label class="form-check-label" for="semAlcunhaCheckbox">
                                Sem alcunha (recém-entrada)
                            </label>
                            <small class="form-text text-muted d-block">
                                Marque esta opção para leitões sem alcunha definida. O email será usado como username.
                            </small>
                        </div>
                    </div>
                </div>
            }
            @* Fundador checkbox - only show for Tuno category *@
            @if (editingUser.SelectedCategory == "Tuno")
            {
                <div class="mb-3">
                    <div class="rtub-checkbox-wrapper">
                        <div class="form-check">
                            <InputCheckbox class="form-check-input rtub-checkbox-large" id="fundadorCheckbox" @bind-Value="isFundador" @bind-Value:after="OnFundadorChanged" />
                            <label class="form-check-label" for="fundadorCheckbox">
                                Fundador
                            </label>
                        </div>
                    </div>
                </div>
            }
            <div class="row">
                @if (showYearLeitao && !isFundador)
                {
                    <div class="col-md-4 mb-3">
                        @{
                            var leitaoComplete = !isCreateMode && IsDatePairComplete(editingUser.YearLeitao, editingUser.MonthLeitao);
                            var leitaoDisabled = leitaoComplete && !CanEditDates;
                        }
                        <MonthYearPicker Label="Entrada a Leitão"
                                         Icon="calendar-plus"
                                         @bind-Year="@editingUser.YearLeitao"
                                         @bind-Month="@editingUser.MonthLeitao"
                                         @bind-Value="LeitaoDate"
                                         Disabled="@leitaoDisabled"
                                         HelpText="@(leitaoDisabled ? "Não podes alterar as datas. Se estão em erro, contacta o Magister." : null)" />
                    </div>
                }

                @if (showYearCaloiro && !isFundador)
                {
                    <div class="col-md-4 mb-3">
                        @{
                            var caloiroComplete = !isCreateMode && IsDatePairComplete(editingUser.YearCaloiro, editingUser.MonthCaloiro);
                            var caloiroDisabled = caloiroComplete && !CanEditDates;
                        }
                        <MonthYearPicker Label="Passagem a Caloiro"
                                         Icon="calendar-event"
                                         @bind-Year="@editingUser.YearCaloiro"
                                         @bind-Month="@editingUser.MonthCaloiro"
                                         @bind-Value="CaloiroDate"
                                         Disabled="@caloiroDisabled"
                                         HelpText="@(caloiroDisabled ? "Não podes alterar as datas. Se estão em erro, contacta o Magister." : null)" />
                    </div>
                }

                @if (showYearTuno && !isFundador)
                {
                    <div class="col-md-4 mb-3">
                        @{
                            var tunoComplete = !isCreateMode && IsDatePairComplete(editingUser.YearTuno, editingUser.MonthTuno);
                            var tunoDisabled = tunoComplete && !CanEditDates;
                        }
                        <MonthYearPicker Label="Passagem a Tuno"
                                         Icon="calendar-check"
                                         @bind-Year="@editingUser.YearTuno"
                                         @bind-Month="@editingUser.MonthTuno"
                                         @bind-Value="TunoDate"
                                         Disabled="@tunoDisabled"
                                         HelpText="@(tunoDisabled ? "Não podes alterar as datas. Se estão em erro, contacta o Magister." : null)" />
                    </div>
                }
            </div>
            
            @* Multiple Instruments Management *@
            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <i class="bi bi-music-note-list text-primary me-2"></i>Instrumentos
                </label>
                
                @* Add Instrument Section *@
                <div class="input-group mb-2">
                    <select class="form-select" @bind-value="selectedInstrumentToAdd" @bind-value:event="onchange">
                        <option value="">Selecionar instrumento...</option>
                        @foreach (var instrument in AllInstrumentTypes.Where(i => !memberInstruments.Any(mi => mi.InstrumentType == i)))
                        {
                            <option value="@instrument">@StatusHelper.GetInstrumentDisplay(instrument)</option>
                        }
                    </select>
                    <button type="button" 
                            class="btn btn-primary btn-primary-purple" 
                            @onclick="AddInstrumentToMember"
                            disabled="@(string.IsNullOrEmpty(selectedInstrumentToAdd))">
                        <i class="bi bi-plus-lg"></i> Adicionar
                    </button>
                </div>
                
                @* Display Instruments List *@
                @if (memberInstruments.Any())
                {
                    <div class="list-group">
                        @foreach (var memberInstrument in memberInstruments)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center gap-2">
                                    <input type="radio" 
                                           name="primaryInstrument" 
                                           class="form-check-input" 
                                           checked="@memberInstrument.IsPrimary"
                                           @onchange="@(() => MarkInstrumentAsPrimary(memberInstrument))"
                                           title="Marcar como principal" />
                                    <span>
                                        @StatusHelper.GetInstrumentDisplay(memberInstrument.InstrumentType)
                                        @if (memberInstrument.IsPrimary)
                                        {
                                            <span class="badge bg-primary ms-2">Principal</span>
                                        }
                                    </span>
                                </div>
                                <button type="button" 
                                        class="btn btn-sm btn-outline-danger" 
                                        @onclick="@(() => RemoveInstrumentFromMember(memberInstrument))"
                                        title="Remover instrumento">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        }
                    </div>
                }
                else if (!isCreateMode)
                {
                    <EmptyState Title="Nenhum instrumento adicionado ainda" Icon="bi-music-note-list" />
                }
            </div>
            
            @* Only show Padrinho field for Caloiro or Tuno (not for Leitão or Fundador) *@
            @if ((editingUser.SelectedCategory == "Caloiro" || editingUser.SelectedCategory == "Tuno") && !isFundador)
            {
                <div class="mb-3">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <label class="form-label d-flex align-items-center gap-2 mb-0">
                            <i class="bi bi-person-hearts text-primary"></i>
                            <span>Padrinho @(editingUser.SelectedCategory == "Caloiro" ? "(Obrigatório quando passa a Caloiro)" : "")</span>
                        </label>
                    </div>
                    <div class="mentor-search-container">
                        <SearchBar @bind-Value="mentorSearchTerm"
                                   Placeholder="Pesquisar padrinho por nome ou alcunha..."
                                   OnSearch="OnMentorSearch"
                                   OnClear="ClearMentorSelection"
                                   Compact="true" />
                    </div>
                    
                    @if (filteredMentors.Any())
                    {
                        <div class="member-list member-list-scrollable">
                            @foreach (var mentor in filteredMentors.Take(20))
                            {
                                <div class="member-item p-2 mb-2 border rounded clickable-row"
                                     @onclick="() => SelectMentor(mentor)">
                                    <div class="d-flex align-items-center">
                                        <img src="@mentor.ProfilePictureSrc" alt="@mentor.GetDisplayName()"
                                             class="member-avatar-small me-2" />
                                        <div>
                                            @if (!string.IsNullOrEmpty(mentor.Nickname))
                                            {
                                                <div><strong>@mentor.Nickname</strong></div>
                                                <div class="text-muted small">@mentor.FirstName @mentor.LastName</div>
                                            }
                                            else
                                            {
                                                <div><strong>@mentor.FirstName @mentor.LastName</strong></div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(mentorSearchTerm) && string.IsNullOrEmpty(editingUser.MentorId))
                    {
                        <div class="alert alert-purple mt-2">Nenhum padrinho encontrado.</div>
                    }

                    @if (!string.IsNullOrEmpty(editingUser.MentorId))
                    {
                        // Use cached mentor to avoid repeated lookups on every render
                        var displayMentor = selectedMentorCache ?? eligibleMentors.FirstOrDefault(m => m.Id == editingUser.MentorId);
                        if (displayMentor != null)
                        {
                            <div class="alert alert-purple mt-2">
                                <strong>Padrinho Selecionado:</strong> @displayMentor.GetDisplayName()
                            </div>
                        }
                    }
                </div>
            }
        </EditForm>
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="CloseEditModal" disabled="@isSaving">Cancelar</button>
        <button type="button" class="btn btn-primary btn-primary-purple" @onclick="HandleSaveClick" disabled="@isSaving">
            @if (isSaving)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
            }
            Guardar
        </button>
    </FooterContent>
</Modal>

<!-- Delete Confirmation Modal -->
<ConfirmDialog Show="@showDeleteModal"
               ShowChanged="@((bool show) => showDeleteModal = show)"
               Title="Confirmar Eliminação"
               Message="@($"Tem certeza que deseja eliminar {deletingUser?.GetDisplayName()}?")"
               WarningMessage="Esta ação não pode ser desfeita."
               ConfirmText="Eliminar"
               CancelText="Cancelar"
               ConfirmButtonClass="btn-danger"
               OnConfirm="DeleteMember"
               OnCancel="CloseDeleteModal" />

<!-- View Details Modal -->
@if (viewingUser != null)
{
    <Modal Show="@showViewDetailsModal" 
           ShowChanged="@((bool show) => showViewDetailsModal = show)"
           Title="Detalhes do Membro" 
           Size="Modal.ModalSize.Large"
           Centered="true">
        <BodyContent>
            <!-- Centered Header Section -->
            <div class="text-center mb-4">
                <img src="@viewingUser.ProfilePictureSrc" alt="@viewingUser.GetDisplayName()"
                     class="member-avatar-large mb-3" style="width: 120px; height: 120px; border-radius: 50%; border: 3px solid var(--bs-primary);" />
                
                @if (!string.IsNullOrEmpty(viewingUser.Nickname))
                {
                    <h4 class="mb-1">@viewingUser.Nickname</h4>
                    <p class="text-muted mb-2">@viewingUser.FirstName @viewingUser.LastName</p>
                }
                else
                {
                    <h4 class="mb-2">@viewingUser.FirstName @viewingUser.LastName</h4>
                }
                
                <!-- Badges centered below name -->
                <div class="d-flex justify-content-center flex-wrap gap-1 mb-2">
                    @{
                        var displayCategories = StatusHelper.GetDisplayCategories(viewingUser);
                    }
                    @foreach (var category in displayCategories)
                    {
                        <CategoryBadge Category="category" />
                    }
                    @if (viewingUser.Positions.Any())
                    {
                        @foreach (var position in viewingUser.Positions)
                        {
                            <PositionBadge Position="position" />
                        }
                    }
                </div>
            </div>

            <div class="mb-3"></div>

            <!-- Personal Information Section -->
            <div class="modal-info-section mb-4">
                <div class="modal-section-header">
                    <h6 class="modal-section-title">
                        <i class="bi bi-person-fill me-2 text-primary"></i>
                        Informações Pessoais
                    </h6>
                </div>
                <div class="modal-section-body">
                    <ProfileField Label="Email" Value="@viewingUser.Email" Icon="bi-envelope-fill" />
                    <ProfileField Label="Contacto" Value="@viewingUser.PhoneNumber" Icon="bi-telephone-fill" />
                    <ProfileField Label="Cidade" Value="@viewingUser.City" Icon="bi-geo-alt-fill" />
                    <ProfileField Label="Data de Nascimento"
                                Value="@(viewingUser.DateOfBirth.HasValue ? viewingUser.DateOfBirth.Value.ToString("dd/MM/yyyy") + (viewingUser.Age.HasValue ? $" ({viewingUser.Age} anos)" : "") : null)"
                                Icon="bi-calendar-event-fill" />
                    <ProfileField Label="Curso" Value="@viewingUser.Degree" Icon="bi-mortarboard-fill" />
                </div>
            </div>

            <!-- Tuna Information Section -->
            <div class="modal-info-section mb-3">
                <div class="modal-section-header">
                    <h6 class="modal-section-title">
                        <i class="bi bi-music-note-list me-2 text-primary"></i>
                        Informação da Tuna
                    </h6>
                </div>
                <div class="modal-section-body">
                    @* Display all instruments with primary indicator *@
                    @if (viewingUserInstruments != null && viewingUserInstruments.Any())
                    {
                        <ProfileField Label="Instrumentos" Icon="bi-music-note-beamed">
                            <ValueContent>
                                @string.Join(", ", viewingUserInstruments
                                    .OrderByDescending(i => i.IsPrimary)
                                    .Select(i => StatusHelper.GetInstrumentDisplay(i.InstrumentType) + (i.IsPrimary ? " (Principal)" : "")))
                            </ValueContent>
                        </ProfileField>
                    }
                    else
                    {
                        <ProfileField Label="Instrumentos" Value="@null" Icon="bi-music-note-beamed" />
                    }
                    
                    @if (!viewingUser.IsFundador())
                    {
                        <ProfileField Label="Padrinho"
                                    Value="@(viewingUserMentor != null ? viewingUserMentor.GetDisplayName() : null)"
                                    Icon="bi-person-heart" />
                    }
                    
                    <!-- Unified Timeline -->
                    <ProfileField Label="Percurso na Tuna" Icon="bi-signpost-2">
                        <ValueContent>
                            @if (userRoleAssignments.ContainsKey(viewingUser.Id))
                            {
                                <UnifiedTimeline User="@viewingUser" RoleAssignments="@userRoleAssignments[viewingUser.Id]" />
                            }
                            else
                            {
                                <UnifiedTimeline User="@viewingUser" RoleAssignments="@(new List<RoleAssignment>())" />
                            }
                        </ValueContent>
                    </ProfileField>

                </div>
            </div>

            <!-- Estado na Tuna Section -->
            @{
                var isActiveMember = viewingUser.Categories.Contains(MemberCategory.Caloiro) ||
                                    viewingUser.Categories.Contains(MemberCategory.Tuno) ||
                                    viewingUser.Categories.Contains(MemberCategory.Veterano) ||
                                    viewingUser.Categories.Contains(MemberCategory.Tunossauro);
                var statusResult = viewingUserStatusData.GetValueOrDefault(viewingUser.Id);
                var hasActivityHistory = statusResult?.HasAnyActivity ?? false;
            }
            @if (isActiveMember && hasActivityHistory)
            {
                <div class="modal-info-section mb-3">
                    <div class="modal-section-header">
                        <h6 class="modal-section-title">
                            <i class="bi bi-flag-fill me-2 text-primary"></i>
                            Estado na Tuna
                        </h6>
                    </div>
                    <div class="modal-section-body">
                        <ProfileField Label="Estado atual" Value="badge" Icon="bi-flag-fill">
                            <ValueContent>
                                @if (statusResult?.IsRetired == true)
                                {
                                    <span class="badge badge-retired"
                                          title="Reformados: transitam para esta categoria os Associados Efectivos que por motivos profissionais ou pessoais, se encontrem afastados, por um período de seis meses ou superior, das actividades da RTUB. Poderão retornar à sua categoria após três meses de actividade ininterrupta.">
                                        REFORMADO
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-active">
                                        NO ATIVO
                                    </span>
                                }
                            </ValueContent>
                        </ProfileField>

                        <ProfileField Label="Último ensaio"
                                      Icon="bi-music-note-list"
                                      Value="@(statusResult?.LastRehearsalDate.HasValue == true
                                          ? statusResult.LastRehearsalDate.Value.ToString("dd MMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("pt-PT"))
                                          : null)" />

                        <ProfileField Label="Última atuação"
                                      Icon="bi-megaphone-fill"
                                      Value="@(statusResult?.LastEventDate.HasValue == true
                                          ? statusResult.LastEventDate.Value.ToString("dd MMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("pt-PT"))
                                          : null)" />
                    </div>
                </div>
            }
        </BodyContent>
        <FooterContent>
            <button type="button" class="btn btn-secondary" @onclick="CloseViewDetailsModal">Fechar</button>
        </FooterContent>
    </Modal>
}

