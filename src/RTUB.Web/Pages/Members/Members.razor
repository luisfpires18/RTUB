    // Active Members Management modal methods
    
    /// <summary>
    /// Opens the active members management modal and loads active members data
    /// </summary>
    private async Task OpenActiveMembersManagementModal()
    {
        modals.Open(ModalType.ActiveMembersManagement);
        activeMembersLoading = true;
        activeMembersSearchTerm = string.Empty;
        activeMembersStatusFilter = string.Empty;
        StateHasChanged();
        
        try
        {
            // Get all active members (excluding Leitão and Tuno Honorário)
            // Active members = Caloiro, Tuno, Veterano, Tunossauro
            var activeMembers = users?
                .Where(u => !u.IsLeitao() && !u.Categories.Contains(MemberCategory.TunoHonorario) &&
                           (u.Categories.Contains(MemberCategory.Caloiro) ||
                            u.Categories.Contains(MemberCategory.Tuno) ||
                            u.Categories.Contains(MemberCategory.Veterano) ||
                            u.Categories.Contains(MemberCategory.Tunossauro)))
                .ToList() ?? new List<ApplicationUser>();
            
            // Load status data for all members in a single batch query (performance optimization)
            var userIds = activeMembers.Select(m => m.Id).ToList();
            Dictionary<string, MemberStatusResult?> statusDataBatch;
            
            try
            {
                statusDataBatch = await MemberStatusService.GetMemberStatusesBatchAsync(userIds);
            }
            catch
            {
                // If batch load fails, use empty dictionary (members will use fallback logic)
                statusDataBatch = new Dictionary<string, MemberStatusResult?>();
            }
            
            // Build active members list with status data
            allActiveMembers = new List<ActiveMemberData>();
            foreach (var member in activeMembers)
            {
                // Get status data from batch result (null if not cached or failed to load)
                var statusData = statusDataBatch.GetValueOrDefault(member.Id);
                
                // Include all active members regardless of activity history
                // Members without activity will show with null or default status data
                allActiveMembers.Add(new ActiveMemberData
                {
                    Member = member,
                    StatusData = statusData
                });
            }
            
            allActiveMembers = allActiveMembers
                .OrderBy(GetActiveMemberGroupPriority)
                .ThenBy(GetActiveMemberPriority)
                .ThenByDescending(m => m.StatusData?.LastActivityDate ?? DateTime.MinValue)
                .ThenByDescending(m => HasFullActivityHistory(m.StatusData))
                .ThenByDescending(m => m.StatusData?.LastRehearsalDate ?? DateTime.MinValue)
                .ThenByDescending(m => m.StatusData?.LastEventDate ?? DateTime.MinValue)
                .ThenByDescending(m => m.StatusData?.TotalActivitiesCount ?? 0)
                .ThenBy(m => m.Member.Nickname ?? m.Member.FirstName ?? string.Empty)
                .ToList();

            // Reset pagination and apply search filter
            activeMembersPaginationHelper.CurrentPage = 1;
            ApplyActiveMembersSearch(activeMembersSearchTerm);
        }
        finally
        {
            activeMembersLoading = false;
            StateHasChanged();
        }
    }
    
    /// <summary>
    /// Closes the active members management modal
    /// </summary>
    private void CloseActiveMembersManagementModal()
    {
        modals.Close(ModalType.ActiveMembersManagement);
        allActiveMembers.Clear();
        filteredActiveMembers.Clear();
        paginatedActiveMembers.Clear();
        activeMembersSearchTerm = string.Empty;
        activeMembersStatusFilter = string.Empty;
    }
    
    /// <summary>
    /// Updates the paginated active members list
    /// </summary>
    private void UpdateActiveMembersPagination()
    {
        paginatedActiveMembers = activeMembersPaginationHelper.GetPageData(filteredActiveMembers);
    }
    
    /// <summary>
    /// Changes the current page in active members modal
    /// </summary>
    private async Task ChangeActiveMembersPage(int newPage)
    {
        activeMembersPaginationHelper.CurrentPage = newPage;
        UpdateActiveMembersPagination();
        StateHasChanged();
        await Task.CompletedTask;
    }
    
    /// <summary>
    /// Changes the page size in active members modal
    /// </summary>
    private async Task ChangeActiveMembersPageSize(int newPageSize)
    {
        activeMembersPaginationHelper.PageSize = newPageSize;
        activeMembersPaginationHelper.CurrentPage = 1; // Reset to first page
        UpdateActiveMembersPagination();
        StateHasChanged();
        await Task.CompletedTask;
    }

    private void ApplyActiveMembersSearch(string term)
    {
        activeMembersSearchTerm = term ?? string.Empty;

        // Use service to filter active members
        filteredActiveMembers = ActiveMemberFilterService.FilterActiveMembers(
            allActiveMembers,
            activeMembersStatusFilter,
            activeMembersSearchTerm);

        activeMembersPaginationHelper.CurrentPage = 1;
        UpdateActiveMembersPagination();
    }

    private void ApplyActiveMembersStatusFilter()
    {
        ApplyActiveMembersSearch(activeMembersSearchTerm);
    }
    
    /// <summary>
    /// Gets the effective retirement status for a member, falling back to member.IsRetired if statusData is null
    /// </summary>
    private static bool GetEffectiveRetirementStatus(ActiveMemberData memberData)
    {
        return memberData.StatusData?.IsRetired ?? memberData.Member.IsRetired;
    }

    private static int GetActiveMemberPriority(ActiveMemberData memberData)
    {
        var status = memberData.StatusData;
        var isRetired = GetEffectiveRetirementStatus(memberData);

        if (!isRetired)
        {
            return 0;
        }

        // For retired members with progress data, prioritize by months toward reactivation
        if (isRetired &&
            status?.ProgressTotalMonths == 3 &&
            status.ProgressMonths.HasValue)
        {
            return status.ProgressMonths.Value switch
            {
                >= 2 => 1,
                1 => 2,
                0 => 3,
                _ => 4
            };
        }

        // Retired members without progress data get lowest priority
        return 4;
    }

    private static int GetActiveMemberGroupPriority(ActiveMemberData memberData)
    {
        // Group by retired status, falling back to member.IsRetired if statusData is null
        var isRetired = GetEffectiveRetirementStatus(memberData);
        return isRetired ? 1 : 0;
    }

    private static bool HasFullActivityHistory(MemberStatusResult? status)
    {
        return status?.LastRehearsalDate.HasValue == true
            && status.LastEventDate.HasValue == true;
    }

    private static bool ShouldShowProgressStatus(MemberStatusResult? status)
    {
        if (status?.ProgressDescription == null)
        {
            return false;
        }

        // For active members (not retired), only show progress if they haven't participated this month
        // If they already participated this month, they're "safe" for now - no need to show countdown
        if (status.IsRetired == false && status.ProgressTotalMonths == 6)
        {
            // Hide progress if member has activity in current month (they're doing well)
            if (status.HasActivityInCurrentMonth)
            {
                return false;
            }
            // Show progress only if there's 1-5 months without activity
            return status.ProgressMonths is >= 1 and <= 5;
        }

        return true;
    }
    
    /// <summary>
    /// Checks if a retired member is at 2/3 progress and should be encouraged to participate
    /// Only shows when member doesn't have activity in the current month
    /// </summary>
    private static bool ShouldShowReactivationEncouragement(MemberStatusResult? status)
    {
        return status?.IsRetired == true 
            && status.ProgressTotalMonths == 3 
            && status.ProgressMonths == 2
            && !status.HasActivityInCurrentMonth;
    }
    
    // Anniversaries modal methods
    
    /// <summary>
    /// Opens the anniversaries modal and loads birthday data
    /// </summary>
    private async Task OpenAnniversariesModal()
    {
        modals.Open(ModalType.Anniversaries);
        anniversariesLoading = true;
        anniversariesSearchTerm = string.Empty;
        StateHasChanged();
        
        try
        {
            // Get current date and year
            var today = DateTime.Now.Date;
            var currentYear = today.Year;
            
            // Get all users with birthdays
            var usersWithBirthdays = users?
                .Where(u => u.DateOfBirth.HasValue)
                .ToList() ?? new List<ApplicationUser>();
            
            // Filter to only show birthdays in current year that are today or in the future
            // Compute nextBirthday for each member and filter
            var filteredUsers = usersWithBirthdays
                .Select(u => new
                {
                    User = u,
                    NextBirthday = new DateTime(currentYear, u.DateOfBirth!.Value.Month, u.DateOfBirth.Value.Day)
                })
                .Where(x => x.NextBirthday >= today && x.NextBirthday.Year == currentYear)
                .ToList();
            
            // Sort by next anniversary (day/month) ascending, then by name
            allAnniversaries = filteredUsers
                .OrderBy(x => x.NextBirthday)
                .ThenBy(x => x.User.FirstName)
                .ThenBy(x => x.User.LastName)
                .Select(x => x.User)
                .ToList();

            // Reset pagination and apply search filter
            anniversariesPaginationHelper.CurrentPage = 1;
            ApplyAnniversariesSearch(anniversariesSearchTerm);
        }
        finally
        {
            anniversariesLoading = false;
            StateHasChanged();
        }
    }
    
    /// <summary>
    /// Closes the anniversaries modal
    /// </summary>
    private void CloseAnniversariesModal()
    {
        modals.Close(ModalType.Anniversaries);
        allAnniversaries.Clear();
        filteredAnniversaries.Clear();
        paginatedAnniversaries.Clear();
        anniversariesSearchTerm = string.Empty;
    }
    
    /// <summary>
    /// Updates the paginated anniversaries list
    /// </summary>
    private void UpdateAnniversariesPagination()
    {
        paginatedAnniversaries = anniversariesPaginationHelper.GetPageData(filteredAnniversaries);
    }
    
    /// <summary>
    /// Changes the current page in anniversaries modal
    /// </summary>
    private async Task ChangeAnniversariesPage(int newPage)
    {
        anniversariesPaginationHelper.CurrentPage = newPage;
        UpdateAnniversariesPagination();
        StateHasChanged();
        await Task.CompletedTask;
    }
    
    /// <summary>
    /// Changes the page size in anniversaries modal
    /// </summary>
    private async Task ChangeAnniversariesPageSize(int newPageSize)
    {
        anniversariesPaginationHelper.PageSize = newPageSize;
        anniversariesPaginationHelper.CurrentPage = 1; // Reset to first page
        UpdateAnniversariesPagination();
        StateHasChanged();
        await Task.CompletedTask;
    }

    private void ApplyAnniversariesSearch(string term)
    {
        anniversariesSearchTerm = term ?? string.Empty;

        // Use service to filter anniversaries
        filteredAnniversaries = MemberAnniversaryService.FilterAnniversaries(allAnniversaries, anniversariesSearchTerm);

        anniversariesPaginationHelper.CurrentPage = 1;
        UpdateAnniversariesPagination();
    }
    
    // Birthday email methods
    
    /// <summary>
    /// Checks if today is the user's birthday
    /// </summary>
    private bool IsBirthdayToday(ApplicationUser user)
    {
        if (!user.DateOfBirth.HasValue)
            return false;
        
        var today = DateTime.Now;
        return user.DateOfBirth.Value.Month == today.Month && 
               user.DateOfBirth.Value.Day == today.Day;
    }
    
    /// <summary>
    /// Initiates the birthday email sending process
    /// </summary>
    private async Task SendBirthdayEmail(ApplicationUser user)
    {
        if (!IsBirthdayToday(user))
        {
            return;
        }
        
        selectedUserForBirthday = user;
        birthdayEmailLoadingSubscribers = true;
        birthdayEmailErrorMessage = null;
        modals.Open(ModalType.BirthdayEmail);
        StateHasChanged();

        try
        {
            // Get all subscribed users with confirmed emails
            var subscribedUsers = await UserManager.Users
                .Where(u => u.Subscribed && u.EmailConfirmed && !string.IsNullOrEmpty(u.Email))
                .OrderBy(u => u.Nickname ?? u.FirstName)
                .AsNoTracking()
                .ToListAsync();
            
            birthdaySubscribedUsers = subscribedUsers;
            birthdaySubscribedUsersCount = subscribedUsers.Count;
        }
        catch (Exception ex)
        {
            birthdayEmailErrorMessage = $"Erro ao carregar membros: {ex.Message}";
        }
        finally
        {
            birthdayEmailLoadingSubscribers = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Closes the birthday email modal
    /// </summary>
    private void CloseBirthdayEmailModal()
    {
        modals.Close(ModalType.BirthdayEmail);
        selectedUserForBirthday = null;
        birthdaySubscribedUsers = null;
        birthdaySubscribedUsersCount = 0;
        birthdayEmailErrorMessage = null;
    }

    /// <summary>
    /// Sends the birthday notification email to subscribed users
    /// </summary>
    private async Task SendBirthdayNotification()
    {
        if (selectedUserForBirthday == null || birthdaySubscribedUsers == null || !birthdaySubscribedUsers.Any())
        {
            CloseBirthdayEmailModal();
            return;
        }

        // Initialize progress tracking
        IsSendingEmails = true;
        EmailsTotal = birthdaySubscribedUsers.Count;
        EmailsSent = 0;
        LastRecipient = null;
        birthdayEmailErrorMessage = null;
        
        StateHasChanged();

        try
        {
            var recipientEmails = birthdaySubscribedUsers
                .Where(u => !string.IsNullOrWhiteSpace(u.Email))
                .Select(u => u.Email!)
                .ToList();

            var recipientData = birthdaySubscribedUsers
                .Where(u => !string.IsNullOrWhiteSpace(u.Email))
                .ToDictionary(
                    u => u.Email!,
                    u => (u.Nickname ?? u.FirstName ?? "", $"{u.FirstName} {u.LastName}")
                );

            // Create progress reporter
            var progress = new Progress<EmailSendProgress>(update =>
            {
                EmailsTotal = update.Total;
                EmailsSent = update.Sent;
                LastRecipient = update.LastRecipient;
                StateHasChanged();
            });
            
            var (success, count, errorMessage) = await EmailNotificationService.SendBirthdayNotificationAsync(
                selectedUserForBirthday.Id,
                selectedUserForBirthday.Nickname ?? selectedUserForBirthday.FirstName ?? "",
                $"{selectedUserForBirthday.FirstName} {selectedUserForBirthday.LastName}",
                recipientEmails,
                recipientData,
                progress
            );
            
            if (success)
            {
                birthdayEmailErrorMessage = null;
                CloseBirthdayEmailModal();
            }
            else
            {
                birthdayEmailErrorMessage = errorMessage ?? "Erro ao enviar notificação.";
            }
        }
        catch (Exception ex)
        {
            birthdayEmailErrorMessage = $"Erro ao enviar email: {ex.Message}";
            _logger.LogError(ex, "Error sending birthday email");
        }
        finally
        {
            IsSendingEmails = false;
            StateHasChanged();
        }
    }
    
    /// <summary>
    /// Toggles the IsRetired status for a user (OWNER only)
    /// This allows manual setting of retirement status, particularly for new members
    /// </summary>
    private async Task ToggleIsRetired(ApplicationUser user, bool isRetired)
    {
        try
        {
            var dbUser = await UserManager.FindByIdAsync(user.Id);
            if (dbUser != null)
            {
                dbUser.IsRetired = isRetired;
                await SetAuditContextToCurrentUser();
                await UserManager.UpdateAsync(dbUser);
                
                // Update local viewing user to reflect the change immediately
                if (viewingUser?.Id == user.Id)
                {
                    viewingUser.IsRetired = isRetired;
                }
                
                // Update the user in the local list without reloading
                var userInList = users?.FirstOrDefault(u => u.Id == user.Id);
                if (userInList != null)
                {
                    userInList.IsRetired = isRetired;
                }
                
                // Reapply filters to update the displayed list
                FilterMembers();
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error toggling IsRetired for user {UserId}", user.Id);
        }
    }
    
