        userRoles.Clear();
        foreach (var user in users)
        {
            userRoles[user.Id] = userRolesQuery
                .Where(ur => ur.UserId == user.Id)
                .Select(ur => ur.RoleName)
                .ToList();
        }

        // Load role assignments in a single query
        var allAssignments = (await RoleAssignmentService.GetAllRoleAssignmentsAsync())
            .Where(ra => userIdList.Contains(ra.UserId))
            .ToList();

        userRoleAssignments.Clear();
        foreach (var user in users)
        {
            userRoleAssignments[user.Id] = allAssignments
                .Where(ra => ra.UserId == user.Id)
                .OrderByDescending(ra => ra.StartYear)
                .ToList();
        }

        // Batch load all member instruments in a single query
        var allInstrumentsByUser = await MemberInstrumentService.GetMemberInstrumentsByUserIdsAsync(userIdList);
        
        userPrimaryInstruments.Clear();
        userPrimaryInstrumentObjects.Clear();
        userAllInstruments.Clear();
        foreach (var user in users)
        {
            var instruments = allInstrumentsByUser.GetValueOrDefault(user.Id, new List<MemberInstrument>());
            var primary = instruments.FirstOrDefault(i => i.IsPrimary);
            userPrimaryInstruments[user.Id] = primary != null ? StatusHelper.GetInstrumentDisplay(primary.InstrumentType) : "";
            userPrimaryInstrumentObjects[user.Id] = primary;
            userAllInstruments[user.Id] = instruments;
        }

