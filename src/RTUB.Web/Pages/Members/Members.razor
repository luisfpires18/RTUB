            MonthCaloiro = freshUser.MonthCaloiro,
            YearTuno = freshUser.YearTuno,
            MonthTuno = freshUser.MonthTuno,
            EmailConfirmed = freshUser.EmailConfirmed,
            MentorId = freshUser.MentorId,
        };

        // Set SelectedCategory based on user's primary category
        var primaryCategory = freshUser.Categories.FirstOrDefault();
        
        // Check if user has Fundador or TunoHonorario in their categories (as subcategories)
        isFundador = freshUser.Categories.Contains(MemberCategory.Fundador);
        isTunoHonorario = freshUser.Categories.Contains(MemberCategory.TunoHonorario);
        
        // Map categories to dropdown - if user has Fundador or TunoHonorario, they must also have Tuno
        editingUser.SelectedCategory = primaryCategory switch
        {
            MemberCategory.Leitao => "Leitão",
            MemberCategory.Caloiro => "Caloiro",
            MemberCategory.Tuno => "Tuno",
            _ => ""
        };
        
        // Initialize mentor search term if user has a mentor
        if (!string.IsNullOrEmpty(freshUser.MentorId))
        {
            var mentor = eligibleMentors.FirstOrDefault(m => m.Id == freshUser.MentorId);
            if (mentor != null)
            {
                selectedMentorCache = mentor;
                mentorSearchTerm = mentor.GetDisplayName();
            }
        }
        else
        {
            selectedMentorCache = null;
            mentorSearchTerm = "";
        }
        
        filteredMentors.Clear();
        
        // Load member instruments
        memberInstruments = (await MemberInstrumentService.GetMemberInstrumentsAsync(freshUser.Id)).ToList();
        selectedInstrumentToAdd = "";
        
