    private async Task OpenViewDetailsModal(ApplicationUser user)
    {
        viewingUser = user;
        
        // Load mentor if exists
        if (!string.IsNullOrEmpty(user.MentorId))
        {
            viewingUserMentor = await UserManager.FindByIdAsync(user.MentorId);
        }
        else
        {
            viewingUserMentor = null;
        }
        
        // Load member instruments
        viewingUserInstruments = (await MemberInstrumentService.GetMemberInstrumentsAsync(user.Id)).ToList();
        
        // Load retirement status
        try
        {
            var retirementStatus = await RetirementStatusService.EvaluateRetirementStatusAsync(user.Id);
            viewingUserRetirementStatus[user.Id] = retirementStatus;
        }
        catch
        {
            viewingUserRetirementStatus[user.Id] = null;
        }
        
        // Load status data for active members (ALWAYS shown when there's activity)
        var isActiveMember = user.Categories.Contains(MemberCategory.Leitao) ||
                            user.Categories.Contains(MemberCategory.Caloiro) || 
                            user.Categories.Contains(MemberCategory.Tuno) ||
                            user.Categories.Contains(MemberCategory.Veterano) ||
                            user.Categories.Contains(MemberCategory.Tunossauro);
        
        if (isActiveMember)
        {
            try
            {
                var statusData = await MemberStatusService.GetMemberStatusAsync(user.Id);
                viewingUserStatusData[user.Id] = statusData;
            }
            catch
            {
                viewingUserStatusData[user.Id] = null;
            }
            
            // Load attended activities for collapsible section
            try
            {
                var now = DateTime.UtcNow;
                viewingUserAttendedActivities = await MemberStatisticsService.GetUserAttendedActivitiesAsync(user.Id, now);
            }
            catch
            {
                viewingUserAttendedActivities = null;
            }
        }
        
        // Reset expansion state when opening modal
        isViewingUserActivitiesExpanded = false;
        
        modals.Open(ModalType.ViewDetails);
    }

