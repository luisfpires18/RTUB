        }
        
        editingUser = new ApplicationUser
        {
            Id = freshUser.Id,
            UserName = freshUser.UserName,
            Email = freshUser.Email,
            FirstName = freshUser.FirstName,
            LastName = freshUser.LastName,
            Nickname = freshUser.Nickname,
