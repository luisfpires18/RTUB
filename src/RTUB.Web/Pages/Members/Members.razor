@page "/members"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using RTUB.Application.Helpers
@using RTUB.Application.Extensions
@using RTUB.Application.Interfaces
@using RTUB.Application.Configuration
@using RTUB.Application.DTOs
@using RTUB.Core.Entities
@using RTUB.Shared
@using RTUB.Shared.Base
@using System.ComponentModel.DataAnnotations
@using Microsoft.Extensions.Options
@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<IdentityRole> RoleManager
@inject IRoleAssignmentService RoleAssignmentService
@inject IEnrollmentService EnrollmentService
@inject IMemberInstrumentService MemberInstrumentService
@inject IEmailNotificationService EmailNotificationService
@inject IUserRoleQueryService UserRoleQueryService
@inject IRetirementStatusService RetirementStatusService
@inject IMemberStatusService MemberStatusService
@inject IMemberStatisticsService MemberStatisticsService
@inject IUserProfileService UserProfileService
@inject IMemberFilterService MemberFilterService
@inject IActiveMemberFilterService ActiveMemberFilterService
@inject IMemberMentorService MemberMentorService
@inject IMemberPositionService MemberPositionService
@inject IMemberAnniversaryService MemberAnniversaryService
@inject IPushNotificationService PushNotificationService
@inject IPushNotificationFactory PushNotificationFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject RTUB.Application.Services.AuditContext AuditContext
@inject NavigationManager NavigationManager
@inject ILogger<Members> _logger
@inject IOptions<Toggles> Toggles
@attribute [Authorize]

<div class="d-flex flex-column gap-3 mb-4">
    <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
        <div>
            <h1 class="mb-2"><i class="bi bi-people"></i> Membros</h1>
            <p class="lead page-header-subtitle mb-0 text-light-theme">Lista de todos os membros da RTUB.</p>
        </div>

        <!-- Page Header Actions -->
        <div class="page-header-actions justify-content-lg-end">
            <AuthorizeView Roles="Admin">
                <Authorized>
                    <button class="btn btn-success" @onclick="OpenCreateModal" title="Adicionar Novo Membro">
                        <i class="bi bi-plus-lg"></i> Adicionar Membro
                    </button>
                </Authorized>
            </AuthorizeView>

            <!-- Anniversaries button visible to all members -->
            @if (Toggles.Value.MapEnabled)
            {
                <button class="btn btn-primary btn-primary-purple" @onclick="NavigateToMap" title="Ver Mapa de Membros">
                    <i class="bi bi-geo-alt"></i> Ver Mapa de Membros
                </button>
            }
            
            <button class="btn btn-primary btn-primary-purple" @onclick="OpenActiveMembersManagementModal" title="Gestão de Membros Ativos">
                <i class="bi bi-person-badge"></i> Gestão de Membros Ativos
            </button>

            <button class="btn btn-primary btn-primary-purple" @onclick="OpenAnniversariesModal" title="Ver Aniversários dos Membros">
                <i class="bi bi-cake2"></i> Aniversários
            </button>
        </div>
    </div>

    <!-- Search and Controls -->
    <div class="d-flex flex-column flex-lg-row align-items-lg-end gap-2 flex-wrap search-controls-container">
        <div class="flex-grow-1 search-bar-container">
            <SearchBar @bind-Value="searchTerm"
                       Placeholder="Pesquisar membros..."
                       OnSearch="@HandleSearchChanged" />
        </div>
        <div class="d-flex flex-column flex-sm-row gap-2 align-items-stretch ms-lg-auto">
            <div class="flex-sm-shrink-0 filter-dropdown-container">
                <FilterDropdown SelectedValue="@selectedCategoryFilter"
                                SelectedValueChanged="@OnCategoryFilterChanged"
                                OnChange="@ApplyFilters"
                                AllItemsLabel="Categoria"
                                Options="@categoryFilterOptions" />
            </div>
            @* SubCategory dropdown - only show when Tuno is selected *@
            @if (selectedCategoryFilter == "Tuno")
            {
                <div class="flex-sm-shrink-0 filter-dropdown-container">
                    <FilterDropdown SelectedValue="@selectedSubCategoryFilter"
                                    SelectedValueChanged="@(value => selectedSubCategoryFilter = value)"
                                    OnChange="@ApplyFilters"
                                    AllItemsLabel="Sub-Categoria"
                                    Options="@subCategoryFilterOptions" />
                </div>
            }
            <div class="flex-sm-shrink-0 filter-dropdown-container">
                <FilterDropdown SelectedValue="@selectedInstrumentFilter"
                                SelectedValueChanged="@(value => selectedInstrumentFilter = value)"
                                OnChange="@ApplyFilters"
                                AllItemsLabel="Instrumento"
                                Options="@instrumentFilterOptions" />
            </div>
            <div class="flex-sm-shrink-0 filter-dropdown-container">
                <div class="form-check form-switch d-flex align-items-center active-only-toggle">
                    <input class="form-check-input form-check-input-clickable" type="checkbox" role="switch" id="showActiveOnlySwitch"
                           @bind="showActiveOnly" @bind:after="ApplyFilters">
                    <label class="form-check-label ms-2 form-check-label-clickable" for="showActiveOnlySwitch">
                        Mostrar só ativos
                    </label>
                </div>
            </div>
        </div>
    </div>
</div>

@if (users == null)
{
    <!-- Loading skeleton cards -->
    <div class="avatar-card-grid">
        @for (int i = 0; i < 8; i++)
        {
            <div class="avatar-card-skeleton-card">
                <div class="avatar-card-image-wrapper">
                    <div class="avatar-card-skeleton"></div>
                </div>
            </div>
        }
    </div>
}
else if (!filteredUsers.Any())
{
    <EmptyState Title="Nenhum membro encontrado"
                    Icon="bi-people"
                    Message="A pesquisa não devolveu resultados." />
}
else
{
    <!-- Regular Members Grid -->
    @if (filteredRegularMembers.Any())
    {
        <h3 class="mb-3">Membros</h3>
        <div class="avatar-card-grid">
            @foreach (var user in paginatedRegularMembers)
            {
                <AvatarCard @key="user.Id"
                           AvatarUrl="@user.ProfilePictureSrc"
                           TunaName="@user.Nickname"
                           FullName="@($"{user.FirstName} {user.LastName}")"
                           InstrumentText="@(userPrimaryInstruments.ContainsKey(user.Id) ? userPrimaryInstruments[user.Id] : "")"
                           AltText="@user.GetDisplayName()"
                           LastLoginDate="@user.LastLoginDate"
                           OnView="@(async () => await OpenViewDetailsModal(user))"
                           OnEdit="@(() => OpenEditModal(user))"
                           OnDelete="@(() => OpenDeleteModal(user))"
                           ShowEditButton="@isAdmin"
                           ShowDeleteButton="@isOwner"
                           ViewTooltip="Ver Detalhes"
                           EditTooltip="Editar"
                           DeleteTooltip="Eliminar"
                           LazyLoad="true">
                    <BadgeContent>
                        @{
                            // Get current fiscal year position for this user
                            var currentPosition = GetCurrentFiscalYearPosition(user.Id);
                        }
                        <!-- Category badges row -->
                        <div class="avatar-card-badges-row">
                            @{
                                var displayCategories = StatusHelper.GetDisplayCategories(user);
                            }
                            @foreach (var category in displayCategories.Where(c =>
                                c == MemberCategory.Caloiro || c == MemberCategory.Tuno || 
                                c == MemberCategory.TunoHonorario))
                            {
                                <CategoryBadge @key="@($"category-{user.Id}-{category}")" Category="@category" />
                            }
                        </div>
                        <!-- Role/Position badges row -->
                        @if (currentPosition != null)
                        {
                            <div class="avatar-card-badges-row">
                                <PositionBadge Position="currentPosition.Value" />
                            </div>
                        }
                        @if (!user.Positions.Any() && !user.Categories.Any())
                        {
                            <div class="avatar-card-badges-row">
                                <span class="badge bg-secondary avatar-card-role-badge" 
                                      title="Sem Cargos"
                                      aria-label="Sem Cargos">Sem Cargos</span>
                            </div>
                        }
                    </BadgeContent>
                </AvatarCard>
            }
        </div>

        <TablePagination CurrentPage="@paginationHelper.CurrentPage"
                        PageSize="@paginationHelper.PageSize"
                        TotalItems="@filteredRegularMembers.Count"
                        ItemLabel="membros"
                        PageSizeOptions="@(new[] { 30, 60, 90, 120, 150 })"
                        OnPageChanged="@HandleRegularMembersPageChange"
                        OnPageSizeChanged="@HandleRegularMembersPageSizeChange" />
    }

    <!-- Leitões Grid -->
    @if (filteredLeitoes.Any())
    {
        <hr class="my-5 hr-divider" />
        <h3 class="mb-3">Leitões</h3>
        <div class="avatar-card-grid">
            @foreach (var user in paginatedLeitoes)
            {
                var leitaoStatus = leitoesStatusData.GetValueOrDefault(user.Id);
                // Show inactivity warning if: no status data (no activity ever) OR status exists but no activity in current month
                var hasNoActivityThisMonth = leitaoStatus == null || !leitaoStatus.HasActivityInCurrentMonth;
                <AvatarCard @key="user.Id"
                           AvatarUrl="@user.ProfilePictureSrc"
                           TunaName="@user.Nickname"
                           FullName="@($"{user.FirstName} {user.LastName}")"
                           InstrumentText="@(userPrimaryInstruments.ContainsKey(user.Id) ? userPrimaryInstruments[user.Id] : "")"
                           AltText="@user.GetDisplayName()"
                           LastLoginDate="@user.LastLoginDate"
                           OnView="@(async () => await OpenViewDetailsModal(user))"
                           OnEdit="@(() => OpenEditModal(user))"
                           OnDelete="@(() => OpenDeleteModal(user))"
                           OnSetNickname="@(() => OpenSetNicknameModal(user))"
                           OnExpel="@(() => OpenExpelConfirmModal(user))"
                           OnReactivate="@(() => OpenReactivateConfirmModal(user))"
                           ShowEditButton="@(isAdmin)"
                           ShowDeleteButton="@(isAdmin)"
                           ShowSetNicknameButton="@isAdmin"
                           ShowExpelButton="@isAdmin"
                           IsExpelled="@user.IsExpelled"
                           ShowInactivityWarning="@hasNoActivityThisMonth"
                           ViewTooltip="Ver Detalhes"
                           EditTooltip="Editar"
                           DeleteTooltip="Eliminar"
                           SetNicknameTooltip="Definir Alcunha"
                           LazyLoad="true">
                    <BadgeContent>
                        <div class="avatar-card-badges-row">
                            <CategoryBadge @key="MemberCategory.Leitao" Category="@MemberCategory.Leitao" />
                        </div>
                    </BadgeContent>
                </AvatarCard>
            }
        </div>

        <TablePagination CurrentPage="@paginationHelperLeitoes.CurrentPage"
                        PageSize="@paginationHelperLeitoes.PageSize"
                        TotalItems="@filteredLeitoes.Count"
                        ItemLabel="leitões"
                        PageSizeOptions="@(new[] { 18, 36, 54, 72, 90 })"
                        OnPageChanged="@HandleLeitoesPageChange"
                        OnPageSizeChanged="@HandleLeitoesPageSizeChange" />
    }
}

<!-- Create/Edit Modal -->
<Modal Show="@modals.IsOpen(ModalType.Edit)"
       ShowChanged="@((bool show) => { if (show) modals.Open(ModalType.Edit); else modals.Close(ModalType.Edit); })"
       Title="@(isCreateMode ? "Adicionar Novo Membro" : "Editar Membro")" 
       Size="Modal.ModalSize.Large"
       Centered="true">
    <BodyContent>
        <EditForm Model="@editingUser" OnValidSubmit="SaveMember" @ref="memberEditForm">
            <DataAnnotationsValidator />
            <ErrorDisplay />

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-person text-primary me-2"></i>Primeiro Nome <span class="text-danger">*</span>
                    </label>
                    <InputText class="form-control" @bind-Value="editingUser.FirstName" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-person text-primary me-2"></i>Último Nome <span class="text-danger">*</span>
                    </label>
                    <InputText class="form-control" @bind-Value="editingUser.LastName" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-star text-primary me-2"></i>Nome de Tuna<span class="text-danger">*</span>
                    </label>
                    <InputText class="form-control" @bind-Value="editingUser.Nickname" @bind-Value:after="OnNicknameChanged" disabled="@semAlcunha" />
                    @if (semAlcunha)
                    {
                        <small class="form-text text-muted">Campo desativado - reflete automaticamente o email</small>
                    }
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-telephone text-primary me-2"></i>Contacto <span class="text-danger">*</span>
                    </label>
                    <InputText class="form-control" @bind-Value="editingUser.PhoneNumber" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-envelope text-primary me-2"></i>Email <span class="text-danger">*</span>
                    </label>
                    <InputText type="email" class="form-control" @bind-Value="editingUser.Email" @bind-Value:after="OnEmailChanged" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-calendar3 text-primary me-2"></i>Data de Nascimento
                    </label>
                    <InputDate class="form-control" @bind-Value="editingUser.DateOfBirth" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-book text-primary me-2"></i>Curso
                    </label>
                    <InputText class="form-control" @bind-Value="editingUser.Degree" placeholder="Inserir curso..." />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-geo-alt text-primary me-2"></i>Cidade
                    </label>
                    <InputText class="form-control" @bind-Value="editingUser.City" placeholder="Inserir cidade..." />
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <i class="bi bi-tag text-primary me-2"></i>Categoria <span class="text-danger">*</span>
                </label>
                <InputSelect class="form-select" @bind-Value="editingUser.SelectedCategory" @bind-Value:after="OnCategoryChanged">
                    <option value="">Selecionar Categoria</option>
                    <option value="Leitão">Leitão</option>
                    <option value="Caloiro">Caloiro</option>
                    <option value="Tuno">Tuno</option>
                </InputSelect>
            </div>
            @* Sem alcunha checkbox - only show for Leitão category in create mode *@
            @if (editingUser.SelectedCategory == "Leitão" && isCreateMode)
            {
                <div class="mb-3">
                    <div class="rtub-checkbox-wrapper">
                        <div class="form-check">
                            <InputCheckbox class="form-check-input rtub-checkbox-large" id="semAlcunhaCheckbox" @bind-Value="semAlcunha" @bind-Value:after="OnSemAlcunhaChanged" />
                            <label class="form-check-label" for="semAlcunhaCheckbox">
                                Sem alcunha (recém-entrada)
                            </label>
                            <small class="form-text text-muted d-block">
                                Marque esta opção para leitões sem alcunha definida. O email será usado como username.
                            </small>
                        </div>
                    </div>
                </div>
            }
            @* Fundador checkbox - only show for Tuno category *@
            @if (editingUser.SelectedCategory == "Tuno")
            {
                <div class="mb-3">
                    <div class="rtub-checkbox-wrapper">
                        <div class="form-check">
                            <InputCheckbox class="form-check-input rtub-checkbox-large" id="fundadorCheckbox" @bind-Value="isFundador" @bind-Value:after="OnFundadorChanged" />
                            <label class="form-check-label" for="fundadorCheckbox">
                                Fundador
                            </label>
                        </div>
                    </div>
                </div>
                <div class="mb-3">
                    <div class="rtub-checkbox-wrapper">
                        <div class="form-check">
                            <InputCheckbox class="form-check-input rtub-checkbox-large" id="tunoHonorarioCheckbox" @bind-Value="isTunoHonorario" @bind-Value:after="OnTunoHonorarioChanged" />
                            <label class="form-check-label" for="tunoHonorarioCheckbox">
                                Tuno Honorário
                            </label>
                        </div>
                    </div>
                </div>
            }
            <div class="row">
                @if (showYearLeitao && !isFundador && !isTunoHonorario)
                {
                    <div class="col-md-4 mb-3">
                        @{
                            var leitaoComplete = !isCreateMode && IsDatePairComplete(editingUser.YearLeitao, editingUser.MonthLeitao);
                            var leitaoDisabled = leitaoComplete && !CanEditDates;
                        }
                        <MonthYearPicker Label="Entrada a Leitão"
                                         Icon="calendar-plus"
                                         @bind-Year="@editingUser.YearLeitao"
                                         @bind-Month="@editingUser.MonthLeitao"
                                         @bind-Value="LeitaoDate"
                                         Disabled="@leitaoDisabled"
                                         HelpText="@(leitaoDisabled ? "Não podes alterar as datas. Se estão em erro, contacta o Magister." : null)" />
                    </div>
                }

                @if (showYearCaloiro && !isFundador && !isTunoHonorario)
                {
                    <div class="col-md-4 mb-3">
                        @{
                            var caloiroComplete = !isCreateMode && IsDatePairComplete(editingUser.YearCaloiro, editingUser.MonthCaloiro);
                            var caloiroDisabled = caloiroComplete && !CanEditDates;
                        }
                        <MonthYearPicker Label="Passagem a Caloiro"
                                         Icon="calendar-event"
                                         @bind-Year="@editingUser.YearCaloiro"
                                         @bind-Month="@editingUser.MonthCaloiro"
                                         @bind-Value="CaloiroDate"
                                         Disabled="@caloiroDisabled"
                                         HelpText="@(caloiroDisabled ? "Não podes alterar as datas. Se estão em erro, contacta o Magister." : null)" />
                    </div>
                }

                @if (showYearTuno && !isFundador)
                {
                    <div class="col-md-4 mb-3">
                        @{
                            var tunoComplete = !isCreateMode && IsDatePairComplete(editingUser.YearTuno, editingUser.MonthTuno);
                            var tunoDisabled = tunoComplete && !CanEditDates;
                        }
                        <MonthYearPicker Label="Passagem a Tuno"
                                         Icon="calendar-check"
                                         @bind-Year="@editingUser.YearTuno"
                                         @bind-Month="@editingUser.MonthTuno"
                                         @bind-Value="TunoDate"
                                         Disabled="@tunoDisabled"
                                         HelpText="@(tunoDisabled ? "Não podes alterar as datas. Se estão em erro, contacta o Magister." : null)" />
                    </div>
                }
            </div>
            
            @* Multiple Instruments Management *@
            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <i class="bi bi-music-note-list text-primary me-2"></i>Instrumentos
                </label>

                @* Add Instrument Section *@
                <div class="d-flex flex-column flex-sm-row align-items-stretch align-items-sm-end gap-2 mb-2">
                    <select class="form-select flex-grow-1" @bind-value="selectedInstrumentToAdd" @bind-value:event="onchange">
                        <option value="">Selecionar instrumento...</option>
                        @foreach (var instrument in AllInstrumentTypes.Where(i => !memberInstruments.Any(mi => mi.InstrumentType == i)))
                        {
                            <option value="@instrument" @key="instrument">@StatusHelper.GetInstrumentDisplay(instrument)</option>
                        }
                    </select>
                    <button type="button"
                            class="btn btn-primary btn-primary-purple flex-shrink-0"
                            @onclick="AddInstrumentToMember"
                            disabled="@(string.IsNullOrEmpty(selectedInstrumentToAdd))">
                        <i class="bi bi-plus-lg"></i> Adicionar
                    </button>
                </div>
                
                @* Display Instruments List *@
                @if (memberInstruments.Any())
                {
                    <div class="list-group">
                        @foreach (var memberInstrument in memberInstruments)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center" @key="memberInstrument.Id">
                                <div class="d-flex align-items-center gap-2">
                                    <input type="radio" 
                                           name="primaryInstrument" 
                                           class="form-check-input" 
                                           checked="@memberInstrument.IsPrimary"
                                           @onchange="@(() => MarkInstrumentAsPrimary(memberInstrument))"
                                           title="Marcar como principal" />
                                    <span>
                                        @StatusHelper.GetInstrumentDisplay(memberInstrument.InstrumentType)
                                        @if (memberInstrument.IsPrimary)
                                        {
                                            <span class="badge bg-primary ms-2">Principal</span>
                                        }
                                    </span>
                                </div>
                                <button type="button"
                                        class="btn btn-sm btn-danger"
                                        @onclick="@(() => RemoveInstrumentFromMember(memberInstrument))"
                                        title="Remover instrumento">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        }
                    </div>
                }
                else if (!isCreateMode)
                {
                    <EmptyState Title="Nenhum instrumento adicionado ainda" Icon="bi-music-note-list" />
                }
            </div>
            
            @* Only show Padrinho field for Caloiro or Tuno (not for Leitão, Fundador or Tuno Honorário) *@
            @if ((editingUser.SelectedCategory == "Caloiro" || editingUser.SelectedCategory == "Tuno") && !isFundador && !isTunoHonorario)
            {
                <div class="mb-3">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <label class="form-label d-flex align-items-center gap-2 mb-0">
                            <i class="bi bi-person-hearts text-primary"></i>
                            <span>Padrinho</span>
                        </label>
                    </div>
                    <div class="mentor-search-container">
                        <SearchBar @bind-Value="mentorSearchTerm"
                                   Placeholder="Pesquisar padrinho por nome ou alcunha..."
                                   OnSearch="OnMentorSearch"
                                   OnClear="ClearMentorSelection"
                                   Compact="true" />
                    </div>
                    
                    @if (filteredMentors.Any())
                    {
                        <div class="member-list member-list-scrollable">
                            @foreach (var mentor in filteredMentors.Take(20))
                            {
                                <div class="member-item p-2 mb-2 border rounded clickable-row" @key="mentor.Id"
                                     @onclick="() => SelectMentor(mentor)">
                                    <div class="d-flex align-items-center">
                                        <img src="@mentor.ProfilePictureSrc" alt="@mentor.GetDisplayName()"
                                             class="member-avatar-small me-2" />
                                        <div>
                                            @if (!string.IsNullOrEmpty(mentor.Nickname))
                                            {
                                                <div><strong>@mentor.Nickname</strong></div>
                                                <div class="text-muted small">@mentor.FirstName @mentor.LastName</div>
                                            }
                                            else
                                            {
                                                <div><strong>@mentor.FirstName @mentor.LastName</strong></div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(mentorSearchTerm) && string.IsNullOrEmpty(editingUser.MentorId))
                    {
                        <div class="alert alert-purple mt-2">Nenhum padrinho encontrado.</div>
                    }

                    @if (!string.IsNullOrEmpty(editingUser.MentorId))
                    {
                        // Use cached mentor to avoid repeated lookups on every render
                        var displayMentor = selectedMentorCache ?? eligibleMentors.FirstOrDefault(m => m.Id == editingUser.MentorId);
                        if (displayMentor != null)
                        {
                            <div class="alert alert-purple mt-2">
                                <strong>Padrinho Selecionado:</strong> @displayMentor.GetDisplayName()
                            </div>
                        }
                    }
                </div>
            }
        </EditForm>
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="CloseEditModal" disabled="@isSaving">Cancelar</button>
        <button type="button" class="btn btn-primary btn-primary-purple" @onclick="HandleSaveClick" disabled="@isSaving">
            @if (isSaving)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
            }
            Guardar
        </button>
    </FooterContent>
</Modal>

<!-- Delete Confirmation Modal -->
<ConfirmDialog Show="@modals.IsOpen(ModalType.Delete)"
               ShowChanged="@((bool show) => { if (show) modals.Open(ModalType.Delete); else modals.Close(ModalType.Delete); })"
               Title="Confirmar Eliminação"
               Message="@($"Tem certeza que deseja eliminar {deletingUser?.GetDisplayName()}?")"
               WarningMessage="Esta ação não pode ser desfeita."
               ConfirmText="Eliminar"
               CancelText="Cancelar"
               ConfirmButtonClass="btn-danger"
               OnConfirm="DeleteMember"
               OnCancel="CloseDeleteModal" />

<!-- Expel Confirmation Modal -->
<ConfirmDialog Show="@modals.IsOpen(ModalType.ExpelConfirm)"
               ShowChanged="@((bool show) => { if (show) modals.Open(ModalType.ExpelConfirm); else modals.Close(ModalType.ExpelConfirm); })"
               Title="Expulsar Membro"
               Message="@($"Tem certeza que deseja expulsar {expellingUser?.GetDisplayName()}? O membro não conseguirá fazer login.")"
               WarningMessage="O membro pode ser reativado mais tarde."
               ConfirmText="Expulsar"
               CancelText="Cancelar"
               ConfirmButtonClass="btn-danger"
               OnConfirm="ExpelMemberAsync"
               OnCancel="CloseExpelConfirmModal"
               Disabled="@isExpelling" />

<!-- Reactivate Confirmation Modal -->
<ConfirmDialog Show="@modals.IsOpen(ModalType.ReactivateConfirm)"
               ShowChanged="@((bool show) => { if (show) modals.Open(ModalType.ReactivateConfirm); else modals.Close(ModalType.ReactivateConfirm); })"
               Title="Reativar Membro"
               Message="@($"Tem certeza que deseja reativar {reactivatingUser?.GetDisplayName()}? O membro poderá fazer login novamente.")"
               ConfirmText="Reativar"
               CancelText="Cancelar"
               ConfirmButtonClass="btn-success"
               OnConfirm="ReactivateMemberAsync"
               OnCancel="CloseReactivateConfirmModal"
               Disabled="@isReactivating" />

<!-- View Details Modal -->
@if (viewingUser != null)
{
    <Modal Show="@modals.IsOpen(ModalType.ViewDetails)"
           ShowChanged="OnViewDetailsModalChanged"
           Title="Detalhes do Membro"
           Size="Modal.ModalSize.Large"
           Centered="true"
           OnClose="CloseViewDetailsModal">
        <BodyContent>
            <!-- Centered Header Section -->
            <div class="text-center mb-4">
                <img src="@viewingUser.ProfilePictureSrc" alt="@viewingUser.GetDisplayName()"
                     class="member-avatar-large mb-3" />
                
                @if (!string.IsNullOrEmpty(viewingUser.Nickname))
                {
                    <h4 class="mb-1">@viewingUser.Nickname</h4>
                    <p class="text-muted mb-2">@viewingUser.FirstName @viewingUser.LastName</p>
                }
                else
                {
                    <h4 class="mb-2">@viewingUser.FirstName @viewingUser.LastName</h4>
                }
                
                <!-- Badges centered below name -->
                <div class="d-flex justify-content-center flex-wrap gap-1 mb-2">
                    @{
                        var displayCategories = StatusHelper.GetDisplayCategories(viewingUser);
                    }
                    @foreach (var category in displayCategories)
                    {
                        <CategoryBadge @key="@($"category-{viewingUser.Id}-{category}")" Category="@category" />
                    }
                    @if (viewingUser.Positions.Any())
                    {
                        @foreach (var position in viewingUser.Positions)
                        {
                            <PositionBadge @key="position" Position="position" />
                        }
                    }
                </div>
            </div>

            <div class="mb-3"></div>

            <!-- Personal Information Section -->
            <div class="modal-info-section mb-4">
                <div class="modal-section-header">
                    <h6 class="modal-section-title">
                        <i class="bi bi-person-fill me-2 text-primary"></i>
                        Informações Pessoais
                    </h6>
                </div>
                <div class="modal-section-body">
                    <ProfileField Label="Email" Value="@viewingUser.Email" Icon="bi-envelope-fill" />
                    <ProfileField Label="Contacto" Value="@viewingUser.PhoneNumber" Icon="bi-telephone-fill" />
                    <ProfileField Label="Cidade" Value="@viewingUser.City" Icon="bi-geo-alt-fill" />
                    <ProfileField Label="Data de Nascimento"
                                Value="@(viewingUser.DateOfBirth.HasValue ? viewingUser.DateOfBirth.Value.ToString("dd/MM/yyyy") + (viewingUser.Age.HasValue ? $" ({viewingUser.Age} anos)" : "") : null)"
                                Icon="bi-calendar-event-fill" />
                    <ProfileField Label="Curso" Value="@viewingUser.Degree" Icon="bi-mortarboard-fill" />
                </div>
            </div>

            <!-- Tuna Information Section -->
            <div class="modal-info-section mb-3">
                <div class="modal-section-header">
                    <h6 class="modal-section-title">
                        <i class="bi bi-music-note-list me-2 text-primary"></i>
                        Informação da Tuna
                    </h6>
                </div>
                <div class="modal-section-body">
                    @* Display all instruments with primary indicator - hide for Tuno Honorários *@
                    @if (!viewingUser.Categories.Contains(MemberCategory.TunoHonorario))
                    {
                        @if (viewingUserInstruments != null && viewingUserInstruments.Any())
                        {
                            <ProfileField Label="Instrumentos" Icon="bi-music-note-beamed">
                                <ValueContent>
                                    @string.Join(", ", viewingUserInstruments
                                        .OrderByDescending(i => i.IsPrimary)
                                        .Select(i => StatusHelper.GetInstrumentDisplay(i.InstrumentType) + (i.IsPrimary ? " (Principal)" : "")))
                                </ValueContent>
                            </ProfileField>
                        }
                        else
                        {
                            <ProfileField Label="Instrumentos" Value="@null" Icon="bi-music-note-beamed" />
                        }
                    }
                    
                    @* Hide Padrinho for Fundador, Tuno Honorário, and Leitões *@
                    @if (!viewingUser.IsFundador() && 
                         !viewingUser.Categories.Contains(MemberCategory.TunoHonorario) &&
                         !viewingUser.Categories.Contains(MemberCategory.Leitao))
                    {
                        <ProfileField Label="Padrinho"
                                    Value="@(viewingUserMentor != null ? viewingUserMentor.GetDisplayName() : null)"
                                    Icon="bi-person-heart" />
                    }
                    
                    <!-- Unified Timeline -->
                    <ProfileField Label="Percurso na Tuna" Icon="bi-signpost-2">
                        <ValueContent>
                            @if (userRoleAssignments.ContainsKey(viewingUser.Id))
                            {
                                <UnifiedTimeline User="@viewingUser" RoleAssignments="@userRoleAssignments[viewingUser.Id]" />
                            }
                            else
                            {
                                <UnifiedTimeline User="@viewingUser" RoleAssignments="@(new List<RoleAssignment>())" />
                            }
                        </ValueContent>
                    </ProfileField>

                </div>
            </div>

            <!-- Estado na Tuna Section - hide for Tuno Honorários -->
            @{
                var isActiveMember = viewingUser.Categories.Contains(MemberCategory.Leitao) ||
                                    viewingUser.Categories.Contains(MemberCategory.Caloiro) ||
                                    viewingUser.Categories.Contains(MemberCategory.Tuno) ||
                                    viewingUser.Categories.Contains(MemberCategory.Veterano) ||
                                    viewingUser.Categories.Contains(MemberCategory.Tunossauro);
                var isTunoHonorario = viewingUser.Categories.Contains(MemberCategory.TunoHonorario);
                var isLeitao = viewingUser.Categories.Contains(MemberCategory.Leitao);
                var statusResult = viewingUserStatusData.GetValueOrDefault(viewingUser.Id);
                var hasActivityHistory = statusResult?.HasAnyActivity ?? false;
            }
            @if (isActiveMember && !isTunoHonorario && hasActivityHistory)
            {
                <div class="modal-info-section mb-3">
                    <div class="modal-section-header">
                        <h6 class="modal-section-title">
                            <i class="bi bi-flag-fill me-2 text-primary"></i>
                            Estado na Tuna
                        </h6>
                    </div>
                    <div class="modal-section-body">
                        @if (hasActivityHistory)
                        {
                            @* Hide "Estado atual" field for Leitões, but show for others *@
                            @if (!isLeitao)
                            {
                                <ProfileField Label="Estado atual" Value="badge" Icon="bi-flag-fill">
                                    <ValueContent>
                                        <div class="d-flex flex-column gap-2">
                                            <div>
                                                @if (statusResult?.IsRetired ?? viewingUser.IsRetired)
                                                {
                                                    <span class="badge badge-retired"
                                                          title="Reformados: transitam para esta categoria os Associados Efectivos que por motivos profissionais ou pessoais, se encontrem afastados, por um período de seis meses ou superior, das actividades da RTUB. Poderão retornar à sua categoria após três meses de actividade ininterrupta.">
                                                        REFORMADO
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-active">
                                                        NO ATIVO
                                                    </span>
                                                }
                                            </div>
                                            @* Progress indicator *@
                                            @if (statusResult is { } statusResultValue && ShouldShowProgressStatus(statusResultValue))
                                            {
                                                <div class="small text-muted">
                                                    <i class="bi bi-clock-history me-1"></i>@statusResultValue.ProgressDescription
                                                </div>
                                                @if (statusResultValue.ProgressMonths.HasValue && statusResultValue.ProgressTotalMonths.HasValue)
                                                {
                                                    <div class="progress progress-compact">
                                                        <div class="progress-bar bg-primary" 
                                                             role="progressbar" 
                                                             style="width: @((statusResultValue.ProgressMonths.Value * 100.0 / statusResultValue.ProgressTotalMonths.Value).ToString("F0"))%"
                                                             aria-valuenow="@statusResultValue.ProgressMonths.Value" 
                                                             aria-valuemin="0" 
                                                             aria-valuemax="@statusResultValue.ProgressTotalMonths.Value">
                                                        </div>
                                                    </div>
                                                }
                                            }
                                        </div>
                                    </ValueContent>
                                </ProfileField>
                            }
                            
                            @* Encouragement note for retired members at 2/3 progress *@
                            @if (statusResult is { } statusValue && ShouldShowReactivationEncouragement(statusValue))
                            {
                                <div class="alert alert-purple mt-2">
                                    <i class="bi bi-info-circle me-2"></i>
                                    <strong>Participa numa atividade este mês para voltares ao ativo!</strong>
                                </div>
                            }

                            <ProfileField Label="Último ensaio"
                                          Icon="bi-music-note-list"
                                          Value="@(statusResult?.LastRehearsalDate.HasValue == true
                                              ? statusResult.LastRehearsalDate.Value.ToString("dd MMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("pt-PT"))
                                              : null)" />

                            <ProfileField Label="Última atuação"
                                          Icon="bi-megaphone-fill"
                                          Value="@(statusResult?.LastEventDate.HasValue == true
                                              ? statusResult.LastEventDate.Value.ToString("dd MMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("pt-PT"))
                                              : null)" />
                        }
                        
                        @* Collapsible Attended Activities Section *@
                        @if (viewingUserAttendedActivities != null)
                        {
                            <div class="mt-3 section-divider">
                                <div class="d-flex justify-content-between align-items-center section-header-clickable" 
                                     @onclick="ToggleViewingUserActivitiesExpanded">
                                    <h6 class="mb-0">
                                        <i class="bi bi-list-ul me-2 text-primary"></i>
                                        Ver atuações e ensaios detalhados
                                    </h6>
                                    <i class="bi @(isViewingUserActivitiesExpanded ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                </div>
                                
                                @if (isViewingUserActivitiesExpanded)
                                {
                                    <div class="mt-3 scrollable-container">
                                        @if (viewingUserAttendedActivities.Any())
                                        {
                                            <div class="list-group">
                                                @foreach (var activity in viewingUserAttendedActivities)
                                                {
                                                    <div class="list-group-item d-flex justify-content-between align-items-start activity-list-item">
                                                        <div class="flex-grow-1">
                                                            <div class="d-flex align-items-center mb-1">
                                                                <i class="bi @(activity.IsRehearsal ? "bi-music-note-list" : "bi-calendar-event-fill") me-2"></i>
                                                                <strong>@activity.Name</strong>
                                                            </div>
                                                            <div class="text-muted small">
                                                                <i class="bi bi-calendar3 me-1"></i>
                                                                @activity.Date.ToString("dd/MM/yyyy")
                                                                <span class="ms-2">
                                                                    <i class="bi bi-tag me-1"></i>
                                                                    @activity.Type
                                                                </span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <p class="text-muted text-center py-3">Nenhuma atividade registada</p>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </BodyContent>
        <FooterContent>
            <button type="button" class="btn btn-secondary" @onclick="CloseViewDetailsModal">Fechar</button>
        </FooterContent>
    </Modal>
}

<!-- Set Nickname Modal -->
    <Modal Show="@modals.IsOpen(ModalType.SetNickname)" 
       ShowChanged="@((bool show) => { if (show) modals.Open(ModalType.SetNickname); else modals.Close(ModalType.SetNickname); })"
       Title="Definir Alcunha" 
       Size="Modal.ModalSize.Default"
       Centered="true">
    <BodyContent>
        @if (nicknameSettingUser != null)
        {
            <div class="mb-3">
                <p class="text-muted">
                    <strong>Membro:</strong> @nicknameSettingUser.FirstName @nicknameSettingUser.LastName
                </p>
                <p class="text-muted">
                    <strong>Email:</strong> @nicknameSettingUser.Email
                </p>
            </div>
            
            <EditForm Model="@nicknameForm" OnValidSubmit="SaveNickname" @ref="nicknameEditForm">
                <DataAnnotationsValidator />
                <ErrorDisplay />
                
                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-star text-primary me-2"></i>Nome de Tuna <span class="text-danger">*</span>
                    </label>
                    <InputText class="form-control" @bind-Value="nicknameForm.Nickname" placeholder="Introduza a alcunha..." />
                    <small class="form-text text-muted">
                        O username será gerado automaticamente a partir da alcunha.
                    </small>
                </div>
                
                @if (!string.IsNullOrEmpty(nicknameForm.Nickname))
                {
                    <div class="alert alert-purple">
                        Novo username: <strong>@UsernameHelper.NormalizeUsername(nicknameForm.Nickname)</strong>
                    </div>
                }
            </EditForm>
        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="CloseSetNicknameModal" disabled="@isSavingNickname">Cancelar</button>
        <button type="button" class="btn btn-primary btn-primary-purple" @onclick="HandleSaveNicknameClick" disabled="@isSavingNickname">
            @if (isSavingNickname)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
            }
            Guardar
        </button>
    </FooterContent>
</Modal>

<!-- Active Members Management Modal -->
    <Modal Show="@modals.IsOpen(ModalType.ActiveMembersManagement)"
       ShowChanged="@((bool show) => { if (show) modals.Open(ModalType.ActiveMembersManagement); else modals.Close(ModalType.ActiveMembersManagement); })"
       Title="Gestão de Membros Ativos"
       Size="Modal.ModalSize.ExtraLarge"
       Centered="true">
    <BodyContent>
        <LoadableContent Items="@allActiveMembers" IsLoading="@activeMembersLoading"
                        EmptyTitle="Nenhum membro ativo encontrado"
                        EmptyMessage="Não há membros ativos (Caloiro, Tuno, Veterano, Tunossauro)."
                        EmptyIcon="bi-person-badge">
            <ChildContent>
            <div class="d-flex flex-column flex-sm-row gap-2 mb-3">
                <div class="flex-grow-1">
                    <SearchBar @bind-Value="activeMembersSearchTerm"
                               Placeholder="Pesquisar membros por nome ou alcunha..."
                               OnSearch="ApplyActiveMembersSearch" />
                </div>
                <div class="flex-sm-shrink-0 filter-dropdown-container">
                    <FilterDropdown SelectedValue="@activeMembersStatusFilter"
                                    SelectedValueChanged="@(value => activeMembersStatusFilter = value)"
                                    OnChange="@ApplyActiveMembersStatusFilter"
                                    AllItemsLabel="Estado"
                                    Options="@activeMembersStatusFilterOptions" />
                </div>
            </div>
            <div class="member-card-lite-grid">
                @foreach (var memberData in paginatedActiveMembers)
                {
                    var member = memberData.Member;
                    var statusData = memberData.StatusData;
                    var instrumentText = userPrimaryInstruments.ContainsKey(member.Id) ? userPrimaryInstruments[member.Id] : "-";
                    var rehearsalText = statusData?.LastRehearsalDate.HasValue == true
                        ? statusData.LastRehearsalDate.Value.ToString("dd MMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("pt-PT"))
                        : "-";
                    var eventText = statusData?.LastEventDate.HasValue == true
                        ? statusData.LastEventDate.Value.ToString("dd MMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("pt-PT"))
                        : "-";
                    var progressText = statusData is { } statusDataValue && ShouldShowProgressStatus(statusDataValue)
                        ? statusDataValue.ProgressDescription
                        : string.Empty;
                    var showEncouragement = statusData != null && ShouldShowReactivationEncouragement(statusData);
                    var isRetired = statusData?.IsRetired ?? member.IsRetired;
                    <MemberCardLite @key="member.Id"
                                    AvatarUrl="@member.ProfilePictureSrc"
                                    AltText="@member.Nickname"
                                    Nickname="@member.Nickname"
                                    FullName="@($"{member.FirstName} {member.LastName}")"
                                    InstrumentText="@instrumentText"
                                    LastRehearsalText="@rehearsalText"
                                    LastEventText="@eventText"
                                    ProgressText="@progressText">
                        <ActionContent>
                            @if (statusData?.IsRetired == true || (statusData == null && member.IsRetired))
                            {
                                <button type="button" 
                                        class="member-card-lite-action-btn" 
                                        title="Tornar este membro ativo"
                                        @onclick="() => OpenMakeActiveConfirmModal(member)">
                                    <i class="bi bi-person-check-fill"></i>
                                </button>
                            }
                            @if (showEncouragement && isAdmin)
                            {
                                <button type="button" 
                                        class="member-card-lite-action-btn" 
                                        title="Enviar notificação push de lembrete"
                                        @onclick="() => SendReminderPushNotification(member)">
                                    <i class="bi bi-bell text-white"></i>
                                </button>
                            }
                        </ActionContent>
                        <StatusContent>
                            @if (statusData?.IsRetired == true || (statusData == null && member.IsRetired))
                            {
                                <span class="badge badge-retired">REFORMADO</span>
                            }
                            else
                            {
                                <span class="badge badge-active">NO ATIVO</span>
                            }
                        </StatusContent>
                        <EncouragementContent>
                            @if (showEncouragement)
                            {
                                <div class="alert alert-purple mb-0 mt-2 small">
                                    <i class="bi bi-info-circle me-1"></i>
                                    <strong>Participa numa atividade este mês para voltares ao ativo!</strong>
                                </div>
                            }
                        </EncouragementContent>
                    </MemberCardLite>
                }
            </div>

            <!-- Pagination -->
            <TablePagination CurrentPage="@activeMembersPaginationHelper.CurrentPage"
                            PageSize="@activeMembersPaginationHelper.PageSize"
                            TotalItems="@filteredActiveMembers.Count"
                            ItemLabel="membros"
                            PageSizeOptions="@(new[] { 12, 24, 36, 48, 60 })"
                            OnPageChanged="ChangeActiveMembersPage"
                            OnPageSizeChanged="ChangeActiveMembersPageSize" />
            </ChildContent>
        </LoadableContent>
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="CloseActiveMembersManagementModal">Fechar</button>
    </FooterContent>
</Modal>

<!-- Make Active Confirmation Modal -->
<ConfirmDialog Show="@modals.IsOpen(ModalType.MakeActiveConfirm)"
               ShowChanged="@((bool show) => { if (show) modals.Open(ModalType.MakeActiveConfirm); else modals.Close(ModalType.MakeActiveConfirm); })"
               Title="Tornar Membro Ativo"
               Message="@($"Tem certeza que deseja tornar {memberToMakeActive?.GetDisplayName()} ativo? Isto irá resetar o estado de reforma e permitir que o membro participe sem necessidade de 3 meses consecutivos de atividade.")"
               ConfirmText="Tornar Ativo"
               CancelText="Cancelar"
               ConfirmButtonClass="btn-primary btn-primary-purple"
               OnConfirm="MakeActiveAsync"
               OnCancel="CloseMakeActiveConfirmModal"
               Disabled="@isMakingActive" />

<!-- Anniversaries Modal -->
<Modal Show="@modals.IsOpen(ModalType.Anniversaries)"
       ShowChanged="@((bool show) => { if (show) modals.Open(ModalType.Anniversaries); else modals.Close(ModalType.Anniversaries); })"
       Title="Aniversários dos Membros"
       Size="Modal.ModalSize.ExtraLarge"
       Centered="true">
    <BodyContent>
        <LoadableContent Items="@allAnniversaries" IsLoading="@anniversariesLoading"
                        EmptyTitle="Nenhum aniversário encontrado"
                        EmptyMessage="Não há membros com data de nascimento registada."
                        EmptyIcon="bi-cake2">
            <ChildContent>
            <SearchBar @bind-Value="anniversariesSearchTerm"
                       Placeholder="Pesquisar aniversariantes por nome ou alcunha..."
                       OnSearch="ApplyAnniversariesSearch" />
            <div class="member-card-lite-grid">
                @foreach (var member in paginatedAnniversaries)
                {
                    var birthdayText = member.DateOfBirth.HasValue
                        ? member.DateOfBirth.Value.ToString("dd/MM")
                        : "-";
                    var birthdayBadgeDate = member.DateOfBirth.HasValue
                        ? new DateTime(DateTime.Now.Year, member.DateOfBirth.Value.Month, member.DateOfBirth.Value.Day)
                        : (DateTime?)null;
                    var ageText = member.DateOfBirth.HasValue
                        ? (DateTime.Now.Year - member.DateOfBirth.Value.Year).ToString()
                        : "-";
                    <MemberCardLite @key="member.Id"
                                    AvatarUrl="@member.ProfilePictureSrc"
                                    AltText="@member.Nickname"
                                    Nickname="@member.Nickname"
                                    FullName="@($"{member.FirstName} {member.LastName}")"
                                    AgeText="@ageText"
                                    CityText="@(member.City ?? "-")">
                        <CategoryContent>
                            @if (member.Categories != null && member.Categories.Any())
                            {
                                foreach (var category in member.Categories)
                                {
                                    <CategoryBadge @key="@($"category-{member.Id}-{category}")" Category="@category" />
                                }
                            }
                        </CategoryContent>
                        <BirthdayContent>
                            <span>@birthdayText</span>
                            @if (birthdayBadgeDate.HasValue)
                            {
                                <DateBadge Date="@birthdayBadgeDate.Value" />
                            }
                        </BirthdayContent>
                    </MemberCardLite>
                }
            </div>

            <!-- Pagination -->
            <TablePagination CurrentPage="@anniversariesPaginationHelper.CurrentPage"
                            PageSize="@anniversariesPaginationHelper.PageSize"
                            TotalItems="@filteredAnniversaries.Count"
                            ItemLabel="membros"
                            PageSizeOptions="@(new[] { 12, 24, 36, 48, 60 })"
                            OnPageChanged="ChangeAnniversariesPage"
                            OnPageSizeChanged="ChangeAnniversariesPageSize" />
            </ChildContent>
        </LoadableContent>
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="CloseAnniversariesModal">Fechar</button>
    </FooterContent>
</Modal>

<!-- Birthday Notification Confirmation Modal -->
<ConfirmDialog Show="@modals.IsOpen(ModalType.BirthdayEmail)"
               ShowChanged="@((bool show) => { if (show) modals.Open(ModalType.BirthdayEmail); else modals.Close(ModalType.BirthdayEmail); })"
               Title="Enviar notificação de aniversário?"
               ConfirmText="Sim"
               CancelText="Não"
               ConfirmButtonClass="btn-primary"
               OnConfirm="@SendBirthdayNotification"
               OnCancel="@CloseBirthdayEmailModal"
               Size="Modal.ModalSize.Large"
               Disabled="@IsSendingEmails">
    <BodyContent>
        @if (selectedUserForBirthday != null)
        {
            <!-- Loading Overlay for Sending Birthday Emails -->
            @if (IsSendingEmails)
            {
                <div class="position-relative loading-overlay-container">
                    <div class="position-absolute top-0 start-0 w-100 h-100 d-flex flex-column align-items-center justify-content-center loading-overlay-backdrop">
                        <div class="spinner-border text-primary mb-3 spinner-large" role="status">
                            <span class="visually-hidden">A enviar...</span>
                        </div>
                        <h5 class="text-white mb-2">Enviando emails de aniversário...</h5>
                        <p class="text-white-full mb-0">
                            @EmailsSent / @EmailsTotal
                            @if (!string.IsNullOrEmpty(LastRecipient))
                            {
                                <span> (último: @LastRecipient)</span>
                            }
                        </p>
                    </div>
                </div>
            }
            
            <div class="mb-3">
                <h6 class="text-white-full">Detalhes do Aniversariante:</h6>
                <div class="event-summary p-3 rounded bg-dark">
                    <div><strong>Nome:</strong> @selectedUserForBirthday.Nickname (@selectedUserForBirthday.FirstName @selectedUserForBirthday.LastName)</div>
                    @if (selectedUserForBirthday.DateOfBirth.HasValue)
                    {
                        <div><strong>Data de Nascimento:</strong> @selectedUserForBirthday.DateOfBirth.Value.ToString("dd/MM/yyyy")</div>
                    }
                </div>
            </div>

            @if (birthdayEmailLoadingSubscribers)
            {
                <LoadingSpinner Message="A carregar subscritores..." />
            }
            else if (!string.IsNullOrEmpty(birthdayEmailErrorMessage))
            {
                <Alert Message="@birthdayEmailErrorMessage" 
                       Type="Alert.AlertType.Error" 
                       Dismissible="true"
                       OnDismiss="@(() => birthdayEmailErrorMessage = null)" />
            }
            else
            {
                <div class="mb-3">
                    <span class="badge bg-purple text-white p-2">
                        @($"{birthdaySubscribedUsersCount} membros têm 'Notificações por email' ativas e irão receber esta mensagem.")
                    </span>
                </div>

                @if (birthdaySubscribedUsers != null && birthdaySubscribedUsers.Any())
                {
                    <div class="mb-3">
                        <h6 class="text-white-full mb-2">Membros que irão receber:</h6>
                        <div class="subscriber-list subscriber-list-scrollable">
                            @foreach (var user in birthdaySubscribedUsers)
                            {
                                <div class="subscriber-item p-2 mb-1 rounded bg-dark text-white-full" @key="user.Id">
                                    @(user.Nickname ?? $"{user.FirstName} {user.LastName}")
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
