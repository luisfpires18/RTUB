    private async Task SaveNickname()
    {
        if (isSavingNickname || nicknameSettingUser == null || string.IsNullOrEmpty(nicknameForm.Nickname))
        {
            return;
        }

        isSavingNickname = true;

        try
        {
            var user = await UserManager.FindByIdAsync(nicknameSettingUser.Id);
            if (user != null)
            {
                var oldUsername = user.UserName ?? "";
                var newUsername = UsernameHelper.NormalizeUsername(nicknameForm.Nickname);
                
                // Check if new username already exists
                var existingUser = await UserManager.FindByNameAsync(newUsername);
                if (existingUser != null && existingUser.Id != user.Id)
                {
                    // Show error message - username already exists
                    if (nicknameEditForm?.EditContext != null)
                    {
                        var validationStore = new ValidationMessageStore(nicknameEditForm.EditContext);
                        validationStore.Add(() => nicknameForm.Nickname!, $"Já existe um utilizador com o username '{newUsername}'.");
                        nicknameEditForm.EditContext.NotifyValidationStateChanged();
                    }
                    return;
                }
                
                // Update nickname and username
                user.Nickname = nicknameForm.Nickname;
                user.UserName = newUsername;
                
                await SetAuditContextToCurrentUser();
                var result = await UserManager.UpdateAsync(user);
                
                if (result.Succeeded)
                {
                    // Send email notification
                    await EmailNotificationService.SendUsernameChangedEmailAsync(
                        user.Email ?? "",
                        $"{user.FirstName} {user.LastName}",
                        user.Nickname,
                        oldUsername,
                        newUsername);
                    
                    // Reload members to reflect changes
                    await LoadMembers();
                    CloseSetNicknameModal();
                }
                else
                {
                    if (nicknameEditForm?.EditContext != null)
                    {
                        var validationStore = new ValidationMessageStore(nicknameEditForm.EditContext);
                        foreach (var error in result.Errors)
                        {
                            validationStore.Add(() => nicknameForm.Nickname!, error.Description);
                        }
                        nicknameEditForm.EditContext.NotifyValidationStateChanged();
                    }
                }
            }
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error saving nickname for user {UserId}", nicknameSettingUser.Id);
            if (nicknameEditForm?.EditContext != null)
            {
                var validationStore = new ValidationMessageStore(nicknameEditForm.EditContext);
                validationStore.Add(() => nicknameForm.Nickname!, "Ocorreu um erro ao guardar a alcunha. Por favor, tente novamente.");
                nicknameEditForm.EditContext.NotifyValidationStateChanged();
            }
        }
        finally
        {
            isSavingNickname = false;
        }
    }
    
    /// <summary>
    /// Checks if a date pair (Year + Month) is complete.
    /// A date pair is considered complete when BOTH year AND month have values.
    /// Used to determine if date fields should be disabled for non-owner/non-magister users.
    /// </summary>
    private bool IsDatePairComplete(int? year, int? month)
    {
        return year.HasValue && month.HasValue;
    }
    
