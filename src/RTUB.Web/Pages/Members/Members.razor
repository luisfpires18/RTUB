    // Anniversaries modal methods
    
    /// <summary>
    /// Opens the anniversaries modal and loads birthday data
    /// </summary>
    private async Task OpenAnniversariesModal()
    {
        showAnniversariesModal = true;
        anniversariesLoading = true;
        anniversariesSearchTerm = string.Empty;
        StateHasChanged();
        
        try
        {
            // Get current date and year
            var today = DateTime.Now.Date;
            var currentYear = today.Year;
            
            // Get all users with birthdays
            var usersWithBirthdays = users?
                .Where(u => u.DateOfBirth.HasValue)
                .ToList() ?? new List<ApplicationUser>();
            
            // Filter to only show birthdays in current year that are today or in the future
            // Compute nextBirthday for each member and filter
            var filteredUsers = usersWithBirthdays
                .Select(u => new
                {
                    User = u,
                    NextBirthday = new DateTime(currentYear, u.DateOfBirth!.Value.Month, u.DateOfBirth.Value.Day)
                })
                .Where(x => x.NextBirthday >= today && x.NextBirthday.Year == currentYear)
                .ToList();
            
            // Sort by next anniversary (day/month) ascending, then by name
            allAnniversaries = filteredUsers
                .OrderBy(x => x.NextBirthday)
                .ThenBy(x => x.User.FirstName)
                .ThenBy(x => x.User.LastName)
                .Select(x => x.User)
                .ToList();

            // Reset pagination and apply search filter
            anniversariesPaginationHelper.CurrentPage = 1;
            ApplyAnniversariesSearch(anniversariesSearchTerm);
        }
        finally
        {
            anniversariesLoading = false;
            StateHasChanged();
        }
    }
    
    /// <summary>
    /// Closes the anniversaries modal
    /// </summary>
    private void CloseAnniversariesModal()
    {
        showAnniversariesModal = false;
        allAnniversaries.Clear();
        filteredAnniversaries.Clear();
        paginatedAnniversaries.Clear();
        anniversariesSearchTerm = string.Empty;
    }
    
    /// <summary>
    /// Updates the paginated anniversaries list
    /// </summary>
    private void UpdateAnniversariesPagination()
    {
        paginatedAnniversaries = anniversariesPaginationHelper.GetPageData(filteredAnniversaries);
    }
    
    /// <summary>
    /// Changes the current page in anniversaries modal
    /// </summary>
    private async Task ChangeAnniversariesPage(int newPage)
    {
        anniversariesPaginationHelper.CurrentPage = newPage;
        UpdateAnniversariesPagination();
        StateHasChanged();
        await Task.CompletedTask;
    }
    
    /// <summary>
    /// Changes the page size in anniversaries modal
    /// </summary>
    private async Task ChangeAnniversariesPageSize(int newPageSize)
    {
        anniversariesPaginationHelper.PageSize = newPageSize;
        anniversariesPaginationHelper.CurrentPage = 1; // Reset to first page
        UpdateAnniversariesPagination();
        StateHasChanged();
        await Task.CompletedTask;
    }

    private void ApplyAnniversariesSearch(string term)
    {
        anniversariesSearchTerm = term ?? string.Empty;

        if (string.IsNullOrWhiteSpace(anniversariesSearchTerm))
        {
            filteredAnniversaries = allAnniversaries;
        }
        else
        {
            anniversariesSearchHelper.SearchTerm = anniversariesSearchTerm;
            filteredAnniversaries = anniversariesSearchHelper.FilterMultiple(allAnniversaries, new List<Func<ApplicationUser, string>>
            {
                u => u.FirstName ?? string.Empty,
                u => u.LastName ?? string.Empty,
                u => $"{u.FirstName} {u.LastName}",
                u => u.Nickname ?? string.Empty
            }, caseSensitive: false, accentSensitive: false);
        }

        anniversariesPaginationHelper.CurrentPage = 1;
        UpdateAnniversariesPagination();
    }
    
    // Birthday email methods
    
    /// <summary>
    /// Checks if today is the user's birthday
    /// </summary>
    private bool IsBirthdayToday(ApplicationUser user)
    {
        if (!user.DateOfBirth.HasValue)
            return false;
        
        var today = DateTime.Now;
        return user.DateOfBirth.Value.Month == today.Month && 
               user.DateOfBirth.Value.Day == today.Day;
    }
    
    /// <summary>
    /// Initiates the birthday email sending process
    /// </summary>
    private async Task SendBirthdayEmail(ApplicationUser user)
    {
        if (!IsBirthdayToday(user))
        {
            return;
        }
        
        selectedUserForBirthday = user;
        birthdayEmailLoadingSubscribers = true;
        birthdayEmailErrorMessage = null;
        showBirthdayEmailModal = true;
        StateHasChanged();

        try
        {
            // Get all subscribed users with confirmed emails
            var subscribedUsers = await UserManager.Users
                .Where(u => u.Subscribed && u.EmailConfirmed && !string.IsNullOrEmpty(u.Email))
                .OrderBy(u => u.Nickname ?? u.FirstName)
                .AsNoTracking()
                .ToListAsync();
            
            birthdaySubscribedUsers = subscribedUsers;
            birthdaySubscribedUsersCount = subscribedUsers.Count;
        }
        catch (Exception ex)
        {
            birthdayEmailErrorMessage = $"Erro ao carregar membros: {ex.Message}";
        }
        finally
        {
            birthdayEmailLoadingSubscribers = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Closes the birthday email modal
    /// </summary>
    private void CloseBirthdayEmailModal()
    {
        showBirthdayEmailModal = false;
        selectedUserForBirthday = null;
        birthdaySubscribedUsers = null;
        birthdaySubscribedUsersCount = 0;
        birthdayEmailErrorMessage = null;
    }

    /// <summary>
    /// Sends the birthday notification email to subscribed users
    /// </summary>
    private async Task SendBirthdayNotification()
    {
        if (selectedUserForBirthday == null || birthdaySubscribedUsers == null || !birthdaySubscribedUsers.Any())
        {
            CloseBirthdayEmailModal();
            return;
        }

        // Initialize progress tracking
        IsSendingEmails = true;
        EmailsTotal = birthdaySubscribedUsers.Count;
        EmailsSent = 0;
        LastRecipient = null;
        birthdayEmailErrorMessage = null;
        
        StateHasChanged();

        try
        {
            var recipientEmails = birthdaySubscribedUsers
                .Where(u => !string.IsNullOrWhiteSpace(u.Email))
                .Select(u => u.Email!)
                .ToList();

            var recipientData = birthdaySubscribedUsers
                .Where(u => !string.IsNullOrWhiteSpace(u.Email))
                .ToDictionary(
                    u => u.Email!,
                    u => (u.Nickname ?? u.FirstName ?? "", $"{u.FirstName} {u.LastName}")
                );

            // Create progress reporter
            var progress = new Progress<EmailSendProgress>(update =>
            {
                EmailsTotal = update.Total;
                EmailsSent = update.Sent;
                LastRecipient = update.LastRecipient;
                StateHasChanged();
            });
            
            var (success, count, errorMessage) = await EmailNotificationService.SendBirthdayNotificationAsync(
                selectedUserForBirthday.Id,
                selectedUserForBirthday.Nickname ?? selectedUserForBirthday.FirstName ?? "",
                $"{selectedUserForBirthday.FirstName} {selectedUserForBirthday.LastName}",
                recipientEmails,
                recipientData,
                progress
            );
            
            if (success)
            {
                birthdayEmailErrorMessage = null;
                CloseBirthdayEmailModal();
            }
            else
            {
                birthdayEmailErrorMessage = errorMessage ?? "Erro ao enviar notificação.";
            }
        }
        catch (Exception ex)
        {
            birthdayEmailErrorMessage = $"Erro ao enviar email: {ex.Message}";
            _logger.LogError(ex, "Error sending birthday email");
        }
        finally
        {
            IsSendingEmails = false;
            StateHasChanged();
        }
    }
