    /// <summary>
    /// Expels a member, preventing them from logging in
    /// </summary>
    private async Task ExpelMemberAsync()
    {
        if (expellingUser == null || isExpelling)
        {
            return;
        }
        
        isExpelling = true;
        StateHasChanged();
        
        try
        {
            var userId = expellingUser.Id;
            
            await SetAuditContextToCurrentUser();
            
            var dbUser = await UserManager.FindByIdAsync(userId);
            if (dbUser != null)
            {
                dbUser.IsExpelled = true;
                var updateResult = await UserManager.UpdateAsync(dbUser);
                if (!updateResult.Succeeded)
                {
                    _logger.LogError("Failed to expel user {UserId}: {Errors}", 
                        userId, string.Join(", ", updateResult.Errors.Select(e => e.Description)));
                    return;
                }
                
                // Update local state
                expellingUser.IsExpelled = true;
                
                var userInList = users?.FirstOrDefault(u => u.Id == userId);
                if (userInList != null)
                {
                    userInList.IsExpelled = true;
                }
                
                // Reapply filters to update the display
                FilterMembers();
                
                _logger.LogInformation("Member {UserId} ({MemberName}) was expelled by admin", 
                    userId, expellingUser.GetDisplayName());
            }
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error expelling member {UserId}", expellingUser?.Id);
        }
        finally
        {
            isExpelling = false;
            CloseExpelConfirmModal();
            StateHasChanged();
        }
    }
    
    /// <summary>
    /// Reactivates an expelled member, allowing them to login again
    /// </summary>
    private async Task ReactivateMemberAsync()
    {
        if (reactivatingUser == null || isReactivating)
        {
            return;
        }
        
        isReactivating = true;
        StateHasChanged();
        
        try
        {
            var userId = reactivatingUser.Id;
            
            await SetAuditContextToCurrentUser();
            
            var dbUser = await UserManager.FindByIdAsync(userId);
            if (dbUser != null)
            {
                dbUser.IsExpelled = false;
                var updateResult = await UserManager.UpdateAsync(dbUser);
                if (!updateResult.Succeeded)
                {
                    _logger.LogError("Failed to reactivate user {UserId}: {Errors}", 
                        userId, string.Join(", ", updateResult.Errors.Select(e => e.Description)));
                    return;
                }
                
                // Update local state
                reactivatingUser.IsExpelled = false;
                
                var userInList = users?.FirstOrDefault(u => u.Id == userId);
                if (userInList != null)
                {
                    userInList.IsExpelled = false;
                }
                
                // Reapply filters to update the display
                FilterMembers();
                
                _logger.LogInformation("Member {UserId} ({MemberName}) was reactivated by admin", 
                    userId, reactivatingUser.GetDisplayName());
            }
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error reactivating member {UserId}", reactivatingUser?.Id);
        }
        finally
        {
            isReactivating = false;
            CloseReactivateConfirmModal();
            StateHasChanged();
        }
    }

