        if (leitoesIds.Any())
        {
            leitoesStatusData = await MemberStatusService.GetMemberStatusesBatchAsync(leitoesIds);
            
            // For any Leitões with null status (stale or missing), update their status to get fresh data
            foreach (var leitaoId in leitoesIds.Where(id => leitoesStatusData.GetValueOrDefault(id) == null))
