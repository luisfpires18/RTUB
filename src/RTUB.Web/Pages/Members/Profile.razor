    public class ChangePasswordModel
    {
        [Required(ErrorMessage = "A palavra-passe atual é obrigatória")]
        [DataType(DataType.Password)]
        public string OldPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "A nova palavra-passe é obrigatória")]
        [StringLength(100, MinimumLength = 8, ErrorMessage = "A palavra-passe deve ter pelo menos 8 caracteres")]
        [DataType(DataType.Password)]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "A confirmação da palavra-passe é obrigatória")]
        [DataType(DataType.Password)]
        [Compare("NewPassword", ErrorMessage = "A nova palavra-passe e a confirmação não coincidem.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var claimsPrincipal = authState.User;

        if (claimsPrincipal?.Identity?.IsAuthenticated == true)
        {
            // Try multiple ways to get the user identifier
            var userName = claimsPrincipal.Identity.Name;
            var nameIdentifierClaim = claimsPrincipal.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            var nameClaim = claimsPrincipal.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value;
            
            // Try to find by username first
            if (!string.IsNullOrEmpty(userName))
            {
                user = await UserManager.FindByNameAsync(userName);
            }
            
            // Try by name claim
            if (user == null && !string.IsNullOrEmpty(nameClaim))
            {
                user = await UserManager.FindByNameAsync(nameClaim);
                if (user == null)
                {
                    user = await UserManager.FindByEmailAsync(nameClaim);
                }
            }
            
            // Try by user ID from NameIdentifier claim
            if (user == null && !string.IsNullOrEmpty(nameIdentifierClaim))
            {
                user = await UserManager.FindByIdAsync(nameIdentifierClaim);
            }
            
            if (user != null)
            {
                // Load mentor if exists
                if (!string.IsNullOrEmpty(user.MentorId))
                {
                    mentor = await UserManager.FindByIdAsync(user.MentorId);
                }
                
                // Load eligible mentors (only Tuno category)
                eligibleMentors = UserManager.Users
                    .Where(u => u.Id != user.Id && u.Categories.Contains(MemberCategory.Tuno))
                    .OrderBy(u => u.FirstName)
                    .ThenBy(u => u.LastName)
                    .ToList();
                    
                // Load role assignments for this user
                var allAssignments = await RoleAssignmentService.GetAllRoleAssignmentsAsync();
                roleAssignments = allAssignments.Where(a => a.UserId == user.Id).ToList();
                
                // Load member instruments for display
                userInstrumentsForDisplay = (await MemberInstrumentService.GetMemberInstrumentsAsync(user.Id)).ToList();
                
                // Load ranking data - always display for all users
                rankProgress = await RankingService.GetRankProgressAsync(user.Id);
                
                // Load retirement status 
                try
                {
                    retirementStatusResult = await RetirementStatusService.EvaluateRetirementStatusAsync(user.Id);
                }
                catch
                {
                    retirementStatusResult = null;
                }
                
                // Load status data for active members (ALWAYS shown when there's activity)
                var isActiveMember = user.Categories.Contains(MemberCategory.Caloiro) || 
                                    user.Categories.Contains(MemberCategory.Tuno) ||
                                    user.Categories.Contains(MemberCategory.Veterano) ||
                                    user.Categories.Contains(MemberCategory.Tunossauro);
                
                if (isActiveMember)
                {
                    try
                    {
                        memberStatusResult = await MemberStatusService.GetMemberStatusAsync(user.Id);
                    }
                    catch
                    {
                        memberStatusResult = null;
                    }
                }
            }
        }
    }

    private void OpenUploadModal()
    {
        uploadMessage = null;
        profileImageFileName = null;
        selectedFile = null;
        showUploadModal = true;
    }

    private void CloseUploadModal()
    {
        showUploadModal = false;
        uploadMessage = null;
    }

    private async Task HandleImageUpload(InputFileChangeEventArgs e)
    {
        try
        {
            var imageFile = e.File;
            if (imageFile != null && user != null)
            {
                var maxFileSize = 10 * 1024 * 1024;
                if (imageFile.Size > maxFileSize)
                {
                    uploadMessage = "O tamanho do ficheiro deve ser inferior a 10MB.";
                    return;
                }

                selectedFile = imageFile;
                profileImageFileName = imageFile.Name;

                // Close upload modal and open cropper
                CloseUploadModal();

                if (imageCropper != null)
                {
                    await imageCropper.LoadImageAsync(selectedFile);
                }
            }
        }
        catch (Exception)
        {
            uploadMessage = "Erro ao carregar imagem. Por favor tente novamente.";
        }
    }

    private async Task OnImageCropped(byte[] croppedImageData)
    {
        try
        {
            if (user != null && croppedImageData != null && croppedImageData.Length > 0)
            {
                // Upload image to R2 storage and update user record
                using var stream = new MemoryStream(croppedImageData);
                await UserProfileService.UpdateProfilePictureAsync(user.Id, stream, "profile-picture.webp", "image/webp");

                // Reload user from database to get the updated ImageUrl
                var updatedUser = await UserManager.FindByIdAsync(user.Id);
                if (updatedUser != null)
                {
                    user.ImageUrl = updatedUser.ImageUrl;
                }
                
                imageRefreshTrigger++;
                
                uploadMessage = "Foto de perfil atualizada com sucesso!";
                StateHasChanged();
                
                // Notify MainLayout to reload user data
                ProfilePictureUpdateService.NotifyProfilePictureUpdated();
                
                // Update navbar via JavaScript as backup
                try
                {
                    var newImageUrl = user.ProfilePictureSrc ?? "/images/default-avatar.webp";
                    await JSRuntime.InvokeVoidAsync("profilePictureRefresh.refreshNavbarAvatar", newImageUrl);
                }
                catch
                {
                    // Silently fail - event service will handle update
                }
                
                // Clear success message after a delay
                await Task.Delay(2000);
                uploadMessage = null;
                StateHasChanged();
            }
        }
        catch (Exception)
        {
            uploadMessage = "Erro ao guardar imagem. Por favor tente novamente.";
            StateHasChanged();
        }
    }

    private string GetProfilePictureUrl()
    {
        if (user == null) return "/images/default-avatar.webp";
        
        // Return the profile picture URL directly - let ETags handle caching (304 responses)
        return user.ProfilePictureSrc ?? "/images/default-avatar.webp";
    }

    private void OnCropperModalChanged(bool isOpen)
    {
        showCropperModal = isOpen;
        StateHasChanged();
    }

    private async Task OpenEditSectionModal(string section)
    {
        if (user == null) return;

        editingSection = section;
        editUser = new ApplicationUser
        {
            Id = user.Id,
            FirstName = user.FirstName,
            LastName = user.LastName,
            Nickname = user.Nickname,
            Email = user.Email,
            PhoneNumber = user.PhoneNumber,
            City = user.City,
            DateOfBirth = user.DateOfBirth,
            Degree = user.Degree,
            YearLeitao = user.YearLeitao,
            MonthLeitao = user.MonthLeitao,
            YearCaloiro = user.YearCaloiro,
            MonthCaloiro = user.MonthCaloiro,
            YearTuno = user.YearTuno,
            MonthTuno = user.MonthTuno,
            MentorId = user.MentorId
        };
        
        // Initialize mentor search term and instruments if tuna section
        if (section == "tuna")
        {
            // Load member instruments
            memberInstruments = (await MemberInstrumentService.GetMemberInstrumentsAsync(user.Id)).ToList();
            selectedInstrumentToAdd = "";
            
            if (!string.IsNullOrEmpty(user.MentorId))
            {
                var existingMentor = eligibleMentors.FirstOrDefault(m => m.Id == user.MentorId);
                if (existingMentor != null)
                {
                    selectedMentorCache = existingMentor;
                    mentorSearchTerm = existingMentor.GetDisplayName();
                }
            }
            else
            {
                selectedMentorCache = null;
                mentorSearchTerm = "";
            }
        }
        else
        {
            selectedMentorCache = null;
            mentorSearchTerm = "";
        }
        
        filteredMentors.Clear();
        StateHasChanged();
    }

    private void CancelEdit()
    {
        editingSection = null;
        editUser = null;
        mentorSearchTerm = "";
        filteredMentors.Clear();
        selectedMentorCache = null;
        memberInstruments.Clear();
        selectedInstrumentToAdd = "";
    }

    private async Task AddInstrumentToMember()
    {
        if (string.IsNullOrEmpty(selectedInstrumentToAdd) || user == null)
            return;

        var instrumentType = Enum.Parse<InstrumentType>(selectedInstrumentToAdd);
        
        // Check if instrument already exists
        if (memberInstruments.Any(mi => mi.InstrumentType == instrumentType))
        {
            return;
        }

        try
        {
            await SetAuditContextToCurrentUser();
            var newInstrument = await MemberInstrumentService.AddInstrumentAsync(
                user.Id!, 
                instrumentType, 
                !memberInstruments.Any() // First instrument becomes primary
            );
            memberInstruments.Add(newInstrument);
        }
        catch (InvalidOperationException)
        {
            // Instrument already exists
            return;
        }

        selectedInstrumentToAdd = "";
        StateHasChanged();
    }

    private async Task RemoveInstrumentFromMember(MemberInstrument instrument)
    {
        if (user == null) return;
        
        try
        {
            await SetAuditContextToCurrentUser();
            
            // Handle primary instrument reassignment BEFORE removal
            if (instrument.IsPrimary && memberInstruments.Count > 1)
            {
                // Find the next instrument to make primary (first one that isn't being deleted)
                var newPrimary = memberInstruments.FirstOrDefault(mi => mi.Id != instrument.Id);
                if (newPrimary != null)
                {
                    await MemberInstrumentService.SetPrimaryInstrumentAsync(newPrimary.Id, user.Id!);
                    newPrimary.MarkAsPrimary();
                }
            }
            
            // Remove from database
            await MemberInstrumentService.RemoveInstrumentAsync(instrument.Id);
            
            // Remove from local list only after successful database removal
            memberInstruments.Remove(instrument);
            
            // Reload instruments to ensure consistency
            memberInstruments = (await MemberInstrumentService.GetMemberInstrumentsAsync(user.Id!)).ToList();
            
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error removing instrument: {ex.Message}");
            // Optionally show error to user
        }
    }

    private async Task MarkInstrumentAsPrimary(MemberInstrument instrument)
    {
        if (user == null) return;
        
        await SetAuditContextToCurrentUser();
        await MemberInstrumentService.SetPrimaryInstrumentAsync(instrument.Id, user.Id!);
        
        // Update local list
        foreach (var mi in memberInstruments)
        {
            mi.UnmarkAsPrimary();
        }
        instrument.MarkAsPrimary();
        
        StateHasChanged();
    }

    private async Task SavePersonalSection()
    {
        if (editUser == null || user == null) return;

        user.FirstName = editUser.FirstName;
        user.LastName = editUser.LastName;
        user.Nickname = editUser.Nickname;
        user.Email = editUser.Email;
        user.PhoneNumber = editUser.PhoneNumber;
        user.City = editUser.City;
        user.Degree = editUser.Degree;
        user.DateOfBirth = editUser.DateOfBirth;

        await SetAuditContextToCurrentUser();
        await UserManager.UpdateAsync(user);
        
        CancelEdit();
        StateHasChanged();
    }

    private async Task SaveTunaSection()
    {
        if (editUser == null || user == null) return;

        // Server-side guard: prevent user from being their own padrinho
        if (!string.IsNullOrEmpty(editUser.MentorId) && editUser.MentorId == user.Id)
        {
            // This should never happen due to client-side filtering, but guard against it
            editUser.MentorId = null;
        }

        user.MentorId = editUser.MentorId;
        
        // Backend security: Only update date pairs if they're not already complete in the database
        // This prevents users from changing dates after they've been set once
        if (!IsDatePairComplete(user.YearLeitao, user.MonthLeitao))
        {
            user.YearLeitao = editUser.YearLeitao;
            user.MonthLeitao = editUser.MonthLeitao;
        }
        
        if (!IsDatePairComplete(user.YearCaloiro, user.MonthCaloiro))
        {
            user.YearCaloiro = editUser.YearCaloiro;
            user.MonthCaloiro = editUser.MonthCaloiro;
        }
        
        if (!IsDatePairComplete(user.YearTuno, user.MonthTuno))
        {
            user.YearTuno = editUser.YearTuno;
            user.MonthTuno = editUser.MonthTuno;
        }

        await SetAuditContextToCurrentUser();
        await UserManager.UpdateAsync(user);
        
        // Reload mentor if changed
        if (!string.IsNullOrEmpty(user.MentorId))
        {
            mentor = await UserManager.FindByIdAsync(user.MentorId);
        }
        else
        {
            mentor = null;
        }
        
        // Reload instruments for display
        userInstrumentsForDisplay = (await MemberInstrumentService.GetMemberInstrumentsAsync(user.Id)).ToList();
        
        CancelEdit();
        StateHasChanged();
    }

    private void OpenChangePasswordModal()
    {
        ChangePasswordMessage = null;
        ChangePasswordSucceeded = false;
        passwordModel = new ChangePasswordModel();
        showPasswordModal = true;
    }

    private void ClosePasswordModal()
    {
        showPasswordModal = false;
        ChangePasswordMessage = null;
        ChangePasswordSucceeded = false;
        passwordModel = new ChangePasswordModel();
    }

    private async Task ChangePassword()
    {
        if (isChangingPassword)
        {
            return;
        }

        isChangingPassword = true;
        ChangePasswordMessage = null;
        ChangePasswordSucceeded = false;
        try
        {
            if (user == null)
            {
                ChangePasswordMessage = "Utilizador não encontrado.";
                return;
            }

            var result = await UserManager.ChangePasswordAsync(user, passwordModel.OldPassword, passwordModel.NewPassword);
            if (result.Succeeded)
            {
                ChangePasswordSucceeded = true;
                ChangePasswordMessage = "A sua palavra-passe foi alterada com sucesso.";
                passwordModel = new ChangePasswordModel();

                // Clear the password change requirement flag
                if (user.RequirePasswordChange)
                {
                    user.RequirePasswordChange = false;
                    await SetAuditContextToCurrentUser();
                    await UserManager.UpdateAsync(user);
                }

                // Close modal after delay if successful
                await Task.Delay(1500);
                ClosePasswordModal();
            }
            else
            {
                ChangePasswordMessage = string.Join("; ", result.Errors.Select(e => e.Description));
            }
        }
        finally
        {
            isChangingPassword = false;
        }
    }

    private void FilterMentors()
    {
        if (string.IsNullOrEmpty(mentorSearchTerm))
        {
            filteredMentors.Clear();
            return;
        }

        // Use SearchHelper for multi-word search support
        // Only search by FirstName, LastName, and Nickname (NOT Email)
        // Use accent-insensitive search
        mentorSearchHelper.SearchTerm = mentorSearchTerm;
        
        // eligibleMentors already excludes the current user (filtered at load time)
        // but we explicitly filter here as well for consistency and safety
        var availableMentors = eligibleMentors;
        if (user != null && !string.IsNullOrEmpty(user.Id))
        {
            availableMentors = eligibleMentors.Where(u => u.Id != user.Id).ToList();
        }
        
        filteredMentors = mentorSearchHelper.FilterMultiple(availableMentors, new List<Func<ApplicationUser, string>>
        {
            u => u.FirstName ?? "",
            u => u.LastName ?? "",
            u => $"{u.FirstName} {u.LastName}",
            u => u.Nickname ?? ""
        }, caseSensitive: false, accentSensitive: false);
    }

    private void OnMentorSearch(string term)
    {
        mentorSearchTerm = term;
        FilterMentors();
    }

    private void SelectMentor(ApplicationUser mentor)
    {
        if (editUser != null)
        {
            // Prevent accidental clear: if clicking the already selected mentor, don't clear it
            if (editUser.MentorId == mentor.Id)
            {
                // Keep the selection and just close the dropdown
                filteredMentors.Clear();
                return;
            }
            
            editUser.MentorId = mentor.Id;
        }
        selectedMentorCache = mentor;
        mentorSearchTerm = mentor.GetDisplayName();
        filteredMentors.Clear();
    }

    private void ClearMentorSelection()
    {
        if (editUser != null)
        {
            editUser.MentorId = null;
        }
        selectedMentorCache = null;
        mentorSearchTerm = "";
        filteredMentors.Clear();
    }
    
    private string? GetMentorDisplayName()
    {
        if (mentor != null)
        {
            return mentor.GetDisplayName();
        }

        // If mentor is null but user has a MentorId, the mentor might not have loaded
        // Return null to show "Não definido"
        return null;
    }

    private async Task OnSubscribedChanged(ChangeEventArgs e)
    {
        if (user == null) return;

        subscriptionMessage = null;
        subscriptionSuccess = false;

        try
        {
            var newValue = e.Value is bool boolValue ? boolValue : false;
            user.Subscribed = newValue;

            await SetAuditContextToCurrentUser();
            var result = await UserManager.UpdateAsync(user);

            if (result.Succeeded)
            {
                subscriptionSuccess = true;
                subscriptionMessage = newValue 
                    ? "Notificações por email ativadas com sucesso."
                    : "Notificações por email desativadas com sucesso.";
                
                // Clear message after 3 seconds
                StateHasChanged();
                await Task.Delay(3000);
                subscriptionMessage = null;
                StateHasChanged();
            }
            else
            {
                subscriptionSuccess = false;
                subscriptionMessage = "Erro ao atualizar preferências de notificação.";
                // Revert the change
                user.Subscribed = !newValue;
                StateHasChanged();
            }
        }
        catch (Exception)
        {
            subscriptionSuccess = false;
            subscriptionMessage = "Erro ao atualizar preferências de notificação.";
            StateHasChanged();
        }
    }

    private async Task SetAuditContextToCurrentUser()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userName = authState.User.Identity?.Name;
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        AuditContext.SetUser(userName, userId);
    }
    
    // Helper methods for converting between DateTime and Year+Month
    private DateTime? GetDateFromYearMonth(int? year, int? month)
    {
        if (!year.HasValue || !month.HasValue) return null;
        return new DateTime(year.Value, month.Value, 1);
    }
    
    private (int? year, int? month) GetYearMonthFromDate(DateTime? date)
    {
        if (date.HasValue)
        {
            return (date.Value.Year, date.Value.Month);
        }
        else
        {
            return (null, null);
        }
    }
    
    /// <summary>
    /// Checks if a date pair (Year + Month) is complete in the database.
    /// A date pair is considered complete when BOTH year AND month have values.
    /// </summary>
    private bool IsDatePairComplete(int? year, int? month)
    {
        return year.HasValue && month.HasValue;
    }

}


