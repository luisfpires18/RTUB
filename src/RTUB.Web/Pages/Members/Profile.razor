@page "/profile"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@using RTUB.Application.Helpers
@using RTUB.Application.Extensions
@using RTUB.Shared
@using RTUB.Application.Services
@using RTUB.Application.Interfaces
@using RTUB.Application.DTOs
@using Microsoft.JSInterop
@using Microsoft.Extensions.Options
@attribute [Authorize]
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JSRuntime
@inject RTUB.Application.Services.AuditContext AuditContext
@inject IRoleAssignmentService RoleAssignmentService
@inject IUserProfileService UserProfileService
@inject IRankingService RankingService
@inject IMemberInstrumentService MemberInstrumentService
@inject IRetirementStatusService RetirementStatusService
@inject IMemberStatusService MemberStatusService
@inject RTUB.Web.Services.ProfilePictureUpdateService ProfilePictureUpdateService
@inject IOptions<RTUB.Application.Configuration.Toggles> Toggles

<style>
    :global(html, body) {
        overflow-x: hidden;
    }
</style>

<div class="profile-page container-fluid w-100 d-flex flex-column align-items-center overflow-hidden">
    <h1 class="text-center mb-4 w-100"><i class="bi bi-person-circle"></i> Meu Perfil</h1>

    @if (user == null)
    {
        <p class="text-white-full">A carregar...</p>
    }
    else
    {
        @* Display password change warning if required *@
        @if (user.RequirePasswordChange)
        {
            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                <h5 class="alert-heading">
                    <i class="bi bi-exclamation-triangle-fill"></i> Ação Necessária
                </h5>
                <p class="mb-2">
                    Por favor, altere a sua palavra-passe assim que possível. Está a usar uma palavra-passe temporária.
                </p>
                <button class="btn btn-sm btn-warning" @onclick="OpenChangePasswordModal">
                    <i class="bi bi-key-fill"></i> Alterar Palavra-passe Agora
                </button>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Profile Header Card -->
        <div class="w-100 d-flex flex-column align-items-stretch overflow-hidden" style="min-width: 0;">
            <ProfileHeader User="@user"
                           ImageRefreshTrigger="@imageRefreshTrigger"
                           OnChangePassword="@OpenChangePasswordModal"
                           OnUploadPhoto="@OpenUploadModal" />
        </div>

        <!-- Profile Content -->
        <div class="d-flex flex-column w-100 align-items-stretch overflow-hidden" style="min-width: 0;">
            <div class="w-100">
            
            @* Rank/Level Section *@
            @if (rankProgress != null)
            {
                <div class="w-100 overflow-hidden" style="min-width: 0;">
                    <RankCard RankProgress="@rankProgress" IsCollapsible="true" InitiallyCollapsed="true" />
                </div>
            }

            <!-- Section 1: Pessoal (Personal Information) -->
            <ProfileSection Title="Informações Pessoais"
                          Icon="bi-person-fill"
                          IsCollapsible="true"
                          IsExpanded="@sectionsExpanded["personal"]"
                          IsEditing="@(editingSection == "personal")"
                          ShowEditButton="true"
                          OnEdit="@(() => OpenEditSectionModal("personal"))"
                          OnSave="@SavePersonalSection"
                          OnCancel="@CancelEdit"
                          AdditionalClasses="w-100">
                <ChildContent>
                    <ProfileField Label="Nome Completo" Value="@($"{user.FirstName} {user.LastName}")" Icon="bi bi-person" />
                    <ProfileField Label="Nome de Tuna" Value="@user.Nickname" Icon="bi bi-star" />
                    <ProfileField Label="Email" Value="@user.Email" Icon="bi bi-envelope" />
                    <ProfileField Label="Data de Nascimento"
                                Value="@(user.DateOfBirth.HasValue ? $"{user.DateOfBirth:dd/MM/yyyy}{(user.Age.HasValue ? $" ({user.Age} anos)" : string.Empty)}" : null)"
                                Icon="bi bi-calendar3" />
                    <ProfileField Label="Contacto" Value="@user.PhoneNumber" Icon="bi bi-telephone" />
                    <ProfileField Label="Cidade" Value="@user.City" Icon="bi bi-geo-alt" />
                    <ProfileField Label="Curso"
                                  Value="@(user!.Degree ?? "")"
                                  AdditionalClasses="mt-4"
                                  Icon="bi bi-mortarboard" />
                </ChildContent>
                <EditContent>
                    @if (editUser != null)
                    {
                        <EditForm Model="editUser" OnValidSubmit="SavePersonalSection">
                            <DataAnnotationsValidator />
                            <ErrorDisplay />

                            <div class="row mb-3">
                                <div class="col-md-6 mb-3 mb-md-0">
                                    <label class="form-label text-white-full fw-semibold">
                                        <i class="bi bi-person text-primary me-2"></i>Primeiro Nome
                                    </label>
                                    <InputText class="form-control" @bind-Value="editUser.FirstName" placeholder="Inserir primeiro nome..." />
                                    <ValidationMessage For="@(() => editUser.FirstName)" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-white-full fw-semibold">
                                        <i class="bi bi-person text-primary me-2"></i>Último Nome
                                    </label>
                                    <InputText class="form-control" @bind-Value="editUser.LastName" placeholder="Inserir último nome..." />
                                    <ValidationMessage For="@(() => editUser.LastName)" />
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6 mb-3 mb-md-0">
                                    <label class="form-label text-white-full fw-semibold">
                                        <i class="bi bi-star text-primary me-2"></i>Nome de Tuna
                                    </label>
                                    <InputText class="form-control" @bind-Value="editUser.Nickname" placeholder="Inserir nome de tuna..." />
                                    <ValidationMessage For="@(() => editUser.Nickname)" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-white-full fw-semibold">
                                        <i class="bi bi-envelope text-primary me-2"></i>Email
                                    </label>
                                    <InputText class="form-control" @bind-Value="editUser.Email" type="email" placeholder="Inserir email..." />
                                    <ValidationMessage For="@(() => editUser.Email)" />
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6 mb-3 mb-md-0">
                                    <label class="form-label text-white-full fw-semibold">
                                        <i class="bi bi-calendar3 text-primary me-2"></i>Data de Nascimento
                                    </label>
                                    <InputDate class="form-control" @bind-Value="editUser.DateOfBirth" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-white-full fw-semibold">
                                        <i class="bi bi-telephone text-primary me-2"></i>Contacto
                                    </label>
                                    <InputText class="form-control" @bind-Value="editUser.PhoneNumber" placeholder="Inserir contacto..." />
                                    <ValidationMessage For="@(() => editUser.PhoneNumber)" />
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6 mb-3 mb-md-0">
                                    <label class="form-label text-white-full fw-semibold">
                                        <i class="bi bi-geo-alt text-primary me-2"></i>Cidade
                                    </label>
                                    <InputText class="form-control" @bind-Value="editUser.City" placeholder="Inserir cidade..." />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-white-full fw-semibold">
                                        <i class="bi bi-mortarboard text-primary me-2"></i>Curso
                                    </label>
                                    <InputText class="form-control" @bind-Value="editUser.Degree" placeholder="Inserir curso..." />
                                </div>
                            </div>
                        </EditForm>
                    }
                </EditContent>
            </ProfileSection>

            <!-- Section 2: Tuna (Tuna Information) -->
            <ProfileSection Title="Informação da Tuna"
                          Icon="bi-music-note-list"
                          IsCollapsible="true"
                          IsExpanded="@sectionsExpanded["tuna"]"
                          IsEditing="@(editingSection == "tuna")"
                          ShowEditButton="true"
                          OnEdit="@(() => OpenEditSectionModal("tuna"))"
                          OnSave="@SaveTunaSection"
                          OnCancel="@CancelEdit"
                          AdditionalClasses="w-100">
                <ChildContent>
                    @* Display all instruments with primary indicator - hide for Tuno Honorários *@
                    @if (user != null && !user.Categories.Contains(MemberCategory.TunoHonorario))
                    {
                        @if (userInstrumentsForDisplay != null && userInstrumentsForDisplay.Any())
                        {
                            <ProfileField Label="Instrumentos"
                                        Value="@string.Join(", ", userInstrumentsForDisplay
                                            .OrderByDescending(i => i.IsPrimary)
                                            .Select(i => StatusHelper.GetInstrumentDisplay(i.InstrumentType) + (i.IsPrimary ? " (Principal)" : "")))"
                                        Icon="bi bi-music-note-list" />
                        }
                        else
                        {
                            <ProfileField Label="Instrumentos" Value="@null" Icon="bi bi-music-note-list" />
                        }
                    }

                    @* Hide Padrinho for Leitao, Fundador and Tuno Honorário *@
                    @if (user != null && (!user.IsLeitao() || user.IsCaloiro() || user.IsTuno()) && !user.IsFundador() && !user.Categories.Contains(MemberCategory.TunoHonorario))
                    {
                        <ProfileField Label="Padrinho"
                                    Value="@GetMentorDisplayName()"
                                    Icon="bi bi-person-heart" />
                    }

                    <ProfileField Label="Percurso na Tuna" Icon="bi bi-flag">
                        <ValueContent>
                            <UnifiedTimeline User="@user" RoleAssignments="@roleAssignments" />
                        </ValueContent>
                    </ProfileField>
                    
                    <!-- Estado na Tuna Section - hide for Tuno Honorários -->
                    @{
                        var isActiveMember = user?.Categories.Contains(MemberCategory.Caloiro) == true || 
                                            user?.Categories.Contains(MemberCategory.Tuno) == true ||
                                            user?.Categories.Contains(MemberCategory.Veterano) == true ||
                                            user?.Categories.Contains(MemberCategory.Tunossauro) == true;
                        var isTunoHonorario = user?.Categories.Contains(MemberCategory.TunoHonorario) == true;
                        var hasActivityHistory = memberStatusResult?.HasAnyActivity ?? false;
                    }
                    @if (isActiveMember && !isTunoHonorario && hasActivityHistory)
                    {
                        <div class="profile-field-section mt-4">
                            <div class="profile-field-section-header mb-3">
                                <strong class="text-white-full">
                                    <i class="bi bi-flag-fill me-2 text-primary"></i>
                                    Estado na Tuna
                                </strong>
                            </div>
                            
                            <ProfileField Label="Estado atual" Value="badge">
                                <ValueContent>
                                    <div class="d-flex flex-column gap-2">
                                        <div>
                                            @if (memberStatusResult?.IsRetired == true)
                                            {
                                                <span class="badge badge-retired" 
                                                      title="Reformados: transitam para esta categoria os Associados Efectivos que por motivos profissionais ou pessoais, se encontrem afastados, por um período de seis meses ou superior, das actividades da RTUB. Poderão retornar à sua categoria após três meses de actividade ininterrupta.">
                                                    REFORMADO
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-active">
                                                    NO ATIVO
                                                </span>
                                            }
                                        </div>
                                        @* Progress indicator *@
                                        @if (memberStatusResult?.ProgressDescription != null)
                                        {
                                            <div class="small text-muted">
                                                <i class="bi bi-clock-history me-1"></i>@memberStatusResult.ProgressDescription
                                            </div>
                                            @if (memberStatusResult.ProgressMonths.HasValue && memberStatusResult.ProgressTotalMonths.HasValue)
                                            {
                                                <div class="progress" style="height: 8px;">
                                                    <div class="progress-bar bg-primary" 
                                                         role="progressbar" 
                                                         style="width: @((memberStatusResult.ProgressMonths.Value * 100.0 / memberStatusResult.ProgressTotalMonths.Value).ToString("F0"))%"
                                                         aria-valuenow="@memberStatusResult.ProgressMonths.Value" 
                                                         aria-valuemin="0" 
                                                         aria-valuemax="@memberStatusResult.ProgressTotalMonths.Value">
                                                    </div>
                                                </div>
                                            }
                                        }
                                    </div>
                                </ValueContent>
                            </ProfileField>
                            
                            <ProfileField Label="Último ensaio"
                                        Icon="bi bi-calendar-check"
                                        Value="@(memberStatusResult?.LastRehearsalDate.HasValue == true
                                            ? memberStatusResult.LastRehearsalDate.Value.ToString("dd MMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("pt-PT"))
                                            : null)" />

                            <ProfileField Label="Última atuação"
                                        Icon="bi bi-calendar-event"
                                        Value="@(memberStatusResult?.LastEventDate.HasValue == true
                                            ? memberStatusResult.LastEventDate.Value.ToString("dd MMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("pt-PT"))
                                            : null)" />
                        </div>
                    }

                </ChildContent>
                <EditContent>
                    @if (editUser != null)
                    {
                        <EditForm Model="editUser" OnValidSubmit="SaveTunaSection">
                            <DataAnnotationsValidator />
                            <ErrorDisplay />

                            @* Multiple Instruments Management *@
                            <div class="mb-3">
                                <label class="form-label text-white-full fw-semibold">
                                    <i class="bi bi-music-note-list text-primary me-2"></i>Instrumentos
                                </label>

                                @* Add Instrument Section *@
                                <div class="d-flex flex-column flex-sm-row align-items-stretch align-items-sm-end gap-2 mb-2">
                                    <select class="form-select flex-grow-1" @bind-value="selectedInstrumentToAdd" @bind-value:event="onchange">
                                        <option value="">Selecionar instrumento...</option>
                                        @foreach (var instrument in Enum.GetValues<InstrumentType>().Where(i => !memberInstruments.Any(mi => mi.InstrumentType == i)))
                                        {
                                            <option value="@instrument">@StatusHelper.GetInstrumentDisplay(instrument)</option>
                                        }
                                    </select>
                                    <button type="button"
                                            class="btn btn-primary btn-primary-purple flex-shrink-0"
                                            @onclick="AddInstrumentToMember"
                                            disabled="@(string.IsNullOrEmpty(selectedInstrumentToAdd))">
                                        <i class="bi bi-plus-lg"></i> Adicionar
                                    </button>
                                </div>
                                
                                @* Display Instruments List *@
                                @if (memberInstruments.Any())
                                {
                                    <div class="list-group">
                                        @foreach (var memberInstrument in memberInstruments)
                                        {
                                            <div class="list-group-item d-flex justify-content-between align-items-center">
                                                <div class="d-flex align-items-center gap-2">
                                                    <input type="radio" 
                                                           name="primaryInstrument" 
                                                           class="form-check-input" 
                                                           checked="@memberInstrument.IsPrimary"
                                                           @onchange="@(() => MarkInstrumentAsPrimary(memberInstrument))"
                                                           title="Marcar como principal" />
                                                    <span>
                                                        @StatusHelper.GetInstrumentDisplay(memberInstrument.InstrumentType)
                                                        @if (memberInstrument.IsPrimary)
                                                        {
                                                            <span class="badge bg-primary ms-2">Principal</span>
                                                        }
                                                    </span>
                                                </div>
                                                <button type="button"
                                                        class="btn btn-sm btn-danger"
                                                        @onclick="@(() => RemoveInstrumentFromMember(memberInstrument))"
                                                        title="Remover instrumento">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <EmptyState Title="Nenhum instrumento adicionado ainda" Icon="bi-music-note-list" />
                                }
                            </div>

                            @if (user != null && (!user.IsLeitao() || user.IsCaloiro() || user.IsTuno()) && !user.IsFundador())
                            {
                                <div class="mb-3">
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <label class="form-label text-white-full fw-semibold d-flex align-items-center gap-2 mb-0">
                                            <i class="bi bi-person-hearts text-primary"></i>
                                            <span>Padrinho</span>
                                        </label>
                                    </div>
                                    <div class="mentor-search-container">
                                        <SearchBar @bind-Value="mentorSearchTerm"
                                                   Placeholder="Pesquisar padrinho por nome ou alcunha..."
                                                   OnSearch="OnMentorSearch"
                                                   OnClear="ClearMentorSelection"
                                                   Compact="true" />
                                    </div>
                                    
                                    @if (filteredMentors.Any())
                                    {
                                        <div class="member-list member-list-scrollable">
                                            @foreach (var mentorItem in filteredMentors.Take(20))
                                            {
                                                <div class="member-item p-2 mb-2 border rounded clickable-row"
                                                     @onclick="() => SelectMentor(mentorItem)">
                                                    <div class="d-flex align-items-center">
                                                        <img src="@mentorItem.ProfilePictureSrc" alt="@mentorItem.GetDisplayName()"
                                                             class="member-avatar-small me-2" />
                                                        <div>
                                                            @if (!string.IsNullOrEmpty(mentorItem.Nickname))
                                                            {
                                                                <div><strong>@mentorItem.Nickname</strong></div>
                                                                <div class="text-muted small">@mentorItem.FirstName @mentorItem.LastName</div>
                                                            }
                                                            else
                                                            {
                                                                <div><strong>@mentorItem.FirstName @mentorItem.LastName</strong></div>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else if (!string.IsNullOrEmpty(mentorSearchTerm) && string.IsNullOrEmpty(editUser.MentorId))
                                    {
                                        <div class="alert alert-purple mt-2">Nenhum padrinho encontrado.</div>
                                    }

                                    @if (!string.IsNullOrEmpty(editUser.MentorId))
                                    {
                    var displayMentor = selectedMentorCache ?? eligibleMentors.FirstOrDefault(m => m.Id == editUser.MentorId);
                    if (displayMentor != null)
                    {
                        <div class="alert alert-purple mt-2">
                            <strong>Padrinho Selecionado:</strong> @displayMentor.GetDisplayName()
                        </div>
                    }
                }
                                </div>
                            }

                            @if (user != null && !user.IsFundador())
                            {
                                <div class="row mb-3">
                                    <div class="col-md-4">
                                        <MonthYearPicker Label="Entrada a Leitão"
                                                         Icon="calendar3"
                                                         LabelCssClass="text-white-full"
                                                         @bind-Year="@editUser!.YearLeitao"
                                                         @bind-Month="@editUser!.MonthLeitao"
                                                         @bind-Value="LeitaoDate"
                                                         Disabled="@IsDatePairComplete(user.YearLeitao, user.MonthLeitao)"
                                                         HelpText="@(IsDatePairComplete(user.YearLeitao, user.MonthLeitao) ? "Não podes alterar as datas. Se estão em erro, contacta o Magister." : null)" />
                                    </div>
                                    @if (!user.IsOnlyLeitao())
                                    {
                                        <div class="col-md-4">
                                            <MonthYearPicker Label="Passagem a caloiro"
                                                             Icon="calendar3"
                                                             LabelCssClass="text-white-full"
                                                             @bind-Year="@editUser!.YearCaloiro"
                                                             @bind-Month="@editUser!.MonthCaloiro"
                                                             @bind-Value="CaloiroDate"
                                                             Disabled="@IsDatePairComplete(user.YearCaloiro, user.MonthCaloiro)"
                                                             HelpText="@(IsDatePairComplete(user.YearCaloiro, user.MonthCaloiro) ? "Não podes alterar as datas. Se estão em erro, contacta o Magister." : null)" />
                                        </div>
                                    }
                                    @if (user.IsTunoOrHigher())
                                    {
                                        <div class="col-md-4">
                                            <MonthYearPicker Label="Passagem a tuno"
                                                             Icon="calendar3"
                                                             LabelCssClass="text-white-full"
                                                             @bind-Year="@editUser!.YearTuno"
                                                             @bind-Month="@editUser!.MonthTuno"
                                                             @bind-Value="TunoDate"
                                                             Disabled="@IsDatePairComplete(user.YearTuno, user.MonthTuno)"
                                                             HelpText="@(IsDatePairComplete(user.YearTuno, user.MonthTuno) ? "Não podes alterar as datas. Se estão em erro, contacta o Magister." : null)" />
                                        </div>
                                    }
                                </div>
                            }
                        </EditForm>
                    }
                </EditContent>
            </ProfileSection>

            <!-- Section 3: Notifications (Email Preferences) -->
            <ProfileSection Title="Notificações"
                          Icon="bi-envelope-fill"
                          IsCollapsible="true"
                          IsExpanded="@sectionsExpanded["notifications"]"
                          IsEditing="false"
                          ShowEditButton="false"
                          AdditionalClasses="w-100">
                <ChildContent>
                    @if (!string.IsNullOrEmpty(subscriptionMessage))
                    {
                        <Alert Message="@subscriptionMessage" 
                               Type="@(subscriptionSuccess ? Alert.AlertType.Success : Alert.AlertType.Error)" 
                               Dismissible="true"
                               OnDismiss="@(() => subscriptionMessage = null)" 
                               AdditionalClasses="mb-3" />
                    }
                    <div class="notification-toggle-list">
                        <div class="notification-toggle-row">
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="emailNotificationSwitch"
                                       checked="@user.Subscribed"
                                       @onchange="OnSubscribedChanged">
                                <label class="form-check-label text-white-full" for="emailNotificationSwitch">
                                    <i class="bi bi-envelope@(user.Subscribed ? "-fill" : "")"></i>
                                    Email Notifications
                                </label>
                            </div>
                        </div>

                        <div class="notification-toggle-row">
                            <PushNotificationToggle />
                        </div>
                    </div>
                </ChildContent>
            </ProfileSection>

        </div>
    </div>
}


</div>

<!-- Upload Photo Modal -->
<Modal Show="@showUploadModal"
       ShowChanged="@((bool show) => showUploadModal = show)"
       Title="Carregar Foto de Perfil" 
       Size="Modal.ModalSize.Default"
       Centered="true">
    <BodyContent>
        <label class="form-label">Escolher imagem</label>
        <div class="localized-file-picker">
            <InputFile id="@profileImageInputId"
                       class="d-none"
                       OnChange="HandleImageUpload"
                       accept="image/*"
                       aria-label="Escolher imagem" />
            <label class="btn btn-outline-secondary localized-file-button" for="@profileImageInputId">
                <i class="bi bi-upload me-2"></i>Escolher imagem
            </label>
            <span class="localized-file-name">@(!string.IsNullOrEmpty(profileImageFileName) ? profileImageFileName : "Sem imagem escolhida")</span>
        </div>
        @if (!string.IsNullOrEmpty(uploadMessage))
        {
            <div class="alert alert-success mt-3">@uploadMessage</div>
        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="CloseUploadModal">Fechar</button>
    </FooterContent>
</Modal>

<!-- Image Cropper Component -->
<ImageCropper @ref="imageCropper"
              ShowModal="showCropperModal"
              ShowModalChanged="OnCropperModalChanged"
              OnImageCropped="OnImageCropped"
              AspectRatio="1"
              AspectRatioHelp="As fotos de perfil são exibidas como avatares circulares (proporção 1:1 recomendada)"
              ImageFormat="image/webp"
              ImageQuality="0.9" />

<!-- Change Password Modal -->
<Modal Show="@showPasswordModal" 
       ShowChanged="@((bool show) => showPasswordModal = show)"
       Title="Alterar Palavra-passe" 
       Size="Modal.ModalSize.Default"
       Centered="true">
    <BodyContent>
        @if (!string.IsNullOrEmpty(ChangePasswordMessage))
        {
            <div class="alert @(ChangePasswordSucceeded ? "alert-success" : "alert-danger")">@ChangePasswordMessage</div>
        }
        <EditForm Model="passwordModel" OnValidSubmit="ChangePassword">
            <DataAnnotationsValidator />
            <ErrorDisplay />

            <div class="mb-3">
                <label class="form-label text-white-full fw-semibold">
                    <i class="bi bi-key text-primary me-2"></i>Palavra-passe Atual
                </label>
                <InputText type="password" class="form-control" @bind-Value="passwordModel.OldPassword" />
            </div>

            <div class="mb-3">
                <label class="form-label text-white-full fw-semibold">
                    <i class="bi bi-key-fill text-primary me-2"></i>Nova Palavra-passe
                </label>
                <InputText type="password" class="form-control" @bind-Value="passwordModel.NewPassword" />
            </div>

            <div class="mb-3">
                <label class="form-label text-white-full fw-semibold">
                    <i class="bi bi-shield-check text-primary me-2"></i>Confirmar Nova Palavra-passe
                </label>
                <InputText type="password" class="form-control" @bind-Value="passwordModel.ConfirmPassword" />
            </div>

            <div class="d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-secondary" @onclick="ClosePasswordModal" disabled="@isChangingPassword">Cancelar</button>
                <button type="submit" class="btn btn-primary btn-primary-purple" disabled="@isChangingPassword">
                    @if (isChangingPassword)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>A alterar...</span>
                    }
                    else
                    {
                        <span>Alterar Palavra-passe</span>
                    }
                </button>
            </div>
        </EditForm>
    </BodyContent>
</Modal>

@code {
