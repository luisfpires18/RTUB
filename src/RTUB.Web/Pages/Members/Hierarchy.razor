@page "/hierarchy"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using RTUB.Application.Helpers
@using RTUB.Application.Extensions
@using RTUB.Application.Interfaces
@using RTUB.Shared.Enums
@attribute [Authorize]
@inject UserManager<ApplicationUser> UserManager
@inject IMemberHierarchyService MemberHierarchyService
@inject IJSRuntime JSRuntime

<h1 class="text-center mb-4"><i class="bi bi-diagram-3"></i> Hierarquia da Tuna - Família</h1>
<p class="lead page-header-subtitle mb-4 text-light-theme text-center">Árvore genealógica dos membros mostrando a relação Padrinho-Afilhado</p>

@if (isLoading)
{
    <LoadingSpinner Message="A carregar hierarquia..." Color="SpinnerColor.Purple" />
}
else if (!members.Any())
{
    <div class="alert alert-info mt-4 identity-alert-info text-center">
        <i class="bi bi-info-circle"></i> Nenhum membro encontrado.
    </div>
}
else
{
    <div class="family-tree-page">
        <div class="family-tree-scroll" id="familyTreeScroll">
            <div class="family-tree-viewport" id="familyTreeViewport">
                <div class="family-tree-container" id="familyTreeContainer">
                    @* Root level - members without mentors *@
                    <div class="tree-level">
                        @foreach (var rootMember in rootMembers)
                        {
                            <div class="tree-node-wrapper" data-is-root="true">
                                @RenderMemberNode(rootMember)
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<ApplicationUser> members = new();
    private List<ApplicationUser> rootMembers = new();
    private Dictionary<string, List<ApplicationUser>> mentorToAfilhados = new();
    private bool isLoading = true;

    protected override void OnInitialized()
    {
        LoadMembersAndBuildHierarchy();
        isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !isLoading && members.Any())
        {
            try
            {
                // Center on root node after initial render
                await JSRuntime.InvokeVoidAsync("RTUB.centerFamilyTree");
            }
            catch (TaskCanceledException) { /* User navigated away - benign */ }
            catch (Microsoft.JSInterop.JSDisconnectedException) { /* Circuit disconnected - benign */ }
        }
    }

    private void LoadMembersAndBuildHierarchy()
    {
        // Load all members excluding Leitões (only show Caloiro, Tuno, Veterano, Tunossauro)
        // Must load to memory first before using IsEffectiveMember() extension method
        var allMembers = UserManager.Users
            .ToList()
            .Where(u => u.IsEffectiveMember())
            .ToList();

        // Use service to build hierarchy
        (rootMembers, mentorToAfilhados) = MemberHierarchyService.BuildHierarchy(allMembers);
        
        // Keep members list for rendering
        members = allMembers;
    }

    private RenderFragment RenderMemberNode(ApplicationUser member) => __builder =>
    {
        <div class="member-node">
            <div class="member-card">
                <img src="@member.ProfilePictureSrc" 
                     alt="@member.GetDisplayName()" 
                     class="member-avatar-medium mb-2"
                     title="@member.GetDisplayName()" />
                <div class="member-info">
                    @if (!string.IsNullOrEmpty(member.Nickname))
                    {
                        <div class="member-name">@member.Nickname</div>
                        <div class="member-nickname">@member.FirstName @member.LastName</div>
                    }
                    else
                    {
                        <div class="member-name">@member.FirstName @member.LastName</div>
                    }
                </div>
            </div>

            @* Show afilhados (children) if this member has any *@
            @if (mentorToAfilhados.ContainsKey(member.Id) && mentorToAfilhados[member.Id].Any())
            {
                <div class="children-connector"></div>
                <div class="children-container">
                    @foreach (var afilhado in mentorToAfilhados[member.Id].OrderBy(a => a.YearCaloiro ?? int.MaxValue).ThenBy(a => a.MonthCaloiro ?? int.MaxValue).ThenBy(a => a.FirstName).ThenBy(a => a.LastName))
                    {
                        <div class="child-node" @key="afilhado.Id">
                            @RenderMemberNode(afilhado)
                        </div>
                    }
                </div>
            }
        </div>
    };
}
