    private void SortEnrollmentsBy(string column)
    {
        enrollmentSortHelper.ChangeSortColumn(column);
        ApplySortToEnrollments();
    }
    
    private void ApplySortToEnrollments()
    {
        if (filteredPerformingMembers == null || !filteredPerformingMembers.Any())
            return;
        
        var columnSelectors = new Dictionary<string, Func<Enrollment, IComparable>>
        {
            [nameof(ApplicationUser.FirstName)] = e => e.User?.FirstName ?? "",
            ["Category"] = e =>
            {
                if (e.User == null) return "3";
                if (e.User.Positions.Contains(Position.Magister)) return "0";
                var cat = e.EffectiveCategory();
                if (cat == MemberCategory.Tuno) return "1";
                if (cat == MemberCategory.Caloiro) return "2";
                return "3";
            },
            ["Instrument"] = e => e.Instrument?.ToString() ?? "ZZZ",
            ["EnrolledAt"] = e => e.EnrolledAt
        };
        
        filteredPerformingMembers = enrollmentSortHelper.ApplySort(filteredPerformingMembers, columnSelectors);
    }

    private async Task CalculateInstrumentCountsAsync()
    {
        primaryInstrumentCounts = new Dictionary<InstrumentType, int>();
        otherInstrumentCounts = new Dictionary<InstrumentType, int>();
        
        if (selectedEvent == null || eventEnrollments == null)
            return;
        
        // Assign the loaded enrollments to the Event's navigation property
        // so that GetPrimaryInstrumentCounts and GetOtherInstrumentCounts can iterate over them
        selectedEvent.Enrollments = eventEnrollments;
        
        // Get all user IDs from enrollments
        var userIds = eventEnrollments
            .Where(e => e.WillAttend && !string.IsNullOrEmpty(e.UserId))
            .Select(e => e.UserId)
            .Distinct()
            .ToList();
        
        if (!userIds.Any())
            return;
        
        // Fetch all member instruments in one query
        var memberInstruments = await MemberInstrumentService.GetMemberInstrumentsByUserIdsAsync(userIds);
        
        // Use service to calculate counts (business logic extracted)
        (primaryInstrumentCounts, otherInstrumentCounts) = EnrollmentStatisticsService.CalculateInstrumentCounts(
            selectedEvent,
            memberInstruments
        );
    }

