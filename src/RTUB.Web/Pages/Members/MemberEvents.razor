    private string videoInputId = $"event-video-{Guid.NewGuid():N}";
    private string? selectedVideoName = null;
    private IBrowserFile? selectedVideoFile = null;
    private string videoTitle = string.Empty;
    private EventVideo? editingVideo = null;
    private string editingVideoTitle = string.Empty;
    
    // Video drag-and-drop state
    private int? draggingVideoId = null;
    private int? dragOverVideoId = null;
    
    private string dateValidationError = string.Empty;
    private bool showPastDateWarning = false;
    private bool isDateRange = false;
    private string eventTimeString = "19:00"; // Default to 19:00 (7 PM)
    private int eventListRefreshTrigger = 0; // Force event list re-render

    // Future events pagination
    private PaginationHelper<Event> futureEventsPaginationHelper = new() { PageSize = 9 };
    private List<Event> paginatedFutureEvents => futureEventsPaginationHelper.GetPageData(filteredFutureEvents);

    // Previous events
    private List<Event>? allPreviousEvents;
    private string previousEventsSearch = string.Empty;
    
    // Helper instances for previous events
    private SearchHelper<Event> searchHelper = new();
    private PaginationHelper<Event> paginationHelper = new() { PageSize = 9 };
    private List<Event> paginatedPreviousEvents => paginationHelper.GetPageData(filteredPreviousEvents);
    
    // Enrollment modal filter variables
    private string enrollmentSearchTerm = string.Empty;
    private SortableTableHelper<Enrollment> enrollmentSortHelper = new() { SortColumn = "EnrolledAt", SortAscending = false };
    private List<Enrollment> filteredPerformingMembers = new();
    private List<Enrollment> filteredLeitoes = new();
    private List<Enrollment> filteredNotAttending = new();
    
    // Instrument count tracking
    private Dictionary<InstrumentType, int> primaryInstrumentCounts = new();
    private Dictionary<InstrumentType, int> otherInstrumentCounts = new();
    
    // Pagination for enrollment modals
