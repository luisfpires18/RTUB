<!-- Mobile Bottom Nav -->
<MobileBottomNav Items="@mobileNavItems" ActiveKey="" OnSelect="HandleMobileNavSelect" />

@code {
    private List<Event>? allEvents; // All events (unfiltered)
    private List<Event> events = new(); // Future events (filtered)
    private List<Enrollment>? enrollments;
    private List<Enrollment>? eventEnrollments;
    private List<EventRepertoire>? eventRepertoires;
    private Dictionary<int, int>? discussionPostCounts; // eventId -> post count
    private Dictionary<int, int> eventVideoCounts = new(); // eventId -> video count
    private Dictionary<int, int> eventTrophyCounts = new(); // eventId -> trophy count
    private ApplicationUser? currentUser;
    private enum ModalType
    {
        Edit,
        Delete,
        EnrollmentList,
        Repertoire,
        EventDetails,
        Trophy,
        TrophyEdit,
        TrophyDelete,
        Videos,
        EditVideo,
        DeleteEnrollment,
        TrophiesStats
