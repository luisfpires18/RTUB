<!-- Trophies Statistics Modal -->
<Modal Show="@modals.IsOpen(ModalType.TrophiesStats)"
       ShowChanged="@((value) => modals.Toggle(ModalType.TrophiesStats, value))"
       Title="Prémios Conquistados"
       Size="Modal.ModalSize.Large"
       ShowCloseButton="true">
    <BodyContent>
        @if (isLoadingTrophiesStats)
        {
            <LoadingSpinner Message="A carregar estatísticas de troféus..." />
        }
        else if (trophiesStatsByEvent == null || !trophiesStatsByEvent.Any())
        {
            <EmptyState Title="Nenhum prémio conquistado ainda"
                       Icon="bi-trophy" />
        }
        else
        {
            <div class="statistics-container">
                <!-- Trophies by Event Section (with expandable trophies) -->
                <div class="mb-4">
                    <h4 class="mb-3"><i class="bi bi-trophy-fill text-warning"></i> Prémios por Evento</h4>
                    @foreach (var eventGroup in paginatedTrophiesStats)
                    {
                        var isExpanded = trophiesStatsExpanded.GetValueOrDefault(eventGroup.EventId, false);
                        var startIndex = (trophiesStatsPaginationHelper.CurrentPage - 1) * trophiesStatsPaginationHelper.PageSize;
                        var position = paginatedTrophiesStats.IndexOf(eventGroup) + startIndex + 1;
                        <div class="user-stats-group mb-3">
                            <div class="user-stats-header @(eventGroup.TrophyCount > 0 ? "user-stats-header-clickable" : "not-expandable")" 
                                 @onclick="() => { if (eventGroup.TrophyCount > 0) ToggleTrophiesStats(eventGroup.EventId); }">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="stats-card-position me-2">
                                        @if (position == 1)
                                        {
                                            <span class="stats-medal gold">🥇</span>
                                        }
                                        else if (position == 2)
                                        {
                                            <span class="stats-medal silver">🥈</span>
                                        }
                                        else if (position == 3)
                                        {
                                            <span class="stats-medal bronze">🥉</span>
                                        }
                                        else
                                        {
                                            <span class="stats-position">@position</span>
                                        }
                                    </div>
                                    <div class="user-stats-info">
                                        <div class="user-stats-nickname">@eventGroup.EventName</div>
                                        <div class="user-stats-fullname">@eventGroup.EventDate.ToString("dd MMM yyyy")</div>
                                    </div>
                                </div>
                                <div class="user-stats-total">@eventGroup.TrophyCount prémio(s)</div>
                                @if (eventGroup.TrophyCount > 0)
                                {
                                    <i class="bi @(isExpanded ? "bi-chevron-up" : "bi-chevron-down") ms-auto"></i>
                                }
                            </div>
                            @if (isExpanded)
                            {
                                <div class="stats-card-grid mt-2">
                                    @foreach (var trophy in eventGroup.Trophies)
                                    {
                                        <div class="stats-card stats-card-detailed">
                                            <div class="stats-card-content">
                                                <div class="stats-card-title">
                                                    <i class="bi bi-trophy-fill text-warning me-2"></i>@trophy.Name
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    <TablePagination 
                        CurrentPage="@trophiesStatsPaginationHelper.CurrentPage"
                        PageSize="@trophiesStatsPaginationHelper.PageSize"
                        TotalItems="@trophiesStatsByEvent.Count"
                        ItemLabel="eventos"
                        PageSizeOptions="@(new[] { 5, 10, 15, 20 })"
                        OnPageChanged="@HandleTrophiesStatsPageChanged"
                        OnPageSizeChanged="@HandleTrophiesStatsPageSizeChanged" />
                </div>
            </div>
        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="CloseTrophiesStatsModal">Voltar Atrás</button>
    </FooterContent>
</Modal>

<!-- Videos Modal (with Upload and View sections) -->
<Modal Show="@modals.IsOpen(ModalType.Videos)" 
       ShowChanged="@((value) => modals.Toggle(ModalType.Videos, value))"
       Title="@($"Vídeos - {selectedEventForVideos?.Name}")" 
       Size="Modal.ModalSize.Large"
       Centered="true"
       ShowCloseButton="true"
       OnClose="@CloseVideosModal">
    <BodyContent>
        @* Upload Section - Visible to all logged-in users (members only) *@
        <AuthorizeView>
            <Authorized>
                <div class="mb-4">
                    <h6 class="mb-3">
                        <i class="bi bi-upload text-primary me-2"></i>Adicionar Vídeo
                    </h6>
                    
                    @if (isUploadingVideo)
                    {
                        <LoadingSpinner Message="A enviar vídeo..." />
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label">Ficheiro de vídeo</label>
                            <div class="localized-file-picker">
                                <InputFile id="@videoInputId" 
                                           @key="videoUploadKey"
                                           class="d-none" 
                                           OnChange="@HandleVideoSelection" 
                                           accept="video/*" 
                                           aria-label="Escolher vídeo" />
                                <label class="btn btn-outline-secondary localized-file-button" for="@videoInputId">
                                    <i class="bi bi-upload me-2"></i>Escolher vídeo
                                </label>
                                <span class="localized-file-name">
                                    @if (!string.IsNullOrEmpty(selectedVideoName))
                                    {
                                        <text>@selectedVideoName</text>
                                    }
                                    else
                                    {
                                        <text>Nenhum vídeo selecionado</text>
                                    }
                                </span>
                            </div>
                            <small class="text-muted d-block mt-1">
                                <i class="bi bi-info-circle me-1"></i>Tamanho máximo: 100MB
                            </small>
                        </div>
                        
                        @if (selectedVideoFile != null)
                        {
                            <div class="mb-3">
                                <label class="form-label">Título do vídeo <span class="text-danger">*</span></label>
                                <InputText @bind-Value="videoTitle" class="form-control" placeholder="Digite um título para o vídeo" />
                                <small class="text-muted">Este nome aparecerá na lista de vídeos</small>
                            </div>
                            
                            <div class="d-flex justify-content-end">
                                <button type="button" class="btn btn-secondary me-2" @onclick="CancelVideoSelection">
                                    Cancelar
                                </button>
                                <button type="button" class="btn btn-primary" @onclick="UploadVideo" disabled="@(string.IsNullOrWhiteSpace(videoTitle))">
                                    <i class="bi bi-upload me-2"></i>Enviar vídeo
                                </button>
                            </div>
                        }
                    }
                </div>
                
                <hr class="my-4" />
            </Authorized>
        </AuthorizeView>
        
        @* View Section - Visible to everyone *@
        <div>
            <h6 class="mb-3">
                <i class="bi bi-list-ul text-primary me-2"></i>Vídeos Disponíveis
            </h6>
            
            @if (eventVideos == null || !eventVideos.Any())
            {
                <EmptyState Title="Ainda não existem vídeos para este evento"
                           Icon="bi-camera-video"
                           Message="Os vídeos aparecerão aqui quando forem adicionados." />
            }
            else
            {
                var videos = eventVideos.OrderBy(v => v.SortOrder).ToList();
                
                <div class="video-selector mb-3">
                    <label class="form-label fw-semibold">Selecione um vídeo:</label>
                    <div class="list-group">
                        @for (int i = 0; i < videos.Count; i++)
                        {
                            var index = i;
                            var video = videos[i];
                            var isSelected = selectedVideoId == video.Id;
                            
                            // Generate clean display title
                            var displayTitle = GetCleanVideoTitle(video, i + 1);
                            
                            <div class="list-group-item list-group-item-action position-relative @(isSelected ? "active" : "") @(draggingVideoId == video.Id ? "dragging" : "") @(dragOverVideoId == video.Id ? "drag-over" : "")"
                                 role="button"
                                 draggable="@(isUserAdmin ? "true" : "false")"
                                 @ondragstart="@(() => HandleVideoDragStart(video.Id))"
                                 @ondragover="HandleVideoDragOver"
                                 @ondragover:preventDefault
                                 @ondragenter="@(() => HandleVideoDragEnter(video.Id))"
                                 @ondragleave="@(() => HandleVideoDragLeave())"
                                 @ondrop="@(async () => await HandleVideoDrop(video.Id))"
                                 @ondragend="@(() => HandleVideoDragEnd())"
                                 @onclick="() => SelectVideoByIndex(video.Id)">
                                @if (isUserAdmin)
                                {
                                    <div class="drag-handle-video" title="Arrastar para reordenar">
                                        <i class="bi bi-grip-vertical"></i>
                                    </div>
                                }
                                <span class="video-title-content">
                                    <i class="bi bi-play-circle me-2"></i>@displayTitle
                                </span>
                                @if (CanDeleteVideo(video))
                                {
                                    <div class="position-absolute top-50 end-0 translate-middle-y me-2 d-flex gap-1">
                                        <button type="button" 
                                                class="btn btn-sm admin-btn-edit" 
                                                @onclick:stopPropagation="true"
                                                @onclick="() => OpenEditVideoModal(video)"
                                                title="Renomear vídeo">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button type="button" 
                                                class="btn btn-sm admin-btn-delete" 
                                                @onclick:stopPropagation="true"
                                                @onclick="() => DeleteVideoFromModal(video)"
                                                title="Eliminar vídeo">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
                
                @if (selectedVideoId.HasValue)
                {
                    var selectedVideo = videos.FirstOrDefault(v => v.Id == selectedVideoId.Value);
                    if (selectedVideo != null)
                    {
                        <div class="video-player-container">
                            <video @key="@selectedVideo.Id" controls playsinline class="modal-video" preload="metadata" @onplay="() => LogVideoPlaybackAsync(selectedVideo, selectedEventForVideos!)">
                                <source src="@selectedVideo.Url" type="@selectedVideo.MimeType">
                                @if (selectedVideo.MimeType == "video/quicktime")
                                {
                                    <source src="@selectedVideo.Url" type="video/mp4">
                                }
                                <p class="text-warning p-3">
                                    O seu navegador não suporta este formato de vídeo.
                                    Se o vídeo foi gravado num telemóvel, pode ter um codec (HEVC/H.265) não suportado neste navegador.
                                    Experimente usar o Safari ou um navegador móvel.
                                </p>
                            </video>
                        </div>
                    }
                }
            }
        </div>
    </BodyContent>
</Modal>

<!-- Edit Video Title Modal -->
<Modal Show="@modals.IsOpen(ModalType.EditVideo)" 
       ShowChanged="@((value) => modals.Toggle(ModalType.EditVideo, value))"
