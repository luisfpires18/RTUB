    private Event? selectedEventForRepertoire;
    private Event? selectedEventForTrophies;
    private Event? selectedEventForVideos;
    private Enrollment? deletingEnrollment;
    private Trophy? editingTrophy;
    private Trophy? deletingTrophy;
    private List<Trophy>? eventTrophies;
    
    // Fiscal year filtering
    private List<string> fiscalYears = new();
    private string currentFiscalYear = "";
    private string selectedFiscalYear = "";
    private IEnumerable<FilterDropdownOption> fiscalYearOptions => fiscalYears
        .Select(year => new FilterDropdownOption(year, $"{year}{(year == currentFiscalYear ? " (ATUAL)" : string.Empty)}"));
    
    // Event type filtering
    private string selectedEventType = "";
    private List<EventType> availableEventTypes = new();
    private IEnumerable<FilterDropdownOption> eventTypeOptions => availableEventTypes
        .Select(type => new FilterDropdownOption(type.ToString(), GetEventTypeDisplay(type)));
    
    // Filtered events lists
    private List<Event> filteredFutureEvents = new();
    private List<Event> filteredPreviousEvents = new();
    
    // Trophies Statistics Modal state
    private List<TrophyStatsByEvent> trophiesStatsByEvent = new();
    private List<TrophyStatsByEvent> paginatedTrophiesStats = new();
