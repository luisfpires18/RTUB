        trophiesStatsPaginationHelper.PageSize = newSize;
        trophiesStatsPaginationHelper.CurrentPage = 1;
        paginatedTrophiesStats = trophiesStatsPaginationHelper.GetPageData(trophiesStatsByEvent);
        StateHasChanged();
    }
    
    private void ToggleTrophiesStats(int eventId)
    {
        if (trophiesStatsExpanded.ContainsKey(eventId))
        {
            trophiesStatsExpanded[eventId] = !trophiesStatsExpanded[eventId];
        }
        else
        {
            trophiesStatsExpanded[eventId] = true;
        }
        StateHasChanged();
    }
    
}
