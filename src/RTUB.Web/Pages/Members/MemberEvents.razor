    private async Task LoadAllEvents()
    {
        // Load all upcoming events
        var upcomingEvents = (await EventService.GetUpcomingEventsAsync(100)).ToList();
        
        // Load all past events
        allPreviousEvents = (await EventService.GetPastEventsAsync(100)).ToList();
        
        // Combine to get all events
        allEvents = upcomingEvents.Concat(allPreviousEvents).ToList();
        
        // Extract available event types from actual data
        availableEventTypes = allEvents
            .Select(e => e.Type)
            .Distinct()
            .OrderBy(t => GetEventTypeDisplay(t))
            .ToList();
        
        // Apply filters
        FilterEvents();
    }
    
    private void FilterEvents()
    {
        if (allEvents == null)
        {
            filteredFutureEvents = new List<Event>();
            filteredPreviousEvents = new List<Event>();
            events = new List<Event>();
            return;
        }
        
        // Use service to filter events (business logic extracted)
        var (futureEvents, previousEvents) = EventFilterService.FilterEvents(
            allEvents,
            selectedFiscalYear,
            selectedEventType,
            previousEventsSearch
        );
        
        filteredFutureEvents = futureEvents;
        filteredPreviousEvents = previousEvents;
        
        // When "Atuação com videos" toggle is active, filter previous events to only those with videos
        if (showVideosOnly)
        {
            filteredPreviousEvents = filteredPreviousEvents
                .Where(e => GetVideoCount(e.Id) > 0)
                .ToList();
        }
        
        // For backward compatibility, assign to events as well
        events = filteredFutureEvents;
        
        // Reset pagination when filters change
        futureEventsPaginationHelper.Reset();
        paginationHelper.Reset();
        
        // Update URL state
        UpdateUrlState();
    }
    
    private async Task OnFiscalYearChanged()
    {
        FilterEvents();
        await Task.CompletedTask;
    }
    
    private async Task OnEventTypeChanged()
    {
        FilterEvents();
        await Task.CompletedTask;
    }
    
    private void UpdateUrlState()
    {
        // Don't update URL during initialization to avoid redirect loop
        if (isInitializing)
        {
            return;
        }

        // Use service to build query string (business logic extracted)
        var queryString = EventUrlService.BuildQueryString(selectedFiscalYear, currentFiscalYear, selectedEventType);
        var newUrl = Navigation.ToAbsoluteUri("/member/events" + (string.IsNullOrEmpty(queryString) ? "" : "?" + queryString)).ToString();
        Navigation.NavigateTo(newUrl, false); // false = don't force reload
    }
    
    private string GetEmptyStateMessage()
    {
        var messages = new List<string>();
        
        if (showVideosOnly)
        {
            messages.Add("com videos");
        }
        
        if (!string.IsNullOrEmpty(selectedFiscalYear))
        {
            messages.Add($"ano letivo {selectedFiscalYear}");
        }
        
        if (!string.IsNullOrEmpty(selectedEventType) && Enum.TryParse<EventType>(selectedEventType, out var eventType))
        {
            messages.Add($"tipo \"{GetEventTypeDisplay(eventType)}\"");
        }
        
        if (messages.Any())
        {
            return $"Não existem atuações para {string.Join(" e ", messages)}.";
        }
        
        return "Não existem atuações para mostrar.";
    }

