    private PaginationHelper<TrophyStatsByEvent> trophiesStatsPaginationHelper = new() { PageSize = 5 };
    
    // Video modal state (view and upload)
    private List<EventVideo>? eventVideos = null;
    private int? selectedVideoId = null;
    private bool isUploadingVideo = false;
