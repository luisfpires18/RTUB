    // Cancel meeting methods
    private async Task OpenCancelMeetingModal(Meeting meeting)
    {
        selectedMeetingForCancellation = meeting;
        notifySubscribersOnMeetingCancel = false;
        cancelMeetingReason = string.Empty;
        cancelMeetingLoadingSubscribers = true;
        cancelMeetingErrorMessage = null;
        showCancelMeetingModal = true;
        StateHasChanged();

        try
        {
            var allUsers = await UserManager.Users.ToListAsync();
            
            // Build recipient list based on meeting type (same logic as email notification)
            if (meeting.Type == MeetingType.ConselhoVeteranos)
            {
                // CV meetings: Veterano + Tunossauro + Magister (using CurrentRole for accurate role detection)
                cancelMeetingSubscribedUsers = allUsers
                    .Where(u => u.Subscribed && u.EmailConfirmed && 
                           (u.CurrentRole == "VETERANO" || u.CurrentRole == "TUNOSSAURO" || u.Positions.Contains(Position.Magister)))
                    .OrderBy(u => u.Nickname ?? u.FirstName)
                    .ToList();
                
                // Non-subscribers for CV: Only TUNO category members who aren't veteran/tunossauro and don't have Magister position
                cancelMeetingNonSubscribedUsers = allUsers
                    .Where(u => u.EmailConfirmed && 
                           u.IsTuno() && 
                           u.CurrentRole == "TUNO" && 
                           !u.Positions.Contains(Position.Magister))
                    .OrderBy(u => u.Nickname ?? u.FirstName)
                    .ToList();
                
                cancelMeetingTotalCount = cancelMeetingSubscribedUsers.Count + cancelMeetingNonSubscribedUsers.Count;
            }
            else
            {
                // AGO/AGE meetings: All members EXCEPT Leitão
                cancelMeetingSubscribedUsers = allUsers
                    .Where(u => u.Subscribed && u.EmailConfirmed && !u.IsLeitao())
                    .OrderBy(u => u.Nickname ?? u.FirstName)
                    .ToList();
                
                // Non-subscribers for Assembleia: not subscribed
                cancelMeetingNonSubscribedUsers = allUsers
                    .Where(u => u.EmailConfirmed && !u.Subscribed && !u.IsLeitao())
                    .OrderBy(u => u.Nickname ?? u.FirstName)
                    .ToList();
                
                cancelMeetingTotalCount = cancelMeetingSubscribedUsers.Count + cancelMeetingNonSubscribedUsers.Count;
            }
            
            cancelMeetingSubscribedCount = cancelMeetingSubscribedUsers.Count;
        }
        catch (Exception ex)
        {
            cancelMeetingErrorMessage = $"Erro ao carregar membros: {ex.Message}";
        }
        finally
        {
            cancelMeetingLoadingSubscribers = false;
            StateHasChanged();
        }
    }

    private void CloseCancelMeetingModal()
    {
        showCancelMeetingModal = false;
        selectedMeetingForCancellation = null;
        notifySubscribersOnMeetingCancel = false;
        cancelMeetingReason = string.Empty;
        cancelMeetingSubscribedUsers = null;
        cancelMeetingNonSubscribedUsers = null;
        cancelMeetingSubscribedCount = 0;
        cancelMeetingTotalCount = 0;
        cancelMeetingErrorMessage = null;
    }

    private async Task ConfirmCancelMeeting()
    {
        if (selectedMeetingForCancellation == null || string.IsNullOrWhiteSpace(cancelMeetingReason))
        {
            cancelMeetingErrorMessage = "O motivo do cancelamento é obrigatório.";
            StateHasChanged();
            return;
        }

        try
        {
            // Cancel the meeting by setting the properties
            selectedMeetingForCancellation.IsCancelled = true;
            selectedMeetingForCancellation.CancellationReason = cancelMeetingReason;
            await MeetingService.UpdateMeetingAsync(selectedMeetingForCancellation);

            // Send notification emails if checkbox is selected
            if (notifySubscribersOnMeetingCancel && cancelMeetingSubscribedUsers != null && cancelMeetingSubscribedUsers.Any())
            {
                // Get recipient emails
                var recipientEmails = cancelMeetingSubscribedUsers
                    .Where(u => !string.IsNullOrWhiteSpace(u.Email))
                    .Select(u => u.Email!)
                    .ToList();

                // Build recipient data dictionary
                var recipientData = cancelMeetingSubscribedUsers
                    .Where(u => !string.IsNullOrWhiteSpace(u.Email))
                    .ToDictionary(
                        u => u.Email!,
                        u => (
                            nickname: u.Nickname ?? "",
                            fullName: $"{u.FirstName ?? ""} {u.LastName ?? ""}".Trim()
                        )
                    );

                // Generate the cancellation email body
                var dateStr = selectedMeetingForCancellation.Date.ToString("dddd, dd 'de' MMMM 'de' yyyy • HH:mm", new System.Globalization.CultureInfo("pt-PT"));
                var currentDate = DateTime.Now.ToString("dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("pt-PT"));
                var senderCity = $"Bragança, {currentDate}";
                var senderNickname = currentUser != null 
                    ? $"{currentUser.FirstName} \"{currentUser.Nickname}\" {currentUser.LastName}"
                    : "Admin";
                
                var emailBody = await EmailTemplateRenderer.RenderMeetingCancellationAsync(
                    meetingType: GetMeetingTypeFullName(selectedMeetingForCancellation.Type),
                    meetingTitle: selectedMeetingForCancellation.Title,
                    dateFormatted: dateStr,
                    location: selectedMeetingForCancellation.Location ?? string.Empty,
                    cancellationReason: cancelMeetingReason,
                    senderNickname: senderNickname,
                    senderCity: senderCity,
                    senderPosition: GetSenderPosition(),
                    nickname: "",
                    fullName: "");

                // Send the cancellation notification
                var subject = $"[RTUB] Cancelamento: {GetMeetingTypeFullName(selectedMeetingForCancellation.Type)} - {selectedMeetingForCancellation.Title}";
                await EmailNotificationService.SendMeetingNotificationAsync(
                    selectedMeetingForCancellation.Id,
                    subject,
                    emailBody,
                    recipientEmails,
                    recipientData);
            }

            // Reload meetings
            await LoadMeetingsAsync();

            CloseCancelMeetingModal();
        }
        catch (Exception ex)
        {
            cancelMeetingErrorMessage = $"Erro ao cancelar reunião: {ex.Message}";
            StateHasChanged();
        }
    }

    private async Task UncancelMeeting(Meeting meeting)
    {
        try
        {
            meeting.IsCancelled = false;
            meeting.CancellationReason = null;
            await MeetingService.UpdateMeetingAsync(meeting);
            await LoadMeetingsAsync();
        }
        catch (Exception ex)
        {
            // Could show an error message here
            Console.WriteLine($"Error uncanceling meeting: {ex.Message}");
        }
    }
    
    private string GetYearsAsTunoDisplay(ApplicationUser user)
    {
        if (user.YearTuno == null) return "< 1 ano de Tuno";
        
        var now = DateTime.Now;
        var tunoStartYear = user.YearTuno.Value;
        var tunoStartMonth = user.MonthTuno ?? 1;
        
        var tunoStart = new DateTime(tunoStartYear, tunoStartMonth, 1);
        var totalMonths = ((now.Year - tunoStart.Year) * 12) + (now.Month - tunoStart.Month);
        
        if (totalMonths < 1)
            return "< 1 mês de Tuno";
        
        var years = totalMonths / 12;
        var months = totalMonths % 12;
        
        if (years == 0)
            return months == 1 ? "1 mês de Tuno" : $"{months} meses de Tuno";
        
        if (months == 0)
            return years == 1 ? "1 ano de Tuno" : $"{years} anos de Tuno";
        
        var yearText = years == 1 ? "ano" : "anos";
        var monthText = months == 1 ? "mês" : "meses";
        return $"{years} {yearText} {months} {monthText} de Tuno";
    }
    
    private bool CanManageMeetings()
    {
        if (currentUser == null) return false;
        
        // Check if user is Owner role
        var authState = AuthenticationStateProvider.GetAuthenticationStateAsync().Result;
        if (authState.User.IsInRole("Owner")) return true;
        
        // Check if user has one of the authorized positions
        if (currentUser.Positions == null) return false;
        
        return currentUser.Positions.Contains(Position.PresidenteMesaAssembleia) ||
               currentUser.Positions.Contains(Position.PresidenteConselhoVeteranos);
    }
    
    private bool CanManageMeeting(Meeting meeting)
    {
        if (currentUser == null) return false;
        
        // Owner can manage all meetings
        var authState = AuthenticationStateProvider.GetAuthenticationStateAsync().Result;
        if (authState.User.IsInRole("Owner")) return true;
        
        if (currentUser.Positions == null) return false;
        
        // PresidenteMesaAssembleia can only manage Assembleia meetings
        if (currentUser.Positions.Contains(Position.PresidenteMesaAssembleia))
        {
            return meeting.Type == MeetingType.AssembleiaGeralOrdinaria || 
                   meeting.Type == MeetingType.AssembleiaGeralExtraordinaria;
        }
        
        // PresidenteConselhoVeteranos can only manage CV meetings
        if (currentUser.Positions.Contains(Position.PresidenteConselhoVeteranos))
        {
            return meeting.Type == MeetingType.ConselhoVeteranos;
        }
        
        return false;
    }
    
    private bool CanCreateMeetingType(MeetingType type)
    {
        if (currentUser == null) return false;
        
        // Owner can create all types
        var authState = AuthenticationStateProvider.GetAuthenticationStateAsync().Result;
        if (authState.User.IsInRole("Owner")) return true;
        
        if (currentUser.Positions == null) return false;
        
        // PresidenteMesaAssembleia can only create Assembleia meetings
        if (currentUser.Positions.Contains(Position.PresidenteMesaAssembleia))
        {
            return type == MeetingType.AssembleiaGeralOrdinaria || 
                   type == MeetingType.AssembleiaGeralExtraordinaria;
        }
        
        // PresidenteConselhoVeteranos can only create CV meetings
        if (currentUser.Positions.Contains(Position.PresidenteConselhoVeteranos))
        {
            return type == MeetingType.ConselhoVeteranos;
        }
        
        return false;
    }
