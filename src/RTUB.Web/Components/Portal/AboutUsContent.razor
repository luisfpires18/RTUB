@using RTUB.Application.Interfaces
@using RTUB.Core.Entities
@using RTUB.Core.Enums
@using RTUB.Shared
@inject ILabelService LabelService
@inject IEventService EventService
@inject ITrophyService TrophyService
@inject ILogger<AboutUsContent> Logger
@inject RTUB.Web.Interop.MediaSessionInterop MediaSession
@namespace RTUB.Components.Portal

<!-- #1 About Us -->
@if (aboutUs != null)
{
    <section class="mb-5">
        <div class="about-us-container">
            <div class="about-us-header">
                <h2 class="about-us-title">@aboutUs.Title</h2>
                <LabelEditButton CurrentLabel="@aboutUs" OnEditClick="@OpenEditModal" CssClass="text-white" />
            </div>
            <div class="about-us-divider"></div>
            <div class="about-us-content portal-content-preformatted">@aboutUs.Content</div>
        </div>
    </section>
}

<!-- #2 Previous Events -->
<section class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Atuações Anteriores</h2>
        <a href="/events" class="btn btn-outline-primary btn-sm">Ver todas as Atuações</a>
    </div>

    @if (previousEvents != null && previousEvents.Any())
    {
        <div class="row g-4">
            @foreach (var evt in previousEvents)
            {
                <div class="col-md-4">
                    <EventCard Event="@evt"
                               EnrollmentCount="0"
                               VideoCount="@(eventVideoCounts.GetValueOrDefault(evt.Id, 0))"
                               TrophyCount="@(eventTrophyCounts.GetValueOrDefault(evt.Id, 0))"
                               IsAdmin="false"
                               IsPastEvent="true"
                               ShowOnlyTrophy="true"
                               OnViewTrophies="@(() => OpenTrophyModal(evt))"
                               OnViewVideos="@(() => OpenVideosModal(evt))" />
                </div>
            }
        </div>
    }
    else
    {
        <EmptyState Title="Nenhum evento anterior ainda"
                    Icon="bi-calendar-event" />
    }
</section>

<!-- Edit Label Modal (at root level) -->
<Modal Show="@showEditModal" 
       ShowChanged="@((value) => showEditModal = value)"
       Title="Editar Conteúdo"
       Size="Modal.ModalSize.Large"
       OnClose="CloseEditModal">
    <BodyContent>
        @if (editingLabel != null)
        {
            <EditForm Model="editingLabel" OnValidSubmit="SaveLabel" id="editAboutUsLabelForm">
                <DataAnnotationsValidator />
                <ErrorDisplay />

                <div class="mb-3">
                    <label class="form-label text-white-full">Referência</label>
                    <input type="text" class="form-control" value="@editingLabel.Reference" disabled />
                    <small class="text-white-opacity">Identificador único (não editável)</small>
                </div>

                <div class="mb-3">
                    <label class="form-label text-white-full">Título</label>
                    <InputText class="form-control" @bind-Value="editingLabel.Title" placeholder="Inserir título..." />
                </div>

                <div class="mb-3">
                    <label class="form-label text-white-full">Conteúdo</label>
                    <InputTextArea class="form-control" rows="10" @bind-Value="editingLabel.Content" 
                                   placeholder="Inserir conteúdo..." />
                    <small class="text-white-opacity">Dica: Use quebras de linha para formatar o texto</small>
                </div>

            </EditForm>
        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="CloseEditModal">Cancelar</button>
        <button type="submit" form="editAboutUsLabelForm" class="btn btn-success">Guardar</button>
    </FooterContent>
</Modal>

<!-- Trophy Modal -->
<Modal Show="@showTrophyModal"
       ShowChanged="@((bool show) => showTrophyModal = show)"
       Title="@($"Prémios de {selectedEvent?.Name ?? ""}")"
       Size="Modal.ModalSize.Large"
       Centered="true">
    <BodyContent>
        @if (eventTrophies == null || !eventTrophies.Any())
        {
            <EmptyState Title="Nenhum prémio conquistado neste evento"
                        Icon="bi-trophy" />
        }
        else
        {
            <div class="row g-3">
                @foreach (var trophy in eventTrophies)
                {
                    <div class="col-md-4 col-sm-6">
                        <div class="card h-100 text-center p-3 trophy-card" style="background-color: #151516; border: 2px solid #2f2f2f; transition: border-color 0.2s ease, box-shadow 0.2s ease;">
                            <div class="card-body d-flex flex-column align-items-center justify-content-center">
                                <i class="bi bi-trophy-fill text-warning mb-3" style="font-size: 3rem;"></i>
                                <h5 class="card-title mb-0">@trophy.Name</h5>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="CloseTrophyModal">Voltar Atrás</button>
    </FooterContent>
</Modal>

<!-- Videos Modal (view-only for public users) -->
<Modal Show="@showVideosModal" 
       ShowChanged="@((value) => showVideosModal = value)"
       Title="@($"Vídeos - {selectedEventForVideos?.Name}")" 
       Size="Modal.ModalSize.Large"
       Centered="true"
       ShowCloseButton="true"
       OnClose="@CloseVideosModal">
    <BodyContent>
        <div>
            <h6 class="mb-3">
                <i class="bi bi-list-ul text-primary me-2"></i>Vídeos Disponíveis
            </h6>
            
            @if (eventVideos == null || !eventVideos.Any())
            {
                <EmptyState Title="Ainda não existem vídeos para este evento"
                           Icon="bi-camera-video"
                           Message="Os vídeos aparecerão aqui quando forem adicionados." />
            }
            else
            {
                var videos = eventVideos.OrderBy(v => v.SortOrder).ToList();
                
                <div class="video-selector mb-3">
                    <label class="form-label fw-semibold">Selecione um vídeo:</label>
                    <div class="list-group">
                        @for (int i = 0; i < videos.Count; i++)
                        {
                            var index = i;
                            var video = videos[i];
                            var isSelected = selectedVideoId == video.Id;
                            
                            // Generate clean display title
                            var displayTitle = GetCleanVideoTitle(video, i + 1);
                            
                            <div class="list-group-item list-group-item-action position-relative @(isSelected ? "active" : "")"
                                 role="button"
                                 @onclick="() => SelectVideoByIndex(video.Id)">
                                <span class="video-title-content">
                                    <i class="bi bi-play-circle me-2"></i>@displayTitle
                                </span>
                            </div>
                        }
                    </div>
                </div>
                
                @if (selectedVideoId.HasValue)
                {
                    var selectedVideo = videos.FirstOrDefault(v => v.Id == selectedVideoId.Value);
                    if (selectedVideo != null)
                    {
                        <div class="video-player-container">
                            <video @key="@selectedVideo.Id" controls playsinline class="modal-video" preload="metadata">
                                <source src="@selectedVideo.Url" type="@selectedVideo.MimeType">
                                @if (selectedVideo.MimeType == "video/quicktime")
                                {
                                    <source src="@selectedVideo.Url" type="video/mp4">
                                }
                                <p class="text-warning p-3">
                                    O seu navegador não suporta este formato de vídeo.
                                    Se o vídeo foi gravado num telemóvel, pode ter um codec (HEVC/H.265) não suportado neste navegador.
                                    Experimente usar o Safari ou um navegador móvel.
                                </p>
                            </video>
                        </div>
                    }
                }
            }
        </div>
    </BodyContent>
</Modal>

@code {
    // Constants for video title cleaning
    private const int MaxCleanTitleLength = 50;
    private static readonly string[] VideoExtensions = { ".mp4", ".mov", ".avi", ".mkv", ".webm", ".flv" };
    
    // Media session constants
    private const int VideoElementRenderDelayMs = 100; // Delay to ensure video element is rendered before attaching MediaSession
    
    private Label? aboutUs;
    private List<Event>? previousEvents;
    private bool showTrophyModal = false;
    private Event? selectedEvent;
    private List<Trophy>? eventTrophies;

    private Label? editingLabel;
    private bool showEditModal = false;
    
    // Video modal state
    private bool showVideosModal = false;
    private Event? selectedEventForVideos;
    private List<EventVideo>? eventVideos = null;
    private int? selectedVideoId = null;
    
    // Counts for video and trophy display
    private Dictionary<int, int> eventVideoCounts = new();
    private Dictionary<int, int> eventTrophyCounts = new();

    protected override async Task OnInitializedAsync()
    {
        // Load About Us label
        await LoadAboutUs();

        // Load previous 3 events (most recent first)
        previousEvents = (await EventService.GetPastEventsAsync(3)).ToList();
        
        // Load video and trophy counts in parallel for better performance
        var videoCountTasks = previousEvents.Select(async evt =>
        {
            var videos = await EventService.GetVideosByEventIdAsync(evt.Id);
            return (EventId: evt.Id, Count: videos.Count());
        });
        
        var trophyCountTasks = previousEvents.Select(async evt =>
        {
            var trophies = await TrophyService.GetByEventIdAsync(evt.Id);
            return (EventId: evt.Id, Count: trophies.Count());
        });
        
        var videoResults = await Task.WhenAll(videoCountTasks);
        var trophyResults = await Task.WhenAll(trophyCountTasks);
        
        foreach (var result in videoResults)
        {
            eventVideoCounts[result.EventId] = result.Count;
        }
        
        foreach (var result in trophyResults)
        {
            eventTrophyCounts[result.EventId] = result.Count;
        }
    }

    private async Task LoadAboutUs()
    {
        aboutUs = await LabelService.GetLabelByReferenceAsync("about-us");
    }

    private void OpenEditModal(Label label)
    {
        editingLabel = new Label
        {
            Id = label.Id,
            Reference = label.Reference,
            Title = label.Title,
            Content = label.Content,
            IsActive = label.IsActive
        };
        showEditModal = true;
    }

    private void CloseEditModal()
    {
        showEditModal = false;
        editingLabel = null;
    }

    private async Task SaveLabel()
    {
        if (editingLabel == null) return;

        try
        {
            await LabelService.UpdateLabelContentAsync(
                editingLabel.Id,
                editingLabel.Title,
                editingLabel.Content,
                editingLabel.IsActive
            );

            await LoadAboutUs();
            
            showEditModal = false;
            editingLabel = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error updating label");
        }
    }

    private async Task OpenTrophyModal(Event eventItem)
    {
        selectedEvent = eventItem;
        eventTrophies = (await TrophyService.GetByEventIdAsync(eventItem.Id)).ToList();
        showTrophyModal = true;
    }

    private void CloseTrophyModal()
    {
        showTrophyModal = false;
        selectedEvent = null;
        eventTrophies = null;
    }
    
    // Video modal methods
    private async Task OpenVideosModal(Event eventItem)
    {
        selectedEventForVideos = eventItem;
        try
        {
            eventVideos = (await EventService.GetVideosByEventIdAsync(eventItem.Id)).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading event videos");
            eventVideos = new List<EventVideo>();
        }
        selectedVideoId = null;
        showVideosModal = true;
    }
    
    private async Task CloseVideosModal()
    {
        showVideosModal = false;
        selectedEventForVideos = null;
        eventVideos = null;
        selectedVideoId = null;
        
        // Clear media session when modal closes
        try
        {
            await MediaSession.ClearMetadataAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to clear media session metadata on modal close");
        }
    }
    
    private async Task SelectVideoByIndex(int videoId)
    {
        if (selectedVideoId == videoId)
        {
            selectedVideoId = null;
            // Clear media session when video is collapsed
            try
            {
                await MediaSession.ClearMetadataAsync();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to clear media session metadata");
            }
        }
        else
        {
            selectedVideoId = videoId;
            
            // Set media session metadata when video is selected
            if (selectedEventForVideos != null && eventVideos != null)
            {
                var selectedVideo = eventVideos.FirstOrDefault(v => v.Id == videoId);
                if (selectedVideo != null)
                {
                    try
                    {
                        var videoTitle = GetCleanVideoTitle(selectedVideo, eventVideos.IndexOf(selectedVideo) + 1);
                        var eventImageUrl = !string.IsNullOrEmpty(selectedEventForVideos.ImageSrc) 
                            ? selectedEventForVideos.ImageSrc 
                            : string.Empty;
                        
                        // Use a small delay to ensure video element is rendered before attaching
                        await Task.Delay(VideoElementRenderDelayMs);
                        await MediaSession.AttachToVideoAsync(
                            ".modal-video",
                            videoTitle,
                            selectedEventForVideos.Name,
                            eventImageUrl
                        );
                    }
                    catch (Exception ex)
                    {
                        Logger.LogWarning(ex, "Failed to set video media session metadata");
                    }
                }
            }
        }
    }
    
    private string GetCleanVideoTitle(EventVideo video, int videoNumber)
    {
        if (selectedEventForVideos == null) 
            return $"Vídeo {videoNumber}";
        
        if (string.IsNullOrWhiteSpace(video.Title))
        {
            return $"{selectedEventForVideos.Name} - Vídeo {videoNumber}";
        }
        
        var title = video.Title.Trim();
        
        if (IsVideoTitleGenerated(title))
        {
            return $"{selectedEventForVideos.Name} - Vídeo {videoNumber}";
        }
        
        return title;
    }
    
    /// <summary>
    /// Determines if a video title appears to be auto-generated or a storage key
    /// rather than a user-friendly title.
    /// </summary>
    /// <param name="title">The video title to check</param>
    /// <returns>True if the title looks like it was auto-generated</returns>
    private bool IsVideoTitleGenerated(string title)
    {
        // Check if title is too long (likely a storage key or UUID)
        if (title.Length > MaxCleanTitleLength)
            return true;
        
        // Check if title contains video file extensions (e.g., "video.mp4")
        if (VideoExtensions.Any(ext => title.Contains(ext, StringComparison.OrdinalIgnoreCase)))
            return true;
        
        // Check if title contains path separators (e.g., "folder/video" or "folder\\video")
        if (title.Contains("/") || title.Contains("\\"))
            return true;
        
        return false;
    }
}
