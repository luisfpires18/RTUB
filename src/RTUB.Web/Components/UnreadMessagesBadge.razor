@namespace RTUB.Components
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using RTUB.Application.Interfaces
@using RTUB.Application.DTOs
@inject IMessagingService MessagingService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JSRuntime
@inject RTUB.Web.Services.MessagesNotificationService NotificationService
@implements IAsyncDisposable

@if (unreadCount > 0)
{
    <span class="badge bg-danger rounded-pill @CssClass">@unreadCount</span>
}

@code {
    [Parameter]
    public string CssClass { get; set; } = "";
    
    [Parameter]
    public EventCallback OnCountChanged { get; set; }

    private int unreadCount = 0;
    private string? currentUserId;
    private System.Threading.Timer? _refreshTimer;
    private DotNetObjectReference<UnreadMessagesBadge>? _dotNetRef;
    
    // Static event to allow cross-component communication
    private static event Action? OnBadgeRefreshRequested;
    

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        
        if (user.Identity?.IsAuthenticated == true)
        {
            currentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            if (!string.IsNullOrEmpty(currentUserId))
            {
                await LoadUnreadCount();
                
                // Subscribe to refresh requests from other components
                OnBadgeRefreshRequested += HandleRefreshRequest;
                
                // Subscribe to notification service events for real-time updates
                NotificationService.OnMessageReceived += HandleMessageReceived;
                NotificationService.OnMessageSeen += HandleMessageSeen;
                
                // Fallback timer refresh every 60 seconds
                _refreshTimer = new System.Threading.Timer(async _ =>
                {
                    try
                    {
                        await InvokeAsync(RefreshAndRender);
                    }
                    catch (ObjectDisposedException) { /* Circuit/component disposed */ }
                    catch (TaskCanceledException) { /* Circuit shutting down */ }
                }, null, TimeSpan.FromSeconds(60), TimeSpan.FromSeconds(60));
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !string.IsNullOrEmpty(currentUserId))
        {
            // Register with service worker to receive push notifications
            _dotNetRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("rtubUnreadMessages.register", _dotNetRef);
            // Sync OS app icon badge with the current DB unread count on startup.
            // Without this, the badge stays at whatever the service worker last set it to
            // (notification count), even after messages are read in-app.
            _ = UpdateAppBadge();
        }
    }

    private async Task LoadUnreadCount()
    {
        if (!string.IsNullOrEmpty(currentUserId))
        {
            try
            {
                unreadCount = await MessagingService.GetUnreadCountAsync(currentUserId);
            }
            catch
            {
                // Ignore errors — keep previous count
            }
        }
    }

    /// <summary>
    /// Fetches the latest count, re-renders immediately, then updates the PWA badge.
    /// Separating StateHasChanged from the JS interop call ensures the UI updates
    /// without waiting for the JS round-trip over the SignalR circuit.
    /// </summary>
    private async Task RefreshAndRender()
    {
        await LoadUnreadCount();
        StateHasChanged();
        if (OnCountChanged.HasDelegate)
        {
            await OnCountChanged.InvokeAsync();
        }
        // Fire-and-forget the badge update so it never blocks rendering
        _ = UpdateAppBadge();
    }

    private async void HandleRefreshRequest()
    {
        try
        {
            await InvokeAsync(RefreshAndRender);
        }
        catch (ObjectDisposedException) { /* Circuit/component disposed */ }
        catch (TaskCanceledException) { /* Circuit shutting down */ }
    }

    /// <summary>
    /// Called from service worker when a push notification is received
    /// </summary>
    [JSInvokable("RefreshUnreadMessages")]
    public async Task RefreshUnreadMessages()
    {
        await RefreshAndRender();
    }

    /// <summary>
    /// Call this static method from other components to refresh all badge instances
    /// </summary>
    public static void RequestRefresh()
    {
        OnBadgeRefreshRequested?.Invoke();
    }

    private async Task HandleMessageReceived(MessageDto message)
    {
        // Only update if the current user is an actual recipient of this message
        // (i.e., they are in the RecipientIds list and are not the sender)
        if (string.IsNullOrEmpty(currentUserId))
        {
            return;
        }

        if (message.SenderId != currentUserId && 
            message.RecipientIds.Contains(currentUserId))
        {
            try
            {
                await InvokeAsync(RefreshAndRender);
            }
            catch (ObjectDisposedException) { /* Circuit/component disposed */ }
            catch (TaskCanceledException) { /* Circuit shutting down */ }
        }
    }

    private async Task HandleMessageSeen(int conversationId, string userId, DateTime seenAt)
    {
        // Update unread count when messages are seen
        try
        {
            await InvokeAsync(RefreshAndRender);
        }
        catch (ObjectDisposedException) { /* Circuit/component disposed */ }
        catch (TaskCanceledException) { /* Circuit shutting down */ }
    }

    /// <summary>
    /// Updates the PWA/TWA app icon badge with the current unread count.
    /// Uses the Badging API (supported on Android Chrome/TWA, iOS 16.4+ PWA, desktop Chrome/Edge).
    /// </summary>
    private async Task UpdateAppBadge()
    {
        try
        {
            if (unreadCount > 0)
            {
                await JSRuntime.InvokeVoidAsync("appBadge.set", unreadCount);
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("appBadge.clear");
            }
        }
        catch
        {
            // Ignore JS interop errors (e.g., circuit disposed, prerendering)
        }
    }

    public async ValueTask DisposeAsync()
    {
        OnBadgeRefreshRequested -= HandleRefreshRequest;
        
        // Unsubscribe from notification service events
        NotificationService.OnMessageReceived -= HandleMessageReceived;
        NotificationService.OnMessageSeen -= HandleMessageSeen;
        
        _refreshTimer?.Dispose();
        _dotNetRef?.Dispose();
        
        await Task.CompletedTask;
    }
}
