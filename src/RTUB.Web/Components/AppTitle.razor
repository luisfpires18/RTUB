@namespace RTUB.Components

@*
    Document title for a route: "<page> - RTUB" (UI refactor 034). Every routable page sets one;
    dynamic pages put the data they already loaded into the content, e.g.
        <AppTitle>Contactos - @(selectedEvent?.Name ?? "Evento")</AppTitle>
    Without content it is the application's full name (home page, and MainLayout's fallback).
    Use this instead of <PageTitle> so the suffix lives in one place.
*@

@if (ChildContent is null)
{
    <PageTitle>@FullName</PageTitle>
}
else
{
    <PageTitle>@ChildContent@Suffix</PageTitle>
}

@code {
    public const string Suffix = " - RTUB";
    public const string FullName = "RTUB - Real Tuna Universitária de Bragança";

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
