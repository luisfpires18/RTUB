@using System.Security.Claims
@using RTUB.Application.Interfaces
@using RTUB.Application.DTOs
@using RTUB.Core.Helpers
@inject IPracticeTrackingService PracticeTrackingService
@inject AuthenticationStateProvider AuthStateProvider

<div class="practice-stats">
    @if (stats == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">A carregar...</span>
            </div>
        </div>
    }
    else
    {
        <!-- Summary Cards -->
        <div class="row g-3 mb-4">
            <div class="col-md-3 col-sm-6">
                <div class="card h-100">
                    <div class="card-body text-center">
                        <h6 class="text-muted mb-3">Esta Semana</h6>
                        <div class="display-6 fw-bold" style="color: #3F2A86;">@stats.WeeklyMinutes min</div>
                        <small class="text-muted">Meta: @stats.WeeklyGoalMinutes min</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="card h-100">
                    <div class="card-body text-center">
                        <h6 class="text-muted mb-3">Streak</h6>
                        <div class="display-6 fw-bold">
                            @if (stats.StreakDays > 0)
                            {
                                <span style="color: #ff6b35;">🔥</span>
                            }
                            <span style="color: #3F2A86;">@stats.StreakDays</span>
                        </div>
                        <small class="text-muted">dias consecutivos</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="card h-100">
                    <div class="card-body text-center">
                        <h6 class="text-muted mb-3">XP Ganho</h6>
                        <div class="display-6 fw-bold" style="color: #3F2A86;">@stats.XpEarned</div>
                        <small class="text-muted">desta prática</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="card h-100">
                    <div class="card-body text-center">
                        <h6 class="text-muted mb-3">Sessões</h6>
                        <div class="display-6 fw-bold" style="color: #3F2A86;">@stats.SessionCount</div>
                        <small class="text-muted">este mês</small>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Weekly Goal Progress -->
        <div class="card mb-4">
            <div class="card-body">
                <h6 class="mb-3"><i class="bi bi-target"></i> Meta Semanal</h6>
                <div class="progress mb-3" style="height: 30px;">
                    <div class="progress-bar" role="progressbar" 
                         style="width: @GetProgressPercentage()%; background-color: #3F2A86;"
                         aria-valuenow="@stats.WeeklyMinutes" 
                         aria-valuemin="0" 
                         aria-valuemax="@stats.WeeklyGoalMinutes">
                        <strong>@stats.WeeklyMinutes / @stats.WeeklyGoalMinutes min</strong>
                    </div>
                </div>
                <p class="mb-0 text-muted">
                    @GetMotivationalMessage()
                </p>
            </div>
        </div>
        
        <!-- Instrument Breakdown -->
        @if (stats.MinutesByInstrument.Any())
        {
            <div class="card mb-4">
                <div class="card-body">
                    <h6 class="mb-3"><i class="bi bi-music-note-list"></i> Tempo por Instrumento</h6>
                    @foreach (var kvp in stats.MinutesByInstrument.OrderByDescending(x => x.Value))
                    {
                        var percentage = stats.TotalMinutes > 0 ? (kvp.Value * 100.0 / stats.TotalMinutes) : 0;
                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-1">
                                <span><i class="bi @GetInstrumentIcon(kvp.Key) me-2"></i>@kvp.Key</span>
                                <span class="fw-bold">@kvp.Value min (@percentage.ToString("F1")%)</span>
                            </div>
                            <div class="progress" style="height: 20px;">
                                <div class="progress-bar" 
                                     style="width: @percentage%; background-color: @GetInstrumentColor(kvp.Key);"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        
        <!-- Most Practiced Songs -->
        @if (stats.MostPracticedSongs.Any())
        {
            <div class="card">
                <div class="card-body">
                    <h6 class="mb-3"><i class="bi bi-star-fill"></i> Músicas Mais Praticadas</h6>
                    <div class="list-group list-group-flush">
                        @foreach (var song in stats.MostPracticedSongs)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-music-note me-2" style="color: #3F2A86;"></i>
                                    <span>@song.Title</span>
                                </div>
                                <span class="badge rounded-pill" style="background-color: #3F2A86;">
                                    @song.TotalMinutes min · @song.SessionCount sessões
                                </span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="card">
                <div class="card-body text-center text-muted py-5">
                    <i class="bi bi-music-note-beamed" style="font-size: 3rem; opacity: 0.3;"></i>
                    <p class="mt-3 mb-0">Ainda não tens sessões registadas. Começa a praticar!</p>
                </div>
            </div>
        }
    }
</div>

@code {
    private PracticeStatsDto? stats;
    private string? userId;
    
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        
        if (!string.IsNullOrEmpty(userId))
        {
            var monthStart = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
            stats = await PracticeTrackingService.GetStatsAsync(userId, monthStart);
        }
    }
    
    private double GetProgressPercentage()
    {
        if (stats == null || stats.WeeklyGoalMinutes == 0) return 0;
        return Math.Min(100, (stats.WeeklyMinutes * 100.0 / stats.WeeklyGoalMinutes));
    }
    
    private string GetMotivationalMessage()
    {
        var progress = GetProgressPercentage();
        return progress switch
        {
            >= 100 => "🎉 Meta cumprida! Excelente trabalho!",
            >= 75 => "💪 Quase lá! Continua assim!",
            >= 50 => "👍 Bom progresso! Metade do caminho!",
            >= 25 => "🎵 Bom começo! Continua a praticar!",
            _ => "🎸 Vamos começar! A prática leva à perfeição!"
        };
    }
    
    private string GetInstrumentColor(string instrument)
    {
        // Generate color based on instrument name hash for consistency
        var hash = instrument.GetHashCode();
        var colors = new[] { "#3F2A86", "#6B46C1", "#805AD5", "#9F7AEA", "#B794F4", "#D6BCFA" };
        return colors[Math.Abs(hash) % colors.Length];
    }
    
    private string GetInstrumentIcon(string instrument)
    {
        // Map instrument names to icons
        return instrument.ToLower() switch
        {
            var s when s.Contains("guitarra") => "bi-guitar",
            var s when s.Contains("bandolim") => "bi-music-note-beamed",
            var s when s.Contains("cavaquinho") => "bi-music-note",
            var s when s.Contains("baixo") => "bi-soundwave",
            var s when s.Contains("acordeão") => "bi-vinyl",
            var s when s.Contains("percussão") => "bi-disc",
            var s when s.Contains("pandeireta") => "bi-circle",
            var s when s.Contains("flauta") => "bi-music-note-list",
            var s when s.Contains("violino") => "bi-music-note-beamed",
            _ => "bi-music-note"
        };
    }
}
