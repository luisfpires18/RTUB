@rendermode InteractiveServer
@using RTUB.Application.Interfaces
@using RTUB.Application.DTOs
@using RTUB.Core.Enums
@using RTUB.Core.Helpers
@using RTUB.Core.Entities
@using Microsoft.JSInterop
@inject ITunerService TunerService
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div class="tuner-container">
    @if (!string.IsNullOrEmpty(_debugMessage))
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <i class="bi bi-info-circle-fill me-2"></i>
            <strong>Debug:</strong> @_debugMessage
            <button type="button" class="btn-close" @onclick="() => _debugMessage = null" aria-label="Fechar"></button>
        </div>
    }
    
    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>Erro:</strong> @_errorMessage
            <button type="button" class="btn-close" @onclick="() => _errorMessage = null" aria-label="Fechar"></button>
        </div>
    }

    @if (_isLoading)
    {
        <LoadingSpinner Show="true" Message="A iniciar afinador..." />
    }
    else
    {
        <div class="row g-3">
            <!-- Instrument Selection -->
            <div class="col-md-6">
                <label for="instrumentSelect" class="form-label">Instrumento (Filtrado v3.0)</label>
                <select id="instrumentSelect" class="form-select" @bind="_selectedInstrument" @bind:after="OnInstrumentChanged" disabled="@_isRunning">
                    @foreach (var instrument in GetTunableInstruments())
                    {
                        <option value="@instrument">@InstrumentTypeHelper.GetDisplayName(instrument)</option>
                    }
                </select>
                <small class="text-muted">Mostrando @GetTunableInstruments().Count() de @Enum.GetValues(typeof(InstrumentType)).Length instrumentos</small>
            </div>

            <!-- Tuning Preset Selection -->
            <div class="col-md-6">
                <label for="tuningSelect" class="form-label">Afinação</label>
                <select id="tuningSelect" class="form-select" @bind="_selectedTuningId" disabled="@_isRunning">
                    @if (_tuningPresets != null)
                    {
                        @foreach (var preset in _tuningPresets)
                        {
                            <option value="@preset.Id">@preset.Name</option>
                        }
                    }
                </select>
            </div>
        </div>

        <!-- Tuner Display -->
        <div class="tuner-display mt-4" style="background-color: #2a1f4d; border: 2px solid #3F2A86;">
            @if (!_isRunning)
            {
                <div class="text-center py-5">
                    <i class="bi bi-mic-fill" style="font-size: 3rem; color: #3F2A86;"></i>
                    <p class="mt-3" style="color: #e2e2e2;">Clique em "Iniciar" para começar a afinar</p>
                </div>
            }
            else
            {
                <!-- Note Display -->
                <div class="text-center mb-3">
                    <div class="note-display @GetNoteColorClass()">
                        @if (_currentPitch != null)
                        {
                            <span>@_currentPitch.NoteName@_currentPitch.Octave</span>
                        }
                        else
                        {
                            <span style="color: #e2e2e2;">--</span>
                        }
                    </div>
                    <div class="frequency-display" style="color: #e2e2e2;">
                        @if (_currentPitch != null)
                        {
                            <span>@(_currentPitch.Frequency.ToString("F1")) Hz</span>
                        }
                        else
                        {
                            <span>-- Hz</span>
                        }
                    </div>
                </div>

                <!-- Needle Indicator -->
                <div class="needle-container mb-4">
                    <div class="needle-scale">
                        <div class="scale-mark scale-left">-50</div>
                        <div class="scale-mark scale-center">0</div>
                        <div class="scale-mark scale-right">+50</div>
                    </div>
                    <div class="needle-track">
                        <div class="needle @GetNeedleColorClass()" style="transform: translateX(@GetNeedlePosition())"></div>
                    </div>
                    <div class="cents-display @GetNoteColorClass()">
                        @if (_currentPitch != null)
                        {
                            <span>@(_currentPitch.CentsOffset.ToString("+0.0;-0.0;0")) cents</span>
                        }
                        else
                        {
                            <span style="color: #e2e2e2;">0 cents</span>
                        }
                    </div>
                </div>

                <!-- String Indicator -->
                @if (_selectedTuning != null && _selectedTuning.NotesArray != null && _selectedTuning.NotesArray.Any())
                {
                    <div class="string-indicator" style="background-color: rgba(63, 42, 134, 0.2); border-radius: 0.375rem; padding: 1rem; margin-top: 1rem;">
                        <h6 class="text-center mb-3" style="color: #e2e2e2;">Notas Esperadas:</h6>
                        <div class="d-flex justify-content-center gap-2 flex-wrap">
                            @foreach (var note in _selectedTuning.NotesArray)
                            {
                                <span class="badge" style="background-color: #3F2A86; font-size: 1rem; padding: 0.5rem 1rem;">@note</span>
                            }
                        </div>
                    </div>
                }
            }
        </div>

        <!-- Control Button -->
        <div class="text-center mt-4">
            <button class="btn @(_isRunning ? "btn-danger" : "btn-primary") btn-lg" 
                    style="min-height: 44px; min-width: 120px;"
                    @onclick="ToggleTuner"
                    @onclick:preventDefault="false"
                    disabled="@_isTogglingTuner">
                @if (_isTogglingTuner)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                }
                <i class="bi @(_isRunning ? "bi-stop-circle" : "bi-play-circle") me-2"></i>
                @(_isRunning ? "Parar" : "Iniciar") [v3.0]
            </button>
            <div class="mt-2">
                <small class="text-muted">Botão renderizado: @DateTime.Now.ToString("HH:mm:ss.fff")</small>
            </div>
        </div>
    }
</div>

@code {
    private InstrumentType _selectedInstrument = InstrumentType.Guitarra;
    private int? _selectedTuningId;
    private List<InstrumentTuning>? _tuningPresets;
    private InstrumentTuning? _selectedTuning;
    
    private bool _isLoading = true;
    private bool _isRunning = false;
    private bool _isTogglingTuner = false;
    private string? _errorMessage;
    private string? _debugMessage;
    
    private PitchInfo? _currentPitch;
    
    private IJSObjectReference? _tunerModule;
    private DotNetObjectReference<Tuner>? _dotNetReference;

    protected override async Task OnInitializedAsync()
    {
        await LoadTuningPresets();
        _isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("console.log", "RTUB Tuner: OnAfterRenderAsync - Loading tuner.js module...");
                // Load the tuner.js module
                _tunerModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/tuner.js");
                await JSRuntime.InvokeVoidAsync("console.log", "RTUB Tuner: Tuner module loaded successfully");
            }
            catch (Exception ex)
            {
                await JSRuntime.InvokeVoidAsync("console.error", $"RTUB Tuner: Error loading tuner module: {ex.Message}");
                _errorMessage = $"Erro ao carregar módulo do afinador: {ex.Message}";
                StateHasChanged();
            }
        }
    }

    private async Task LoadTuningPresets()
    {
        try
        {
            var presets = await TunerService.GetTuningPresetsAsync(_selectedInstrument);
            _tuningPresets = presets.ToList();
            
            if (_tuningPresets.Any())
            {
                // Select the default tuning or the first one
                var defaultTuning = _tuningPresets.FirstOrDefault(t => t.IsDefault) ?? _tuningPresets.First();
                _selectedTuningId = defaultTuning.Id;
                _selectedTuning = defaultTuning;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Erro ao carregar afinações: {ex.Message}";
        }
    }

    private async Task OnInstrumentChanged()
    {
        await LoadTuningPresets();
    }

    private async Task ToggleTuner()
    {
        // Show visible debug message on screen
        _debugMessage = $"Botão clicado! Versão: {DateTime.Now:HH:mm:ss}";
        StateHasChanged();
        
        // Also log to console
        try
        {
            await JSRuntime.InvokeVoidAsync("console.log", $"RTUB Tuner: ✓ Button clicked at {DateTime.Now:HH:mm:ss}! isRunning={_isRunning}");
        }
        catch
        {
            // Ignore if console.log fails
        }
        
        if (_isTogglingTuner) return;
        
        _isTogglingTuner = true;
        _errorMessage = null;

        try
        {
            if (_isRunning)
            {
                await JSRuntime.InvokeVoidAsync("console.log", "RTUB Tuner: Stopping tuner...");
                await StopTuner();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("console.log", "RTUB Tuner: Starting tuner...");
                await StartTuner();
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"RTUB Tuner: Error in ToggleTuner: {ex.Message}");
            _errorMessage = ex.Message.Contains("Permission") || ex.Message.Contains("denied") 
                ? "Acesso ao microfone negado. Por favor, permita o acesso ao microfone nas configurações do navegador."
                : $"Erro ao iniciar o afinador: {ex.Message}";
        }
        finally
        {
            _isTogglingTuner = false;
            StateHasChanged();
        }
    }

    private async Task StartTuner()
    {
        if (_tunerModule == null)
        {
            throw new InvalidOperationException("Módulo do afinador não carregado");
        }

        // Update selected tuning
        if (_selectedTuningId.HasValue && _tuningPresets != null)
        {
            _selectedTuning = _tuningPresets.FirstOrDefault(t => t.Id == _selectedTuningId.Value);
        }

        // Create .NET object reference for callbacks
        _dotNetReference = DotNetObjectReference.Create(this);

        try
        {
            await JSRuntime.InvokeVoidAsync("console.log", "RTUB Tuner: Calling startTuner JS function...");
            // Start the tuner with the callback
            await _tunerModule.InvokeVoidAsync("startTuner", _dotNetReference);
            
            _isRunning = true;
            _currentPitch = null;
            await JSRuntime.InvokeVoidAsync("console.log", "RTUB Tuner: startTuner JS function completed successfully");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"RTUB Tuner: Error in StartTuner: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("console.error", $"RTUB Tuner: Stack trace: {ex.StackTrace}");
            throw new InvalidOperationException($"Erro ao iniciar o afinador: {ex.Message}", ex);
        }
    }

    private async Task StopTuner()
    {
        if (_tunerModule != null)
        {
            try
            {
                await _tunerModule.InvokeVoidAsync("stopTuner");
            }
            catch
            {
                // Ignore disposal errors
            }
        }

        _dotNetReference?.Dispose();
        _dotNetReference = null;
        
        _isRunning = false;
        _currentPitch = null;
    }

    [JSInvokable]
    public void UpdatePitch(double frequency)
    {
        try
        {
            _currentPitch = TunerService.ValidatePitch(frequency);
            InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating pitch: {ex.Message}");
        }
    }

    private string GetNoteColorClass()
    {
        if (_currentPitch == null) return "";
        
        var absCents = Math.Abs(_currentPitch.CentsOffset);
        if (absCents < 10) return "text-success";  // Increased from 5 to 10
        if (absCents <= 20) return "text-warning"; // Increased from 10 to 20
        return "text-danger";
    }

    private string GetNeedleColorClass()
    {
        if (_currentPitch == null) return "needle-neutral";
        
        var absCents = Math.Abs(_currentPitch.CentsOffset);
        if (absCents < 10) return "needle-green";  // Increased from 5 to 10
        if (absCents <= 20) return "needle-yellow"; // Increased from 10 to 20
        return "needle-red";
    }

    private string GetNeedlePosition()
    {
        if (_currentPitch == null) return "0%";
        
        // Map -50 to +50 cents to -100% to +100%
        var position = (_currentPitch.CentsOffset / 50.0) * 100.0;
        // Clamp to -100% to +100%
        position = Math.Max(-100, Math.Min(100, position));
        return $"{position:F1}%";
    }

    private IEnumerable<InstrumentType> GetTunableInstruments()
    {
        // Only show instruments that can be tuned (have pitch)
        // Exclude: Estandarte, Pandeireta (no pitch)
        return new[]
        {
            InstrumentType.Guitarra,
            InstrumentType.Bandolim,
            InstrumentType.Cavaquinho,
            InstrumentType.Baixo,
            InstrumentType.Contrabaixo,
            InstrumentType.Acordeao,
            InstrumentType.Percussao,
            InstrumentType.Violino,
            InstrumentType.Fagote,
            InstrumentType.Flauta
        };
    }

    public async ValueTask DisposeAsync()
    {
        if (_isRunning)
        {
            await StopTuner();
        }

        if (_tunerModule != null)
        {
            try
            {
                await _tunerModule.DisposeAsync();
            }
            catch
            {
                // Ignore disposal errors
            }
        }
    }
}
