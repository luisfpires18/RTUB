@namespace RTUB.Components
@rendermode InteractiveServer
@using RTUB.Shared
@inject RTUB.Web.Services.AnnouncementService AnnouncementService
@inject IJSRuntime JS
@implements IAsyncDisposable

<Modal Show="@(message is not null)"
       Title="Aviso do Sistema"
       Centered="true"
       Size="Modal.ModalSize.Small"
       ShowCloseButton="false">
    <BodyContent>
        <div class="text-center">
            <i class="bi bi-megaphone-fill fs-1 mb-3 d-block"></i>
            <p class="mb-0">@message</p>
        </div>
    </BodyContent>
    <FooterContent>
        <div class="w-100 d-flex justify-content-center">
            <button type="button" class="btn btn-primary" @onclick="Dismiss">
                <i class="bi bi-check2 me-1"></i>OK, entendido
            </button>
        </div>
    </FooterContent>
</Modal>

@code {
    private string? message;
    private bool _isDisposed;

    protected override void OnInitialized()
    {
        AnnouncementService.OnAnnouncement += HandleAnnouncementAsync;
    }

    private async Task HandleAnnouncementAsync(string text)
    {
        if (_isDisposed) return;

        try
        {
            await InvokeAsync(async () =>
            {
                if (_isDisposed) return;
                message = text;
                StateHasChanged();

                // Play sound inside InvokeAsync so it runs on this circuit's sync context.
                // Use a timeout to prevent hanging on disconnected circuits — a hung JS call
                // blocks the singleton BroadcastAsync and causes Kestrel "application never completed".
                using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(5));
                try
                {
                    await JS.InvokeVoidAsync("rtubAudioPlayer.playAnnouncementSound", cts.Token);
                }
                catch
                {
                    // Sound is best-effort — don't block the announcement
                }
            });
        }
        catch (ObjectDisposedException)
        {
        }
    }

    private async Task Dismiss()
    {
        message = null;
        using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(3));
        try { await JS.InvokeVoidAsync("rtubAudioPlayer.stopAnnouncementSound", cts.Token); } catch { }
    }

    public async ValueTask DisposeAsync()
    {
        _isDisposed = true;
        AnnouncementService.OnAnnouncement -= HandleAnnouncementAsync;
        using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(3));
        try { await JS.InvokeVoidAsync("rtubAudioPlayer.stopAnnouncementSound", cts.Token); } catch { }
    }
}
