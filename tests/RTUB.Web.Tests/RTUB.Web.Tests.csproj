<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.Core" />
    <PackageReference Include="bunit" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="MockQueryable.Moq" />
    <PackageReference Include="Moq" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RTUB.Web\RTUB.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\src\RTUB.Web\appsettings.json" CopyToOutputDirectory="PreserveNewest" Link="appsettings.json" />
    <None Include="..\..\src\RTUB.Web\appsettings.Production.json" CopyToOutputDirectory="PreserveNewest" Link="appsettings.Production.json" />
  </ItemGroup>

</Project>
