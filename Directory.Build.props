<Project>
  <!-- 
    Suppress warnings for transitive dependencies:
    - NU1903: Old vulnerable .NETCore runtime packages (Microsoft.NETCore.App, Microsoft.NETCore.Jit)
      that come from older packages like Microsoft.AspNetCore.Http.Abstractions 2.2.0.
      These packages are excluded from the build and publish output. The actual runtime uses .NET 10.0 libraries.
    - NETSDK1206: Version-specific runtime identifiers in Libuv package.
      The package contains deprecated RID-specific assets that are not used in modern .NET versions.
  -->
  <PropertyGroup>
    <!-- Explicitly set C# 14 language version for .NET 10 consistency -->
    <LangVersion>14</LangVersion>
    <NoWarn>$(NoWarn);NU1903;NETSDK1206</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETCore.App" Version="1.0.5">
      <ExcludeAssets>all</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NETCore.Jit" Version="1.0.7">
      <ExcludeAssets>all</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>