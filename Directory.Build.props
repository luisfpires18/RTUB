<Project>
  <PropertyGroup>
    <!-- C# Language and Analysis Settings -->
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!--
    Release version. The root VERSION file is the only place it is written: MAJOR.MINOR.PATCH,
    nothing else. Every build reads it, so a local build, a DEV build and a production build all
    report the same number; CI adds only a VersionSuffix for DEV (2.0.0-dev.N). The SDK appends the
    commit SHA to the informational version, which is what GET /api/version serves.
    See docs/release-and-rollback.md.
  -->
  <PropertyGroup>
    <RtubVersionFile>$(MSBuildThisFileDirectory)VERSION</RtubVersionFile>
    <VersionPrefix Condition="Exists('$(RtubVersionFile)')">$([System.IO.File]::ReadAllText('$(RtubVersionFile)').Trim())</VersionPrefix>
  </PropertyGroup>

  <Target Name="ValidateRtubVersion" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(RtubVersionFile)')" Text="The root VERSION file is missing. It must hold MAJOR.MINOR.PATCH." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(VersionPrefix)', '^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'))"
           Text="VERSION must be MAJOR.MINOR.PATCH with no leading zeros, prerelease or build metadata; found '$(VersionPrefix)'." />
  </Target>
</Project>
