<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <RootNamespace>RTUB.DbSanitizer</RootNamespace>
    <!-- Not a test project. Stated explicitly so `dotnet test` over the solution, which runs on
         Microsoft.Testing.Platform (see global.json), never tries to execute this console app. -->
    <IsTestProject>false</IsTestProject>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RTUB.Application\RTUB.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- RTUB.Application carries the same FrameworkReference; a console app that references it
         needs its own, or the ASP.NET Core assemblies are not on the runtime's probing path. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
